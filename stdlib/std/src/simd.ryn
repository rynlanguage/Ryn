            y := *((lane_address(pb as *u8, at * 8 as u64)) as *i64)
            slot := (lane_address(po as *u8, at * 8 as u64)) as *i64
            *slot = x * y
            at += 1
        }
        return out
    }
    pub fun bit_and(self, rhs: I64x4) -> I64x4 {
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        mut b := I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }
        mut out := I64x4 { d: 0 as u64, c: 0 as u64, b: 0 as u64, a: 0 as u64 }
        pa := &raw mut a
        pb := &raw mut b
        po := &raw mut out
        when cpu::has_avx2() {
            __simd_bin(2480896, po as *u8, pa as *u8, pb as *u8)
        } else {
            __simd_bin(383744, po as *u8, pa as *u8, pb as *u8)
            __simd_bin(383744, lane_address(po as *u8, 16 as u64), lane_address(pa as *u8, 16 as u64), lane_address(pb as *u8, 16 as u64))
        }
        return out
    }
    pub fun bit_andnot(self, rhs: I64x4) -> I64x4 {
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        mut b := I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }
        mut out := I64x4 { d: 0 as u64, c: 0 as u64, b: 0 as u64, a: 0 as u64 }
        pa := &raw mut a
        pb := &raw mut b
        po := &raw mut out
        when cpu::has_avx2() {
            __simd_bin(2481920, po as *u8, pa as *u8, pb as *u8)
        } else {
            __simd_bin(384768, po as *u8, pa as *u8, pb as *u8)
            __simd_bin(384768, lane_address(po as *u8, 16 as u64), lane_address(pa as *u8, 16 as u64), lane_address(pb as *u8, 16 as u64))
        }
        return out
    }
    pub fun bit_or(self, rhs: I64x4) -> I64x4 {
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        mut b := I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }
        mut out := I64x4 { d: 0 as u64, c: 0 as u64, b: 0 as u64, a: 0 as u64 }
        pa := &raw mut a
        pb := &raw mut b
        po := &raw mut out
        when cpu::has_avx2() {
            __simd_bin(2484992, po as *u8, pa as *u8, pb as *u8)
        } else {
            __simd_bin(387840, po as *u8, pa as *u8, pb as *u8)
            __simd_bin(387840, lane_address(po as *u8, 16 as u64), lane_address(pa as *u8, 16 as u64), lane_address(pb as *u8, 16 as u64))
        }
        return out
    }
    pub fun bit_xor(self, rhs: I64x4) -> I64x4 {
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        mut b := I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }
        mut out := I64x4 { d: 0 as u64, c: 0 as u64, b: 0 as u64, a: 0 as u64 }
        pa := &raw mut a
        pb := &raw mut b
        po := &raw mut out
        when cpu::has_avx2() {
            __simd_bin(2486016, po as *u8, pa as *u8, pb as *u8)
        } else {
            __simd_bin(388864, po as *u8, pa as *u8, pb as *u8)
            __simd_bin(388864, lane_address(po as *u8, 16 as u64), lane_address(pa as *u8, 16 as u64), lane_address(pb as *u8, 16 as u64))
        }
        return out
    }
    pub fun eq(self, rhs: I64x4) -> I64x4 {
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        mut b := I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }
        mut out := I64x4 { d: 0 as u64, c: 0 as u64, b: 0 as u64, a: 0 as u64 }
        pa := &raw mut a
        pb := &raw mut b
        po := &raw mut out
        when cpu::has_avx2() {
            __simd_bin(2500864, po as *u8, pa as *u8, pb as *u8)
            return out
        }
        mut at: u64 = 0
        while at < 4 {
            x := *((lane_address(pa as *u8, at * 8 as u64)) as *i64)
            y := *((lane_address(pb as *u8, at * 8 as u64)) as *i64)
            slot := (lane_address(po as *u8, at * 8 as u64)) as *i64
            when x == y {
                *slot = -1
            } else {
                *slot = 0
            }
            at += 1
        }
        return out
    }
    pub fun gt(self, rhs: I64x4) -> I64x4 {
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        mut b := I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }
        mut out := I64x4 { d: 0 as u64, c: 0 as u64, b: 0 as u64, a: 0 as u64 }
        pa := &raw mut a
        pb := &raw mut b
        po := &raw mut out
        when cpu::has_avx2() {
            __simd_bin(2504448, po as *u8, pa as *u8, pb as *u8)
            return out
        }
        mut at: u64 = 0
        while at < 4 {
            x := *((lane_address(pa as *u8, at * 8 as u64)) as *i64)
            y := *((lane_address(pb as *u8, at * 8 as u64)) as *i64)
            slot := (lane_address(po as *u8, at * 8 as u64)) as *i64
            when x > y {
                *slot = -1
            } else {
                *slot = 0
            }
            at += 1
        }
        return out
    }
    pub fun lt(self, rhs: I64x4) -> I64x4 {
        return I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }.gt(I64x4 { d: self.d, c: self.c, b: self.b, a: self.a })
    }

    pub fun ge(self, rhs: I64x4) -> I64x4 {
        return I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }.gt(I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }).bit_or(I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }.eq(I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }))
    }

    pub fun le(self, rhs: I64x4) -> I64x4 {
        return I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }.ge(I64x4 { d: self.d, c: self.c, b: self.b, a: self.a })
    }

    pub fun ne(self, rhs: I64x4) -> I64x4 {
        return I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }.eq(I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }).bit_xor(I64x4::all_ones())
    }

    pub fun min(self, rhs: I64x4) -> I64x4 {
        return I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }.gt(I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }).select(I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }, I64x4 { d: self.d, c: self.c, b: self.b, a: self.a })
    }

    pub fun max(self, rhs: I64x4) -> I64x4 {
        return I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }.gt(I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a }).select(I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }, I64x4 { d: rhs.d, c: rhs.c, b: rhs.b, a: rhs.a })
    }

    pub fun neg(self) -> I64x4 {
        return I64x4::zero().sub(I64x4 { d: self.d, c: self.c, b: self.b, a: self.a })
    }
    pub fun zero() -> I64x4 {
        return I64x4 { d: 0 as u64, c: 0 as u64, b: 0 as u64, a: 0 as u64 }
    }

    pub fun all_ones() -> I64x4 {
        return I64x4 { d: 18446744073709551615 as u64, c: 18446744073709551615 as u64, b: 18446744073709551615 as u64, a: 18446744073709551615 as u64 }
    }

    pub fun lanes() -> u64 {
        return 4
    }

    // every lane set to `value`
    pub fun splat(value: i64) -> I64x4 {
        mut out := I64x4 { d: 0 as u64, c: 0 as u64, b: 0 as u64, a: 0 as u64 }
        po := &raw mut out
        mut at: u64 = 0
        while at < 4 {
            slot := (lane_address(po as *u8, at * 8 as u64)) as *i64
            *slot = value
            at += 1
        }
        return out
    }

    pub fun get(self, index: u64) -> i64 {
        when index >= 4 {
            panic("simd lane index out of range")
        }
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        pa := &raw mut a
        return *((lane_address(pa as *u8, index * 8 as u64)) as *i64)
    }

    // a copy with lane `index` replaced
    pub fun with(self, index: u64, value: i64) -> I64x4 {
        when index >= 4 {
            panic("simd lane index out of range")
        }
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        pa := &raw mut a
        slot := (lane_address(pa as *u8, index * 8 as u64)) as *i64
        *slot = value
        return a
    }

    // `select(mask, a, b)`: lane i from `a` where the mask lane is all ones, else from `b`
    pub fun select(self, on_true: I64x4, on_false: I64x4) -> I64x4 {
        return I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }.bit_and(I64x4 { d: on_true.d, c: on_true.c, b: on_true.b, a: on_true.a }).bit_or(I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }.bit_andnot(I64x4 { d: on_false.d, c: on_false.c, b: on_false.b, a: on_false.a }))
    }

    // the first 32 bytes at `address`, with no alignment requirement
    pub fun load(address: *u8) -> I64x4 {
        mut out := I64x4 { d: 0 as u64, c: 0 as u64, b: 0 as u64, a: 0 as u64 }
        po := &raw mut out
        when cpu::has_avx2() {
            __simd_copy(2097152, po as *u8, address, 32 as u64)
        } else {
            __simd_copy(0, po as *u8, address, 16 as u64)
            __simd_copy(0, lane_address(po as *u8, 16 as u64), lane_address(address, 16 as u64), 16 as u64)
        }
        return out
    }

    pub fun load_aligned(address: *u8) -> I64x4 {
        aligned_check(address, 32 as u64)
        return I64x4::load(address)
    }

    pub fun store(self, address: *u8) {
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        pa := &raw mut a
        when cpu::has_avx2() {
            __simd_copy(2097152, address, pa as *u8, 32 as u64)
        } else {
            __simd_copy(0, address, pa as *u8, 16 as u64)
            __simd_copy(0, lane_address(address, 16 as u64), lane_address(pa as *u8, 16 as u64), 16 as u64)
        }
    }

    pub fun store_aligned(self, address: *u8) {
        aligned_check(address, 32 as u64)
        I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }.store(address)
    }

    // the lanes added from lane 0 to the last, in the lane type's own arithmetic
    pub fun sum(self) -> i64 {
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        pa := &raw mut a
        mut total := *(pa as *i64)
        mut at: u64 = 1
        while at < 4 {
            total = total + *((lane_address(pa as *u8, at * 8 as u64)) as *i64)
            at += 1
        }
        return total
    }

    pub fun reduce_min(self) -> i64 {
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        pa := &raw mut a
        mut best := *(pa as *i64)
        mut at: u64 = 1
        while at < 4 {
            lane := *((lane_address(pa as *u8, at * 8 as u64)) as *i64)
            when lane < best {
                best = lane
            }
            at += 1
        }
        return best
    }

    pub fun reduce_max(self) -> i64 {
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        pa := &raw mut a
        mut best := *(pa as *i64)
        mut at: u64 = 1
        while at < 4 {
            lane := *((lane_address(pa as *u8, at * 8 as u64)) as *i64)
            when lane > best {
                best = lane
            }
            at += 1
        }
        return best
    }

    // the lanes in reverse order (a scalar rearrangement)
    pub fun reverse(self) -> I64x4 {
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        mut out := I64x4 { d: 0 as u64, c: 0 as u64, b: 0 as u64, a: 0 as u64 }
        pa := &raw mut a
        po := &raw mut out
        mut at: u64 = 0
        while at < 4 {
            slot := (lane_address(po as *u8, at * 8 as u64)) as *i64
            *slot = *((lane_address(pa as *u8, (4 - 1 - at) * 8 as u64)) as *i64)
            at += 1
        }
        return out
    }

    // lane i of the result is lane `order[i]` of this vector (a scalar rearrangement; indexes wrap by the lane count)
    pub fun shuffle(self, order: &[u64]) -> I64x4 {
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        mut out := I64x4 { d: 0 as u64, c: 0 as u64, b: 0 as u64, a: 0 as u64 }
        pa := &raw mut a
        po := &raw mut out
        mut at: u64 = 0
        while at < 4 && at < order.len() {
            slot := (lane_address(po as *u8, at * 8 as u64)) as *i64
            *slot = *((lane_address(pa as *u8, (order[at] % 4 as u64) * 8 as u64)) as *i64)
            at += 1
        }
        return out
    }
    // bit i is the top bit of lane i
    pub fun movemask(self) -> u64 {
        mut a := I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }
        pa := &raw mut a
        mut bits: u64 = 0
        mut at: u64 = 0
        while at < 4 {
            raw := *((lane_address(pa as *u8, at * 8 as u64)) as *u64)
            top := (raw as u64) >> (63 as u32)
            bits = bits | (top << (at as u32))
            at += 1
        }
        return bits
    }
    pub fun any(self) -> bool {
        return I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }.movemask() != 0
    }

    pub fun all(self) -> bool {
        return I64x4 { d: self.d, c: self.c, b: self.b, a: self.a }.movemask() == 15
    }
}

// Fused array operations: one loop over `count` consecutive elements from the pointer, with the vector registers kept
// across iterations (the loops are in selfhost/src/back/fused.ryn). Each takes the AVX2 form when std::cpu reports AVX2
// and the SSE2 form otherwise, and the two forms give the same bits. The pointers need no alignment.
//
// A reduction (sum_f32, dot_f32, sum_i32) adds the elements in a fixed order that is not the scalar loop's order: blocks of 16
// elements feed four lane accumulators, the accumulators and the four lanes are combined as (A0 + A2) + (A1 + A3) and
// (l0 + l2) + (l1 + l3), and the elements after the last full block are added in order. For values whose sums are exact
// the result equals the scalar loop's; otherwise the rounding differs from a loop that adds one element at a time.
// Integer sums wrap, so their order does not matter. add_f32 is element by element, so it equals the scalar loop: dst may
// equal a or b, but must not partly overlap them.

// The sum of the `count` floats at `values`.
pub fun sum_f32(values: *f32, count: u64) -> f32 {
    mut out: f32 = 0.0
    po := &raw mut out
    when cpu::has_avx2() {
        __simd_fused_sum_f32(2097152, values as *u8, count, po as *u8)
    } else {
        __simd_fused_sum_f32(0, values as *u8, count, po as *u8)
    }
    return out
}

// The dot product of the `count` floats at `a` and `b`: each product is rounded, then added as in sum_f32.
pub fun dot_f32(a: *f32, b: *f32, count: u64) -> f32 {
    mut out: f32 = 0.0
    po := &raw mut out
    when cpu::has_avx2() {
        __simd_fused_dot_f32(2097152, a as *u8, b as *u8, count, po as *u8)
    } else {
        __simd_fused_dot_f32(0, a as *u8, b as *u8, count, po as *u8)
    }
    return out
}

// The sum of the `count` 32-bit integers at `values`, wrapping on overflow.
pub fun sum_i32(values: *i32, count: u64) -> i32 {
    mut out: i32 = 0
    po := &raw mut out
    when cpu::has_avx2() {
        __simd_fused_sum_i32(2097152, values as *u8, count, po as *u8)
    } else {
        __simd_fused_sum_i32(0, values as *u8, count, po as *u8)
    }
    return out
}

// dst[i] = a[i] + b[i] for the `count` floats.
pub fun add_f32(dst: *f32, a: *f32, b: *f32, count: u64) {
    when cpu::has_avx2() {
        __simd_fused_add_f32(2097152, dst as *u8, a as *u8, b as *u8, count)
    } else {
        __simd_fused_add_f32(0, dst as *u8, a as *u8, b as *u8, count)
    }
}
