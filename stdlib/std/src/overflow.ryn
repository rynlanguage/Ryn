        return smallest
    }
    when right < 0 && difference < left {
        return 9223372036854775807
    }
    return difference
}
pub fun saturating_mul_i64(left: i64, right: i64) -> i64 {
    smallest: i64 = -9223372036854775808
    when left == 0 || right == 0 {
        return 0
    }
    overflowed := (left == -1 && right == smallest) || (right == -1 && left == smallest)
    when !overflowed {
        product := left * right
        when product / right == left {
            return product
        }
    }
    when (left < 0) == (right < 0) {
        return 9223372036854775807
    }
    return smallest
}
