}
pub fun checked_sub_i64(left: i64, right: i64) -> Option<i64> {
    difference := left - right
    when (right > 0 && difference > left) || (right < 0 && difference < left) {
        return Option::None
    }
    return Option::Some(difference)
}
pub fun checked_mul_i64(left: i64, right: i64) -> Option<i64> {
    smallest: i64 = -9223372036854775808
    when left == 0 || right == 0 {
        return Option::Some(0)
    }
    when (left == -1 && right == smallest) || (right == -1 && left == smallest) {
        return Option::None
    }
    product := left * right
    when product / right != left {
        return Option::None
    }
    return Option::Some(product)
}
pub fun saturating_add_i64(left: i64, right: i64) -> i64 {
    sum := left + right
    when right > 0 && sum < left {
        return 9223372036854775807
    }
    when right < 0 && sum > left {
