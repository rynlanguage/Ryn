// Explicit overflow control. The operators `+`, `-` and `*` always wrap at the width of their type; this module
// names the other behaviours. `checked_*` gives `Option::None` when the result does not fit, `wrapping_*` is the
// two's-complement result, and `saturating_*` clamps to the smallest or largest value of the type.

pub fun checked_add_i8(left: i8, right: i8) -> Option<i8> {
    low: i64 = -128
    high: i64 = 127
    wide: i64 = (left as i64) + (right as i64)
    when wide < low || wide > high {
        return Option::None
    }
    return Option::Some(wide as i8)
}
pub fun saturating_add_i8(left: i8, right: i8) -> i8 {
    low: i64 = -128
    high: i64 = 127
    wide: i64 = (left as i64) + (right as i64)
    when wide < low {
        return low as i8
    }
    when wide > high {
        return high as i8
    }
    return wide as i8
}
