// The parts of the native runtime that differ on Windows. When a program is built for Windows, the compiler looks for each
// builtin's implementation here first (`std::native_windows::__rt_<name>`) and in `std::native` after that; what this module
// does not define is the same on both systems. The functions of kernel32 are the `extern "C"` functions whose names begin
// with a capital letter.

extern "C" fun malloc(size: u64) -> *u8;
extern "C" fun free(pointer: *u8);
extern "C" fun realloc(pointer: *u8, size: u64) -> *u8;

extern "C" fun CreateProcessW(application: *u8, command: *u8, process_attributes: *u8, thread_attributes: *u8, inherit: i32, flags: u32, environment: *u8, directory: *u8, startup: *u8, information: *u8) -> i32;
extern "C" fun WaitForSingleObject(handle: *u8, milliseconds: u32) -> u32;
extern "C" fun GetExitCodeProcess(handle: *u8, code: *u8) -> i32;
extern "C" fun CloseHandle(handle: *u8) -> i32;
extern "C" fun CreatePipe(read_end: *u8, write_end: *u8, attributes: *u8, size: u32) -> i32;
extern "C" fun PeekNamedPipe(handle: *u8, buffer: *u8, size: u32, read: *u8, available: *u8, left: *u8) -> i32;
extern "C" fun ReadFile(handle: *u8, buffer: *u8, size: u32, read: *u8, overlapped: *u8) -> i32;
extern "C" fun SetHandleInformation(handle: *u8, mask: u32, flags: u32) -> i32;
extern "C" fun GetStdHandle(which: u32) -> *u8;
extern "C" fun MultiByteToWideChar(code_page: u32, flags: u32, text: *u8, length: i32, wide: *u8, capacity: i32) -> i32;
extern "C" fun Sleep(milliseconds: u32);

fun word64_at(pointer: *u8, offset: u64) -> u64 {
    cell := ((pointer as u64) + offset) as *u64
    return *cell
}

fun set_word64_at(pointer: *u8, offset: u64, value: u64) {
    cell := ((pointer as u64) + offset) as *u64
    *cell = value
}

fun set_word32_at(pointer: *u8, offset: u64, value: u32) {
    cell := ((pointer as u64) + offset) as *u32
    *cell = value
}

fun word32_at(pointer: *u8, offset: u64) -> u32 {
    cell := ((pointer as u64) + offset) as *u32
    return *cell
}

fun byte_of(pointer: *u8, offset: u64) -> u8 {
    cell := ((pointer as u64) + offset) as *u8
    return *cell
}

fun zeroed(size: u64) -> *u8 {
    block := malloc(size)
    mut at: u64 = 0
    while at < size {
        cell := ((block as u64) + at) as *u8
        *cell = 0 as u8
        at += 1
    }
    return block
}

// The text in C memory with a terminating zero.
fun c_text_of(text: String) -> *u8 {
    block := malloc(text.len() + 1)
    mut at: u64 = 0
    while at < text.len() {
        cell := ((block as u64) + at) as *u8
        *cell = text.byte_at(at)
        at += 1
    }
    end := ((block as u64) + text.len()) as *u8
    *end = 0 as u8
    return block
}

// The text in UTF-16 with a terminating zero, in C memory.
fun wide_text_of(text: String) -> *u8 {
    c := c_text_of(text.clone())
    count := MultiByteToWideChar(65001 as u32, 0 as u32, c, -1, 0 as *u8, 0)
    wide := zeroed(((count as u64) + 1) * 2)
    converted := MultiByteToWideChar(65001 as u32, 0 as u32, c, -1, wide, count)
    free(c)
    return wide
}

// One argument of a command line, quoted the way `CommandLineToArgvW` reads it back.
fun quote_argument(argument: String) -> String {
    mut needs_quotes := argument.is_empty()
    mut at: u64 = 0
    while at < argument.len() {
        byte := argument.byte_at(at) as u64
        when byte == 32 || byte == 9 || byte == 34 || byte == 10 {
            needs_quotes = true
        }
        at += 1
    }
    when !needs_quotes {
        return argument
    }
    mut out := String("\"")
    mut backslashes: u64 = 0
    at = 0
    while at < argument.len() {
        byte := argument.byte_at(at) as u64
        when byte == 92 {
            backslashes += 1
            out.append(argument.slice(at, at + 1))
        } else when byte == 34 {
            // The backslashes before a quote are doubled, and the quote is escaped.
            while backslashes > 0 {
                out.append("\\")
                backslashes -= 1
            }
            out.append("\\\"")
        } else {
            backslashes = 0
            out.append(argument.slice(at, at + 1))
        }
        at += 1
    }
    while backslashes > 0 {
        out.append("\\")
        backslashes -= 1
    }
    out.append("\"")
    return out
}

fun command_line(program: String, arguments: Vec<String>) -> String {
    mut line := quote_argument(program)
    for argument in arguments {
        line.append(" ")
        line.append(quote_argument(argument))
    }
    return line
}

// Starts the program with the three standard handles `input`, `output` and `error`; the process handle, or 0.
fun start(program: String, arguments: Vec<String>, input: *u8, output: *u8, error: *u8) -> *u8 {
    command := wide_text_of(command_line(program, arguments))
    startup := zeroed(104)
    set_word32_at(startup, 0, 104 as u32)
    set_word32_at(startup, 60, 256 as u32)
    set_word64_at(startup, 80, input as u64)
    set_word64_at(startup, 88, output as u64)
    set_word64_at(startup, 96, error as u64)
    information := zeroed(24)
    created := CreateProcessW(0 as *u8, command, 0 as *u8, 0 as *u8, 1, 0 as u32, 0 as *u8, 0 as *u8, startup, information)
    process := word64_at(information, 0)
    when created != 0 {
        closed := CloseHandle(word64_at(information, 8) as *u8)
    }
    free(command)
    free(startup)
    free(information)
    when created == 0 {
        return 0 as *u8
    }
    return process as *u8
}

// Waits for the process, closes it, and answers its exit code.
fun finish(process: *u8) -> i32 {
    waited := WaitForSingleObject(process, 4294967295 as u32)
    code := zeroed(8)
    got := GetExitCodeProcess(process, code)
    result := word32_at(code, 0)
    free(code)
    closed := CloseHandle(process)
    return result as i32
}

fun run_program(program: String, arguments: Vec<String>) -> i32 {
    process := start(program, arguments, GetStdHandle(4294967286 as u32), GetStdHandle(4294967285 as u32), GetStdHandle(4294967284 as u32))
    when (process as u64) == 0 {
        return -1
    }
    return finish(process)
}

pub fun __rt_system_run_process(program_given: str) -> i32 {
    arguments: Vec<String> = Vec()
    return run_program(String(program_given), arguments)
}

pub fun __rt_system_run_process_args(program_given: str, arguments: Vec<String>) -> i32 {
    return run_program(String(program_given), arguments)
}

// A growing buffer: the data pointer, the length and the capacity, as three words.
fun buffer_append(buffer: *u8, source: *u8, count: u64) {
    length := word64_at(buffer, 8)
    mut capacity := word64_at(buffer, 16)
    mut data := word64_at(buffer, 0) as *u8
    when length + count > capacity {
        capacity = 2 * (length + count) + 64
        data = realloc(data, capacity)
        set_word64_at(buffer, 0, data as u64)
        set_word64_at(buffer, 16, capacity)
    }
    mut at: u64 = 0
    while at < count {
        from := ((source as u64) + at) as *u8
        to := ((data as u64) + length + at) as *u8
        *to = *from
        at += 1
    }
    set_word64_at(buffer, 8, length + count)
}

// Moves what is waiting in a pipe to its buffer: 1 when something was moved, 0 when nothing is waiting, and -1 when the
// pipe is closed and empty.
fun drain(pipe: *u8, buffer: *u8, chunk: *u8, scratch: *u8) -> i32 {
    peeked := PeekNamedPipe(pipe, 0 as *u8, 0 as u32, 0 as *u8, scratch, 0 as *u8)
    when peeked == 0 {
        return -1
    }
    available := word32_at(scratch, 0)
    when available == 0 {
        return 0
    }
    mut want := available
    when want > 4096 {
        want = 4096 as u32
    }
    got := ReadFile(pipe, chunk, want, scratch, 0 as *u8)
    when got == 0 {
        return -1
    }
    count := word32_at(scratch, 0)
    when count == 0 {
        return -1
    }
    buffer_append(buffer, chunk, count as u64)
    return 1
}

// Runs a program to its end with its output captured. A program that cannot be started gives -1 and no output. The record:
// the exit code, then the pointer and length of the standard output and of the standard error.
fun capture_program(program: String, arguments: Vec<String>) -> *u8 {
    record := zeroed(40)
    set_word64_at(record, 0, 18446744073709551615)
    attributes := zeroed(24)
    set_word32_at(attributes, 0, 24 as u32)
    set_word32_at(attributes, 16, 1 as u32)
    out_read := zeroed(8)
    out_write := zeroed(8)
    err_read := zeroed(8)
    err_write := zeroed(8)
    made_out := CreatePipe(out_read, out_write, attributes, 0 as u32)
    made_err := CreatePipe(err_read, err_write, attributes, 0 as u32)
    reading_out := word64_at(out_read, 0) as *u8
    writing_out := word64_at(out_write, 0) as *u8
    reading_err := word64_at(err_read, 0) as *u8
    writing_err := word64_at(err_write, 0) as *u8
    free(attributes)
    free(out_read)
    free(out_write)
    free(err_read)
    free(err_write)
    when made_out == 0 || made_err == 0 {
        return record
    }
    kept_out := SetHandleInformation(reading_out, 1 as u32, 0 as u32)
    kept_err := SetHandleInformation(reading_err, 1 as u32, 0 as u32)
    process := start(program, arguments, 0 as *u8, writing_out, writing_err)
    closed_out := CloseHandle(writing_out)
    closed_err := CloseHandle(writing_err)
    when (process as u64) == 0 {
        closed_a := CloseHandle(reading_out)
        closed_b := CloseHandle(reading_err)
        return record
    }
    stdout_buffer := zeroed(24)
    stderr_buffer := zeroed(24)
    chunk := malloc(4096)
    scratch := zeroed(8)
    mut open_out := true
    mut open_err := true
    while open_out || open_err {
        mut moved := false
        when open_out {
            state := drain(reading_out, stdout_buffer, chunk, scratch)
            when state < 0 {
                open_out = false
            } else when state > 0 {
                moved = true
            }
        }
        when open_err {
            state := drain(reading_err, stderr_buffer, chunk, scratch)
            when state < 0 {
                open_err = false
            } else when state > 0 {
                moved = true
            }
        }
        when !moved && (open_out || open_err) {
            Sleep(1 as u32)
        }
    }
    free(chunk)
    free(scratch)
    closed_a := CloseHandle(reading_out)
    closed_b := CloseHandle(reading_err)
    set_word64_at(record, 0, (finish(process) as i64) as u64)
    set_word64_at(record, 8, word64_at(stdout_buffer, 0))
    set_word64_at(record, 16, word64_at(stdout_buffer, 8))
    set_word64_at(record, 24, word64_at(stderr_buffer, 0))
    set_word64_at(record, 32, word64_at(stderr_buffer, 8))
    free(stdout_buffer)
    free(stderr_buffer)
    return record
}

pub fun __rt_system_process_capture(program_given: str, arguments: Vec<String>) -> *u8 {
    return capture_program(String(program_given), arguments)
}

// The peak memory of a captured child is not measured on Windows.
pub fun __rt_system_process_capture_peak_kb(capture: *u8) -> u64 {
    return 0
}

// ---------------------------------------------------------------------------------------------------------------------
// Directories, paths and time

extern "C" fun FindFirstFileW(pattern: *u8, data: *u8) -> *u8;
extern "C" fun FindNextFileW(handle: *u8, data: *u8) -> i32;
extern "C" fun FindClose(handle: *u8) -> i32;
extern "C" fun WideCharToMultiByte(code_page: u32, flags: u32, wide: *u8, length: i32, text: *u8, capacity: i32, default_char: *u8, used: *u8) -> i32;
extern "C" fun GetFileAttributesW(path: *u8) -> u32;
extern "C" fun DeleteFileW(path: *u8) -> i32;
extern "C" fun RemoveDirectoryW(path: *u8) -> i32;
extern "C" fun GetModuleFileNameW(module: *u8, buffer: *u8, size: u32) -> u32;
extern "C" fun GetTempPathW(size: u32, buffer: *u8) -> u32;
extern "C" fun GetSystemTimePreciseAsFileTime(out: *u8);
extern "C" fun QueryPerformanceCounter(out: *u8) -> i32;
extern "C" fun QueryPerformanceFrequency(out: *u8) -> i32;
extern "C" fun getenv(name: *u8) -> *u8;
extern "C" fun strlen(text: *u8) -> u64;

// The UTF-8 text of a zero-terminated UTF-16 string, with `/` for the path separators.
fun text_of_wide(wide: *u8) -> String {
    size := WideCharToMultiByte(65001 as u32, 0 as u32, wide, -1, 0 as *u8, 0, 0 as *u8, 0 as *u8)
    when size <= 1 {
        return String("")
    }
    buffer := zeroed((size as u64) + 1)
    converted := WideCharToMultiByte(65001 as u32, 0 as u32, wide, -1, buffer, size, 0 as *u8, 0 as *u8)
    mut at: u64 = 0
    while at < (size as u64) {
        when (byte_of(buffer, at) as u64) == 92 {
            cell := ((buffer as u64) + at) as *u8
            *cell = 47 as u8
        }
        at += 1
    }
    text := __native_string_from_raw(buffer, (size as u64) - 1)
    free(buffer)
    return text
}

fun join_text(base: String, name: String) -> String {
    mut out := base.clone()
    when !out.is_empty() && !out.ends_with("/") {
        out.append("/")
    }
    out.append(name)
    return out
}

// The names in a directory, without `.` and `..`; nothing when it cannot be listed.
fun directory_names(path: String) -> Option<Vec<String>> {
    mut pattern := path.clone()
    when !pattern.ends_with("/") {
        pattern.append("/")
    }
    pattern.append("*")
    wide := wide_text_of(pattern)
    data := zeroed(600)
    handle := FindFirstFileW(wide, data)
    free(wide)
    when (handle as u64) == 18446744073709551615 {
        free(data)
        return Option::None
    }
    mut names: Vec<String> = Vec()
    mut more := true
    while more {
        name := text_of_wide(((data as u64) + 44) as *u8)
        when name != "." && name != ".." {
            names.push(name)
        }
        more = FindNextFileW(handle, data) != 0
    }
    closed := FindClose(handle)
    free(data)
    return Option::Some(names)
}

fun text_less(left: String, right: String) -> bool {
    mut at: u64 = 0
    while at < left.len() && at < right.len() {
        a := left.byte_at(at)
        b := right.byte_at(at)
        when a != b {
            return a < b
        }
        at += 1
    }
    return left.len() < right.len()
}

pub fun __rt_filesystem_read_dir(path_given: str) -> Vec<String> {
    path := String(path_given)
    names := directory_names(path.clone())
    mut entries: Vec<String> = Vec()
    when names.is_none() {
        return entries
    }
    for entry in names.unwrap() {
        entries.push(join_text(path.clone(), entry))
    }
    mut at: u64 = 1
    while at < entries.len() {
        mut position := at
        while position > 0 && text_less(entries[position].clone(), entries[position - 1].clone()) {
            earlier := entries[position - 1].clone()
            later := entries[position].clone()
            entries.set(position - 1, later)
            entries.set(position, earlier)
            position -= 1
        }
        at += 1
    }
    return entries
}

pub fun __rt_filesystem_delete_dir_all(path_given: str) -> bool {
    path := String(path_given)
    wide := wide_text_of(path.clone())
    attributes := GetFileAttributesW(wide)
    when attributes == 4294967295 {
        free(wide)
        return false
    }
    when ((attributes as u64) & 16) == 0 {
        removed := DeleteFileW(wide)
        free(wide)
        return removed != 0
    }
    names := directory_names(path.clone())
    when names.is_none() {
        free(wide)
        return false
    }
    for entry in names.unwrap() {
        child := join_text(path.clone(), entry)
        when !__rt_filesystem_delete_dir_all(child) {
            free(wide)
            return false
        }
    }
    removed := RemoveDirectoryW(wide)
    free(wide)
    return removed != 0
}

pub fun __rt_system_executable_path() -> String {
    buffer := zeroed(65536)
    count := GetModuleFileNameW(0 as *u8, buffer, 32768 as u32)
    text := text_of_wide(buffer)
    free(buffer)
    return text
}

pub fun __rt_system_temp_dir() -> String {
    buffer := zeroed(65536)
    count := GetTempPathW(32768 as u32, buffer)
    mut text := text_of_wide(buffer)
    free(buffer)
    when text.len() > 1 && text.ends_with("/") {
        text = text.slice(0, text.len() - 1)
    }
    return text
}

pub fun __rt_system_home_dir() -> String {
    name := c_text_of(String("USERPROFILE"))
    value := getenv(name)
    free(name)
    when (value as u64) == 0 {
        return String("")
    }
    mut text := __native_string_from_raw(value, strlen(value))
    return text
}

pub fun __rt_system_time_unix() -> f64 {
    stamp := zeroed(8)
    GetSystemTimePreciseAsFileTime(stamp)
    ticks := word64_at(stamp, 0)
    free(stamp)
    return ((ticks - 116444736000000000) as f64) / 10000000.0
}

pub fun __rt_system_time_monotonic() -> f64 {
    counter := zeroed(8)
    frequency := zeroed(8)
    got := QueryPerformanceCounter(counter)
    rate := QueryPerformanceFrequency(frequency)
    seconds := (word64_at(counter, 0) as f64) / (word64_at(frequency, 0) as f64)
    free(counter)
    free(frequency)
    return seconds
}

pub fun __rt_system_time_elapsed(started: f64) -> f64 {
    return __rt_system_time_monotonic() - started
}

pub fun __rt_system_sleep(milliseconds: u64) {
    Sleep(milliseconds as u32)
}

pub fun __rt_system_os() -> String {
    return String("windows")
}

extern "C" fun GetCurrentDirectoryW(size: u32, buffer: *u8) -> u32;
extern "C" fun GetFullPathNameW(path: *u8, size: u32, buffer: *u8, file_part: *u8) -> u32;

pub fun __rt_system_current_dir() -> String {
    buffer := zeroed(65536)
    count := GetCurrentDirectoryW(32768 as u32, buffer)
    text := text_of_wide(buffer)
    free(buffer)
    return text
}

// The absolute path of an existing file or directory, or an empty text; links are not resolved.
pub fun __rt_filesystem_path_canonical(path_given: str) -> String {
    wide := wide_text_of(String(path_given))
    attributes := GetFileAttributesW(wide)
    when attributes == 4294967295 {
        free(wide)
        return String("")
    }
    buffer := zeroed(65536)
    count := GetFullPathNameW(wide, 32768 as u32, buffer, 0 as *u8)
    free(wide)
    mut text := text_of_wide(buffer)
    free(buffer)
    when text.len() > 3 && text.ends_with("/") {
        text = text.slice(0, text.len() - 1)
    }
    return text
}

// ---------------------------------------------------------------------------------------------------------------------
// Dynamic libraries

extern "C" fun LoadLibraryA(path: *u8) -> *u8;
extern "C" fun GetProcAddress(library: *u8, name: *u8) -> *u8;
extern "C" fun FreeLibrary(library: *u8) -> i32;

pub fun __rt_system_load_library(path_given: str) -> *u8 {
    name := c_text_of(String(path_given))
    library := LoadLibraryA(name)
    free(name)
    return library
}

pub fun __rt_system_load_symbol(library: *u8, name_given: str) -> *u8 {
    when (library as u64) == 0 {
        return 0 as *u8
    }
    text := c_text_of(String(name_given))
    symbol := GetProcAddress(library, text)
    free(text)
    return symbol
}

pub fun __rt_system_unload_library(library: *u8) -> bool {
    when (library as u64) == 0 {
        return false
    }
    return FreeLibrary(library) != 0
}
