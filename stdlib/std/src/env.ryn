pub fun get(name: str) -> String { return __env_get(name) }
pub fun env(name: str) -> String { return __env_get(name) }
pub fun set(name: str, value: str) -> bool { return set_env(name, value) }
pub fun set_env(name: str, value: str) -> bool { return __env_set(name, value) }
pub fun remove(name: str) -> bool { return remove_env(name) }

pub fun current_dir() -> String { return __current_dir() }
pub fun set_current_dir(path: str) -> bool { return __set_current_dir(path) }
pub fun home_dir() -> String { return __home_dir() }
pub fun temp_dir() -> String { return __temp_dir() }
pub fun executable_path() -> String { return __executable_path() }
