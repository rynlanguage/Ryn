// Reads textual IR, decodes it into the Ryn data model, encodes it again, and writes the
// result to the second path. The Rust test compares that output with the original text.

use std::fs
use ir

fun main() -> i32 {
    when arg_count() != 2 {
        echo "usage: ryn-ir-roundtrip <input.ir> <output.ir>"
        return 2
    }
    text := fs::read_text(arg(0))
    decoded := ir::decode_ir(text)
    when decoded.is_err() {
        echo "invalid IR text"
        return 1
    }
    fs::write(arg(1), ir::encode_ir(decoded.unwrap()))
    return 0
}
