// Reads a successful syntax tree written by the frontend, decodes it into the Ryn data model,
// encodes it again, and writes the result to the second path. The Rust test compares that
// output with the original text.

use std::fs
use ast

fun main() -> i32 {
    when arg_count() != 2 {
        echo "usage: ryn-ast-roundtrip <input.ast> <output.ast>"
        return 2
    }
    text := fs::read_text(arg(0))
    decoded := ast::decode_program(text)
    when decoded.is_err() {
        echo "invalid syntax tree text"
        return 1
    }
    fs::write(arg(1), ast::encode_program(decoded.unwrap()))
    return 0
}
