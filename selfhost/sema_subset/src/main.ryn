// Lowers a syntax tree (written by the frontend or `ast_codec::encode_program`) to textual IR
// for the supported subset. Prints `unsupported` and exits 3 for anything outside the subset.

use std::fs
use ast_roundtrip::ast
use lower

fun main() -> i32 {
    when arg_count() != 2 {
        echo "usage: ryn-sema-subset <input.ast> <output.ir>"
        return 2
    }
    text := fs::read_text(arg(0))
    decoded := ast::decode_program(text)
    when decoded.is_err() {
        echo "invalid syntax tree text"
        return 1
    }
    lowered := lower::lower_program(decoded.unwrap())
    when lowered.is_err() {
        echo lowered.unwrap_err()
        return 3
    }
    fs::write(arg(1), lowered.unwrap())
    return 0
}
