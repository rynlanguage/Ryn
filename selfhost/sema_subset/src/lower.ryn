// Lowers the subset of programs that the syntax tree model can express into the textual IR
// that `ryn::ir_codec::encode_ir` writes, as the bootstrap compiler's `sema` and `guard` do.
//
// The subset is one function, `main`, with no parameters and an optional `-> i32` result;
// `i32`, `i64`, and `str` locals; integer arithmetic; string literals; `echo` and template
// prints; `let`; `=`; and compound assignment. Anything else is reported as `unsupported`.

use ast_roundtrip::ast

pub struct Local {
    name: String,
    slot: u64,
    ty: String,
    mutable: bool,
}

pub struct Lowered {
    text: String,
    ty: String,
}

// A function's IR-level signature: parameter type words and the result word ("" for none).
pub struct Signature {
    name: String,
    params: Vec<String>,
    ret: String,
}

// The lowered statements of one branch, and whether control falls off its end.
pub struct Block {
    items: Vec<String>,
    falls: bool,
}

pub struct Lowering {
    program: ast::Program,
    signatures: Vec<Signature>,
    locals: Vec<Local>,
    local_types: Vec<String>,
    addressed: u64,
    next_slot: u64,
    statements: Vec<String>,
    return_ty: String,
}

// Joins tokens with single spaces. A token may hold spaces itself, as a length-prefixed string does.
fun join(tokens: Vec<String>) -> String {
    mut out := String("")
    mut first := true
    for token in tokens {
        when !first {
            out.append(" ")
        }
        out.append(token)
        first = false
    }
    return out
}

fun num(value: u64) -> String {
    return String(value)
}

// `<byte length>:<bytes>`, the form the IR uses for strings.
fun length_prefixed(text: String) -> String {
    mut out := String(text.len())
    out.append(":")
    out.append(text)
    return out
}

fun unsupported(what: str) -> String {
    mut out := String("unsupported: ")
    out.append(what)
    return out
}

fun words2(a: String, b: String) -> Vec<String> {
    mut items: Vec<String> = Vec()
    items.push(a)
    items.push(b)
    return items
}

fun words3(a: String, b: String, c: String) -> Vec<String> {
    mut items: Vec<String> = Vec()
    items.push(a)
    items.push(b)
    items.push(c)
    return items
}

fun words4(a: String, b: String, c: String, d: String) -> Vec<String> {
    mut items: Vec<String> = Vec()
    items.push(a)
    items.push(b)
    items.push(c)
    items.push(d)
    return items
}

fun words5(a: String, b: String, c: String, d: String, e: String) -> Vec<String> {
    mut items: Vec<String> = Vec()
    items.push(a)
    items.push(b)
    items.push(c)
    items.push(d)
    items.push(e)
    return items
}

fun words6(a: String, b: String, c: String, d: String, e: String, f: String) -> Vec<String> {
    mut items: Vec<String> = Vec()
    items.push(a)
    items.push(b)
    items.push(c)
    items.push(d)
    items.push(e)
    items.push(f)
    return items
}

// The IR word for a binary operator the subset supports.
fun operator_word(op: String) -> Result<String, String> {
    when op == "Add" || op == "Sub" || op == "Mul" || op == "Div" || op == "Rem" {
        return Result::Ok(op)
    }
    return Result::Err(unsupported("operator"))
}

fun is_comparison(op: String) -> bool {
    return op == "Eq" || op == "Ne" || op == "Lt" || op == "Le" || op == "Gt" || op == "Ge"
}

fun is_logical(op: String) -> bool {
    return op == "And" || op == "Or"
}

fun is_integer_word(ty: String) -> bool {
    return ty == "I32" || ty == "I64"
}

// The IR word for a simple type name in the subset.
fun type_word(word: String) -> Result<String, String> {
    when word == "i32" {
        return Result::Ok(String("I32"))
    }
    when word == "i64" {
        return Result::Ok(String("I64"))
    }
    when word == "str" {
        return Result::Ok(String("Str"))
    }
    when word == "bool" {
        return Result::Ok(String("Bool"))
    }
    return Result::Err(unsupported("type"))
}

fun ryn_preamble_words() -> Vec<String> {
    mut items: Vec<String> = Vec()
    items.push(String("I8"))
    items.push(String("I16"))
    items.push(String("I32"))
    items.push(String("I64"))
    items.push(String("U8"))
    items.push(String("U16"))
    items.push(String("U32"))
    items.push(String("U64"))
    items.push(String("F32"))
    items.push(String("F64"))
    items.push(String("OwnedString"))
    return items
}

fun text_part(text: String) -> Result<String, String> {
    return Result::Ok(join(words2(String("Text"), length_prefixed(text))))
}

// `$RynOption#<name>`: `Some(payload)` and `None`, as the bootstrap compiler registers it.
fun option_record(name: String, payload: String) -> String {
    mut tokens: Vec<String> = Vec()
    tokens.push(length_prefixed(name))
    tokens.push(String("2"))
    tokens.push(String("4:Some"))
    tokens.push(String("1"))
    tokens.push(payload)
    tokens.push(String("4:None"))
    tokens.push(String("0"))
    return join(tokens)
}

// `$RynResult#...`: `Ok(ok)` and `Err(err)`.
fun result_record(name: String, ok: String, err: String) -> String {
    mut tokens: Vec<String> = Vec()
    tokens.push(length_prefixed(name))
    tokens.push(String("2"))
    tokens.push(String("2:Ok"))
    tokens.push(String("1"))
    tokens.push(ok)
    tokens.push(String("3:Err"))
    tokens.push(String("1"))
    tokens.push(err)
    return join(tokens)
}

// The generated enums every IR text starts with. `sema::analyze` registers them in this order,
// skipping `TryParseU64` because `FindU64` already has a `u64` payload.
fun enum_records() -> Vec<String> {
    mut records: Vec<String> = Vec()
    records.push(option_record(String("$RynOption#FindU64"), String("U64")))
    records.push(option_record(String("$RynOption#FileString"), String("OwnedString")))
    mut try_parse: Vec<String> = Vec()
    try_parse.push(String("I8"))
    try_parse.push(String("I16"))
    try_parse.push(String("I32"))
    try_parse.push(String("I64"))
    try_parse.push(String("U8"))
    try_parse.push(String("U16"))
    try_parse.push(String("U32"))
    try_parse.push(String("F32"))
    try_parse.push(String("F64"))
    try_parse.push(String("Bool"))
    try_parse.push(String("Char"))
    mut index: u64 = 0
    while index < try_parse.len() {
        mut name := String("$RynOption#TryParse")
        name.append(try_parse[index].clone())
        records.push(option_record(name, try_parse[index].clone()))
        index += 1
    }
    primitive := ryn_preamble_words()
    mut left: u64 = 0
    while left < primitive.len() {
        mut right: u64 = 0
        while right < primitive.len() {
            mut name := String("$RynResult#")
            name.append(String(left))
            name.append("#")
            name.append(String(right))
            records.push(result_record(name, primitive[left].clone(), primitive[right].clone()))
            right += 1
        }
        left += 1
    }
    mut parse_index: u64 = 0
    while parse_index < 10 {
        mut name := String("$RynResult#Parse")
        name.append(String(parse_index))
        name.append("String")
        records.push(result_record(name, primitive[parse_index].clone(), String("OwnedString")))
        parse_index += 1
    }
    return records
}

extend Lowering {
    fun find(self, name: String) -> Result<u64, String> {
        mut index: u64 = self.locals.len()
        while index > 0 {
            index -= 1
            when self.locals[index].name == name {
                return Result::Ok(index)
            }
        }
        return Result::Err(unsupported("unknown name"))
    }

    fun declared(self, name: String) -> bool {
        mut index: u64 = 0
        while index < self.locals.len() {
            when self.locals[index].name == name {
                return true
            }
            index += 1
        }
        return false
    }

    // Allocates the slots a value of `ty` takes, as `sema` does: `str` takes a pointer and a
    // length, and each scalar takes one. Each allocation adds one addressed entry.
    fun allocate(mut self, ty: String) -> Result<u64, String> {
        slot := self.next_slot
        self.addressed += 1
        when ty == "I32" {
            self.local_types.push(String("I32"))
            self.next_slot += 1
            return Result::Ok(slot)
        }
        when ty == "I64" {
            self.local_types.push(String("I64"))
            self.next_slot += 1
            return Result::Ok(slot)
        }
        when ty == "Bool" {
            self.local_types.push(String("I8"))
            self.next_slot += 1
            return Result::Ok(slot)
        }
        when ty == "Str" {
            self.local_types.push(String("Ptr"))
            self.local_types.push(String("I64"))
            self.next_slot += 2
            return Result::Ok(slot)
        }
        return Result::Err(unsupported("local type"))
    }

    fun annotation(self, index: u64) -> Result<String, String> {
        choose self.program.types[index] {
            ast::TypeNode::Simple(word) => type_word(word),
            _ => Result::Err(unsupported("type")),
        }
    }

    // The type of an expression when it does not depend on context; "" when it does.
    fun infer(self, index: u64) -> Result<String, String> {
        choose self.program.exprs[index] {
            ast::Expr::NameRef(name, span) => self.local_type(name),
            ast::Expr::BinaryE(op, left, right, span) => self.binary_result_type(op, left, right),
            ast::Expr::BoolLit(value, span) => Result::Ok(String("Bool")),
            ast::Expr::NotE(value, span) => Result::Ok(String("Bool")),
            ast::Expr::IntLit(value, span) => Result::Ok(String("")),
            ast::Expr::StrLit(text, span) => Result::Ok(String("Str")),
            ast::Expr::CallE(name, type_arguments, arguments, span) => self.call_result_type(name),
            _ => Result::Err(unsupported("expression")),
        }
    }

    fun call_result_type(self, name: String) -> Result<String, String> {
        id := self.signature_index(name)?
        return Result::Ok(self.signatures[id].ret.clone())
    }

    fun signature_index(self, name: String) -> Result<u64, String> {
        mut id: u64 = 0
        while id < self.signatures.len() {
            when self.signatures[id].name == name {
                return Result::Ok(id)
            }
            id += 1
        }
        return Result::Err(unsupported("unknown function"))
    }

    fun local_type(self, name: String) -> Result<String, String> {
        index := self.find(name)?
        return Result::Ok(self.locals[index].ty.clone())
    }

    fun binary_result_type(self, op: String, left: u64, right: u64) -> Result<String, String> {
        when is_comparison(op.clone()) || is_logical(op) {
            return Result::Ok(String("Bool"))
        }
        return self.binary_type(left, right)
    }

    fun binary_type(self, left: u64, right: u64) -> Result<String, String> {
        ty := self.infer(left)?
        when !ty.is_empty() {
            return Result::Ok(ty)
        }
        return self.infer(right)
    }

    fun expression(mut self, index: u64, expected: String) -> Result<Lowered, String> {
        choose self.program.exprs[index] {
            ast::Expr::IntLit(value, span) => self.integer(value, expected),
            ast::Expr::StrLit(text, span) => self.string_literal(text),
            ast::Expr::NameRef(name, span) => self.name(name, span),
            ast::Expr::BinaryE(op, left, right, span) => self.binary(op, left, right, expected),
            ast::Expr::BoolLit(value, span) => self.boolean_literal(value, expected),
            ast::Expr::NotE(value, span) => self.negation(value, expected),
            ast::Expr::CallE(name, type_arguments, arguments, span) => self.call(name, type_arguments, arguments, expected),
            _ => Result::Err(unsupported("expression")),
        }
    }

    fun integer(self, value: u64, expected: String) -> Result<Lowered, String> {
        mut ty := expected.clone()
        when ty.is_empty() {
            ty = String("I64")
        }
        when !is_integer_word(ty.clone()) {
            return Result::Err(unsupported("integer type"))
        }
        text := join(words3(String("Integer"), num(value), ty.clone()))
        return Result::Ok(Lowered { text: text, ty: ty })
    }

    fun string_literal(self, text: String) -> Result<Lowered, String> {
        tokens := join(words2(String("String"), length_prefixed(text)))
        return Result::Ok(Lowered { text: tokens, ty: String("Str") })
    }

    fun name(self, name: String, span: ast::Span) -> Result<Lowered, String> {
        index := self.find(name)?
        slot := self.locals[index].slot
        ty := self.locals[index].ty.clone()
        text := join(words5(String("Local"), num(slot), ty.clone(), num(span.start), num(span.end)))
        return Result::Ok(Lowered { text: text, ty: ty })
    }

    fun boolean_literal(self, value: bool, expected: String) -> Result<Lowered, String> {
        when !expected.is_empty() && expected != "Bool" {
            return Result::Err(unsupported("boolean where another type is expected"))
        }
        mut bit: u64 = 0
        when value {
            bit = 1
        }
        return Result::Ok(Lowered { text: join(words2(String("Boolean"), num(bit))), ty: String("Bool") })
    }

    fun negation(mut self, value: u64, expected: String) -> Result<Lowered, String> {
        when !expected.is_empty() && expected != "Bool" {
            return Result::Err(unsupported("boolean where another type is expected"))
        }
        operand := self.expression(value, String("Bool"))?
        when operand.ty != "Bool" {
            return Result::Err(unsupported("negation of a non-boolean"))
        }
        return Result::Ok(Lowered { text: join(words2(String("Not"), operand.text)), ty: String("Bool") })
    }

    fun binary(mut self, op: String, left: u64, right: u64, expected: String) -> Result<Lowered, String> {
        when is_logical(op.clone()) {
            when !expected.is_empty() && expected != "Bool" {
                return Result::Err(unsupported("boolean where another type is expected"))
            }
            lhs := self.expression(left, String("Bool"))?
            rhs := self.expression(right, String("Bool"))?
            when lhs.ty != "Bool" || rhs.ty != "Bool" {
                return Result::Err(unsupported("logical operator on non-boolean operands"))
            }
            text := join(words5(String("Binary"), op, lhs.text, rhs.text, String("Bool")))
            return Result::Ok(Lowered { text: text, ty: String("Bool") })
        }
        when is_comparison(op.clone()) {
            when !expected.is_empty() && expected != "Bool" {
                return Result::Err(unsupported("comparison where another type is expected"))
            }
            mut operand_ty := self.binary_type(left, right)?
            when operand_ty.is_empty() {
                operand_ty = String("I64")
            }
            when !is_integer_word(operand_ty.clone()) {
                return Result::Err(unsupported("comparison of this type"))
            }
            lhs := self.expression(left, operand_ty.clone())?
            rhs := self.expression(right, operand_ty.clone())?
            when lhs.ty != operand_ty || rhs.ty != operand_ty {
                return Result::Err(unsupported("mixed operand types"))
            }
            text := join(words5(String("Binary"), op, lhs.text, rhs.text, operand_ty))
            return Result::Ok(Lowered { text: text, ty: String("Bool") })
        }
        mut ty := expected.clone()
        when ty.is_empty() {
            ty = self.binary_type(left, right)?
        }
        when ty.is_empty() {
            ty = String("I64")
        }
        when !is_integer_word(ty.clone()) {
            return Result::Err(unsupported("arithmetic on this type"))
        }
        word := operator_word(op)?
        lhs := self.expression(left, ty.clone())?
        rhs := self.expression(right, ty.clone())?
        when lhs.ty != ty || rhs.ty != ty {
            return Result::Err(unsupported("mixed operand types"))
        }
        text := join(words5(String("Binary"), word, lhs.text, rhs.text, ty.clone()))
        return Result::Ok(Lowered { text: text, ty: ty })
    }

    // Checks the argument list against a signature and lowers each argument to its parameter type.
    fun arguments(mut self, id: u64, arguments: Vec<u64>) -> Result<Vec<String>, String> {
        params := self.signatures[id].params.clone()
        when arguments.len() != params.len() {
            return Result::Err(unsupported("argument count"))
        }
        mut lowered: Vec<String> = Vec()
        mut position: u64 = 0
        while position < arguments.len() {
            value := self.expression(arguments[position], params[position].clone())?
            when value.ty != params[position] {
                return Result::Err(unsupported("argument type"))
            }
            lowered.push(value.text)
            position += 1
        }
        return Result::Ok(lowered)
    }

    fun call(mut self, name: String, type_arguments: Vec<u64>, arguments: Vec<u64>, expected: String) -> Result<Lowered, String> {
        when !type_arguments.is_empty() {
            return Result::Err(unsupported("generic call"))
        }
        id := self.signature_index(name)?
        ret := self.signatures[id].ret.clone()
        when ret.is_empty() {
            return Result::Err(unsupported("value of a call without a result"))
        }
        when !expected.is_empty() && expected != ret {
            return Result::Err(unsupported("call result type"))
        }
        lowered := self.arguments(id, arguments)?
        mut tokens: Vec<String> = Vec()
        tokens.push(String("Call"))
        tokens.push(String("Function"))
        tokens.push(num(id))
        tokens.push(num(lowered.len()))
        for text in lowered {
            tokens.push(text)
        }
        tokens.push(ret.clone())
        return Result::Ok(Lowered { text: join(tokens), ty: ret })
    }

    fun call_statement(mut self, name: String, type_arguments: Vec<u64>, arguments: Vec<u64>) -> Result<bool, String> {
        when !type_arguments.is_empty() {
            return Result::Err(unsupported("generic call"))
        }
        id := self.signature_index(name)?
        lowered := self.arguments(id, arguments)?
        mut tokens: Vec<String> = Vec()
        tokens.push(String("CallStatement"))
        tokens.push(String("Function"))
        tokens.push(num(id))
        tokens.push(num(lowered.len()))
        for text in lowered {
            tokens.push(text)
        }
        self.statements.push(join(tokens))
        return Result::Ok(false)
    }

    // Lowers the statements of one branch. A branch that falls through ends with `Drop 0`,
    // as `guard::check` adds it to a nested block. Declarations are left to the later subset.
    fun block(mut self, body: Vec<u64>) -> Result<Block, String> {
        locals_before := self.locals.len()
        start := self.statements.len()
        mut falls := true
        for statement in body {
            falls = !self.statement(statement)?
        }
        when self.locals.len() != locals_before {
            return Result::Err(unsupported("declaration inside a branch"))
        }
        when falls {
            self.statements.push(String("Drop 0"))
        }
        mut reversed: Vec<String> = Vec()
        while self.statements.len() > start {
            reversed.push(self.statements.pop().unwrap())
        }
        mut items: Vec<String> = Vec()
        mut index: u64 = reversed.len()
        while index > 0 {
            index -= 1
            items.push(reversed[index].clone())
        }
        return Result::Ok(Block { items: items, falls: falls })
    }

    fun if_statement(mut self, condition: u64, then_body: Vec<u64>, else_body: Vec<u64>) -> Result<bool, String> {
        test := self.expression(condition, String("Bool"))?
        when test.ty != "Bool" {
            return Result::Err(unsupported("condition is not a boolean"))
        }
        then_block := self.block(then_body)?
        else_block := self.block(else_body)?
        mut tokens: Vec<String> = Vec()
        tokens.push(String("IfStatement"))
        tokens.push(test.text)
        tokens.push(num(then_block.items.len()))
        for item in then_block.items {
            tokens.push(item)
        }
        tokens.push(num(else_block.items.len()))
        for item in else_block.items {
            tokens.push(item)
        }
        self.statements.push(join(tokens))
        return Result::Ok(!(then_block.falls || else_block.falls))
    }

    fun template_part(mut self, index: u64) -> Result<String, String> {
        choose self.program.parts[index] {
            ast::TemplatePart::TextPart(text) => text_part(text),
            ast::TemplatePart::ValuePart(value) => self.value_part(value),
        }
    }

    fun value_part(mut self, value: u64) -> Result<String, String> {
        lowered := self.expression(value, String(""))?
        return Result::Ok(join(words3(String("Value"), lowered.text, lowered.ty)))
    }

    // Each statement appends its IR tokens to `statements`; a return reports true.
    fun statement(mut self, index: u64) -> Result<bool, String> {
        choose self.program.stmts[index] {
            ast::Stmt::LetS(name, mutable, annotation, value, span) => self.let_statement(name, mutable, annotation, value, span),
            ast::Stmt::AssignS(name, value, span) => self.assign_statement(name, value, span),
            ast::Stmt::CompoundS(name, op, value, span) => self.compound_statement(name, op, value, span),
            ast::Stmt::PrintS(value, span) => self.print_statement(value),
            ast::Stmt::TemplateS(parts, span) => self.template_statement(parts),
            ast::Stmt::ReturnS(value, span) => self.return_statement(value, span),
            ast::Stmt::CallS(name, type_arguments, arguments, span) => self.call_statement(name, type_arguments, arguments),
            ast::Stmt::IfS(condition, then_body, else_body, span) => self.if_statement(condition, then_body, else_body),
            _ => Result::Err(unsupported("statement")),
        }
    }

    fun let_statement(mut self, name: String, mutable: bool, annotation: Option<u64>, value: u64, span: ast::Span) -> Result<bool, String> {
        mut declared := String("")
        when annotation.is_some() {
            declared = self.annotation(annotation.unwrap())?
        }
        lowered := self.expression(value, declared.clone())?
        mut ty := declared.clone()
        when ty.is_empty() {
            ty = lowered.ty.clone()
        }
        when ty != lowered.ty {
            return Result::Err(unsupported("annotation does not match the value"))
        }
        when self.declared(name.clone()) {
            return Result::Err(unsupported("redeclared name"))
        }
        slot := self.allocate(ty.clone())?
        self.locals.push(Local { name: name, slot: slot, ty: ty.clone(), mutable: mutable })
        self.statements.push(join(words6(String("Let"), num(slot), ty, lowered.text, num(span.start), num(span.end))))
        return Result::Ok(false)
    }

    fun assign_statement(mut self, name: String, value: u64, span: ast::Span) -> Result<bool, String> {
        index := self.find(name)?
        when !self.locals[index].mutable {
            return Result::Err(unsupported("assignment to an immutable local"))
        }
        slot := self.locals[index].slot
        ty := self.locals[index].ty.clone()
        lowered := self.expression(value, ty.clone())?
        self.statements.push(join(words6(String("Assign"), num(slot), ty, lowered.text, num(span.start), num(span.end))))
        return Result::Ok(false)
    }

    // `x op= value` is lowered as `x = x op value`; the name's span is the first `len(x)` bytes.
    fun compound_statement(mut self, name: String, op: String, value: u64, span: ast::Span) -> Result<bool, String> {
        index := self.find(name.clone())?
        when !self.locals[index].mutable {
            return Result::Err(unsupported("assignment to an immutable local"))
        }
        slot := self.locals[index].slot
        ty := self.locals[index].ty.clone()
        when !is_integer_word(ty.clone()) {
            return Result::Err(unsupported("arithmetic on this type"))
        }
        word := operator_word(op)?
        rhs := self.expression(value, ty.clone())?
        end := span.start + name.len()
        target := join(words5(String("Local"), num(slot), ty.clone(), num(span.start), num(end)))
        binary := join(words5(String("Binary"), word, target, rhs.text, ty.clone()))
        self.statements.push(join(words6(String("Assign"), num(slot), ty, binary, num(span.start), num(span.end))))
        return Result::Ok(false)
    }

    fun print_statement(mut self, value: u64) -> Result<bool, String> {
        lowered := self.expression(value, String(""))?
        self.statements.push(join(words3(String("Print"), lowered.text, lowered.ty)))
        return Result::Ok(false)
    }

    fun template_statement(mut self, parts: Vec<u64>) -> Result<bool, String> {
        mut tokens: Vec<String> = Vec()
        tokens.push(String("PrintTemplate"))
        tokens.push(num(parts.len()))
        for part in parts {
            tokens.push(self.template_part(part)?)
        }
        self.statements.push(join(tokens))
        return Result::Ok(false)
    }

    fun return_statement(mut self, value: Option<u64>, span: ast::Span) -> Result<bool, String> {
        when value.is_none() {
            self.statements.push(String("Return -"))
            return Result::Ok(true)
        }
        when self.return_ty.is_empty() {
            return Result::Err(unsupported("return value without a result type"))
        }
        lowered := self.expression(value.unwrap(), self.return_ty.clone())?
        self.statements.push(join(words3(String("Return"), String("+"), lowered.text)))
        return Result::Ok(true)
    }
}

// The IR word for the declared result type of a function.
fun result_type_word(node: ast::TypeNode) -> Result<String, String> {
    choose node {
        ast::TypeNode::Simple(word) => type_word(word),
        _ => Result::Err(unsupported("result type")),
    }
}

// Lowers the program's functions, in source order, and returns the complete IR text, or
// `unsupported: ...` when the program is outside the subset.
pub fun lower_program(program: ast::Program) -> Result<String, String> {
    when !program.uses.is_empty() || !program.structs.is_empty() || !program.enums.is_empty() {
        return Result::Err(unsupported("items other than functions"))
    }
    when !program.type_aliases.is_empty() || !program.extends.is_empty() || !program.shapes.is_empty() {
        return Result::Err(unsupported("items other than functions"))
    }
    count := program.functions.len()
    mut signatures: Vec<Signature> = Vec()
    mut main_index: u64 = count
    mut position: u64 = 0
    while position < count {
        definition := program.function_defs[program.functions[position]]
        when definition.extern_c || definition.external_symbol.is_some() || !definition.type_parameters.is_empty() || !definition.type_parameter_bounds.is_empty() {
            return Result::Err(unsupported("external or generic function"))
        }
        mut params: Vec<String> = Vec()
        mut parameter_index: u64 = 0
        while parameter_index < definition.parameters.len() {
            parameter := program.parameters[definition.parameters[parameter_index]]
            params.push(result_type_word(program.types[parameter.ty])?)
            parameter_index += 1
        }
        mut ret := String("")
        when definition.return_type.is_some() {
            ret = result_type_word(program.types[definition.return_type.unwrap()])?
        }
        when definition.name == "main" {
            when !params.is_empty() {
                return Result::Err(unsupported("main with parameters"))
            }
            main_index = position
        }
        signatures.push(Signature { name: definition.name, params: params, ret: ret })
        position += 1
    }
    when main_index == count {
        return Result::Err(unsupported("no main function"))
    }
    mut lowering := Lowering {
        program: program,
        signatures: signatures,
        locals: Vec(),
        local_types: Vec(),
        addressed: 0,
        next_slot: 0,
        statements: Vec(),
        return_ty: String(""),
    }
    mut functions: Vec<String> = Vec()
    mut id: u64 = 0
    while id < count {
        functions.push(lowering.function(id)?)
        id += 1
    }
    return Result::Ok(assemble(main_index, functions, enum_records()))
}

extend Lowering {
    // Lowers one function body. Its locals, slots, and statements start empty.
    fun function(mut self, id: u64) -> Result<String, String> {
        self.locals = Vec()
        self.local_types = Vec()
        self.addressed = 0
        self.next_slot = 0
        self.statements = Vec()
        self.return_ty = self.signatures[id].ret.clone()
        definition := self.program.function_defs[self.program.functions[id]]
        mut parameters: Vec<String> = Vec()
        mut parameter_index: u64 = 0
        while parameter_index < definition.parameters.len() {
            parameter := self.program.parameters[definition.parameters[parameter_index]]
            ty := self.signatures[id].params[parameter_index].clone()
            slot := self.allocate(ty.clone())?
            self.locals.push(Local { name: parameter.name, slot: slot, ty: ty.clone(), mutable: false })
            parameters.push(num(slot))
            parameters.push(ty)
            parameter_index += 1
        }
        mut falls_through := true
        for statement in definition.body {
            falls_through = !self.statement(statement)?
        }
        when definition.return_value.is_some() {
            when self.return_ty.is_empty() {
                return Result::Err(unsupported("result expression without a result type"))
            }
            lowered := self.expression(definition.return_value.unwrap(), self.return_ty.clone())?
            self.statements.push(join(words3(String("Return"), String("+"), lowered.text)))
            falls_through = false
        }
        when !self.return_ty.is_empty() && falls_through {
            return Result::Err(unsupported("function must return a value"))
        }
        when falls_through {
            self.statements.push(String("Drop 0"))
        }
        return Result::Ok(self.function_text(id, parameters))
    }
}

extend Lowering {
    // One function's IR: parameters, external symbol, result, return value, statements, tables.
    fun function_text(self, id: u64, parameters: Vec<String>) -> String {
        mut tokens: Vec<String> = Vec()
        tokens.push(num(parameters.len() / 2))
        for token in parameters {
            tokens.push(token)
        }
        tokens.push(String("-"))
        ret := self.signatures[id].ret.clone()
        when ret.is_empty() {
            tokens.push(String("-"))
        } else {
            tokens.push(String("+"))
            tokens.push(ret)
        }
        tokens.push(String("-"))
        tokens.push(String("-"))
        local_count := self.local_types.len()
        tokens.push(num(self.statements.len()))
        mut index: u64 = 0
        while index < self.statements.len() {
            tokens.push(self.statements[index].clone())
            index += 1
        }
        tokens.push(num(local_count))
        index = 0
        while index < local_count {
            tokens.push(self.local_types[index].clone())
            index += 1
        }
        tokens.push(num(local_count))
        mut owned: u64 = 0
        while owned < local_count {
            tokens.push(String("-"))
            owned += 1
        }
        tokens.push(num(self.addressed))
        mut addressed: u64 = 0
        while addressed < self.addressed {
            tokens.push(String("-"))
            addressed += 1
        }
        return join(tokens)
    }
}

// The whole IR text: header, builtin enums, and the functions in source order.
fun assemble(main_index: u64, functions: Vec<String>, enums: Vec<String>) -> String {
    mut tokens: Vec<String> = Vec()
    tokens.push(String("Ir"))
    tokens.push(num(main_index))
    tokens.push(String("-"))
    tokens.push(String("0"))
    tokens.push(num(enums.len()))
    for record in enums {
        tokens.push(record)
    }
    tokens.push(num(functions.len()))
    for function in functions {
        tokens.push(function)
    }
    // The bootstrap encoder writes a space before every word, including the first.
    mut out := String(" ")
    out.append(join(tokens))
    return out
}
