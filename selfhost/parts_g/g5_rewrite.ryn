
// ---------------------------------------------------------------------------
// Type inference for call arguments, from local bindings and signatures.

extend Tree {
    // Looks a generic function up by the name a caller uses. Returns the
    // function index plus one, or zero when the name is not generic.
    fun resolve_template(self, name: String, caller: u64) -> u64 {
        when self.templates.contains_key(name.clone()) {
            return self.templates.get(name).unwrap() + 1
        }
        function := self.functions[caller]
        mut local_name := function.name.clone()
        when !function.module_path.is_empty() {
            mut prefix := function.module_path.clone()
            prefix.append("::")
            when !local_name.starts_with(prefix.clone()) {
                return 0
            }
            local_name = local_name.slice(prefix.len(), local_name.len())
        }
        // The caller's namespace: everything before its last `::`.
        mut last_separator: u64 = 0
        mut found := false
        mut index: u64 = 0
        while index + 1 < local_name.len() {
            when local_name.byte_at(index) == 58 && local_name.byte_at(index + 1) == 58 {
                last_separator = index
                found = true
            }
            index += 1
        }
        when found {
            mut qualified := local_name.slice(0, last_separator)
            qualified.append("::")
            qualified.append(name.clone())
            when self.templates.contains_key(qualified.clone()) {
                return self.templates.get(qualified).unwrap() + 1
            }
        }
        when !function.module_path.is_empty() {
            mut qualified := function.module_path.clone()
            qualified.append("::")
            qualified.append(name)
            when self.templates.contains_key(qualified.clone()) {
                return self.templates.get(qualified).unwrap() + 1
            }
        }
        return 0
    }

    fun environment_type(self, environment: Map<String, u64>, name: String) -> u64 {
        when environment.contains_key(name.clone()) {
            return environment.get(name).unwrap()
        }
        return 0
    }

    // Returns the inferred type, or 0 when it is unknown.
    fun infer_type(mut self, index: u64, environment: Map<String, u64>, caller: u64) -> u64 {
        node := self.exprs[index]
        kind := node.kind
        when kind == Ex::INT { return TypeKind::I64 as u64 }
        when kind == Ex::FLOAT { return TypeKind::F64 as u64 }
        when kind == Ex::STR { return TypeKind::STR as u64 }
        when kind == Ex::CHAR { return TypeKind::CHAR as u64 }
        when kind == Ex::BOOL { return TypeKind::BOOL as u64 }
        when kind == Ex::NAME {
            return self.environment_type(environment, node.text)
        }
        when kind == Ex::CAST {
            return node.ty
        }
        when kind == Ex::LAYOUT {
            return TypeKind::U64 as u64
        }
        when kind == Ex::NEW_VEC {
            return self.wrapped(TypeKind::VEC, node.ty, node.start, node.end)
        }
        when kind == Ex::NEW_SET {
            return self.wrapped(TypeKind::SET, node.ty, node.start, node.end)
        }
        when kind == Ex::NEW_MAP {
            mut map := blank_type(TypeKind::MAP)
            map.first = node.ty
            map.second = node.ty2
            map.start = node.start
            map.end = node.end
            return self.new_type(map)
        }
        when kind == Ex::STRUCT {
            return self.named(TypeKind::NAMED, node.text, node.start, node.end)
        }
        when kind == Ex::CALL {
            when node.text == "String" {
                return TypeKind::STRING as u64
            }
            pointer := self.environment_type(environment.clone(), node.text.clone())
            when pointer != 0 && self.types[pointer].kind == TypeKind::FNPTR {
                when self.types[pointer].has_result {
                    return self.types[pointer].first
                }
                return 0
            }
            mut function_index: u64 = 0
            when self.known.contains_key(node.text.clone()) {
                function_index = self.known.get(node.text.clone()).unwrap() + 1
            } else {
                function_index = self.resolve_template(node.text.clone(), caller)
            }
            when function_index == 0 {
                return 0
            }
            function := self.functions[function_index - 1]
            when !function.has_return {
                return 0
            }
            when function.type_params.is_empty() {
                return function.return_type
            }
            mut substitutions := Map<String, u64>()
            mut argument: u64 = 0
            while argument < function.param_types.len() && argument < node.list.len() {
                actual := self.infer_type(node.list[argument], environment.clone(), caller)
                when actual == 0 {
                    return 0
                }
                unified := self.unify(function.param_types[argument], actual, Map<String, u64>(), node.start, node.end)
                when unified.is_err() {
                    return 0
                }
                merged := self.merge(substitutions, unified.unwrap(), node.start, node.end)
                when merged.is_err() {
                    return 0
                }
                substitutions = merged.unwrap()
                argument += 1
            }
            return self.substitute_type(function.return_type, substitutions)
        }
        when kind == Ex::METHOD_CALL {
            value_type := self.infer_type(node.a, environment, caller)
            when value_type == 0 {
                return 0
            }
            receiver := self.types[value_type]
            method := node.text
            when receiver.kind == TypeKind::VEC && (method == "as_slice" || method == "slice") {
                return self.wrapped(TypeKind::SLICE, receiver.first, receiver.start, receiver.end)
            }
            when receiver.kind == TypeKind::VEC && (method == "len" || method == "capacity") {
                return TypeKind::U64 as u64
            }
            when receiver.kind == TypeKind::VEC && (method == "take" || method == "extract" || method == "index") {
                return receiver.first
            }
            when receiver.kind == TypeKind::STRING && (method == "clone" || method == "concat" || method == "slice"
                || method == "slice_chars" || method == "trim") {
                return TypeKind::STRING as u64
            }
            when receiver.kind == TypeKind::STRING && (method == "len" || method == "char_count") {
                return TypeKind::U64 as u64
            }
            when receiver.kind == TypeKind::STRING && method == "char_at" {
                return TypeKind::CHAR as u64
            }
            when receiver.kind == TypeKind::SLICE && method == "len" {
                return TypeKind::U64 as u64
            }
            return 0
        }
        when kind == Ex::ARRAY {
            when node.list.is_empty() {
                return 0
            }
            element := self.infer_type(node.list[0], environment, caller)
            when element == 0 {
                return 0
            }
            mut array := blank_type(TypeKind::ARRAY)
            array.first = element
            array.length = node.list.len()
            array.start = node.start
            array.end = node.end
            return self.new_type(array)
        }
        when kind == Ex::REPEAT {
            element := self.infer_type(node.a, environment, caller)
            when element == 0 {
                return 0
            }
            mut array := blank_type(TypeKind::ARRAY)
            array.first = element
            array.length = node.value
            array.start = node.start
            array.end = node.end
            return self.new_type(array)
        }
        when kind == Ex::INDEX {
            collection := self.infer_type(node.a, environment, caller)
            when collection == 0 {
                return 0
            }
            collection_node := self.types[collection]
            when collection_node.kind == TypeKind::ARRAY || collection_node.kind == TypeKind::SLICE || collection_node.kind == TypeKind::VEC {
                return collection_node.first
            }
            return 0
        }
        when kind == Ex::BINARY {
            op := node.text
            when op == "Eq" || op == "Ne" || op == "Lt" || op == "Le" || op == "Gt" || op == "Ge" || op == "And" || op == "Or" {
                return TypeKind::BOOL as u64
            }
            return self.infer_type(node.a, environment, caller)
        }
        when kind == Ex::IF {
            return self.infer_type(node.b, environment, caller)
        }
        when kind == Ex::CHOOSE {
            when node.list.is_empty() {
                return 0
            }
            arm := self.arms[node.list[0]]
            return self.infer_type(arm.body, environment, caller)
        }
        when kind == Ex::NEGATE || kind == Ex::BIT_NOT {
            return self.infer_type(node.a, environment, caller)
        }
        when kind == Ex::ADDRESS_OF {
            target := self.infer_type(node.a, environment, caller)
            when target == 0 {
                return 0
            }
            mut reference := blank_type(TypeKind::REF)
            reference.first = target
            reference.flag = node.flag
            reference.start = node.start
            reference.end = node.end
            return self.new_type(reference)
        }
        when kind == Ex::DEREF {
            pointer := self.infer_type(node.a, environment, caller)
            when pointer == 0 {
                return 0
            }
            pointer_node := self.types[pointer]
            when pointer_node.kind == TypeKind::REF || pointer_node.kind == TypeKind::RAW {
                return pointer_node.first
            }
            return 0
        }
        return 0
    }

    fun collection_element(self, ty: u64) -> u64 {
        when ty == 0 {
            return 0
        }
        node := self.types[ty]
        when node.kind == TypeKind::VEC || node.kind == TypeKind::SLICE || node.kind == TypeKind::ARRAY {
            return node.first
        }
        when node.kind == TypeKind::STR || node.kind == TypeKind::STRING {
            return TypeKind::CHAR as u64
        }
        return 0
    }
}

// ---------------------------------------------------------------------------
// Specializing calls and rewriting function bodies.

extend Tree {
    fun specialize_call(mut self, name: String, explicit: Vec<u64>, arguments: Vec<u64>, start: u64, end: u64, environment: Map<String, u64>, caller: u64) -> Result<String, lexer::Diag> {
        found := self.resolve_template(name.clone(), caller)
        when found == 0 {
            when !explicit.is_empty() {
                mut message := String("`")
                message.append(name)
                message.append("` is not a generic function")
                return Result::Err(lexer::diag("R0264", message, start, end))
            }
            return Result::Ok(name)
        }
        template := self.functions[found - 1]
        when !explicit.is_empty() && explicit.len() != template.type_params.len() {
            mut message := String("generic function `")
            message.append(template.name.clone())
            message.append("` expects ")
            message.append(String(template.type_params.len()))
            message.append(" type argument(s), found ")
            message.append(String(explicit.len()))
            return Result::Err(lexer::diag("R0264", message, start, end))
        }
        mut substitutions := Map<String, u64>()
        mut index: u64 = 0
        while index < template.type_params.len() && index < explicit.len() {
            substitutions.insert(template.type_params[index], explicit[index])
            index += 1
        }
        index = 0
        while index < template.param_types.len() && index < arguments.len() {
            actual := self.infer_type(arguments[index], environment.clone(), caller)
            when actual == 0 {
                mut message := String("cannot infer generic type arguments for `")
                message.append(template.name.clone())
                message.push('`')
                return Result::Err(diag_help("R0262", message, start, end, String("pass an expression with a known concrete type")))
            }
            unified := self.unify(template.param_types[index], actual, Map<String, u64>(), start, end)?
            substitutions = self.merge(substitutions, unified, start, end)?
            index += 1
        }
        // Generic Option/Result signatures use parser-created placeholder
        // enums; select the concrete specialization matching the payloads.
        mut definition_index: u64 = 0
        while definition_index < self.enums.len() {
            definition := self.enums[definition_index]
            is_option := starts_with_text(definition.name.clone(), "$RynOption#")
            is_result := starts_with_text(definition.name.clone(), "$RynResult#")
            when self.enum_has_type_parameters(definition_index) && (is_option || is_result) {
                mut specialized := Vec<u64>()
                mut still_generic := false
                for field in definition.fields.clone() {
                    substituted := self.substitute_type(field, substitutions.clone())
                    when self.type_has_parameter(substituted) {
                        still_generic = true
                    }
                    specialized.push(substituted)
                }
                when !still_generic {
                    family := when is_option { "$RynOption#" } else { "$RynResult#" }
                    mut candidate_index: u64 = 0
                    mut matched := false
                    while candidate_index < self.enums.len() && !matched {
                        candidate := self.enums[candidate_index]
                        when candidate.name != definition.name && starts_with_text(candidate.name.clone(), family)
                            && candidate.variant_names.len() == definition.variant_names.len() {
                            mut same := true
                            mut variant: u64 = 0
                            mut field: u64 = 0
                            mut candidate_field: u64 = 0
                            while variant < definition.variant_names.len() && same {
                                count := definition.variant_counts[variant]
                                when candidate.variant_names[variant] != definition.variant_names[variant]
                                    || candidate.variant_counts[variant] != count {
                                    same = false
                                } else {
                                    mut offset: u64 = 0
                                    while offset < count && same {
                                        when self.type_key(candidate.fields[candidate_field + offset]) != self.type_key(specialized[field + offset]) {
                                            same = false
                                        }
                                        offset += 1
                                    }
                                }
                                field += count
                                candidate_field += candidate.variant_counts[variant]
                                variant += 1
                            }
                            when same {
                                replacement := self.named(TypeKind::NAMED, candidate.name.clone(), definition.start, definition.end)
                                substitutions.insert(definition.name.clone(), replacement)
                                matched = true
                            }
                        }
                        candidate_index += 1
                    }
                }
            }
            definition_index += 1
        }
        for parameter in template.type_params.clone() {
            when !substitutions.contains_key(parameter.clone()) {
                mut message := String("cannot infer generic parameter `")
                message.append(parameter)
                message.append("` for `")
                message.append(template.name.clone())
                message.push('`')
                return Result::Err(diag_help("R0262", message, start, end, String("use the parameter in an argument type so its type can be inferred")))
            }
        }
        mut bound_params := Vec<String>()
        mut bound_lists := Vec<String>()
        index = 0
        while index < template.bound_params.len() {
            parameter := template.bound_params[index]
            when substitutions.contains_key(parameter.clone()) {
                bound_params.push(self.type_key(substitutions.get(parameter).unwrap()))
                bound_lists.push(template.bound_lists[index])
            }
            index += 1
        }
        mut keys := Vec<String>()
        for parameter in template.type_params.clone() {
            when substitutions.contains_key(parameter.clone()) {
                keys.push(self.type_key(substitutions.get(parameter).unwrap()))
            } else {
                keys.push(String())
            }
        }
        mut key := template.name.clone()
        key.push('<')
        key.append(join(keys, ","))
        key.push('>')
        when self.specializations.contains_key(key.clone()) {
            return Result::Ok(self.specializations.get(key).unwrap())
        }
        when self.specializations.len() >= Limit::SPECIALIZATIONS {
            return Result::Err(diag_help(
                "R0261",
                String("generic specialization limit exceeded"),
                start,
                end,
                String("reduce recursively growing type arguments or split the generic call graph")
            ))
        }
        mut specialized_name := template.name.clone()
        specialized_name.append("$RynGeneric#")
        specialized_name.append(String(self.specializations.len()))
        self.specializations.insert(key, specialized_name.clone())
        mut function := template
        function.name = specialized_name.clone()
        function.type_params = Vec<String>()
        function.bound_params = bound_params
        function.bound_lists = bound_lists
        new_param_types := self.copy_types(function.param_types.clone(), substitutions.clone())
        function.param_types = new_param_types
        when function.has_return {
            new_return_type := self.substitute_type(function.return_type, substitutions.clone())
            function.return_type = new_return_type
        }
        new_body := self.copy_stmts(function.body.clone(), substitutions.clone())
        function.body = new_body
        when function.has_value {
            new_value := self.copy_expr(function.value, substitutions)
            function.value = new_value
        }
        self.pending.push(self.functions.len())
        self.functions.push(function)
        return Result::Ok(specialized_name)
    }

    fun rewrite_exprs(mut self, expressions: Vec<u64>, environment: Map<String, u64>, caller: u64) -> Result<bool, lexer::Diag> {
        for expression in expressions {
            self.rewrite_expr(expression, environment.clone(), caller)?
        }
        return Result::Ok(true)
    }

    fun rewrite_expr(mut self, index: u64, environment: Map<String, u64>, caller: u64) -> Result<bool, lexer::Diag> {
        mut node := self.exprs[index]
        kind := node.kind
        when kind == Ex::CALL {
            new_types := self.copy_types(node.types.clone(), environment.clone())
            node.types = new_types
            self.exprs.set(index, node.clone())
            self.rewrite_exprs(node.list.clone(), environment.clone(), caller)?
            new_text := self.specialize_call(node.text.clone(), node.types.clone(), node.list.clone(), node.start, node.end, environment, caller)?
            node.text = new_text
            node.types = Vec<u64>()
            self.exprs.set(index, node)
            return Result::Ok(true)
        }
        when kind == Ex::METHOD_CALL {
            receiver_type := self.infer_type(node.a, environment.clone(), caller)
            mut helper := String()
            when receiver_type != 0 && self.types[receiver_type].kind == TypeKind::NAMED {
                enum_name := self.types[receiver_type].name
                when starts_with_text(enum_name.clone(), "$RynOption#") && node.text == "map" {
                    helper = String("option::map")
                } else when starts_with_text(enum_name.clone(), "$RynResult#") && node.text == "map" {
                    helper = String("result::map")
                } else when starts_with_text(enum_name, "$RynResult#") && node.text == "map_err" {
                    helper = String("result::map_err")
                }
            }
            when !helper.is_empty() && self.resolve_template(helper.clone(), caller) != 0 && node.list.len() == 1 {
                // `value.map(f)` on an Option or Result calls the generic
                // helper module function with the receiver as an argument.
                mut call := blank_expr(Ex::CALL)
                call.text = helper
                call.list.push(node.a)
                call.list.push(node.list[0])
                call.start = node.start
                call.end = node.end
                self.exprs.set(index, call)
                return self.rewrite_expr(index, environment, caller)
            }
            new_types := self.copy_types(node.types.clone(), environment.clone())
            node.types = new_types
            self.exprs.set(index, node.clone())
            self.rewrite_expr(node.a, environment.clone(), caller)?
            return self.rewrite_exprs(node.list.clone(), environment, caller)
        }
        when kind == Ex::STRUCT || kind == Ex::ARRAY || kind == Ex::TUPLE || kind == Ex::ENUM {
            return self.rewrite_exprs(node.list.clone(), environment, caller)
        }
        when kind == Ex::FIELD || kind == Ex::NEGATE || kind == Ex::NOT || kind == Ex::BIT_NOT
            || kind == Ex::DEREF || kind == Ex::PROPAGATE || kind == Ex::ADDRESS_OF || kind == Ex::CAST
            || kind == Ex::REPEAT {
            return self.rewrite_expr(node.a, environment, caller)
        }
        when kind == Ex::IF {
            self.rewrite_expr(node.a, environment.clone(), caller)?
            self.rewrite_expr(node.b, environment.clone(), caller)?
            return self.rewrite_expr(node.c, environment, caller)
        }
        when kind == Ex::BINARY || kind == Ex::INDEX {
            self.rewrite_expr(node.a, environment.clone(), caller)?
            return self.rewrite_expr(node.b, environment, caller)
        }
        when kind == Ex::CHOOSE {
            value_type := self.infer_type(node.a, environment.clone(), caller)
            self.rewrite_expr(node.a, environment.clone(), caller)?
            for arm_index in node.list.clone() {
                arm := self.arms[arm_index]
                mut arm_environment := environment.clone()
                when value_type != 0 && self.types[value_type].kind == TypeKind::NAMED && arm.has_variant {
                    found := self.find_enum(self.types[value_type].name)
                    when found != 0 {
                        definition := self.enums[found - 1]
                        mut variant: u64 = 0
                        mut field: u64 = 0
                        mut located := false
                        while variant < definition.variant_names.len() && !located {
                            when definition.variant_names[variant] == arm.variant {
                                located = true
                            } else {
                                field += definition.variant_counts[variant]
                                variant += 1
                            }
                        }
                        when located {
                            mut binding: u64 = 0
                            while binding < arm.bindings.len() && binding < definition.variant_counts[variant] {
                                arm_environment.insert(arm.bindings[binding], definition.fields[field + binding])
                                binding += 1
                            }
                        }
                    }
                }
                self.rewrite_expr(arm.body, arm_environment, caller)?
            }
            return Result::Ok(true)
        }
        return Result::Ok(true)
    }

    // Rewrites a block; returns its environment with the block's bindings.
    fun rewrite_stmts(mut self, statements: Vec<u64>, environment: Map<String, u64>, caller: u64) -> Result<Map<String, u64>, lexer::Diag> {
        mut current := environment
        for statement in statements {
            current = self.rewrite_stmt(statement, current, caller)?
        }
        return Result::Ok(current)
    }

    fun rewrite_stmt(mut self, index: u64, environment: Map<String, u64>, caller: u64) -> Result<Map<String, u64>, lexer::Diag> {
        mut node := self.stmts[index]
        kind := node.kind
        mut current := environment
        when kind == St::LET {
            self.rewrite_expr(node.a, current.clone(), caller)?
            when node.has {
                current.insert(node.text.clone(), node.ty)
            } else {
                inferred := self.infer_type(node.a, current.clone(), caller)
                when inferred != 0 {
                    current.insert(node.text.clone(), inferred)
                }
            }
        } else when kind == St::ASSIGN || kind == St::COMPOUND || kind == St::PRINT || kind == St::FIELD_ASSIGN {
            self.rewrite_expr(node.a, current.clone(), caller)?
        } else when kind == St::INDEX_ASSIGN || kind == St::DEREF_ASSIGN {
            self.rewrite_expr(node.a, current.clone(), caller)?
            self.rewrite_expr(node.b, current.clone(), caller)?
        } else when kind == St::TEMPLATE {
            mut part: u64 = 0
            while part < node.parts.len() {
                when node.part_kinds[part] == 2 {
                    self.rewrite_expr(node.parts[part], current.clone(), caller)?
                }
                part += 1
            }
        } else when kind == St::CALL {
            new_types := self.copy_types(node.types.clone(), current.clone())
            node.types = new_types
            self.stmts.set(index, node.clone())
            self.rewrite_exprs(node.list.clone(), current.clone(), caller)?
            new_text := self.specialize_call(node.text.clone(), node.types.clone(), node.list.clone(), node.start, node.end, current.clone(), caller)?
            node.text = new_text
            node.types = Vec<u64>()
            self.stmts.set(index, node)
        } else when kind == St::METHOD_CALL {
            self.rewrite_expr(node.a, current.clone(), caller)?
            self.rewrite_exprs(node.list.clone(), current.clone(), caller)?
        } else when kind == St::IF {
            self.rewrite_expr(node.a, current.clone(), caller)?
            self.rewrite_stmts(node.body.clone(), current.clone(), caller)?
            self.rewrite_stmts(node.body2.clone(), current.clone(), caller)?
        } else when kind == St::WHILE {
            self.rewrite_expr(node.a, current.clone(), caller)?
            self.rewrite_stmts(node.body.clone(), current.clone(), caller)?
        } else when kind == St::FOR {
            self.rewrite_expr(node.a, current.clone(), caller)?
            self.rewrite_expr(node.b, current.clone(), caller)?
            mut loop_environment := current.clone()
            start_type := self.infer_type(node.a, current.clone(), caller)
            when start_type != 0 {
                loop_environment.insert(node.text.clone(), start_type)
            }
            self.rewrite_stmts(node.body.clone(), loop_environment, caller)?
        } else when kind == St::FOR_EACH {
            self.rewrite_expr(node.a, current.clone(), caller)?
            mut loop_environment := current.clone()
            element := self.collection_element(self.infer_type(node.a, current.clone(), caller))
            when element != 0 {
                loop_environment.insert(node.text.clone(), element)
            }
            self.rewrite_stmts(node.body.clone(), loop_environment, caller)?
        } else when kind == St::RETURN {
            when node.has {
                self.rewrite_expr(node.a, current.clone(), caller)?
            }
        }
        return Result::Ok(current)
    }

    fun parameter_environment(self, function: u64) -> Map<String, u64> {
        mut environment := Map<String, u64>()
        node := self.functions[function]
        mut index: u64 = 0
        while index < node.param_names.len() {
            environment.insert(node.param_names[index], node.param_types[index])
            index += 1
        }
        return environment
    }

    fun rewrite_function(mut self, function: u64) -> Result<bool, lexer::Diag> {
        environment := self.parameter_environment(function)
        node := self.functions[function]
        body_environment := self.rewrite_stmts(node.body.clone(), environment, function)?
        when node.has_value {
            self.rewrite_expr(node.value, body_environment, function)?
        }
        return Result::Ok(true)
    }

    // Returns the specialized program's encoding, or the input unchanged when
    // no function is generic.
    fun monomorphize(mut self) -> Result<String, lexer::Diag> {
        program_functions := self.functions.len()
        mut concrete := Vec<u64>()
        mut has_generic := false
        mut index: u64 = 0
        while index < program_functions {
            function := self.functions[index]
            when function.type_params.is_empty() {
                concrete.push(index)
            } else {
                has_generic = true
                self.templates.insert(function.name.clone(), index)
            }
            index += 1
        }
        when !has_generic {
            return Result::Ok(self.text.clone())
        }
        mut use_index: u64 = 0
        while use_index < self.use_paths.len() {
            module_path := self.use_paths[use_index]
            alias := self.use_aliases[use_index]
            mut prefix := module_path.clone()
            prefix.append("::")
            index = 0
            while index < program_functions {
                function := self.functions[index]
                when !function.type_params.is_empty() && function.public && function.module_path == module_path
                    && function.name.starts_with(prefix.clone()) {
                    mut imported := alias.clone()
                    imported.append("::")
                    imported.append(function.name.slice(prefix.len(), function.name.len()))
                    self.templates.insert(imported, index)
                }
                index += 1
            }
            use_index += 1
        }
        for function in concrete.clone() {
            self.known.insert(self.functions[function].name, function)
        }
        for function in concrete.clone() {
            self.rewrite_function(function)?
        }
        mut cursor: u64 = 0
        while cursor < self.pending.len() {
            function := self.pending[cursor]
            cursor += 1
            self.rewrite_function(function)?
            self.known.insert(self.functions[function].name, function)
            concrete.push(function)
            when concrete.len() as u64 > Limit::SPECIALIZATIONS {
                last := self.functions[function]
                return Result::Err(diag_help(
                    "R0261",
                    String("generic specialization limit exceeded"),
                    last.start,
                    last.end,
                    String("reduce recursively growing type arguments or split the generic call graph")
                ))
            }
        }
        mut enums := String()
        mut enum_count: u64 = 0
        mut enum_index: u64 = 0
        while enum_index < self.enums.len() {
            when !self.enum_has_type_parameters(enum_index) {
                enums.append(self.enums[enum_index].raw)
                enum_count += 1
            }
            enum_index += 1
        }
        mut functions := String()
        for function in concrete.clone() {
            functions.append(self.encode_function(function))
        }
        mut out := word("Ok")
        out.push('\n')
        out.append(enc_uint(self.use_count))
        out.append(self.uses_raw.clone())
        out.push('\n')
        out.append(enc_uint(self.struct_count))
        out.append(self.structs_raw.clone())
        out.push('\n')
        out.append(enc_uint(enum_count))
        out.append(enums)
        out.push('\n')
        out.append(enc_uint(self.alias_count))
        out.append(self.aliases_raw.clone())
        out.push('\n')
        out.append(enc_uint(self.extend_count))
        out.append(self.extends_raw.clone())
        out.push('\n')
        out.append(enc_uint(self.shape_count))
        out.append(self.shapes_raw.clone())
        out.push('\n')
        out.append(enc_uint(concrete.len()))
        out.append(functions)
        out.push('\n')
        return Result::Ok(out)
    }
}

fun primitive(kind: u32) -> TreeType {
    return blank_type(kind)
}

fun encode_failure(error: lexer::Diag) -> String {
    mut out := word("Error")
    out.append(enc_str(error.code))
    out.append(enc_str(error.message))
    out.append(enc_span(error.start, error.end))
    when error.has_help {
        out.append(word("+"))
        out.append(enc_str(error.help))
    } else {
        out.append(word("-"))
    }
    return out
}

// Specializes the generic functions of an encoded program and returns the
// encoded result: the program, or the first specialization diagnostic.
pub fun specialize(encoded: String) -> String {
    mut types := Vec<TreeType>()
    mut kind: u32 = 0
    while kind <= TypeKind::BOOL {
        types.push(primitive(kind))
        kind += 1
    }
    mut tree := Tree {
        text: encoded,
        at: 0,
        failed: false,
        types: types,
        exprs: Vec<ExprNode>(),
        arms: Vec<ArmNode>(),
        stmts: Vec<StmtNode>(),
        functions: Vec<FunctionNode>(),
        enums: Vec<EnumNode>(),
        uses_raw: String(),
        use_count: 0,
        use_paths: Vec<String>(),
        use_aliases: Vec<String>(),
        structs_raw: String(),
        struct_count: 0,
        aliases_raw: String(),
        alias_count: 0,
        extends_raw: String(),
        extend_count: 0,
        shapes_raw: String(),
        shape_count: 0,
        templates: Map<String, u64>(),
        known: Map<String, u64>(),
        specializations: Map<String, String>(),
        pending: Vec<u64>()
    }
    when !tree.decode_program() {
        return encode_failure(lexer::diag(
            "R0901",
            String("the generic specialization pass received a malformed syntax tree"),
            0,
            0
        ))
    }
    result := tree.monomorphize()
    when result.is_ok() {
        return result.unwrap()
    }
    return encode_failure(result.unwrap_err())
}
