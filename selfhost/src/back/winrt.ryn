// The Windows side of the freestanding runtime. The freestanding code makes its operating system requests with the Linux
// `syscall` instruction; for a Windows image every such instruction is a call of `win_syscall`, which takes the same
// registers (the number in rax, the arguments in rdi, rsi, rdx, r10, r8 and r9) and answers as the kernel does (the result
// or a negative error number in rax, everything but rax, rcx and r11 preserved), using the functions of kernel32. Besides
// it there are the start-up routine that reads the command line, and the vectored exception handler that turns an access
// violation or a stack overflow into the call of the program's SIGSEGV handler.
//
// The routines are called with the stack at any alignment: each aligns it for the calls it makes.

use back::x64

// The functions of the system libraries that these routines call, each as `library!name`.
pub fun api_names(arguments: bool) -> Vec<String> {
    mut names: Vec<String> = Vec()
    names.push(String("kernel32!ExitProcess"))
    names.push(String("kernel32!GetStdHandle"))
    names.push(String("kernel32!WriteFile"))
    names.push(String("kernel32!ReadFile"))
    names.push(String("kernel32!VirtualAlloc"))
    names.push(String("kernel32!VirtualFree"))
    names.push(String("kernel32!CreateFileW"))
    names.push(String("kernel32!CloseHandle"))
    names.push(String("kernel32!SetFilePointerEx"))
    names.push(String("kernel32!GetFileAttributesW"))
    names.push(String("kernel32!MultiByteToWideChar"))
    names.push(String("kernel32!WideCharToMultiByte"))
    when arguments { names.push(String("kernel32!GetCommandLineW")) }
    names.push(String("kernel32!AddVectoredExceptionHandler"))
    names.push(String("kernel32!SetConsoleOutputCP"))
    names.push(String("kernel32!SetThreadStackGuarantee"))
    names.push(String("kernel32!GetLastError"))
    names.push(String("kernel32!GetCurrentProcessId"))
    names.push(String("kernel32!GetFileAttributesExW"))
    names.push(String("kernel32!SetCurrentDirectoryW"))
    names.push(String("kernel32!GetCurrentDirectoryW"))
    names.push(String("kernel32!MoveFileExW"))
    names.push(String("kernel32!DeleteFileW"))
    names.push(String("kernel32!RemoveDirectoryW"))
    names.push(String("kernel32!CreateDirectoryW"))
    names.push(String("kernel32!GetConsoleMode"))
    when arguments { names.push(String("shell32!CommandLineToArgvW")) }
    return names
}

// The labels of the routines, the symbol of a block of 16 zeroed bytes (the first word holds the program's SIGSEGV
// handler, the second says whether the exception handler is installed), and the symbols of the API functions.
#[derive(Clone)]
pub struct WinRt {
    pub syscall_label: u64,
    pub init_label: u64,
    pub veh_label: u64,
    pub state_symbol: u64,
    pub api_names: Vec<String>,
    pub api_symbols: Vec<u64>,
}

fun reg_r12() -> u64 {
    return 12
}

fun reg_r13() -> u64 {
    return 13
}

fun reg_r14() -> u64 {
    return 14
}

fun call_api(asm: &mut x64::Asm, rt: &WinRt, name: String) {
    mut at: u64 = 0
    while at < rt.api_names.len() {
        when rt.api_names[at] == name {
            asm.call_symbol(rt.api_symbols[at])
            return
        }
        at += 1
    }
    asm.trap()
}

// -1 as a 64-bit value minus `n`: the error number `-n` as the kernel returns it.
fun negative(n: u64) -> u64 {
    return 0 - n
}

// rcx = the handle of the descriptor in r12: the standard handles for 0, 1 and 2, the descriptor itself otherwise.
fun emit_handle(asm: &mut x64::Asm, rt: &WinRt) {
    standard_in := asm.new_label()
    standard_out := asm.new_label()
    standard_err := asm.new_label()
    have := asm.new_label()
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.alu_rr(57, reg_r12(), x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, standard_in)
    asm.mov_ri(x64::Reg::RAX, 1)
    asm.alu_rr(57, reg_r12(), x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, standard_out)
    asm.mov_ri(x64::Reg::RAX, 2)
    asm.alu_rr(57, reg_r12(), x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, standard_err)
    asm.mov_rr(x64::Reg::RCX, reg_r12())
    asm.jmp(have)
    asm.bind(standard_in)
    asm.mov_ri(x64::Reg::RCX, 4294967286)
    call_api(asm, rt, String("kernel32!GetStdHandle"))
    asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
    asm.jmp(have)
    asm.bind(standard_out)
    asm.mov_ri(x64::Reg::RCX, 4294967285)
    call_api(asm, rt, String("kernel32!GetStdHandle"))
    asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
    asm.jmp(have)
    asm.bind(standard_err)
    asm.mov_ri(x64::Reg::RCX, 4294967284)
    call_api(asm, rt, String("kernel32!GetStdHandle"))
    asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
    asm.bind(have)
}

// The path in r12 (UTF-8, zero-terminated) converted into UTF-16 at [rsp + 64]; jumps to `failed` when it cannot be.
fun emit_wide_path_of(asm: &mut x64::Asm, rt: &WinRt, failed: u64, source: u64) {
    asm.alu_ri(5, x64::Reg::RSP, 16448)
    asm.mov_ri(x64::Reg::RCX, 65001)
    asm.mov_ri(x64::Reg::RDX, 0)
    asm.mov_rr(x64::Reg::R8, source)
    asm.mov_ri(x64::Reg::R9, 4294967295)
    asm.lea(x64::Reg::RAX, x64::Reg::RSP, 64)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
    asm.mov_ri(x64::Reg::RAX, 8192)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 40)
    call_api(asm, rt, String("kernel32!MultiByteToWideChar"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, failed)
}

fun emit_wide_path(asm: &mut x64::Asm, rt: &WinRt, failed: u64) {
    emit_wide_path_of(asm, rt, failed, reg_r12())
}

// The syscall emulation. Inside, r12 holds the first argument, r13 the second, r14 the third and rbx the number.
pub fun emit_syscall(asm: &mut x64::Asm, rt: &WinRt) {
    asm.bind(rt.syscall_label)
    asm.push(x64::Reg::RBP)
    asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
    asm.push(x64::Reg::RBX)
    asm.push(x64::Reg::RDI)
    asm.push(x64::Reg::RSI)
    asm.push(x64::Reg::RDX)
    asm.push(x64::Reg::R8)
    asm.push(x64::Reg::R9)
    asm.push(x64::Reg::R10)
    asm.push(reg_r12())
    asm.push(reg_r13())
    asm.push(reg_r14())
    asm.alu_ri(4, x64::Reg::RSP, (0 as i64) - 16)
    asm.alu_ri(5, x64::Reg::RSP, 160)
    asm.mov_rr(reg_r12(), x64::Reg::RDI)
    asm.mov_rr(reg_r13(), x64::Reg::RSI)
    asm.mov_rr(reg_r14(), x64::Reg::RDX)
    asm.mov_rr(x64::Reg::RBX, x64::Reg::RAX)

    done := asm.new_label()
    write_case := asm.new_label()
    exit_case := asm.new_label()
    mmap_case := asm.new_label()
    munmap_case := asm.new_label()
    read_case := asm.new_label()
    open_case := asm.new_label()
    close_case := asm.new_label()
    seek_case := asm.new_label()
    chmod_case := asm.new_label()
    access_case := asm.new_label()
    sigaction_case := asm.new_label()
    sigaltstack_case := asm.new_label()
    mkdir_case := asm.new_label()
    rmdir_case := asm.new_label()
    unlink_case := asm.new_label()
    rename_case := asm.new_label()
    chdir_case := asm.new_label()
    getcwd_case := asm.new_label()
    stat_case := asm.new_label()
    getpid_case := asm.new_label()
    ioctl_case := asm.new_label()

    asm.alu_ri(7, x64::Reg::RBX, 1)
    asm.jcc(x64::Cc::EQUAL, write_case)
    asm.alu_ri(7, x64::Reg::RBX, 16)
    asm.jcc(x64::Cc::EQUAL, ioctl_case)
    asm.alu_ri(7, x64::Reg::RBX, 231)
    asm.jcc(x64::Cc::EQUAL, exit_case)
    asm.alu_ri(7, x64::Reg::RBX, 9)
    asm.jcc(x64::Cc::EQUAL, mmap_case)
    asm.alu_ri(7, x64::Reg::RBX, 11)
    asm.jcc(x64::Cc::EQUAL, munmap_case)
    asm.alu_ri(7, x64::Reg::RBX, 0)
    asm.jcc(x64::Cc::EQUAL, read_case)
    asm.alu_ri(7, x64::Reg::RBX, 2)
    asm.jcc(x64::Cc::EQUAL, open_case)
    asm.alu_ri(7, x64::Reg::RBX, 3)
    asm.jcc(x64::Cc::EQUAL, close_case)
    asm.alu_ri(7, x64::Reg::RBX, 8)
    asm.jcc(x64::Cc::EQUAL, seek_case)
    asm.alu_ri(7, x64::Reg::RBX, 90)
    asm.jcc(x64::Cc::EQUAL, chmod_case)
    asm.alu_ri(7, x64::Reg::RBX, 21)
    asm.jcc(x64::Cc::EQUAL, access_case)
    asm.alu_ri(7, x64::Reg::RBX, 13)
    asm.jcc(x64::Cc::EQUAL, sigaction_case)
    asm.alu_ri(7, x64::Reg::RBX, 131)
    asm.jcc(x64::Cc::EQUAL, sigaltstack_case)
    asm.alu_ri(7, x64::Reg::RBX, 83)
    asm.jcc(x64::Cc::EQUAL, mkdir_case)
    asm.alu_ri(7, x64::Reg::RBX, 84)
    asm.jcc(x64::Cc::EQUAL, rmdir_case)
    asm.alu_ri(7, x64::Reg::RBX, 87)
    asm.jcc(x64::Cc::EQUAL, unlink_case)
    asm.alu_ri(7, x64::Reg::RBX, 82)
    asm.jcc(x64::Cc::EQUAL, rename_case)
    asm.alu_ri(7, x64::Reg::RBX, 80)
    asm.jcc(x64::Cc::EQUAL, chdir_case)
    asm.alu_ri(7, x64::Reg::RBX, 79)
    asm.jcc(x64::Cc::EQUAL, getcwd_case)
    asm.alu_ri(7, x64::Reg::RBX, 4)
    asm.jcc(x64::Cc::EQUAL, stat_case)
    asm.alu_ri(7, x64::Reg::RBX, 6)
    asm.jcc(x64::Cc::EQUAL, stat_case)
    asm.alu_ri(7, x64::Reg::RBX, 39)
    asm.jcc(x64::Cc::EQUAL, getpid_case)
    // A system call this runtime does not emulate: ENOSYS.
    asm.mov_ri(x64::Reg::RAX, negative(38))
    asm.jmp(done)

    // write(descriptor, buffer, length) -> bytes written
    asm.bind(write_case)
    write_failed := asm.new_label()
    emit_handle(asm, rt)
    asm.mov_rr(x64::Reg::RDX, reg_r13())
    asm.mov_rr(x64::Reg::R8, reg_r14())
    asm.lea(x64::Reg::R9, x64::Reg::RSP, 96)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
    call_api(asm, rt, String("kernel32!WriteFile"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, write_failed)
    asm.load(4, false, x64::Reg::RAX, x64::Reg::RSP, 96)
    asm.jmp(done)
    asm.bind(write_failed)
    asm.mov_ri(x64::Reg::RAX, negative(5))
    asm.jmp(done)

    // ioctl(descriptor, TCGETS, termios): 0 for a console, the terminal test of standard output; ENOTTY otherwise.
    asm.bind(ioctl_case)
    not_console := asm.new_label()
    asm.mov_ri(x64::Reg::RAX, 21505)
    asm.alu_rr(57, reg_r13(), x64::Reg::RAX)
    asm.jcc(x64::Cc::NOT_EQUAL, not_console)
    emit_handle(asm, rt)
    asm.lea(x64::Reg::RDX, x64::Reg::RSP, 96)
    call_api(asm, rt, String("kernel32!GetConsoleMode"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, not_console)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.jmp(done)
    asm.bind(not_console)
    asm.mov_ri(x64::Reg::RAX, negative(25))
    asm.jmp(done)

    // exit_group(status)
    asm.bind(exit_case)
    asm.mov_rr(x64::Reg::RCX, reg_r12())
    call_api(asm, rt, String("kernel32!ExitProcess"))
    asm.trap()

    // mmap(0, length, ...) -> zeroed memory, or ENOMEM
    asm.bind(mmap_case)
    mmap_failed := asm.new_label()
    asm.mov_ri(x64::Reg::RCX, 0)
    asm.mov_rr(x64::Reg::RDX, reg_r13())
    asm.mov_ri(x64::Reg::R8, 12288)
    asm.mov_ri(x64::Reg::R9, 4)
    call_api(asm, rt, String("kernel32!VirtualAlloc"))
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, mmap_failed)
    asm.jmp(done)
    asm.bind(mmap_failed)
    asm.mov_ri(x64::Reg::RAX, negative(12))
    asm.jmp(done)

    // munmap(address, length): the whole reservation is released.
    asm.bind(munmap_case)
    asm.mov_rr(x64::Reg::RCX, reg_r12())
    asm.mov_ri(x64::Reg::RDX, 0)
    asm.mov_ri(x64::Reg::R8, 32768)
    call_api(asm, rt, String("kernel32!VirtualFree"))
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.jmp(done)

    // read(descriptor, buffer, length) -> bytes read; an error reads as the end of the input.
    asm.bind(read_case)
    read_failed := asm.new_label()
    emit_handle(asm, rt)
    asm.mov_rr(x64::Reg::RDX, reg_r13())
    asm.mov_rr(x64::Reg::R8, reg_r14())
    asm.lea(x64::Reg::R9, x64::Reg::RSP, 96)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
    call_api(asm, rt, String("kernel32!ReadFile"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, read_failed)
    asm.load(4, false, x64::Reg::RAX, x64::Reg::RSP, 96)
    asm.jmp(done)
    asm.bind(read_failed)
    // A closed pipe or the end of a file reads as no more bytes; any other failure (a directory) is EISDIR.
    read_end := asm.new_label()
    call_api(asm, rt, String("kernel32!GetLastError"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    asm.alu_ri(7, x64::Reg::RAX, 109)
    asm.jcc(x64::Cc::EQUAL, read_end)
    asm.alu_ri(7, x64::Reg::RAX, 38)
    asm.jcc(x64::Cc::EQUAL, read_end)
    asm.mov_ri(x64::Reg::RAX, negative(21))
    asm.jmp(done)
    asm.bind(read_end)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.jmp(done)

    // open(path, flags, mode) -> a handle, or a negative error number
    asm.bind(open_case)
    open_failed := asm.new_label()
    emit_wide_path(asm, rt, open_failed)
    // The access: read, write or both; an appending file may only append.
    access_done := asm.new_label()
    access_write := asm.new_label()
    access_both := asm.new_label()
    asm.mov_rr(x64::Reg::RAX, reg_r13())
    asm.alu_ri(4, x64::Reg::RAX, 3)
    asm.alu_ri(7, x64::Reg::RAX, 1)
    asm.jcc(x64::Cc::EQUAL, access_write)
    asm.alu_ri(7, x64::Reg::RAX, 2)
    asm.jcc(x64::Cc::EQUAL, access_both)
    asm.mov_ri(reg_r12(), 2147483648)
    asm.jmp(access_done)
    asm.bind(access_write)
    asm.mov_ri(reg_r12(), 1073741824)
    asm.jmp(access_done)
    asm.bind(access_both)
    asm.mov_ri(reg_r12(), 3221225472)
    asm.bind(access_done)
    not_append := asm.new_label()
    asm.mov_rr(x64::Reg::RAX, reg_r13())
    asm.alu_ri(4, x64::Reg::RAX, 1024)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, not_append)
    asm.mov_ri(x64::Reg::RAX, 2147483648)
    asm.alu_rr(33, reg_r12(), x64::Reg::RAX)
    asm.alu_ri(1, reg_r12(), 1048580)
    asm.bind(not_append)
    // The disposition: create and truncate 2, create 4, truncate 5, neither 3.
    asm.mov_ri(reg_r14(), 3)
    no_create := asm.new_label()
    disposition_done := asm.new_label()
    asm.mov_rr(x64::Reg::RAX, reg_r13())
    asm.alu_ri(4, x64::Reg::RAX, 64)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, no_create)
    asm.mov_ri(reg_r14(), 4)
    asm.mov_rr(x64::Reg::RAX, reg_r13())
    asm.alu_ri(4, x64::Reg::RAX, 512)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, disposition_done)
    asm.mov_ri(reg_r14(), 2)
    asm.jmp(disposition_done)
    asm.bind(no_create)
    asm.mov_rr(x64::Reg::RAX, reg_r13())
    asm.alu_ri(4, x64::Reg::RAX, 512)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, disposition_done)
    asm.mov_ri(reg_r14(), 5)
    asm.bind(disposition_done)
    asm.lea(x64::Reg::RCX, x64::Reg::RSP, 64)
    asm.mov_rr(x64::Reg::RDX, reg_r12())
    asm.mov_ri(x64::Reg::R8, 7)
    asm.mov_ri(x64::Reg::R9, 0)
    asm.store(8, reg_r14(), x64::Reg::RSP, 32)
    asm.mov_ri(x64::Reg::RAX, 33554560)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 40)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 48)
    call_api(asm, rt, String("kernel32!CreateFileW"))
    asm.mov_ri(x64::Reg::RCX, 18446744073709551615)
    asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
    asm.jcc(x64::Cc::NOT_EQUAL, done)
    call_api(asm, rt, String("kernel32!GetLastError"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    missing := asm.new_label()
    denied := asm.new_label()
    exists := asm.new_label()
    asm.alu_ri(7, x64::Reg::RAX, 2)
    asm.jcc(x64::Cc::EQUAL, missing)
    asm.alu_ri(7, x64::Reg::RAX, 3)
    asm.jcc(x64::Cc::EQUAL, missing)
    asm.alu_ri(7, x64::Reg::RAX, 5)
    asm.jcc(x64::Cc::EQUAL, denied)
    asm.alu_ri(7, x64::Reg::RAX, 80)
    asm.jcc(x64::Cc::EQUAL, exists)
    asm.alu_ri(7, x64::Reg::RAX, 183)
    asm.jcc(x64::Cc::EQUAL, exists)
    asm.mov_ri(x64::Reg::RAX, negative(5))
    asm.jmp(done)
    asm.bind(missing)
    asm.mov_ri(x64::Reg::RAX, negative(2))
    asm.jmp(done)
    asm.bind(denied)
    asm.mov_ri(x64::Reg::RAX, negative(13))
    asm.jmp(done)
    asm.bind(exists)
    asm.mov_ri(x64::Reg::RAX, negative(17))
    asm.jmp(done)
    asm.bind(open_failed)
    asm.mov_ri(x64::Reg::RAX, negative(2))
    asm.jmp(done)

    // close(descriptor)
    asm.bind(close_case)
    keep_open := asm.new_label()
    asm.alu_ri(7, reg_r12(), 2)
    asm.jcc(x64::Cc::BELOW_EQUAL, keep_open)
    asm.mov_rr(x64::Reg::RCX, reg_r12())
    call_api(asm, rt, String("kernel32!CloseHandle"))
    asm.bind(keep_open)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.jmp(done)

    // lseek(descriptor, offset, whence) -> the new position
    asm.bind(seek_case)
    seek_failed := asm.new_label()
    asm.mov_rr(x64::Reg::RCX, reg_r12())
    asm.mov_rr(x64::Reg::RDX, reg_r13())
    asm.lea(x64::Reg::R8, x64::Reg::RSP, 96)
    asm.mov_rr(x64::Reg::R9, reg_r14())
    call_api(asm, rt, String("kernel32!SetFilePointerEx"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, seek_failed)
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 96)
    asm.jmp(done)
    asm.bind(seek_failed)
    asm.mov_ri(x64::Reg::RAX, negative(22))
    asm.jmp(done)

    // chmod(path, mode): Windows files have no such mode.
    asm.bind(chmod_case)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.jmp(done)

    // access(path, mode): 0 when the path exists
    asm.bind(access_case)
    access_failed := asm.new_label()
    emit_wide_path(asm, rt, access_failed)
    asm.lea(x64::Reg::RCX, x64::Reg::RSP, 64)
    call_api(asm, rt, String("kernel32!GetFileAttributesW"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    asm.mov_ri(x64::Reg::RCX, 4294967295)
    asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
    asm.jcc(x64::Cc::EQUAL, access_failed)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.jmp(done)
    asm.bind(access_failed)
    asm.mov_ri(x64::Reg::RAX, negative(2))
    asm.jmp(done)

    // rt_sigaction(signal, action, ...): the handler is kept, and the exception handler is installed once.
    asm.bind(sigaction_case)
    installed := asm.new_label()
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.alu_rr(57, reg_r13(), x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, installed)
    asm.load(8, false, x64::Reg::RAX, reg_r13(), 0)
    asm.lea_symbol(x64::Reg::RCX, rt.state_symbol)
    asm.store(8, x64::Reg::RAX, x64::Reg::RCX, 0)
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RCX, 8)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::NOT_EQUAL, installed)
    asm.mov_ri(x64::Reg::RAX, 1)
    asm.store(8, x64::Reg::RAX, x64::Reg::RCX, 8)
    asm.mov_ri(x64::Reg::RCX, 1)
    asm.lea_label(x64::Reg::RDX, rt.veh_label)
    call_api(asm, rt, String("kernel32!AddVectoredExceptionHandler"))
    asm.bind(installed)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.jmp(done)


    // mkdir(path, mode), rmdir(path), unlink(path), chdir(path): one wide path and one Win32 call that answers 0 or fails.
    path_failed := asm.new_label()
    path_done := asm.new_label()
    asm.bind(mkdir_case)
    emit_wide_path(asm, rt, path_failed)
    asm.lea(x64::Reg::RCX, x64::Reg::RSP, 64)
    asm.mov_ri(x64::Reg::RDX, 0)
    call_api(asm, rt, String("kernel32!CreateDirectoryW"))
    asm.jmp(path_done)
    asm.bind(rmdir_case)
    emit_wide_path(asm, rt, path_failed)
    asm.lea(x64::Reg::RCX, x64::Reg::RSP, 64)
    call_api(asm, rt, String("kernel32!RemoveDirectoryW"))
    asm.jmp(path_done)
    asm.bind(unlink_case)
    emit_wide_path(asm, rt, path_failed)
    asm.lea(x64::Reg::RCX, x64::Reg::RSP, 64)
    call_api(asm, rt, String("kernel32!DeleteFileW"))
    asm.jmp(path_done)
    asm.bind(chdir_case)
    emit_wide_path(asm, rt, path_failed)
    asm.lea(x64::Reg::RCX, x64::Reg::RSP, 64)
    call_api(asm, rt, String("kernel32!SetCurrentDirectoryW"))
    asm.jmp(path_done)
    asm.bind(rename_case)
    emit_wide_path(asm, rt, path_failed)
    emit_wide_path_of(asm, rt, path_failed, reg_r13())
    asm.lea(x64::Reg::RCX, x64::Reg::RSP, 16512)
    asm.lea(x64::Reg::RDX, x64::Reg::RSP, 64)
    asm.mov_ri(x64::Reg::R8, 1)
    call_api(asm, rt, String("kernel32!MoveFileExW"))
    asm.bind(path_done)
    path_error := asm.new_label()
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, path_error)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.jmp(done)
    asm.bind(path_error)
    call_api(asm, rt, String("kernel32!GetLastError"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    path_missing := asm.new_label()
    path_denied := asm.new_label()
    path_exists := asm.new_label()
    asm.alu_ri(7, x64::Reg::RAX, 2)
    asm.jcc(x64::Cc::EQUAL, path_missing)
    asm.alu_ri(7, x64::Reg::RAX, 3)
    asm.jcc(x64::Cc::EQUAL, path_missing)
    asm.alu_ri(7, x64::Reg::RAX, 5)
    asm.jcc(x64::Cc::EQUAL, path_denied)
    asm.alu_ri(7, x64::Reg::RAX, 183)
    asm.jcc(x64::Cc::EQUAL, path_exists)
    asm.alu_ri(7, x64::Reg::RAX, 145)
    asm.jcc(x64::Cc::EQUAL, path_exists)
    asm.mov_ri(x64::Reg::RAX, negative(5))
    asm.jmp(done)
    asm.bind(path_missing)
    asm.mov_ri(x64::Reg::RAX, negative(2))
    asm.jmp(done)
    asm.bind(path_denied)
    asm.mov_ri(x64::Reg::RAX, negative(13))
    asm.jmp(done)
    asm.bind(path_exists)
    asm.mov_ri(x64::Reg::RAX, negative(17))
    asm.jmp(done)
    asm.bind(path_failed)
    asm.mov_ri(x64::Reg::RAX, negative(2))
    asm.jmp(done)

    // getcwd(buffer, size) -> the length with the terminator, with `/` for the separators
    asm.bind(getcwd_case)
    cwd_failed := asm.new_label()
    asm.alu_ri(5, x64::Reg::RSP, 16448)
    asm.mov_ri(x64::Reg::RCX, 8192)
    asm.lea(x64::Reg::RDX, x64::Reg::RSP, 64)
    call_api(asm, rt, String("kernel32!GetCurrentDirectoryW"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, cwd_failed)
    asm.mov_ri(x64::Reg::RCX, 65001)
    asm.mov_ri(x64::Reg::RDX, 0)
    asm.lea(x64::Reg::R8, x64::Reg::RSP, 64)
    asm.mov_ri(x64::Reg::R9, 4294967295)
    asm.store(8, reg_r12(), x64::Reg::RSP, 32)
    asm.store(8, reg_r13(), x64::Reg::RSP, 40)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 48)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 56)
    call_api(asm, rt, String("kernel32!WideCharToMultiByte"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, cwd_failed)
    // Backslashes become slashes.
    asm.mov_rr(x64::Reg::RCX, reg_r12())
    separators := asm.new_label()
    separators_done := asm.new_label()
    not_separator := asm.new_label()
    asm.bind(separators)
    asm.load(1, false, x64::Reg::RDX, x64::Reg::RCX, 0)
    asm.test_rr(x64::Reg::RDX, x64::Reg::RDX)
    asm.jcc(x64::Cc::EQUAL, separators_done)
    asm.alu_ri(7, x64::Reg::RDX, 92)
    asm.jcc(x64::Cc::NOT_EQUAL, not_separator)
    asm.mov_ri(x64::Reg::RDX, 47)
    asm.store(1, x64::Reg::RDX, x64::Reg::RCX, 0)
    asm.bind(not_separator)
    asm.alu_ri(0, x64::Reg::RCX, 1)
    asm.jmp(separators)
    asm.bind(separators_done)
    asm.jmp(done)
    asm.bind(cwd_failed)
    asm.mov_ri(x64::Reg::RAX, negative(34))
    asm.jmp(done)

    // stat(path, buffer) and lstat: the mode (a directory or a regular file) at 24 and the size at 48 of the 144 bytes.
    asm.bind(stat_case)
    stat_failed := asm.new_label()
    emit_wide_path(asm, rt, stat_failed)
    asm.lea(x64::Reg::RCX, x64::Reg::RSP, 64)
    asm.mov_ri(x64::Reg::RDX, 0)
    asm.lea(x64::Reg::R8, x64::Reg::RSP, 16448)
    call_api(asm, rt, String("kernel32!GetFileAttributesExW"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, stat_failed)
    asm.mov_ri(x64::Reg::RAX, 0)
    zeroing := asm.new_label()
    asm.mov_ri(x64::Reg::RCX, 0)
    asm.bind(zeroing)
    asm.mov_rr(x64::Reg::RDX, reg_r13())
    asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RCX)
    asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
    asm.alu_ri(0, x64::Reg::RCX, 8)
    asm.alu_ri(7, x64::Reg::RCX, 144)
    asm.jcc(x64::Cc::BELOW, zeroing)
    asm.load(4, false, x64::Reg::RAX, x64::Reg::RSP, 16448)
    is_directory := asm.new_label()
    mode_done := asm.new_label()
    asm.alu_ri(4, x64::Reg::RAX, 16)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::NOT_EQUAL, is_directory)
    asm.mov_ri(x64::Reg::RAX, 33188)
    asm.jmp(mode_done)
    asm.bind(is_directory)
    asm.mov_ri(x64::Reg::RAX, 16877)
    asm.bind(mode_done)
    asm.store(4, x64::Reg::RAX, reg_r13(), 24)
    asm.load(4, false, x64::Reg::RAX, x64::Reg::RSP, 16448 + 28)
    asm.load(4, false, x64::Reg::RDX, x64::Reg::RSP, 16448 + 32)
    asm.mov_ri(x64::Reg::RCX, 32)
    asm.shift_cl(4, x64::Reg::RAX)
    asm.alu_rr(9, x64::Reg::RAX, x64::Reg::RDX)
    asm.store(8, x64::Reg::RAX, reg_r13(), 48)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.jmp(done)
    asm.bind(stat_failed)
    asm.mov_ri(x64::Reg::RAX, negative(2))
    asm.jmp(done)

    // getpid()
    asm.bind(getpid_case)
    call_api(asm, rt, String("kernel32!GetCurrentProcessId"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    asm.jmp(done)

    // sigaltstack: the thread's stack guarantee takes its place.
    asm.bind(sigaltstack_case)
    asm.mov_ri(x64::Reg::RAX, 0)

    asm.bind(done)
    asm.lea(x64::Reg::RSP, x64::Reg::RBP, (0 as i64) - 80)
    asm.pop(reg_r14())
    asm.pop(reg_r13())
    asm.pop(reg_r12())
    asm.pop(x64::Reg::R10)
    asm.pop(x64::Reg::R9)
    asm.pop(x64::Reg::R8)
    asm.pop(x64::Reg::RDX)
    asm.pop(x64::Reg::RSI)
    asm.pop(x64::Reg::RDI)
    asm.pop(x64::Reg::RBX)
    asm.pop(x64::Reg::RBP)
    asm.ret()
}

// Start-up: the console writes UTF-8, the thread keeps 64 KiB of stack for the exception handler, and the command line is
// split into arguments in UTF-8. Returns argc in rdi and the argument vector (a zero ends it) in rsi.
pub fun emit_init(asm: &mut x64::Asm, rt: &WinRt, arguments: bool) {
    asm.bind(rt.init_label)
    asm.push(x64::Reg::RBP)
    asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
    asm.push(x64::Reg::RBX)
    asm.push(reg_r12())
    asm.push(reg_r13())
    asm.push(reg_r14())
    asm.alu_ri(4, x64::Reg::RSP, (0 as i64) - 16)
    asm.alu_ri(5, x64::Reg::RSP, 128)
    asm.mov_ri(x64::Reg::RCX, 65001)
    call_api(asm, rt, String("kernel32!SetConsoleOutputCP"))
    asm.mov_ri(x64::Reg::RAX, 65536)
    asm.store(4, x64::Reg::RAX, x64::Reg::RSP, 64)
    asm.lea(x64::Reg::RCX, x64::Reg::RSP, 64)
    call_api(asm, rt, String("kernel32!SetThreadStackGuarantee"))
    when !arguments {
        asm.lea(x64::Reg::RSP, x64::Reg::RBP, (0 as i64) - 32)
        asm.pop(reg_r14()) asm.pop(reg_r13()) asm.pop(reg_r12()) asm.pop(x64::Reg::RBX) asm.pop(x64::Reg::RBP)
        asm.ret()
        return
    }
    call_api(asm, rt, String("kernel32!GetCommandLineW"))
    asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
    asm.lea(x64::Reg::RDX, x64::Reg::RSP, 72)
    call_api(asm, rt, String("shell32!CommandLineToArgvW"))
    asm.mov_rr(x64::Reg::RBX, x64::Reg::RAX)
    asm.load(4, false, reg_r12(), x64::Reg::RSP, 72)
    // The argument vector: (argc + 1) pointers.
    asm.mov_rr(x64::Reg::RDX, reg_r12())
    asm.mov_ri(x64::Reg::RAX, 8)
    asm.imul_rr(x64::Reg::RDX, x64::Reg::RAX)
    asm.alu_ri(0, x64::Reg::RDX, 8)
    asm.mov_ri(x64::Reg::RCX, 0)
    asm.mov_ri(x64::Reg::R8, 12288)
    asm.mov_ri(x64::Reg::R9, 4)
    call_api(asm, rt, String("kernel32!VirtualAlloc"))
    asm.mov_rr(reg_r13(), x64::Reg::RAX)
    asm.mov_ri(reg_r14(), 0)
    next := asm.new_label()
    finished := asm.new_label()
    asm.bind(next)
    asm.alu_rr(57, reg_r14(), reg_r12())
    asm.jcc(x64::Cc::ABOVE_EQUAL, finished)
    // rsi = the wide argument i
    asm.mov_rr(x64::Reg::RAX, reg_r14())
    asm.mov_ri(x64::Reg::RCX, 8)
    asm.imul_rr(x64::Reg::RAX, x64::Reg::RCX)
    asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RBX)
    asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
    // The size in UTF-8, then the buffer, then the conversion.
    asm.mov_ri(x64::Reg::RCX, 65001)
    asm.mov_ri(x64::Reg::RDX, 0)
    asm.mov_rr(x64::Reg::R8, x64::Reg::RSI)
    asm.mov_ri(x64::Reg::R9, 4294967295)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 40)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 48)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 56)
    call_api(asm, rt, String("kernel32!WideCharToMultiByte"))
    asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, 4)
    asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
    asm.mov_ri(x64::Reg::RCX, 0)
    asm.mov_rr(x64::Reg::RDX, x64::Reg::RDI)
    asm.mov_ri(x64::Reg::R8, 12288)
    asm.mov_ri(x64::Reg::R9, 4)
    call_api(asm, rt, String("kernel32!VirtualAlloc"))
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 80)
    asm.mov_ri(x64::Reg::RCX, 65001)
    asm.mov_ri(x64::Reg::RDX, 0)
    asm.mov_rr(x64::Reg::R8, x64::Reg::RSI)
    asm.mov_ri(x64::Reg::R9, 4294967295)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
    asm.store(8, x64::Reg::RDI, x64::Reg::RSP, 40)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 48)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 56)
    call_api(asm, rt, String("kernel32!WideCharToMultiByte"))
    // argv[i] = the buffer
    asm.mov_rr(x64::Reg::RAX, reg_r14())
    asm.mov_ri(x64::Reg::RCX, 8)
    asm.imul_rr(x64::Reg::RAX, x64::Reg::RCX)
    asm.alu_rr(1, x64::Reg::RAX, reg_r13())
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 80)
    asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
    asm.alu_ri(0, reg_r14(), 1)
    asm.jmp(next)
    asm.bind(finished)
    asm.mov_rr(x64::Reg::RAX, reg_r12())
    asm.mov_ri(x64::Reg::RCX, 8)
    asm.imul_rr(x64::Reg::RAX, x64::Reg::RCX)
    asm.alu_rr(1, x64::Reg::RAX, reg_r13())
    asm.mov_ri(x64::Reg::RCX, 0)
    asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
    asm.mov_rr(x64::Reg::RDI, reg_r12())
    asm.mov_rr(x64::Reg::RSI, reg_r13())
    asm.lea(x64::Reg::RSP, x64::Reg::RBP, (0 as i64) - 32)
    asm.pop(reg_r14())
    asm.pop(reg_r13())
    asm.pop(reg_r12())
    asm.pop(x64::Reg::RBX)
    asm.pop(x64::Reg::RBP)
    asm.ret()
}

// The vectored exception handler, called by Windows with a pointer to the EXCEPTION_POINTERS in rcx. An access violation
// or a stack overflow becomes a call of the program's SIGSEGV handler with a `siginfo` whose fault address is at 16 and
// a `ucontext` whose stack pointer is at 160; the handler ends the process. Any other exception is passed on.
pub fun emit_veh(asm: &mut x64::Asm, rt: &WinRt) {
    asm.bind(rt.veh_label)
    asm.push(x64::Reg::RBP)
    asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
    asm.push(x64::Reg::RBX)
    asm.push(x64::Reg::RSI)
    asm.push(x64::Reg::RDI)
    asm.alu_ri(4, x64::Reg::RSP, (0 as i64) - 16)
    asm.alu_ri(5, x64::Reg::RSP, 640)
    access := asm.new_label()
    overflow := asm.new_label()
    go := asm.new_label()
    leave := asm.new_label()
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RCX, 0)
    asm.load(4, false, x64::Reg::RDX, x64::Reg::RAX, 0)
    asm.mov_ri(x64::Reg::R8, 3221225477)
    asm.alu_rr(57, x64::Reg::RDX, x64::Reg::R8)
    asm.jcc(x64::Cc::EQUAL, access)
    asm.mov_ri(x64::Reg::R8, 3221225725)
    asm.alu_rr(57, x64::Reg::RDX, x64::Reg::R8)
    asm.jcc(x64::Cc::EQUAL, overflow)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.jmp(leave)
    asm.bind(access)
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 40)
    asm.jmp(go)
    asm.bind(overflow)
    asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RDX, 152)
    asm.bind(go)
    asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
    asm.load(8, false, x64::Reg::RDX, x64::Reg::RDX, 152)
    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 16)
    asm.store(8, x64::Reg::RDX, x64::Reg::RSP, 288)
    asm.mov_ri(x64::Reg::RDI, 11)
    asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
    asm.lea(x64::Reg::RDX, x64::Reg::RSP, 128)
    asm.lea_symbol(x64::Reg::RAX, rt.state_symbol)
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 0)
    asm.call_reg(x64::Reg::RAX)
    asm.bind(leave)
    asm.lea(x64::Reg::RSP, x64::Reg::RBP, (0 as i64) - 24)
    asm.pop(x64::Reg::RDI)
    asm.pop(x64::Reg::RSI)
    asm.pop(x64::Reg::RBX)
    asm.pop(x64::Reg::RBP)
    asm.ret()
}
