// Text routines for the native backend that work on Unicode scalars: trimming white space, changing case, finding and
// replacing text. Each is written once as a runtime routine; the registers on entry and return are given on each.
//
// Case changes cover ASCII, Latin-1 and Latin Extended-A letters, Greek and Cyrillic capitals and small letters, and
// `ß` (to `SS`); letters of other scripts are left as they are. White space is Unicode's White_Space property, as
// Rust's `trim` uses.

use back::x64

// Decodes the scalar at r8 into rax and its length in bytes into r9. Clobbers rcx.
fun decode(asm: &mut x64::Asm) {
    one := asm.new_label()
    two := asm.new_label()
    three := asm.new_label()
    done := asm.new_label()
    asm.load(1, false, x64::Reg::RAX, x64::Reg::R8, 0)
    asm.alu_ri(7, x64::Reg::RAX, 128)
    asm.jcc(x64::Cc::BELOW, one)
    asm.alu_ri(7, x64::Reg::RAX, 224)
    asm.jcc(x64::Cc::BELOW, two)
    asm.alu_ri(7, x64::Reg::RAX, 240)
    asm.jcc(x64::Cc::BELOW, three)
    // Four bytes.
    asm.alu_ri(4, x64::Reg::RAX, 7)
    continuation(asm, 1, 18)
    continuation(asm, 2, 12)
    continuation(asm, 3, 6)
    asm.load(1, false, x64::Reg::RCX, x64::Reg::R8, 4)
    asm.mov_ri(x64::Reg::R9, 4)
    asm.jmp(done)
    asm.bind(three)
    asm.alu_ri(4, x64::Reg::RAX, 15)
    continuation(asm, 1, 12)
    continuation(asm, 2, 6)
    asm.mov_ri(x64::Reg::R9, 3)
    asm.jmp(done)
    asm.bind(two)
    asm.alu_ri(4, x64::Reg::RAX, 31)
    continuation(asm, 1, 6)
    asm.mov_ri(x64::Reg::R9, 2)
    asm.jmp(done)
    asm.bind(one)
    asm.mov_ri(x64::Reg::R9, 1)
    asm.bind(done)
}

// Builds a scalar from its leading bits in rax and the continuation byte at r8 + `at`, which brings six bits and
// leaves the scalar's higher bits where they are. The shift is applied to rax already holding the earlier bits: the
// earlier bits are shifted left by 6, and the new six are added. `unused` only documents the position of the byte.
fun continuation(asm: &mut x64::Asm, at: i64, unused: u64) {
    asm.mov_ri(x64::Reg::RCX, 6)
    asm.shift_cl(4, x64::Reg::RAX)
    asm.load(1, false, x64::Reg::RCX, x64::Reg::R8, at)
    asm.alu_ri(4, x64::Reg::RCX, 63)
    asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RCX)
}

// Sets the flags to equal when rax is a White_Space scalar and jumps to `space` for it.
fun jump_if_space(asm: &mut x64::Asm, space: u64) {
    no := asm.new_label()
    asm.alu_ri(7, x64::Reg::RAX, 32)
    asm.jcc(x64::Cc::EQUAL, space)
    asm.mov_rr(x64::Reg::R10, x64::Reg::RAX)
    asm.alu_ri(5, x64::Reg::R10, 9)
    asm.alu_ri(7, x64::Reg::R10, 4)
    asm.jcc(x64::Cc::BELOW_EQUAL, space)
    asm.alu_ri(7, x64::Reg::RAX, 133)
    asm.jcc(x64::Cc::EQUAL, space)
    asm.alu_ri(7, x64::Reg::RAX, 160)
    asm.jcc(x64::Cc::EQUAL, space)
    asm.alu_ri(7, x64::Reg::RAX, 5760)
    asm.jcc(x64::Cc::EQUAL, space)
    asm.mov_rr(x64::Reg::R10, x64::Reg::RAX)
    asm.alu_ri(5, x64::Reg::R10, 8192)
    asm.alu_ri(7, x64::Reg::R10, 10)
    asm.jcc(x64::Cc::BELOW_EQUAL, space)
    asm.alu_ri(7, x64::Reg::RAX, 8232)
    asm.jcc(x64::Cc::EQUAL, space)
    asm.alu_ri(7, x64::Reg::RAX, 8233)
    asm.jcc(x64::Cc::EQUAL, space)
    asm.alu_ri(7, x64::Reg::RAX, 8239)
    asm.jcc(x64::Cc::EQUAL, space)
    asm.alu_ri(7, x64::Reg::RAX, 8287)
    asm.jcc(x64::Cc::EQUAL, space)
    asm.alu_ri(7, x64::Reg::RAX, 12288)
    asm.jcc(x64::Cc::EQUAL, space)
    asm.bind(no)
}

// Trim: rsi and rdx are the text, rcx the mode (1 trims the start, 2 the end, 3 both). On return rsi and rdx are the
// part that is kept.
pub fun emit_trim(asm: &mut x64::Asm, label: u64) {
    asm.bind(label)
    asm.push(x64::Reg::RBP)
    asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
    asm.push(x64::Reg::RBX)
    asm.push(x64::Reg::RDI)
    asm.mov_rr(x64::Reg::RBX, x64::Reg::RCX)
    // rdi is the end of the text; rsi moves forward over leading white space.
    asm.mov_rr(x64::Reg::RDI, x64::Reg::RSI)
    asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RDX)
    start_done := asm.new_label()
    start_loop := asm.new_label()
    start_skip := asm.new_label()
    asm.mov_rr(x64::Reg::RAX, x64::Reg::RBX)
    asm.alu_ri(4, x64::Reg::RAX, 1)
    asm.jcc(x64::Cc::EQUAL, start_done)
    asm.bind(start_loop)
    asm.alu_rr(57, x64::Reg::RSI, x64::Reg::RDI)
    asm.jcc(x64::Cc::ABOVE_EQUAL, start_done)
    asm.mov_rr(x64::Reg::R8, x64::Reg::RSI)
    decode(asm)
    jump_if_space(asm, start_skip)
    asm.jmp(start_done)
    asm.bind(start_skip)
    asm.alu_rr(1, x64::Reg::RSI, x64::Reg::R9)
    asm.jmp(start_loop)
    asm.bind(start_done)
    // The end moves back over trailing white space: back to the first byte of the previous scalar, then decode it.
    end_done := asm.new_label()
    end_loop := asm.new_label()
    end_skip := asm.new_label()
    back := asm.new_label()
    asm.mov_rr(x64::Reg::RAX, x64::Reg::RBX)
    asm.alu_ri(4, x64::Reg::RAX, 2)
    asm.jcc(x64::Cc::EQUAL, end_done)
    asm.bind(end_loop)
    asm.alu_rr(57, x64::Reg::RDI, x64::Reg::RSI)
    asm.jcc(x64::Cc::BELOW_EQUAL, end_done)
    asm.mov_rr(x64::Reg::R8, x64::Reg::RDI)
    asm.bind(back)
    asm.alu_ri(5, x64::Reg::R8, 1)
    asm.load(1, false, x64::Reg::RAX, x64::Reg::R8, 0)
    asm.alu_ri(4, x64::Reg::RAX, 192)
    asm.alu_ri(7, x64::Reg::RAX, 128)
    asm.jcc(x64::Cc::EQUAL, back)
    asm.mov_rr(x64::Reg::R11, x64::Reg::R8)
    decode(asm)
    jump_if_space(asm, end_skip)
    asm.jmp(end_done)
    asm.bind(end_skip)
    asm.mov_rr(x64::Reg::RDI, x64::Reg::R11)
    asm.jmp(end_loop)
    asm.bind(end_done)
    asm.mov_rr(x64::Reg::RDX, x64::Reg::RDI)
    asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RSI)
    asm.pop(x64::Reg::RDI)
    asm.pop(x64::Reg::RBX)
    asm.pop(x64::Reg::RBP)
    asm.ret()
}

// Writes the scalar in rax as UTF-8 at r11 and moves r11 past it. Clobbers rcx and r10.
fun encode(asm: &mut x64::Asm) {
    one := asm.new_label()
    two := asm.new_label()
    three := asm.new_label()
    done := asm.new_label()
    asm.alu_ri(7, x64::Reg::RAX, 128)
    asm.jcc(x64::Cc::BELOW, one)
    asm.alu_ri(7, x64::Reg::RAX, 2048)
    asm.jcc(x64::Cc::BELOW, two)
    asm.alu_ri(7, x64::Reg::RAX, 65536)
    asm.jcc(x64::Cc::BELOW, three)
    put_part(asm, 18, 240, 0)
    put_part(asm, 12, 128, 1)
    put_part(asm, 6, 128, 2)
    put_part(asm, 0, 128, 3)
    asm.alu_ri(0, x64::Reg::R11, 4)
    asm.jmp(done)
    asm.bind(three)
    put_part(asm, 12, 224, 0)
    put_part(asm, 6, 128, 1)
    put_part(asm, 0, 128, 2)
    asm.alu_ri(0, x64::Reg::R11, 3)
    asm.jmp(done)
    asm.bind(two)
    put_part(asm, 6, 192, 0)
    put_part(asm, 0, 128, 1)
    asm.alu_ri(0, x64::Reg::R11, 2)
    asm.jmp(done)
    asm.bind(one)
    asm.store(1, x64::Reg::RAX, x64::Reg::R11, 0)
    asm.alu_ri(0, x64::Reg::R11, 1)
    asm.bind(done)
}

fun put_part(asm: &mut x64::Asm, shift: u64, tag: u64, at: i64) {
    asm.mov_rr(x64::Reg::R10, x64::Reg::RAX)
    asm.mov_ri(x64::Reg::RCX, shift)
    asm.shift_cl(5, x64::Reg::R10)
    if_tag(asm, tag)
    asm.store(1, x64::Reg::R10, x64::Reg::R11, at)
}

fun if_tag(asm: &mut x64::Asm, tag: u64) {
    when tag == 128 {
        asm.alu_ri(4, x64::Reg::R10, 63)
    } else {
        when tag == 240 {
            asm.alu_ri(4, x64::Reg::R10, 7)
        } else {
            when tag == 224 {
                asm.alu_ri(4, x64::Reg::R10, 15)
            } else {
                asm.alu_ri(4, x64::Reg::R10, 31)
            }
        }
    }
    asm.alu_ri(1, x64::Reg::R10, tag as i64)
}

// Jumps to `hit` when rax - low <= span (unsigned): rax is in the range [low, low + span]. Clobbers r10.
fun jump_if_in(asm: &mut x64::Asm, low: i64, span: i64, hit: u64) {
    asm.mov_rr(x64::Reg::R10, x64::Reg::RAX)
    asm.alu_ri(5, x64::Reg::R10, low)
    asm.alu_ri(7, x64::Reg::R10, span)
    asm.jcc(x64::Cc::BELOW_EQUAL, hit)
}

// Case change: rsi and rdx are the text, rcx is 1 for upper case and 0 for lower. On return rsi and rdx are a new
// buffer from malloc and its length; the length of the text does not change, since each mapping keeps the byte count
// (`ß` becomes `SS`). `malloc` is the symbol of the C function.
pub fun emit_case(asm: &mut x64::Asm, label: u64, malloc: u64, freestanding: bool, malloc_label: u64) {
    asm.bind(label)
    asm.push(x64::Reg::RBP)
    asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
    asm.push(x64::Reg::RBX)
    asm.push(x64::Reg::RSI)
    asm.push(x64::Reg::RDX)
    asm.push(x64::Reg::RCX)
    asm.lea(x64::Reg::RDI, x64::Reg::RDX, 4)
    when freestanding {
        asm.call_label(malloc_label)
    } else {
        asm.call_aligned(malloc)
    }
    asm.mov_rr(x64::Reg::RBX, x64::Reg::RAX)
    asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, (0 as i64) - 16)
    asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 24)
    // r8 reads, r11 writes, r12-free: the end of the input is kept on the stack.
    asm.mov_rr(x64::Reg::R8, x64::Reg::RSI)
    asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RSI)
    asm.push(x64::Reg::RDX)
    asm.mov_rr(x64::Reg::R11, x64::Reg::RBX)
    next := asm.new_label()
    finish := asm.new_label()
    asm.bind(next)
    asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
    asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
    asm.jcc(x64::Cc::ABOVE_EQUAL, finish)
    decode(asm)
    asm.alu_rr(1, x64::Reg::R8, x64::Reg::R9)
    asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 32)
    lower := asm.new_label()
    store := asm.new_label()
    asm.test_rr(x64::Reg::RDX, x64::Reg::RDX)
    asm.jcc(x64::Cc::EQUAL, lower)
    upper_case(asm, store)
    asm.bind(lower)
    lower_case(asm)
    asm.bind(store)
    encode(asm)
    asm.jmp(next)
    asm.bind(finish)
    asm.alu_ri(0, x64::Reg::RSP, 8)
    asm.mov_rr(x64::Reg::RSI, x64::Reg::RBX)
    asm.mov_rr(x64::Reg::RDX, x64::Reg::R11)
    asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RBX)
    asm.lea(x64::Reg::RSP, x64::Reg::RBP, (0 as i64) - 8)
    asm.pop(x64::Reg::RBX)
    asm.pop(x64::Reg::RBP)
    asm.ret()
}

// The upper case of the scalar in rax, then a jump to `store`. A `ß` is written as two letters here.
fun upper_case(asm: &mut x64::Asm, store: u64) {
    sharp_s := asm.new_label()
    plain := asm.new_label()
    asm.alu_ri(7, x64::Reg::RAX, 223)
    asm.jcc(x64::Cc::EQUAL, sharp_s)
    // a-z, then the Latin-1 letters à-þ except ÷, then Greek and Cyrillic small letters.
    shift := asm.new_label()
    jump_if_in(asm, 97, 25, shift)
    jump_if_in(asm, 224, 30, shift)
    jump_if_in(asm, 945, 24, shift)
    jump_if_in(asm, 1072, 31, shift)
    cyr_ext := asm.new_label()
    jump_if_in(asm, 1104, 15, cyr_ext)
    // Latin Extended-A pairs: odd code points are the small letters in 0x100-0x17F (a subset of the block).
    ext := asm.new_label()
    jump_if_in(asm, 257, 62, ext)
    asm.jmp(plain)
    asm.bind(ext)
    asm.mov_rr(x64::Reg::R10, x64::Reg::RAX)
    asm.alu_ri(4, x64::Reg::R10, 1)
    asm.jcc(x64::Cc::EQUAL, plain)
    asm.alu_ri(5, x64::Reg::RAX, 1)
    asm.jmp(store)
    asm.bind(cyr_ext)
    asm.alu_ri(5, x64::Reg::RAX, 80)
    asm.jmp(store)
    asm.bind(shift)
    // ÷ (247) is not a letter, and the final sigma ς (962) maps to Σ (931).
    asm.alu_ri(7, x64::Reg::RAX, 247)
    asm.jcc(x64::Cc::EQUAL, plain)
    asm.alu_ri(7, x64::Reg::RAX, 962)
    final_sigma := asm.new_label()
    asm.jcc(x64::Cc::EQUAL, final_sigma)
    asm.alu_ri(5, x64::Reg::RAX, 32)
    asm.jmp(store)
    asm.bind(final_sigma)
    asm.mov_ri(x64::Reg::RAX, 931)
    asm.jmp(store)
    asm.bind(plain)
    asm.jmp(store)
    asm.bind(sharp_s)
    asm.mov_ri(x64::Reg::RAX, 83)
    asm.store(1, x64::Reg::RAX, x64::Reg::R11, 0)
    asm.alu_ri(0, x64::Reg::R11, 1)
    asm.jmp(store)
}

// The lower case of the scalar in rax; control falls through to the encoder.
fun lower_case(asm: &mut x64::Asm) {
    done := asm.new_label()
    shift := asm.new_label()
    jump_if_in(asm, 65, 25, shift)
    jump_if_in(asm, 192, 30, shift)
    jump_if_in(asm, 913, 24, shift)
    jump_if_in(asm, 1040, 31, shift)
    cyr_ext := asm.new_label()
    jump_if_in(asm, 1024, 15, cyr_ext)
    ext := asm.new_label()
    jump_if_in(asm, 256, 62, ext)
    asm.jmp(done)
    asm.bind(ext)
    asm.mov_rr(x64::Reg::R10, x64::Reg::RAX)
    asm.alu_ri(4, x64::Reg::R10, 1)
    asm.jcc(x64::Cc::NOT_EQUAL, done)
    asm.alu_ri(0, x64::Reg::RAX, 1)
    asm.jmp(done)
    asm.bind(cyr_ext)
    asm.alu_ri(0, x64::Reg::RAX, 80)
    asm.jmp(done)
    asm.bind(shift)
    asm.alu_ri(7, x64::Reg::RAX, 215)
    asm.jcc(x64::Cc::EQUAL, done)
    asm.alu_ri(0, x64::Reg::RAX, 32)
    asm.bind(done)
}

// Find: rdi and rcx are the text, rsi and rdx the pattern. On return rax is the byte offset of the first match, or
// -1. The caller turns the offset into a character index.
pub fun emit_find(asm: &mut x64::Asm, label: u64) {
    asm.bind(label)
    yes := asm.new_label()
    no := asm.new_label()
    attempt := asm.new_label()
    next := asm.new_label()
    compare := asm.new_label()
    asm.alu_rr(57, x64::Reg::RDX, x64::Reg::RCX)
    asm.jcc(x64::Cc::ABOVE, no)
    asm.mov_rr(x64::Reg::R9, x64::Reg::RCX)
    asm.alu_rr(41, x64::Reg::R9, x64::Reg::RDX)
    asm.mov_ri(x64::Reg::R8, 0)
    asm.bind(attempt)
    asm.alu_rr(57, x64::Reg::R8, x64::Reg::R9)
    asm.jcc(x64::Cc::ABOVE, no)
    asm.mov_ri(x64::Reg::R10, 0)
    asm.bind(compare)
    asm.alu_rr(57, x64::Reg::R10, x64::Reg::RDX)
    asm.jcc(x64::Cc::ABOVE_EQUAL, yes)
    asm.mov_rr(x64::Reg::R11, x64::Reg::RDI)
    asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
    asm.alu_rr(1, x64::Reg::R11, x64::Reg::R10)
    asm.load(1, false, x64::Reg::RAX, x64::Reg::R11, 0)
    asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
    asm.alu_rr(1, x64::Reg::R11, x64::Reg::R10)
    asm.load(1, false, x64::Reg::R11, x64::Reg::R11, 0)
    asm.alu_rr(57, x64::Reg::RAX, x64::Reg::R11)
    asm.jcc(x64::Cc::NOT_EQUAL, next)
    asm.alu_ri(0, x64::Reg::R10, 1)
    asm.jmp(compare)
    asm.bind(next)
    asm.alu_ri(0, x64::Reg::R8, 1)
    asm.jmp(attempt)
    asm.bind(yes)
    asm.mov_rr(x64::Reg::RAX, x64::Reg::R8)
    asm.ret()
    asm.bind(no)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.alu_ri(5, x64::Reg::RAX, 1)
    asm.ret()
}

// Reverse: rsi and rdx are the text. On return rsi and rdx are a new buffer from malloc and its length: the scalars of the text in
// the opposite order, each with its own bytes.
pub fun emit_reverse(asm: &mut x64::Asm, label: u64, malloc: u64, freestanding: bool, malloc_label: u64) {
    asm.bind(label)
    asm.push(x64::Reg::RBP)
    asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
    asm.push(x64::Reg::RBX)
    asm.push(x64::Reg::RSI)
    asm.push(x64::Reg::RDX)
    asm.lea(x64::Reg::RDI, x64::Reg::RDX, 1)
    when freestanding {
        asm.call_label(malloc_label)
    } else {
        asm.call_aligned(malloc)
    }
    asm.mov_rr(x64::Reg::RBX, x64::Reg::RAX)
    // r8 is the start of the text, r9 the end of what is left of it, r10 the next place to write.
    asm.load(8, false, x64::Reg::R8, x64::Reg::RBP, (0 as i64) - 16)
    asm.load(8, false, x64::Reg::R9, x64::Reg::RBP, (0 as i64) - 24)
    asm.alu_rr(1, x64::Reg::R9, x64::Reg::R8)
    asm.mov_rr(x64::Reg::R10, x64::Reg::RBX)
    scalar := asm.new_label()
    back := asm.new_label()
    copy := asm.new_label()
    finished := asm.new_label()
    asm.bind(scalar)
    asm.alu_rr(57, x64::Reg::R9, x64::Reg::R8)
    asm.jcc(x64::Cc::BELOW_EQUAL, finished)
    asm.mov_rr(x64::Reg::R11, x64::Reg::R9)
    asm.bind(back)
    asm.alu_ri(5, x64::Reg::R11, 1)
    asm.alu_rr(57, x64::Reg::R11, x64::Reg::R8)
    asm.jcc(x64::Cc::BELOW_EQUAL, copy)
    asm.load(1, false, x64::Reg::RAX, x64::Reg::R11, 0)
    asm.alu_ri(4, x64::Reg::RAX, 192)
    asm.alu_ri(7, x64::Reg::RAX, 128)
    asm.jcc(x64::Cc::EQUAL, back)
    asm.bind(copy)
    // The bytes from r11 up to r9 are one scalar; they are copied in order, and what is left of the text ends at r11.
    each := asm.new_label()
    scalar_done := asm.new_label()
    asm.mov_rr(x64::Reg::RCX, x64::Reg::R11)
    asm.bind(each)
    asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R9)
    asm.jcc(x64::Cc::ABOVE_EQUAL, scalar_done)
    asm.load(1, false, x64::Reg::RAX, x64::Reg::RCX, 0)
    asm.store(1, x64::Reg::RAX, x64::Reg::R10, 0)
    asm.alu_ri(0, x64::Reg::RCX, 1)
    asm.alu_ri(0, x64::Reg::R10, 1)
    asm.jmp(each)
    asm.bind(scalar_done)
    asm.mov_rr(x64::Reg::R9, x64::Reg::R11)
    asm.jmp(scalar)
    asm.bind(finished)
    asm.mov_rr(x64::Reg::RSI, x64::Reg::RBX)
    asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 24)
    asm.lea(x64::Reg::RSP, x64::Reg::RBP, (0 as i64) - 8)
    asm.pop(x64::Reg::RBX)
    asm.pop(x64::Reg::RBP)
    asm.ret()
}
