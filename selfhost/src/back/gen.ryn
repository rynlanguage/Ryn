// The native backend in Ryn for the scalar subset: typed IR in, a relocatable x86-64 object out (see `elf.ryn`). The
// object links with `ld` or `cc` into an executable whose `_start` calls `main` and exits with its result.
//
// The subset: integers of every width, `bool` values, and `char` values in locals, parameters and results; the
// arithmetic, bitwise and comparison operators, with fixed-width wrapping; `when`, `while`, `for`, `break`, `continue`
// and `return`; calls of functions of the program with up to six arguments; and `echo` of integers, booleans and string
// literals. Anything else makes `generate` report that the program is not handled.
//
// Every local lives in an eight-byte cell below the frame pointer. An expression leaves its value in rax, normalized to
// the width of its type: sign-extended for signed types, zero-extended otherwise. Arguments travel in the System V
// argument registers; each call pushes its arguments and then loads them. Output goes to standard output by system
// calls, so no C library is used.

use back::x64
use back::elf
use back::floats
use back::textops
use back::rt
use middle::ir

fun if_text(keys: bool, key_text: bool, value_text: bool) -> bool {
    when keys {
        return key_text
    }
    return value_text
}

// Whether the freestanding runtime has a routine for the C function `name`.
fun rt_provides(name: String) -> bool {
    return name == "ryn_native_live_allocations" || name == "ryn_native_live_bytes" || name == "malloc" || name == "free" || name == "realloc" || name == "calloc" || name == "memcpy" || name == "memmove" || name == "strlen" || name == "fopen" || name == "fseek" || name == "ftell" || name == "fread" || name == "fwrite" || name == "fclose" || name == "strerror" || name == "__errno_location" || name == "putchar" || name == "chmod"
}

// The 64-bit pattern of an integer literal's text (a leading `-` negates it).
fun literal_bits(text: String) -> u64 {
    mut negative := false
    mut at: u64 = 0
    when text.len() > 0 && text.byte_at(0) == 45 {
        negative = true
        at = 1
    }
    mut value: u64 = 0
    while at < text.len() {
        value = value * 10 + ((text.byte_at(at) - 48) as u64)
        at += 1
    }
    when negative {
        return (0 as u64) - value
    }
    return value
}

// The System V register that carries argument `index`.
fun arg_register(index: u64) -> u64 {
    when index == 0 { return x64::Reg::RDI }
    when index == 1 { return x64::Reg::RSI }
    when index == 2 { return x64::Reg::RDX }
    when index == 3 { return x64::Reg::RCX }
    when index == 4 { return x64::Reg::R8 }
    return x64::Reg::R9
}

// The displacement from the frame pointer of a local's cell.
fun slot_disp(slot: u64) -> i64 {
    return (0 as i64) - (((slot + 1) * 8) as i64)
}

// The width in bytes of a scalar type word, or 0 for a word this backend does not handle.
fun width_of(word: String) -> u64 {
    when word == "I8" || word == "U8" || word == "Bool" { return 1 }
    when word == "I16" || word == "U16" { return 2 }
    when word == "I32" || word == "U32" || word == "Char" { return 4 }
    when word == "I64" || word == "U64" || word == "F64" { return 8 }
    when word == "F32" { return 4 }
    return 0
}

// The width of a scalar word in a cell: `width_of`, and 8 for an owned String, which is the address of its header.
fun string_width(word: String) -> u64 {
    when word == "OwnedString" {
        return 8
    }
    return width_of(word)
}

fun is_integer_word(word: String) -> bool {
    return word.starts_with("I") || word.starts_with("U")
}

fun is_signed_word(word: String) -> bool {
    return word == "I8" || word == "I16" || word == "I32" || word == "I64"
}

// The condition that holds for the reverse of a comparison's, for the branch that leaves a loop.
fun negated_condition(condition: u64) -> u64 {
    when condition == x64::Cc::LESS { return x64::Cc::GREATER_EQUAL }
    when condition == x64::Cc::LESS_EQUAL { return x64::Cc::GREATER }
    when condition == x64::Cc::BELOW { return x64::Cc::ABOVE_EQUAL }
    return x64::Cc::ABOVE
}

pub struct Gen {
    program: ir::IrProgram,
    // The label of each function, by function index.
    labels: Vec<u64>,
    // The targets of `break` and `continue` in the loops being generated, innermost last.
    breaks: Vec<u64>,
    continues: Vec<u64>,
    // The bytes of the string literals, and each literal's offset, length and index in the list of literals.
    rodata: Vec<u8>,
    literal_offsets: Vec<u64>,
    literal_lengths: Vec<u64>,
    // The symbol table of the object: symbol 0 is `main`, then the literals' and the foreign functions' symbols. The
    // symbol of each literal is in `literal_symbols`.
    symbol_names: Vec<String>,
    symbol_sections: Vec<u64>,
    symbol_values: Vec<u64>,
    symbol_sizes: Vec<u64>,
    symbol_global: Vec<bool>,
    literal_symbols: Vec<u64>,
    // The handler of a segmentation fault, which reports a stack overflow, and the messages it writes.
    handler_label: u64,
    division_error_label: u64,
    index_error_label: u64,
    index_literal: u64,
    overflow_literal: u64,
    invalid_literal: u64,
    division_literal: u64,
    // The labels of the runtime routines: writing a buffer, and printing an unsigned, signed or boolean value.
    write_label: u64,
    map_hash_scalar: u64,
    map_hash_string: u64,
    map_find_scalar: u64,
    map_find_string: u64,
    map_grow: u64,
    string_less_label: u64,
    string_clone_label: u64,
    // Whether each function is reached from `main`: only those are generated.
    needed: Vec<bool>,
    // The element types of the vector clone routines asked for, and their labels.
    vec_routine_elements: Vec<u64>,
    vec_routine_labels: Vec<u64>,
    // The C runtime's argc and argv, which the entry stores: a zero-filled cell of 16 bytes.
    arguments_symbol: u64,
    map_clone_plain: u64,
    map_clone_key_text: u64,
    map_clone_value_text: u64,
    map_clone_both_text: u64,
    print_u64_label: u64,
    print_i64_label: u64,
    print_bool_label: u64,
    // The routine that formats a float as text, and whether the program needs it: it is written only when it does.
    float_format_label: u64,
    float_format_used: bool,
    // The cells past the locals that the function being generated uses for temporaries (arrays and slices that are not in
    // a local); the frame is sized once the body is generated.
    // The Unicode text routines (1 trim, 2 case, 4 find) the program uses, and their labels.
    textops_used: u64,
    trim_label: u64,
    case_label: u64,
    reverse_label: u64,
    find_label: u64,
    // The drop routines of vectors and maps of destructor values: kind (0 vector, 1 map), element type, label.
    // The C size of the `repr(C)` structure that a memory copy moves (zero for the other structures).
    copy_ty_id: u64,
    // The `repr(C)` locals whose address was taken in the function being generated: the slot, the scratch cells that hold its
    // C layout, and its structure. The layout is brought up to date before a foreign call, and read back after it.
    shadow_slots: Vec<u64>,
    shadow_images: Vec<u64>,
    shadow_ids: Vec<u64>,
    // The enums whose values are copied by a routine of their own, and its labels.
    // Whether the object runs without the C library (its own `_start` and the routines of `back/rt.ryn`), and their labels.
    freestanding: bool,
    rt: rt::Labels,
    enum_clone_ids: Vec<u64>,
    enum_clone_labels: Vec<u64>,
    glue_kinds: Vec<u64>,
    map_value_type: u64,
    glue_elements: Vec<u64>,
    glue_labels: Vec<u64>,
    scratch_base: u64,
    scratch_used: u64,
    // The functions whose address is taken, and the labels of their C-convention entry points.
    thunk_functions: Vec<u64>,
    thunk_labels: Vec<u64>,
    failed: bool,
    reason: String,
    // The cells of the arguments of the function being generated, and its result when that is a string or a structure:
    // the caller reserves the result cells above the arguments, and the callee writes them there.
    argument_cells: u64,
    result_cells: u64,
    result_type: u64,
    // The slots of the destructor values that the function owns, in ascending order, with their types.
    owner_slots: Vec<u64>,
    owner_types: Vec<u64>,
    // The routines that drop a value at an address (by type), and that free a handle (by owner type), with their labels.
    drop_value_ids: Vec<u64>,
    drop_value_labels: Vec<u64>,
    drop_handle_ids: Vec<u64>,
    drop_handle_labels: Vec<u64>,
    drop_values_done: u64,
    drop_handles_done: u64,
    // Whether the cells of each value routine rise in memory with the cell index (an enum box) or fall (a local, a vector
    // element: cell 0 is the highest word).
    drop_value_ascending: Vec<bool>,
    // The argument expressions that are read from a frame cell instead of being evaluated: a temporary that a builtin call borrows.
    temp_exprs: Vec<u64>,
    temp_cells: Vec<u64>,
    temp_ready: Vec<bool>,
}

// The literals that the runtime routines and `echo` use, in the order their indices are fixed.
fun newline_literal() -> u64 {
    return 0
}

fun true_literal() -> u64 {
    return 1
}

fun false_literal() -> u64 {
    return 2
}

// Generates the object of a program, or the reason it is not handled.
pub fun generate(program: ir::IrProgram) -> Result<Vec<u8>, String> {
    return build(program, false, false)
}

// The program as a static executable, when it needs nothing from the C library.
pub fun generate_executable(program: ir::IrProgram) -> Result<Vec<u8>, String> {
    return build(program, true, false)
}

// An object linked against libc, including its floating-point formatting and parsing routines.
pub fun generate_libc(program: ir::IrProgram) -> Result<Vec<u8>, String> {
    return build(program, false, true)
}

fun build(program: ir::IrProgram, executable: bool, libc: bool) -> Result<Vec<u8>, String> {
    mut asm := x64::new_asm()
    mut gen := Gen {
        program: program,
        labels: Vec(),
        breaks: Vec(),
        continues: Vec(),
        rodata: Vec(),
        literal_offsets: Vec(),
        literal_lengths: Vec(),
        symbol_names: Vec(),
        symbol_sections: Vec(),
        symbol_values: Vec(),
        symbol_sizes: Vec(),
        symbol_global: Vec(),
        literal_symbols: Vec(),
        handler_label: 0,
        division_error_label: 0,
        index_error_label: 0,
        index_literal: 0,
        overflow_literal: 0,
        invalid_literal: 0,
        division_literal: 0,
        write_label: 0,
        map_hash_scalar: 0,
        map_hash_string: 0,
        map_find_scalar: 0,
        map_find_string: 0,
        map_grow: 0,
        string_less_label: 0,
        string_clone_label: 0,
        needed: Vec(),
        vec_routine_elements: Vec(),
        vec_routine_labels: Vec(),
        arguments_symbol: 0,
        map_clone_plain: 0,
        map_clone_key_text: 0,
        map_clone_value_text: 0,
        map_clone_both_text: 0,
        print_u64_label: 0,
        print_i64_label: 0,
        print_bool_label: 0,
        float_format_label: 0,
        float_format_used: false,
        textops_used: 0,
        trim_label: 0,
        case_label: 0,
        reverse_label: 0,
        find_label: 0,
        copy_ty_id: 0,
        shadow_slots: Vec(),
        shadow_images: Vec(),
        shadow_ids: Vec(),
        freestanding: false,
        rt: rt::Labels { malloc: 0, free: 0, realloc: 0, calloc: 0, memcpy: 0, memmove: 0, strlen: 0, fopen: 0, fseek: 0, ftell: 0, fread: 0, fwrite: 0, fclose: 0, strerror: 0, errno_location: 0, putchar: 0, chmod: 0, sigreturn: 0, live_allocations: 0, live_bytes: 0, state: 0 },
        enum_clone_ids: Vec(),
        enum_clone_labels: Vec(),
        glue_kinds: Vec(),
        map_value_type: 0,
        glue_elements: Vec(),
        glue_labels: Vec(),
        scratch_base: 0,
        scratch_used: 0,
        thunk_functions: Vec(),
        thunk_labels: Vec(),
        failed: false,
        reason: String(""),
        argument_cells: 0,
        result_cells: 0,
        result_type: 0,
        owner_slots: Vec(),
        owner_types: Vec(),
        drop_value_ids: Vec(),
        drop_value_labels: Vec(),
        drop_handle_ids: Vec(),
        drop_handle_labels: Vec(),
        drop_values_done: 0,
        drop_handles_done: 0,
        drop_value_ascending: Vec(),
        temp_exprs: Vec(),
        temp_cells: Vec(),
        temp_ready: Vec(),
    }
    // Symbol 0 is the entry point `main`, which the C runtime calls; its size is set when the object is made.
    gen.freestanding = !libc
    for function in gen.program.functions.clone() {
        when function.external_symbol.is_some() && !rt_provides(function.external_symbol.unwrap()) {
            gen.freestanding = false
        }
    }
    when gen.freestanding {
        gen.symbol(String("_start"), elf::Where::TEXT, 0, 0, true)
    } else {
        gen.symbol(String("main"), elf::Where::TEXT, 0, 0, true)
    }
    gen.arguments_symbol = gen.symbol(String("ryn_arguments"), elf::Where::BSS, 0, 16, false)
    gen.rt.state = gen.symbol(String("ryn_runtime"), elf::Where::BSS, 16, rt::state_size(), false)
    gen.rt.live_allocations = asm.new_label()
    gen.rt.live_bytes = asm.new_label()
    gen.rt.malloc = asm.new_label()
    gen.rt.free = asm.new_label()
    gen.rt.realloc = asm.new_label()
    gen.rt.calloc = asm.new_label()
    gen.rt.memcpy = asm.new_label()
    gen.rt.memmove = asm.new_label()
    gen.rt.strlen = asm.new_label()
    gen.rt.fopen = asm.new_label()
    gen.rt.fseek = asm.new_label()
    gen.rt.ftell = asm.new_label()
    gen.rt.fread = asm.new_label()
    gen.rt.fwrite = asm.new_label()
    gen.rt.fclose = asm.new_label()
    gen.rt.strerror = asm.new_label()
    gen.rt.errno_location = asm.new_label()
    gen.rt.putchar = asm.new_label()
    gen.rt.chmod = asm.new_label()
    gen.rt.sigreturn = asm.new_label()
    gen.literal(String("\n"))
    gen.literal(String("true"))
    gen.literal(String("false"))
    gen.overflow_literal = gen.literal(String("Ryn runtime error: stack overflow (recursion is too deep)\n"))
    gen.invalid_literal = gen.literal(String("Ryn runtime error: invalid memory access (segmentation fault)\n"))
    gen.handler_label = asm.new_label()
    gen.division_error_label = asm.new_label()
    gen.index_error_label = asm.new_label()
    gen.index_literal = gen.literal(String("Ryn runtime error: array index is out of bounds\n"))
    gen.division_literal = gen.literal(String("Ryn runtime error: integer division or remainder by zero\n"))
    gen.write_label = asm.new_label()
    gen.map_hash_scalar = asm.new_label()
    gen.map_hash_string = asm.new_label()
    gen.map_find_scalar = asm.new_label()
    gen.map_find_string = asm.new_label()
    gen.map_grow = asm.new_label()
    gen.string_less_label = asm.new_label()
    gen.string_clone_label = asm.new_label()
    gen.map_clone_plain = asm.new_label()
    gen.map_clone_key_text = asm.new_label()
    gen.map_clone_value_text = asm.new_label()
    gen.map_clone_both_text = asm.new_label()
    gen.print_u64_label = asm.new_label()
    gen.print_i64_label = asm.new_label()
    gen.print_bool_label = asm.new_label()
    gen.float_format_label = asm.new_label()
    gen.trim_label = asm.new_label()
    gen.case_label = asm.new_label()
    gen.reverse_label = asm.new_label()
    gen.find_label = asm.new_label()
    mut position: u64 = 0
    while position < gen.program.functions.len() {
        label := asm.new_label()
        gen.labels.push(label)
        gen.needed.push(false)
        position += 1
    }
    gen.needed.set(gen.program.main_index, true)
    gen.entry(&mut asm)
    start_size := asm.code.len()
    gen.runtime(&mut asm)
    // The functions reached from `main` are generated; generating one may reach more, so the scan repeats until none is new.
    mut generated: Vec<bool> = Vec()
    while generated.len() < gen.program.functions.len() {
        generated.push(false)
    }
    mut progress: bool = true
    while progress {
        progress = false
        position = 0
        while position < gen.program.functions.len() {
            when gen.needed[position] && !generated[position] {
                generated.set(position, true)
                when !gen.function(&mut asm, position) {
                    return Result::Err(gen.reason.clone())
                }
                progress = true
            }
            position += 1
        }
        before := gen.drop_values_done + gen.drop_handles_done
        when !gen.emit_drop_routines(&mut asm) {
            return Result::Err(gen.reason.clone())
        }
        when gen.drop_values_done + gen.drop_handles_done != before {
            progress = true
        }
    }
    when gen.failed {
        return Result::Err(gen.reason.clone())
    }
    when !gen.emit_vec_routines(&mut asm) {
        return Result::Err(gen.reason.clone())
    }
    when !gen.emit_thunks(&mut asm) {
        return Result::Err(gen.reason.clone())
    }
    when gen.freestanding {
        gen.emit_freestanding(&mut asm)
        when gen.failed {
            return Result::Err(gen.reason.clone())
        }
    }
    when gen.textops_used % 2 == 1 {
        textops::emit_trim(&mut asm, gen.trim_label)
    }
    when gen.textops_used / 2 % 2 == 1 {
        mut malloc: u64 = 0
        when !gen.freestanding {
            malloc = gen.foreign_symbol(String("malloc"))
        }
        textops::emit_case(&mut asm, gen.case_label, malloc, gen.freestanding, gen.rt.malloc)
    }
    when gen.textops_used / 8 % 2 == 1 {
        mut reverse_malloc: u64 = 0
        when !gen.freestanding {
            reverse_malloc = gen.foreign_symbol(String("malloc"))
        }
        textops::emit_reverse(&mut asm, gen.reverse_label, reverse_malloc, gen.freestanding, gen.rt.malloc)
    }
    when gen.textops_used / 4 % 2 == 1 {
        textops::emit_find(&mut asm, gen.find_label)
    }
    when gen.float_format_used {
        snprintf := gen.foreign_symbol(String("snprintf"))
        strtod := gen.foreign_symbol(String("strtod"))
        strtof := gen.foreign_symbol(String("strtof"))
        fesetround := gen.foreign_symbol(String("fesetround"))
        floats::emit_float_format(&mut asm, gen.float_format_label, snprintf, strtod, strtof, fesetround)
    }
    when !asm.resolve() {
        return Result::Err(String("a jump has no target"))
    }
    when executable {
        when !gen.freestanding {
            return Result::Err(String("the program calls the C library, so it cannot be linked without it"))
        }
        return elf::link_executable(gen.object(&mut asm, start_size))
    }
    return Result::Ok(elf::write_object(gen.object(&mut asm, start_size)))
}

extend Gen {
    // Records a string literal and returns its index. Literal `i` is the symbol `i + 1`, since symbol 0 is `_start`.
    fun literal(mut self, text: String) -> u64 {
        index := self.literal_offsets.len()
        mut name := String("ryn_literal_")
        name.append(String(index))
        self.literal_symbols.push(self.symbol(name, elf::Where::RODATA, self.rodata.len(), text.len(), false))
        self.literal_offsets.push(self.rodata.len())
        self.literal_lengths.push(text.len())
        mut at: u64 = 0
        while at < text.len() {
            self.rodata.push(text.byte_at(at))
            at += 1
        }
        return index
    }

    // Adds a symbol to the object's table and returns its index.
    fun symbol(mut self, name: String, section: u64, value: u64, size: u64, global: bool) -> u64 {
        index := self.symbol_names.len()
        self.symbol_names.push(name)
        self.symbol_sections.push(section)
        self.symbol_values.push(value)
        self.symbol_sizes.push(size)
        self.symbol_global.push(global)
        return index
    }

    // The symbol of a foreign function, which the link resolves; it is added the first time the program calls it.
    fun foreign_symbol(mut self, name: String) -> u64 {
        mut index: u64 = 0
        while index < self.symbol_names.len() {
            when self.symbol_sections[index] == elf::Where::UNDEFINED && self.symbol_names[index] == name {
                return index
            }
            index += 1
        }
        return self.symbol(name, elf::Where::UNDEFINED, 0, 0, true)
    }

    // The name of the kind of an expression, for the reasons a program is declined.
    fun expr_name(self, index: u64) -> String {
        return choose self.program.exprs[index] {
            ir::IrExpr::IntegerLit(text, ty) => String("an integer literal"),
            ir::IrExpr::FloatLit(bits, ty) => String("a float literal"),
            ir::IrExpr::StrLit(text) => String("a string literal"),
            ir::IrExpr::CharLit(scalar) => String("a character literal"),
            ir::IrExpr::BoolLit(flag) => String("a boolean literal"),
            ir::IrExpr::LocalRef(slot, ty, span) => String("a local"),
            ir::IrExpr::MoveRef(slot, ty) => String("a moved local"),
            ir::IrExpr::StructValue(id, fields, values) => String("a structure literal"),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => String("a field read"),
            ir::IrExpr::ReferenceFieldRead(value, id, field, ty, span, borrowed) => String("a field read through a reference"),
            ir::IrExpr::ValueAddress(value, ty, pointer, span) => String("the address of a value"),
            ir::IrExpr::CallExpr(target, arguments, ty) => String("a call"),
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => String("an if expression"),
            ir::IrExpr::EnumMatch(value, id, arms, ty) => String("a choose expression"),
            ir::IrExpr::Propagate(value, a, b, c, d, e, f, g, deferred) => String("a propagation"),
            ir::IrExpr::ArrayValue(items) => String("an array literal"),
            ir::IrExpr::ArrayRepeat(value, count) => String("an array repeat"),
            ir::IrExpr::ArrayAsSlice(array, ty, length) => String("an array as a slice"),
            ir::IrExpr::ArrayIndex(array, index, ty, length) => String("an array index"),
            ir::IrExpr::SliceIndex(slice, index, ty) => String("a slice index"),
            ir::IrExpr::SliceElementAddress(slice, index, ty, span) => String("the address of a slice element"),
            ir::IrExpr::AddressOf(slot, ty, pointer, span) => String("the address of a local"),
            ir::IrExpr::Dereference(pointer, ty) => String("a dereference"),
            ir::IrExpr::StringFindOption(value, id) => String("a find result"),
            ir::IrExpr::StringAsStr(value) => String("a String as str"),
            ir::IrExpr::Binary(op, left, right, ty) => String("an arithmetic expression"),
            ir::IrExpr::Negate(value, ty) => String("a negation"),
            ir::IrExpr::Not(value) => String("a logical not"),
            ir::IrExpr::BitNot(value, ty) => String("a bitwise not"),
            ir::IrExpr::FunctionAddress(function, ty) => String("a function address"),
            ir::IrExpr::CastExpr(value, source, target) => String("a cast"),
        }
    }

    // Declines with `what` and the kind of the expression at `index`.
    fun fail_at(mut self, what: str, index: u64) -> bool {
        mut message := String(what)
        message.append(" (")
        message.append(self.expr_name(index))
        message.append(")")
        when !self.failed {
            self.failed = true
            self.reason = message
        }
        return false
    }

    fun fail(mut self, what: str) -> bool {
        when !self.failed {
            self.failed = true
            self.reason = String(what)
        }
        return false
    }

    // The scalar type word of a type index, or "" for a type that is not scalar.
    fun word(self, ty: u64) -> String {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => word,
            _ => String(""),
        }
    }

    // Brings the value in rax to the canonical form of its type: sign-extended from its width for a signed type,
    // zero-extended otherwise. 64-bit types are already canonical.
    fun normalize(mut self, asm: &mut x64::Asm, word: String) {
        width := width_of(word.clone())
        when width == 0 || width == 8 {
            return
        }
        when is_signed_word(word) {
            asm.sext_rr(x64::Reg::RAX, x64::Reg::RAX, width)
        } else {
            asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, width)
        }
    }

    // The entry point: call `main`, then exit with its result (or 0 when it returns nothing).
    fun entry(mut self, asm: &mut x64::Asm) {
        // A freestanding object starts at `_start`: the stack holds argc, then argv. It sets the C registers and calls the
        // entry below, then exits with its result.
        entry_body := asm.new_label()
        when self.freestanding {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
            asm.lea(x64::Reg::RSI, x64::Reg::RSP, 8)
            asm.alu_ri(4, x64::Reg::RSP, (0 as i64) - 16)
            asm.call_label(entry_body)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.mov_ri(x64::Reg::RAX, 231)
            asm.syscall()
        }
        asm.bind(entry_body)
        // The C runtime calls main with argc in rdi and argv in rsi; they are kept for `arg_count` and `arg`.
        asm.lea_symbol(x64::Reg::RAX, self.arguments_symbol)
        asm.store(8, x64::Reg::RDI, x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RSI, x64::Reg::RAX, 8)
        // A stack for the segmentation handler, then the handler for SIGSEGV. The `stack_t` is at the frame's bottom and
        // the `sigaction` (152 bytes, with the handler first and the flags after the 128-byte mask) above it.
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 192)
        asm.mov_ri(x64::Reg::RDI, 65536)
        when self.freestanding {
            asm.call_label(self.rt.malloc)
        } else {
            asm.call_symbol(self.foreign_symbol(String("malloc")))
        }
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 8)
        asm.mov_ri(x64::Reg::RAX, 65536)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 16)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RSP)
        asm.mov_ri(x64::Reg::RSI, 0)
        when self.freestanding {
            asm.mov_ri(x64::Reg::RAX, 131)
            asm.syscall()
        } else {
            asm.call_symbol(self.foreign_symbol(String("sigaltstack")))
        }
        asm.mov_ri(x64::Reg::RAX, 0)
        mut zeroed: u64 = 0
        while zeroed < 19 {
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, (32 + zeroed * 8) as i64)
            zeroed += 1
        }
        asm.lea_label(x64::Reg::RAX, self.handler_label)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
        when self.freestanding {
            // The kernel's layout: the handler, the flags (`SA_SIGINFO`, `SA_ONSTACK`, `SA_RESTORER`), the restorer, the mask.
            asm.mov_ri(x64::Reg::RAX, 201326596)
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 40)
            asm.lea_label(x64::Reg::RAX, self.rt.sigreturn)
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 48)
            asm.mov_ri(x64::Reg::RAX, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 56)
            asm.mov_ri(x64::Reg::RDI, 11)
            asm.lea(x64::Reg::RSI, x64::Reg::RSP, 32)
            asm.mov_ri(x64::Reg::RDX, 0)
            asm.mov_ri(x64::Reg::R10, 8)
            asm.mov_ri(x64::Reg::RAX, 13)
            asm.syscall()
        } else {
            asm.mov_ri(x64::Reg::RAX, 134217732)
            asm.store(4, x64::Reg::RAX, x64::Reg::RSP, 168)
            asm.mov_ri(x64::Reg::RDI, 11)
            asm.lea(x64::Reg::RSI, x64::Reg::RSP, 32)
            asm.mov_ri(x64::Reg::RDX, 0)
            asm.call_symbol(self.foreign_symbol(String("sigaction")))
        }
        asm.call_label(self.labels[self.program.main_index])
        main_function := self.program.functions[self.program.main_index]
        when main_function.return_type.is_none() {
            asm.mov_ri(x64::Reg::RAX, 0)
        }
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
    }

    // The runtime routines: `write` (buffer in rsi, length in rdx, to standard output), and the printers of unsigned,
    // signed and boolean values in rax, each followed by nothing (the newline is written by the statement).
    fun runtime(mut self, asm: &mut x64::Asm) {
        self.map_routines(asm)
        asm.bind(self.write_label)
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
        asm.ret()

        // Digits are written backwards into a 32-byte buffer on the stack, from its last byte.
        asm.bind(self.print_u64_label)
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 32)
        asm.lea(x64::Reg::R8, x64::Reg::RSP, 32)
        asm.mov_ri(x64::Reg::RCX, 10)
        digits := asm.new_label()
        asm.bind(digits)
        asm.alu_rr(49, x64::Reg::RDX, x64::Reg::RDX)
        asm.unary(6, x64::Reg::RCX)
        asm.alu_ri(0, x64::Reg::RDX, 48)
        asm.alu_ri(5, x64::Reg::R8, 1)
        asm.store(1, x64::Reg::RDX, x64::Reg::R8, 0)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::NOT_EQUAL, digits)
        asm.lea(x64::Reg::RDX, x64::Reg::RSP, 32)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::R8)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::R8)
        asm.call_label(self.write_label)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()

        // A negative value is written with its sign first; the magnitude is printed unsigned.
        asm.bind(self.print_i64_label)
        positive := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::GREATER_EQUAL, positive)
        asm.push(x64::Reg::RAX)
        asm.alu_ri(5, x64::Reg::RSP, 8)
        asm.mov_ri(x64::Reg::RCX, 45)
        asm.store(1, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
        asm.mov_ri(x64::Reg::RDX, 1)
        asm.call_label(self.write_label)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        asm.pop(x64::Reg::RAX)
        asm.unary(3, x64::Reg::RAX)
        asm.bind(positive)
        asm.jmp(self.print_u64_label)

        // The SIGSEGV handler: `rsi` is the siginfo (the fault address at 16) and `rdx` the context (the stack pointer
        // of the fault at 160). A fault within 64 KiB of that stack pointer is a stack overflow; any other is an invalid
        // access. The message goes to standard error, and the process exits with status 1.
        // An index past the end of a vector: the message to standard error, and exit with status 1.
        asm.bind(self.index_error_label)
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[self.index_literal])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[self.index_literal])
        asm.mov_ri(x64::Reg::RDI, 2)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RAX, 231)
        asm.syscall()

        // A division by zero: the message to standard error, and exit with status 1.
        asm.bind(self.division_error_label)
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[self.division_literal])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[self.division_literal])
        asm.mov_ri(x64::Reg::RDI, 2)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RAX, 231)
        asm.syscall()

        asm.bind(self.handler_label)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSI, 16)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 160)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RAX)
        asm.alu_rr(41, x64::Reg::R8, x64::Reg::RCX)
        asm.alu_ri(0, x64::Reg::R8, 65536)
        overflow := asm.new_label()
        report := asm.new_label()
        asm.alu_ri(7, x64::Reg::R8, 131072)
        asm.jcc(x64::Cc::BELOW, overflow)
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[self.invalid_literal])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[self.invalid_literal])
        asm.jmp(report)
        asm.bind(overflow)
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[self.overflow_literal])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[self.overflow_literal])
        asm.bind(report)
        asm.mov_ri(x64::Reg::RDI, 2)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RAX, 231)
        asm.syscall()

        // `true` or `false`, from a value that is 0 or 1.
        asm.bind(self.print_bool_label)
        is_false := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, is_false)
        self.write_literal(asm, true_literal())
        asm.ret()
        asm.bind(is_false)
        self.write_literal(asm, false_literal())
        asm.ret()
    }

    // Writes a string literal to standard output.
    fun write_literal(mut self, asm: &mut x64::Asm, index: u64) {
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[index])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[index])
        asm.call_label(self.write_label)
    }

    // A function: its frame, its parameters from the argument registers, its body, and a return that ends it.
    fun function(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        definition := self.program.functions[index]
        // A foreign function has no body here: its calls go to the C library.
        when definition.external_symbol.is_some() {
            return true
        }
        mut owned: u64 = 0
        while owned < definition.owned_slot_types.len() {
            when definition.owned_slot_types[owned].is_some() && !self.is_leakable(definition.owned_slot_types[owned].unwrap()) && !self.needs_drop(definition.owned_slot_types[owned].unwrap()) {
                return self.fail("an owned value")
            }
            owned += 1
        }
        asm.bind(self.labels[index])
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        // The frame holds the locals and the scratch cells; its size is patched in once the body is generated.
        asm.alu_ri(5, x64::Reg::RSP, 0)
        frame_at := asm.code.len() - 4
        // Scratch owners may be live on an early return or absent on another branch.
        // Zero the whole frame before loading parameters, including scratch cells allocated below.
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RSP)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.alu_ri(0, x64::Reg::RCX, 0)
        zero_at := asm.code.len() - 4
        asm.rep_stosb()
        self.scratch_base = definition.local_types.len()
        self.scratch_used = 0
        self.shadow_slots = Vec()
        self.shadow_images = Vec()
        self.shadow_ids = Vec()
        self.owner_slots = Vec()
        self.owner_types = Vec()
        mut owner: u64 = 0
        while owner < definition.owned_slot_types.len() {
            when definition.owned_slot_types[owner].is_some() && self.needs_drop(definition.owned_slot_types[owner].unwrap()) {
                self.owner_slots.push(owner)
                self.owner_types.push(definition.owned_slot_types[owner].unwrap())
                asm.mov_ri(x64::Reg::RAX, 0)
                asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(owner))
            }
            owner += 1
        }
        // The arguments are on the stack above the return address and the saved frame pointer, the last one lowest.
        mut total: u64 = 0
        mut pair: u64 = 0
        while pair < definition.parameters.len() / 2 {
            cells := self.cells_of(definition.parameters[pair * 2 + 1])
            when cells == 0 {
                return self.fail("a parameter of this type")
            }
            total += cells
            pair += 1
        }
        mut returned: u64 = 0
        mut returned_cells: u64 = 0
        when definition.return_type.is_some() {
            returned = definition.return_type.unwrap()
            returned_cells = self.aggregate_cells(returned)
        }
        self.argument_cells = total
        self.result_type = returned
        self.result_cells = returned_cells
        mut argument: u64 = 0
        pair = 0
        while pair < definition.parameters.len() / 2 {
            base := definition.parameters[pair * 2]
            cells := self.cells_of(definition.parameters[pair * 2 + 1])
            mut cell: u64 = 0
            while cell < cells {
                asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (16 + 8 * (total - 1 - argument)) as i64)
                asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + cell))
                argument += 1
                cell += 1
            }
            pair += 1
        }
        when !self.body(asm, definition.statements.clone()) {
            return false
        }
        bytes := ((self.scratch_base + self.scratch_used) * 8 + 15) / 16 * 16
        asm.patch32(frame_at, bytes)
        asm.patch32(zero_at, bytes)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
        return true
    }

    fun body(mut self, asm: &mut x64::Asm, statements: Vec<u64>) -> bool {
        for statement in statements {
            when !self.stmt(asm, statement) {
                return false
            }
        }
        return true
    }

    fun stmt(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        return choose self.program.stmts[index] {
            ir::IrStmt::BlockStmt(body) => self.body(asm, body),
            ir::IrStmt::DropStmt(slots, types) => self.drops(asm, slots, types),
            ir::IrStmt::LetStmt(slot, ty, value, span) => self.store_into(asm, value, slot, ty),
            ir::IrStmt::AssignStmt(slot, ty, value, span) => self.assign_value(asm, value, slot, ty),
            ir::IrStmt::PrintStmt(value, ty) => self.echo_statement(asm, value, ty),
            ir::IrStmt::PrintTemplateStmt(parts) => self.template(asm, parts),
            ir::IrStmt::CallStmt(target, arguments) => self.call_statement(asm, target, arguments),
            ir::IrStmt::IfStmt(condition, then_body, else_body) => self.if_statement(asm, condition, then_body, else_body),
            ir::IrStmt::WhileStmt(setup, condition, body) => self.while_statement(asm, setup, condition, body),
            ir::IrStmt::ForStmt(slot, end_slot, ty, start, end, inclusive, body) => self.for_statement(asm, slot, end_slot, ty, start, end, inclusive, body),
            ir::IrStmt::BreakStmt => self.jump_to(asm, true),
            ir::IrStmt::ContinueStmt => self.jump_to(asm, false),
            ir::IrStmt::ReturnStmt(value) => self.return_statement(asm, value),
            ir::IrStmt::FieldAssignStmt(slot, ty, value) => self.field_assign(asm, value, slot, ty),
            ir::IrStmt::ArrayAssignStmt(slot, element, length, index, value, span) => self.array_assign(asm, slot, element, length, index, value),
            ir::IrStmt::DereferenceAssignStmt(pointer, ty, value) => self.store_through(asm, value, pointer, 0, ty),
            ir::IrStmt::ReferenceFieldAssignStmt(pointer, id, field, ty, value) => self.store_field_through(asm, value, pointer, id, field, ty),
            _ => self.fail("a statement of this kind"),
        }
    }

    // The owners that a scope ends with: a destructor value is dropped, and an owned value that is not a destructor must
    // leak, since nothing else frees it.
    fun drops(mut self, asm: &mut x64::Asm, slots: Vec<u64>, types: Vec<u64>) -> bool {
        mut position: u64 = 0
        while position < types.len() {
            when !self.needs_drop(types[position]) && !self.is_leakable(types[position]) {
                return self.fail("a drop")
            }
            when self.needs_drop(types[position]) {
                self.drop_slot(asm, slots[position], types[position])
            }
            position += 1
        }
        return true
    }

    // Drops the destructor owners of the function, the last slot first, as a return does.
    fun drop_owners(mut self, asm: &mut x64::Asm) {
        mut at: u64 = self.owner_slots.len()
        while at > 0 {
            at -= 1
            self.drop_slot(asm, self.owner_slots[at], self.owner_types[at])
        }
    }

    // Drops the value of type `ty` at `slot`, and clears its owners.
    fun drop_value(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) {
        self.drop_slot(asm, slot, ty)
    }

    // Whether a value of type `ty` holds a destructor, which its owner drops.
    fun has_destructor(self, ty: u64) -> bool {
        when self.glue_function(ty).is_some() {
            return true
        }
        structure := choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => Option::Some(id),
            _ => Option::None,
        }
        when structure.is_none() {
            return false
        }
        id := structure.unwrap()
        when self.program.structs[id].drop_function.is_some() {
            return true
        }
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            when self.has_destructor(self.program.structs[id].fields[position].ty) {
                return true
            }
            position += 1
        }
        return false
    }

    // `x = value` for a value that holds a destructor: the new value is built, the old value is dropped, and then the
    // cells of the local are replaced.
    fun assign_value(mut self, asm: &mut x64::Asm, value: u64, slot: u64, ty: u64) -> bool {
        when !self.has_owners(ty) {
            return self.store_into(asm, value, slot, ty)
        }
        when !self.push_value(asm, value, ty) {
            return false
        }
        self.drop_value(asm, slot, ty)
        count := self.cells_of(ty)
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot + cell))
            cell += 1
        }
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    // A field assignment of a destructor is not in the subset: the old field would need its drop as well.
    fun field_assign(mut self, asm: &mut x64::Asm, value: u64, slot: u64, ty: u64) -> bool {
        return self.assign_value(asm, value, slot, ty)
    }

    // The destructor of a structure type, when it has one.
    fun destructor_of(self, ty: u64) -> Option<u64> {
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.program.structs[id].drop_function,
            _ => Option::None,
        }
    }

    // Whether a value of type `ty` owns storage that is freed when its owner ends: a String, a vector, a map, a set, an enum
    // (always a box), or a structure with a destructor, whose destructor releases the rest of it.
    fun is_owner_type(self, ty: u64) -> bool {
        when self.is_string(ty) {
            return true
        }
        return choose self.program.types[ty] {
            ir::IrTy::VecOf(element) => true,
            ir::IrTy::MapOf(key, value) => true,
            ir::IrTy::SetOf(key, value) => true,
            ir::IrTy::EnumTy(id) => true,
            ir::IrTy::StructTy(id) => self.program.structs[id].drop_function.is_some(),
            _ => false,
        }
    }

    // The owners in a value of type `ty`, as pairs of (cell offset, owner type), in ascending cell order. A structure without a
    // destructor owns what its fields own; a structure with one is a single owner at cell 0.
    fun owner_pairs(self, ty: u64) -> Vec<u64> {
        mut pairs: Vec<u64> = Vec()
        when self.is_owner_type(ty) {
            pairs.push(0)
            pairs.push(ty)
            return pairs
        }
        structure := choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => Option::Some(id),
            _ => Option::None,
        }
        when structure.is_none() {
            return pairs
        }
        id := structure.unwrap()
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            field_ty := self.program.structs[id].fields[position].ty
            offset := self.program.structs[id].fields[position].slot_offset
            inner := self.owner_pairs(field_ty)
            mut at: u64 = 0
            while at < inner.len() {
                pairs.push(offset + inner[at])
                pairs.push(inner[at + 1])
                at += 2
            }
            position += 1
        }
        return pairs
    }

    // The type id of the structure `id`, found in the type table.
    fun struct_type(self, id: u64) -> u64 {
        mut at: u64 = 0
        while at < self.program.types.len() {
            is_it := choose self.program.types[at] {
                ir::IrTy::StructTy(other) => other == id,
                _ => false,
            }
            when is_it {
                return at
            }
            at += 1
        }
        return 0
    }

    // A move leaves the owners of the moved value null, so that the drop at the end of its owner's scope does nothing for them.
    fun null_owners(self, asm: &mut x64::Asm, slot: u64, ty: u64) {
        pairs := self.owner_pairs(ty)
        mut at: u64 = 0
        while at < pairs.len() {
            asm.mov_ri(x64::Reg::R11, 0)
            asm.store(8, x64::Reg::R11, x64::Reg::RBP, slot_disp(slot + pairs[at]))
            at += 2
        }
    }

    // The label of the routine that drops the value of type `ty` at the address in rdi: its owners are dropped and their cells
    // cleared, the last first.
    fun value_drop_routine(mut self, asm: &mut x64::Asm, ty: u64, ascending: bool) -> u64 {
        mut at: u64 = 0
        while at < self.drop_value_ids.len() {
            when self.drop_value_ids[at] == ty && self.drop_value_ascending[at] == ascending {
                return self.drop_value_labels[at]
            }
            at += 1
        }
        label := asm.new_label()
        self.drop_value_ids.push(ty)
        self.drop_value_labels.push(label)
        self.drop_value_ascending.push(ascending)
        return label
    }

    // The displacement from the address of cell 0 to cell `cell` of a value: cells rise in memory when `ascending`, and fall
    // otherwise (as the cells of a local do).
    fun cell_disp(self, ascending: bool, cell: u64) -> i64 {
        mut disp: i64 = (8 * cell) as i64
        when !ascending {
            disp = 0 - disp
        }
        return disp
    }

    // The label of the routine that frees a handle of type `ty` (a String, vector, map, set or enum box) in rdi, with what it
    // owns. The owner of the handle clears its cell.
    fun handle_drop_routine(mut self, asm: &mut x64::Asm, ty: u64) -> u64 {
        mut at: u64 = 0
        while at < self.drop_handle_ids.len() {
            when self.drop_handle_ids[at] == ty {
                return self.drop_handle_labels[at]
            }
            at += 1
        }
        label := asm.new_label()
        self.drop_handle_ids.push(ty)
        self.drop_handle_labels.push(label)
        return label
    }

    // Drops the value of type `ty` in the cells from `slot` on, when it owns something.
    fun drop_slot(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) {
        when self.owner_pairs(ty).len() == 0 {
            return
        }
        label := self.value_drop_routine(asm, ty, false)
        asm.lea(x64::Reg::RDI, x64::Reg::RBP, slot_disp(slot))
        asm.call_label(label)
    }

    // The body of a value drop routine: the owners of the value at the address in rdi are dropped, the last first.
    fun emit_value_drop(mut self, asm: &mut x64::Asm, ty: u64, ascending: bool) -> bool {
        pairs := self.owner_pairs(ty)
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 16)
        asm.store(8, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        mut at: u64 = pairs.len()
        while at > 0 {
            at -= 2
            offset := pairs[at]
            owner := pairs[at + 1]
            skip := asm.new_label()
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 8)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, self.cell_disp(ascending, offset))
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::EQUAL, skip)
            when self.destructor_of(owner).is_some() {
                // The destructor takes every cell of the structure, the first pushed first, and releases the rest itself.
                fid := self.destructor_of(owner).unwrap()
                self.needed.set(fid, true)
                count := self.cells_of(owner)
                mut cell: u64 = 0
                while cell < count {
                    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 8)
                    asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, self.cell_disp(ascending, offset + cell))
                    asm.push(x64::Reg::RCX)
                    cell += 1
                }
                asm.call_label(self.labels[fid])
                asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
            }
            when self.destructor_of(owner).is_none() {
                asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
                label := self.handle_drop_routine(asm, owner)
                asm.call_label(label)
            }
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 8)
            asm.mov_ri(x64::Reg::RCX, 0)
            asm.store(8, x64::Reg::RCX, x64::Reg::RDX, self.cell_disp(ascending, offset))
            asm.bind(skip)
        }
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
        return true
    }

    // The body of a handle routine: the handle in rdi is freed with what it owns, by its kind.
    fun emit_handle_drop(mut self, asm: &mut x64::Asm, ty: u64) -> bool {
        when self.is_string(ty) {
            asm.push(x64::Reg::RBP)
            asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
            asm.alu_ri(5, x64::Reg::RSP, 16)
            asm.store(8, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 0)
            self.aligned_call(asm, String("free"))
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
            self.aligned_call(asm, String("free"))
            asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
            asm.pop(x64::Reg::RBP)
            asm.ret()
            return true
        }
        return choose self.program.types[ty] {
            ir::IrTy::VecOf(element) => self.emit_vec_free(asm, element),
            ir::IrTy::MapOf(key, value) => self.emit_map_free(asm, key, value, true),
            ir::IrTy::SetOf(key, value) => self.emit_map_free(asm, key, value, true),
            ir::IrTy::EnumTy(id) => self.emit_enum_free(asm, id),
            _ => self.fail("a handle of this kind"),
        }
    }

    // A vector's handle: {data, len, capacity}. Its elements are dropped last first, then the data and the header are freed.
    fun emit_vec_free(mut self, asm: &mut x64::Asm, element: u64) -> bool {
        cells := self.cells_of(element)
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 32)
        asm.store(8, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        when self.owner_pairs(element).len() > 0 {
            top := asm.new_label()
            done := asm.new_label()
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RDI, 8)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            asm.bind(top)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 16)
            asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
            asm.jcc(x64::Cc::EQUAL, done)
            asm.alu_ri(5, x64::Reg::RCX, 1)
            asm.store(8, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 16)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 8)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RDX, 0)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RCX)
            self.scale_bytes(asm, x64::Reg::RDI, 8 * cells)
            asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RDX)
            asm.alu_ri(0, x64::Reg::RDI, (8 * (cells - 1)) as i64)
            label := self.value_drop_routine(asm, element, false)
            asm.call_label(label)
            asm.jmp(top)
            asm.bind(done)
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 0)
        self.aligned_call(asm, String("free"))
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        self.aligned_call(asm, String("free"))
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
        return true
    }

    // A map's handle: {buckets, bucket count, length, ...}, and each bucket a chain of nodes {next, hash, key, value}. Every node's
    // owned key and value are dropped, then the node is freed; then the buckets and the header.
    fun emit_map_free(mut self, asm: &mut x64::Asm, key: u64, value: u64, header: bool) -> bool {
        keys := self.owner_pairs(key).len() > 0
        values := self.owner_pairs(value).len() > 0
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 48)
        asm.store(8, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
        bucket_top := asm.new_label()
        buckets_done := asm.new_label()
        next_bucket := asm.new_label()
        node_top := asm.new_label()
        asm.bind(bucket_top)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, buckets_done)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 0)
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RCX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
        asm.bind(node_top)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, next_bucket)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 32)
        when keys {
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.alu_ri(0, x64::Reg::RDI, 16)
            label := self.value_drop_routine(asm, key, false)
            asm.call_label(label)
        }
        when values {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 24)
            asm.alu_ri(0, x64::Reg::RDI, 24)
            label := self.value_drop_routine(asm, value, false)
            asm.call_label(label)
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 24)
        self.aligned_call(asm, String("free"))
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
        asm.jmp(node_top)
        asm.bind(next_bucket)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
        asm.jmp(bucket_top)
        asm.bind(buckets_done)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 0)
        self.aligned_call(asm, String("free"))
        when header {
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        self.aligned_call(asm, String("free"))
        }
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
        return true
    }

    // An enum's box: the tag in cell 0, then the payload of the variant. The owned fields of the variant of the tag are dropped,
    // then the box is freed.
    fun emit_enum_free(mut self, asm: &mut x64::Asm, id: u64) -> bool {
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 16)
        asm.store(8, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        mut variant: u64 = 0
        while variant < self.program.enums[id].variants.len() {
            fields := self.program.enums[id].variants[variant].fields.clone()
            mut field: u64 = 0
            while field < fields.len() {
                field_ty := fields[field]
                when self.owner_pairs(field_ty).len() > 0 {
                    skip := asm.new_label()
                    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 8)
                    asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
                    asm.alu_ri(7, x64::Reg::RCX, variant as i64)
                    asm.jcc(x64::Cc::NOT_EQUAL, skip)
                    payload: u64 = self.enum_field_offset(id, variant, field)
                    disp: u64 = 8 * (1 + payload)
                    asm.alu_ri(0, x64::Reg::RAX, disp as i64)
                    asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
                    label := self.value_drop_routine(asm, field_ty, true)
                    asm.call_label(label)
                    asm.bind(skip)
                }
                field += 1
            }
            variant += 1
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        self.aligned_call(asm, String("free"))
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
        return true
    }

    // Emits the drop routines that were asked for and are not written yet, until none is missing. A routine may ask for
    // more, and may make a destructor needed, so the function scan calls this again after each function it generates.
    fun emit_drop_routines(mut self, asm: &mut x64::Asm) -> bool {
        mut changed: bool = true
        while changed {
            changed = false
            while self.drop_values_done < self.drop_value_labels.len() {
                asm.bind(self.drop_value_labels[self.drop_values_done])
                when !self.emit_value_drop(asm, self.drop_value_ids[self.drop_values_done], self.drop_value_ascending[self.drop_values_done]) {
                    return false
                }
                self.drop_values_done += 1
                changed = true
            }
            while self.drop_handles_done < self.drop_handle_labels.len() {
                asm.bind(self.drop_handle_labels[self.drop_handles_done])
                when !self.emit_handle_drop(asm, self.drop_handle_ids[self.drop_handles_done]) {
                    return false
                }
                self.drop_handles_done += 1
                changed = true
            }
        }
        return true
    }

    // Whether a type is a structure with a destructor that is one cell, a handle: such a value can be a map's value.
    fun is_handle_struct(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.program.structs[id].slot_count == 1 && self.program.structs[id].drop_function.is_some(),
            _ => false,
        }
    }

    // The destructor function that dropping a vector (of structures) or a map (of handle structures) must run on each
    // element or value, when there is one.
    fun glue_function(self, ty: u64) -> Option<u64> {
        return choose self.program.types[ty] {
            ir::IrTy::VecOf(element) => self.destructor_of(element),
            ir::IrTy::MapOf(key, value) => self.handle_destructor(value),
            _ => Option::None,
        }
    }

    fun handle_destructor(self, ty: u64) -> Option<u64> {
        when self.is_handle_struct(ty) {
            return self.destructor_of(ty)
        }
        return Option::None
    }

    // Whether the owner of a value of this type has to drop it: a destructor structure, or a vector or map of them.
    fun needs_drop(self, ty: u64) -> bool {
        return self.has_owners(ty)
    }

    // Whether a value of type `ty` owns storage that its owner frees (see `owner_pairs`).
    fun has_owners(self, ty: u64) -> bool {
        return self.owner_pairs(ty).len() > 0
    }

    // The drop routine of a vector (kind 0) or map (kind 1) whose elements have destructors, asked for once per element type.
    fun glue_routine(mut self, asm: &mut x64::Asm, kind: u64, element: u64) -> u64 {
        mut at: u64 = 0
        while at < self.glue_labels.len() {
            when self.glue_kinds[at] == kind && self.glue_elements[at] == element {
                return self.glue_labels[at]
            }
            at += 1
        }
        label := asm.new_label()
        self.glue_kinds.push(kind)
        self.glue_elements.push(element)
        self.glue_labels.push(label)
        self.needed.set(self.destructor_of(element).unwrap(), true)
        return label
    }

    fun glue_is_map(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::MapOf(key, value) => true,
            _ => false,
        }
    }

    // The routine that drops each element of a vector (last first) or each value of a map: the header is in rdi.
    fun emit_glue(mut self, asm: &mut x64::Asm, kind: u64, element: u64) {
        fid := self.destructor_of(element).unwrap()
        cells := self.cells_of(element)
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 32)
        asm.store(8, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        done := asm.new_label()
        top := asm.new_label()
        when kind == 0 {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RDI, 8)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            asm.bind(top)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::EQUAL, done)
            asm.alu_ri(5, x64::Reg::RAX, 1)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            self.scale_bytes(asm, x64::Reg::RAX, cells * 8)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, (0 as i64) - 8)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RSI, 0)
            asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RAX)
            asm.alu_ri(5, x64::Reg::RSP, (cells * 8) as i64)
            self.copy_block(asm, x64::Reg::RSI, x64::Reg::RSP, cells)
            asm.call_label(self.labels[fid])
            asm.alu_ri(0, x64::Reg::RSP, (cells * 8) as i64)
            asm.jmp(top)
        } else {
            // Buckets in order; each bucket's chain of nodes, whose value is at offset 24.
            asm.mov_ri(x64::Reg::RAX, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            next_bucket := asm.new_label()
            inner := asm.new_label()
            asm.bind(top)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 8)
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
            asm.jcc(x64::Cc::ABOVE_EQUAL, done)
            self.scale_bytes(asm, x64::Reg::RAX, 8)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 0)
            asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RCX, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
            asm.bind(inner)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::EQUAL, next_bucket)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 24)
            asm.push(x64::Reg::RCX)
            asm.call_label(self.labels[fid])
            asm.alu_ri(0, x64::Reg::RSP, 8)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
            asm.jmp(inner)
            asm.bind(next_bucket)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            asm.alu_ri(0, x64::Reg::RAX, 1)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            asm.jmp(top)
        }
        asm.bind(done)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
    }

    // Drops a value of type `ty` that a call left as its result, in rax or on the stack, and removes it from the stack.
    fun drop_pushed(mut self, asm: &mut x64::Asm, ty: u64) {
        when self.aggregate_cells(ty) == 0 {
            skip := asm.new_label()
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::EQUAL, skip)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            label := self.handle_drop_routine(asm, ty)
            asm.call_label(label)
            asm.bind(skip)
            return
        }
        count := self.aggregate_cells(ty)
        slot := self.scratch(count)
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot + cell))
            cell += 1
        }
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        self.drop_slot(asm, slot, ty)
    }

    // The cells, from the first of a structure, that hold the handles of destructors it owns: a destructor value owns its
    // first cell, and a structure without a destructor owns the handles of its fields.
    fun struct_destructor_cells(self, id: u64) -> Vec<u64> {
        mut cells: Vec<u64> = Vec()
        when self.program.structs[id].drop_function.is_some() {
            cells.push(0)
            return cells
        }
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            field_ty := self.program.structs[id].fields[position].ty
            offset := self.program.structs[id].fields[position].slot_offset
            inner := choose self.program.types[field_ty] {
                ir::IrTy::StructTy(field_id) => self.struct_destructor_cells(field_id),
                _ => Vec(),
            }
            mut at: u64 = 0
            while at < inner.len() {
                cells.push(offset + inner[at])
                at += 1
            }
            position += 1
        }
        return cells
    }

    // A move leaves the handles of the destructors it moved out null, so that the scope's drop does nothing for them.
    fun null_moved(mut self, asm: &mut x64::Asm, slot: u64, id: u64) {
        self.null_owners(asm, slot, self.struct_type(id))
    }

    fun string_type(self) -> u64 {
        mut ty: u64 = 0
        while ty < self.program.types.len() {
            when self.is_string(ty) { return ty }
            ty += 1
        }
        return 0
    }

    fun is_string(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => word == "OwnedString",
            _ => false,
        }
    }

    // A structure of one cell used as a value (a map's value): the value of its only field.
    fun handle_value(mut self, asm: &mut x64::Asm, id: u64, values: Vec<u64>) -> bool {
        when self.program.structs[id].slot_count != 1 || values.len() != 1 {
            return self.fail("a structure value")
        }
        return self.expr(asm, values[0])
    }

    // The owned values that are not freed yet: a String or a Vec, whose storage the process frees at its end. An array of
    // plain scalars owns nothing, so dropping it does nothing.
    fun is_leakable(self, ty: u64) -> bool {
        return self.is_string(ty) || choose self.program.types[ty] {
            ir::IrTy::ArrayOf(element, length) => self.is_plain_scalar(element),
            ir::IrTy::SliceOf(element) => true,
            ir::IrTy::VecOf(element) => true,
            ir::IrTy::MapOf(key, value) => true,
            ir::IrTy::SetOf(key, value) => true,
            ir::IrTy::EnumTy(id) => true,
            _ => false,
        }
    }

    fun assign(mut self, asm: &mut x64::Asm, slot: u64, value: u64) -> bool {
        when !self.expr(asm, value) {
            return false
        }
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
        return true
    }

    // `arg_count()`: the number of arguments after the program's name, which is argc less one.
    fun arg_count(mut self, asm: &mut x64::Asm) -> bool {
        asm.lea_symbol(x64::Reg::RAX, self.arguments_symbol)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 0)
        asm.alu_ri(5, x64::Reg::RAX, 1)
        return true
    }

    // `arg(i)`: argument i after the program's name, as a str pushed as its cells. An index past the arguments is the empty
    // text. The argument is a C string, whose length strlen finds.
    fun argument(mut self, asm: &mut x64::Asm, arguments: Vec<u64>) -> bool {
        when arguments.len() != 1 {
            return self.fail("an argument with another number of arguments")
        }
        when !self.expr(asm, arguments[0]) {
            return false
        }
        asm.lea_symbol(x64::Reg::RCX, self.arguments_symbol)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RCX, 8)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::R8, 1)
        empty := asm.new_label()
        have := asm.new_label()
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, empty)
        self.scale_bytes(asm, x64::Reg::R8, 8)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::R8, 0)
        asm.jmp(have)
        asm.bind(empty)
        asm.lea_symbol(x64::Reg::RDI, self.c_literal(String("")))
        asm.bind(have)
        asm.push(x64::Reg::RDI)
        self.aligned_call(asm, String("strlen"))
        asm.push(x64::Reg::RAX)
        return true
    }

    // `echo value`: the value, then a newline.
    fun echo_statement(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        when !self.printed(asm, value, ty) {
            return false
        }
        self.write_literal(asm, newline_literal())
        return true
    }

    fun template(mut self, asm: &mut x64::Asm, parts: Vec<u64>) -> bool {
        for part in parts {
            done := choose self.program.parts[part] {
                ir::PrintPart::TextPart(text) => self.text_part(asm, text),
                ir::PrintPart::ValuePart(value, ty) => self.printed(asm, value, ty),
            }
            when !done {
                return false
            }
        }
        // A template is a line, as `print` writes it.
        self.write_literal(asm, newline_literal())
        return true
    }

    fun text_part(mut self, asm: &mut x64::Asm, text: String) -> bool {
        index := self.literal(text)
        self.write_literal(asm, index)
        return true
    }

    // A value written by `echo` or a template: a string literal as its text, a scalar through its printer.
    fun printed(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        mut arguments: Vec<u64> = Vec()
        arguments.push(value)
        temps := self.borrowed_temporaries(arguments.clone(), 0)
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) { return false }
        ok := self.printed_inner(asm, value, ty)
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    fun printed_inner(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        literal := self.string_literal(value)
        when literal.is_some() {
            return self.text_part(asm, literal.unwrap())
        }
        when self.is_str(ty) {
            when !self.load_string_parts(asm, value) {
                return false
            }
            asm.call_label(self.write_label)
            return true
        }
        when self.is_string(ty) {
            when !self.expr(asm, value) {
                return false
            }
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
            asm.call_label(self.write_label)
            return true
        }
        word := self.word(ty)
        when is_integer_word(word.clone()) {
            when !self.expr(asm, value) {
                return false
            }
            when is_signed_word(word.clone()) {
                asm.call_label(self.print_i64_label)
            } else {
                asm.call_label(self.print_u64_label)
            }
            return true
        }
        when word == "Bool" {
            when !self.expr(asm, value) {
                return false
            }
            asm.call_label(self.print_bool_label)
            return true
        }
        when word == "Char" {
            when !self.expr(asm, value) {
                return false
            }
            self.write_char(asm)
            return true
        }
        when self.is_float(ty) {
            return self.print_float(asm, value, ty)
        }
        return self.fail("an echo of this type")
    }

    // A float written to standard output: its text is formatted into a buffer on the stack and written.
    fun print_float(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        when !self.format_float(asm, value, self.word(ty) == "F32") {
            return false
        }
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
        asm.call_label(self.write_label)
        asm.alu_ri(0, x64::Reg::RSP, 416)
        return true
    }

    // Formats the float that `value` computes as text. The text is at rsp, in 416 bytes that the caller removes, and its
    // length is in rax. The routine itself is written once, after the functions, when a program needs it.
    fun format_float(mut self, asm: &mut x64::Asm, value: u64, single: bool) -> bool {
        when !self.expr(asm, value) {
            return false
        }
        when self.freestanding {
            return self.fail("a float written as text in a freestanding program")
        }
        self.float_format_used = true
        asm.alu_ri(5, x64::Reg::RSP, 416)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RSP)
        asm.mov_ri(x64::Reg::RCX, 0)
        when single {
            asm.mov_ri(x64::Reg::RCX, 1)
        }
        asm.call_label(self.float_format_label)
        return true
    }

    // The routines of the freestanding runtime, with the text `strerror` gives for the common errors.
    fun emit_freestanding(mut self, asm: &mut x64::Asm) {
        mut numbers: Vec<u64> = Vec()
        mut texts: Vec<u64> = Vec()
        numbers.push(1)
        texts.push(self.c_literal(String("Operation not permitted")))
        numbers.push(2)
        texts.push(self.c_literal(String("No such file or directory")))
        numbers.push(5)
        texts.push(self.c_literal(String("Input/output error")))
        numbers.push(12)
        texts.push(self.c_literal(String("Cannot allocate memory")))
        numbers.push(13)
        texts.push(self.c_literal(String("Permission denied")))
        numbers.push(17)
        texts.push(self.c_literal(String("File exists")))
        numbers.push(20)
        texts.push(self.c_literal(String("Not a directory")))
        numbers.push(21)
        texts.push(self.c_literal(String("Is a directory")))
        numbers.push(22)
        texts.push(self.c_literal(String("Invalid argument")))
        numbers.push(24)
        texts.push(self.c_literal(String("Too many open files")))
        numbers.push(28)
        texts.push(self.c_literal(String("No space left on device")))
        numbers.push(36)
        texts.push(self.c_literal(String("File name too long")))
        unknown := self.c_literal(String("Unknown error"))
        labels := self.rt.clone()
        rt::emit(asm, &labels, numbers, texts, unknown)
    }

    // The symbol of a string literal followed by a zero byte.
    fun c_literal(mut self, text: String) -> u64 {
        mut terminated := text
        terminated.push(char_from_u32(0))
        index := self.literal(terminated)
        return self.literal_symbols[index]
    }

    // `trim`, `trim_start` and `trim_end`: a new String of the part of the text that white space does not surround.
    fun string_trim(mut self, asm: &mut x64::Asm, text: u64, op: String) -> bool {
        when !self.text_parts(asm, text, true) {
            return false
        }
        self.textops_used = self.textops_used | 1
        mut mode: u64 = 3
        when op == "TrimStart" {
            mode = 1
        }
        when op == "TrimEnd" {
            mode = 2
        }
        asm.mov_ri(x64::Reg::RCX, mode)
        asm.call_label(self.trim_label)
        return self.string_from_parts(asm)
    }

    // `to_lower` and `to_upper`: a new String with the letters changed.
    fun string_case(mut self, asm: &mut x64::Asm, text: u64, upper: bool) -> bool {
        when !self.text_parts(asm, text, true) {
            return false
        }
        self.textops_used = self.textops_used | 2
        asm.mov_ri(x64::Reg::RCX, 0)
        when upper {
            asm.mov_ri(x64::Reg::RCX, 1)
        }
        asm.call_label(self.case_label)
        // rsi and rdx are a malloc'd buffer: it becomes the String's text.
        when !self.string_from_parts(asm) {
            return false
        }
        return true
    }

    // `find`: the index in characters of the first match, or -1.
    fun string_find(mut self, asm: &mut x64::Asm, text: u64, pattern: u64, owned: bool) -> bool {
        when !self.find_offset(asm, text, pattern, owned) {
            return false
        }
        // rax is a byte offset or -1; the characters before it are the bytes that are not continuation bytes.
        done := asm.new_label()
        count := asm.new_label()
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::LESS, done)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.mov_ri(x64::Reg::R8, 0)
        asm.bind(count)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::R9)
        asm.jcc(x64::Cc::ABOVE_EQUAL, done)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RDI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::R11, 0)
        asm.alu_ri(4, x64::Reg::RCX, 192)
        asm.alu_ri(7, x64::Reg::RCX, 128)
        skip := asm.new_label()
        asm.jcc(x64::Cc::EQUAL, skip)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.bind(skip)
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.jmp(count)
        asm.bind(done)
        return true
    }

    // Finds the pattern in the text: rax is the byte offset or -1, and rdi is the text's data.
    fun find_offset(mut self, asm: &mut x64::Asm, text: u64, pattern: u64, owned: bool) -> bool {
        when !self.text_parts(asm, text, true) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, pattern, owned) {
            return false
        }
        asm.pop(x64::Reg::RCX)
        asm.pop(x64::Reg::RDI)
        self.textops_used = self.textops_used | 4
        asm.call_label(self.find_label)
        return true
    }

    // The Option<u64> of a `find` result that is -1 or an index.
    fun find_option(mut self, asm: &mut x64::Asm, value: u64, id: u64) -> bool {
        some := self.variant_tag(id, String("Some"))
        none := self.variant_tag(id, String("None"))
        when some.is_none() || none.is_none() {
            return self.fail("a find without its Option")
        }
        when !self.expr(asm, value) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.pop(x64::Reg::RCX)
        found := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
        asm.jcc(x64::Cc::GREATER_EQUAL, found)
        asm.mov_ri(x64::Reg::RDX, none.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.jmp(done)
        asm.bind(found)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.mov_ri(x64::Reg::RDX, some.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `replace(from, to)` with `str` arguments: every match of `from` is replaced, left to right. The result is built in
    // a buffer sized for the most matches there can be, and then copied into a String. The state lives on the stack:
    // the text, `from`, `to`, the buffer, the output position and the position in the text.
    fun string_replace(mut self, asm: &mut x64::Asm, text: u64, from: u64, to: u64) -> bool {
        when self.string_literal(from).is_some() {
            when self.string_literal(from).unwrap().len() == 0 {
                return self.fail("a replace of an empty pattern")
            }
        }
        when !self.text_parts(asm, text, true) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, from, false) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, to, false) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        self.textops_used = self.textops_used | 4
        // rsp: 0 to-length, 8 to, 16 from-length, 24 from, 32 text-length, 40 text.
        nonempty := asm.new_label()
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
        asm.jcc(x64::Cc::NOT_EQUAL, nonempty)
        self.fail_exit(asm, String("Ryn runtime error: replace of an empty pattern\n"))
        asm.bind(nonempty)
        // Capacity: text + (text / from + 1) * to + 1.
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.mov_ri(x64::Reg::RDX, 0)
        asm.unary(6, x64::Reg::RCX)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.imul_rr(x64::Reg::RAX, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 32)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RCX)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("malloc"))
        // Layout: 0 offset of the match, 8 position in the text, 16 output position, 24 buffer, then the six above.
        asm.push(x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.push(x64::Reg::RAX)
        asm.push(x64::Reg::RAX)
        asm.push(x64::Reg::RAX)
        loop_start := asm.new_label()
        tail := asm.new_label()
        asm.bind(loop_start)
        self.sum_at(asm, x64::Reg::RDI, 72, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 64)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 8)
        asm.alu_rr(41, x64::Reg::RCX, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 56)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 48)
        asm.call_label(self.find_label)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::LESS, tail)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 0)
        self.sum_at(asm, x64::Reg::RDI, 24, 16)
        self.sum_at(asm, x64::Reg::RSI, 72, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        self.aligned_call(asm, String("memcpy"))
        self.add_to(asm, 16, 0)
        self.sum_at(asm, x64::Reg::RDI, 24, 16)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 40)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 32)
        self.aligned_call(asm, String("memcpy"))
        self.add_to(asm, 16, 32)
        self.add_to(asm, 8, 0)
        self.add_to(asm, 8, 48)
        asm.jmp(loop_start)
        asm.bind(tail)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 64)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 8)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RAX)
        asm.store(8, x64::Reg::RDX, x64::Reg::RSP, 0)
        self.sum_at(asm, x64::Reg::RDI, 24, 16)
        self.sum_at(asm, x64::Reg::RSI, 72, 8)
        self.aligned_call(asm, String("memcpy"))
        self.add_to(asm, 16, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        when !self.string_from_parts(asm) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 32)
        self.aligned_call(asm, String("free"))
        asm.pop(x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::RSP, 80)
        return true
    }

    // `reg` = the word at rsp + a plus the word at rsp + b. Clobbers r10.
    fun sum_at(self, asm: &mut x64::Asm, reg: u64, a: i64, b: i64) {
        asm.load(8, false, reg, x64::Reg::RSP, a)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RSP, b)
        asm.alu_rr(1, reg, x64::Reg::R10)
    }

    // The word at rsp + to += the word at rsp + from. Clobbers r10 and r11.
    fun add_to(self, asm: &mut x64::Asm, to: i64, from: i64) {
        asm.load(8, false, x64::Reg::R10, x64::Reg::RSP, to)
        asm.load(8, false, x64::Reg::R11, x64::Reg::RSP, from)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::R11)
        asm.store(8, x64::Reg::R10, x64::Reg::RSP, to)
    }

    // `String(float)`: the text of the float, copied into a new String.
    fun string_from_float(mut self, asm: &mut x64::Asm, value: u64, single: bool) -> bool {
        when !self.format_float(asm, value, single) {
            return false
        }
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
        when !self.string_from_parts(asm) {
            return false
        }
        asm.alu_ri(0, x64::Reg::RSP, 416)
        return true
    }

    // Writes the character in rax to standard output as UTF-8: its bytes are built in a buffer on the stack and written
    // with one write call.
    // Encodes the codepoint in rax as UTF-8 at rsp, which must have 4 bytes free: their count is left in rdx.
    fun encode_char(self, asm: &mut x64::Asm) {
        one := asm.new_label()
        two := asm.new_label()
        three := asm.new_label()
        written := asm.new_label()
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.alu_ri(7, x64::Reg::RDX, 128)
        asm.jcc(x64::Cc::BELOW, one)
        asm.alu_ri(7, x64::Reg::RDX, 2048)
        asm.jcc(x64::Cc::BELOW, two)
        asm.alu_ri(7, x64::Reg::RDX, 65536)
        asm.jcc(x64::Cc::BELOW, three)
        self.utf8_byte(asm, 18, 240, 0)
        self.utf8_byte(asm, 12, 128, 1)
        self.utf8_byte(asm, 6, 128, 2)
        self.utf8_byte(asm, 0, 128, 3)
        asm.mov_ri(x64::Reg::RDX, 4)
        asm.jmp(written)
        asm.bind(three)
        self.utf8_byte(asm, 12, 224, 0)
        self.utf8_byte(asm, 6, 128, 1)
        self.utf8_byte(asm, 0, 128, 2)
        asm.mov_ri(x64::Reg::RDX, 3)
        asm.jmp(written)
        asm.bind(two)
        self.utf8_byte(asm, 6, 192, 0)
        self.utf8_byte(asm, 0, 128, 1)
        asm.mov_ri(x64::Reg::RDX, 2)
        asm.jmp(written)
        asm.bind(one)
        asm.store(1, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.mov_ri(x64::Reg::RDX, 1)
        asm.bind(written)
    }

    // `print` of a character: its bytes are written to standard output.
    fun write_char(self, asm: &mut x64::Asm) {
        asm.alu_ri(5, x64::Reg::RSP, 8)
        self.encode_char(asm)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
        asm.alu_ri(0, x64::Reg::RSP, 8)
    }


    // One byte of the UTF-8 encoding of the codepoint in rdx: its bits from `shift` up, the low six, and `tag`, at `at`
    // in the buffer on the stack.
    fun utf8_byte(self, asm: &mut x64::Asm, shift: u64, tag: u64, at: i64) {
        asm.mov_rr(x64::Reg::R8, x64::Reg::RDX)
        asm.mov_ri(x64::Reg::RCX, shift)
        asm.shift_cl(5, x64::Reg::R8)
        asm.alu_ri(4, x64::Reg::R8, 63)
        asm.alu_ri(1, x64::Reg::R8, tag as i64)
        asm.store(1, x64::Reg::R8, x64::Reg::RSP, at)
    }

    // The text of a string literal expression, or nothing.
    fun string_literal(self, index: u64) -> Option<String> {
        return choose self.program.exprs[index] {
            ir::IrExpr::StrLit(text) => Option::Some(text),
            _ => Option::None,
        }
    }

    // Whether an owned value of type `ty` is one cell: a String, a vector, a map, a set or an enum, which a temporary can be.
    fun is_handle_type(self, ty: u64) -> bool {
        when self.is_string(ty) {
            return true
        }
        return choose self.program.types[ty] {
            ir::IrTy::VecOf(element) => true,
            ir::IrTy::MapOf(key, value) => true,
            ir::IrTy::SetOf(key, value) => true,
            ir::IrTy::EnumTy(id) => true,
            _ => false,
        }
    }

    // The type of a call that yields a temporary of an owned handle type, when the argument is one.
    fun temporary_type(self, index: u64) -> Option<u64> {
        found := choose self.program.exprs[index] {
            ir::IrExpr::CallExpr(target, arguments, ty) => Option::Some(ty),
            ir::IrExpr::MoveRef(slot, ty) => Option::Some(ty),
            ir::IrExpr::IfExpr(condition, yes, no, ty) => Option::Some(ty),
            ir::IrExpr::EnumMatch(value, id, arms, ty) => Option::Some(ty),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.field_temporary_type(index, ty),
            ir::IrExpr::StringAsStr(inner) => self.temporary_type(inner),
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => self.reference_temporary_type(ty, borrowed),
            _ => Option::None,
        }
        when found.is_none() {
            return Option::None
        }
        when self.is_handle_type(found.unwrap()) {
            return found
        }
        return Option::None
    }

    fun reference_temporary_type(self, ty: u64, borrowed: bool) -> Option<u64> {
        when borrowed { return Option::None }
        return Option::Some(ty)
    }

    fun field_temporary_type(self, index: u64, ty: u64) -> Option<u64> {
        when self.place_of(index).is_some() || self.is_memory_place(index) { return Option::None }
        return Option::Some(ty)
    }

    // The temporaries among the arguments of a builtin that the builtin only borrows, as positions. A position whose bit is set
    // in `kept` is an argument the builtin stores, so it is not dropped. A temporary after an argument that may have effects is
    // evaluated when the builtin first reads it, preserving argument order.
    fun borrowed_temporaries(self, arguments: Vec<u64>, kept: u64) -> Vec<u64> {
        mut found: Vec<u64> = Vec()
        mut position: u64 = 0
        while position < arguments.len() {
            index := arguments[position]
            keeps := bit_set(kept, position)
            when !keeps && self.temporary_type(index).is_some() {
                found.push(position)
            }
            position += 1
        }
        return found
    }

    // Whether bit `position` of `mask` is set.
    fun bit_set(mask: u64, position: u64) -> bool {
        mut rest: u64 = mask
        mut at: u64 = 0
        while at < position {
            rest = rest / 2
            at += 1
        }
        return rest % 2 == 1
    }

    // Evaluates the borrowed temporaries of a builtin call into frame cells, which the call then reads.
    fun begin_temporaries(mut self, asm: &mut x64::Asm, temps: Vec<u64>, arguments: Vec<u64>) -> bool {
        mut at: u64 = 0
        while at < temps.len() {
            original := arguments[temps[at]]
            index := choose self.program.exprs[original] { ir::IrExpr::StringAsStr(inner) => inner, _ => original }
            cell := self.scratch(1)
            asm.mov_ri(x64::Reg::RAX, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(cell))
            self.temp_exprs.push(index)
            self.temp_cells.push(cell)
            self.temp_ready.push(false)
            self.owner_slots.push(cell)
            self.owner_types.push(self.temporary_type(original).unwrap())
            at += 1
        }
        return true
    }

    // Drops the borrowed temporaries of a builtin call, last first, keeping the call's result: rax, and the cells it left on
    // the stack are untouched by the pushes and pops around the drops.
    fun end_temporaries(mut self, asm: &mut x64::Asm, temps: Vec<u64>, arguments: Vec<u64>) {
        mut at: u64 = temps.len()
        while at > 0 {
            at -= 1
            index := arguments[temps[at]]
            ty := self.temporary_type(index).unwrap()
            cell := self.temp_cells.pop().unwrap()
            self.temp_exprs.pop()
            self.temp_ready.pop()
            skip := asm.new_label()
            asm.push(x64::Reg::RAX)
            asm.push(x64::Reg::RDX)
            asm.push(x64::Reg::RSI)
            asm.push(x64::Reg::RCX)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, slot_disp(cell))
            asm.test_rr(x64::Reg::RDI, x64::Reg::RDI)
            asm.jcc(x64::Cc::EQUAL, skip)
            label := self.handle_drop_routine(asm, ty)
            asm.call_label(label)
            asm.bind(skip)
            asm.mov_ri(x64::Reg::R11, 0)
            asm.store(8, x64::Reg::R11, x64::Reg::RBP, slot_disp(cell))
            asm.pop(x64::Reg::RCX)
            asm.pop(x64::Reg::RSI)
            asm.pop(x64::Reg::RDX)
            asm.pop(x64::Reg::RAX)
        }
    }

    // A string operation: its temporaries are borrowed, so they are dropped after it.
    fun guarded_string(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        temps := self.borrowed_temporaries(arguments.clone(), 0)
        when temps.len() == 0 {
            return self.string_op(asm, op, arguments)
        }
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) {
            return false
        }
        ok := self.string_op(asm, op, arguments.clone())
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    // A vector operation (as a statement or an expression): a value that is pushed, set or inserted is kept, not borrowed.
    fun guarded_vec(mut self, asm: &mut x64::Asm, op: String, ty: u64, arguments: Vec<u64>, statement: bool) -> bool {
        mut kept: u64 = 0
        when op == "Push" {
            kept = 2
        } else when op == "Set" || op == "Insert" {
            kept = 4
        }
        temps := self.borrowed_temporaries(arguments.clone(), kept)
        when temps.len() == 0 {
            when statement {
                return self.vec_statement(asm, op, ty, arguments)
            }
            return self.vec_op(asm, op, ty, arguments)
        }
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) {
            return false
        }
        mut ok: bool = false
        when statement {
            ok = self.vec_statement(asm, op, ty, arguments.clone())
        } else {
            ok = self.vec_op(asm, op, ty, arguments.clone())
        }
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    // A map or set operation: an inserted key and value are kept.
    fun guarded_map(mut self, asm: &mut x64::Asm, op: String, key: u64, value: u64, arguments: Vec<u64>) -> bool {
        mut kept: u64 = 0
        when op == "Insert" {
            kept = 6
        }
        temps := self.borrowed_temporaries(arguments.clone(), kept)
        when temps.len() == 0 {
            return self.map_op(asm, op, key, value, arguments)
        }
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) {
            return false
        }
        ok := self.map_op(asm, op, key, value, arguments.clone())
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    // An Option or Result test: the value it reads is borrowed.
    fun guarded_predicate(mut self, asm: &mut x64::Asm, op: String, id: u64, arguments: Vec<u64>) -> bool {
        temps := self.borrowed_temporaries(arguments.clone(), 0)
        when temps.len() == 0 {
            return self.enum_predicate(asm, op, id, arguments)
        }
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) {
            return false
        }
        ok := self.enum_predicate(asm, op, id, arguments.clone())
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    // `unwrap` and `expect`: the receiver is borrowed (its payload is copied), so a temporary receiver is dropped after it.
    fun guarded_unwrap(mut self, asm: &mut x64::Asm, id: u64, ty: u64, message: bool, tag: u64, failure: String, arguments: Vec<u64>) -> bool {
        temps := self.borrowed_temporaries(arguments.clone(), 0)
        when temps.len() == 0 {
            return self.enum_unwrap(asm, id, ty, message, tag, failure, arguments)
        }
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) {
            return false
        }
        ok := self.enum_unwrap(asm, id, ty, message, tag, failure, arguments.clone())
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    // `unwrap_or`: the fallback is returned when there is no payload, so it is kept; the receiver is borrowed.
    fun guarded_unwrap_or(mut self, asm: &mut x64::Asm, id: u64, ty: u64, arguments: Vec<u64>) -> bool {
        temps := self.borrowed_temporaries(arguments.clone(), 2)
        when temps.len() == 0 {
            return self.enum_unwrap_or(asm, id, ty, arguments)
        }
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) {
            return false
        }
        ok := self.enum_unwrap_or(asm, id, ty, arguments.clone())
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    fun call_statement(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>) -> bool {
        return choose target {
            ir::CallTarget::Func(id) => self.call_for_effect(asm, id, arguments),
            ir::CallTarget::StringOp(op) => self.guarded_string(asm, op, arguments),
            ir::CallTarget::VecOp(op, ty) => self.guarded_vec(asm, op, ty, arguments, true),
            ir::CallTarget::SystemOp(op) => self.guarded_system(asm, op, arguments),
            ir::CallTarget::EnumNew(id, variant) => self.enum_new(asm, id, variant, arguments),
            ir::CallTarget::MapOp(op, key, value) => self.guarded_map(asm, op, key, value, arguments),
            ir::CallTarget::SetOp(op, key, value) => self.guarded_map(asm, op, key, value, arguments),
            ir::CallTarget::IndirectFn(id) => self.indirect_call(asm, id, arguments),
            ir::CallTarget::FilesystemOp(op) => self.filesystem(asm, op, arguments),
            ir::CallTarget::ArgCount => self.arg_count(asm),
            ir::CallTarget::VecGetOption(element, option, pop) => self.vec_get_option(asm, element, option, pop, arguments),
            ir::CallTarget::EnumPredicate(op, id) => self.guarded_predicate(asm, op, id, arguments),
            ir::CallTarget::TryRead(id) => self.fail("a call to the file reading builtin that gives an Option"),
            ir::CallTarget::ReadFileRes(id) => self.fail("a call to the file reading builtin that gives a Result"),
            ir::CallTarget::VecSlice(element) => self.fail("a vector slice outside a slice argument"),
            ir::CallTarget::SliceLen => self.fail("a slice length"),
            _ => self.fail("a builtin call"),
        }
    }

    fun if_statement(mut self, asm: &mut x64::Asm, condition: u64, then_body: Vec<u64>, else_body: Vec<u64>) -> bool {
        when !self.expr(asm, condition) {
            return false
        }
        otherwise := asm.new_label()
        end := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, otherwise)
        when !self.body(asm, then_body) {
            return false
        }
        asm.jmp(end)
        asm.bind(otherwise)
        when !self.body(asm, else_body) {
            return false
        }
        asm.bind(end)
        return true
    }

    fun while_statement(mut self, asm: &mut x64::Asm, setup: Vec<u64>, condition: u64, body: Vec<u64>) -> bool {
        top := asm.new_label()
        end := asm.new_label()
        asm.bind(top)
        when !self.body(asm, setup) {
            return false
        }
        when !self.expr(asm, condition) {
            return false
        }
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, end)
        self.breaks.push(end)
        self.continues.push(top)
        let_ok := self.body(asm, body)
        self.breaks.pop()
        self.continues.pop()
        when !let_ok {
            return false
        }
        asm.jmp(top)
        asm.bind(end)
        return true
    }

    // `for slot in start..end` (or `..=`): the counter starts at `start`, and the loop stops at `end` (`end` is included
    // for `..=`). The test runs before each iteration, and for `..=` the counter stops before it would step past `end`.
    fun for_statement(mut self, asm: &mut x64::Asm, slot: u64, end_slot: u64, ty: u64, start: u64, end: u64, inclusive: bool, body: Vec<u64>) -> bool {
        when !self.expr(asm, start) {
            return false
        }
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
        when !self.expr(asm, end) {
            return false
        }
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(end_slot))
        signed := is_signed_word(self.word(ty))
        mut stays: u64 = x64::Cc::BELOW_EQUAL
        when signed {
            stays = x64::Cc::LESS_EQUAL
        }
        when !inclusive {
            stays = x64::Cc::BELOW
            when signed {
                stays = x64::Cc::LESS
            }
        }
        top := asm.new_label()
        step := asm.new_label()
        end_label := asm.new_label()
        asm.bind(top)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, slot_disp(end_slot))
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(negated_condition(stays), end_label)
        self.breaks.push(end_label)
        self.continues.push(step)
        let_ok := self.body(asm, body)
        self.breaks.pop()
        self.continues.pop()
        when !let_ok {
            return false
        }
        asm.bind(step)
        // `..=` ends after the iteration that reaches `end`, before the counter would step past it.
        when inclusive {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, slot_disp(end_slot))
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
            asm.jcc(x64::Cc::EQUAL, end_label)
        }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
        asm.alu_ri(0, x64::Reg::RAX, 1)
        step_word := self.word(ty)
        self.normalize(asm, step_word)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
        asm.jmp(top)
        asm.bind(end_label)
        return true
    }

    fun jump_to(mut self, asm: &mut x64::Asm, is_break: bool) -> bool {
        when is_break {
            when self.breaks.is_empty() {
                return self.fail("a break outside a loop")
            }
            asm.jmp(self.breaks[self.breaks.len() - 1])
        } else {
            when self.continues.is_empty() {
                return self.fail("a continue outside a loop")
            }
            asm.jmp(self.continues[self.continues.len() - 1])
        }
        return true
    }

    fun return_statement(mut self, asm: &mut x64::Asm, value: Option<u64>) -> bool {
        when value.is_some() && self.result_cells > 0 {
            when !self.return_aggregate(asm, value.unwrap()) {
                return false
            }
        }
        when value.is_some() && self.result_cells == 0 {
            when !self.expr(asm, value.unwrap()) {
                return false
            }
        }
        mut saved: bool = false
        when self.owner_slots.len() > 0 {
            saved = self.result_cells == 0
            when saved {
                asm.push(x64::Reg::RAX)
            }
            self.drop_owners(asm)
            when saved {
                asm.pop(x64::Reg::RAX)
            }
        }
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
        return true
    }

    // Returns a string or structure value: it is pushed as its cells, then copied to the result cells, which lie above the
    // arguments. Once pushed, cell k of the value is at rsp + 8 * (count - 1 - k), and the caller reads the result in the
    // same order.
    fun return_aggregate(mut self, asm: &mut x64::Asm, value: u64) -> bool {
        count := self.result_cells
        when !self.push_value(asm, value, self.result_type) {
            return false
        }
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (16 + 8 * (self.argument_cells + count - 1 - cell)) as i64)
            cell += 1
        }
        return true
    }

    // Calls function `id` with the arguments, which are pushed in order and then loaded into the argument registers
    // from the last. The result is in rax, or for a string or structure, on the stack in the order of a pushed value.
    fun call(mut self, asm: &mut x64::Asm, id: u64, arguments: Vec<u64>) -> bool {
        self.needed.set(id, true)
        callee := self.program.functions[id]
        when callee.external_symbol.is_some() {
            return self.call_foreign(asm, callee.parameters.clone(), callee.return_type, callee.external_symbol.unwrap(), arguments)
        }
        when arguments.len() != callee.parameters.len() / 2 {
            return self.fail("a call with another number of arguments")
        }
        // A string or structure result gets its cells first, above the arguments, where the callee writes them.
        mut reserved: u64 = 0
        when callee.return_type.is_some() {
            reserved = self.aggregate_cells(callee.return_type.unwrap())
        }
        when reserved > 0 {
            asm.alu_ri(5, x64::Reg::RSP, (8 * reserved) as i64)
        }
        // Each argument is pushed as its cells, in order: a scalar is one cell, and a structure local is the cells it
        // occupies. The callee reads them from the stack, and the caller removes them after the call.
        mut total: u64 = 0
        mut position: u64 = 0
        for argument in arguments.clone() {
            ty := callee.parameters[position * 2 + 1]
            cells := self.cells_of(ty)
            when cells == 0 {
                return self.fail("an argument of this type")
            }
            when !self.push_value(asm, argument, ty) {
                return false
            }
            total += cells
            position += 1
        }
        asm.call_label(self.labels[id])
        asm.alu_ri(0, x64::Reg::RSP, (total * 8) as i64)
        return true
    }

    // A call statement: a string or structure result that the call left on the stack is removed, since nothing reads it.
    fun call_for_effect(mut self, asm: &mut x64::Asm, id: u64, arguments: Vec<u64>) -> bool {
        when !self.call(asm, id, arguments) {
            return false
        }
        callee := self.program.functions[id]
        when callee.return_type.is_some() && self.has_owners(callee.return_type.unwrap()) {
            self.drop_pushed(asm, callee.return_type.unwrap())
            return true
        }
        mut discarded: u64 = 0
        when callee.return_type.is_some() {
            discarded = self.aggregate_cells(callee.return_type.unwrap())
        }
        when discarded > 0 {
            asm.alu_ri(0, x64::Reg::RSP, (8 * discarded) as i64)
        }
        return true
    }

    // A call in an expression that yields one cell. A string or structure result is not one: the code that stores or
    // pushes it reads it from the stack.
    fun call_value(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>, ty: u64) -> bool {
        when self.aggregate_cells(ty) > 0 {
            return self.fail("a structure value")
        }
        return self.call_expression(asm, target, arguments)
    }

    // Stores a string or structure result, which the call leaves on the stack, into the cells from `base` on, and removes
    // it from the stack.
    fun call_into(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>, base: u64, count: u64) -> bool {
        when !self.call_expression(asm, target, arguments) {
            return false
        }
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + cell))
            cell += 1
        }
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    // A cell of a structure that a call returns: it is read from the pushed result, which is then removed.
    fun call_field(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>, id: u64, field: u64, ty: u64) -> bool {
        when self.program.structs[id].drop_function.is_some() {
            return self.fail("a field of a temporary destructor")
        }
        when !self.call_expression(asm, target, arguments) {
            return false
        }
        count := self.program.structs[id].slot_count
        when !self.load_cell(asm, ty, x64::Reg::RSP, self.pushed_field_disp(id, field)) {
            return false
        }
        self.drop_field_remainder(asm, id, field, ty)
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    // The data and length of a string expression (a literal, a str local, or a String local), in rsi and rdx.
    // A String or `str` field, read where it lies: in a local's frame, or in memory at the address of the field.
    fun load_field_string(mut self, asm: &mut x64::Asm, index: u64, ty: u64) -> bool {
        place := self.place_of(index)
        when place.is_some() {
            return self.load_string_local(asm, place.unwrap(), ty)
        }
        when !self.is_memory_place(index) {
            return self.fail("a string field that is not in a local or in memory")
        }
        // A `str` field through a reference is not in the subset of the reference compiler, so it is not read here.
        when self.is_str(ty) {
            return self.fail("a str field through a reference")
        }
        when !self.memory_address(asm, index) {
            return false
        }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
        return true
    }

    // A String used as a str: the data and length of its header, which the expression `inner` gives, are pushed, the
    // pointer first.
    fun push_string_as_str(mut self, asm: &mut x64::Asm, inner: u64) -> bool {
        when !self.expr(asm, inner) {
            return false
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.push(x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.push(x64::Reg::RCX)
        return true
    }

    // A String used as a str: its data and length are in rsi and rdx.
    fun load_string_as_str(mut self, asm: &mut x64::Asm, inner: u64) -> bool {
        when !self.expr(asm, inner) {
            return false
        }
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
        return true
    }

    // A `str` field of a local, pushed as its two cells, the pointer first.
    fun push_field_str(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        place := self.place_of(index)
        when place.is_some() {
            return self.push_local_cells(asm, place.unwrap(), 2)
        }
        return self.fail("a str field through a reference")
    }

    // A `str` field of a local stored into the cells from `base` on.
    fun store_field_str(mut self, asm: &mut x64::Asm, index: u64, base: u64) -> bool {
        place := self.place_of(index)
        when place.is_some() {
            return self.copy_cells(asm, place.unwrap(), base, 2)
        }
        return self.fail("a str field through a reference")
    }

    fun load_string_parts(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        when self.string_literal(index).is_some() {
            literal := self.literal(self.string_literal(index).unwrap())
            asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[literal])
            asm.mov_ri(x64::Reg::RDX, self.literal_lengths[literal])
            return true
        }
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => self.load_string_local(asm, slot, ty),
            ir::IrExpr::MoveRef(slot, ty) => self.moved_string_parts(asm, index, slot, ty),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_string_parts(asm, index, cty),
            ir::IrExpr::FieldRead(value, id, field, fty, span) => self.load_field_string(asm, index, fty),
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, fty, span, borrowed) => self.load_field_string(asm, index, fty),
            ir::IrExpr::StringAsStr(inner) => self.load_string_as_str(asm, inner),
            _ => self.fail("a string argument that is not a literal or a local"),
        }
    }

    // The data and length of a `str` that a call returns: its cells are on the stack, the length on top.
    fun str_call_parts(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>) -> bool {
        when !self.call_expression(asm, target, arguments) {
            return false
        }
        asm.pop(x64::Reg::RDX)
        asm.pop(x64::Reg::RSI)
        return true
    }

    // The data and length of a String that a call returns, read through its header.
    fun call_string_parts(mut self, asm: &mut x64::Asm, index: u64, ty: u64) -> bool {
        when self.is_str(ty) {
            return choose self.program.exprs[index] {
                ir::IrExpr::CallExpr(target, arguments, cty) => self.str_call_parts(asm, target, arguments),
                _ => self.fail("a string argument that is not a literal or a local"),
            }
        }
        when !self.is_string(ty) {
            return self.fail("a string argument that is not a literal or a local")
        }
        when !self.expr(asm, index) {
            return false
        }
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
        return true
    }

    fun moved_string_parts(mut self, asm: &mut x64::Asm, index: u64, slot: u64, ty: u64) -> bool {
        when self.is_str(ty) { return self.load_string_local(asm, slot, ty) }
        when !self.expr(asm, index) { return false }
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
        return true
    }

    fun load_string_local(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        when self.is_str(ty) {
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, slot_disp(slot))
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(slot + 1))
            return true
        }
        when self.is_string(ty) {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
            return true
        }
        return self.fail("a string of this type")
    }

    // `len()` is the byte length, and `char_count()` counts the bytes that begin a character (not continuation bytes).
    fun string_query(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        when arguments.len() != 1 {
            return self.op_fail("a string operation ", op)
        }
        when !self.load_string_parts(asm, arguments[0]) {
            return false
        }
        when op == "Len" {
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
            return true
        }
        // rsi walks the bytes up to rdi; rcx counts the character starts.
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RDX)
        asm.mov_ri(x64::Reg::RCX, 0)
        top := asm.new_label()
        skip := asm.new_label()
        done := asm.new_label()
        asm.bind(top)
        asm.alu_rr(57, x64::Reg::RSI, x64::Reg::RDI)
        asm.jcc(x64::Cc::EQUAL, done)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::RSI, 0)
        asm.alu_ri(4, x64::Reg::RAX, 192)
        asm.alu_ri(7, x64::Reg::RAX, 128)
        asm.jcc(x64::Cc::EQUAL, skip)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.bind(skip)
        asm.alu_ri(0, x64::Reg::RSI, 1)
        asm.jmp(top)
        asm.bind(done)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        return true
    }

    // The operations on a vector of destructor values: they are moved in, counted, and dropped by `clear` and by the owner.
    fun vec_of_destructors(mut self, asm: &mut x64::Asm, op: String, element: u64, arguments: Vec<u64>) -> bool {
        when op == "New" && arguments.len() == 0 {
            return self.vec_new(asm)
        }
        when op == "Push" && arguments.len() == 2 {
            return self.vec_push(asm, element, arguments[0], arguments[1])
        }
        when (op == "Len" || op == "IsEmpty") && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 8)
            when op == "IsEmpty" {
                asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
                asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            }
            return true
        }
        when op == "Clear" && arguments.len() == 1 {
            cells := self.cells_of(element)
            when !self.expr(asm, arguments[0]) {
                return false
            }
            label := self.glue_routine(asm, 0, element)
            asm.push(x64::Reg::RAX)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.call_label(label)
            asm.pop(x64::Reg::RAX)
            asm.mov_ri(x64::Reg::RCX, 0)
            asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
            return true
        }
        return self.op_fail("a vector of destructor values and ", op)
    }

    // A vector operation. An element takes `cells_of` cells, eight bytes each, laid out as the cells of a pushed value
    // (the first cell highest), so a structure element is one block that is copied whole. A vector of scalars or Strings
    // is one array of cells. The header is {data, len, capacity}, with the data from malloc and grown by realloc.
    fun vec_op(mut self, asm: &mut x64::Asm, op: String, element: u64, arguments: Vec<u64>) -> bool {
        when self.destructor_of(element).is_some() {
            return self.vec_of_destructors(asm, op, element, arguments)
        }
        when !self.is_cell(element) && !self.is_plain_structure(element) {
            return self.fail("a vector of this element type")
        }
        when op == "New" && arguments.len() == 0 {
            return self.vec_new(asm)
        }
        when op == "Len" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 8)
            return true
        }
        when op == "IsEmpty" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 8)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            return true
        }
        when op == "Push" && arguments.len() == 2 {
            return self.vec_push(asm, element, arguments[0], arguments[1])
        }
        when op == "Index" && arguments.len() == 2 {
            return self.vec_index(asm, element, arguments[0], arguments[1])
        }
        when op == "Capacity" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 16)
            return true
        }
        when op == "Clear" && arguments.len() == 1 {
            cells := self.cells_of(element)
            when !self.expr(asm, arguments[0]) {
                return false
            }
            when self.has_owners(element) {
                asm.push(x64::Reg::RAX)
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 8)
                asm.push(x64::Reg::RCX)
                top := asm.new_label()
                done := asm.new_label()
                asm.bind(top)
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
                asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
                asm.jcc(x64::Cc::EQUAL, done)
                asm.alu_ri(5, x64::Reg::RCX, 1)
                asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 0)
                asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 8)
                asm.load(8, false, x64::Reg::RDI, x64::Reg::RAX, 0)
                self.scale_bytes(asm, x64::Reg::RCX, 8 * cells)
                asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RCX)
                asm.alu_ri(0, x64::Reg::RDI, (8 * (cells - 1)) as i64)
                asm.call_label(self.value_drop_routine(asm, element, false))
                asm.jmp(top)
                asm.bind(done)
                asm.alu_ri(0, x64::Reg::RSP, 8)
                asm.pop(x64::Reg::RAX)
            }
            asm.mov_ri(x64::Reg::RCX, 0)
            asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
            return true
        }
        when op == "Clone" && arguments.len() == 1 {
            return self.vec_clone(asm, element, arguments[0])
        }
        when op == "Sort" && arguments.len() == 1 {
            when !self.is_cell(element) {
                return self.fail("a sort of structures")
            }
            return self.vec_sort(asm, element, arguments[0])
        }
        when op == "Contains" && arguments.len() == 2 {
            when !self.is_cell(element) {
                return self.fail("a search of structures")
            }
            return self.vec_contains(asm, element, arguments[0], arguments[1])
        }
        when op == "Set" && arguments.len() == 3 {
            return self.vec_set(asm, element, arguments[0], arguments[1], arguments[2])
        }
        when op == "Take" && arguments.len() == 2 {
            return self.vec_take(asm, element, arguments[0], arguments[1])
        }
        when op == "Insert" && arguments.len() == 3 {
            return self.vec_insert(asm, element, arguments[0], arguments[1], arguments[2])
        }
        return self.op_fail("a vector operation ", op)
    }

    // A vector operation as a statement. An Index or Take of a structure leaves its cells on the stack, which nothing reads.
    fun vec_statement(mut self, asm: &mut x64::Asm, op: String, element: u64, arguments: Vec<u64>) -> bool {
        discards := (op == "Index" || op == "Take") && !self.is_cell(element)
        cells := self.cells_of(element)
        when !self.vec_op(asm, op, element, arguments) {
            return false
        }
        when discards {
            asm.alu_ri(0, x64::Reg::RSP, (8 * cells) as i64)
        }
        return true
    }

    // Whether a structure can be an element: a destructor would have to run for each element, which a vector does not do.
    fun is_plain_structure(self, ty: u64) -> bool {
        when self.has_destructor(ty) {
            return false
        }
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.program.structs[id].slot_count > 0,
            _ => false,
        }
    }

    // The owned cells of a value of type `ty` in memory, as triples: the offset of the cell from the start of the value, a
    // code (1 for a String, 2 for a vector) and the type (the String, or the element type of the vector). None when the value
    // owns something a clone does not copy: a map or a set, an enum whose payloads own memory, or a vector of such.
    fun owned_cells(self, ty: u64) -> Option<Vec<u64>> {
        mut cells: Vec<u64> = Vec()
        when self.is_string(ty) {
            cells.push(0)
            cells.push(1)
            cells.push(ty)
            return Option::Some(cells)
        }
        element := choose self.program.types[ty] {
            ir::IrTy::VecOf(e) => Option::Some(e),
            _ => Option::None,
        }
        when element.is_some() {
            when self.owned_cells(element.unwrap()).is_none() {
                return Option::None
            }
            cells.push(0)
            cells.push(2)
            cells.push(element.unwrap())
            return Option::Some(cells)
        }
        when self.is_map_or_set(ty) {
            key := choose self.program.types[ty] { ir::IrTy::MapOf(k, v) => k, ir::IrTy::SetOf(k, v) => k, _ => 0 }
            value := choose self.program.types[ty] { ir::IrTy::MapOf(k, v) => v, ir::IrTy::SetOf(k, v) => v, _ => 0 }
            when !self.map_cell(key) || !self.map_cell(value) || self.is_handle_struct(key) || self.is_handle_struct(value) {
                return Option::None
            }
            cells.push(0)
            cells.push(4)
            cells.push(ty)
            return Option::Some(cells)
        }
        enum_id := choose self.program.types[ty] {
            ir::IrTy::EnumTy(id) => Option::Some(id),
            _ => Option::None,
        }
        when enum_id.is_some() {
            owned := self.enum_owned_fields(enum_id.unwrap())
            when owned.is_none() {
                return Option::None
            }
            // An enum is always a box of its own, so a copy always makes a new one.
            cells.push(0)
            cells.push(3)
            cells.push(ty)
            return Option::Some(cells)
        }
        structure := choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => Option::Some(id),
            _ => Option::None,
        }
        when structure.is_none() {
            return Option::Some(cells)
        }
        id := structure.unwrap()
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            inner := self.owned_cells(self.program.structs[id].fields[position].ty)
            when inner.is_none() {
                return Option::None
            }
            base := self.sub_displacement(id, position) as u64
            list := inner.unwrap()
            mut at: u64 = 0
            while at < list.len() {
                cells.push(base + list[at])
                cells.push(list[at + 1])
                cells.push(list[at + 2])
                at += 3
            }
            position += 1
        }
        return Option::Some(cells)
    }

    fun is_map_or_set(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::MapOf(a, b) => true,
            ir::IrTy::SetOf(a, b) => true,
            _ => false,
        }
    }

    // The owned payload fields of an enum, as quadruples: the variant, the byte offset in the box, the code (1 String, 2 vector,
    // 3 enum) and the type. None when a payload owns something this backend cannot copy (more than a cell, a map).
    fun enum_owned_fields(self, id: u64) -> Option<Vec<u64>> {
        mut list: Vec<u64> = Vec()
        mut variant: u64 = 0
        while variant < self.program.enums[id].variants.len() {
            fields := self.program.enums[id].variants[variant].fields.clone()
            mut field: u64 = 0
            while field < fields.len() {
                inner := self.owned_cells(fields[field])
                when inner.is_none() {
                    return Option::None
                }
                owned := inner.unwrap()
                mut at: u64 = 0
                while at < owned.len() {
                    // Stack/element offsets run backwards; enum payload cells run forwards.
                    list.push(variant)
                    list.push(8 * (self.enum_field_offset(id, variant, field) + self.cells_of(fields[field])) - owned[at])
                    list.push(owned[at + 1])
                    list.push(owned[at + 2])
                    at += 3
                }
                field += 1
            }
            variant += 1
        }
        return Option::Some(list)
    }

    fun enum_id_of(self, ty: u64) -> u64 {
        return choose self.program.types[ty] {
            ir::IrTy::EnumTy(id) => id,
            _ => 0,
        }
    }

    // The label of the routine that copies an enum value whose payloads own memory.
    fun enum_routine(mut self, asm: &mut x64::Asm, id: u64) -> u64 {
        mut at: u64 = 0
        while at < self.enum_clone_ids.len() {
            when self.enum_clone_ids[at] == id {
                return self.enum_clone_labels[at]
            }
            at += 1
        }
        label := asm.new_label()
        self.enum_clone_ids.push(id)
        self.enum_clone_labels.push(label)
        return label
    }

    // The routine that copies the enum value (a box) in rdi: the box is copied by variant, and each owned payload in the copy
    // is replaced by its own copy. The new box is left in rax.
    fun emit_enum_clone(mut self, asm: &mut x64::Asm, id: u64) -> bool {
        owned := self.enum_owned_fields(id)
        when owned.is_none() {
            return self.fail("a copy of an enum with this payload")
        }
        list := owned.unwrap()
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.push(x64::Reg::RDI)
        asm.push(x64::Reg::RDI)
        done := asm.new_label()
        mut variant: u64 = 0
        while variant < self.program.enums[id].variants.len() {
            next := asm.new_label()
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 8)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
            asm.alu_ri(7, x64::Reg::RCX, variant as i64)
            asm.jcc(x64::Cc::NOT_EQUAL, next)
            fields := self.program.enums[id].variants[variant].fields.clone()
            mut cells: u64 = 0
            for field in fields.clone() {
                cells += self.cells_of(field)
            }
            asm.mov_ri(x64::Reg::RDI, 8 * (1 + cells))
            self.aligned_call(asm, String("malloc"))
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            mut cell: u64 = 0
            while cell < 1 + cells {
                asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 8)
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, (8 * cell) as i64)
                asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
                asm.store(8, x64::Reg::RCX, x64::Reg::RAX, (8 * cell) as i64)
                cell += 1
            }
            mut at: u64 = 0
            while at < list.len() {
                when list[at] == variant {
                    target := self.copy_routine(asm, list[at + 2], list[at + 3])
                    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
                    asm.load(8, false, x64::Reg::RDI, x64::Reg::RAX, list[at + 1] as i64)
                    asm.call_label(target)
                    asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 16)
                    asm.store(8, x64::Reg::RAX, x64::Reg::RDX, list[at + 1] as i64)
                }
                at += 4
            }
            asm.jmp(done)
            asm.bind(next)
            variant += 1
        }
        asm.bind(done)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
        return true
    }

    // Whether no payload of the enum owns memory, so that a copy of the enum may share its box: a box is never changed or
    // freed, and the payloads are not moved out of an element.
    fun enum_payloads_own_nothing(self, id: u64) -> bool {
        mut variant: u64 = 0
        while variant < self.program.enums[id].variants.len() {
            fields := self.program.enums[id].variants[variant].fields.clone()
            mut field: u64 = 0
            while field < fields.len() {
                inner := self.owned_cells(fields[field])
                when inner.is_none() {
                    return false
                }
                when inner.unwrap().len() > 0 {
                    return false
                }
                field += 1
            }
            variant += 1
        }
        return true
    }

    // `reg *= bytes`: the byte offset of an element, through r11.
    fun scale_bytes(self, asm: &mut x64::Asm, reg: u64, bytes: u64) {
        asm.mov_ri(x64::Reg::R11, bytes)
        asm.imul_rr(reg, x64::Reg::R11)
    }

    // Copies `count` cells from the memory at `source` to the memory at `target`, both addresses in registers, through rax.
    // The cells of an element keep their order in memory, so the copy is word for word.
    fun copy_block(self, asm: &mut x64::Asm, source: u64, target: u64, count: u64) {
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, source, (8 * cell) as i64)
            asm.store(8, x64::Reg::RAX, target, (8 * cell) as i64)
            cell += 1
        }
    }

    // `clone` of a vector: the header is passed to the routine that clones a vector of this element type.
    fun vec_clone(mut self, asm: &mut x64::Asm, element: u64, vec: u64) -> bool {
        when self.owned_cells(element).is_none() {
            return self.fail("a vector clone of owned elements")
        }
        when !self.expr(asm, vec) {
            return false
        }
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        label := self.vec_routine(asm, element)
        asm.call_label(label)
        return true
    }

    // The label of the routine that clones a vector whose element type is `element`: the header in rdi, the copy in rax. The
    // routine is made once, after the functions, by `emit_vec_routines`, which may ask for more.
    fun vec_routine(mut self, asm: &mut x64::Asm, element: u64) -> u64 {
        mut position: u64 = 0
        while position < self.vec_routine_elements.len() {
            when self.vec_routine_elements[position] == element {
                return self.vec_routine_labels[position]
            }
            position += 1
        }
        label := asm.new_label()
        self.vec_routine_elements.push(element)
        self.vec_routine_labels.push(label)
        return label
    }

    // The routines of the vector clones that were asked for.
    fun emit_vec_routines(mut self, asm: &mut x64::Asm) -> bool {
        // A routine may ask for others (a vector of enums asks for the enum's copy, which asks for a vector's), so the three
        // lists are walked together until none has a routine left that is not written.
        mut enum_done: u64 = 0
        mut glue: u64 = 0
        mut done: u64 = 0
        mut progress: bool = true
        while progress {
            progress = false
            while enum_done < self.enum_clone_ids.len() {
                asm.bind(self.enum_clone_labels[enum_done])
                when !self.emit_enum_clone(asm, self.enum_clone_ids[enum_done]) {
                    return false
                }
                enum_done += 1
                progress = true
            }
            while glue < self.glue_labels.len() {
                asm.bind(self.glue_labels[glue])
                self.emit_glue(asm, self.glue_kinds[glue], self.glue_elements[glue])
                glue += 1
                progress = true
            }
            while done < self.vec_routine_elements.len() {
                asm.bind(self.vec_routine_labels[done])
                when !self.emit_vec_clone(asm, self.vec_routine_elements[done]) {
                    return false
                }
                asm.ret()
                done += 1
                progress = true
            }
        }
        return self.emit_drop_routines(asm)
    }

    // The body of a vector clone: the header in rdi is copied with its elements, each owned cell of the copy is replaced by
    // its clone, and the copy's header is left in rax.
    fun emit_vec_clone(mut self, asm: &mut x64::Asm, element: u64) -> bool {
        cells := self.cells_of(element)
        bytes := 8 * cells
        owned := self.owned_cells(element)
        when owned.is_none() {
            return self.fail("a vector clone of owned elements")
        }
        asm.push(x64::Reg::RDI)
        // The copy of the elements: malloc(bytes * len), then memcpy(copy, data, bytes * len).
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 8)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::RDI, bytes)
        self.aligned_call(asm, String("malloc"))
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RCX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        self.scale_bytes(asm, x64::Reg::RDX, bytes)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("memcpy"))
        self.clone_owned(asm, owned.unwrap(), bytes)
        // The header: the copy, the length, and the capacity of the length.
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 16)
        asm.alu_ri(0, x64::Reg::RSP, 16)
        return true
    }

    // Replaces each owned cell of each element of the copy by its clone: a String by the String clone, and a vector by the
    // routine of its element type. The stack holds the copy at 0 and the source header at 8; the loop keeps the element
    // index, the length and the copy on the stack, as the clone calls clobber the registers.
    fun clone_owned(mut self, asm: &mut x64::Asm, cells: Vec<u64>, bytes: u64) {
        when cells.len() == 0 {
            return
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RCX, 8)
        asm.push(x64::Reg::RCX)
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.push(x64::Reg::RCX)
        // [rsp] is the index, [rsp + 8] the length, [rsp + 16] the copy and [rsp + 24] the source header.
        top := asm.new_label()
        done := asm.new_label()
        asm.bind(top)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, done)
        mut at: u64 = 0
        while at < cells.len() {
            offset := cells[at]
            code := cells[at + 1]
            ty := cells[at + 2]
            target := self.copy_routine(asm, code, ty)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
            self.scale_bytes(asm, x64::Reg::RAX, bytes)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
            asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RDX)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RAX, offset as i64)
            asm.call_label(target)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
            self.scale_bytes(asm, x64::Reg::RDX, bytes)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
            asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RCX)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, offset as i64)
            at += 3
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.jmp(top)
        asm.bind(done)
        asm.alu_ri(0, x64::Reg::RSP, 16)
    }

    fun vec_new(mut self, asm: &mut x64::Asm) -> bool {
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        return true
    }

    // `vec.push(value)`: when the length has reached the capacity, the capacity doubles (at least to four), and the data
    // is grown by realloc; then the value's cells are copied to the end.
    fun vec_push(mut self, asm: &mut x64::Asm, element: u64, vec: u64, value: u64) -> bool {
        cells := self.cells_of(element)
        when !self.expr(asm, vec) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.push_value(asm, value, element) {
            return false
        }
        // The header is under the value's cells; rcx is the length, and rax the capacity.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * cells) as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RDX, 16)
        room := asm.new_label()
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RAX)
        asm.jcc(x64::Cc::BELOW, room)
        self.grow_capacity(asm)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 16)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RAX)
        self.scale_bytes(asm, x64::Reg::RSI, 8 * cells)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        self.aligned_call(asm, String("realloc"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * cells) as i64)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.bind(room)
        // The value goes at data + len * bytes, and the length grows by one.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * cells) as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::RDI, 8 * cells)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RSI)
        self.copy_block(asm, x64::Reg::RSP, x64::Reg::RDI, cells)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.alu_ri(0, x64::Reg::RSP, (8 * (cells + 1)) as i64)
        return true
    }

    // `Enum::Variant(fields)`: a box {tag, one cell per field} from malloc, which is the enum's one cell.
    fun enum_new(mut self, asm: &mut x64::Asm, id: u64, variant: u64, arguments: Vec<u64>) -> bool {
        fields := self.program.enums[id].variants[variant].fields.clone()
        when fields.len() != arguments.len() {
            return self.fail("an enum value with another number of fields")
        }
        mut cells: u64 = 0
        for field in fields.clone() {
            cells += self.cells_of(field)
        }
        asm.mov_ri(x64::Reg::RDI, (8 * (1 + cells)) as u64)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RCX, variant)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.push(x64::Reg::RAX)
        // Each field takes its cells after the tag, in declaration order.
        mut offset: u64 = 0
        mut position: u64 = 0
        while position < arguments.len() {
            field_ty := fields[position]
            when !self.store_into_box(asm, arguments[position], offset, field_ty) {
                return false
            }
            offset += self.cells_of(field_ty)
            position += 1
        }
        asm.pop(x64::Reg::RAX)
        return true
    }

    // Stores a value of type `ty` into the box whose pointer is on the stack top, at `offset` cells after the tag: a
    // scalar or an owned value in one cell, a str in two, and a structure field by field, in the order they are written.
    fun store_into_box(mut self, asm: &mut x64::Asm, value: u64, offset: u64, ty: u64) -> bool {
        when self.is_str(ty) {
            return self.store_str_in_box(asm, value, offset)
        }
        when self.is_cell(ty) {
            when !self.expr(asm, value) {
                return false
            }
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (1 + offset)) as i64)
            return true
        }
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.store_structure_in_box(asm, value, offset, id),
            _ => self.fail("an enum field of this type"),
        }
    }

    fun store_structure_in_box(mut self, asm: &mut x64::Asm, value: u64, offset: u64, id: u64) -> bool {
        place := self.place_of(value)
        when place.is_some() && self.struct_destructor_cells(id).len() == 0 {
            return self.copy_local_to_box(asm, place.unwrap(), offset, self.program.structs[id].slot_count)
        }
        when self.is_memory_place(value) && self.struct_destructor_cells(id).len() == 0 {
            when !self.memory_borrowed(value) && self.has_owners(self.struct_type(id)) {
                saved := self.scratch(self.program.structs[id].slot_count)
                when !self.store_struct(asm, value, saved, id) { return false }
                return self.copy_local_to_box(asm, saved, offset, self.program.structs[id].slot_count)
            }
            when !self.memory_address(asm, value) {
                return false
            }
            when self.program.structs[id].repr_c {
                return self.fail("a repr(C) structure in an enum payload")
            }
            return self.copy_memory_to_box(asm, offset, self.program.structs[id].slot_count)
        }
        return choose self.program.exprs[value] {
            ir::IrExpr::StructValue(sid, fields, values) => self.store_fields_in_box(asm, offset, sid, fields, values),
            ir::IrExpr::LocalRef(slot, ty, span) => self.copy_local_to_box(asm, slot, offset, self.program.structs[id].slot_count),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_into_box(asm, target, arguments, offset, id),
            ir::IrExpr::MoveRef(slot, mty) => self.store_moved_to_box(asm, slot, offset, id),
            ir::IrExpr::Propagate(inner, input, output, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred) => self.store_propagated_in_box(asm, inner, id, failure_type, success_variant, output_failure_variant, deferred, offset),
            _ => self.fail_at("a structure field that is not a value or a local", value),
        }
    }

    // A propagated structure stored in an enum box: it is taken into scratch cells first, then copied.
    fun store_propagated_in_box(mut self, asm: &mut x64::Asm, inner: u64, id: u64, failure_type: Option<u64>, success_variant: u64, output_failure_variant: u64, deferred: Vec<u64>, offset: u64) -> bool {
        count := self.program.structs[id].slot_count
        held := self.scratch(count)
        when !self.propagate_struct(asm, inner, id, failure_type, success_variant, output_failure_variant, deferred, held) {
            return false
        }
        return self.copy_local_to_box(asm, held, offset, count)
    }

    fun store_fields_in_box(mut self, asm: &mut x64::Asm, offset: u64, id: u64, fields: Vec<u64>, values: Vec<u64>) -> bool {
        mut position: u64 = 0
        while position < fields.len() {
            field := fields[position]
            field_offset := self.program.structs[id].fields[field].slot_offset
            field_ty := self.program.structs[id].fields[field].ty
            when !self.store_into_box(asm, values[position], offset + field_offset, field_ty) {
                return false
            }
            position += 1
        }
        return true
    }

    // Copies `count` cells of the local at `slot` into the box, from `offset` cells after the tag.
    fun copy_local_to_box(mut self, asm: &mut x64::Asm, slot: u64, offset: u64, count: u64) -> bool {
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot + cell))
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (1 + offset + cell)) as i64)
            cell += 1
        }
        return true
    }

    // Stores a str value into the box whose pointer is on the stack top, at `offset` cells after the tag.
    fun store_str_in_box(mut self, asm: &mut x64::Asm, value: u64, offset: u64) -> bool {
        when self.string_literal(value).is_some() {
            index := self.literal(self.string_literal(value).unwrap())
            asm.lea_symbol(x64::Reg::RAX, self.literal_symbols[index])
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (1 + offset)) as i64)
            asm.mov_ri(x64::Reg::RAX, self.literal_lengths[index])
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (2 + offset)) as i64)
            return true
        }
        source := self.struct_local_of(value)
        when source.is_none() {
            return self.fail("a string field that is not a literal or a local")
        }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(source.unwrap()))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (1 + offset)) as i64)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(source.unwrap() + 1))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (2 + offset)) as i64)
        return true
    }

    // The cell offset of a field of a variant, after the tag, from the cells of the fields before it.
    fun enum_field_offset(self, id: u64, variant: u64, field: u64) -> u64 {
        fields := self.program.enums[id].variants[variant].fields.clone()
        mut offset: u64 = 0
        mut position: u64 = 0
        while position < field {
            offset += self.cells_of(fields[position])
            position += 1
        }
        return offset
    }
    // A match of an enum value: the tag of the box is compared with each arm's variant in order (an arm with no variant
    // always matches); the arm's fields are copied into their slots, and its body is the value. No arm for the tag is a
    // trap, which the exhaustive matches of checked programs do not reach.
    fun enum_match(mut self, asm: &mut x64::Asm, value: u64, id: u64, arms: Vec<u64>, ty: u64) -> bool {
        when self.cells_of(ty) == 0 {
            return self.fail("an enum match with a result of this type")
        }
        aggregate := !self.is_cell(ty)
        // The matched enum waits in a cell of the frame, so that a result pushed on the stack needs nothing removed.
        held := self.scratch(1)
        when !self.expr(asm, value) {
            return false
        }
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(held))
        end := asm.new_label()
        for arm in arms {
            record := self.program.arms[arm]
            next := asm.new_label()
            when record.variant.is_some() {
                asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(held))
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 0)
                asm.alu_ri(7, x64::Reg::RCX, record.variant.unwrap() as i64)
                asm.jcc(x64::Cc::NOT_EQUAL, next)
            }
            mut binding: u64 = 0
            while binding < record.bindings.len() {
                slot := record.bindings[binding]
                field_ty := record.bindings[binding + 1]
                field := record.bindings[binding + 2]
                when record.variant.is_none() {
                    return self.fail("a binding without a variant")
                }
                at := self.enum_field_offset(id, record.variant.unwrap(), field)
                cells := self.cells_of(field_ty)
                when cells == 0 {
                    return self.fail("an enum field of this type")
                }
                asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(held))
                mut cell: u64 = 0
                while cell < cells {
                    asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, (8 * (1 + at + cell)) as i64)
                    asm.store(8, x64::Reg::RCX, x64::Reg::RBP, slot_disp(slot + cell))
                    cell += 1
                }
                // Pattern bindings take ownership of payload owners, just as the Rust backend does.
                owners := self.owner_pairs(field_ty)
                mut owner: u64 = 0
                while owner < owners.len() {
                    asm.mov_ri(x64::Reg::RCX, 0)
                    asm.store(8, x64::Reg::RCX, x64::Reg::RDX, (8 * (1 + at + owners[owner])) as i64)
                    owner += 2
                }
                binding += 3
            }
            when aggregate {
                when !self.push_value(asm, record.body, ty) {
                    return false
                }
            } else {
                when !self.expr(asm, record.body) {
                    return false
                }
            }
            asm.push(x64::Reg::RAX)
            mut remaining: u64 = record.bindings.len()
            while remaining > 0 {
                remaining -= 3
                self.drop_slot(asm, record.bindings[remaining], record.bindings[remaining + 1])
            }
            when self.temporary_type(value).is_some() {
                asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, slot_disp(held))
                asm.call_label(self.handle_drop_routine(asm, self.temporary_type(value).unwrap()))
            }
            asm.pop(x64::Reg::RAX)
            asm.jmp(end)
            asm.bind(next)
        }
        asm.trap()
        asm.bind(end)
        return true
    }

    // An `if` whose value is a string or a structure: the chosen branch is pushed as its cells.
    fun push_if(mut self, asm: &mut x64::Asm, condition: u64, then_value: u64, else_value: u64, ty: u64) -> bool {
        when !self.expr(asm, condition) {
            return false
        }
        otherwise := asm.new_label()
        end := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, otherwise)
        when !self.push_value(asm, then_value, ty) {
            return false
        }
        asm.jmp(end)
        asm.bind(otherwise)
        when !self.push_value(asm, else_value, ty) {
            return false
        }
        asm.bind(end)
        return true
    }

    // The value of a match, an `if` or a field, of a type that takes several cells, stored into the cells from `base` on: it is
    // pushed by the code for arguments and then moved.
    fun store_aggregate_result(mut self, asm: &mut x64::Asm, value: u64, base: u64, count: u64, ty: u64) -> bool {
        when !self.push_value(asm, value, ty) {
            return false
        }
        return self.store_pushed(asm, base, count)
    }

    // Moves the `count` cells that were just pushed into the cells from `base` on, and removes them.
    fun store_pushed(mut self, asm: &mut x64::Asm, base: u64, count: u64) -> bool {
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + cell))
            cell += 1
        }
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    // A structure that is a field of another structure value: the outer one is pushed, and the field's cells are moved up to
    // take its place on the stack.
    fun push_field_struct(mut self, asm: &mut x64::Asm, outer: u64, outer_id: u64, field: u64, inner_id: u64) -> bool {
        when !self.push_structure(asm, outer, outer_id) {
            return false
        }
        total := self.program.structs[outer_id].slot_count
        count := self.program.structs[inner_id].slot_count
        offset := self.program.structs[outer_id].fields[field].slot_offset
        saved := self.scratch(count)
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (total - 1 - offset - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(saved + cell))
            cell += 1
        }
        owners := self.owner_pairs(self.struct_type(inner_id))
        mut at: u64 = 0
        while at < owners.len() {
            asm.mov_ri(x64::Reg::RAX, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, (8 * (total - 1 - offset - owners[at])) as i64)
            at += 2
        }
        asm.lea(x64::Reg::RDI, x64::Reg::RSP, (8 * (total - 1)) as i64)
        asm.call_label(self.value_drop_routine(asm, self.struct_type(outer_id), false))
        asm.alu_ri(0, x64::Reg::RSP, (8 * total) as i64)
        when !self.push_local_cells(asm, saved, count) { return false }
        return true
    }

    // `vec[index]`: the index is checked against the length, and an index past it is a runtime error.
    // Writes a message and a newline to standard error and exits with status 1, as the runtime does for a failed check.
    fun fail_exit(mut self, asm: &mut x64::Asm, text: String) {
        index := self.literal(text)
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[index])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[index])
        asm.mov_ri(x64::Reg::RDI, 2)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RAX, 231)
        asm.syscall()
    }

    // The capacity of a vector after it grows, from the capacity in rax: 4 when it was empty, and double otherwise.
    fun grow_capacity(self, asm: &mut x64::Asm) {
        doubled := asm.new_label()
        grown := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::NOT_EQUAL, doubled)
        asm.mov_ri(x64::Reg::RAX, 4)
        asm.jmp(grown)
        asm.bind(doubled)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RAX)
        asm.bind(grown)
    }

    // `set(index, value)`: the element at index is replaced; an index past the length fails.
    fun vec_set(mut self, asm: &mut x64::Asm, element: u64, vec: u64, index: u64, value: u64) -> bool {
        cells := self.cells_of(element)
        when !self.expr(asm, vec) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, index) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.push_value(asm, value, element) {
            return false
        }
        // The value's cells are on top, then the index, then the header.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * (cells + 1)) as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, (8 * cells) as i64)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDI)
        in_range := asm.new_label()
        asm.jcc(x64::Cc::BELOW, in_range)
        self.fail_exit(asm, String("Ryn runtime error: Vec index is out of bounds\n"))
        asm.bind(in_range)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::R8, 8 * cells)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::RDI)
        when self.has_owners(element) {
            asm.push(x64::Reg::R8)
            asm.lea(x64::Reg::RDI, x64::Reg::R8, (8 * (cells - 1)) as i64)
            asm.call_label(self.value_drop_routine(asm, element, false))
            asm.pop(x64::Reg::R8)
        }
        self.copy_block(asm, x64::Reg::RSP, x64::Reg::R8, cells)
        asm.alu_ri(0, x64::Reg::RSP, (8 * (cells + 2)) as i64)
        return true
    }

    // `take(index)`: the element at index is removed, the elements after it move down one, and the element is the value. A
    // structure is left on the stack as its cells, as a call returns it.
    fun vec_take(mut self, asm: &mut x64::Asm, element: u64, vec: u64, index: u64) -> bool {
        cells := self.cells_of(element)
        when !self.expr(asm, vec) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, index) {
            return false
        }
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDI)
        in_range := asm.new_label()
        asm.jcc(x64::Cc::BELOW, in_range)
        self.fail_exit(asm, String("Ryn runtime error: Vec index is out of bounds\n"))
        asm.bind(in_range)
        // r8 is the element's address, r10 the bytes of the elements after it, and the length drops by one.
        asm.mov_rr(x64::Reg::R8, x64::Reg::RAX)
        self.scale_bytes(asm, x64::Reg::R8, 8 * cells)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDX, 0)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R9)
        asm.mov_rr(x64::Reg::R10, x64::Reg::RDI)
        asm.alu_rr(41, x64::Reg::R10, x64::Reg::RAX)
        asm.alu_ri(5, x64::Reg::R10, 1)
        self.scale_bytes(asm, x64::Reg::R10, 8 * cells)
        asm.alu_ri(5, x64::Reg::RDI, 1)
        asm.store(8, x64::Reg::RDI, x64::Reg::RDX, 8)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        // The element is copied to the stack, and the elements after it move down over it.
        asm.alu_ri(5, x64::Reg::RSP, (8 * cells) as i64)
        self.copy_block(asm, x64::Reg::R8, x64::Reg::RSP, cells)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::R8)
        asm.lea(x64::Reg::RSI, x64::Reg::R8, (8 * cells) as i64)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::R10)
        self.aligned_call(asm, String("memmove"))
        when self.is_cell(element) {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
            asm.alu_ri(0, x64::Reg::RSP, 8)
        }
        return true
    }

    // `insert(index, value)`: the elements from index on move up one, and the value takes index; an index past the
    // length fails, and a full vector grows first.
    fun vec_insert(mut self, asm: &mut x64::Asm, element: u64, vec: u64, index: u64, value: u64) -> bool {
        cells := self.cells_of(element)
        when !self.expr(asm, vec) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, index) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.push_value(asm, value, element) {
            return false
        }
        // The value's cells are on top, then the index, then the header.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * (cells + 1)) as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, (8 * cells) as i64)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDI)
        in_range := asm.new_label()
        asm.jcc(x64::Cc::BELOW_EQUAL, in_range)
        self.fail_exit(asm, String("Ryn runtime error: Vec insert index is out of bounds\n"))
        asm.bind(in_range)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RDX, 16)
        room := asm.new_label()
        asm.alu_rr(57, x64::Reg::RDI, x64::Reg::RAX)
        asm.jcc(x64::Cc::BELOW, room)
        self.grow_capacity(asm)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 16)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RAX)
        self.scale_bytes(asm, x64::Reg::RSI, 8 * cells)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        self.aligned_call(asm, String("realloc"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * (cells + 1)) as i64)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.bind(room)
        // The elements from the index on move up one element: memmove(at + bytes, at, (len - index) * bytes), where `at` is
        // the element at the index. The length grows by one.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * (cells + 1)) as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, (8 * cells) as i64)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 8)
        asm.mov_rr(x64::Reg::R10, x64::Reg::RDI)
        asm.alu_rr(41, x64::Reg::R10, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::R10, 8 * cells)
        asm.alu_ri(0, x64::Reg::RDI, 1)
        asm.store(8, x64::Reg::RDI, x64::Reg::RDX, 8)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::R8, 8 * cells)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDX, 0)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R9)
        asm.lea(x64::Reg::RDI, x64::Reg::R8, (8 * cells) as i64)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::R8)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::R10)
        self.aligned_call(asm, String("memmove"))
        // The value's cells go to `at`, found again because the call clobbered the registers.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * (cells + 1)) as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, (8 * cells) as i64)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::R8, 8 * cells)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDX, 0)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R9)
        self.copy_block(asm, x64::Reg::RSP, x64::Reg::R8, cells)
        asm.alu_ri(0, x64::Reg::RSP, (8 * (cells + 2)) as i64)
        return true
    }

    // `vec[index]`: the element is at data + index * bytes. A scalar is its value; a structure is pushed as its cells, as a
    // call returns it.
    fun vec_index(mut self, asm: &mut x64::Asm, element: u64, vec: u64, index: u64) -> bool {
        cells := self.cells_of(element)
        when !self.expr(asm, vec) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, index) {
            return false
        }
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        self.scale_bytes(asm, x64::Reg::RAX, 8 * cells)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        owned := self.owned_cells(element)
        mut copies: Vec<u64> = Vec()
        when owned.is_some() {
            copies = owned.unwrap()
        }
        when self.is_cell(element) {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSI, 0)
            // A String, vector or enum element is copied with what it owns, as the runtime's indexing copies it: the value
            // read must not share memory with the vector.
            when copies.len() == 3 {
                asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
                asm.call_label(self.copy_routine(asm, copies[1], copies[2]))
            }
            return true
        }
        asm.alu_ri(5, x64::Reg::RSP, (8 * cells) as i64)
        self.copy_block(asm, x64::Reg::RSI, x64::Reg::RSP, cells)
        mut at: u64 = 0
        while at < copies.len() {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, copies[at] as i64)
            asm.call_label(self.copy_routine(asm, copies[at + 1], copies[at + 2]))
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, copies[at] as i64)
            at += 3
        }
        return true
    }

    // The label of the routine that copies a value that owns memory: code 1 a String, 2 a vector (of `ty`), 3 an enum (`ty`).
    fun copy_routine(mut self, asm: &mut x64::Asm, code: u64, ty: u64) -> u64 {
        when code == 2 {
            return self.vec_routine(asm, ty)
        }
        when code == 3 {
            return self.enum_routine(asm, self.enum_id_of(ty))
        }
        when code == 4 {
            key := choose self.program.types[ty] { ir::IrTy::MapOf(k, v) => k, ir::IrTy::SetOf(k, v) => k, _ => 0 }
            value := choose self.program.types[ty] { ir::IrTy::MapOf(k, v) => v, ir::IrTy::SetOf(k, v) => v, _ => 0 }
            when self.is_string(key) && self.is_string(value) { return self.map_clone_both_text }
            when self.is_string(key) { return self.map_clone_key_text }
            when self.is_string(value) { return self.map_clone_value_text }
            return self.map_clone_plain
        }
        return self.string_clone_label
    }

    // Whether a type is a float: `f32` or `f64`, held as its IEEE bits in a cell.
    fun is_float(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => word == "F32" || word == "F64",
            _ => false,
        }
    }

    // The top bit of a float's width, which negation flips.
    fun float_sign_bit(self, ty: u64) -> u64 {
        when self.word(ty) == "F64" {
            return 9223372036854775808 as u64
        }
        return 2147483648 as u64
    }

    // A float literal: its f64 bits, narrowed to single precision for `f32`.
    fun float_literal(mut self, asm: &mut x64::Asm, bits: u64, ty: u64) -> bool {
        asm.mov_ri(x64::Reg::RAX, bits)
        when self.word(ty) == "F32" {
            asm.movq_to_xmm(true, 0, x64::Reg::RAX)
            asm.cvt_precision(8, 0, 0)
            asm.movq_from_xmm(false, x64::Reg::RAX, 0)
        }
        return true
    }

    // `a op b` of floats: the operands are in xmm0 and xmm1, and an ordered comparison is false for a NaN, as in Rust.
    fun float_binary(mut self, asm: &mut x64::Asm, op: String, left: u64, right: u64, ty: u64) -> bool {
        mut precision: u64 = 4
        when self.word(ty) == "F64" {
            precision = 8
        }
        wide := precision == 8
        when !self.expr(asm, left) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, right) {
            return false
        }
        asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
        asm.pop(x64::Reg::RAX)
        asm.movq_to_xmm(wide, 0, x64::Reg::RAX)
        asm.movq_to_xmm(wide, 1, x64::Reg::RCX)
        when op == "Add" || op == "Sub" || op == "Mul" || op == "Div" {
            mut opcode: u64 = 88
            when op == "Sub" {
                opcode = 92
            }
            when op == "Mul" {
                opcode = 89
            }
            when op == "Div" {
                opcode = 94
            }
            asm.sse_op(precision, opcode, 0, 1)
            asm.movq_from_xmm(wide, x64::Reg::RAX, 0)
            return true
        }
        when op == "Lt" {
            asm.ucomis(precision, 1, 0)
            asm.setcc(x64::Cc::ABOVE, x64::Reg::RAX)
            return true
        }
        when op == "Le" {
            asm.ucomis(precision, 1, 0)
            asm.setcc(x64::Cc::ABOVE_EQUAL, x64::Reg::RAX)
            return true
        }
        when op == "Gt" {
            asm.ucomis(precision, 0, 1)
            asm.setcc(x64::Cc::ABOVE, x64::Reg::RAX)
            return true
        }
        when op == "Ge" {
            asm.ucomis(precision, 0, 1)
            asm.setcc(x64::Cc::ABOVE_EQUAL, x64::Reg::RAX)
            return true
        }
        when op == "Eq" || op == "Ne" {
            // Equal when the comparison sets zero and not the unordered flag.
            asm.ucomis(precision, 0, 1)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            asm.setcc(x64::Cc::NOT_PARITY, x64::Reg::RCX)
            asm.alu_rr(33, x64::Reg::RAX, x64::Reg::RCX)
            when op == "Ne" {
                asm.alu_ri(6, x64::Reg::RAX, 1)
            }
            return true
        }
        return self.fail("an operator on this type")
    }

    // A conversion to a float: from a float of the other width, or from a signed integer (an unsigned 64-bit value does
    // not fit the signed conversion, and is declined).
    fun float_cast(mut self, asm: &mut x64::Asm, value: u64, source: u64, target: u64) -> bool {
        mut target_precision: u64 = 4
        when self.word(target) == "F64" {
            target_precision = 8
        }
        when self.is_float(source) {
            mut source_precision: u64 = 4
            when self.word(source) == "F64" {
                source_precision = 8
            }
            when !self.expr(asm, value) {
                return false
            }
            when source_precision != target_precision {
                asm.movq_to_xmm(source_precision == 8, 0, x64::Reg::RAX)
                asm.cvt_precision(source_precision, 0, 0)
                asm.movq_from_xmm(target_precision == 8, x64::Reg::RAX, 0)
            }
            return true
        }
        when is_integer_word(self.word(source)) && self.word(source) != "U64" {
            when !self.expr(asm, value) {
                return false
            }
            asm.cvt_from_int(target_precision, 0, x64::Reg::RAX)
            asm.movq_from_xmm(target_precision == 8, x64::Reg::RAX, 0)
            return true
        }
        when self.word(source) == "U64" {
            when !self.expr(asm, value) {
                return false
            }
            // A value with the top bit set does not fit the signed conversion: it is halved, keeping the lowest bit so
            // that the rounding is right, converted, and doubled.
            simple := asm.new_label()
            done := asm.new_label()
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::GREATER_EQUAL, simple)
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.mov_ri(x64::Reg::RCX, 1)
            asm.shift_cl(5, x64::Reg::RAX)
            asm.alu_ri(4, x64::Reg::RDX, 1)
            asm.alu_rr(9, x64::Reg::RAX, x64::Reg::RDX)
            asm.cvt_from_int(target_precision, 0, x64::Reg::RAX)
            asm.sse_op(target_precision, 88, 0, 0)
            asm.jmp(done)
            asm.bind(simple)
            asm.cvt_from_int(target_precision, 0, x64::Reg::RAX)
            asm.bind(done)
            asm.movq_from_xmm(target_precision == 8, x64::Reg::RAX, 0)
            return true
        }
        return self.fail("a conversion to a float from this type")
    }

    // The bits of the double 2^`power`, negated when `negative`.
    fun power_of_two_bits(self, power: u64, negative: bool) -> u64 {
        mut bits: u64 = (1023 + power) << (52 as u32)
        when negative {
            bits = bits | ((1 as u64) << 63)
        }
        return bits
    }

    // A float converted to an integer type as Rust's `as` does: the fraction is dropped, a value past the range gives the
    // nearest end of the range, and NaN gives zero. The value is held as a double (a single is widened, which is exact),
    // and compared with the ends of the range, which are powers of two, before the truncating conversion runs.
    fun float_to_integer(mut self, asm: &mut x64::Asm, value: u64, source: u64, target: u64) -> bool {
        word := self.word(target)
        when !is_integer_word(word.clone()) {
            return self.fail("a conversion from a float to this type")
        }
        when !self.expr(asm, value) {
            return false
        }
        when self.word(source) == "F32" {
            asm.movq_to_xmm(false, 0, x64::Reg::RAX)
            asm.cvt_precision(4, 0, 0)
        } else {
            asm.movq_to_xmm(true, 0, x64::Reg::RAX)
        }
        width := width_of(word.clone()) * 8
        done := asm.new_label()
        not_a_number := asm.new_label()
        high := asm.new_label()
        low := asm.new_label()
        asm.ucomis(8, 0, 0)
        asm.jcc(x64::Cc::PARITY, not_a_number)
        when is_signed_word(word.clone()) {
            asm.mov_ri(x64::Reg::RAX, self.power_of_two_bits(width - 1, false))
            asm.movq_to_xmm(true, 1, x64::Reg::RAX)
            asm.ucomis(8, 0, 1)
            asm.jcc(x64::Cc::ABOVE_EQUAL, high)
            asm.mov_ri(x64::Reg::RAX, self.power_of_two_bits(width - 1, true))
            asm.movq_to_xmm(true, 1, x64::Reg::RAX)
            asm.ucomis(8, 0, 1)
            asm.jcc(x64::Cc::BELOW_EQUAL, low)
            asm.cvt_to_int(8, x64::Reg::RAX, 0)
            asm.jmp(done)
            asm.bind(high)
            asm.mov_ri(x64::Reg::RAX, ((1 as u64) << ((width - 1) as u32)) - 1)
            asm.jmp(done)
            asm.bind(low)
            asm.mov_ri(x64::Reg::RAX, (0 as u64) - ((1 as u64) << ((width - 1) as u32)))
            asm.jmp(done)
        } else {
            // Negative values, and the fractions between -1 and 0, give zero; the top is the largest value of the type.
            asm.mov_ri(x64::Reg::RAX, 0)
            asm.movq_to_xmm(true, 1, x64::Reg::RAX)
            asm.ucomis(8, 0, 1)
            asm.jcc(x64::Cc::BELOW, not_a_number)
            asm.mov_ri(x64::Reg::RAX, self.power_of_two_bits(width, false))
            asm.movq_to_xmm(true, 1, x64::Reg::RAX)
            asm.ucomis(8, 0, 1)
            asm.jcc(x64::Cc::ABOVE_EQUAL, high)
            when width == 64 {
                // Past 2^63 the signed conversion overflows: convert the excess over 2^63, and add 2^63 back.
                small := asm.new_label()
                asm.mov_ri(x64::Reg::RAX, self.power_of_two_bits(63, false))
                asm.movq_to_xmm(true, 1, x64::Reg::RAX)
                asm.ucomis(8, 0, 1)
                asm.jcc(x64::Cc::BELOW, small)
                asm.sse_op(8, 92, 0, 1)
                asm.cvt_to_int(8, x64::Reg::RAX, 0)
                asm.mov_ri(x64::Reg::RCX, (1 as u64) << 63)
                asm.alu_rr(49, x64::Reg::RAX, x64::Reg::RCX)
                asm.jmp(done)
                asm.bind(small)
            }
            asm.cvt_to_int(8, x64::Reg::RAX, 0)
            asm.jmp(done)
            asm.bind(high)
            when width == 64 {
                asm.mov_ri(x64::Reg::RAX, (0 as u64) - 1)
            } else {
                asm.mov_ri(x64::Reg::RAX, ((1 as u64) << (width as u32)) - 1)
            }
            asm.jmp(done)
            asm.bind(low)
        }
        asm.bind(not_a_number)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `String(text)` for a str: the header {data, len, capacity} from malloc, and the data, a copy of the text from malloc.
    fun string_op(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        when op == "Len" || op == "CharCount" {
            return self.string_query(asm, op, arguments)
        }
        when op == "Clone" && arguments.len() == 1 {
            return self.string_clone(asm, arguments[0])
        }
        when op == "AppendStr" && arguments.len() == 2 {
            return self.string_append(asm, arguments[0], arguments[1], false)
        }
        when op == "Push" && arguments.len() == 2 {
            return self.string_push(asm, arguments[0], arguments[1])
        }
        when op == "AppendString" && arguments.len() == 2 {
            return self.string_append(asm, arguments[0], arguments[1], true)
        }
        when op == "IsEmpty" && arguments.len() == 1 {
            when !self.text_parts(asm, arguments[0], true) {
                return false
            }
            asm.test_rr(x64::Reg::RDX, x64::Reg::RDX)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            return true
        }
        when op == "StartsWithStr" && arguments.len() == 2 {
            return self.string_starts_with(asm, arguments[0], arguments[1], false)
        }
        when op == "StartsWithString" && arguments.len() == 2 {
            return self.string_starts_with(asm, arguments[0], arguments[1], true)
        }
        when op == "Slice" && arguments.len() == 3 {
            return self.string_slice(asm, arguments[0], arguments[1], arguments[2])
        }
        when op == "TryParse" && arguments.len() == 2 {
            return self.string_try_parse(asm, arguments[0], arguments[1])
        }
        when op == "ConcatString" && arguments.len() == 2 {
            return self.string_concat(asm, arguments[0], arguments[1])
        }
        when op == "ConcatStr" && arguments.len() == 2 {
            return self.string_concat_text(asm, arguments[0], arguments[1])
        }
        when op == "SplitStr" && arguments.len() == 2 {
            return self.string_split(asm, arguments[0], arguments[1], false)
        }
        when op == "SplitString" && arguments.len() == 2 {
            return self.string_split(asm, arguments[0], arguments[1], true)
        }
        when op == "ContainsStr" && arguments.len() == 2 {
            return self.string_search(asm, arguments[0], arguments[1], false, false)
        }
        when op == "ContainsString" && arguments.len() == 2 {
            return self.string_search(asm, arguments[0], arguments[1], true, false)
        }
        when op == "EndsWithStr" && arguments.len() == 2 {
            return self.string_search(asm, arguments[0], arguments[1], false, true)
        }
        when op == "EndsWithString" && arguments.len() == 2 {
            return self.string_search(asm, arguments[0], arguments[1], true, true)
        }
        when op == "CharAt" && arguments.len() == 2 {
            return self.string_char_at(asm, arguments[0], arguments[1], String("Ryn runtime error: String character index is out of bounds\n"))
        }
        when (op == "FromI8" || op == "FromI16" || op == "FromI32" || op == "FromI64") && arguments.len() == 1 {
            return self.string_from_integer(asm, arguments[0], true)
        }
        when (op == "FromU8" || op == "FromU16" || op == "FromU32" || op == "FromU64") && arguments.len() == 1 {
            return self.string_from_integer(asm, arguments[0], false)
        }
        when (op == "FromF32" || op == "FromF64") && arguments.len() == 1 {
            return self.string_from_float(asm, arguments[0], op == "FromF32")
        }
        when (op == "Trim" || op == "TrimStart" || op == "TrimEnd") && arguments.len() == 1 {
            return self.string_trim(asm, arguments[0], op)
        }
        when op == "Reverse" && arguments.len() == 1 {
            when !self.text_parts(asm, arguments[0], true) {
                return false
            }
            self.textops_used = self.textops_used | 8
            asm.call_label(self.reverse_label)
            return self.string_from_parts(asm)
        }
        when (op == "ToLower" || op == "ToUpper") && arguments.len() == 1 {
            return self.string_case(asm, arguments[0], op == "ToUpper")
        }
        when (op == "FindStr" || op == "FindString") && arguments.len() == 2 {
            return self.string_find(asm, arguments[0], arguments[1], op == "FindString")
        }
        when op == "ReplaceStr" && arguments.len() == 3 {
            return self.string_replace(asm, arguments[0], arguments[1], arguments[2])
        }
        when op == "CharFromU32" && arguments.len() == 1 {
            // The value must be a Unicode scalar value: below 0x110000 and not a surrogate.
            when !self.expr(asm, arguments[0]) {
                return false
            }
            valid := asm.new_label()
            invalid := asm.new_label()
            asm.alu_ri(7, x64::Reg::RAX, 1114112)
            asm.jcc(x64::Cc::ABOVE_EQUAL, invalid)
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.alu_ri(5, x64::Reg::RCX, 55296)
            asm.alu_ri(7, x64::Reg::RCX, 2047)
            asm.jcc(x64::Cc::ABOVE, valid)
            asm.bind(invalid)
            self.fail_exit(asm, String("Ryn runtime error: integer is not a valid Unicode scalar value\n"))
            asm.bind(valid)
            return true
        }
        when op == "ByteAt" && arguments.len() == 2 {
            return self.string_byte_at(asm, arguments[0], arguments[1])
        }
        when op == "SliceChars" && arguments.len() == 3 {
            return self.string_slice_chars(asm, arguments[0], arguments[1], arguments[2])
        }
        when op == "StrCharAt" && arguments.len() == 2 {
            return self.string_char_at(asm, arguments[0], arguments[1], String("Ryn runtime error: str character index is out of bounds\n"))
        }
        when op != "New" || arguments.len() != 1 {
            return self.op_fail("a string operation ", op)
        }
        when !self.load_string_parts(asm, arguments[0]) {
            return false
        }
        return self.string_from_parts(asm)
    }

    // A new String with the text in rsi and rdx: its bytes are copied, and its header is left in rax.
    fun string_from_parts(mut self, asm: &mut x64::Asm) -> bool {
        // The source and its length stay on the stack while the allocations run.
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RDX)
        self.aligned_call(asm, String("malloc"))
        asm.push(x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("memcpy"))
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        return true
    }

    // Whether a text is a choice between two string literals, as `bool` is when it is printed.
    fun is_text_choice(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => self.string_literal(then_value).is_some() && self.string_literal(else_value).is_some(),
            _ => false,
        }
    }

    // The text of a choice between two string literals: the condition picks the literal, whose data and length go to rsi
    // and rdx.
    fun text_choice(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        condition := choose self.program.exprs[index] {
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => condition,
            _ => 0,
        }
        then_value := choose self.program.exprs[index] {
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => then_value,
            _ => 0,
        }
        else_value := choose self.program.exprs[index] {
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => else_value,
            _ => 0,
        }
        when !self.expr(asm, condition) {
            return false
        }
        otherwise := asm.new_label()
        end := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, otherwise)
        text := self.literal(self.string_literal(then_value).unwrap())
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[text])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[text])
        asm.jmp(end)
        asm.bind(otherwise)
        other := self.literal(self.string_literal(else_value).unwrap())
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[other])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[other])
        asm.bind(end)
        return true
    }

    // The routines of the Map representation, emitted once. A header is {buckets, bucket count, length, sequence}; a node
    // is {next, hash, key cell, value cell, sequence}. The hash of a key cell in rsi is left in rax; the node for the key
    // rsi in the map header rdi is left in rax, or 0; and the buckets of the header rdi are doubled.
    fun map_routines(mut self, asm: &mut x64::Asm) {
        // FNV-1a over the eight bytes of a scalar key.
        asm.bind(self.map_hash_scalar)
        asm.mov_ri(x64::Reg::RAX, 14695981039346656037 as u64)
        mut byte: u64 = 0
        while byte < 8 {
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RSI)
            asm.mov_ri(x64::Reg::RCX, byte * 8)
            asm.shift_cl(5, x64::Reg::RDX)
            asm.alu_ri(4, x64::Reg::RDX, 255)
            asm.alu_rr(49, x64::Reg::RAX, x64::Reg::RDX)
            asm.mov_ri(x64::Reg::RDX, 1099511628211)
            asm.imul_rr(x64::Reg::RAX, x64::Reg::RDX)
            byte += 1
        }
        asm.ret()
        // FNV-1a over the bytes of a String key, whose header is in rsi.
        asm.bind(self.map_hash_string)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RSI, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSI, 8)
        asm.mov_ri(x64::Reg::RAX, 14695981039346656037 as u64)
        hashing := asm.new_label()
        hashed := asm.new_label()
        asm.bind(hashing)
        asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
        asm.jcc(x64::Cc::EQUAL, hashed)
        asm.load(1, false, x64::Reg::RDX, x64::Reg::R9, 0)
        asm.alu_rr(49, x64::Reg::RAX, x64::Reg::RDX)
        asm.mov_ri(x64::Reg::RDX, 1099511628211)
        asm.imul_rr(x64::Reg::RAX, x64::Reg::RDX)
        asm.alu_ri(0, x64::Reg::R9, 1)
        asm.alu_ri(5, x64::Reg::RCX, 1)
        asm.jmp(hashing)
        asm.bind(hashed)
        asm.ret()
        self.string_clone_routine(asm)
        self.map_clone_routine(asm, self.map_clone_plain, false, false)
        self.map_clone_routine(asm, self.map_clone_key_text, true, false)
        self.map_clone_routine(asm, self.map_clone_value_text, false, true)
        self.map_clone_routine(asm, self.map_clone_both_text, true, true)
        asm.bind(self.string_less_label)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSI, 8)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDI, 0)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RSI, 0)
        asm.mov_rr(x64::Reg::R10, x64::Reg::RCX)
        shorter := asm.new_label()
        asm.alu_rr(57, x64::Reg::R10, x64::Reg::RDX)
        asm.jcc(x64::Cc::BELOW_EQUAL, shorter)
        asm.mov_rr(x64::Reg::R10, x64::Reg::RDX)
        asm.bind(shorter)
        asm.mov_ri(x64::Reg::R11, 0)
        common := asm.new_label()
        differ := asm.new_label()
        prefix := asm.new_label()
        asm.bind(common)
        asm.alu_rr(57, x64::Reg::R11, x64::Reg::R10)
        asm.jcc(x64::Cc::ABOVE_EQUAL, prefix)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::R8)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::R11)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::RAX, 0)
        asm.mov_rr(x64::Reg::RCX, x64::Reg::R9)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::R11)
        asm.load(1, false, x64::Reg::RDX, x64::Reg::RCX, 0)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDX)
        asm.jcc(x64::Cc::NOT_EQUAL, differ)
        asm.alu_ri(0, x64::Reg::R11, 1)
        asm.jmp(common)
        asm.bind(differ)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDX)
        asm.setcc(x64::Cc::BELOW, x64::Reg::RAX)
        asm.ret()
        asm.bind(prefix)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSI, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        asm.setcc(x64::Cc::BELOW, x64::Reg::RAX)
        asm.ret()
        self.map_find_routine(asm, self.map_find_scalar, self.map_hash_scalar, false)
        self.map_find_routine(asm, self.map_find_string, self.map_hash_string, true)
        // Doubling: the buckets become twice as many, and every node moves to its bucket in the new array.
        asm.bind(self.map_grow)
        asm.push(x64::Reg::RDI)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RDI, 8)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RAX)
        asm.push(x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RSI, 8)
        self.aligned_call(asm, String("calloc"))
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 0)
        asm.mov_ri(x64::Reg::R9, 0)
        each := asm.new_label()
        each_done := asm.new_label()
        chain := asm.new_label()
        chained := asm.new_label()
        asm.bind(each)
        asm.alu_rr(57, x64::Reg::R9, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, each_done)
        asm.mov_rr(x64::Reg::R11, x64::Reg::R9)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R11)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R11)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R11)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(8, false, x64::Reg::R11, x64::Reg::R11, 0)
        asm.bind(chain)
        asm.test_rr(x64::Reg::R11, x64::Reg::R11)
        asm.jcc(x64::Cc::EQUAL, chained)
        asm.load(8, false, x64::Reg::R10, x64::Reg::R11, 0)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::R11, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.alu_ri(5, x64::Reg::RDX, 1)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.alu_rr(33, x64::Reg::RDI, x64::Reg::RDX)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RDI)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RDI)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RDI)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RDI, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::R11, 0)
        asm.store(8, x64::Reg::R11, x64::Reg::RDI, 0)
        asm.mov_rr(x64::Reg::R11, x64::Reg::R10)
        asm.jmp(chain)
        asm.bind(chained)
        asm.alu_ri(0, x64::Reg::R9, 1)
        asm.jmp(each)
        asm.bind(each_done)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.ret()
    }

    // Three doublings: the value in the register is multiplied by eight.
    fun scale8(self, asm: &mut x64::Asm, reg: u64) {
        asm.alu_rr(1, reg, reg)
        asm.alu_rr(1, reg, reg)
        asm.alu_rr(1, reg, reg)
    }

    // `contains(value)` of a vector of plain cells: the elements are scanned in order, a String equal when neither is
    // less than the other, and a scalar equal when its word is. The frame holds the index, the value and the vector.
    fun vec_contains(mut self, asm: &mut x64::Asm, element: u64, vec: u64, value: u64) -> bool {
        text := self.is_string(element)
        when !self.expr(asm, vec) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, value) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.alu_ri(5, x64::Reg::RSP, 8)
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 0)
        scan := asm.new_label()
        next := asm.new_label()
        found := asm.new_label()
        missing := asm.new_label()
        done := asm.new_label()
        asm.bind(scan)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RSI)
        asm.jcc(x64::Cc::ABOVE_EQUAL, missing)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        self.scale8(asm, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RAX, 0)
        when text {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
            asm.mov_rr(x64::Reg::RSI, x64::Reg::R8)
            asm.call_label(self.string_less_label)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::NOT_EQUAL, next)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
            self.scale8(asm, x64::Reg::RAX)
            asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RSI)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
            asm.call_label(self.string_less_label)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::NOT_EQUAL, next)
            asm.jmp(found)
        }
        when !text {
            asm.load(8, false, x64::Reg::R9, x64::Reg::RSP, 8)
            asm.alu_rr(57, x64::Reg::R8, x64::Reg::R9)
            asm.jcc(x64::Cc::EQUAL, found)
        }
        asm.bind(next)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.jmp(scan)
        asm.bind(found)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.jmp(done)
        asm.bind(missing)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.bind(done)
        return true
    }

    // `sort()` of a vector of plain cells: an insertion sort, which is stable as the Rust sort is. A String is compared by
    // its bytes, and a scalar by its value, signed or unsigned as its type is. The frame holds the header, the index i,
    // the index j, and the key being placed.
    fun vec_sort(mut self, asm: &mut x64::Asm, element: u64, vec: u64) -> bool {
        text := self.is_string(element)
        signed := choose self.program.types[element] {
            ir::IrTy::Scalar(word) => is_signed_word(word),
            _ => false,
        }
        when !self.expr(asm, vec) {
            return false
        }
        asm.alu_ri(5, x64::Reg::RSP, 48)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.mov_ri(x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 8)
        outer := asm.new_label()
        done := asm.new_label()
        asm.bind(outer)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RSI)
        asm.jcc(x64::Cc::ABOVE_EQUAL, done)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        self.scale8(asm, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::R8, x64::Reg::RSP, 24)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 16)
        inner := asm.new_label()
        place := asm.new_label()
        asm.bind(inner)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
        asm.jcc(x64::Cc::EQUAL, place)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        asm.alu_ri(5, x64::Reg::RAX, 1)
        self.scale8(asm, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RSP, 24)
        // The key moves before the previous element only when it is less.
        when text {
            asm.mov_rr(x64::Reg::RDI, x64::Reg::R8)
            asm.mov_rr(x64::Reg::RSI, x64::Reg::R10)
            asm.call_label(self.string_less_label)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::EQUAL, place)
        }
        when !text {
            asm.alu_rr(57, x64::Reg::R8, x64::Reg::R10)
            when signed {
                asm.jcc(x64::Cc::GREATER_EQUAL, place)
            }
            when !signed {
                asm.jcc(x64::Cc::ABOVE_EQUAL, place)
            }
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        self.scale8(asm, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RAX, -8)
        asm.store(8, x64::Reg::R10, x64::Reg::RAX, 0)
        asm.alu_ri(5, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.jmp(inner)
        asm.bind(place)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        self.scale8(asm, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RSP, 24)
        asm.store(8, x64::Reg::R8, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.jmp(outer)
        asm.bind(done)
        asm.alu_ri(0, x64::Reg::RSP, 48)
        return true
    }

    // A lookup routine for one kind of key: the bucket of the key's hash is scanned for a node with that hash whose key
    // is equal, a String key comparing by its bytes and a scalar key by its word.
    fun map_find_routine(mut self, asm: &mut x64::Asm, label: u64, hash: u64, text: bool) {
        asm.bind(label)
        asm.call_label(hash)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RDI, 8)
        asm.alu_ri(5, x64::Reg::R10, 1)
        asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
        asm.alu_rr(33, x64::Reg::RCX, x64::Reg::R10)
        asm.load(8, false, x64::Reg::R11, x64::Reg::RDI, 0)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RCX)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RDX)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RDX)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RDX)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::R11)
        asm.load(8, false, x64::Reg::R11, x64::Reg::RDX, 0)
        next := asm.new_label()
        top := asm.new_label()
        miss := asm.new_label()
        hit := asm.new_label()
        out := asm.new_label()
        asm.bind(top)
        asm.test_rr(x64::Reg::R11, x64::Reg::R11)
        asm.jcc(x64::Cc::EQUAL, miss)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::R11, 8)
        asm.alu_rr(57, x64::Reg::RDX, x64::Reg::RAX)
        asm.jcc(x64::Cc::NOT_EQUAL, next)
        when text {
            asm.load(8, false, x64::Reg::RDX, x64::Reg::R11, 16)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
            asm.load(8, false, x64::Reg::R10, x64::Reg::R8, 8)
            asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R10)
            asm.jcc(x64::Cc::NOT_EQUAL, next)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::R8, 0)
            asm.load(8, false, x64::Reg::R9, x64::Reg::RDX, 0)
            bytes := asm.new_label()
            asm.bind(bytes)
            asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
            asm.jcc(x64::Cc::EQUAL, hit)
            asm.load(1, false, x64::Reg::R10, x64::Reg::RSI, 0)
            asm.load(1, false, x64::Reg::RDX, x64::Reg::R9, 0)
            asm.alu_rr(57, x64::Reg::R10, x64::Reg::RDX)
            asm.jcc(x64::Cc::NOT_EQUAL, next)
            asm.alu_ri(0, x64::Reg::RSI, 1)
            asm.alu_ri(0, x64::Reg::R9, 1)
            asm.alu_ri(5, x64::Reg::RCX, 1)
            asm.jmp(bytes)
        }
        when !text {
            asm.load(8, false, x64::Reg::RDX, x64::Reg::R11, 16)
            asm.alu_rr(57, x64::Reg::RDX, x64::Reg::R8)
            asm.jcc(x64::Cc::NOT_EQUAL, next)
            asm.jmp(hit)
        }
        asm.bind(next)
        asm.load(8, false, x64::Reg::R11, x64::Reg::R11, 0)
        asm.jmp(top)
        asm.bind(hit)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::R11)
        asm.jmp(out)
        asm.bind(miss)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.bind(out)
        asm.ret()
    }

    // The clone of the String whose header is in rdi, left in rax: a new header with a copy of the bytes.
    fun string_clone_routine(mut self, asm: &mut x64::Asm) {
        asm.bind(self.string_clone_label)
        asm.push(x64::Reg::RDI)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 8)
        self.aligned_call(asm, String("malloc"))
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RCX, 0)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
        self.aligned_call(asm, String("memcpy"))
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 16)
        asm.alu_ri(0, x64::Reg::RSP, 16)
        asm.ret()
    }

    // The clone of the map whose header is in rdi, left in rax: a new header with the same buckets count, length and
    // sequence, and a copy of every node in its bucket. A String key or value is copied as a String. The frame holds the
    // bucket index, the new buckets, the new header, the source header, the node being copied and its copy.
    fun map_clone_routine(mut self, asm: &mut x64::Asm, label: u64, text_key: bool, text_value: bool) {
        asm.bind(label)
        asm.alu_ri(5, x64::Reg::RSP, 48)
        asm.store(8, x64::Reg::RDI, x64::Reg::RSP, 24)
        asm.mov_ri(x64::Reg::RDI, 32)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RCX, 8)
        asm.mov_ri(x64::Reg::RSI, 8)
        self.aligned_call(asm, String("calloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RCX, 8)
        asm.store(8, x64::Reg::R8, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RCX, 16)
        asm.store(8, x64::Reg::R8, x64::Reg::RDX, 16)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RCX, 24)
        asm.store(8, x64::Reg::R8, x64::Reg::RDX, 24)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 0)
        outer := asm.new_label()
        inner := asm.new_label()
        next := asm.new_label()
        done := asm.new_label()
        asm.bind(outer)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::ABOVE_EQUAL, done)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        self.scale8(asm, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::R9)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.bind(inner)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, next)
        asm.mov_ri(x64::Reg::RDI, 40)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 40)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 32)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
        asm.store(8, x64::Reg::R8, x64::Reg::RCX, 8)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 32)
        asm.store(8, x64::Reg::R8, x64::Reg::RCX, 32)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 16)
        when text_key {
            asm.call_label(self.string_clone_label)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
            asm.store(8, x64::Reg::RAX, x64::Reg::RCX, 16)
        }
        when !text_key {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
            asm.store(8, x64::Reg::RDI, x64::Reg::RCX, 16)
        }
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 32)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 24)
        when text_value {
            asm.call_label(self.string_clone_label)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
            asm.store(8, x64::Reg::RAX, x64::Reg::RCX, 24)
        }
        when !text_value {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
            asm.store(8, x64::Reg::RDI, x64::Reg::RCX, 24)
        }
        // The copy goes to the front of its bucket in the new array.
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
        asm.alu_ri(5, x64::Reg::R8, 1)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RCX, 8)
        asm.alu_rr(33, x64::Reg::R9, x64::Reg::R8)
        self.scale8(asm, x64::Reg::R9)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RDX, 0)
        asm.alu_rr(1, x64::Reg::R9, x64::Reg::R10)
        asm.load(8, false, x64::Reg::R10, x64::Reg::R9, 0)
        asm.store(8, x64::Reg::R10, x64::Reg::RCX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::R9, 0)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.jmp(inner)
        asm.bind(next)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.jmp(outer)
        asm.bind(done)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 16)
        asm.alu_ri(0, x64::Reg::RSP, 48)
        asm.ret()
    }

    // The map header of a new map: no node, and the buckets as a zeroed array of eight.
    fun map_new(mut self, asm: &mut x64::Asm) -> bool {
        asm.mov_ri(x64::Reg::RDI, 32)
        self.aligned_call(asm, String("malloc"))
        asm.push(x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RDI, 8)
        asm.mov_ri(x64::Reg::RSI, 8)
        self.aligned_call(asm, String("calloc"))
        asm.pop(x64::Reg::RDX)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.mov_ri(x64::Reg::RCX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 16)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 24)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
        return true
    }

    // The Option whose payload is `value`, when the program has one.
    fun option_of(self, value: u64) -> Option<u64> {
        mut index: u64 = 0
        while index < self.program.enums.len() {
            when self.program.enums[index].name.contains("RynOption#") {
                mut variant: u64 = 0
                while variant < self.program.enums[index].variants.len() {
                    when self.program.enums[index].variants[variant].name == "Some" && self.program.enums[index].variants[variant].fields.len() == 1 && self.same_type(self.program.enums[index].variants[variant].fields[0], value) {
                        return Option::Some(index)
                    }
                    variant += 1
                }
            }
            index += 1
        }
        return Option::None
    }

    // Whether two type ids name the same type: a scalar by its word, since the IR may name it under several ids.
    fun same_type(self, a: u64, b: u64) -> bool {
        when a == b {
            return true
        }
        return choose self.program.types[a] {
            ir::IrTy::Scalar(word) => choose self.program.types[b] {
                ir::IrTy::Scalar(other) => word == other,
                _ => false,
            },
            _ => false,
        }
    }

    // A key or value of a map: a scalar or a String, one cell.
    fun map_cell(self, ty: u64) -> bool {
        return self.is_string(ty) || self.is_handle_struct(ty) || choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => string_width(word) != 0,
            _ => false,
        }
    }

    // A map operation. A key is hashed and compared by its word, or by its text for a String; the values are cells.
    fun map_op(mut self, asm: &mut x64::Asm, op: String, key: u64, value: u64, arguments: Vec<u64>) -> bool {
        self.map_value_type = value
        when !self.map_cell(key) || !self.map_cell(value) {
            return self.fail("a map of this type")
        }
        when op == "New" && arguments.len() == 0 {
            return self.map_new(asm)
        }
        when op == "Len" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 16)
            return true
        }
        when op == "IsEmpty" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 16)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            return true
        }
        when (op == "Keys" || op == "Values") && arguments.len() == 1 {
            return self.map_collect(asm, arguments[0], op == "Keys", if_text(op == "Keys", self.is_string(key), self.is_string(value)), self.is_handle_struct(value))
        }
        when op == "Clear" && arguments.len() == 1 {
            clear := asm.new_label()
            skip := asm.new_label()
            asm.jmp(skip)
            asm.bind(clear)
            when !self.emit_map_free(asm, key, value, false) { return false }
            asm.bind(skip)
            when !self.expr(asm, arguments[0]) { return false }
            asm.push(x64::Reg::RAX)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.call_label(clear)
            asm.pop(x64::Reg::RAX)
            asm.push(x64::Reg::RAX)
            asm.mov_ri(x64::Reg::RDI, 8)
            asm.mov_ri(x64::Reg::RSI, 8)
            self.aligned_call(asm, String("calloc"))
            asm.pop(x64::Reg::RDX)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
            asm.mov_ri(x64::Reg::RCX, 8)
            asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
            asm.mov_ri(x64::Reg::RCX, 0)
            asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 16)
            return true
        }
        when op == "ContainsKey" && arguments.len() == 2 {
            when !self.find_key(asm, arguments[0], arguments[1], self.is_string(key)) {
                return false
            }
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.setcc(x64::Cc::NOT_EQUAL, x64::Reg::RAX)
            return true
        }
        when op == "Insert" && arguments.len() == 3 {
            return self.map_insert(asm, arguments[0], arguments[1], arguments[2], self.is_string(key))
        }
        when op == "Get" && arguments.len() == 2 {
            return self.map_get(asm, arguments[0], arguments[1], value, self.is_string(key))
        }
        when op == "Remove" && arguments.len() == 2 {
            return self.map_remove(asm, arguments[0], arguments[1], self.is_string(key))
        }
        when op == "Clone" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            when self.is_string(key) && self.is_string(value) {
                asm.call_label(self.map_clone_both_text)
            }
            when self.is_string(key) && !self.is_string(value) {
                asm.call_label(self.map_clone_key_text)
            }
            when !self.is_string(key) && self.is_string(value) {
                asm.call_label(self.map_clone_value_text)
            }
            when !self.is_string(key) && !self.is_string(value) {
                asm.call_label(self.map_clone_plain)
            }
            return true
        }
        return self.op_fail("a map operation ", op)
    }

    // `keys()` and `values()`: a new vector of copies, in the order of the hashes of the keys (the order the runtime walks its
    // map in; keys with the same hash are in an unspecified order). The nodes are collected, sorted by hash with a shell
    // sort, and copied; a String is copied with its text.
    fun map_collect(mut self, asm: &mut x64::Asm, map: u64, keys: bool, text: bool, handle: bool) -> bool {
        when handle && !keys {
            return self.fail("the values of a map of values with destructors")
        }
        when !self.expr(asm, map) {
            return false
        }
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 64)
        // Locals: -8 map, -16 nodes, -24 count, -32 i, -40 data, -48 header, -56 j, -64 gap.
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 24)
        asm.lea(x64::Reg::RDI, x64::Reg::RCX, 1)
        self.scale_bytes(asm, x64::Reg::RDI, 8)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
        // The nodes, bucket by bucket.
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        bucket_top := asm.new_label()
        bucket_done := asm.new_label()
        chain_top := asm.new_label()
        chain_done := asm.new_label()
        asm.bind(bucket_top)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 8)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, bucket_done)
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 0)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RCX, 0)
        asm.bind(chain_top)
        asm.test_rr(x64::Reg::R8, x64::Reg::R8)
        asm.jcc(x64::Cc::EQUAL, chain_done)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        self.scale_bytes(asm, x64::Reg::R9, 8)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::R9)
        asm.store(8, x64::Reg::R8, x64::Reg::R10, 0)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        asm.load(8, false, x64::Reg::R8, x64::Reg::R8, 0)
        asm.jmp(chain_top)
        asm.bind(chain_done)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.jmp(bucket_top)
        asm.bind(bucket_done)
        // A shell sort of the nodes by hash: -64 is the gap, -32 the position i, -56 the position j.
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
        asm.mov_ri(x64::Reg::RCX, 1)
        asm.shift_cl(5, x64::Reg::RAX)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 64)
        gap_top := asm.new_label()
        gap_done := asm.new_label()
        i_top := asm.new_label()
        i_done := asm.new_label()
        j_top := asm.new_label()
        j_done := asm.new_label()
        asm.bind(gap_top)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 64)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, gap_done)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.bind(i_top)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 24)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, i_done)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        // The node being placed is kept in -48 for the duration of the inner loop.
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::R8, x64::Reg::R10, 0)
        asm.store(8, x64::Reg::R8, x64::Reg::RBP, (0 as i64) - 48)
        asm.bind(j_top)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 64)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::BELOW, j_done)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::RDX)
        asm.load(8, false, x64::Reg::R9, x64::Reg::R10, 0)
        asm.load(8, false, x64::Reg::R11, x64::Reg::R9, 8)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RBP, (0 as i64) - 48)
        asm.load(8, false, x64::Reg::R8, x64::Reg::R8, 8)
        asm.alu_rr(57, x64::Reg::R11, x64::Reg::R8)
        asm.jcc(x64::Cc::BELOW_EQUAL, j_done)
        // nodes[j] = nodes[j - gap]
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::RAX)
        asm.store(8, x64::Reg::R9, x64::Reg::R10, 0)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        asm.alu_rr(41, x64::Reg::RAX, x64::Reg::RCX)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        asm.jmp(j_top)
        asm.bind(j_done)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RBP, (0 as i64) - 48)
        asm.store(8, x64::Reg::R8, x64::Reg::R10, 0)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.jmp(i_top)
        asm.bind(i_done)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 64)
        asm.mov_ri(x64::Reg::RCX, 1)
        asm.shift_cl(5, x64::Reg::RAX)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 64)
        asm.jmp(gap_top)
        asm.bind(gap_done)
        // The vector: its header and a data block of one cell per node.
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 48)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 24)
        asm.alu_ri(0, x64::Reg::RDI, 1)
        self.scale_bytes(asm, x64::Reg::RDI, 8)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 40)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 48)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 24)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 16)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        copy_top := asm.new_label()
        copy_done := asm.new_label()
        asm.bind(copy_top)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 24)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, copy_done)
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::R10, x64::Reg::R10, 0)
        mut field: i64 = 24
        when keys {
            field = 16
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::R10, field)
        when text {
            asm.call_label(self.string_clone_label)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 40)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RAX)
        asm.store(8, x64::Reg::RDI, x64::Reg::RDX, 0)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.jmp(copy_top)
        asm.bind(copy_done)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 48)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        return true
    }

    // The node of a key in a map, left in rax: the map is evaluated first, then the key.
    fun find_key(mut self, asm: &mut x64::Asm, map: u64, key: u64, text: bool) -> bool {
        when !self.expr(asm, map) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, key) {
            return false
        }
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RAX)
        asm.pop(x64::Reg::RDI)
        when text {
            asm.call_label(self.map_find_string)
        }
        when !text {
            asm.call_label(self.map_find_scalar)
        }
        return true
    }

    // `insert(key, value)`: an existing key takes the new value and the call returns 1; a new key gets a node, is linked
    // into its bucket, and the map doubles when it has more nodes than buckets. The call returns 0.
    fun map_insert(mut self, asm: &mut x64::Asm, map: u64, key: u64, value: u64, text: bool) -> bool {
        when !self.expr(asm, map) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, key) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, value) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
        when text {
            asm.call_label(self.map_find_string)
        }
        when !text {
            asm.call_label(self.map_find_scalar)
        }
        fresh := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, fresh)
        when self.handle_destructor(self.map_value_type).is_some() {
            fid := self.handle_destructor(self.map_value_type).unwrap()
            self.needed.set(fid, true)
            asm.push(x64::Reg::RAX)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 24)
            asm.push(x64::Reg::RCX)
            asm.call_label(self.labels[fid])
            asm.alu_ri(0, x64::Reg::RSP, 8)
            asm.pop(x64::Reg::RAX)
        }
        when self.handle_destructor(self.map_value_type).is_none() && self.has_owners(self.map_value_type) {
            asm.push(x64::Reg::RAX)
            asm.lea(x64::Reg::RDI, x64::Reg::RAX, 24)
            asm.call_label(self.value_drop_routine(asm, self.map_value_type, false))
            asm.pop(x64::Reg::RAX)
        }
        when text {
            asm.push(x64::Reg::RAX)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
            asm.call_label(self.handle_drop_routine(asm, self.string_type()))
            asm.pop(x64::Reg::RAX)
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 24)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.jmp(done)
        asm.bind(fresh)
        asm.mov_ri(x64::Reg::RDI, 40)
        self.aligned_call(asm, String("malloc"))
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 24)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 16)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RCX)
        when text {
            asm.call_label(self.map_hash_string)
        }
        when !text {
            asm.call_label(self.map_hash_scalar)
        }
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 24)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 32)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDI, 24)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 16)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDI, 16)
        // The bucket of the hash gets the node at its front.
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDI, 8)
        asm.alu_ri(5, x64::Reg::R8, 1)
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        asm.alu_rr(33, x64::Reg::R9, x64::Reg::R8)
        asm.alu_rr(1, x64::Reg::R9, x64::Reg::R9)
        asm.alu_rr(1, x64::Reg::R9, x64::Reg::R9)
        asm.alu_rr(1, x64::Reg::R9, x64::Reg::R9)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RDI, 0)
        asm.alu_rr(1, x64::Reg::R9, x64::Reg::R10)
        asm.load(8, false, x64::Reg::R10, x64::Reg::R9, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::R10, x64::Reg::RDX, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::R9, 0)
        // More nodes than buckets: the buckets double.
        nogrow := asm.new_label()
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 16)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDI, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::BELOW_EQUAL, nogrow)
        asm.call_label(self.map_grow)
        asm.bind(nogrow)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.alu_ri(0, x64::Reg::RSP, 32)
        asm.bind(done)
        return true
    }

    // `get(key)`: the Option of the value of a scalar value, or None; the value is copied into the box.
    fun map_get(mut self, asm: &mut x64::Asm, map: u64, key: u64, value: u64, text: bool) -> bool {
        option := self.option_of(value)
        when option.is_none() {
            return self.fail("a map get without an Option of its value")
        }
        some := self.variant_tag(option.unwrap(), String("Some"))
        none := self.variant_tag(option.unwrap(), String("None"))
        when some.is_none() || none.is_none() {
            return self.fail("a map get without an Option of its value")
        }
        when !self.find_key(asm, map, key, text) {
            return false
        }
        missing := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, missing)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 24)
        when self.is_string(value) {
            self.clone_header(asm)
        }
        asm.push(x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.pop(x64::Reg::RCX)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.mov_ri(x64::Reg::RDX, some.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.jmp(done)
        asm.bind(missing)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RDX, none.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `remove(key)`: the node is unlinked from its bucket and the call returns 1; a key that is not there gives 0.
    fun map_remove(mut self, asm: &mut x64::Asm, map: u64, key: u64, text: bool) -> bool {
        when !self.expr(asm, map) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, key) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        when text {
            asm.call_label(self.map_find_string)
        }
        when !text {
            asm.call_label(self.map_find_scalar)
        }
        missing := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, missing)
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
        when text {
            asm.call_label(self.map_hash_string)
        }
        when !text {
            asm.call_label(self.map_hash_scalar)
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDI, 8)
        asm.alu_ri(5, x64::Reg::R8, 1)
        asm.alu_rr(33, x64::Reg::RAX, x64::Reg::R8)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDI, 0)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::R9)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        // The link that points at the node is found, and it takes the node's next.
        walk := asm.new_label()
        found := asm.new_label()
        asm.bind(walk)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.alu_rr(57, x64::Reg::RDX, x64::Reg::RCX)
        asm.jcc(x64::Cc::EQUAL, found)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
        asm.jmp(walk)
        asm.bind(found)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 16)
        asm.alu_ri(5, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDI, 16)
        when self.handle_destructor(self.map_value_type).is_some() {
            fid := self.handle_destructor(self.map_value_type).unwrap()
            self.needed.set(fid, true)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 24)
            asm.push(x64::Reg::RAX)
            asm.call_label(self.labels[fid])
            asm.alu_ri(0, x64::Reg::RSP, 8)
        }
        when self.handle_destructor(self.map_value_type).is_none() && self.has_owners(self.map_value_type) {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
            asm.alu_ri(0, x64::Reg::RDI, 24)
            asm.call_label(self.value_drop_routine(asm, self.map_value_type, false))
        }
        when text {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
            asm.alu_ri(0, x64::Reg::RDI, 16)
            asm.call_label(self.value_drop_routine(asm, self.string_type(), false))
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
        self.aligned_call(asm, String("free"))
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.jmp(done)
        asm.bind(missing)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.alu_ri(0, x64::Reg::RSP, 16)
        asm.bind(done)
        return true
    }

    // The owned String that a `str` argument is converted from, when the argument is one.
    fun as_str_inner(self, index: u64) -> Option<u64> {
        return choose self.program.exprs[index] {
            ir::IrExpr::StringAsStr(inner) => Option::Some(inner),
            _ => Option::None,
        }
    }

    // `String(n)` of an integer: its digits are written backwards into a frame buffer, then copied into a malloc'd text,
    // and the header is {data, length, length}. A negative signed value takes a minus sign first. The frame holds the
    // buffer (24 bytes), the text's length, its data, the digit position and the header.
    fun string_from_integer(mut self, asm: &mut x64::Asm, value: u64, signed: bool) -> bool {
        when !self.expr(asm, value) {
            return false
        }
        asm.alu_ri(5, x64::Reg::RSP, 56)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RAX)
        asm.mov_ri(x64::Reg::R9, 0)
        when signed {
            positive := asm.new_label()
            asm.test_rr(x64::Reg::R11, x64::Reg::R11)
            asm.jcc(x64::Cc::GREATER_EQUAL, positive)
            asm.unary(3, x64::Reg::R11)
            asm.mov_ri(x64::Reg::R9, 1)
            asm.bind(positive)
        }
        // The digits, the last first: r10 is the position, starting past the buffer's end.
        asm.mov_ri(x64::Reg::R10, 24)
        digits := asm.new_label()
        asm.bind(digits)
        asm.alu_ri(5, x64::Reg::R10, 1)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::R11)
        asm.mov_ri(x64::Reg::RDX, 0)
        asm.mov_ri(x64::Reg::RCX, 10)
        asm.unary(6, x64::Reg::RCX)
        asm.alu_ri(0, x64::Reg::RDX, 48)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RSP)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R10)
        asm.store(1, x64::Reg::RDX, x64::Reg::R8, 0)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RAX)
        asm.test_rr(x64::Reg::R11, x64::Reg::R11)
        asm.jcc(x64::Cc::NOT_EQUAL, digits)
        // The minus sign of a negative value, then the length of the text and its position in the buffer.
        unsigned := asm.new_label()
        asm.test_rr(x64::Reg::R9, x64::Reg::R9)
        asm.jcc(x64::Cc::EQUAL, unsigned)
        asm.alu_ri(5, x64::Reg::R10, 1)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RSP)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R10)
        asm.mov_ri(x64::Reg::RDX, 45)
        asm.store(1, x64::Reg::RDX, x64::Reg::R8, 0)
        asm.bind(unsigned)
        asm.mov_ri(x64::Reg::RCX, 24)
        asm.alu_rr(41, x64::Reg::RCX, x64::Reg::R10)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 24)
        asm.store(8, x64::Reg::R10, x64::Reg::RSP, 40)
        // The text is copied from the buffer into its own memory, and the header is made.
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RCX)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 24)
        self.aligned_call(asm, String("memcpy"))
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 48)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 32)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 24)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 48)
        asm.alu_ri(0, x64::Reg::RSP, 56)
        return true
    }

    // The byte at `index` of a String, which fails past its end, as the runtime does.
    fun string_byte_at(mut self, asm: &mut x64::Asm, text: u64, index: u64) -> bool {
        when !self.expr(asm, index) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.load_string_parts(asm, text) {
            return false
        }
        asm.pop(x64::Reg::RCX)
        ok := asm.new_label()
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        asm.jcc(x64::Cc::BELOW, ok)
        self.fail_exit(asm, String("Ryn runtime error: String byte index is out of bounds\n"))
        asm.bind(ok)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::RCX)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::R8, 0)
        return true
    }

    // Fails unless the offset in the frame at `offset` is on a character boundary of the text, whose data is at 0 and
    // length at 8 of the frame: the end of the text, the start, or a byte that is not a continuation byte.
    fun slice_boundary(mut self, asm: &mut x64::Asm, offset: i64, message: String) {
        ok := asm.new_label()
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, offset)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        asm.jcc(x64::Cc::EQUAL, ok)
        asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
        asm.jcc(x64::Cc::EQUAL, ok)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::RSI, 0)
        asm.alu_ri(4, x64::Reg::RAX, 192)
        asm.alu_ri(7, x64::Reg::RAX, 128)
        asm.jcc(x64::Cc::NOT_EQUAL, ok)
        self.fail_exit(asm, message)
        asm.bind(ok)
    }

    // `slice(start, end)` of a String by bytes: a new String with the bytes from start to end. The range must be in order
    // and within the text, and each end must lie on a character boundary, as the runtime checks. The frame has the same
    // slots as `substring`: the data, length, the two offsets, the copy and its header, and the end and start above.
    fun string_slice(mut self, asm: &mut x64::Asm, text: u64, start: u64, end: u64) -> bool {
        message := String("Ryn runtime error: String slice must use ordered in-bounds UTF-8 byte boundaries\n")
        when !self.expr(asm, start) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, end) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.alu_ri(5, x64::Reg::RSP, 48)
        when !self.load_string_parts(asm, text) {
            return false
        }
        asm.store(8, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 56)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 48)
        ordered := asm.new_label()
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::BELOW_EQUAL, ordered)
        self.fail_exit(asm, message.clone())
        asm.bind(ordered)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        inside := asm.new_label()
        asm.jcc(x64::Cc::BELOW_EQUAL, inside)
        self.fail_exit(asm, message.clone())
        asm.bind(inside)
        // Each end is on a boundary: the start or end is the length or 0, or else its byte is not a continuation byte.
        self.slice_boundary(asm, 56, message.clone())
        self.slice_boundary(asm, 48, message.clone())
        // The copy: malloc(end - start), then memcpy(copy, data + start, end - start).
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 48)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 56)
        asm.alu_rr(41, x64::Reg::RDI, x64::Reg::RCX)
        asm.store(8, x64::Reg::RDI, x64::Reg::RSP, 24)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 56)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 24)
        self.aligned_call(asm, String("memcpy"))
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 40)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 32)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 24)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 40)
        asm.alu_ri(0, x64::Reg::RSP, 64)
        return true
    }

    // `substring(start, end)` of a String, by character: a new String with the bytes between the two character offsets.
    // The offsets are found with the same walk as `char_at`, and an out-of-order or out-of-range pair fails. The values
    // live in one frame of 48 bytes: the text's data, length, the two byte offsets, the copy and its header; the end and
    // start indices are the two words above them.
    fun string_slice_chars(mut self, asm: &mut x64::Asm, text: u64, start: u64, end: u64) -> bool {
        message := String("Ryn runtime error: String character slice must use ordered in-bounds Unicode scalar indices\n")
        when !self.expr(asm, start) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, end) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.alu_ri(5, x64::Reg::RSP, 48)
        when !self.load_string_parts(asm, text) {
            return false
        }
        asm.store(8, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::RSP, 8)
        // The start must not come after the end.
        ordered := asm.new_label()
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 56)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 48)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::BELOW_EQUAL, ordered)
        self.fail_exit(asm, message.clone())
        asm.bind(ordered)
        // The byte offset of the start, then of the end.
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 56)
        self.char_offset_code(asm, message.clone())
        asm.store(8, x64::Reg::R8, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 48)
        self.char_offset_code(asm, message.clone())
        asm.store(8, x64::Reg::R8, x64::Reg::RSP, 24)
        // The copy: malloc(finish - begin), then memcpy(copy, data + begin, finish - begin).
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.alu_rr(41, x64::Reg::RDI, x64::Reg::RCX)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 24)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RCX)
        self.aligned_call(asm, String("memcpy"))
        // The header: the copy, the length and the capacity of the length.
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 40)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 32)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RCX)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 16)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 40)
        asm.alu_ri(0, x64::Reg::RSP, 64)
        return true
    }

    // The character at `index` of a String or str: the index is evaluated first, then the text's data and length are read.
    fun string_char_at(mut self, asm: &mut x64::Asm, text: u64, index: u64, message: String) -> bool {
        when !self.expr(asm, index) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.load_string_parts(asm, text) {
            return false
        }
        asm.pop(x64::Reg::RCX)
        self.char_at_code(asm, message)
        return true
    }

    // Walks the UTF-8 text at rsi, of rdx bytes, to the character index that rcx names, and leaves its byte offset in r8.
    // The index of the length is the end of the text; an index past it fails with `message`. Uses r8 to r11.
    fun char_offset_code(mut self, asm: &mut x64::Asm, message: String) {
        top := asm.new_label()
        fail := asm.new_label()
        done := asm.new_label()
        asm.mov_ri(x64::Reg::R8, 0)
        asm.mov_ri(x64::Reg::R9, 0)
        asm.bind(top)
        asm.alu_rr(57, x64::Reg::R9, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, done)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, fail)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::R10, x64::Reg::R11, 0)
        // The width of the character from its lead byte: one below 0x80, two below 0xE0, three below 0xF0, else four.
        width := asm.new_label()
        asm.mov_ri(x64::Reg::R11, 1)
        asm.alu_ri(7, x64::Reg::R10, 128)
        asm.jcc(x64::Cc::BELOW, width)
        asm.mov_ri(x64::Reg::R11, 2)
        asm.alu_ri(7, x64::Reg::R10, 224)
        asm.jcc(x64::Cc::BELOW, width)
        asm.mov_ri(x64::Reg::R11, 3)
        asm.alu_ri(7, x64::Reg::R10, 240)
        asm.jcc(x64::Cc::BELOW, width)
        asm.mov_ri(x64::Reg::R11, 4)
        asm.bind(width)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R11)
        asm.alu_ri(0, x64::Reg::R9, 1)
        asm.jmp(top)
        asm.bind(fail)
        self.fail_exit(asm, message)
        asm.bind(done)
    }

    // The character at the index in rcx, decoded into rax; an index past the last character fails with `message`.
    fun char_at_code(mut self, asm: &mut x64::Asm, message: String) {
        self.char_offset_code(asm, message.clone())
        ok := asm.new_label()
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::BELOW, ok)
        self.fail_exit(asm, message)
        asm.bind(ok)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::R11, 0)
        // Decoding: the lead byte's bits, then six bits from each continuation byte.
        done := asm.new_label()
        two := asm.new_label()
        three := asm.new_label()
        asm.alu_ri(7, x64::Reg::RAX, 128)
        asm.jcc(x64::Cc::BELOW, done)
        asm.alu_ri(7, x64::Reg::RAX, 224)
        asm.jcc(x64::Cc::BELOW, two)
        asm.alu_ri(7, x64::Reg::RAX, 240)
        asm.jcc(x64::Cc::BELOW, three)
        asm.alu_ri(4, x64::Reg::RAX, 7)
        asm.mov_ri(x64::Reg::RCX, 18)
        asm.shift_cl(4, x64::Reg::RAX)
        self.continuation(asm, 1, 12)
        self.continuation(asm, 2, 6)
        self.continuation(asm, 3, 0)
        asm.jmp(done)
        asm.bind(three)
        asm.alu_ri(4, x64::Reg::RAX, 15)
        asm.mov_ri(x64::Reg::RCX, 12)
        asm.shift_cl(4, x64::Reg::RAX)
        self.continuation(asm, 1, 6)
        self.continuation(asm, 2, 0)
        asm.jmp(done)
        asm.bind(two)
        asm.alu_ri(4, x64::Reg::RAX, 31)
        asm.mov_ri(x64::Reg::RCX, 6)
        asm.shift_cl(4, x64::Reg::RAX)
        self.continuation(asm, 1, 0)
        asm.bind(done)
    }

    // ORs the six bits of the continuation byte at `offset` from the character in r11, shifted left by `shift`, into rax.
    fun continuation(self, asm: &mut x64::Asm, offset: i64, shift: u64) {
        asm.load(1, false, x64::Reg::R10, x64::Reg::R11, offset)
        asm.alu_ri(4, x64::Reg::R10, 63)
        asm.mov_ri(x64::Reg::RCX, shift)
        asm.shift_cl(4, x64::Reg::R10)
        asm.alu_rr(9, x64::Reg::RAX, x64::Reg::R10)
    }

    // `try_to_<int>()` of a String or str: the decimal text, an optional sign, then digits and nothing else, as Rust's
    // integer parse reads it, is an Option of the integer whose type the tag names (0 i8 to 7 u64). A value past the
    // range, an empty text, or any other text gives None.
    fun string_try_parse(mut self, asm: &mut x64::Asm, text: u64, tag: u64) -> bool {
        when self.integer_literal(tag).is_none() {
            return self.fail("a parse of a type that is not an integer")
        }
        kind := self.integer_literal(tag).unwrap()
        when kind == 8 || kind == 9 {
            return self.string_try_parse_float(asm, text, kind == 8)
        }
        when kind > 7 {
            return self.fail("a parse of a type that is not an integer")
        }
        signed := kind < 4
        // The largest value of the type; a negative signed value may be one more in magnitude.
        mut largest: u64 = 0
        when kind == 0 {
            largest = 127 as u64
        }
        when kind == 1 {
            largest = 32767 as u64
        }
        when kind == 2 {
            largest = 2147483647 as u64
        }
        when kind == 3 {
            largest = 9223372036854775807 as u64
        }
        when kind == 4 {
            largest = 255 as u64
        }
        when kind == 5 {
            largest = 65535 as u64
        }
        when kind == 6 {
            largest = 4294967295 as u64
        }
        when kind == 7 {
            largest = 18446744073709551615 as u64
        }
        mut name := String("I8")
        when kind == 1 {
            name = String("I16")
        }
        when kind == 2 {
            name = String("I32")
        }
        when kind == 3 {
            name = String("I64")
        }
        when kind == 4 {
            name = String("U8")
        }
        when kind == 5 {
            name = String("U16")
        }
        when kind == 6 {
            name = String("U32")
        }
        when kind == 7 {
            name = String("U64")
        }
        scalar := self.scalar_type_id(name)
        mut option: Option<u64> = Option::None
        when scalar.is_some() {
            option = self.option_of(scalar.unwrap())
        }
        when option.is_none() {
            return self.fail("a parse without its Option")
        }
        some := self.variant_tag(option.unwrap(), String("Some"))
        none := self.variant_tag(option.unwrap(), String("None"))
        when some.is_none() || none.is_none() {
            return self.fail("a parse without its Option")
        }
        when !self.load_string_parts(asm, text) {
            return false
        }
        bad := asm.new_label()
        parsed := asm.new_label()
        done := asm.new_label()
        digits := asm.new_label()
        finish := asm.new_label()
        asm.test_rr(x64::Reg::RDX, x64::Reg::RDX)
        asm.jcc(x64::Cc::EQUAL, bad)
        asm.mov_ri(x64::Reg::R8, 0)
        asm.mov_ri(x64::Reg::R9, 0)
        asm.mov_ri(x64::Reg::R10, 0)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::RSI, 0)
        sign := asm.new_label()
        asm.alu_ri(7, x64::Reg::RCX, 43)
        asm.jcc(x64::Cc::EQUAL, sign)
        when signed {
            asm.alu_ri(7, x64::Reg::RCX, 45)
            asm.jcc(x64::Cc::NOT_EQUAL, digits)
            asm.mov_ri(x64::Reg::R10, 1)
            asm.jmp(sign)
        }
        when !signed {
            asm.alu_ri(7, x64::Reg::RCX, 45)
            asm.jcc(x64::Cc::EQUAL, bad)
            asm.jmp(digits)
        }
        asm.bind(sign)
        asm.mov_ri(x64::Reg::R8, 1)
        asm.bind(digits)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, bad)
        digit := asm.new_label()
        asm.bind(digit)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, finish)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::R11, x64::Reg::R11, 0)
        asm.alu_ri(5, x64::Reg::R11, 48)
        asm.alu_ri(7, x64::Reg::R11, 9)
        asm.jcc(x64::Cc::ABOVE, bad)
        // The digit fits when the value so far is at most (limit - digit) / 10.
        asm.push(x64::Reg::RDX)
        asm.mov_ri(x64::Reg::RAX, largest)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::R10)
        asm.alu_rr(41, x64::Reg::RAX, x64::Reg::R11)
        asm.mov_ri(x64::Reg::RCX, 10)
        asm.mov_ri(x64::Reg::RDX, 0)
        asm.unary(6, x64::Reg::RCX)
        asm.pop(x64::Reg::RDX)
        asm.alu_rr(57, x64::Reg::R9, x64::Reg::RAX)
        asm.jcc(x64::Cc::ABOVE, bad)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::R9)
        asm.mov_ri(x64::Reg::RCX, 10)
        asm.imul_rr(x64::Reg::RAX, x64::Reg::RCX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::R11)
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.jmp(digit)
        asm.bind(finish)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::R9)
        asm.test_rr(x64::Reg::R10, x64::Reg::R10)
        asm.jcc(x64::Cc::EQUAL, parsed)
        asm.unary(3, x64::Reg::RAX)
        asm.bind(parsed)
        asm.push(x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.pop(x64::Reg::RCX)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.mov_ri(x64::Reg::RDX, some.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.jmp(done)
        asm.bind(bad)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RDX, none.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // The case-folded comparison of `word` with the text at rsi + r8, r10 bytes of which remain: jumps to `matched` when the
    // text is that word in any case, and falls through otherwise. Clobbers rcx and r11.
    fun match_word(self, asm: &mut x64::Asm, word: String, matched: u64) {
        next := asm.new_label()
        asm.alu_ri(7, x64::Reg::R10, word.len() as i64)
        asm.jcc(x64::Cc::NOT_EQUAL, next)
        mut at: u64 = 0
        while at < word.len() {
            asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
            asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
            asm.load(1, false, x64::Reg::RCX, x64::Reg::R11, at as i64)
            asm.alu_ri(1, x64::Reg::RCX, 32)
            asm.alu_ri(7, x64::Reg::RCX, word.byte_at(at) as i64)
            asm.jcc(x64::Cc::NOT_EQUAL, next)
            at += 1
        }
        asm.jmp(matched)
        asm.bind(next)
    }

    // Counts the ASCII digits at rsi + r8 (bounded by the length in rdx), moving r8 past them and adding to r9. Clobbers
    // rcx and r11.
    fun skip_digits(self, asm: &mut x64::Asm) {
        again := asm.new_label()
        stop := asm.new_label()
        asm.bind(again)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, stop)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::R11, 0)
        asm.alu_ri(5, x64::Reg::RCX, 48)
        asm.alu_ri(7, x64::Reg::RCX, 9)
        asm.jcc(x64::Cc::ABOVE, stop)
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.alu_ri(0, x64::Reg::R9, 1)
        asm.jmp(again)
        asm.bind(stop)
    }

    // `try_to_f32` and `try_to_f64`: the text must be what Rust's parser accepts (an optional sign, then `inf`, `infinity` or
    // `nan` in any case, or digits with an optional point and an optional exponent, with at least one mantissa digit and no
    // other character), and the value is then read by `strtod` or `strtof` from a terminated copy of the text.
    fun string_try_parse_float(mut self, asm: &mut x64::Asm, text: u64, single: bool) -> bool {
        mut name := String("F64")
        when single {
            name = String("F32")
        }
        scalar := self.scalar_type_id(name)
        mut option: Option<u64> = Option::None
        when scalar.is_some() {
            option = self.option_of(scalar.unwrap())
        }
        when option.is_none() {
            return self.fail("a parse without its Option")
        }
        some := self.variant_tag(option.unwrap(), String("Some"))
        none := self.variant_tag(option.unwrap(), String("None"))
        when some.is_none() || none.is_none() {
            return self.fail("a parse without its Option")
        }
        when !self.load_string_parts(asm, text) {
            return false
        }
        bad := asm.new_label()
        valid := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RDX, x64::Reg::RDX)
        asm.jcc(x64::Cc::EQUAL, bad)
        asm.mov_ri(x64::Reg::R8, 0)
        asm.mov_ri(x64::Reg::R9, 0)
        // An optional sign, and something after it.
        asm.load(1, false, x64::Reg::RCX, x64::Reg::RSI, 0)
        unsigned := asm.new_label()
        asm.alu_ri(7, x64::Reg::RCX, 43)
        asm.jcc(x64::Cc::EQUAL, unsigned)
        asm.alu_ri(7, x64::Reg::RCX, 45)
        after_sign := asm.new_label()
        asm.jcc(x64::Cc::NOT_EQUAL, after_sign)
        asm.bind(unsigned)
        asm.mov_ri(x64::Reg::R8, 1)
        asm.bind(after_sign)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, bad)
        // The words `inf`, `infinity` and `nan`; r10 is the number of characters after the sign.
        asm.mov_rr(x64::Reg::R10, x64::Reg::RDX)
        asm.alu_rr(41, x64::Reg::R10, x64::Reg::R8)
        self.match_word(asm, String("inf"), valid)
        self.match_word(asm, String("infinity"), valid)
        self.match_word(asm, String("nan"), valid)
        // Digits, a point and digits, then an exponent: r9 counts the mantissa digits.
        self.skip_digits(asm)
        no_point := asm.new_label()
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, no_point)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::R11, 0)
        asm.alu_ri(7, x64::Reg::RCX, 46)
        asm.jcc(x64::Cc::NOT_EQUAL, no_point)
        asm.alu_ri(0, x64::Reg::R8, 1)
        self.skip_digits(asm)
        asm.bind(no_point)
        asm.test_rr(x64::Reg::R9, x64::Reg::R9)
        asm.jcc(x64::Cc::EQUAL, bad)
        no_exponent := asm.new_label()
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, no_exponent)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::R11, 0)
        asm.alu_ri(1, x64::Reg::RCX, 32)
        asm.alu_ri(7, x64::Reg::RCX, 101)
        asm.jcc(x64::Cc::NOT_EQUAL, no_exponent)
        asm.alu_ri(0, x64::Reg::R8, 1)
        // The exponent's own sign, then at least one digit.
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, bad)
        exponent_digits := asm.new_label()
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::R11, 0)
        exponent_sign := asm.new_label()
        asm.alu_ri(7, x64::Reg::RCX, 43)
        asm.jcc(x64::Cc::EQUAL, exponent_sign)
        asm.alu_ri(7, x64::Reg::RCX, 45)
        asm.jcc(x64::Cc::NOT_EQUAL, exponent_digits)
        asm.bind(exponent_sign)
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.bind(exponent_digits)
        asm.mov_ri(x64::Reg::R9, 0)
        self.skip_digits(asm)
        asm.test_rr(x64::Reg::R9, x64::Reg::R9)
        asm.jcc(x64::Cc::EQUAL, bad)
        asm.bind(no_exponent)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::NOT_EQUAL, bad)
        // A terminated copy of the text is read by the C library; the copy is freed after.
        asm.bind(valid)
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        asm.lea(x64::Reg::RDI, x64::Reg::RDX, 1)
        self.aligned_call(asm, String("malloc"))
        asm.push(x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("memcpy"))
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RCX)
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.store(1, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
        asm.mov_ri(x64::Reg::RSI, 0)
        when single {
            self.aligned_call(asm, String("strtof"))
            asm.movq_from_xmm(false, x64::Reg::RAX, 0)
        } else {
            self.aligned_call(asm, String("strtod"))
            asm.movq_from_xmm(true, x64::Reg::RAX, 0)
        }
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("free"))
        asm.pop(x64::Reg::RCX)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.push(x64::Reg::RCX)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.pop(x64::Reg::RCX)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.mov_ri(x64::Reg::RDX, some.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.jmp(done)
        asm.bind(bad)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RDX, none.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // The type id of a scalar by its word, as the IR names it.
    fun scalar_type_id(self, word: String) -> Option<u64> {
        mut index: u64 = 0
        while index < self.program.types.len() {
            when choose self.program.types[index] {
                ir::IrTy::Scalar(name) => name == word,
                _ => false,
            } {
                return Option::Some(index)
            }
            index += 1
        }
        return Option::None
    }

    // The value of an integer literal expression.
    fun integer_literal(self, index: u64) -> Option<u64> {
        return choose self.program.exprs[index] {
            ir::IrExpr::IntegerLit(text, ty) => Option::Some(literal_bits(text)),
            _ => Option::None,
        }
    }

    // `concat` of two Strings: a new String holding the first, then the second, with the capacity of the length. Both
    // operands are String values, read through their headers; the operands are consumed, as the Rust call does.
    fun string_concat(mut self, asm: &mut x64::Asm, first: u64, second: u64) -> bool {
        when !self.expr(asm, first) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, second) {
            return false
        }
        asm.push(x64::Reg::RAX)
        return self.concat_pushed(asm)
    }

    // `concat(suffix)` of a String with a `str`: the suffix is copied into a String, which is then joined to the first.
    fun string_concat_text(mut self, asm: &mut x64::Asm, first: u64, second: u64) -> bool {
        when !self.expr(asm, first) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.text_parts(asm, second, false) {
            return false
        }
        when !self.string_from_parts(asm) {
            return false
        }
        asm.push(x64::Reg::RAX)
        return self.concat_pushed(asm)
    }

    // Joins the two Strings whose headers are the two topmost cells of the stack, the first below the second. The result's
    // header is left in rax, and both are popped.
    fun concat_pushed(mut self, asm: &mut x64::Asm) -> bool {
        // The frame: the data of the copy at 0, its length at 8, and the header at 16; the second header is at 24 and the
        // first at 32.
        asm.alu_ri(5, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::R8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RCX)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 0)
        // The first text, then the second after it.
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 32)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RCX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("memcpy"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 32)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RCX, 8)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::R8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RDX, 8)
        self.aligned_call(asm, String("memcpy"))
        // The header: the copy, and its length as both length and capacity.
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 16)
        asm.alu_ri(0, x64::Reg::RSP, 40)
        return true
    }

    // `contains(pattern)`, or `ends_with(pattern)` when `at_end`: the pattern's bytes are compared where it may start in the
    // text. The pattern is a `str`, or a String when `owned` is set.
    fun string_search(mut self, asm: &mut x64::Asm, text: u64, pattern: u64, owned: bool, at_end: bool) -> bool {
        when !self.text_parts(asm, text, true) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, pattern, owned) {
            return false
        }
        // rdi and rcx are the text's data and length, rsi and rdx the pattern's; r9 is the last position where it may start.
        asm.pop(x64::Reg::RCX)
        asm.pop(x64::Reg::RDI)
        yes := asm.new_label()
        no := asm.new_label()
        done := asm.new_label()
        attempt := asm.new_label()
        next := asm.new_label()
        compare := asm.new_label()
        asm.alu_rr(57, x64::Reg::RDX, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE, no)
        asm.mov_rr(x64::Reg::R9, x64::Reg::RCX)
        asm.alu_rr(41, x64::Reg::R9, x64::Reg::RDX)
        asm.mov_ri(x64::Reg::R8, 0)
        when at_end {
            asm.mov_rr(x64::Reg::R8, x64::Reg::R9)
        }
        asm.bind(attempt)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::R9)
        asm.jcc(x64::Cc::ABOVE, no)
        asm.mov_ri(x64::Reg::R10, 0)
        asm.bind(compare)
        asm.alu_rr(57, x64::Reg::R10, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, yes)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RDI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R10)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::R11, 0)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R10)
        asm.load(1, false, x64::Reg::R11, x64::Reg::R11, 0)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::R11)
        asm.jcc(x64::Cc::NOT_EQUAL, next)
        asm.alu_ri(0, x64::Reg::R10, 1)
        asm.jmp(compare)
        asm.bind(next)
        when at_end {
            asm.jmp(no)
        }
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.jmp(attempt)
        asm.bind(yes)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.jmp(done)
        asm.bind(no)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `split(separator)` of a String: the pieces, as a vector of Strings. The pieces are the parts between the matches, left to
    // right, as in Rust; an empty separator matches between each pair of characters, so the first and the last piece are
    // empty. The separator is a `str`, or a String when `owned` is set.
    fun string_split(mut self, asm: &mut x64::Asm, text: u64, pattern: u64, owned: bool) -> bool {
        when !self.text_parts(asm, text, true) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, pattern, owned) {
            return false
        }
        asm.pop(x64::Reg::RCX)
        asm.pop(x64::Reg::RDI)
        // rdi and rcx are the text's data and length, rsi and rdx the separator's. The frame, below rbp: the text's data at
        // -8, its length at -16, the separator's data at -24, its length at -32, the start of the piece at -40, the index at
        // -48 and the vector's header at -56.
        past := asm.new_label()
        piece := asm.new_label()
        asm.jmp(past)
        // The piece from the start to the end in rdx is copied into a String, which is appended to the vector.
        asm.bind(piece)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -40)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, -8)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        when !self.string_from_parts(asm) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -56)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 16)
        room := asm.new_label()
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::BELOW, room)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::R8)
        self.grow_capacity(asm)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -56)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 16)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RAX)
        self.scale_bytes(asm, x64::Reg::RSI, 8)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        self.aligned_call(asm, String("realloc"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -56)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.bind(room)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -56)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::R9, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::R9, 8)
        asm.alu_rr(1, x64::Reg::R9, x64::Reg::RDI)
        asm.store(8, x64::Reg::RAX, x64::Reg::R9, 0)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        asm.ret()
        asm.bind(past)
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 64)
        asm.store(8, x64::Reg::RDI, x64::Reg::RBP, -8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -16)
        asm.store(8, x64::Reg::RSI, x64::Reg::RBP, -24)
        asm.store(8, x64::Reg::RDX, x64::Reg::RBP, -32)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, -40)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, -48)
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, -56)
        finish := asm.new_label()
        empty := asm.new_label()
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -32)
        asm.test_rr(x64::Reg::RDX, x64::Reg::RDX)
        asm.jcc(x64::Cc::EQUAL, empty)
        // A separator of bytes: each match, leftmost first, ends a piece, and the rest of the text is the last piece.
        looping := asm.new_label()
        matched := asm.new_label()
        mismatch := asm.new_label()
        comparing := asm.new_label()
        ended := asm.new_label()
        asm.bind(looping)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -32)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RCX)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::RDX)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RBP, -16)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::R9)
        asm.jcc(x64::Cc::ABOVE, ended)
        asm.mov_ri(x64::Reg::R10, 0)
        asm.bind(comparing)
        asm.alu_rr(57, x64::Reg::R10, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, matched)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, -8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RDI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::RCX)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R10)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::R11, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, -24)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R10)
        asm.load(1, false, x64::Reg::R11, x64::Reg::R11, 0)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::R11)
        asm.jcc(x64::Cc::NOT_EQUAL, mismatch)
        asm.alu_ri(0, x64::Reg::R10, 1)
        asm.jmp(comparing)
        asm.bind(matched)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -48)
        asm.call_label(piece)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -32)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RDX)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -40)
        asm.jmp(looping)
        asm.bind(mismatch)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.jmp(looping)
        asm.bind(ended)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -16)
        asm.call_label(piece)
        asm.jmp(finish)
        // An empty separator: the boundaries between characters are the matches, the first at the start of the text.
        asm.bind(empty)
        each := asm.new_label()
        each_done := asm.new_label()
        skipping := asm.new_label()
        skipped := asm.new_label()
        asm.bind(each)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -48)
        asm.call_label(piece)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -40)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RBP, -16)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::ABOVE_EQUAL, each_done)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.bind(skipping)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RBP, -16)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::ABOVE_EQUAL, skipped)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, -8)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RCX)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::RDI, 0)
        asm.alu_ri(4, x64::Reg::RAX, 192)
        asm.alu_ri(7, x64::Reg::RAX, 128)
        asm.jcc(x64::Cc::NOT_EQUAL, skipped)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.jmp(skipping)
        asm.bind(skipped)
        asm.jmp(each)
        asm.bind(each_done)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -16)
        asm.call_label(piece)
        asm.bind(finish)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, -56)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        return true
    }

    // `get(index)`, `first()`, `last()` and `pop()` of a vector: an Option whose payload is a copy of the element, and None past
    // the end (and for `last` and `pop` of an empty vector). A `get` clones the owned cells of its copy; a `pop` moves the last
    // element out and shortens the vector, so its copy is not cloned. The payload is in the box in the order of the frame's
    // cells, while a vector keeps a structure's cells in memory order, so each cell is reversed.
    fun vec_get_option(mut self, asm: &mut x64::Asm, element: u64, option: u64, pop: bool, arguments: Vec<u64>) -> bool {
        mut expected: u64 = 2
        when pop {
            expected = 1
        }
        when arguments.len() != expected {
            return self.fail("a get with another number of arguments")
        }
        owned := self.owned_cells(element)
        when owned.is_none() {
            return self.fail("a get of owned elements that a clone does not copy")
        }
        when self.variant_tag(option, String("Some")).is_none() || self.variant_tag(option, String("None")).is_none() {
            return self.fail("a get of an enum that is not an Option")
        }
        some := self.variant_tag(option, String("Some")).unwrap()
        none := self.variant_tag(option, String("None")).unwrap()
        cells := self.cells_of(element)
        bytes := 8 * cells
        resolved := asm.new_label()
        absent := asm.new_label()
        done := asm.new_label()
        when pop {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
            asm.test_rr(x64::Reg::R8, x64::Reg::R8)
            asm.jcc(x64::Cc::EQUAL, absent)
            asm.mov_rr(x64::Reg::RCX, x64::Reg::R8)
            asm.alu_ri(5, x64::Reg::RCX, 1)
            asm.jmp(resolved)
        }
        when !pop {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.pop(x64::Reg::RDX)
            asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
            asm.alu_ri(7, x64::Reg::RCX, -1)
            asm.jcc(x64::Cc::NOT_EQUAL, resolved)
            asm.test_rr(x64::Reg::R8, x64::Reg::R8)
            asm.jcc(x64::Cc::EQUAL, absent)
            asm.mov_rr(x64::Reg::RCX, x64::Reg::R8)
            asm.alu_ri(5, x64::Reg::RCX, 1)
        }
        asm.bind(resolved)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::ABOVE_EQUAL, absent)
        asm.push(x64::Reg::RDX)
        asm.push(x64::Reg::RCX)
        asm.mov_ri(x64::Reg::RDI, (8 * (1 + cells)) as u64)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RCX, some)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.push(x64::Reg::RAX)
        // rsi is the element's address: the header's data plus the index times the element's bytes.
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        self.scale_bytes(asm, x64::Reg::RCX, bytes)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        mut memory: u64 = 0
        while memory < cells {
            asm.load(8, false, x64::Reg::R8, x64::Reg::RSI, (8 * memory) as i64)
            asm.store(8, x64::Reg::R8, x64::Reg::RAX, (8 * (1 + cells - 1 - memory)) as i64)
            memory += 1
        }
        // The owned cells of a copy by `get` are replaced by their clones.
        list := owned.unwrap()
        mut at: u64 = 0
        while at < list.len() && !pop {
            offset := list[at]
            code := list[at + 1]
            ty := list[at + 2]
            disp := (8 * (1 + cells - 1 - offset / 8)) as i64
            mut target: u64 = self.string_clone_label
            when code == 2 {
                target = self.vec_routine(asm, ty)
            }
            when code == 3 {
                target = self.enum_routine(asm, self.enum_id_of(ty))
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RAX, disp)
            asm.call_label(target)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RCX, disp)
            at += 3
        }
        // A pop shortens the vector once its last element is copied out.
        when pop {
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
            asm.alu_ri(5, x64::Reg::RCX, 1)
            asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
        }
        asm.pop(x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::RSP, 16)
        asm.jmp(done)
        asm.bind(absent)
        asm.mov_ri(x64::Reg::RDI, (8 * (1 + cells)) as u64)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RCX, none)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // The file builtins, through the C library: `read_file` gives the file's text as a String, or reports the error and exits
    // as the runtime does; `write_file` says whether the file was written.
    fun filesystem(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        when op == "ReadFile" && arguments.len() == 1 {
            return self.read_file(asm, arguments[0])
        }
        when op == "WriteFile" && arguments.len() == 2 {
            return self.write_file(asm, arguments[0], arguments[1])
        }
        when (op == "Exists" || op == "IsFile") && arguments.len() == 1 {
            // `access(path, F_OK)` through the system call: zero means the path exists.
            when !self.text_parts(asm, arguments[0], false) {
                return false
            }
            self.c_string(asm)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.mov_ri(x64::Reg::RSI, 0)
            asm.mov_ri(x64::Reg::RAX, 21)
            asm.syscall()
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            return true
        }
        return self.op_fail("a filesystem operation ", op)
    }

    // The text in rsi and rdx as a C string, with a NUL after it, whose address is left in rax.
    fun c_string(mut self, asm: &mut x64::Asm) {
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RDX)
        asm.alu_ri(0, x64::Reg::RDI, 1)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
        asm.push(x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("memcpy"))
        asm.pop(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RDX)
        asm.mov_ri(x64::Reg::R8, 0)
        asm.store(1, x64::Reg::R8, x64::Reg::RCX, 0)
        asm.alu_ri(0, x64::Reg::RSP, 16)
    }

    // Writes the bytes at rsi, of length rdx, to standard error.
    fun stderr_bytes(self, asm: &mut x64::Asm) {
        asm.mov_ri(x64::Reg::RDI, 2)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
    }

    fun literal_to_stderr(mut self, asm: &mut x64::Asm, text: String) {
        index := self.literal(text)
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[index])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[index])
        self.stderr_bytes(asm)
    }

    // The unsigned number at rsp (one cell, which is removed) in decimal, to standard error.
    fun decimal_to_stderr(self, asm: &mut x64::Asm) {
        asm.alu_ri(5, x64::Reg::RSP, 32)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.lea(x64::Reg::R8, x64::Reg::RSP, 32)
        asm.mov_ri(x64::Reg::R9, 10)
        digits := asm.new_label()
        asm.bind(digits)
        asm.mov_ri(x64::Reg::RDX, 0)
        asm.unary(6, x64::Reg::R9)
        asm.alu_ri(0, x64::Reg::RDX, 48)
        asm.alu_ri(5, x64::Reg::R8, 1)
        asm.store(1, x64::Reg::RDX, x64::Reg::R8, 0)
        asm.alu_ri(7, x64::Reg::RAX, 0)
        asm.jcc(x64::Cc::NOT_EQUAL, digits)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::R8)
        asm.lea(x64::Reg::RDX, x64::Reg::RSP, 32)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::R8)
        self.stderr_bytes(asm)
        asm.alu_ri(0, x64::Reg::RSP, 32)
    }

    // The error of a file that cannot be read: `Ryn runtime error: could not read `path`: strerror (os error n)`, and exit
    // with status 1. The path, a C string, is at rsp.
    fun read_error(mut self, asm: &mut x64::Asm) {
        self.aligned_call(asm, String("__errno_location"))
        asm.load(4, true, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.push(x64::Reg::RCX)
        self.literal_to_stderr(asm, String("Ryn runtime error: could not read `"))
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("strlen"))
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
        self.stderr_bytes(asm)
        self.literal_to_stderr(asm, String("`: "))
        asm.load(4, true, x64::Reg::RDI, x64::Reg::RSP, 0)
        self.aligned_call(asm, String("strerror"))
        asm.push(x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("strlen"))
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        self.stderr_bytes(asm)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        self.literal_to_stderr(asm, String(" (os error "))
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.push(x64::Reg::RAX)
        self.decimal_to_stderr(asm)
        self.literal_to_stderr(asm, String(")\n"))
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RAX, 231)
        asm.syscall()
    }

    // Jumps to `invalid` unless the bytes at the buffer (its address at rsp, its length at rsp + 8) are UTF-8, by the rules of
    // Rust's `str`: the lead byte, the number of continuation bytes, and the range of the first of them.
    fun utf8_check(mut self, asm: &mut x64::Asm, invalid: u64) {
        top := asm.new_label()
        ok := asm.new_label()
        ascii := asm.new_label()
        check := asm.new_label()
        rest := asm.new_label()
        next := asm.new_label()
        c2 := asm.new_label()
        c3 := asm.new_label()
        c4 := asm.new_label()
        c5 := asm.new_label()
        c6 := asm.new_label()
        asm.load(8, false, x64::Reg::R10, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RSP, 8)
        asm.mov_ri(x64::Reg::R8, 0)
        asm.bind(top)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::R9)
        asm.jcc(x64::Cc::ABOVE_EQUAL, ok)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::R10)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::RDI, 0)
        asm.alu_ri(7, x64::Reg::RAX, 128)
        asm.jcc(x64::Cc::BELOW, ascii)
        asm.mov_ri(x64::Reg::R11, 1)
        asm.mov_ri(x64::Reg::RCX, 128)
        asm.mov_ri(x64::Reg::RDX, 191)
        asm.alu_ri(7, x64::Reg::RAX, 194)
        asm.jcc(x64::Cc::BELOW, invalid)
        asm.alu_ri(7, x64::Reg::RAX, 223)
        asm.jcc(x64::Cc::ABOVE, c2)
        asm.jmp(check)
        asm.bind(c2)
        asm.alu_ri(7, x64::Reg::RAX, 224)
        asm.jcc(x64::Cc::NOT_EQUAL, c3)
        asm.mov_ri(x64::Reg::R11, 2)
        asm.mov_ri(x64::Reg::RCX, 160)
        asm.jmp(check)
        asm.bind(c3)
        asm.alu_ri(7, x64::Reg::RAX, 237)
        asm.jcc(x64::Cc::NOT_EQUAL, c4)
        asm.mov_ri(x64::Reg::R11, 2)
        asm.mov_ri(x64::Reg::RDX, 159)
        asm.jmp(check)
        asm.bind(c4)
        asm.alu_ri(7, x64::Reg::RAX, 225)
        asm.jcc(x64::Cc::BELOW, c5)
        asm.alu_ri(7, x64::Reg::RAX, 239)
        asm.jcc(x64::Cc::ABOVE, c5)
        asm.mov_ri(x64::Reg::R11, 2)
        asm.jmp(check)
        asm.bind(c5)
        asm.alu_ri(7, x64::Reg::RAX, 240)
        asm.jcc(x64::Cc::NOT_EQUAL, c6)
        asm.mov_ri(x64::Reg::R11, 3)
        asm.mov_ri(x64::Reg::RCX, 144)
        asm.jmp(check)
        asm.bind(c6)
        asm.alu_ri(7, x64::Reg::RAX, 241)
        asm.jcc(x64::Cc::BELOW, invalid)
        asm.alu_ri(7, x64::Reg::RAX, 244)
        asm.jcc(x64::Cc::ABOVE, invalid)
        asm.mov_ri(x64::Reg::R11, 3)
        asm.alu_ri(7, x64::Reg::RAX, 244)
        asm.jcc(x64::Cc::NOT_EQUAL, check)
        asm.mov_ri(x64::Reg::RDX, 143)
        asm.bind(check)
        // The continuation bytes must all be in the text, and the first in its range.
        asm.mov_rr(x64::Reg::RSI, x64::Reg::R8)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::R11)
        asm.alu_rr(57, x64::Reg::RSI, x64::Reg::R9)
        asm.jcc(x64::Cc::ABOVE_EQUAL, invalid)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::R10)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RSI, x64::Reg::RDI, 1)
        asm.alu_rr(57, x64::Reg::RSI, x64::Reg::RCX)
        asm.jcc(x64::Cc::BELOW, invalid)
        asm.alu_rr(57, x64::Reg::RSI, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE, invalid)
        asm.mov_ri(x64::Reg::RSI, 2)
        asm.bind(rest)
        asm.alu_rr(57, x64::Reg::RSI, x64::Reg::R11)
        asm.jcc(x64::Cc::ABOVE, next)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::R10)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::R8)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RSI)
        asm.load(1, false, x64::Reg::RDI, x64::Reg::RDI, 0)
        asm.alu_ri(7, x64::Reg::RDI, 128)
        asm.jcc(x64::Cc::BELOW, invalid)
        asm.alu_ri(7, x64::Reg::RDI, 191)
        asm.jcc(x64::Cc::ABOVE, invalid)
        asm.alu_ri(0, x64::Reg::RSI, 1)
        asm.jmp(rest)
        asm.bind(next)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R11)
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.jmp(top)
        asm.bind(ascii)
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.jmp(top)
        asm.bind(ok)
    }

    // `read_file(path)`: the file is read whole with its length by fseek and ftell, and its bytes are checked as UTF-8.
    fun read_file(mut self, asm: &mut x64::Asm, path: u64) -> bool {
        when !self.text_parts(asm, path, false) {
            return false
        }
        self.c_string(asm)
        asm.push(x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RCX, 25202)
        asm.push(x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
        self.aligned_call(asm, String("fopen"))
        asm.alu_ri(0, x64::Reg::RSP, 8)
        failed := asm.new_label()
        invalid := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, failed)
        // The stack: the file at 0 and the path at 8.
        asm.push(x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RSI, 0)
        asm.mov_ri(x64::Reg::RDX, 2)
        self.aligned_call(asm, String("fseek"))
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
        self.aligned_call(asm, String("ftell"))
        // The stack: the length at 0, the file at 8 and the path at 16.
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        asm.mov_ri(x64::Reg::RSI, 0)
        asm.mov_ri(x64::Reg::RDX, 0)
        self.aligned_call(asm, String("fseek"))
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
        asm.alu_ri(0, x64::Reg::RDI, 1)
        self.aligned_call(asm, String("malloc"))
        // The stack: the buffer at 0, the length at 8, the file at 16 and the path at 24.
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
        asm.mov_ri(x64::Reg::RSI, 1)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        self.aligned_call(asm, String("fread"))
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
        self.aligned_call(asm, String("fclose"))
        self.utf8_check(asm, invalid)
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.alu_ri(0, x64::Reg::RSP, 32)
        asm.jmp(done)
        asm.bind(failed)
        self.read_error(asm)
        asm.bind(invalid)
        self.fail_exit(asm, String("Ryn runtime error: file contents are not valid UTF-8\n"))
        asm.bind(done)
        return true
    }

    // `write_file(path, text)`: the file is created or truncated and the text written; the result is whether that succeeded.
    fun write_file(mut self, asm: &mut x64::Asm, path: u64, data: u64) -> bool {
        when !self.text_parts(asm, path, false) {
            return false
        }
        self.c_string(asm)
        asm.push(x64::Reg::RAX)
        when !self.text_parts(asm, data, false) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        // The stack: the length at 0, the text at 8 and the path at 16.
        asm.mov_ri(x64::Reg::RCX, 25207)
        asm.push(x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 24)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
        self.aligned_call(asm, String("fopen"))
        asm.alu_ri(0, x64::Reg::RSP, 8)
        failed := asm.new_label()
        bad := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, failed)
        // The stack: the file at 0, the length at 8, the text at 16 and the path at 24.
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
        asm.mov_ri(x64::Reg::RSI, 1)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        self.aligned_call(asm, String("fwrite"))
        // The stack: the bytes written at 0, the file at 8, the length at 16, the text at 24 and the path at 32.
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("fclose"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        asm.alu_ri(0, x64::Reg::RSP, 40)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        asm.jcc(x64::Cc::NOT_EQUAL, bad)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::NOT_EQUAL, bad)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.jmp(done)
        asm.bind(bad)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.jmp(done)
        asm.bind(failed)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `starts_with(prefix)` of a String: the prefix's bytes are the first bytes of the text. The prefix is a `str`, or
    // a String when `owned` is set.
    fun string_starts_with(mut self, asm: &mut x64::Asm, text: u64, prefix: u64, owned: bool) -> bool {
        when !self.text_parts(asm, text, true) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, prefix, owned) {
            return false
        }
        // rsi and rdx are the prefix's data and length; the text's length is popped first, then its data.
        asm.pop(x64::Reg::RCX)
        asm.pop(x64::Reg::RDI)
        no := asm.new_label()
        yes := asm.new_label()
        done := asm.new_label()
        looping := asm.new_label()
        asm.alu_rr(57, x64::Reg::RDX, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE, no)
        asm.mov_ri(x64::Reg::R9, 0)
        asm.bind(looping)
        asm.alu_rr(57, x64::Reg::R9, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, yes)
        asm.mov_rr(x64::Reg::R10, x64::Reg::RDI)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::R9)
        asm.load(1, false, x64::Reg::R10, x64::Reg::R10, 0)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R9)
        asm.load(1, false, x64::Reg::R11, x64::Reg::R11, 0)
        asm.alu_rr(57, x64::Reg::R10, x64::Reg::R11)
        asm.jcc(x64::Cc::NOT_EQUAL, no)
        asm.alu_ri(0, x64::Reg::R9, 1)
        asm.jmp(looping)
        asm.bind(yes)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.jmp(done)
        asm.bind(no)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `clone` of a String: a new header and a copy of its bytes, with the capacity of the length.
    fun string_clone(mut self, asm: &mut x64::Asm, source: u64) -> bool {
        when !self.expr(asm, source) {
            return false
        }
        self.clone_header(asm)
        return true
    }

    // The clone of the String whose header is in rax, left in rax.
    fun clone_header(mut self, asm: &mut x64::Asm) {
        asm.push(x64::Reg::RAX)
        // The copy of the bytes: malloc(len), then memcpy(copy, data, len).
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RAX, 8)
        self.aligned_call(asm, String("malloc"))
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RCX, 0)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("memcpy"))
        // The header: the copy, the length, and the capacity of the length. Stack: the copy at 0, the source header at 8.
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 16)
        asm.alu_ri(0, x64::Reg::RSP, 16)
    }

    // `push(c)` of a String: the character's UTF-8 bytes are encoded in an 8-byte buffer on the stack, and appended. The
    // stack is then: the text's length, its data (the buffer), the buffer, and the header.
    fun string_push(mut self, asm: &mut x64::Asm, receiver: u64, ch: u64) -> bool {
        when !self.expr(asm, receiver) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, ch) {
            return false
        }
        asm.alu_ri(5, x64::Reg::RSP, 8)
        self.encode_char(asm)
        asm.lea(x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        return self.append_pushed(asm, 24)
    }

    // `push_str` of a String: the text is appended, growing the buffer by doubling (at least to the new length) when it is
    // full. The header and the text stay on the stack while the calls run.
    fun string_append(mut self, asm: &mut x64::Asm, receiver: u64, text: u64, owned: bool) -> bool {
        when !self.expr(asm, receiver) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.text_parts(asm, text, owned) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        return self.append_pushed(asm, 16)
    }

    // The append of a text on the stack: its length at 0, its data at 8, and the String's header `header` bytes up, which
    // the three and whatever lies between them are popped from. The header is removed with them.
    fun append_pushed(mut self, asm: &mut x64::Asm, header: u64) -> bool {
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, header as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 16)
        room := asm.new_label()
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::BELOW_EQUAL, room)
        // The new capacity: twice the old one, but at least the new length and at least eight bytes.
        asm.mov_rr(x64::Reg::RSI, x64::Reg::R8)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RSI)
        big := asm.new_label()
        asm.alu_rr(57, x64::Reg::RSI, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, big)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RCX)
        asm.bind(big)
        eight := asm.new_label()
        asm.alu_ri(7, x64::Reg::RSI, 8)
        asm.jcc(x64::Cc::ABOVE_EQUAL, eight)
        asm.mov_ri(x64::Reg::RSI, 8)
        asm.bind(eight)
        asm.store(8, x64::Reg::RSI, x64::Reg::RDX, 16)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        self.aligned_call(asm, String("realloc"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, header as i64)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.bind(room)
        // memcpy(data + len, text, n), then len += n.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, header as i64)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        self.aligned_call(asm, String("memcpy"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, header as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.alu_ri(0, x64::Reg::RSP, (header + 8) as i64)
        return true
    }

    // A call of a C function with its arguments already in the registers, from an aligned stack.
    fun aligned_call(mut self, asm: &mut x64::Asm, name: String) {
        when self.freestanding {
            self.call_runtime(asm, name)
            return
        }
        symbol := self.foreign_symbol(name)
        asm.call_aligned(symbol)
    }

    // A call of a C function in a freestanding object: the runtime routine of that name, or a decline.
    fun call_runtime(mut self, asm: &mut x64::Asm, name: String) {
        label := self.runtime_label(name.clone())
        when label.is_none() {
            mut message := String("the C library function ")
            message.append(name)
            message.append(String(" in a freestanding program"))
            self.failed = true
            when self.reason.is_empty() {
                self.reason = message
            }
            return
        }
        asm.call_label(label.unwrap())
    }

    fun runtime_label(self, name: String) -> Option<u64> {
        when name == "ryn_native_live_allocations" { return Option::Some(self.rt.live_allocations) }
        when name == "ryn_native_live_bytes" { return Option::Some(self.rt.live_bytes) }
        when name == "malloc" { return Option::Some(self.rt.malloc) }
        when name == "free" { return Option::Some(self.rt.free) }
        when name == "realloc" { return Option::Some(self.rt.realloc) }
        when name == "calloc" { return Option::Some(self.rt.calloc) }
        when name == "memcpy" { return Option::Some(self.rt.memcpy) }
        when name == "memmove" { return Option::Some(self.rt.memmove) }
        when name == "strlen" { return Option::Some(self.rt.strlen) }
        when name == "fopen" { return Option::Some(self.rt.fopen) }
        when name == "fseek" { return Option::Some(self.rt.fseek) }
        when name == "ftell" { return Option::Some(self.rt.ftell) }
        when name == "fread" { return Option::Some(self.rt.fread) }
        when name == "fwrite" { return Option::Some(self.rt.fwrite) }
        when name == "fclose" { return Option::Some(self.rt.fclose) }
        when name == "strerror" { return Option::Some(self.rt.strerror) }
        when name == "__errno_location" { return Option::Some(self.rt.errno_location) }
        when name == "putchar" { return Option::Some(self.rt.putchar) }
        when name == "chmod" { return Option::Some(self.rt.chmod) }
        return Option::None
    }

    // The stream builtins: a write sends a string to standard output or error, and a flush has nothing to do.
    fun guarded_system(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        temps := self.borrowed_temporaries(arguments.clone(), 0)
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) { return false }
        ok := self.system_call(asm, op, arguments.clone())
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    fun system_call(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        when op == "FlushStdout" || op == "FlushStderr" {
            return true
        }
        when op == "Exit" && arguments.len() == 1 {
            // The status is evaluated first, then the owners are dropped, as the runtime's exit does, and the process ends.
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            self.drop_owners(asm)
            asm.pop(x64::Reg::RDI)
            asm.mov_ri(x64::Reg::RAX, 231)
            asm.syscall()
            return true
        }
        when op == "PointerIsNull" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            return true
        }
        when op.starts_with("Math") {
            return self.math_call(asm, op, arguments)
        }
        when (op != "WriteStdout" && op != "WriteStderr") || arguments.len() != 1 {
            return self.fail("a system call")
        }
        when self.string_literal(arguments[0]).is_some() {
            index := self.literal(self.string_literal(arguments[0]).unwrap())
            asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[index])
            asm.mov_ri(x64::Reg::RDX, self.literal_lengths[index])
        }
        when self.is_text_choice(arguments[0]) {
            when !self.text_choice(asm, arguments[0]) {
                return false
            }
        }
        when self.as_str_inner(arguments[0]).is_some() && self.is_text_choice(self.as_str_inner(arguments[0]).unwrap()) {
            when !self.text_choice(asm, self.as_str_inner(arguments[0]).unwrap()) {
                return false
            }
        }
        when self.as_str_inner(arguments[0]).is_some() && !self.is_text_choice(self.as_str_inner(arguments[0]).unwrap()) {
            // An owned String written as text: its header is the value, and the text is the header's data and length.
            when !self.expr(asm, self.as_str_inner(arguments[0]).unwrap()) {
                return false
            }
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
        }
        when self.string_literal(arguments[0]).is_none() && self.as_str_inner(arguments[0]).is_none() && !self.is_text_choice(arguments[0]) {
            source := self.struct_local_of(arguments[0])
            when source.is_none() {
                return self.fail("a string argument that is not a literal or a local")
            }
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, slot_disp(source.unwrap()))
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(source.unwrap() + 1))
        }
        when op == "WriteStderr" {
            asm.mov_ri(x64::Reg::RDI, 2)
        } else {
            asm.mov_ri(x64::Reg::RDI, 1)
        }
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
        return true
    }

    // The C library function that computes a math builtin of one argument, and "" for the others.
    fun math_function(self, op: String) -> String {
        when op == "MathSqrt" { return String("sqrt") }
        when op == "MathFloor" { return String("floor") }
        when op == "MathCeil" { return String("ceil") }
        when op == "MathRound" { return String("round") }
        when op == "MathSin" { return String("sin") }
        when op == "MathCos" { return String("cos") }
        when op == "MathTan" { return String("tan") }
        when op == "MathLog" { return String("log") }
        when op == "MathLog2" { return String("log2") }
        when op == "MathLog10" { return String("log10") }
        return String("")
    }

    // The `std::math` builtins, which take and give `f64`. Most call the C math library (which the program is linked with);
    // `abs`, `min`, `max` and `clamp` are computed here, with the rules of Rust's float methods: `min` and `max` give the
    // other value when one is NaN, and `clamp` gives NaN when the bounds are in the wrong order.
    fun math_call(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        when op == "MathAbs" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.mov_ri(x64::Reg::RCX, 1)
            asm.shift_cl(4, x64::Reg::RAX)
            asm.shift_cl(5, x64::Reg::RAX)
            return true
        }
        function := self.math_function(op.clone())
        when !function.is_empty() && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.movq_to_xmm(true, 0, x64::Reg::RAX)
            self.aligned_call(asm, function)
            asm.movq_from_xmm(true, x64::Reg::RAX, 0)
            return true
        }
        when op == "MathPow" && arguments.len() == 2 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.movq_to_xmm(true, 1, x64::Reg::RAX)
            asm.pop(x64::Reg::RAX)
            asm.movq_to_xmm(true, 0, x64::Reg::RAX)
            self.aligned_call(asm, String("pow"))
            asm.movq_from_xmm(true, x64::Reg::RAX, 0)
            return true
        }
        when (op == "MathMin" || op == "MathMax") && arguments.len() == 2 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            // rax is the first value and rcx the second, each also in an xmm register.
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.pop(x64::Reg::RAX)
            asm.movq_to_xmm(true, 0, x64::Reg::RAX)
            asm.movq_to_xmm(true, 1, x64::Reg::RCX)
            first := asm.new_label()
            second := asm.new_label()
            done := asm.new_label()
            asm.ucomis(8, 0, 0)
            asm.jcc(x64::Cc::PARITY, second)
            asm.ucomis(8, 1, 1)
            asm.jcc(x64::Cc::PARITY, first)
            asm.ucomis(8, 0, 1)
            when op == "MathMax" {
                asm.jcc(x64::Cc::ABOVE, first)
            } else {
                asm.jcc(x64::Cc::BELOW, first)
            }
            asm.bind(second)
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
            asm.bind(first)
            asm.bind(done)
            return true
        }
        when op == "MathClamp" && arguments.len() == 3 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[2]) {
                return false
            }
            // rax is the value, rcx the lower bound and rdx the upper bound.
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.pop(x64::Reg::RCX)
            asm.pop(x64::Reg::RAX)
            asm.movq_to_xmm(true, 0, x64::Reg::RAX)
            asm.movq_to_xmm(true, 1, x64::Reg::RCX)
            asm.movq_to_xmm(true, 2, x64::Reg::RDX)
            not_a_number := asm.new_label()
            keep := asm.new_label()
            lower := asm.new_label()
            upper := asm.new_label()
            done := asm.new_label()
            asm.ucomis(8, 1, 2)
            asm.jcc(x64::Cc::ABOVE, not_a_number)
            asm.ucomis(8, 0, 0)
            asm.jcc(x64::Cc::PARITY, keep)
            asm.ucomis(8, 0, 1)
            asm.jcc(x64::Cc::BELOW, lower)
            asm.ucomis(8, 0, 2)
            asm.jcc(x64::Cc::ABOVE, upper)
            asm.jmp(done)
            asm.bind(keep)
            asm.jmp(done)
            asm.bind(lower)
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
            asm.jmp(done)
            asm.bind(upper)
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
            asm.jmp(done)
            asm.bind(not_a_number)
            asm.mov_ri(x64::Reg::RAX, 0x7FF8000000000000)
            asm.bind(done)
            return true
        }
        return self.op_fail("a math function ", op)
    }

    // The tag of the variant of an enum that is called `name`, when the enum has one.
    fun variant_tag(self, id: u64, name: String) -> Option<u64> {
        mut index: u64 = 0
        while index < self.program.enums[id].variants.len() {
            when self.program.enums[id].variants[index].name == name {
                return Option::Some(index)
            }
            index += 1
        }
        return Option::None
    }

    // The tag of the variant that an unwrap takes: `Ok` of a Result, or `Some` of an Option.
    fun success_tag(self, id: u64) -> Option<u64> {
        when self.variant_tag(id, String("Ok")).is_some() {
            return self.variant_tag(id, String("Ok"))
        }
        return self.variant_tag(id, String("Some"))
    }

    // `is_some`, `is_none`, `is_ok` and `is_err`: the tag of the box is compared with the variant the predicate names.
    fun enum_predicate(mut self, asm: &mut x64::Asm, op: String, id: u64, arguments: Vec<u64>) -> bool {
        when arguments.len() != 1 {
            return self.fail("an enum predicate with another number of arguments")
        }
        mut name := String("")
        when op == "IsSome" {
            name = String("Some")
        }
        when op == "IsNone" {
            name = String("None")
        }
        when op == "IsOk" {
            name = String("Ok")
        }
        when op == "IsErr" {
            name = String("Err")
        }
        when name.len() == 0 {
            return self.fail("an enum predicate that is not in the subset")
        }
        found := self.variant_tag(id, name)
        when found.is_none() {
            return self.fail("an enum predicate on an enum without its variant")
        }
        when !self.expr(asm, arguments[0]) {
            return false
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.alu_ri(7, x64::Reg::RCX, found.unwrap() as i64)
        asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
        return true
    }

    // `unwrap_or` of an Option or a Result whose payload is one cell: the payload of the box when its tag is the success
    // tag, and otherwise the default, which is evaluated after the receiver, as the arguments are in order.
    fun enum_unwrap_or(mut self, asm: &mut x64::Asm, id: u64, ty: u64, arguments: Vec<u64>) -> bool {
        when arguments.len() != 2 {
            return self.fail("an unwrap with another number of arguments")
        }
        when !self.is_cell(ty) && self.aggregate_cells(ty) == 0 {
            return self.fail("an unwrap of a payload of this type")
        }
        when self.success_tag(id).is_none() {
            return self.fail("an unwrap of an enum that is not an Option or a Result")
        }
        tag := self.success_tag(id).unwrap()
        when !self.is_cell(ty) {
            return self.enum_unwrap_or_aggregate(asm, ty, tag, arguments)
        }
        when !self.expr(asm, arguments[0]) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, arguments[1]) {
            return false
        }
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.pop(x64::Reg::RAX)
        fallback := asm.new_label()
        done := asm.new_label()
        // The result is an owner of its own: a payload is copied from the box, and a borrowed fallback is copied too.
        owned := self.owned_cells(ty)
        mut copy: u64 = 0
        when owned.is_some() && owned.unwrap().len() == 3 {
            copy = 1
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.alu_ri(7, x64::Reg::RCX, tag as i64)
        asm.jcc(x64::Cc::NOT_EQUAL, fallback)
        when self.has_owners(ty) && !self.is_local_expr(arguments[1]) {
            asm.push(x64::Reg::RAX)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RDX)
            asm.call_label(self.handle_drop_routine(asm, ty))
            asm.pop(x64::Reg::RAX)
        }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 8)
        when copy == 1 {
            copies := self.owned_cells(ty).unwrap()
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.call_label(self.copy_routine(asm, copies[1], copies[2]))
        }
        asm.jmp(done)
        asm.bind(fallback)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
        when copy == 1 && self.is_local_expr(arguments[1]) {
            copies := self.owned_cells(ty).unwrap()
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.call_label(self.copy_routine(asm, copies[1], copies[2]))
        }
        asm.bind(done)
        return true
    }

    // Whether an expression reads a local without moving it: its value is borrowed, and a copy of it is an owner of its own.
    fun is_local_expr(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => true,
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.place_of(index).is_some(),
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => borrowed,
            _ => false,
        }
    }

    // `unwrap_or` of a string or structure payload: the payload's cells are pushed, as a call returns them, or else the
    // fallback is. The fallback is evaluated only on the fallback path, so it must be pure to keep the program's meaning.
    fun enum_unwrap_or_aggregate(mut self, asm: &mut x64::Asm, ty: u64, tag: u64, arguments: Vec<u64>) -> bool {
        when self.has_destructor(ty) { return self.fail("an unwrap of a payload with a destructor") }
        box := self.scratch(1)
        count := self.aggregate_cells(ty)
        default := self.scratch(count)
        when !self.expr(asm, arguments[0]) { return false }
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(box))
        when !self.push_value(asm, arguments[1], ty) { return false }
        when !self.store_pushed(asm, default, count) { return false }
        fallback := asm.new_label()
        done := asm.new_label()
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(box))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.alu_ri(7, x64::Reg::RCX, tag as i64)
        asm.jcc(x64::Cc::NOT_EQUAL, fallback)
        when !self.is_local_expr(arguments[1]) { self.drop_slot(asm, default, ty) }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(box))
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (1 + cell)) as i64)
            asm.push(x64::Reg::RCX)
            cell += 1
        }
        when !self.clone_stack_value(asm, ty) { return false }
        asm.jmp(done)
        asm.bind(fallback)
        when !self.push_local_cells(asm, default, count) { return false }
        when self.is_local_expr(arguments[1]) {
            when !self.clone_stack_value(asm, ty) { return false }
        }
        asm.bind(done)
        return true
    }

    // Replaces each owning cell of a pushed value with an independent copy.
    fun clone_stack_value(mut self, asm: &mut x64::Asm, ty: u64) -> bool {
        copies := self.owned_cells(ty)
        when copies.is_none() { return self.fail("a copy of this payload") }
        list := copies.unwrap()
        mut at: u64 = 0
        while at < list.len() {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, list[at] as i64)
            asm.call_label(self.copy_routine(asm, list[at + 1], list[at + 2]))
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, list[at] as i64)
            at += 3
        }
        return true
    }

    // `unwrap`, `expect` and `unwrap_err` of an Option or a Result whose payload is one cell. The wrong variant writes the
    // runtime's message to standard error and exits with status 1. An `expect` message must be a string literal, so that
    // the message is known when the code is generated.
    fun enum_unwrap(mut self, asm: &mut x64::Asm, id: u64, ty: u64, message: bool, tag: u64, failure: String, arguments: Vec<u64>) -> bool {
        mut expected: u64 = 1
        when message {
            expected = 2
        }
        when arguments.len() != expected {
            return self.fail("an unwrap with another number of arguments")
        }
        when !self.is_cell(ty) && self.aggregate_cells(ty) == 0 {
            return self.fail("an unwrap of a payload of this type")
        }
        when self.has_destructor(ty) {
            return self.fail("an unwrap of a payload with a destructor")
        }
        mut text := String("")
        when failure == "OptionUnwrapFailed" {
            text = String("Ryn runtime error: called Option.unwrap() on None\n")
        }
        when failure == "ResultUnwrapFailed" {
            text = String("Ryn runtime error: called Result extraction on the wrong variant\n")
        }
        when failure == "OptionExpectFailed" {
            when !message {
                return self.fail("an expect without a message")
            }
            literal := self.string_literal(arguments[1])
            when literal.is_none() {
                return self.fail("an expect message that is not a literal")
            }
            text = String("Ryn runtime error: ")
            text.append(literal.unwrap())
            text.append(String("\n"))
        }
        when text.len() == 0 {
            return self.fail("an unwrap failure that is not in the subset")
        }
        when !self.expr(asm, arguments[0]) {
            return false
        }
        done := asm.new_label()
        failed := asm.new_label()
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.alu_ri(7, x64::Reg::RCX, tag as i64)
        asm.jcc(x64::Cc::NOT_EQUAL, failed)
        when self.is_cell(ty) {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 8)
            // The payload is a copy of what the box owns, as the runtime's unwrap copies it; the box keeps its own.
            owned := self.owned_cells(ty)
            when owned.is_some() && owned.unwrap().len() == 3 {
                copies := self.owned_cells(ty).unwrap()
                asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
                asm.call_label(self.copy_routine(asm, copies[1], copies[2]))
            }
        } else {
            // A string or structure payload is pushed as its cells, as a call returns it.
            count := self.aggregate_cells(ty)
            mut cell: u64 = 0
            while cell < count {
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (1 + cell)) as i64)
                asm.push(x64::Reg::RCX)
                cell += 1
            }
            // The payload's owners are copies too: each is replaced on the stack by its copy.
            copies := self.owned_cells(ty)
            when copies.is_some() {
                list := copies.unwrap()
                mut at: u64 = 0
                while at < list.len() {
                    asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, list[at] as i64)
                    asm.call_label(self.copy_routine(asm, list[at + 1], list[at + 2]))
                    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, list[at] as i64)
                    at += 3
                }
            }
        }
        asm.jmp(done)
        asm.bind(failed)
        self.fail_exit(asm, text)
        asm.bind(done)
        return true
    }

    // A call of a C function with scalar, pointer and bool arguments and result: the arguments go to the System V
    // registers, the stack is aligned for the call, and the result is in rax, brought to its width.
    fun call_foreign(mut self, asm: &mut x64::Asm, parameters: Vec<u64>, result: Option<u64>, name: String, arguments: Vec<u64>) -> bool {
        when arguments.len() != parameters.len() / 2 {
            return self.fail("a foreign call with this number of arguments")
        }
        mut types: Vec<u64> = Vec()
        mut position: u64 = 0
        for argument in arguments.clone() {
            types.push(parameters[position * 2 + 1])
            when !self.push_value(asm, argument, parameters[position * 2 + 1]) {
                return false
            }
            position += 1
        }
        when !self.load_c_arguments(asm, types) {
            return false
        }
        self.sync_shadows(asm, false)
        self.aligned_call(asm, name)
        return self.finish_c_call(asm, result)
    }

    // After a foreign call: the result is taken, and the `repr(C)` locals whose address was given out are read back from
    // their C layout (the result in rax is kept across that).
    fun finish_c_call(mut self, asm: &mut x64::Asm, result: Option<u64>) -> bool {
        when !self.take_c_result(asm, result) {
            return false
        }
        when self.shadow_slots.len() > 0 {
            asm.push(x64::Reg::RAX)
            self.sync_shadows(asm, true)
            asm.pop(x64::Reg::RAX)
        }
        return true
    }

    // Pushes the cells of a value of type `ty`, in cell order: a scalar is one, a str is its address and length, and a
    // structure is its fields in declaration order, each taking its own cells. A structure value is pushed in field
    // order only, because the fields are evaluated in the order they are written.
    fun push_value(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        when self.is_str(ty) {
            literal := self.string_literal(value)
            when literal.is_some() {
                index := self.literal(literal.unwrap())
                asm.lea_symbol(x64::Reg::RAX, self.literal_symbols[index])
                asm.push(x64::Reg::RAX)
                asm.mov_ri(x64::Reg::RAX, self.literal_lengths[index])
                asm.push(x64::Reg::RAX)
                return true
            }
            source := self.struct_local_of(value)
            when source.is_none() {
                return choose self.program.exprs[value] {
                    ir::IrExpr::MoveRef(slot, mty) => self.push_local_cells(asm, slot, 2),
                    ir::IrExpr::CallExpr(target, arguments, cty) => self.call_expression(asm, target, arguments),
                    ir::IrExpr::FieldRead(fv, fid, field, fty, fspan) => self.push_field_str(asm, value),
                    ir::IrExpr::ReferenceFieldRead(rp, rid, rfield, rty, rspan, rborrowed) => self.push_field_str(asm, value),
                    ir::IrExpr::StringAsStr(inner) => self.push_string_as_str(asm, inner),
                    ir::IrExpr::IfExpr(condition, then_value, else_value, ity) => self.push_if(asm, condition, then_value, else_value, ity),
                    ir::IrExpr::EnumMatch(matched, mid, arms, mty) => self.enum_match(asm, matched, mid, arms, mty),
                    _ => self.fail_at("a string argument that is not a literal or a local", value),
                }
            }
            return self.push_local_cells(asm, source.unwrap(), 2)
        }
        when self.is_cell(ty) {
            when !self.expr(asm, value) {
                return false
            }
            asm.push(x64::Reg::RAX)
            return true
        }
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.push_structure(asm, value, id),
            ir::IrTy::ArrayOf(element, length) => self.push_array(asm, value, ty),
            ir::IrTy::SliceOf(element) => self.push_slice(asm, value),
            _ => self.fail("an argument of this type"),
        }
    }

    fun push_structure(mut self, asm: &mut x64::Asm, value: u64, id: u64) -> bool {
        base := self.place_of(value)
        when base.is_some() && self.struct_destructor_cells(id).len() == 0 {
            return self.push_local_cells(asm, base.unwrap(), self.program.structs[id].slot_count)
        }
        when self.is_memory_place(value) && self.struct_destructor_cells(id).len() == 0 {
            when !self.memory_address(asm, value) {
                return false
            }
            self.copy_ty_id = 0
            when self.program.structs[id].repr_c {
                self.copy_ty_id = id + 1
            }
            result := self.push_memory_cells(asm, self.program.structs[id].slot_count)
            self.copy_ty_id = 0
            when result && !self.memory_borrowed(value) {
                return self.clone_stack_value(asm, self.struct_type(id))
            }
            return result
        }
        return choose self.program.exprs[value] {
            ir::IrExpr::Propagate(v, input, output, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred) => self.push_propagated(asm, v, id, failure_type, success_variant, output_failure_variant, deferred),
            ir::IrExpr::LocalRef(slot, ty, span) => self.push_local_cells(asm, slot, self.program.structs[id].slot_count),
            ir::IrExpr::StructValue(sid, fields, values) => self.push_fields(asm, sid, fields, values),
            ir::IrExpr::MoveRef(slot, mty) => self.push_moved(asm, slot, id),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_expression(asm, target, arguments),
            ir::IrExpr::EnumMatch(matched, mid, arms, mty) => self.enum_match(asm, matched, mid, arms, mty),
            ir::IrExpr::IfExpr(condition, then_value, else_value, ity) => self.push_if(asm, condition, then_value, else_value, ity),
            ir::IrExpr::FieldRead(outer, oid, field, fty, fspan) => self.push_field_struct(asm, outer, oid, field, id),
            _ => self.fail_at("a structure argument", value),
        }
    }

    fun push_fields(mut self, asm: &mut x64::Asm, id: u64, fields: Vec<u64>, values: Vec<u64>) -> bool {
        when fields.len() != self.program.structs[id].fields.len() {
            return self.fail("a structure value with missing fields")
        }
        mut position: u64 = 0
        while position < fields.len() {
            when fields[position] != position {
                return self.fail("a structure value out of field order")
            }
            field_ty := self.program.structs[id].fields[position].ty
            when !self.push_value(asm, values[position], field_ty) {
                return false
            }
            position += 1
        }
        return true
    }

    // A structure local moved out: its cells are pushed, and its destructor handles are nulled.
    fun push_moved(mut self, asm: &mut x64::Asm, slot: u64, id: u64) -> bool {
        when !self.push_local_cells(asm, slot, self.program.structs[id].slot_count) {
            return false
        }
        self.null_moved(asm, slot, id)
        return true
    }

    // A structure local moved into the cells from `base` on: copied, and its destructor handles are nulled.
    fun store_moved(mut self, asm: &mut x64::Asm, slot: u64, base: u64, id: u64) -> bool {
        when !self.copy_cells(asm, slot, base, self.program.structs[id].slot_count) {
            return false
        }
        self.null_moved(asm, slot, id)
        return true
    }

    // Pushes `count` cells of the local at `slot`, from its first cell.
    fun push_local_cells(mut self, asm: &mut x64::Asm, slot: u64, count: u64) -> bool {
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot + cell))
            asm.push(x64::Reg::RAX)
            cell += 1
        }
        return true
    }

    // The number of cells a parameter of type `ty` takes: a structure takes its slot count.
    fun cells_of(self, ty: u64) -> u64 {
        when self.is_str(ty) {
            return 2
        }
        structure_cells := choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.program.structs[id].slot_count,
            _ => 0,
        }
        when structure_cells > 0 {
            return structure_cells
        }
        when self.array_element_of(ty).is_some() {
            return self.array_length_of(ty)
        }
        when self.slice_element(ty).is_some() {
            return 2
        }
        when self.is_cell(ty) {
            return 1
        }
        return 0
    }

    // The cells that a string, array or structure value takes on the stack, and zero for any other type.
    fun aggregate_cells(self, ty: u64) -> u64 {
        when self.is_str(ty) {
            return 2
        }
        when self.array_element_of(ty).is_some() {
            return self.array_length_of(ty)
        }
        when self.slice_element(ty).is_some() {
            return 2
        }
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.program.structs[id].slot_count,
            _ => 0,
        }
    }

    // The first cell of a structure local, when the expression is one.
    fun struct_local_of(self, index: u64) -> Option<u64> {
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => Option::Some(slot),
            _ => Option::None,
        }
    }

    // The slot of an array local, when the expression is one.
    fun array_local_of(self, index: u64) -> Option<u64> {
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => Option::Some(slot),
            ir::IrExpr::MoveRef(slot, ty) => Option::Some(slot),
            _ => Option::None,
        }
    }

    // Whether a type is a scalar of one cell with no ownership: an integer, bool, char or float. Arrays hold only these.
    fun is_plain_scalar(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => width_of(word) != 0,
            _ => false,
        }
    }

    // The element type of an array of plain scalars, or None for any other type. An array takes one cell per element,
    // element `i` in cell `slot + i`, as the frame layout of a structure's fields does.
    fun array_element_of(self, ty: u64) -> Option<u64> {
        found := choose self.program.types[ty] {
            ir::IrTy::ArrayOf(element, length) => Option::Some(element),
            _ => Option::None,
        }
        when found.is_none() {
            return Option::None
        }
        when !self.is_plain_scalar(found.unwrap()) {
            return Option::None
        }
        return found
    }

    // The number of elements of an array type, and zero for any other type.
    fun array_length_of(self, ty: u64) -> u64 {
        return choose self.program.types[ty] {
            ir::IrTy::ArrayOf(element, length) => length,
            _ => 0,
        }
    }

    // Leaves rdx at the address that element `index` of an array is found from: element 0 of an array of `n` at slot `s` is
    // its lowest cell, `s + n - 1`, and element `i` is `8 * i` above it, at `rdx + slot_disp(s + n - 1)`. The index is
    // copied to rcx and scaled there, so rcx and r11 are clobbered and the index register is kept.
    fun element_base(self, asm: &mut x64::Asm, index: u64) {
        asm.mov_rr(x64::Reg::RCX, index)
        self.scale_bytes(asm, x64::Reg::RCX, 8)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RBP)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RCX)
    }

    // Pushes the value of each item in order, so that item `i` is the cell that a pushed array has at position `i`.
    fun push_array_items(mut self, asm: &mut x64::Asm, items: Vec<u64>) -> bool {
        mut position: u64 = 0
        while position < items.len() {
            when !self.expr(asm, items[position]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            position += 1
        }
        return true
    }

    // `[item; count]`: the item is evaluated once, and its value is pushed `count` times.
    fun push_array_repeat(mut self, asm: &mut x64::Asm, item: u64, count: u64) -> bool {
        when !self.expr(asm, item) {
            return false
        }
        mut at: u64 = 0
        while at < count {
            asm.push(x64::Reg::RAX)
            at += 1
        }
        return true
    }

    // An array of plain scalars pushed as its cells, element 0 first, as an argument or a returned value is pushed.
    fun push_array(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        when self.array_element_of(ty).is_none() {
            return self.fail("an array of this element type")
        }
        length := self.array_length_of(ty)
        return choose self.program.exprs[value] {
            ir::IrExpr::ArrayValue(items) => self.push_array_through_scratch(asm, value, ty),
            ir::IrExpr::ArrayRepeat(item, count) => self.push_array_through_scratch(asm, value, ty),
            ir::IrExpr::LocalRef(slot, lty, span) => self.push_local_cells(asm, slot, length),
            ir::IrExpr::MoveRef(slot, mty) => self.push_local_cells(asm, slot, length),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_expression(asm, target, arguments),
            _ => self.fail("an array argument of this kind"),
        }
    }

    // Stores an array of plain scalars into the cells from `base` on. The items of a value are all evaluated before any
    // cell is written, since the value may read the array it replaces.
    fun store_array(mut self, asm: &mut x64::Asm, value: u64, base: u64, ty: u64) -> bool {
        when self.array_element_of(ty).is_none() {
            return self.fail("an array of this element type")
        }
        return self.store_array_parts(asm, value, base, self.array_element_of(ty).unwrap(), self.array_length_of(ty))
    }

    // An array value pushed as its cells: it is built in scratch cells first, since its cells are in the reverse of the
    // order its items are evaluated in.
    fun push_array_through_scratch(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        length := self.array_length_of(ty)
        base := self.scratch(length)
        when !self.store_array(asm, value, base, ty) {
            return false
        }
        return self.push_local_cells(asm, base, length)
    }

    // `count` scratch cells of the function being generated, as the slot of the first.
    fun scratch(mut self, count: u64) -> u64 {
        slot := self.scratch_base + self.scratch_used
        self.scratch_used += count
        return slot
    }

    fun store_array_parts(mut self, asm: &mut x64::Asm, value: u64, base: u64, element: u64, length: u64) -> bool {
        return choose self.program.exprs[value] {
            ir::IrExpr::ArrayValue(items) => self.store_array_items(asm, items, base, element),
            ir::IrExpr::ArrayRepeat(item, count) => self.store_array_repeat(asm, item, base, element, count),
            ir::IrExpr::LocalRef(slot, lty, span) => self.copy_cells(asm, slot, base, length),
            ir::IrExpr::MoveRef(slot, mty) => self.copy_cells(asm, slot, base, length),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_into(asm, target, arguments, base, length),
            _ => self.fail("an array value of this kind"),
        }
    }

    // The items are pushed, then stored last to first. Element `i` of an array of `n` is in cell `base + n - 1 - i`, so the
    // elements ascend in memory from the lowest cell, as a slice of them reads them.
    fun store_array_items(mut self, asm: &mut x64::Asm, items: Vec<u64>, base: u64, element: u64) -> bool {
        count := items.len()
        mut at: u64 = count
        when !self.push_array_items(asm, items) {
            return false
        }
        while at > 0 {
            at -= 1
            asm.pop(x64::Reg::RAX)
            self.store_cell(asm, element, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + count - 1 - at))
        }
        return true
    }

    // `[item; count]` stored into the cells from `base` on: the item is evaluated once, and its value goes to every cell.
    fun store_array_repeat(mut self, asm: &mut x64::Asm, item: u64, base: u64, element: u64, count: u64) -> bool {
        when !self.expr(asm, item) {
            return false
        }
        mut at: u64 = 0
        while at < count {
            self.store_cell(asm, element, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + at))
            at += 1
        }
        return true
    }

    // `array[index]` of an array local. The index is checked as unsigned against the length: a negative index of a signed
    // type is a huge unsigned value, so it fails the same check as one past the end. The element is loaded from its cell.
    fun array_index(mut self, asm: &mut x64::Asm, array: u64, index: u64, element: u64, length: u64) -> bool {
        when !self.is_plain_scalar(element) {
            return self.fail("an element of this array type")
        }
        slot := self.array_local_of(array)
        when slot.is_none() {
            return self.fail("an index into an array that is not a local")
        }
        when !self.expr(asm, index) {
            return false
        }
        asm.alu_ri(7, x64::Reg::RAX, length as i64)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        self.element_base(asm, x64::Reg::RAX)
        return self.load_cell(asm, element, x64::Reg::RDX, slot_disp(slot.unwrap() + length - 1))
    }

    // The element type of a slice type, or None for any other type. A slice is two cells: the address of its first
    // element and its length; its elements ascend in memory, `8 * cells` apart.
    fun slice_element(self, ty: u64) -> Option<u64> {
        return choose self.program.types[ty] {
            ir::IrTy::SliceOf(element) => Option::Some(element),
            _ => Option::None,
        }
    }

    // The address and length of a slice, in rax and rdx: a slice local, a view of a Vec, or a view of an array (a
    // temporary array is built in scratch cells, which live as long as the function's frame).
    fun slice_parts(mut self, asm: &mut x64::Asm, value: u64) -> bool {
        local := self.array_local_of(value)
        when local.is_some() {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(local.unwrap()))
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(local.unwrap() + 1))
            return true
        }
        return choose self.program.exprs[value] {
            ir::IrExpr::ArrayAsSlice(array, slice_ty, length) => self.array_as_slice(asm, array, slice_ty, length),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.slice_call(asm, target, arguments),
            _ => self.fail("a slice of this kind"),
        }
    }

    fun slice_call(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>) -> bool {
        return choose target {
            ir::CallTarget::VecSlice(element) => self.vec_slice(asm, element, arguments),
            _ => self.fail("a slice from this call"),
        }
    }

    // `array` viewed as a slice; the IR names the element type.
    fun array_as_slice(mut self, asm: &mut x64::Asm, array: u64, element_ty: u64, length: u64) -> bool {
        element: Option<u64> = Option::Some(element_ty)
        when !self.is_plain_scalar(element.unwrap()) {
            return self.fail("a slice of an array of this element type")
        }
        when length == 0 {
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RBP)
            asm.mov_ri(x64::Reg::RDX, 0)
            return true
        }
        mut slot: u64 = 0
        local := self.array_local_of(array)
        when local.is_some() {
            slot = local.unwrap()
        } else {
            slot = self.scratch(length)
            when !self.store_array_parts(asm, array, slot, element.unwrap(), length) {
                return false
            }
        }
        asm.lea(x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot + length - 1))
        asm.mov_ri(x64::Reg::RDX, length)
        return true
    }

    // `vec.slice(start, end)` and `vec.as_slice()`: the range is checked as the runtime checks it, and the view starts at
    // element `start` of the vector's data.
    fun vec_slice(mut self, asm: &mut x64::Asm, element: u64, arguments: Vec<u64>) -> bool {
        when arguments.len() != 3 {
            return self.fail("a vector slice with this number of arguments")
        }
        stride := self.cells_of(element) * 8
        when stride == 0 {
            return self.fail("a vector slice of this element type")
        }
        when !self.expr(asm, arguments[0]) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, arguments[1]) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, arguments[2]) {
            return false
        }
        asm.pop(x64::Reg::RCX)
        asm.pop(x64::Reg::RDX)
        bad_start := asm.new_label()
        bad_end := asm.new_label()
        done := asm.new_label()
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::ABOVE, bad_start)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::BELOW, bad_end)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::R8)
        asm.jcc(x64::Cc::ABOVE, bad_end)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        asm.alu_rr(41, x64::Reg::R9, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::RCX, stride)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RSI)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::R9)
        asm.jmp(done)
        asm.bind(bad_start)
        self.fail_exit(asm, String("Ryn runtime error: Vec slice start is out of bounds\n"))
        asm.bind(bad_end)
        self.fail_exit(asm, String("Ryn runtime error: Vec slice end is out of bounds\n"))
        asm.bind(done)
        return true
    }

    fun store_slice(mut self, asm: &mut x64::Asm, value: u64, base: u64) -> bool {
        when !self.slice_parts(asm, value) {
            return false
        }
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base))
        asm.store(8, x64::Reg::RDX, x64::Reg::RBP, slot_disp(base + 1))
        return true
    }

    fun push_slice(mut self, asm: &mut x64::Asm, value: u64) -> bool {
        when !self.slice_parts(asm, value) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.push(x64::Reg::RDX)
        return true
    }

    fun slice_len(mut self, asm: &mut x64::Asm, arguments: Vec<u64>) -> bool {
        when arguments.len() != 1 {
            return self.fail("a slice length with this number of arguments")
        }
        when !self.slice_parts(asm, arguments[0]) {
            return false
        }
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
        return true
    }

    // `slice[index]` (or `&slice[index]` when `address`): the index is checked against the length, and the element, a
    // value of one cell that owns nothing, is read at its place (or its address is the value).
    fun slice_index(mut self, asm: &mut x64::Asm, slice: u64, index: u64, element: u64, address: bool) -> bool {
        when !self.is_cell(element) || self.is_leakable(element) {
            return self.fail("a slice element of this type")
        }
        when !self.slice_parts(asm, slice) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.push(x64::Reg::RDX)
        when !self.expr(asm, index) {
            return false
        }
        asm.pop(x64::Reg::RDX)
        asm.pop(x64::Reg::RCX)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
        when address {
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
            return true
        }
        return self.load_cell(asm, element, x64::Reg::RCX, 0)
    }

    // The address of a function, as a function pointer: the address of its C-convention entry point, so that C code and
    // indirect calls both call it with the arguments in registers.
    fun function_address(mut self, asm: &mut x64::Asm, function: u64) -> bool {
        when self.program.functions[function].external_symbol.is_some() {
            return self.fail("the address of a foreign function")
        }
        self.needed.set(function, true)
        mut at: u64 = 0
        while at < self.thunk_functions.len() {
            when self.thunk_functions[at] == function {
                asm.lea_label(x64::Reg::RAX, self.thunk_labels[at])
                return true
            }
            at += 1
        }
        label := asm.new_label()
        self.thunk_functions.push(function)
        self.thunk_labels.push(label)
        asm.lea_label(x64::Reg::RAX, label)
        return true
    }

    // Whether a parameter or result type travels in an SSE register in a C call.
    fun is_sse(self, ty: u64) -> bool {
        return self.is_float(ty)
    }

    // The entry points of the functions whose address is taken: each takes its arguments in the C registers, pushes them
    // as the function's own calls do, calls it, and gives the result in rax (xmm0 for a float).
    fun emit_thunks(mut self, asm: &mut x64::Asm) -> bool {
        mut at: u64 = 0
        while at < self.thunk_functions.len() {
            definition := self.program.functions[self.thunk_functions[at]]
            asm.bind(self.thunk_labels[at])
            asm.push(x64::Reg::RBP)
            asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
            mut integers: u64 = 0
            mut floats: u64 = 0
            mut pair: u64 = 0
            while pair < definition.parameters.len() / 2 {
                ty := definition.parameters[pair * 2 + 1]
                when self.cells_of(ty) != 1 {
                    return self.fail("a function pointer to a function with a parameter of this type")
                }
                when self.is_sse(ty) {
                    when floats >= 8 {
                        return self.fail("a function pointer to a function with this many float parameters")
                    }
                    asm.movq_from_xmm(self.word(ty) == "F64", x64::Reg::RAX, floats)
                    asm.push(x64::Reg::RAX)
                    floats += 1
                } else {
                    when integers >= 6 {
                        return self.fail("a function pointer to a function with this many parameters")
                    }
                    asm.push(arg_register(integers))
                    integers += 1
                }
                pair += 1
            }
            when definition.return_type.is_some() {
                when self.aggregate_cells(definition.return_type.unwrap()) > 0 {
                    return self.fail("a function pointer to a function with a result of this type")
                }
            }
            asm.call_label(self.labels[self.thunk_functions[at]])
            when definition.return_type.is_some() {
                when self.is_sse(definition.return_type.unwrap()) {
                    asm.movq_to_xmm(self.word(definition.return_type.unwrap()) == "F64", 0, x64::Reg::RAX)
                }
            }
            asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
            asm.pop(x64::Reg::RBP)
            asm.ret()
            at += 1
        }
        return true
    }

    // The System V classes of the eightbytes of a `repr(C)` structure of plain scalars no larger than 16 bytes: 0 for an
    // eightbyte that goes in an integer register, 1 for one that goes in an SSE register (all its fields are floats). Empty
    // for any other type.
    fun c_classes(self, ty: u64) -> Vec<u64> {
        id := choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => id,
            _ => 0,
        }
        mut classes: Vec<u64> = Vec()
        when !self.is_repr_c_structure(ty) {
            return classes
        }
        when !self.c_fields_are_scalars(id) {
            return classes
        }
        size := self.struct_c_size(id)
        when size == 0 {
            return classes
        }
        when size > 16 {
            return classes
        }
        mut count: u64 = (size + 7) / 8
        mut at: u64 = 0
        while at < count {
            classes.push(1)
            at += 1
        }
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            when !self.is_float(self.program.structs[id].fields[position].ty) {
                classes.set(self.c_field_offset(id, position) / 8, 0)
            }
            position += 1
        }
        return classes
    }

    // Moves the arguments that were pushed in order into the C argument registers: integers and pointers to rdi, rsi, rdx,
    // rcx, r8 and r9 in turn, floats to xmm0 to xmm7, and each eightbyte of a small `repr(C)` structure to the next register
    // of its class. A scalar was pushed as one cell; a structure as its cells, whose first eightbyte is on top.
    fun load_c_arguments(mut self, asm: &mut x64::Asm, types: Vec<u64>) -> bool {
        mut registers: Vec<u64> = Vec()
        mut sse: Vec<bool> = Vec()
        mut firsts: Vec<u64> = Vec()
        mut integers: u64 = 0
        mut floats: u64 = 0
        for ty in types.clone() {
            firsts.push(registers.len())
            classes := self.c_classes(ty)
            when classes.len() > 0 {
                for class in classes {
                    when class == 1 {
                        when floats >= 8 {
                            return self.fail("a foreign call with this many float arguments")
                        }
                        registers.push(floats)
                        sse.push(true)
                        floats += 1
                    } else {
                        when integers >= 6 {
                            return self.fail("a foreign call with this many arguments")
                        }
                        registers.push(arg_register(integers))
                        sse.push(false)
                        integers += 1
                    }
                }
            } else {
                when self.cells_of(ty) != 1 {
                    return self.fail("a foreign argument of this type")
                }
                when self.is_sse(ty) {
                    when floats >= 8 {
                        return self.fail("a foreign call with this many float arguments")
                    }
                    registers.push(floats)
                    sse.push(true)
                    floats += 1
                } else {
                    when integers >= 6 {
                        return self.fail("a foreign call with this many arguments")
                    }
                    registers.push(arg_register(integers))
                    sse.push(false)
                    integers += 1
                }
            }
        }
        mut index: u64 = types.len()
        while index > 0 {
            index -= 1
            classes := self.c_classes(types[index])
            when classes.len() > 0 {
                // The structure's fields go into a two-word image in C layout below its cells, and the words are loaded.
                asm.alu_ri(5, x64::Reg::RSP, 16)
                asm.mov_ri(x64::Reg::RAX, 0)
                asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 0)
                asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 8)
                asm.lea(x64::Reg::RSI, x64::Reg::RSP, 16)
                self.pack_to_image(asm, self.struct_id_of(types[index]), x64::Reg::RSI, x64::Reg::RSP)
                mut word: u64 = 0
                while word < classes.len() {
                    asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * word) as i64)
                    when sse[firsts[index] + word] {
                        asm.movq_to_xmm(true, registers[firsts[index] + word], x64::Reg::RAX)
                    } else {
                        asm.mov_rr(registers[firsts[index] + word], x64::Reg::RAX)
                    }
                    word += 1
                }
                asm.alu_ri(0, x64::Reg::RSP, (self.cells_of(types[index]) * 8 + 16) as i64)
            } else {
                when sse[firsts[index]] {
                    asm.pop(x64::Reg::RAX)
                    asm.movq_to_xmm(self.word(types[index]) == "F64", registers[firsts[index]], x64::Reg::RAX)
                } else {
                    asm.pop(registers[firsts[index]])
                }
            }
        }
        return true
    }

    // The result of a C call: a small `repr(C)` structure from its registers (rax and rdx for integer eightbytes, xmm0 and
    // xmm1 for float ones, in order), left on the stack as the cells of a pushed value; any other result into rax: a float
    // from xmm0, an integer extended as its type says.
    fun take_c_result(mut self, asm: &mut x64::Asm, result: Option<u64>) -> bool {
        when result.is_none() {
            return true
        }
        ty := result.unwrap()
        classes := self.c_classes(ty)
        when classes.len() > 0 {
            cells := self.cells_of(ty)
            asm.alu_ri(5, x64::Reg::RSP, (8 * cells + 16) as i64)
            mut integers: u64 = 0
            mut floats: u64 = 0
            mut word: u64 = 0
            while word < classes.len() {
                when classes[word] == 1 {
                    asm.sse_store(8, floats, x64::Reg::RSP, (8 * word) as i64)
                    floats += 1
                } else {
                    when integers == 0 {
                        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, (8 * word) as i64)
                    } else {
                        asm.store(8, x64::Reg::RDX, x64::Reg::RSP, (8 * word) as i64)
                    }
                    integers += 1
                }
                word += 1
            }
            asm.lea(x64::Reg::RSI, x64::Reg::RSP, 16)
            self.unpack_from_image(asm, self.struct_id_of(ty), x64::Reg::RSP, x64::Reg::RSI)
            asm.alu_ri(0, x64::Reg::RSP, 16)
            return true
        }
        when self.cells_of(ty) != 1 {
            return self.fail("a foreign result of this type")
        }
        when self.is_sse(ty) {
            asm.movq_from_xmm(self.word(ty) == "F64", x64::Reg::RAX, 0)
            return true
        }
        self.normalize(asm, self.word(ty))
        return true
    }

    // The parameter types of a function pointer type.
    fun pointer_parameters(self, id: u64) -> Vec<u64> {
        return choose self.program.types[id] {
            ir::IrTy::FunctionPointerTo(parameters, result, external) => parameters,
            _ => Vec(),
        }
    }

    // The result type of a function pointer type, if it has one.
    fun pointer_result(self, id: u64) -> Option<u64> {
        return choose self.program.types[id] {
            ir::IrTy::FunctionPointerTo(parameters, result, external) => result,
            _ => Option::None,
        }
    }

    // A call through a function pointer: the pointer is evaluated first, then the arguments, which go to the C registers.
    fun indirect_call(mut self, asm: &mut x64::Asm, id: u64, arguments: Vec<u64>) -> bool {
        parameters := self.pointer_parameters(id)
        when arguments.len() != parameters.len() + 1 {
            return self.fail("a call through a value that is not a function pointer")
        }
        mut position: u64 = 0
        while position < arguments.len() {
            when !self.expr(asm, arguments[position]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            position += 1
        }
        when !self.load_c_arguments(asm, parameters) {
            return false
        }
        asm.pop(x64::Reg::R11)
        asm.push(x64::Reg::RBX)
        asm.mov_rr(x64::Reg::RBX, x64::Reg::RSP)
        asm.alu_ri(4, x64::Reg::RSP, (0 as i64) - 16)
        asm.call_reg(x64::Reg::R11)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBX)
        asm.pop(x64::Reg::RBX)
        return self.finish_c_call(asm, self.pointer_result(id))
    }

    // `array[index] = value` for a mutable array local. The index is checked before the value is evaluated, as the
    // bootstrap compiler does, and it waits on the stack while the value is computed.
    fun array_assign(mut self, asm: &mut x64::Asm, slot: u64, element: u64, length: u64, index: u64, value: u64) -> bool {
        when !self.is_plain_scalar(element) {
            return self.fail("an element of this array type")
        }
        when !self.expr(asm, index) {
            return false
        }
        asm.alu_ri(7, x64::Reg::RAX, length as i64)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, value) {
            return false
        }
        asm.pop(x64::Reg::RCX)
        self.element_base(asm, x64::Reg::RCX)
        return self.store_cell(asm, element, x64::Reg::RAX, x64::Reg::RDX, slot_disp(slot + length - 1))
    }

    fun expr(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        mut at: u64 = 0
        while at < self.temp_exprs.len() {
            when self.temp_exprs[at] == index {
                when !self.temp_ready[at] {
                    self.temp_ready.set(at, true)
                    when !self.expr_inner(asm, index) { return false }
                    asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(self.temp_cells[at]))
                }
                asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(self.temp_cells[at]))
                return true
            }
            at += 1
        }
        return self.expr_inner(asm, index)
    }

    fun expr_inner(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::IntegerLit(text, ty) => self.integer(asm, text, ty),
            ir::IrExpr::BoolLit(value) => self.boolean(asm, value),
            ir::IrExpr::CharLit(scalar) => self.char_value(asm, scalar),
            ir::IrExpr::LocalRef(slot, ty, span) => self.local(asm, slot, ty),
            ir::IrExpr::Binary(op, left, right, ty) => self.binary(asm, op, left, right, ty),
            ir::IrExpr::Negate(value, ty) => self.negate(asm, value, ty),
            ir::IrExpr::Not(value) => self.not(asm, value),
            ir::IrExpr::BitNot(value, ty) => self.bit_not(asm, value, ty),
            ir::IrExpr::CastExpr(value, source, target) => self.cast(asm, value, source, target),
            ir::IrExpr::CallExpr(target, arguments, ty) => self.call_value(asm, target, arguments, ty),
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => self.if_expression(asm, condition, then_value, else_value),
            ir::IrExpr::StrLit(text) => self.fail("a string value"),
            ir::IrExpr::StringAsStr(value) => self.fail("a string as str"),
            ir::IrExpr::StructValue(id, fields, values) => self.handle_value(asm, id, values),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.field_read(asm, value, id, field, ty),
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => self.read_reference_field(asm, pointer, id, field, ty, borrowed),
            ir::IrExpr::ArrayValue(items) => self.fail("an array value"),
            ir::IrExpr::ArrayRepeat(value, length) => self.fail("an array repeat"),
            ir::IrExpr::ArrayIndex(array, index, ty, length) => self.array_index(asm, array, index, ty, length),
            ir::IrExpr::SliceIndex(slice, index, ty) => self.slice_index(asm, slice, index, ty, false),
            ir::IrExpr::AddressOf(slot, ty, pointer, span) => self.address_of(asm, slot, ty),
            ir::IrExpr::ValueAddress(value, ty, pointer, span) => self.fail("an address of a value"),
            ir::IrExpr::Dereference(pointer, ty) => self.load_through(asm, pointer, 0, ty),
            ir::IrExpr::MoveRef(slot, ty) => self.move_local(asm, slot, ty),
            ir::IrExpr::FloatLit(bits, ty) => self.float_literal(asm, bits, ty),
            ir::IrExpr::FunctionAddress(function, ty) => self.function_address(asm, function),
            ir::IrExpr::EnumMatch(value, id, arms, ty) => self.enum_match(asm, value, id, arms, ty),
            ir::IrExpr::Propagate(value, input, output, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred) => self.propagate(asm, value, success_type, failure_type, success_variant, output_failure_variant, deferred),
            ir::IrExpr::StringFindOption(value, id) => self.find_option(asm, value, id),
            ir::IrExpr::SliceElementAddress(slice, index, ty, span) => self.slice_index(asm, slice, index, ty, true),
            ir::IrExpr::ArrayAsSlice(array, id, length) => self.fail("an array as a slice"),
        }
    }

    // `value?`: a success gives its payload. Otherwise the enclosing function returns the failure of its own enum, which
    // carries the error of a Result, after the `defer` bodies of the scopes it leaves have run. A payload and an error are
    // one cell each.
    fun propagate(mut self, asm: &mut x64::Asm, value: u64, success_type: u64, failure_type: Option<u64>, success_variant: u64, output_failure_variant: u64, deferred: Vec<u64>) -> bool {
        when !self.is_cell(success_type) || self.is_str(success_type) {
            return self.fail("a propagated value of this type")
        }
        when !self.propagate_box(asm, value, failure_type, success_variant, output_failure_variant, deferred) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 8)
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("free"))
        asm.pop(x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        return true
    }

    // The part of `value?` up to the success: rax is then the box of the success, whose payload is the cell after the tag.
    // A failure returns from the function, after the `defer` bodies of the scopes it leaves have run.
    fun propagate_box(mut self, asm: &mut x64::Asm, value: u64, failure_type: Option<u64>, success_variant: u64, output_failure_variant: u64, deferred: Vec<u64>) -> bool {
        when failure_type.is_some() && (self.cells_of(failure_type.unwrap()) == 0 || self.has_destructor(failure_type.unwrap())) {
            return self.fail("a propagated error of this type")
        }
        mut errors: u64 = 0
        when failure_type.is_some() {
            errors = self.cells_of(failure_type.unwrap())
        }
        when !self.expr(asm, value) {
            return false
        }
        succeeded := asm.new_label()
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.alu_ri(7, x64::Reg::RCX, success_variant as i64)
        asm.jcc(x64::Cc::EQUAL, succeeded)
        // The failure is a new box with the output's failure tag, and the error of the input box for a Result.
        asm.push(x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RDI, 8 * (1 + errors))
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RCX, output_failure_variant)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        when failure_type.is_some() {
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
            mut cell: u64 = 0
            while cell < errors {
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, (8 * (1 + cell)) as i64)
                asm.store(8, x64::Reg::RCX, x64::Reg::RAX, (8 * (1 + cell)) as i64)
                cell += 1
            }
        }
        // The payload has moved into the output box; release only the input shell.
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("free"))
        asm.pop(x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        // The box survives the `defer` bodies, which clobber the registers.
        asm.push(x64::Reg::RAX)
        when !self.body(asm, deferred) {
            return false
        }
        self.drop_owners(asm)
        asm.pop(x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
        asm.bind(succeeded)
        return true
    }

    // `value?` of a structure, pushed as its cells, as a call returns it.
    fun push_propagated(mut self, asm: &mut x64::Asm, value: u64, id: u64, failure_type: Option<u64>, success_variant: u64, output_failure_variant: u64, deferred: Vec<u64>) -> bool {
        when self.struct_destructor_cells(id).len() > 0 {
            return self.fail("a propagated structure with a destructor")
        }
        when !self.propagate_box(asm, value, failure_type, success_variant, output_failure_variant, deferred) {
            return false
        }
        held := self.scratch(1)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(held))
        count := self.program.structs[id].slot_count
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (1 + cell)) as i64)
            asm.push(x64::Reg::RCX)
            cell += 1
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, slot_disp(held))
        self.aligned_call(asm, String("free"))
        return true
    }

    // `value?` of a structure: its cells are copied from the success box into the frame from `base` on.
    fun propagate_struct(mut self, asm: &mut x64::Asm, value: u64, id: u64, failure_type: Option<u64>, success_variant: u64, output_failure_variant: u64, deferred: Vec<u64>, base: u64) -> bool {
        when self.struct_destructor_cells(id).len() > 0 {
            return self.fail("a propagated structure with a destructor")
        }
        when !self.propagate_box(asm, value, failure_type, success_variant, output_failure_variant, deferred) {
            return false
        }
        count := self.program.structs[id].slot_count
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (1 + cell)) as i64)
            asm.store(8, x64::Reg::RCX, x64::Reg::RBP, slot_disp(base + cell))
            cell += 1
        }
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("free"))
        return true
    }

    fun integer(mut self, asm: &mut x64::Asm, text: String, ty: u64) -> bool {
        when !is_integer_word(self.word(ty)) {
            return self.fail("an integer literal of this type")
        }
        asm.mov_ri(x64::Reg::RAX, literal_bits(text))
        return true
    }

    fun boolean(mut self, asm: &mut x64::Asm, value: bool) -> bool {
        when value {
            asm.mov_ri(x64::Reg::RAX, 1)
        } else {
            asm.mov_ri(x64::Reg::RAX, 0)
        }
        return true
    }

    fun char_value(mut self, asm: &mut x64::Asm, scalar: u64) -> bool {
        asm.mov_ri(x64::Reg::RAX, scalar)
        return true
    }

    fun local(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        when !self.is_cell(ty) && !self.is_handle_struct(ty) {
            return self.fail("a structure value")
        }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
        when self.is_handle_struct(ty) {
            return true
        }
        return self.load_cell(asm, ty, x64::Reg::RBP, slot_disp(slot))
    }

    // A local moved out: its value is read, and a vector or map that has to be dropped (or a handle) leaves the slot null,
    // so that its owner drops nothing.
    fun move_local(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        when !self.local(asm, slot, ty) {
            return false
        }
        self.null_owners(asm, slot, ty)
        return true
    }

    // Whether a type occupies one cell of its own: a scalar, a reference or a raw pointer. Structures, strings and arrays
    // take several cells, and are not values of an expression here.
    // The width in bytes of a value of a type in memory: a scalar's width, or 8 for a reference or a raw pointer.
    fun value_width(self, ty: u64) -> u64 {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => string_width(word),
            _ => 8,
        }
    }

    // Loads a scalar of type `ty` from `displacement` past `base` into rax, extended to 64 bits as its type says.
    fun load_cell(mut self, asm: &mut x64::Asm, ty: u64, base: u64, displacement: i64) -> bool {
        signed := choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => is_signed_word(word),
            _ => false,
        }
        asm.load(self.value_width(ty), signed, x64::Reg::RAX, base, displacement)
        return true
    }

    fun store_cell(mut self, asm: &mut x64::Asm, ty: u64, source: u64, base: u64, displacement: i64) -> bool {
        asm.store(self.value_width(ty), source, base, displacement)
        return true
    }

    fun is_str(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => word == "Str",
            _ => false,
        }
    }

    fun is_cell(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => string_width(word) != 0,
            ir::IrTy::ReferenceTo(target, mutable) => true,
            ir::IrTy::RawPointerTo(target) => true,
            ir::IrTy::VecOf(element) => true,
            ir::IrTy::MapOf(key, value) => true,
            ir::IrTy::SetOf(key, value) => true,
            ir::IrTy::EnumTy(id) => true,
            ir::IrTy::FunctionPointerTo(parameters, result, external) => true,
            _ => false,
        }
    }

    // Stores a value of type `ty` into the cells from `base` on: one cell for a scalar, and each field of a structure
    // at its own offset, a structure value being stored field by field and a structure local copied cell by cell.
    fun store_into(mut self, asm: &mut x64::Asm, value: u64, base: u64, ty: u64) -> bool {
        when self.is_str(ty) {
            return self.store_str(asm, value, base)
        }
        when self.array_element_of(ty).is_some() {
            return self.store_array(asm, value, base, ty)
        }
        when self.slice_element(ty).is_some() {
            return self.store_slice(asm, value, base)
        }
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.store_struct(asm, value, base, id),
            _ => self.store_scalar(asm, value, base, ty),
        }
    }

    fun store_scalar(mut self, asm: &mut x64::Asm, value: u64, base: u64, ty: u64) -> bool {
        when !self.is_cell(ty) {
            return self.fail("a value of this type")
        }
        when !self.expr(asm, value) {
            return false
        }
        return self.store_cell(asm, ty, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base))
    }

    fun store_str(mut self, asm: &mut x64::Asm, value: u64, base: u64) -> bool {
        return choose self.program.exprs[value] {
            ir::IrExpr::StrLit(text) => self.store_literal_cells(asm, text, base),
            ir::IrExpr::LocalRef(slot, ty, span) => self.copy_cells(asm, slot, base, 2),
            ir::IrExpr::MoveRef(slot, mty) => self.copy_cells(asm, slot, base, 2),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_into(asm, target, arguments, base, 2),
            ir::IrExpr::FieldRead(fv, fid, field, fty, fspan) => self.store_field_str(asm, value, base),
            ir::IrExpr::ReferenceFieldRead(rp, rid, rfield, rty, rspan, rborrowed) => self.store_field_str(asm, value, base),
            ir::IrExpr::IfExpr(condition, then_value, else_value, ity) => self.store_aggregate_result(asm, value, base, 2, ity),
            ir::IrExpr::EnumMatch(matched, mid, arms, mty) => self.store_aggregate_result(asm, value, base, 2, mty),
            _ => self.fail_at("a string value", value),
        }
    }

    fun store_literal_cells(mut self, asm: &mut x64::Asm, text: String, base: u64) -> bool {
        index := self.literal(text.clone())
        asm.lea_symbol(x64::Reg::RAX, self.literal_symbols[index])
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base))
        asm.mov_ri(x64::Reg::RAX, text.len())
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + 1))
        return true
    }

    // Writes a str local to standard output: its pointer and length are its two cells.
    fun write_str_local(mut self, asm: &mut x64::Asm, slot: u64) -> bool {
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, slot_disp(slot))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(slot + 1))
        asm.call_label(self.write_label)
        return true
    }

    fun store_struct(mut self, asm: &mut x64::Asm, value: u64, base: u64, id: u64) -> bool {
        place := self.place_of(value)
        when place.is_some() && self.struct_destructor_cells(id).len() == 0 {
            return self.copy_cells(asm, place.unwrap(), base, self.program.structs[id].slot_count)
        }
        when self.is_memory_place(value) && self.struct_destructor_cells(id).len() == 0 {
            when !self.memory_borrowed(value) && self.has_owners(self.struct_type(id)) {
                return self.store_aggregate_result(asm, value, base, self.program.structs[id].slot_count, self.struct_type(id))
            }
            when !self.memory_address(asm, value) {
                return false
            }
            self.copy_ty_id = 0
            when self.program.structs[id].repr_c {
                self.copy_ty_id = id + 1
            }
            result := self.copy_memory_to_cells(asm, base, self.program.structs[id].slot_count)
            self.copy_ty_id = 0
            return result
        }
        return choose self.program.exprs[value] {
            ir::IrExpr::StructValue(sid, fields, values) => self.store_fields(asm, base, id, sid, fields, values),
            ir::IrExpr::LocalRef(slot, ty, span) => self.copy_cells(asm, slot, base, self.program.structs[id].slot_count),
            ir::IrExpr::MoveRef(slot, mty) => self.store_moved(asm, slot, base, id),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_into(asm, target, arguments, base, self.program.structs[id].slot_count),
            ir::IrExpr::Propagate(value, input, output, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred) => self.propagate_struct(asm, value, id, failure_type, success_variant, output_failure_variant, deferred, base),
            ir::IrExpr::EnumMatch(matched, mid, arms, mty) => self.store_aggregate_result(asm, value, base, self.program.structs[id].slot_count, mty),
            ir::IrExpr::IfExpr(condition, then_value, else_value, ity) => self.store_aggregate_result(asm, value, base, self.program.structs[id].slot_count, ity),
            ir::IrExpr::FieldRead(outer, oid, field, fty, fspan) => self.store_aggregate_result(asm, value, base, self.program.structs[id].slot_count, fty),
            _ => self.fail_at("a structure value", value),
        }
    }

    fun store_fields(mut self, asm: &mut x64::Asm, base: u64, id: u64, sid: u64, fields: Vec<u64>, values: Vec<u64>) -> bool {
        when sid != id {
            return self.fail("a structure value of another structure")
        }
        mut position: u64 = 0
        while position < fields.len() {
            field_index := fields[position]
            offset := self.program.structs[id].fields[field_index].slot_offset
            field_ty := self.program.structs[id].fields[field_index].ty
            when !self.store_into(asm, values[position], base + offset, field_ty) {
                return false
            }
            position += 1
        }
        return true
    }

    // Copies `count` cells from the local at `source` to the cells from `base` on.
    fun copy_cells(mut self, asm: &mut x64::Asm, source: u64, base: u64, count: u64) -> bool {
        mut position: u64 = 0
        while position < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(source + position))
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + position))
            position += 1
        }
        return true
    }

    // A field of a structure local, read from its cell.
    fun field_read(mut self, asm: &mut x64::Asm, value: u64, id: u64, field: u64, ty: u64) -> bool {
        when !self.is_cell(ty) {
            return self.fail("a structure field of a structure type")
        }
        return choose self.program.exprs[value] {
            ir::IrExpr::LocalRef(slot, lty, span) => self.local_field(asm, slot, id, field, ty),
            ir::IrExpr::MoveRef(slot, mty) => self.moved_local_field(asm, slot, id, field, ty, mty),
            ir::IrExpr::Dereference(pointer, dty) => self.field_through(asm, pointer, id, field, ty),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_field(asm, target, arguments, id, field, ty),
            _ => self.field_of_value(asm, value, id, field, ty),
        }
    }

    // A field of a structure value that is not a local: the value is pushed and the field read from its cells, which
    // are then removed. The value is evaluated once for each field read, so only a value without effects is read here.
    // Whether an expression builds a structure from its fields, so that all of them are evaluated once, in order, as a push does.
    fun is_struct_literal(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::StructValue(id, fields, values) => true,
            _ => false,
        }
    }

    fun field_of_value(mut self, asm: &mut x64::Asm, value: u64, id: u64, field: u64, ty: u64) -> bool {
        base := self.place_of(value)
        when base.is_some() {
            return self.local_field(asm, base.unwrap(), id, field, ty)
        }
        when self.is_memory_place(value) {
            return self.field_through_place(asm, value, id, field, ty)
        }
        when self.program.structs[id].drop_function.is_some() {
            return self.fail("a field of a temporary destructor")
        }
        when !self.is_pure(value) && !self.is_propagation(value) && !self.is_struct_literal(value) {
            return self.fail("a field of a value that is not a local")
        }
        when !self.push_structure(asm, value, id) {
            return false
        }
        count := self.program.structs[id].slot_count
        when !self.load_cell(asm, ty, x64::Reg::RSP, self.pushed_field_disp(id, field)) {
            return false
        }
        self.drop_field_remainder(asm, id, field, ty)
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    // Whether evaluating an expression has no effect: a literal, a local, or a structure or cast of such values.
    fun is_pure(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::IntegerLit(text, ty) => true,
            ir::IrExpr::BoolLit(flag) => true,
            ir::IrExpr::CharLit(scalar) => true,
            ir::IrExpr::LocalRef(slot, ty, span) => true,
            ir::IrExpr::MoveRef(slot, ty) => true,
            ir::IrExpr::CastExpr(inner, source, target) => self.is_pure(inner),
            ir::IrExpr::StructValue(id, fields, values) => self.all_pure(values),
            ir::IrExpr::FieldRead(inner, id, field, ty, span) => self.is_pure(inner),
            ir::IrExpr::ReferenceFieldRead(inner, id, field, ty, span, borrowed) => self.is_pure(inner),
            ir::IrExpr::Dereference(inner, ty) => self.is_pure(inner),
            ir::IrExpr::Binary(op, left, right, ty) => self.is_pure(left) && self.is_pure(right),
            ir::IrExpr::CallExpr(target, arguments, ty) => self.is_pure_call(target, arguments),
            _ => false,
        }
    }

    // A vector read (an element, the length) with arguments that are pure: it has no effect but a failed bounds check.
    fun is_pure_call(self, target: ir::CallTarget, arguments: Vec<u64>) -> bool {
        return choose target {
            ir::CallTarget::VecOp(op, element) => (op == "Index" || op == "Len") && self.all_pure(arguments),
            _ => false,
        }
    }

    fun all_pure(self, values: Vec<u64>) -> bool {
        for value in values {
            when !self.is_pure(value) {
                return false
            }
        }
        return true
    }

    fun is_propagation(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::Propagate(v, input, output, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred) => true,
            _ => false,
        }
    }

    // Whether a structure is in memory, reached through a reference: a field of a reference's structure, or what a
    // reference points at.
    fun is_memory_place(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => true,
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.is_memory_place(value),
            ir::IrExpr::Dereference(pointer, ty) => true,
            _ => false,
        }
    }

    fun memory_borrowed(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => borrowed,
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.memory_borrowed(value),
            _ => true,
        }
    }

    // The address of a structure in memory, in rax: its lowest cell, and its cell k lies `8 * (N - 1 - k)` above that.
    fun memory_address(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => self.reference_field_address(asm, pointer, id, field),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.value_field_address(asm, value, id, field),
            ir::IrExpr::Dereference(pointer, ty) => self.expr(asm, pointer),
            _ => self.fail("a structure in memory that is not reached through a reference"),
        }
    }

    // The address of field `field` of the structure that the reference `pointer` holds, in rax.
    fun reference_field_address(mut self, asm: &mut x64::Asm, pointer: u64, id: u64, field: u64) -> bool {
        when !self.expr(asm, pointer) {
            return false
        }
        asm.lea(x64::Reg::RAX, x64::Reg::RAX, self.sub_displacement(id, field))
        return true
    }

    // The address of field `field` of the structure in memory at `value`, in rax.
    fun value_field_address(mut self, asm: &mut x64::Asm, value: u64, id: u64, field: u64) -> bool {
        when !self.memory_address(asm, value) {
            return false
        }
        asm.lea(x64::Reg::RAX, x64::Reg::RAX, self.sub_displacement(id, field))
        return true
    }

    // The distance from the lowest cell of a structure to the lowest cell of its field, which takes `cells` cells above it.
    fun sub_displacement(self, id: u64, field: u64) -> i64 {
        when self.program.structs[id].repr_c {
            return self.c_field_offset(id, field) as i64
        }
        count := self.program.structs[id].slot_count
        offset := self.program.structs[id].fields[field].slot_offset
        cells := self.cells_of(self.program.structs[id].fields[field].ty)
        return (8 * (count - offset - cells)) as i64
    }

    // A cell of a structure in memory, read at the address of the structure.
    fun field_through_place(mut self, asm: &mut x64::Asm, value: u64, id: u64, field: u64, ty: u64) -> bool {
        when !self.is_cell(ty) {
            return self.fail("a structure field of a structure type")
        }
        when !self.memory_address(asm, value) {
            return false
        }
        return self.load_cell(asm, ty, x64::Reg::RAX, self.field_displacement(id, field))
    }

    // Pushes the `count` cells of the structure at the address in rax, the first cell first.
    fun push_memory_cells(mut self, asm: &mut x64::Asm, count: u64) -> bool {
        when self.copy_ty_id != 0 {
            asm.mov_rr(x64::Reg::RSI, x64::Reg::RAX)
            asm.alu_ri(5, x64::Reg::RSP, (8 * count) as i64)
            self.unpack_from_image(asm, self.copy_ty_id - 1, x64::Reg::RSI, x64::Reg::RSP)
            return true
        }
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (count - 1 - cell)) as i64)
            asm.push(x64::Reg::RCX)
            cell += 1
        }
        return true
    }

    // Copies the `count` cells of the structure at the address in rax into the frame from `base` on.
    fun copy_memory_to_cells(mut self, asm: &mut x64::Asm, base: u64, count: u64) -> bool {
        when self.copy_ty_id != 0 {
            asm.mov_rr(x64::Reg::RSI, x64::Reg::RAX)
            asm.lea(x64::Reg::RDI, x64::Reg::RBP, slot_disp(base + count - 1))
            self.unpack_from_image(asm, self.copy_ty_id - 1, x64::Reg::RSI, x64::Reg::RDI)
            return true
        }
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RCX, x64::Reg::RBP, slot_disp(base + cell))
            cell += 1
        }
        return true
    }

    // Copies the `count` cells of the structure at the address in rax into the box on the stack, after the tag and `offset`.
    fun copy_memory_to_box(mut self, asm: &mut x64::Asm, offset: u64, count: u64) -> bool {
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (count - 1 - cell)) as i64)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
            asm.store(8, x64::Reg::RCX, x64::Reg::RDX, (8 * (1 + offset + cell)) as i64)
            cell += 1
        }
        return true
    }

    // A structure local moved into the box at the payload `offset`.
    fun store_moved_to_box(mut self, asm: &mut x64::Asm, slot: u64, offset: u64, id: u64) -> bool {
        when self.struct_destructor_cells(id).len() > 0 {
            return self.fail("a structure with a destructor in a box")
        }
        when !self.copy_local_to_box(asm, slot, offset, self.program.structs[id].slot_count) {
            return false
        }
        self.null_moved(asm, slot, id)
        return true
    }

    // A structure that a call returns, stored into the box at the payload `offset`: its cells are on the stack above the box.
    fun call_into_box(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>, offset: u64, id: u64) -> bool {
        when self.struct_destructor_cells(id).len() > 0 {
            return self.fail("a structure with a destructor in a box")
        }
        count := self.program.structs[id].slot_count
        when !self.call_expression(asm, target, arguments) {
            return false
        }
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * count) as i64)
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (1 + offset + cell)) as i64)
            cell += 1
        }
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    // The first cell of a local place: a structure local, or a field of one, which the frame holds at its offset.
    fun place_of(self, index: u64) -> Option<u64> {
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => Option::Some(slot),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.field_place(value, id, field),
            _ => Option::None,
        }
    }

    // Where field `field` of a structure that was pushed as its cells lies above the stack pointer: the cell of the field, or
    // for a `repr(C)` structure its place in the structure's bytes, which start at the stack pointer.
    fun pushed_field_disp(self, id: u64, field: u64) -> i64 {
        count := self.program.structs[id].slot_count
        offset := self.program.structs[id].fields[field].slot_offset
        return (8 * (count - 1 - offset)) as i64
    }

    fun field_place(self, value: u64, id: u64, field: u64) -> Option<u64> {
        base := self.place_of(value)
        when base.is_none() {
            return Option::None
        }
        return Option::Some(base.unwrap() + self.program.structs[id].fields[field].slot_offset)
    }

    // A field of a moved structure local: the whole structure is moved, so none of its owners is left for its scope to drop.
    fun moved_local_field(mut self, asm: &mut x64::Asm, slot: u64, id: u64, field: u64, ty: u64, structure: u64) -> bool {
        when !self.local_field(asm, slot, id, field, ty) {
            return false
        }
        asm.push(x64::Reg::RAX)
        self.null_owners(asm, slot + self.program.structs[id].fields[field].slot_offset, ty)
        self.drop_slot(asm, slot, structure)
        asm.pop(x64::Reg::RAX)
        return true
    }

    // A field taken from a temporary leaves its owner alive and drops the other fields.
    fun drop_field_remainder(mut self, asm: &mut x64::Asm, id: u64, field: u64, ty: u64) {
        count := self.program.structs[id].slot_count
        asm.push(x64::Reg::RAX)
        when self.has_owners(ty) {
            asm.mov_ri(x64::Reg::RCX, 0)
            asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 8 + self.pushed_field_disp(id, field))
        }
        asm.lea(x64::Reg::RDI, x64::Reg::RSP, (8 * count) as i64)
        asm.call_label(self.value_drop_routine(asm, self.struct_type(id), false))
        asm.pop(x64::Reg::RAX)
    }

    fun local_field(mut self, asm: &mut x64::Asm, slot: u64, id: u64, field: u64, ty: u64) -> bool {
        displacement := slot_disp(slot + self.program.structs[id].fields[field].slot_offset)
        return self.load_cell(asm, ty, x64::Reg::RBP, displacement)
    }

    // A field read through a reference: the reference is the address of the structure's first cell, and the cells
    // of a structure lie at lower addresses as their slots rise.
    fun field_through(mut self, asm: &mut x64::Asm, pointer: u64, id: u64, field: u64, ty: u64) -> bool {
        when !self.is_cell(ty) {
            return self.fail("a structure field of a structure type")
        }
        when !self.expr(asm, pointer) {
            return false
        }
        return self.load_cell(asm, ty, x64::Reg::RAX, self.field_displacement(id, field))
    }

    // Reading an owning field through a reference clones it unless the IR explicitly lends it.
    fun read_reference_field(mut self, asm: &mut x64::Asm, pointer: u64, id: u64, field: u64, ty: u64, borrowed: bool) -> bool {
        when !self.field_through(asm, pointer, id, field, ty) {
            return false
        }
        when !borrowed && self.has_owners(ty) {
            owned := self.owned_cells(ty)
            when owned.is_none() || owned.unwrap().len() != 3 {
                return self.fail("a copy of this reference field")
            }
            cells := owned.unwrap()
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.call_label(self.copy_routine(asm, cells[1], cells[2]))
        }
        return true
    }

    fun store_field_through(mut self, asm: &mut x64::Asm, value: u64, pointer: u64, id: u64, field: u64, ty: u64) -> bool {
        when !self.is_cell(ty) {
            return self.fail("a structure field of a structure type")
        }
        return self.store_through(asm, value, pointer, self.field_displacement(id, field), ty)
    }

    // Stores a scalar through a pointer, at `displacement` from the address the pointer holds.
    fun store_through(mut self, asm: &mut x64::Asm, value: u64, pointer: u64, displacement: i64, ty: u64) -> bool {
        when !self.is_cell(ty) {
            when self.is_repr_c_structure(ty) {
                return self.store_c_struct_through(asm, value, pointer, displacement, ty)
            }
            when self.cells_of(ty) > 0 && !self.is_str(ty) && self.c_size_of(ty) == 8 * self.cells_of(ty) {
                // A structure is pushed as its cells, the pointer is evaluated, and each cell is stored through it, the
                // first cell at the highest offset, as a field read through the pointer reads it.
                count := self.cells_of(ty)
                when !self.push_value(asm, value, ty) {
                    return false
                }
                when !self.expr(asm, pointer) {
                    return false
                }
                when self.has_owners(ty) {
                    asm.push(x64::Reg::RAX)
                    asm.lea(x64::Reg::RDI, x64::Reg::RAX, displacement + (8 * (count - 1)) as i64)
                    asm.call_label(self.value_drop_routine(asm, ty, false))
                    asm.pop(x64::Reg::RAX)
                }
                mut cell: u64 = 0
                while cell < count {
                    asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
                    asm.store(8, x64::Reg::RCX, x64::Reg::RAX, displacement + (8 * (count - 1 - cell)) as i64)
                    cell += 1
                }
                asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
                return true
            }
            return self.fail("an assignment of a structure through a pointer")
        }
        when !self.expr(asm, value) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, pointer) {
            return false
        }
        when self.has_owners(ty) {
            asm.push(x64::Reg::RAX)
            asm.lea(x64::Reg::RDI, x64::Reg::RAX, displacement)
            asm.call_label(self.value_drop_routine(asm, ty, false))
            asm.pop(x64::Reg::RAX)
        }
        asm.pop(x64::Reg::RCX)
        return self.store_cell(asm, ty, x64::Reg::RCX, x64::Reg::RAX, displacement)
    }

    // A `repr(C)` structure stored through a pointer: its bytes, `sizeof` of them, from its lowest cell to the address.
    fun store_c_struct_through(mut self, asm: &mut x64::Asm, value: u64, pointer: u64, displacement: i64, ty: u64) -> bool {
        count := self.cells_of(ty)
        when !self.push_value(asm, value, ty) {
            return false
        }
        when !self.expr(asm, pointer) {
            return false
        }
        asm.lea(x64::Reg::RDI, x64::Reg::RAX, displacement)
        self.pack_to_image(asm, self.struct_id_of(ty), x64::Reg::RSP, x64::Reg::RDI)
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    fun struct_id_of(self, ty: u64) -> u64 {
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => id,
            _ => 0,
        }
    }

    // Writes the fields of a `repr(C)` structure whose cells are at `cells` (the structure's lowest cell; cell k is `8 *
    // (N - 1 - k)` above it) into the C layout at `image`. Clobbers rax.
    fun pack_to_image(self, asm: &mut x64::Asm, id: u64, cells: u64, image: u64) {
        count := self.program.structs[id].slot_count
        mut field: u64 = 0
        while field < self.program.structs[id].fields.len() {
            offset := self.program.structs[id].fields[field].slot_offset
            width := self.value_width(self.program.structs[id].fields[field].ty)
            asm.load(width, false, x64::Reg::RAX, cells, (8 * (count - 1 - offset)) as i64)
            asm.store(width, x64::Reg::RAX, image, self.c_field_offset(id, field) as i64)
            field += 1
        }
    }

    // The reverse: reads the fields from the C layout at `image` into the cells at `cells`, each extended as its type says.
    fun unpack_from_image(self, asm: &mut x64::Asm, id: u64, image: u64, cells: u64) {
        count := self.program.structs[id].slot_count
        mut field: u64 = 0
        while field < self.program.structs[id].fields.len() {
            offset := self.program.structs[id].fields[field].slot_offset
            ty := self.program.structs[id].fields[field].ty
            width := self.value_width(ty)
            signed := choose self.program.types[ty] {
                ir::IrTy::Scalar(word) => is_signed_word(word),
                _ => false,
            }
            asm.load(width, signed, x64::Reg::RAX, image, self.c_field_offset(id, field) as i64)
            asm.store(8, x64::Reg::RAX, cells, (8 * (count - 1 - offset)) as i64)
            field += 1
        }
    }

    // Copies `size` bytes from the memory at `source` to the memory at `target` (both registers), in moves of 8, 4, 2 and
    // 1 bytes, so that no byte past the end is read or written. Clobbers rax.
    fun copy_bytes(self, asm: &mut x64::Asm, source: u64, target: u64, size: u64) {
        mut at: u64 = 0
        while at + 8 <= size {
            asm.load(8, false, x64::Reg::RAX, source, at as i64)
            asm.store(8, x64::Reg::RAX, target, at as i64)
            at += 8
        }
        when at + 4 <= size {
            asm.load(4, false, x64::Reg::RAX, source, at as i64)
            asm.store(4, x64::Reg::RAX, target, at as i64)
            at += 4
        }
        when at + 2 <= size {
            asm.load(2, false, x64::Reg::RAX, source, at as i64)
            asm.store(2, x64::Reg::RAX, target, at as i64)
            at += 2
        }
        when at + 1 <= size {
            asm.load(1, false, x64::Reg::RAX, source, at as i64)
            asm.store(1, x64::Reg::RAX, target, at as i64)
        }
    }

    fun load_through(mut self, asm: &mut x64::Asm, pointer: u64, displacement: i64, ty: u64) -> bool {
        when !self.is_cell(ty) {
            return self.fail("a read of a structure through a pointer")
        }
        when !self.expr(asm, pointer) {
            return false
        }
        return self.load_cell(asm, ty, x64::Reg::RAX, displacement)
    }

    // The address of a local: the frame address of its first cell.
    fun address_of(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        // A `repr(C)` structure is laid out in memory as C lays it out, which the cells of a frame are not: its address
        // is not given out.
        when self.is_repr_c_structure(ty) {
            return self.shadow_address(asm, slot, ty)
        }
        asm.lea(x64::Reg::RAX, x64::Reg::RBP, slot_disp(self.pointed_slot(slot, ty)))
        return true
    }

    // The address of a `repr(C)` local: the frame holds one cell per field, not C's layout, so a copy in C's layout is made
    // in scratch cells and its address given out. Foreign calls bring the copy up to date before they run and read it back
    // after, which is where C code can look at it or change it.
    fun shadow_address(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        id := self.struct_id_of(ty)
        when !self.c_fields_are_scalars(id) {
            return self.fail("the address of a repr(C) structure with a field that is not a plain scalar")
        }
        mut image: u64 = 0
        mut at: u64 = 0
        mut known: bool = false
        while at < self.shadow_slots.len() {
            when self.shadow_slots[at] == slot {
                image = self.shadow_images[at]
                known = true
            }
            at += 1
        }
        when !known {
            image = self.scratch(self.program.structs[id].slot_count)
            self.shadow_slots.push(slot)
            self.shadow_images.push(image)
            self.shadow_ids.push(id)
        }
        self.sync_shadow(asm, self.shadow_slots.len() - 1, false)
        asm.lea(x64::Reg::RAX, x64::Reg::RBP, slot_disp(image + self.program.structs[id].slot_count - 1))
        return true
    }

    // Copies the shadow `which` (the index in the lists) to or from its local: `read_back` reads C's layout into the cells.
    fun sync_shadow(self, asm: &mut x64::Asm, which: u64, read_back: bool) {
        id := self.shadow_ids[which]
        count := self.program.structs[id].slot_count
        asm.lea(x64::Reg::R10, x64::Reg::RBP, slot_disp(self.shadow_slots[which] + count - 1))
        asm.lea(x64::Reg::R11, x64::Reg::RBP, slot_disp(self.shadow_images[which] + count - 1))
        when read_back {
            self.unpack_from_image(asm, id, x64::Reg::R11, x64::Reg::R10)
        } else {
            self.pack_to_image(asm, id, x64::Reg::R10, x64::Reg::R11)
        }
    }

    fun sync_shadows(self, asm: &mut x64::Asm, read_back: bool) {
        mut at: u64 = 0
        while at < self.shadow_slots.len() {
            self.sync_shadow(asm, at, read_back)
            at += 1
        }
    }

    // The slot whose cell is the lowest in memory for a value at `slot`: a structure's last slot, since its cells rise
    // from its last slot down to its first, and every other value's first slot.
    fun pointed_slot(self, slot: u64, ty: u64) -> u64 {
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => slot + self.program.structs[id].slot_count - 1,
            _ => slot,
        }
    }

    // The offset above a structure's lowest cell at which its field's cell lies: the cells of a structure rise from its
    // last slot down, so a field at slot offset k lies 8 * (count - 1 - k) above the structure's address.
    fun field_displacement(self, id: u64, field: u64) -> i64 {
        when self.program.structs[id].repr_c {
            return self.c_field_offset(id, field) as i64
        }
        count := self.program.structs[id].slot_count
        offset := self.program.structs[id].fields[field].slot_offset
        return (8 * (count - 1 - offset)) as i64
    }

    // The size and alignment that C gives a value, as the `sizeof` and `alignof` of a program are.
    fun c_size_of(self, ty: u64) -> u64 {
        when self.is_str(ty) {
            return 16
        }
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => string_width(word),
            ir::IrTy::StructTy(id) => self.struct_c_size(id),
            _ => 8,
        }
    }

    fun c_align_of(self, ty: u64) -> u64 {
        when self.is_str(ty) {
            return 8
        }
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => string_width(word),
            ir::IrTy::StructTy(id) => self.struct_c_align(id),
            _ => 8,
        }
    }

    // The byte offset that C gives field `field` of a structure: the fields follow each other, each at a multiple of its
    // alignment. A `repr(C)` structure keeps this layout in its cells: its bytes start at its lowest cell.
    fun c_field_offset(self, id: u64, field: u64) -> u64 {
        mut size: u64 = 0
        mut position: u64 = 0
        while position <= field {
            field_ty := self.program.structs[id].fields[position].ty
            a := self.c_align_of(field_ty)
            size = (size + a - 1) / a * a
            when position == field {
                return size
            }
            size += self.c_size_of(field_ty)
            position += 1
        }
        return size
    }

    // Whether every field of a `repr(C)` structure is a plain scalar, as the layout supports.
    fun c_fields_are_scalars(self, id: u64) -> bool {
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            when !self.is_plain_scalar(self.program.structs[id].fields[position].ty) {
                return false
            }
            position += 1
        }
        return true
    }

    fun struct_c_size(self, id: u64) -> u64 {
        mut size: u64 = 0
        mut align: u64 = 1
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            field_ty := self.program.structs[id].fields[position].ty
            a := self.c_align_of(field_ty)
            size = (size + a - 1) / a * a + self.c_size_of(field_ty)
            when a > align {
                align = a
            }
            position += 1
        }
        return (size + align - 1) / align * align
    }

    fun struct_c_align(self, id: u64) -> u64 {
        mut align: u64 = 1
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            a := self.c_align_of(self.program.structs[id].fields[position].ty)
            when a > align {
                align = a
            }
            position += 1
        }
        return align
    }

    fun binary(mut self, asm: &mut x64::Asm, op: String, left: u64, right: u64, ty: u64) -> bool {
        when self.is_float(ty) {
            return self.float_binary(asm, op, left, right, ty)
        }
        when (self.is_string(ty) || self.is_str(ty)) && (op == "Eq" || op == "Ne") {
            return self.text_equal(asm, op == "Ne", left, right, self.is_string(ty))
        }
        when self.is_raw_pointer(ty) && (op == "Eq" || op == "Ne") {
            when !self.expr(asm, left) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, right) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.pop(x64::Reg::RAX)
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
            asm.setcc(comparison_condition(op, false), x64::Reg::RAX)
            return true
        }
        operand := self.word(ty)
        when width_of(operand.clone()) == 0 {
            return self.fail("an operator on this type")
        }
        when op == "And" || op == "Or" {
            return self.logical(asm, op == "And", left, right)
        }
        when !self.expr(asm, left) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, right) {
            return false
        }
        asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
        asm.pop(x64::Reg::RAX)
        when op == "Eq" || op == "Ne" || op == "Lt" || op == "Le" || op == "Gt" || op == "Ge" {
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
            asm.setcc(comparison_condition(op, is_signed_word(operand.clone())), x64::Reg::RAX)
            return true
        }
        when op == "Add" {
            asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RCX)
        } else when op == "Sub" {
            asm.alu_rr(41, x64::Reg::RAX, x64::Reg::RCX)
        } else when op == "Mul" {
            asm.imul_rr(x64::Reg::RAX, x64::Reg::RCX)
        } else when op == "BitAnd" {
            asm.alu_rr(33, x64::Reg::RAX, x64::Reg::RCX)
        } else when op == "BitOr" {
            asm.alu_rr(9, x64::Reg::RAX, x64::Reg::RCX)
        } else when op == "BitXor" {
            asm.alu_rr(49, x64::Reg::RAX, x64::Reg::RCX)
        } else when op == "Div" || op == "Rem" {
            return self.division(asm, op == "Div", is_signed_word(operand.clone()), operand)
        } else when op == "ShiftLeft" || op == "ShiftRight" {
            return self.shift(asm, op == "ShiftLeft", is_signed_word(operand.clone()), operand)
        } else {
            return self.fail("an operator that is not in the subset")
        }
        self.normalize(asm, operand)
        return true
    }

    // The quotient or remainder of rax by rcx at a width. A zero divisor is a runtime error; for a signed type the least
    // value divided by -1 wraps to itself (its quotient is the least value, and its remainder 0), so the divisor is 1 then.
    fun division(mut self, asm: &mut x64::Asm, is_quotient: bool, signed: bool, word: String) -> bool {
        asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
        asm.jcc(x64::Cc::EQUAL, self.division_error_label)
        when signed {
            asm.mov_ri(x64::Reg::RDX, min_bits(word.clone()))
            unchanged := asm.new_label()
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDX)
            asm.jcc(x64::Cc::NOT_EQUAL, unchanged)
            asm.alu_ri(7, x64::Reg::RCX, (0 as i64) - 1)
            asm.jcc(x64::Cc::NOT_EQUAL, unchanged)
            asm.mov_ri(x64::Reg::RCX, 1)
            asm.bind(unchanged)
            asm.cqo()
            asm.unary(7, x64::Reg::RCX)
        } else {
            asm.alu_rr(49, x64::Reg::RDX, x64::Reg::RDX)
            asm.unary(6, x64::Reg::RCX)
        }
        when !is_quotient {
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
        }
        self.normalize(asm, word)
        return true
    }

    // A shift of rax by rcx at a width: a count below the width shifts the value; a count at or above it gives zero, or
    // all ones for a signed right shift of a negative value.
    fun shift(mut self, asm: &mut x64::Asm, is_left: bool, signed: bool, word: String) -> bool {
        bits := width_of(word.clone()) * 8
        out_of_range := asm.new_label()
        done := asm.new_label()
        asm.alu_ri(7, x64::Reg::RCX, bits as i64)
        asm.jcc(x64::Cc::ABOVE_EQUAL, out_of_range)
        when is_left {
            asm.shift_cl(4, x64::Reg::RAX)
        } else when signed {
            asm.shift_cl(7, x64::Reg::RAX)
        } else {
            asm.shift_cl(5, x64::Reg::RAX)
        }
        self.normalize(asm, word)
        asm.jmp(done)
        asm.bind(out_of_range)
        zero := asm.new_label()
        when !is_left && signed {
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::GREATER_EQUAL, zero)
            asm.mov_ri(x64::Reg::RAX, 18446744073709551615)
            asm.jmp(done)
        }
        asm.bind(zero)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `left && right` or `left || right`: the right side runs only when the left does not decide the result.
    // The data and length of a String or str value, in rsi and rdx: a literal or a local reads them directly, and any other
    // String is read through its header.
    fun text_parts(mut self, asm: &mut x64::Asm, index: u64, owned: bool) -> bool {
        when self.as_str_inner(index).is_some() {
            return self.text_parts(asm, self.as_str_inner(index).unwrap(), true)
        }
        when self.string_literal(index).is_some() || self.is_text_local(index) || !owned {
            return self.load_string_parts(asm, index)
        }
        when !self.expr(asm, index) {
            return false
        }
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
        return true
    }

    fun is_text_local(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => true,
            ir::IrExpr::MoveRef(slot, ty) => true,
            _ => false,
        }
    }

    // Equality of two Strings or two `str`s: the lengths are compared, and then the bytes, one at a time. `negate` gives
    // the inequality.
    fun text_equal(mut self, asm: &mut x64::Asm, negate: bool, left: u64, right: u64, owned: bool) -> bool {
        mut arguments: Vec<u64> = Vec()
        arguments.push(left)
        arguments.push(right)
        temps := self.borrowed_temporaries(arguments.clone(), 0)
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) { return false }
        ok := self.text_equal_inner(asm, negate, left, right, owned)
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    fun text_equal_inner(mut self, asm: &mut x64::Asm, negate: bool, left: u64, right: u64, owned: bool) -> bool {
        when !self.text_parts(asm, left, owned) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, right, owned) {
            return false
        }
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RSI)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RDX)
        asm.pop(x64::Reg::R9)
        asm.pop(x64::Reg::R10)
        end := asm.new_label()
        same := asm.new_label()
        looping := asm.new_label()
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.alu_rr(57, x64::Reg::R9, x64::Reg::R8)
        asm.jcc(x64::Cc::NOT_EQUAL, end)
        asm.mov_ri(x64::Reg::R11, 0)
        asm.bind(looping)
        asm.alu_rr(57, x64::Reg::R11, x64::Reg::R9)
        asm.jcc(x64::Cc::ABOVE_EQUAL, same)
        asm.mov_rr(x64::Reg::RCX, x64::Reg::R10)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::R11)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::RCX, 0)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RDI)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::R11)
        asm.load(1, false, x64::Reg::RDX, x64::Reg::RDX, 0)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        asm.jcc(x64::Cc::NOT_EQUAL, end)
        asm.alu_ri(0, x64::Reg::R11, 1)
        asm.jmp(looping)
        asm.bind(same)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.bind(end)
        when negate {
            asm.alu_ri(6, x64::Reg::RAX, 1)
        }
        return true
    }

    fun logical(mut self, asm: &mut x64::Asm, is_and: bool, left: u64, right: u64) -> bool {
        when !self.expr(asm, left) {
            return false
        }
        end := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        when is_and {
            asm.jcc(x64::Cc::EQUAL, end)
        } else {
            asm.jcc(x64::Cc::NOT_EQUAL, end)
        }
        when !self.expr(asm, right) {
            return false
        }
        asm.bind(end)
        return true
    }

    fun negate(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        when self.is_float(ty) {
            when !self.expr(asm, value) {
                return false
            }
            // The sign is the top bit of the value's width.
            asm.mov_ri(x64::Reg::RCX, self.float_sign_bit(ty))
            asm.alu_rr(49, x64::Reg::RAX, x64::Reg::RCX)
            return true
        }
        operand := self.word(ty)
        when !is_integer_word(operand.clone()) {
            return self.fail("a negation of this type")
        }
        when !self.expr(asm, value) {
            return false
        }
        asm.unary(3, x64::Reg::RAX)
        self.normalize(asm, operand)
        return true
    }

    fun not(mut self, asm: &mut x64::Asm, value: u64) -> bool {
        when !self.expr(asm, value) {
            return false
        }
        asm.alu_ri(6, x64::Reg::RAX, 1)
        return true
    }

    fun bit_not(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        operand := self.word(ty)
        when !is_integer_word(operand.clone()) {
            return self.fail("a bitwise not of this type")
        }
        when !self.expr(asm, value) {
            return false
        }
        asm.unary(2, x64::Reg::RAX)
        self.normalize(asm, operand)
        return true
    }

    // A conversion between integer types: the value is brought to the target's width and signedness.
    fun cast(mut self, asm: &mut x64::Asm, value: u64, source: u64, target: u64) -> bool {
        when self.is_float(target) {
            return self.float_cast(asm, value, source, target)
        }
        when self.is_float(source) {
            return self.float_to_integer(asm, value, source, target)
        }
        target_word := self.word(target)
        when is_integer_word(target_word.clone()) {
            when !self.expr(asm, value) {
                return false
            }
            self.normalize(asm, target_word)
            return true
        }
        // A raw pointer keeps the bits of its address, from an integer or from another pointer.
        when self.is_raw_pointer(target) {
            return self.expr(asm, value)
        }
        return self.fail("a conversion to this type")
    }

    fun is_repr_c_structure(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.program.structs[id].repr_c,
            _ => false,
        }
    }

    fun op_fail(mut self, what: str, op: String) -> bool {
        mut message := String(what)
        message.append(op)
        when !self.failed {
            self.failed = true
            self.reason = message
        }
        return false
    }

    fun is_raw_pointer(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::RawPointerTo(target) => true,
            _ => false,
        }
    }

    fun call_expression(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>) -> bool {
        return choose target {
            ir::CallTarget::Func(id) => self.call(asm, id, arguments),
            ir::CallTarget::StringOp(op) => self.guarded_string(asm, op, arguments),
            ir::CallTarget::VecOp(op, ty) => self.guarded_vec(asm, op, ty, arguments, false),
            ir::CallTarget::SystemOp(op) => self.guarded_system(asm, op, arguments),
            ir::CallTarget::EnumNew(id, variant) => self.enum_new(asm, id, variant, arguments),
            ir::CallTarget::EnumPredicate(op, id) => self.guarded_predicate(asm, op, id, arguments),
            ir::CallTarget::EnumUnwrapOr(id, ty) => self.guarded_unwrap_or(asm, id, ty, arguments),
            ir::CallTarget::EnumUnwrap(id, ty, message, tag, failure) => self.guarded_unwrap(asm, id, ty, message, tag, failure, arguments),
            ir::CallTarget::MapOp(op, key, value) => self.guarded_map(asm, op, key, value, arguments),
            ir::CallTarget::SetOp(op, key, value) => self.guarded_map(asm, op, key, value, arguments),
            ir::CallTarget::IndirectFn(id) => self.indirect_call(asm, id, arguments),
            ir::CallTarget::ArgCount => self.arg_count(asm),
            ir::CallTarget::SliceLen => self.slice_len(asm, arguments),
            ir::CallTarget::Arg => self.argument(asm, arguments),
            ir::CallTarget::FilesystemOp(op) => self.filesystem(asm, op, arguments),
            ir::CallTarget::VecGetOption(element, option, pop) => self.vec_get_option(asm, element, option, pop, arguments),
            ir::CallTarget::TryRead(id) => self.fail("a call to the file reading builtin that gives an Option"),
            ir::CallTarget::ReadFileRes(id) => self.fail("a call to the file reading builtin that gives a Result"),
            ir::CallTarget::VecSlice(element) => self.fail("a vector slice outside a slice argument"),
            _ => self.fail("a builtin call"),
        }
    }

    fun if_expression(mut self, asm: &mut x64::Asm, condition: u64, then_value: u64, else_value: u64) -> bool {
        when !self.expr(asm, condition) {
            return false
        }
        otherwise := asm.new_label()
        end := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, otherwise)
        when !self.expr(asm, then_value) {
            return false
        }
        asm.jmp(end)
        asm.bind(otherwise)
        when !self.expr(asm, else_value) {
            return false
        }
        asm.bind(end)
        return true
    }

    // The object of the program: `_start`, the runtime and the functions, and the string literals as local symbols.
    fun object(self, asm: &mut x64::Asm, start_size: u64) -> elf::ObjectInput {
        mut sizes: Vec<u64> = Vec()
        mut position: u64 = 0
        while position < self.symbol_sizes.len() {
            when position == 0 {
                sizes.push(start_size)
            } else {
                sizes.push(self.symbol_sizes[position])
            }
            position += 1
        }
        // The functions that were generated get local symbols, `ryn_function_<index>`, so a debugger can name them.
        mut names: Vec<String> = self.symbol_names.clone()
        mut sections: Vec<u64> = self.symbol_sections.clone()
        mut values: Vec<u64> = self.symbol_values.clone()
        mut globals: Vec<bool> = self.symbol_global.clone()
        mut function: u64 = 0
        while function < self.labels.len() {
            when self.needed[function] && self.program.functions[function].external_symbol.is_none() {
                mut name := String("ryn_function_")
                name.append(String(function))
                names.push(name)
                sections.push(elf::Where::TEXT)
                values.push(asm.label_offsets[self.labels[function]])
                sizes.push(0)
                globals.push(false)
            }
            function += 1
        }
        return elf::ObjectInput {
            text: asm.code.clone(),
            rodata: self.rodata.clone(),
            bss_size: 16 + rt::state_size(),
            symbol_names: names,
            symbol_sections: sections,
            symbol_values: values,
            symbol_sizes: sizes,
            symbol_global: globals,
            reloc_offsets: asm.reloc_offsets.clone(),
            reloc_symbols: asm.reloc_symbols.clone(),
            reloc_kinds: asm.reloc_kinds.clone(),
            reloc_addends: asm.reloc_addends.clone(),
        }
    }
}

// The least value of a signed type, as the 64-bit pattern of its sign-extended value.
fun min_bits(word: String) -> u64 {
    when word == "I8" { return (0 as u64) - 128 }
    when word == "I16" { return (0 as u64) - 32768 }
    when word == "I32" { return (0 as u64) - 2147483648 }
    return 9223372036854775808
}

// The condition code of a comparison, for signed or unsigned operands.
fun comparison_condition(op: String, signed: bool) -> u64 {
    when op == "Eq" {
        return x64::Cc::EQUAL
    }
    when op == "Ne" {
        return x64::Cc::NOT_EQUAL
    }
    when op == "Lt" {
        when signed { return x64::Cc::LESS }
        return x64::Cc::BELOW
    }
    when op == "Le" {
        when signed { return x64::Cc::LESS_EQUAL }
        return x64::Cc::BELOW_EQUAL
    }
    when op == "Gt" {
        when signed { return x64::Cc::GREATER }
        return x64::Cc::ABOVE
    }
    when signed { return x64::Cc::GREATER_EQUAL }
    return x64::Cc::ABOVE_EQUAL
}
