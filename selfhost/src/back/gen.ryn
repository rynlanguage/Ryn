// The native backend in Ryn for the scalar subset: typed IR in, a relocatable x86-64 object out (see `elf.ryn`). The
// object links with `ld` or `cc` into an executable whose `_start` calls `main` and exits with its result.
//
// The subset: integers of every width, `bool` values, and `char` values in locals, parameters and results; the
// arithmetic, bitwise and comparison operators, with fixed-width wrapping; `when`, `while`, `for`, `break`, `continue`
// and `return`; calls of functions of the program with up to six arguments; and `echo` of integers, booleans and string
// literals. Anything else makes `generate` report that the program is not handled.
//
// Every local lives in an eight-byte cell below the frame pointer. An expression leaves its value in rax, normalized to
// the width of its type: sign-extended for signed types, zero-extended otherwise. Arguments travel in the System V
// argument registers; each call pushes its arguments and then loads them. Output goes to standard output by system
// calls, so no C library is used.

use back::x64
use back::elf
use back::pe
use back::winrt
use back::math
use back::fused
use back::floats
use back::float_runtime_ir
use back::textops
use back::rt
use back::ffi_helpers
use middle::ir

// The precision in bytes of a float: 4 for `f32`, 8 otherwise.
fun if_f32(is_f32: bool) -> u64 {
    when is_f32 {
        return 4
    }
    return 8
}

fun if_text(keys: bool, key_text: bool, value_text: bool) -> bool {
    when keys {
        return key_text
    }
    return value_text
}

// Whether the freestanding runtime has a routine for the C function `name`.
fun rt_provides(name: String) -> bool {
    when ffi_helpers::is_helper(name.clone()) {
        return true
    }
    return name == "ryn_native_live_allocations" || name == "ryn_native_live_bytes" || name == "malloc" || name == "free" || name == "realloc" || name == "calloc" || name == "memcpy" || name == "memmove" || name == "strlen" || name == "fopen" || name == "fseek" || name == "ftell" || name == "fread" || name == "fwrite" || name == "fclose" || name == "strerror" || name == "__errno_location" || name == "putchar" || name == "chmod" || name == "rename" || name == "unlink" || name == "getpid"
}

// The 64-bit pattern of an integer literal's text (a leading `-` negates it).
fun literal_bits(text: String) -> u64 {
    mut negative := false
    mut at: u64 = 0
    when text.len() > 0 && text.byte_at(0) == 45 {
        negative = true
        at = 1
    }
    mut value: u64 = 0
    while at < text.len() {
        value = value * 10 + ((text.byte_at(at) - 48) as u64)
        at += 1
    }
    when negative {
        return (0 as u64) - value
    }
    return value
}

// The System V register that carries argument `index`.
// `value + 1` when `condition` holds, and 0 when it does not: an optional id that keeps 0 for none.
fun if_text_id(condition: bool, value: u64) -> u64 {
    when condition {
        return value + 1
    }
    return 0
}

fun arg_register(index: u64) -> u64 {
    when index == 0 { return x64::Reg::RDI }
    when index == 1 { return x64::Reg::RSI }
    when index == 2 { return x64::Reg::RDX }
    when index == 3 { return x64::Reg::RCX }
    when index == 4 { return x64::Reg::R8 }
    return x64::Reg::R9
}

// The displacement from the frame pointer of a local's cell.
fun slot_disp(slot: u64) -> i64 {
    return (0 as i64) - (((slot + 1) * 8) as i64)
}

// The width in bytes of a scalar type word, or 0 for a word this backend does not handle.
fun width_of(word: String) -> u64 {
    when word == "I8" || word == "U8" || word == "Bool" { return 1 }
    when word == "I16" || word == "U16" { return 2 }
    when word == "I32" || word == "U32" || word == "Char" { return 4 }
    when word == "I64" || word == "U64" || word == "F64" { return 8 }
    when word == "F32" { return 4 }
    return 0
}

// The width of a scalar word in a cell: `width_of`, and 8 for an owned String, which is the address of its header.
fun string_width(word: String) -> u64 {
    when word == "OwnedString" {
        return 8
    }
    return width_of(word)
}

fun is_integer_word(word: String) -> bool {
    return word.starts_with("I") || word.starts_with("U")
}

fun is_signed_word(word: String) -> bool {
    return word == "I8" || word == "I16" || word == "I32" || word == "I64"
}

// The condition that holds for the reverse of a comparison's, for the branch that leaves a loop.
fun negated_condition(condition: u64) -> u64 {
    when condition == x64::Cc::LESS { return x64::Cc::GREATER_EQUAL }
    when condition == x64::Cc::LESS_EQUAL { return x64::Cc::GREATER }
    when condition == x64::Cc::BELOW { return x64::Cc::ABOVE_EQUAL }
    return x64::Cc::ABOVE
}

// The bits `boolean` emits for a bool: 1 or 0.
fun bool_bits(value: bool) -> u64 {
    when value {
        return 1
    }
    return 0
}

// The bits `normalize` leaves in rax for `value` at the width of `word`: its low bits, sign-extended for a signed word and
// zero-extended otherwise. A 64-bit word and a word with no width are unchanged.
fun canonical_bits(value: u64, word: String) -> u64 {
    width := width_of(word.clone())
    when width == 0 || width == 8 {
        return value
    }
    span := (1 as u64) << ((width * 8) as u32)
    low := value & (span - 1)
    when is_signed_word(word) && low >= (span >> (1 as u32)) {
        return low - span
    }
    return low
}

// The exponent k of `value` = 2^k, or 64 when `value` is zero or not a power of two.
fun power_exponent(value: u64) -> u64 {
    when value == 0 || (value & (value - 1)) != 0 {
        return 64
    }
    mut exponent: u64 = 0
    mut rest := value
    while rest > 1 {
        rest = rest >> (1 as u32)
        exponent += 1
    }
    return exponent
}

// The bits `binary` leaves in rax for `left op right` on two constants of the operand word `word`, computed as the
// emitted code computes them. None when the operation is not folded: a zero divisor stays a run-time error.
fun fold_binary(op: String, word: String, left: u64, right: u64) -> Option<u64> {
    signed := is_signed_word(word.clone())
    when op == "Eq" {
        return Option::Some(bool_bits(left == right))
    }
    when op == "Ne" {
        return Option::Some(bool_bits(left != right))
    }
    when op == "Lt" || op == "Le" || op == "Gt" || op == "Ge" {
        // Flipping the sign bit maps the signed order of a signed word onto the unsigned order of its bits.
        mut bias: u64 = 0
        when signed {
            bias = (1 as u64) << (63 as u32)
        }
        a := left ^ bias
        b := right ^ bias
        when op == "Lt" {
            return Option::Some(bool_bits(a < b))
        }
        when op == "Le" {
            return Option::Some(bool_bits(a <= b))
        }
        when op == "Gt" {
            return Option::Some(bool_bits(a > b))
        }
        return Option::Some(bool_bits(a >= b))
    }
    // `&&` and `||` yield the left value when it decides the result, and the right value otherwise.
    when op == "And" {
        when left == 0 {
            return Option::Some(left)
        }
        return Option::Some(right)
    }
    when op == "Or" {
        when left != 0 {
            return Option::Some(left)
        }
        return Option::Some(right)
    }
    when op == "Add" {
        return Option::Some(canonical_bits(left + right, word.clone()))
    }
    when op == "Sub" {
        return Option::Some(canonical_bits(left - right, word.clone()))
    }
    when op == "Mul" {
        return Option::Some(canonical_bits(left * right, word.clone()))
    }
    when op == "BitAnd" {
        return Option::Some(canonical_bits(left & right, word.clone()))
    }
    when op == "BitOr" {
        return Option::Some(canonical_bits(left | right, word.clone()))
    }
    when op == "BitXor" {
        return Option::Some(canonical_bits(left ^ right, word.clone()))
    }
    when op == "Div" || op == "Rem" {
        when right == 0 {
            return Option::None
        }
        mut divisor := right
        // The least value divided by -1 wraps to itself: the emitted code divides it by 1 then.
        when signed && left == min_bits(word.clone()) && right == (0 as u64) - 1 {
            divisor = 1
        }
        when signed && op == "Div" {
            return Option::Some(canonical_bits(((left as i64) / (divisor as i64)) as u64, word.clone()))
        }
        when signed {
            return Option::Some(canonical_bits(((left as i64) % (divisor as i64)) as u64, word.clone()))
        }
        when op == "Div" {
            return Option::Some(canonical_bits(left / divisor, word.clone()))
        }
        return Option::Some(canonical_bits(left % divisor, word.clone()))
    }
    when op == "ShiftLeft" || op == "ShiftRight" {
        bits := width_of(word.clone()) * 8
        // A count at or above the width gives zero, or all ones for a signed right shift of a negative value.
        when right >= bits {
            when op == "ShiftRight" && signed && (left >> (63 as u32)) == 1 {
                return Option::Some((0 as u64) - 1)
            }
            return Option::Some(0)
        }
        when op == "ShiftLeft" {
            return Option::Some(canonical_bits(left << (right as u32), word.clone()))
        }
        mut shifted := left >> (right as u32)
        // An arithmetic right shift fills the vacated bits with the sign bit, which is the top bit of the canonical value.
        when signed && (left >> (63 as u32)) == 1 && right > 0 {
            shifted = shifted | (((0 as u64) - 1) << ((64 - right) as u32))
        }
        return Option::Some(canonical_bits(shifted, word.clone()))
    }
    return Option::None
}

pub struct Gen {
    program: ir::IrProgram,
    // The label of each function, by function index.
    labels: Vec<u64>,
    // The targets of `break` and `continue` in the loops being generated, innermost last.
    breaks: Vec<u64>,
    continues: Vec<u64>,
    // The bytes of the string literals, and each literal's offset, length and index in the list of literals.
    rodata: Vec<u8>,
    literal_offsets: Vec<u64>,
    literal_lengths: Vec<u64>,
    // The symbol table of the object: symbol 0 is `main`, then the literals' and the foreign functions' symbols. The
    // symbol of each literal is in `literal_symbols`.
    symbol_names: Vec<String>,
    symbol_sections: Vec<u64>,
    symbol_values: Vec<u64>,
    symbol_sizes: Vec<u64>,
    symbol_global: Vec<bool>,
    literal_symbols: Vec<u64>,
    // The handler of a segmentation fault, which reports a stack overflow, and the messages it writes.
    handler_label: u64,
    division_error_label: u64,
    index_error_label: u64,
    set_error_label: u64,
    index_literal: u64,
    overflow_literal: u64,
    invalid_literal: u64,
    division_literal: u64,
    // The labels of the runtime routines: writing a buffer, and printing an unsigned, signed or boolean value.
    write_label: u64,
    // Standard output is buffered (Linux only): 64 KiB, written when it is full, at exit, before an error message, before the
    // program reads standard input or starts a process, and on `flush`. A terminal, and a program with threads, are not
    // buffered. `stdout_symbol` holds the mode (0 not known, 1 buffered, 2 direct), the length and the bytes.
    buffered: bool,
    stdout_symbol: u64,
    flush_label: u64,
    map_hash_scalar: u64,
    map_hash_string: u64,
    // The slot of the structure key whose words are being written.
    key_base: u64,
    struct_key_drop: u64,
    map_find_scalar: u64,
    map_find_string: u64,
    map_grow: u64,
    string_less_label: u64,
    string_clone_label: u64,
    // Whether each function is reached from `main`: only those are generated.
    needed: Vec<bool>,
    // The element types of the vector clone routines asked for, and their labels.
    vec_routine_elements: Vec<u64>,
    vec_routine_labels: Vec<u64>,
    // The C runtime's argc and argv, which the entry stores: a zero-filled cell of 16 bytes.
    arguments_symbol: u64,
    // One zero-filled cell of the runtime, which a Ryn runtime function reads and writes through `RuntimeCell`.
    runtime_cell_symbol: u64,
    cpu_cell_symbol: u64,
    // Profile-guided code layout (`--profile-generate`): whether each function counts its entries, the symbol of the
    // counters (one u64 per function of the program), and the label of the routine that writes them at exit.
    profiling: bool,
    profile_symbol: u64,
    profile_dump_label: u64,
    map_clone_plain: u64,
    map_clone_key_text: u64,
    map_clone_value_text: u64,
    map_clone_both_text: u64,
    print_u64_label: u64,
    print_i64_label: u64,
    print_bool_label: u64,
    // The routine that formats a float as text, and whether the program needs it: it is written only when it does.
    float_format_label: u64,
    native_float_format: u64,
    native_float_parse: u64,
    float_format_used: bool,
    // The cells past the locals that the function being generated uses for temporaries (arrays and slices that are not in
    // a local); the frame is sized once the body is generated.
    // The Unicode text routines (1 trim, 2 case, 4 find) the program uses, and their labels.
    textops_used: u64,
    trim_label: u64,
    case_label: u64,
    reverse_label: u64,
    find_label: u64,
    // The drop routines of vectors and maps of destructor values: kind (0 vector, 1 map), element type, label.
    // The C size of the `repr(C)` structure that a memory copy moves (zero for the other structures).
    copy_ty_id: u64,
    // The `repr(C)` locals whose address was taken in the function being generated: the slot, the scratch cells that hold its
    // C layout, and its structure. The layout is brought up to date before a foreign call, and read back after it.
    shadow_slots: Vec<u64>,
    // The array elements a C call is given pointers into: six words each (the array slot, the element width, whether it is
    // signed, the length, the buffer slot and whether it is mutable), copied back after the call.
    ffi_copies: Vec<u64>,
    shadow_images: Vec<u64>,
    shadow_ids: Vec<u64>,
    // The enums whose values are copied by a routine of their own, and its labels.
    // Whether the object runs without the C library (its own `_start` and the routines of `back/rt.ryn`), and their labels.
    freestanding: bool,
    // Whether the image is for Windows: the system requests of the freestanding runtime go through `back/winrt`.
    windows: bool,
    win_syscall: u64,
    win_init: u64,
    win_veh: u64,
    win_state: u64,
    win_names: Vec<String>,
    win_symbols: Vec<u64>,
    // Whether the program's own foreign functions come from the system's shared C library: a freestanding program that
    // declares a C function the runtime does not provide is linked dynamically, and every foreign call it makes itself goes
    // to the library, so that memory and handles it gets from C are given back to C.
    dynamic_imports: bool,
    // Whether a freestanding build met a call it can only make through the C library.
    wants_libc: bool,
    // The arguments of the last C call that do not fit the six integer registers, by position: they go to the stack.
    c_overflow: Vec<u64>,
    // The source span of the statement or expression being generated, and the one where generation failed: a construct
    // the backend lacks is reported at its place in the program.
    span_start: u64,
    span_end: u64,
    failed_start: u64,
    failed_end: u64,
    // The `ryn_ffi_*` test routines the program calls, and their labels.
    helper_names: Vec<String>,
    helper_labels: Vec<u64>,
    rt: rt::Labels,
    enum_clone_ids: Vec<u64>,
    enum_clone_labels: Vec<u64>,
    glue_kinds: Vec<u64>,
    map_value_type: u64,
    glue_elements: Vec<u64>,
    glue_labels: Vec<u64>,
    scratch_base: u64,
    scratch_used: u64,
    // The roots of the function's IR cells that hold an array: a parameter or a `let` (base slot and type). See `phys_slot`.
    regions_base: Vec<u64>,
    regions_type: Vec<u64>,
    // The functions whose address is taken, and the labels of their C-convention entry points.
    thunk_functions: Vec<u64>,
    thunk_labels: Vec<u64>,
    failed: bool,
    reason: String,
    // The cells of the arguments of the function being generated, and its result when that is a string or a structure:
    // the caller reserves the result cells above the arguments, and the callee writes them there.
    argument_cells: u64,
    result_cells: u64,
    result_type: u64,
    // The slots of the destructor values that the function owns, in ascending order, with their types.
    owner_slots: Vec<u64>,
    owner_types: Vec<u64>,
    // The routines that drop a value at an address (by type), and that free a handle (by owner type), with their labels.
    drop_value_ids: Vec<u64>,
    // The position of each (type, direction) in the lists of the value drop routines and of each (kind, element) in those of the
    // glue routines, so a routine is found by one lookup instead of a scan of every one asked for so far.
    drop_value_index: Map<u64, u64>,
    glue_index: Map<u64, u64>,
    drop_value_labels: Vec<u64>,
    drop_handle_ids: Vec<u64>,
    drop_handle_index: Map<u64, u64>,
    // The first type that is each structure, by structure id.
    struct_types: Map<u64, u64>,
    drop_handle_labels: Vec<u64>,
    drop_values_done: u64,
    drop_handles_done: u64,
    // Whether the cells of each value routine rise in memory with the cell index (an enum box) or fall (a local, a vector
    // element: cell 0 is the highest word).
    drop_value_ascending: Vec<bool>,
    // The argument expressions that are read from a frame cell instead of being evaluated: a temporary that a builtin call borrows.
    temp_exprs: Vec<u64>,
    temp_cells: Vec<u64>,
    temp_ready: Vec<bool>,
    // How many of the vector clone, enum clone, glue and thunk routines are written: the passes of `build_listing` write the rest.
    vec_clone_done: u64,
    enum_clone_done: u64,
    glue_done: u64,
    thunks_done: u64,
    // The index of each string literal written, by its text: a text that occurs again shares the one copy.
    literal_indices: Map<String, u64>,
    // Whether the function being generated has its body (a call is inlined only then), and whether a leaf function is being
    // inlined at a call: its parameters' slots, the caller's scratch cells that hold their arguments, and the nodes of its
    // body counted so far.
    in_function: bool,
    inline_active: bool,
    inline_slots: Vec<u64>,
    inline_cells: Vec<u64>,
    inline_nodes: u64,
    // The most nodes an inlined body may have, whether the body being checked may read locals other than parameters, and the
    // labels that the `return`s of the inlined bodies of statements jump to (the innermost last).
    inline_limit: u64,
    inline_locals: bool,
    inline_exits: Vec<u64>,
    // Per function, how its calls are inlined (see `inline_kind`), or 9 while that is not known.
    inline_kinds: Vec<u64>,
    // Per expression: 0 when its constness is not known yet, 1 when it is not a constant, 2 when it is, with its bits in
    // `const_bits`. Memoized so that a deep chain of operations is evaluated once per node.
    const_state: Vec<u64>,
    const_bits: Vec<u64>,
    // The locals of the function being generated that are defined once: per slot, the number of `let`s, the expression of the
    // last one (plus one), and whether anything else writes the slot or takes its address. A local defined once by a constant
    // is that constant wherever it is read.
    def_count: Vec<u64>,
    def_init: Vec<u64>,
    def_bad: Vec<bool>,
    def_addressed: Vec<bool>,
    def_reads: Vec<u64>,
    // Per slot: how much the function uses it (a use in a loop counts 8 times, in two loops 64), whether it is the target of
    // a `let`, assignment, loop or parameter of a scalar type, and whether anything else writes it. A slot that is only
    // written by those, and is not addressed, can live in a register as well as in its frame cell.
    def_weight: Vec<u64>,
    def_seen: Vec<bool>,
    def_noreg: Vec<bool>,
    scan_depth: u64,
    // Per slot, the first and last position (a count of the statements and uses the scan has passed) at which the function uses
    // it, widened over the loops it lives across; two locals whose ranges do not meet can share a register.
    live_first: Vec<u64>,
    live_last: Vec<u64>,
    loop_starts: Vec<u64>,
    loop_ends: Vec<u64>,
    scan_pos: u64,
    scan_whole: bool,
    // Bounds-check elimination: pairs (vector local, index local) whose index is below the vector's length in the loop being
    // generated; `bce_cut` is the statement after which the index may have changed, `bce_on` whether the pair holds now.
    // Scalar replacement: per cell, the base slot plus one of the structure local whose field it is (0 for none), and the
    // bases of the structure locals the scan has found.
    sroa_base: Vec<u64>,
    sroa_list: Vec<u64>,
    bce_vec: Vec<u64>,
    bce_idx: Vec<u64>,
    bce_cut: Vec<u64>,
    bce_on: Vec<bool>,
    // The locals kept in callee-saved registers: `slot_reg[slot]` is the register, or 0. The function saves each register
    // it uses in a frame cell on entry and restores it on every return (`saved_regs`, `saved_cells`).
    slot_reg: Vec<u64>,
    saved_regs: Vec<u64>,
    saved_cells: Vec<u64>,
    // Per expression: whether it is the element read of a `vector[index].field` whose value a builtin only borrows, so that
    // the field is lent in place and not cloned.
    lent: Vec<bool>,
    // The function being generated, and whether a call of itself in a `return` is a jump back to the start of its body: its
    // parameters are scalars, and it has no owned values, no address taken and no `repr(C)` copy. `tail_label` is that start.
    cur_function: u64,
    tail_ok: bool,
    tail_label: u64,
    // Whether the optimizations that need an analysis (constant propagation of locals, dead code) are switched off.
    no_opt: bool,
    // RYN_REGPOISON: a local in a register gets a marker in its frame cell, not its value, so a read of the cell shows up as a wrong result.
    poison: bool,
    symbols: bool,
}

// The literals that the runtime routines and `echo` use, in the order their indices are fixed.
fun newline_literal() -> u64 {
    return 0
}

fun true_literal() -> u64 {
    return 1
}

fun false_literal() -> u64 {
    return 2
}

// The width in bytes of an array element that a C call may point into (0 for the others): integers and bool.
fun ffi_width_of(word: String) -> u64 {
    when word == "U8" || word == "I8" || word == "Bool" {
        return 1
    } else when word == "U16" || word == "I16" {
        return 2
    } else when word == "U32" || word == "I32" {
        return 4
    } else when word == "U64" || word == "I64" {
        return 8
    }
    return 0
}

fun ffi_signed_word(word: String) -> bool {
    return word == "I8" || word == "I16" || word == "I32" || word == "I64"
}

// The cells of a frame buffer that hold `length` elements of `width` bytes.
fun ffi_cells(length: u64, width: u64) -> u64 {
    cells := (length * width + 7) / 8
    when cells == 0 {
        return 1
    }
    return cells
}

// The name of an MMX instruction by its opcode (the `MmxBin` operations of std::mmx).
fun mmx_name(opcode: u64) -> String {
    when opcode == 254 {
        return String("paddd")
    } else when opcode == 250 {
        return String("psubd")
    } else when opcode == 219 {
        return String("pand")
    } else when opcode == 235 {
        return String("por")
    } else when opcode == 239 {
        return String("pxor")
    } else when opcode == 212 {
        return String("paddq")
    } else when opcode == 251 {
        return String("psubq")
    } else when opcode == 253 {
        return String("paddw")
    } else when opcode == 249 {
        return String("psubw")
    } else when opcode == 252 {
        return String("paddb")
    } else when opcode == 248 {
        return String("psubb")
    } else when opcode == 213 {
        return String("pmullw")
    } else when opcode == 118 {
        return String("pcmpeqd")
    } else when opcode == 102 {
        return String("pcmpgtd")
    }
    return String("mmx")
}

// Generates the object of a program, or the reason it is not handled.
pub fun generate(program: ir::IrProgram) -> Result<Vec<u8>, String> {
    return build(program, false, false, false)
}

// The program as an executable. A program that needs nothing from the C library becomes a static executable with the
// backend's own runtime (`back/rt.ryn`). A program that calls a C function the runtime does not provide is generated
// again against the C library: its runtime calls go to libc, its `_start` hands `main` to `__libc_start_main`, and the
// executable is linked dynamically with `libc.so.6` and `libm.so.6` (`elf::link_executable`).
pub fun generate_executable(program: ir::IrProgram) -> Result<Vec<u8>, String> {
    first := build(program, true, false, false)
    when first.is_err() {
        reason := first.unwrap_err()
        when reason == needs_libc_marker() {
            return Result::Err(String("the program calls the C library; generate it from its IR text"))
        }
        return Result::Err(reason)
    }
    return first
}

// `generate_executable` from the encoded typed IR, which is read again for the build against the C library.
pub fun generate_executable_text(text: String) -> Result<Vec<u8>, String> {
    return generate_for_target(text, false)
}

// An executable for Windows (`windows`) or Linux: a Windows program that needs the C library is declined.
pub fun generate_for_target(text: String, windows: bool) -> Result<Vec<u8>, String> {
    return generate_profiled(text, windows, String(""), String(""))
}

// `generate_for_target` with profile-guided code layout. A non-empty `profile_out` makes an instrumented executable: each
// function counts its entries, and when the program exits (`__cxa_atexit`) it writes one line per function,
// `count<TAB>name`, to that file. Such an executable is built against the C library, and only for Linux. A non-empty
// `profile` is the text of a profile written that way: the functions are generated most entered first, so the hot code
// is together. A profile changes the order of the code and nothing else: the same functions are generated.
pub fun generate_profiled(text: String, windows: bool, profile_out: String, profile: String) -> Result<Vec<u8>, String> {
    when !profile_out.is_empty() {
        when windows {
            return Result::Err(String("profiling is not available for Windows programs yet"))
        }
        program := ir::decode_ir(text)
        when program.is_err() {
            return Result::Err(String("the typed IR does not decode"))
        }
        return build_listing(program.unwrap(), true, true, false, false, String(""), false, Layout { profile_out: profile_out, profile: String(""), reach: false, preset: Vec() })
    }
    when profile.is_empty() {
        return generate_layout(text, windows, String(""), String(""), false, Vec())
    }
    // The functions the program reaches are found first, by a generation whose result is that set; the generation with the
    // profile then generates exactly those, most entered first.
    reached := generate_layout(text.clone(), windows, String(""), String(""), true, Vec())
    when reached.is_err() {
        return Result::Err(reached.unwrap_err())
    }
    return generate_layout(text, windows, String(""), profile, false, reached.unwrap())
}

// The layout of one generation of a program: as an executable, against the C library when the program needs it and
// the target is Linux. The result of a `reach` layout is the set of functions reached, one byte each, not an object.
fun generate_layout(text: String, windows: bool, profile_out: String, profile: String, reach: bool, preset: Vec<u8>) -> Result<Vec<u8>, String> {
    program := ir::decode_ir(text.clone())
    when program.is_err() {
        return Result::Err(String("the typed IR does not decode"))
    }
    first := build_listing(program.unwrap(), true, false, windows, false, String(""), false, Layout { profile_out: profile_out.clone(), profile: profile.clone(), reach: reach, preset: preset.clone() })
    when first.is_err() {
        reason := first.unwrap_err()
        when reason == needs_libc_marker() {
            when windows {
                return Result::Err(String("the C library is not available in a Windows program yet"))
            }
            again := ir::decode_ir(text)
            when again.is_err() {
                return Result::Err(String("the typed IR does not decode"))
            }
            return build_listing(again.unwrap(), true, true, false, false, String(""), false, Layout { profile_out: profile_out, profile: profile, reach: reach, preset: preset })
        }
        return Result::Err(reason)
    }
    return first
}

// The layout of a program's code. `profile_out`: the program is instrumented, writing its entry counts to that file.
// `profile`: the text of a profile, which orders the functions. `reach`: the result is the set of functions the program
// reaches, one byte each, instead of the object. `preset`: that set, given in advance (empty when there is none).
struct Layout {
    profile_out: String,
    profile: String,
    reach: bool,
    preset: Vec<u8>,
}

// The reason a freestanding build gives up when the program needs the C library.
fun needs_libc_marker() -> String {
    return String("$needs-libc")
}

// An object linked against libc, including its floating-point formatting and parsing routines.
pub fun generate_libc(program: ir::IrProgram) -> Result<Vec<u8>, String> {
    return build(program, false, true, false)
}

fun build(input: ir::IrProgram, executable: bool, libc: bool, windows: bool) -> Result<Vec<u8>, String> {
    return build_listing(input, executable, libc, windows, false, String(""), false, Layout { profile_out: String(""), profile: String(""), reach: false, preset: Vec() })
}

// The assembly of a program as text (`rync asm`): the functions of the IR text, or the one called `only`, one line per
// instruction; with `summary` just the instruction and byte count of each. The program is generated exactly as for an
// executable (the same generator, with a flag that makes it keep the text of each instruction).
pub fun generate_listing(text: String, windows: bool, only: String, summary: bool) -> Result<String, String> {
    program := ir::decode_ir(text.clone())
    when program.is_err() {
        return Result::Err(String("the typed IR does not decode"))
    }
    mut built := build_listing(program.unwrap(), true, false, windows, true, only.clone(), summary, Layout { profile_out: String(""), profile: String(""), reach: false, preset: Vec() })
    when built.is_err() && built.unwrap_err() == needs_libc_marker() {
        when windows {
            return Result::Err(String("the C library is not available in a Windows program yet"))
        }
        again := ir::decode_ir(text)
        when again.is_err() {
            return Result::Err(String("the typed IR does not decode"))
        }
        built = build_listing(again.unwrap(), true, true, false, true, only, summary, Layout { profile_out: String(""), profile: String(""), reach: false, preset: Vec() })
    }
    when built.is_err() {
        return Result::Err(built.unwrap_err())
    }
    mut out := String("")
    for byte in built.unwrap() {
        out.push(char_from_u32(byte as u32))
    }
    return Result::Ok(out)
}

fun build_listing(input: ir::IrProgram, executable: bool, libc: bool, windows: bool, listing: bool, only: String, summary: bool, plan: Layout) -> Result<Vec<u8>, String> {
    runtime_base := input.functions.len()
    program := ir::append_ir(input, float_runtime_ir::source_ir())?
    mut asm := x64::new_asm()
    asm.listing = listing
    mut gen := Gen {
        program: program,
        labels: Vec(),
        breaks: Vec(),
        continues: Vec(),
        rodata: Vec(),
        literal_offsets: Vec(),
        literal_lengths: Vec(),
        symbol_names: Vec(),
        symbol_sections: Vec(),
        symbol_values: Vec(),
        symbol_sizes: Vec(),
        symbol_global: Vec(),
        literal_symbols: Vec(),
        handler_label: 0,
        division_error_label: 0,
        index_error_label: 0,
        set_error_label: 0,
        index_literal: 0,
        overflow_literal: 0,
        invalid_literal: 0,
        division_literal: 0,
        write_label: 0,
        buffered: false,
        stdout_symbol: 0,
        flush_label: 0,
        map_hash_scalar: 0,
        map_hash_string: 0,
        key_base: 0,
        struct_key_drop: 0,
        map_find_scalar: 0,
        map_find_string: 0,
        map_grow: 0,
        string_less_label: 0,
        string_clone_label: 0,
        needed: Vec(),
        vec_routine_elements: Vec(),
        vec_routine_labels: Vec(),
        arguments_symbol: 0,
        runtime_cell_symbol: 0,
        cpu_cell_symbol: 0,
        profiling: !plan.profile_out.is_empty(),
        profile_symbol: 0,
        profile_dump_label: 0,
        map_clone_plain: 0,
        map_clone_key_text: 0,
        map_clone_value_text: 0,
        map_clone_both_text: 0,
        print_u64_label: 0,
        print_i64_label: 0,
        print_bool_label: 0,
        float_format_label: 0,
        native_float_format: runtime_base + float_runtime_ir::format_index(),
        native_float_parse: runtime_base + float_runtime_ir::parse_index(),
        float_format_used: false,
        textops_used: 0,
        trim_label: 0,
        case_label: 0,
        reverse_label: 0,
        find_label: 0,
        copy_ty_id: 0,
        shadow_slots: Vec(),
        ffi_copies: Vec(),
        shadow_images: Vec(),
        shadow_ids: Vec(),
        freestanding: false,
        windows: false,
        win_syscall: 0,
        win_init: 0,
        win_veh: 0,
        win_state: 0,
        win_names: Vec(),
        win_symbols: Vec(),
        dynamic_imports: false,
        wants_libc: false,
        c_overflow: Vec(),
        helper_names: Vec(),
        helper_labels: Vec(),
        span_start: 0,
        span_end: 0,
        failed_start: 0,
        failed_end: 0,
        rt: rt::Labels { malloc: 0, free: 0, realloc: 0, calloc: 0, memcpy: 0, memmove: 0, strlen: 0, fopen: 0, fseek: 0, ftell: 0, fread: 0, fwrite: 0, fclose: 0, strerror: 0, errno_location: 0, putchar: 0, chmod: 0, rename: 0, unlink: 0, getpid: 0, sigreturn: 0, live_allocations: 0, live_bytes: 0, state: 0, flush: 0 },
        enum_clone_ids: Vec(),
        enum_clone_labels: Vec(),
        glue_kinds: Vec(),
        map_value_type: 0,
        glue_elements: Vec(),
        glue_labels: Vec(),
        scratch_base: 0,
        scratch_used: 0,
        regions_base: Vec(),
        regions_type: Vec(),
        thunk_functions: Vec(),
        thunk_labels: Vec(),
        failed: false,
        reason: String(""),
        argument_cells: 0,
        result_cells: 0,
        result_type: 0,
        owner_slots: Vec(),
        owner_types: Vec(),
        drop_value_ids: Vec(),
        drop_value_index: Map<u64, u64>(),
        glue_index: Map<u64, u64>(),
        drop_value_labels: Vec(),
        drop_handle_ids: Vec(),
        drop_handle_index: Map<u64, u64>(),
        struct_types: Map<u64, u64>(),
        drop_handle_labels: Vec(),
        drop_values_done: 0,
        drop_handles_done: 0,
        drop_value_ascending: Vec(),
        temp_exprs: Vec(),
        temp_cells: Vec(),
        temp_ready: Vec(),
        vec_clone_done: 0,
        enum_clone_done: 0,
        glue_done: 0,
        thunks_done: 0,
        literal_indices: Map<String, u64>(),
        in_function: false,
        inline_active: false,
        inline_slots: Vec(),
        inline_cells: Vec(),
        inline_nodes: 0,
        inline_limit: 32,
        inline_locals: false,
        inline_exits: Vec(),
        inline_kinds: Vec(),
        const_state: Vec(),
        const_bits: Vec(),
        def_count: Vec(),
        def_init: Vec(),
        def_bad: Vec(),
        def_addressed: Vec(),
        def_reads: Vec(),
        def_weight: Vec(),
        def_seen: Vec(),
        def_noreg: Vec(),
        scan_depth: 0,
        live_first: Vec(),
        live_last: Vec(),
        loop_starts: Vec(),
        loop_ends: Vec(),
        scan_pos: 0,
        scan_whole: false,
        sroa_base: Vec(),
        sroa_list: Vec(),
        bce_vec: Vec(),
        bce_idx: Vec(),
        bce_cut: Vec(),
        bce_on: Vec(),
        slot_reg: Vec(),
        saved_regs: Vec(),
        saved_cells: Vec(),
        lent: Vec(),
        cur_function: 0,
        tail_ok: false,
        tail_label: 0,
        no_opt: !env::get("RYN_NO_OPT").is_empty(),
        poison: !env::get("RYN_REGPOISON").is_empty(),
        symbols: !env::get("RYN_SYMBOLS").is_empty(),
    }
    // Symbol 0 is the entry point `main`, which the C runtime calls; its size is set when the object is made.
    gen.freestanding = !libc
    gen.dynamic_imports = executable && libc
    mut expression: u64 = 0
    while expression < gen.program.exprs.len() {
        gen.const_state.push(0)
        gen.lent.push(false)
        gen.const_bits.push(0)
        expression += 1
    }
    mut type_at: u64 = 0
    while type_at < gen.program.types.len() {
        structure := choose gen.program.types[type_at] {
            ir::IrTy::StructTy(other) => Option::Some(other),
            _ => Option::None,
        }
        when structure.is_some() && !gen.struct_types.contains_key(structure.unwrap()) {
            gen.struct_types.insert(structure.unwrap(), type_at)
        }
        type_at += 1
    }
    for function in gen.program.functions.clone() {
        when function.external_symbol.is_some() && !rt_provides(function.external_symbol.unwrap()) && !executable {
            gen.freestanding = false
        }
    }
    when gen.freestanding || gen.dynamic_imports {
        gen.symbol(String("_start"), elf::Where::TEXT, 0, 0, true)
    } else {
        gen.symbol(String("main"), elf::Where::TEXT, 0, 0, true)
    }
    gen.arguments_symbol = gen.symbol(String("ryn_arguments"), elf::Where::BSS, 0, 16, false)
    gen.rt.state = gen.symbol(String("ryn_runtime"), elf::Where::BSS, 16, rt::state_size(), false)
    gen.runtime_cell_symbol = gen.symbol(String("ryn_runtime_cell"), elf::Where::BSS, 16 + rt::state_size(), 8, false)
    gen.cpu_cell_symbol = gen.symbol(String("ryn_cpu_cell"), elf::Where::BSS, 16 + rt::state_size() + 8, 8, false)
    gen.rt.live_allocations = asm.new_label()
    gen.rt.live_bytes = asm.new_label()
    gen.rt.malloc = asm.new_label()
    gen.rt.free = asm.new_label()
    gen.rt.realloc = asm.new_label()
    gen.rt.calloc = asm.new_label()
    gen.rt.memcpy = asm.new_label()
    gen.rt.memmove = asm.new_label()
    gen.rt.strlen = asm.new_label()
    gen.rt.fopen = asm.new_label()
    gen.rt.fseek = asm.new_label()
    gen.rt.ftell = asm.new_label()
    gen.rt.fread = asm.new_label()
    gen.rt.fwrite = asm.new_label()
    gen.rt.fclose = asm.new_label()
    gen.rt.strerror = asm.new_label()
    gen.rt.errno_location = asm.new_label()
    gen.rt.putchar = asm.new_label()
    gen.rt.chmod = asm.new_label()
    gen.rt.rename = asm.new_label()
    gen.rt.unlink = asm.new_label()
    gen.rt.getpid = asm.new_label()
    gen.rt.sigreturn = asm.new_label()
    gen.literal(String("\n"))
    gen.literal(String("true"))
    gen.literal(String("false"))
    gen.overflow_literal = gen.literal(String("Ryn runtime error: stack overflow (recursion is too deep)\n"))
    gen.invalid_literal = gen.literal(String("Ryn runtime error: invalid memory access (segmentation fault)\n"))
    gen.handler_label = asm.new_label()
    gen.division_error_label = asm.new_label()
    gen.index_error_label = asm.new_label()
    gen.set_error_label = asm.new_label()
    gen.write_label = asm.new_label()
    gen.map_hash_scalar = asm.new_label()
    gen.struct_key_drop = asm.new_label()
    gen.map_hash_string = asm.new_label()
    gen.map_find_scalar = asm.new_label()
    gen.map_find_string = asm.new_label()
    gen.map_grow = asm.new_label()
    gen.string_less_label = asm.new_label()
    gen.string_clone_label = asm.new_label()
    gen.map_clone_plain = asm.new_label()
    gen.map_clone_key_text = asm.new_label()
    gen.map_clone_value_text = asm.new_label()
    gen.map_clone_both_text = asm.new_label()
    gen.print_u64_label = asm.new_label()
    gen.print_i64_label = asm.new_label()
    gen.print_bool_label = asm.new_label()
    gen.float_format_label = asm.new_label()
    gen.trim_label = asm.new_label()
    gen.case_label = asm.new_label()
    gen.reverse_label = asm.new_label()
    gen.find_label = asm.new_label()
    mut position: u64 = 0
    while position < gen.program.functions.len() {
        label := asm.new_label()
        gen.labels.push(label)
        gen.needed.push(false)
        position += 1
    }
    gen.needed.set(gen.program.main_index, true)
    // The functions a profiled generation was told that the program reaches (see `Layout`).
    when plan.preset.len() == gen.program.functions.len() {
        mut known: u64 = 0
        while known < plan.preset.len() {
            when plan.preset[known] == 1 {
                gen.needed.set(known, true)
            }
            known += 1
        }
    }
    when windows {
        gen.windows = true
        asm.windows = true
        asm.syscall_label = asm.new_label()
        mut symbols: Vec<u64> = Vec()
        for name in winrt::api_names() {
            symbols.push(gen.foreign_symbol(name))
        }
        state := gen.symbol(String("ryn_win_state"), elf::Where::BSS, 16 + rt::state_size() + 16, 16, false)
        gen.win_syscall = asm.syscall_label
        gen.win_init = asm.new_label()
        gen.win_veh = asm.new_label()
        gen.win_state = state
        gen.win_names = winrt::api_names()
        gen.win_symbols = symbols
    }
    // The buffer of standard output, after the Windows state (there is none for Windows).
    when !gen.windows && !gen.no_opt {
        gen.buffered = true
        gen.stdout_symbol = gen.symbol(String("ryn_stdout"), elf::Where::BSS, 16 + rt::state_size() + 16 + gen.windows_state_size(), gen.stdout_state_size(), false)
        gen.flush_label = asm.new_label()
        gen.rt.flush = gen.flush_label
    }
    // The entry counters of the functions, after the Windows state, and the label of the routine that writes them at exit.
    when gen.profiling {
        gen.profile_symbol = gen.symbol(String("ryn_profile_counts"), elf::Where::BSS, gen.profile_offset(), 8 * gen.program.functions.len(), false)
        gen.profile_dump_label = asm.new_label()
    }
    gen.entry(&mut asm)
    start_size := asm.code.len()
    when gen.windows {
        gen.emit_windows(&mut asm)
    }
    // The functions reached from `main` are generated, and the routines that the code names are written: the runtime, the
    // clones and drops, the thunks, the text and float routines. Generating one may name more, so the pass repeats until it
    // writes no code.
    mut generated: Vec<bool> = Vec()
    while generated.len() < gen.program.functions.len() {
        generated.push(false)
    }
    // The order in which the functions are generated: the program's own, or with a profile the most entered first.
    order := gen.generation_order(plan.profile.clone())
    mut progress: bool = true
    while progress {
        before := asm.code.len()
        mut slot: u64 = 0
        while slot < order.len() {
            position = order[slot]
            when gen.needed[position] && !generated[position] {
                generated.set(position, true)
                when !gen.function(&mut asm, position) {
                    return Result::Err(gen.failure())
                }
                // What follows a function (a drop routine, a thunk) is not part of it in a listing.
                when asm.listing || gen.symbols {
                    asm.name_function(String("<support code>"))
                }
            }
            slot += 1
        }
        when gen.symbols {
            asm.name_function(String("<drop routines>"))
        }
        when !gen.emit_drop_routines(&mut asm) {
            return Result::Err(gen.failure())
        }
        when gen.symbols {
            asm.name_function(String("<vec routines>"))
        }
        when !gen.emit_vec_routines(&mut asm) {
            return Result::Err(gen.failure())
        }
        when gen.symbols {
            asm.name_function(String("<thunks>"))
        }
        when !gen.emit_thunks(&mut asm) {
            return Result::Err(gen.failure())
        }
        when gen.symbols {
            asm.name_function(String("<runtime>"))
        }
        gen.runtime(&mut asm)
        when gen.freestanding {
            gen.emit_freestanding(&mut asm)
            when gen.failed {
                return Result::Err(gen.failure())
            }
        }
        when gen.textops_used % 2 == 1 && asm.is_pending(gen.trim_label) {
            textops::emit_trim(&mut asm, gen.trim_label)
        }
        when gen.textops_used / 2 % 2 == 1 && asm.is_pending(gen.case_label) {
            mut malloc: u64 = 0
            when !gen.freestanding {
                malloc = gen.foreign_symbol(String("malloc"))
            }
            textops::emit_case(&mut asm, gen.case_label, malloc, gen.freestanding, gen.rt.malloc)
        }
        when gen.textops_used / 8 % 2 == 1 && asm.is_pending(gen.reverse_label) {
            mut reverse_malloc: u64 = 0
            when !gen.freestanding {
                reverse_malloc = gen.foreign_symbol(String("malloc"))
            }
            textops::emit_reverse(&mut asm, gen.reverse_label, reverse_malloc, gen.freestanding, gen.rt.malloc)
        }
        when gen.textops_used / 4 % 2 == 1 && asm.is_pending(gen.find_label) {
            textops::emit_find(&mut asm, gen.find_label)
        }
        mut helper: u64 = 0
        while helper < gen.helper_names.len() {
            when asm.is_pending(gen.helper_labels[helper]) {
                ffi_helpers::emit_helper(&mut asm, gen.helper_labels[helper], gen.helper_names[helper].clone())
            }
            helper += 1
        }
        when gen.float_format_used && asm.is_pending(gen.float_format_label) {
            snprintf := gen.foreign_symbol(String("snprintf"))
            strtod := gen.foreign_symbol(String("strtod"))
            strtof := gen.foreign_symbol(String("strtof"))
            fesetround := gen.foreign_symbol(String("fesetround"))
            floats::emit_float_format(&mut asm, gen.float_format_label, snprintf, strtod, strtof, fesetround)
        }
        when gen.failed {
            return Result::Err(gen.failure())
        }
        progress = asm.code.len() != before
    }
    when gen.profiling {
        gen.emit_profile_dump(&mut asm, plan.profile_out.clone())
    }
    // A reach layout returns the functions the program reaches, once they are all known.
    when plan.reach {
        when gen.wants_libc && !libc {
            return Result::Err(needs_libc_marker())
        }
        mut flags: Vec<u8> = Vec()
        mut at: u64 = 0
        while at < gen.needed.len() {
            when gen.needed[at] {
                flags.push(1 as u8)
            } else {
                flags.push(0 as u8)
            }
            at += 1
        }
        return Result::Ok(flags)
    }
    when !asm.resolve() {
        return Result::Err(String("a jump has no target"))
    }
    when listing {
        text := asm.listing_text(only, summary)
        when text.is_empty() {
            return Result::Err(String("no function with that name"))
        }
        mut bytes: Vec<u8> = Vec()
        mut at: u64 = 0
        while at < text.len() {
            bytes.push(text.byte_at(at))
            at += 1
        }
        return Result::Ok(bytes)
    }
    when executable {
        when gen.wants_libc && !libc {
            return Result::Err(needs_libc_marker())
        }
        when gen.symbols {
            mut at: u64 = 0
            while at < asm.names_at.len() {
                mut line := String(asm.names_at[at])
                line.append(" ")
                line.append(asm.names_text[at].clone())
                eprint("{}", line)
                at += 1
            }
        }
        when gen.windows {
            return pe::link_executable(gen.object(&mut asm, start_size))
        }
        return elf::link_executable(gen.object(&mut asm, start_size))
    }
    return Result::Ok(elf::write_object(gen.object(&mut asm, start_size)))
}

extend Gen {
    // Records a string literal and returns its index. Literal `i` is the symbol `i + 1`, since symbol 0 is `_start`.
    fun literal(mut self, text: String) -> u64 {
        when self.literal_indices.contains_key(text.clone()) {
            return self.literal_indices.get(text).unwrap()
        }
        index := self.literal_offsets.len()
        mut name := String("ryn_literal_")
        name.append(String(index))
        self.literal_symbols.push(self.symbol(name, elf::Where::RODATA, self.rodata.len(), text.len(), false))
        self.literal_offsets.push(self.rodata.len())
        self.literal_lengths.push(text.len())
        mut at: u64 = 0
        while at < text.len() {
            self.rodata.push(text.byte_at(at))
            at += 1
        }
        self.literal_indices.insert(text, index)
        return index
    }

    // Adds a symbol to the object's table and returns its index.
    fun symbol(mut self, name: String, section: u64, value: u64, size: u64, global: bool) -> u64 {
        index := self.symbol_names.len()
        self.symbol_names.push(name)
        self.symbol_sections.push(section)
        self.symbol_values.push(value)
        self.symbol_sizes.push(size)
        self.symbol_global.push(global)
        return index
    }

    // The symbol of a foreign function, which the link resolves; it is added the first time the program calls it.
    fun foreign_symbol(mut self, name: String) -> u64 {
        mut index: u64 = 0
        while index < self.symbol_names.len() {
            when self.symbol_sections[index] == elf::Where::UNDEFINED && self.symbol_names[index] == name {
                return index
            }
            index += 1
        }
        return self.symbol(name, elf::Where::UNDEFINED, 0, 0, true)
    }

    // The name of the kind of an expression, for the reasons a program is declined.
    fun expr_name(self, index: u64) -> String {
        return choose self.program.exprs[index] {
            ir::IrExpr::IntegerLit(text, ty) => String("an integer literal"),
            ir::IrExpr::FloatLit(bits, ty) => String("a float literal"),
            ir::IrExpr::StrLit(text) => String("a string literal"),
            ir::IrExpr::CharLit(scalar) => String("a character literal"),
            ir::IrExpr::BoolLit(flag) => String("a boolean literal"),
            ir::IrExpr::LocalRef(slot, ty, span) => String("a local"),
            ir::IrExpr::MoveRef(slot, ty) => String("a moved local"),
            ir::IrExpr::StructValue(id, fields, values) => String("a structure literal"),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => String("a field read"),
            ir::IrExpr::ReferenceFieldRead(value, id, field, ty, span, borrowed) => String("a field read through a reference"),
            ir::IrExpr::ValueAddress(value, ty, pointer, span) => String("the address of a value"),
            ir::IrExpr::CallExpr(target, arguments, ty) => String("a call"),
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => String("an if expression"),
            ir::IrExpr::EnumMatch(value, id, arms, ty) => String("a choose expression"),
            ir::IrExpr::Propagate(value, a, b, c, d, e, f, g, deferred) => String("a propagation"),
            ir::IrExpr::ArrayValue(items) => String("an array literal"),
            ir::IrExpr::ArrayRepeat(value, count) => String("an array repeat"),
            ir::IrExpr::ArrayAsSlice(array, ty, length) => String("an array as a slice"),
            ir::IrExpr::ArrayIndex(array, index, ty, length) => String("an array index"),
            ir::IrExpr::SliceIndex(slice, index, ty) => String("a slice index"),
            ir::IrExpr::SliceElementAddress(slice, index, ty, span) => String("the address of a slice element"),
            ir::IrExpr::AddressOf(slot, ty, pointer, span) => String("the address of a local"),
            ir::IrExpr::Dereference(pointer, ty) => String("a dereference"),
            ir::IrExpr::PlaceAddress(place, ty) => String("the address of a nested field"),
            ir::IrExpr::StringFindOption(value, id) => String("a find result"),
            ir::IrExpr::StringAsStr(value) => String("a String as str"),
            ir::IrExpr::Binary(op, left, right, ty) => String("an arithmetic expression"),
            ir::IrExpr::Negate(value, ty) => String("a negation"),
            ir::IrExpr::Not(value) => String("a logical not"),
            ir::IrExpr::BitNot(value, ty) => String("a bitwise not"),
            ir::IrExpr::FunctionAddress(function, ty) => String("a function address"),
            ir::IrExpr::FfiArray(array, element, length, index, mutable) => String("a pointer into an array"),
            ir::IrExpr::CastExpr(value, source, target) => String("a cast"),
        }
    }

    // Declines with `what` and the kind of the expression at `index`.
    fun fail_at(mut self, what: str, index: u64) -> bool {
        mut message := String(what)
        message.append(" (")
        message.append(self.expr_name(index))
        message.append(")")
        when !self.failed {
            self.failed = true
            self.reason = message
            self.failed_start = self.span_start
            self.failed_end = self.span_end
        }
        return false
    }

    fun fail(mut self, what: str) -> bool {
        when !self.failed {
            self.failed = true
            self.reason = String(what)
            self.failed_start = self.span_start
            self.failed_end = self.span_end
        }
        return false
    }

    // The reason generation failed, as a diagnostic at its place when one is known.
    fun failure(self) -> String {
        when self.failed_end == 0 {
            return self.reason.clone()
        }
        // The form `lower::diagnostic` writes: `diagnostic <code> <start> <end> <message> <help>`.
        mut out := String("diagnostic R0905 ")
        out.append(String(self.failed_start))
        out.append(" ")
        out.append(String(self.failed_end))
        out.append(" ")
        out.append(String(self.reason.len()))
        out.append(":")
        out.append(self.reason.clone())
        out.append(" 0:")
        return out
    }

    fun note_span(mut self, span: ir::IrSpan) -> bool {
        when span.end > 0 {
            self.span_start = span.start
            self.span_end = span.end
        }
        return true
    }

    fun note_statement(mut self, index: u64) -> bool {
        return choose self.program.stmts[index] {
            ir::IrStmt::LetStmt(slot, ty, value, span) => self.note_span(span),
            ir::IrStmt::AssignStmt(slot, ty, value, span) => self.note_span(span),
            ir::IrStmt::ArrayAssignStmt(slot, ty, position, value, element, span) => self.note_span(span),
            _ => true,
        }
    }

    fun note_expression(mut self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => self.note_span(span),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.note_span(span),
            ir::IrExpr::ReferenceFieldRead(value, id, field, ty, span, borrowed) => self.note_span(span),
            _ => true,
        }
    }

    // The scalar type word of a type index, or "" for a type that is not scalar.
    fun word(self, ty: u64) -> String {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => word,
            _ => String(""),
        }
    }

    // Brings the value in rax to the canonical form of its type: sign-extended from its width for a signed type,
    // zero-extended otherwise. 64-bit types are already canonical.
    fun normalize(mut self, asm: &mut x64::Asm, word: String) {
        width := width_of(word.clone())
        when width == 0 || width == 8 {
            return
        }
        when is_signed_word(word) {
            asm.sext_rr(x64::Reg::RAX, x64::Reg::RAX, width)
        } else {
            asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, width)
        }
    }

    // The entry point: call `main`, then exit with its result (or 0 when it returns nothing).
    fun entry(mut self, asm: &mut x64::Asm) {
        // A freestanding object starts at `_start`: the stack holds argc, then argv. It sets the C registers and calls the
        // entry below, then exits with its result.
        entry_body := asm.new_label()
        when self.dynamic_imports {
            // An executable that uses the C library starts as the C runtime's `_start` does: the dynamic loader's
            // finalizer is in rdx, argc and argv are on the stack, and `__libc_start_main` initializes the library, calls
            // the entry below as `main`, and exits with its result (writing out the library's buffered streams).
            asm.mov_ri(x64::Reg::RBP, 0)
            asm.mov_rr(x64::Reg::R9, x64::Reg::RDX)
            asm.pop(x64::Reg::RSI)
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RSP)
            asm.alu_ri(4, x64::Reg::RSP, (0 as i64) - 16)
            asm.push(x64::Reg::RAX)
            asm.push(x64::Reg::RSP)
            asm.mov_ri(x64::Reg::R8, 0)
            asm.mov_ri(x64::Reg::RCX, 0)
            asm.lea_label(x64::Reg::RDI, entry_body)
            asm.call_symbol(self.foreign_symbol(String("__libc_start_main")))
            asm.trap()
        }
        when self.windows {
            // Windows enters with the return address on the stack: the command line is read by the start-up routine.
            asm.alu_ri(4, x64::Reg::RSP, (0 as i64) - 16)
            asm.call_label(self.win_init)
            asm.alu_ri(4, x64::Reg::RSP, (0 as i64) - 16)
            asm.call_label(entry_body)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.mov_ri(x64::Reg::RAX, 231)
            asm.syscall()
        } else when self.freestanding {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
            asm.lea(x64::Reg::RSI, x64::Reg::RSP, 8)
            asm.alu_ri(4, x64::Reg::RSP, (0 as i64) - 16)
            asm.call_label(entry_body)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.mov_ri(x64::Reg::RAX, 231)
            asm.syscall()
        }
        asm.bind(entry_body)
        // The C runtime calls main with argc in rdi and argv in rsi; they are kept for `arg_count` and `arg`.
        asm.lea_symbol(x64::Reg::RAX, self.arguments_symbol)
        asm.store(8, x64::Reg::RDI, x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RSI, x64::Reg::RAX, 8)
        // A stack for the segmentation handler, then the handler for SIGSEGV. The `stack_t` is at the frame's bottom and
        // the `sigaction` (152 bytes, with the handler first and the flags after the 128-byte mask) above it.
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 192)
        asm.mov_ri(x64::Reg::RDI, 65536)
        when self.freestanding {
            asm.call_label(self.rt.malloc)
        } else {
            asm.call_symbol(self.foreign_symbol(String("malloc")))
        }
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 8)
        asm.mov_ri(x64::Reg::RAX, 65536)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 16)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RSP)
        asm.mov_ri(x64::Reg::RSI, 0)
        when self.freestanding {
            asm.mov_ri(x64::Reg::RAX, 131)
            asm.syscall()
        } else {
            asm.call_symbol(self.foreign_symbol(String("sigaltstack")))
        }
        asm.mov_ri(x64::Reg::RAX, 0)
        mut zeroed: u64 = 0
        while zeroed < 19 {
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, (32 + zeroed * 8) as i64)
            zeroed += 1
        }
        asm.lea_label(x64::Reg::RAX, self.handler_label)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
        when self.freestanding {
            // The kernel's layout: the handler, the flags (`SA_SIGINFO`, `SA_ONSTACK`, `SA_RESTORER`), the restorer, the mask.
            asm.mov_ri(x64::Reg::RAX, 201326596)
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 40)
            asm.lea_label(x64::Reg::RAX, self.rt.sigreturn)
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 48)
            asm.mov_ri(x64::Reg::RAX, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 56)
            asm.mov_ri(x64::Reg::RDI, 11)
            asm.lea(x64::Reg::RSI, x64::Reg::RSP, 32)
            asm.mov_ri(x64::Reg::RDX, 0)
            asm.mov_ri(x64::Reg::R10, 8)
            asm.mov_ri(x64::Reg::RAX, 13)
            asm.syscall()
        } else {
            asm.mov_ri(x64::Reg::RAX, 134217732)
            asm.store(4, x64::Reg::RAX, x64::Reg::RSP, 168)
            asm.mov_ri(x64::Reg::RDI, 11)
            asm.lea(x64::Reg::RSI, x64::Reg::RSP, 32)
            asm.mov_ri(x64::Reg::RDX, 0)
            asm.call_symbol(self.foreign_symbol(String("sigaction")))
        }
        // A profiling program writes its counters when it exits: `__cxa_atexit` (what `atexit` is in the C library) runs the
        // routine at the exit of `main`, with no argument and no dynamic object.
        when self.profiling {
            asm.lea_label(x64::Reg::RDI, self.profile_dump_label)
            asm.mov_ri(x64::Reg::RSI, 0)
            asm.mov_ri(x64::Reg::RDX, 0)
            asm.call_symbol(self.foreign_symbol(String("__cxa_atexit")))
        }
        asm.call_label(self.labels[self.program.main_index])
        main_function := self.program.functions[self.program.main_index]
        when main_function.return_type.is_none() {
            asm.mov_ri(x64::Reg::RAX, 0)
        }
        when self.buffered {
            asm.push(x64::Reg::RAX)
            asm.call_label(self.flush_label)
            asm.pop(x64::Reg::RAX)
        }
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
    }

    // The write routine of a buffered standard output: the bytes at rsi, of length rdx, are added to the buffer, which is written
    // out first when they do not fit, and a write too long for the buffer goes at once. The first call finds out whether
    // standard output is a terminal (`ioctl TCGETS`), which is not buffered. Keeps rdi, rsi and rdx; clobbers rax, rcx, r11.
    fun emit_buffered_write(mut self, asm: &mut x64::Asm) {
        known := asm.new_label()
        direct := asm.new_label()
        make_room := asm.new_label()
        append := asm.new_label()
        done := asm.new_label()
        buffered_mode := asm.new_label()
        asm.bind(self.write_label)
        asm.push(x64::Reg::RDI)
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        asm.lea_symbol(x64::Reg::R11, self.stdout_symbol)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::R11, 0)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::NOT_EQUAL, known)
        // Not known yet: a terminal answers TCGETS with 0, anything else with an error.
        asm.alu_ri(5, x64::Reg::RSP, 64)
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RSI, 21505)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RSP)
        asm.mov_ri(x64::Reg::RAX, 16)
        asm.syscall()
        asm.alu_ri(0, x64::Reg::RSP, 64)
        asm.mov_ri(x64::Reg::RCX, 1)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::NOT_EQUAL, buffered_mode)
        asm.mov_ri(x64::Reg::RCX, 2)
        asm.bind(buffered_mode)
        asm.lea_symbol(x64::Reg::R11, self.stdout_symbol)
        asm.store(8, x64::Reg::RCX, x64::Reg::R11, 0)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        asm.bind(known)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.alu_ri(7, x64::Reg::RAX, 2)
        asm.jcc(x64::Cc::EQUAL, direct)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::R11, 8)
        asm.lea(x64::Reg::RAX, x64::Reg::RCX, 0)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RDX)
        asm.alu_ri(7, x64::Reg::RAX, 65536)
        asm.jcc(x64::Cc::ABOVE, make_room)
        asm.bind(append)
        asm.store(8, x64::Reg::RAX, x64::Reg::R11, 8)
        asm.lea(x64::Reg::RDI, x64::Reg::R11, 16)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RCX)
        asm.mov_rr(x64::Reg::RCX, x64::Reg::RDX)
        asm.rep_movsb()
        asm.jmp(done)
        asm.bind(make_room)
        asm.call_label(self.flush_label)
        asm.lea_symbol(x64::Reg::R11, self.stdout_symbol)
        asm.alu_ri(7, x64::Reg::RDX, 65536)
        asm.jcc(x64::Cc::ABOVE, direct)
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
        asm.jmp(append)
        asm.bind(direct)
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
        asm.bind(done)
        asm.pop(x64::Reg::RDX)
        asm.pop(x64::Reg::RSI)
        asm.pop(x64::Reg::RDI)
        asm.ret()
    }

    // The routine that writes out the buffer of standard output. Keeps rdi, rsi and rdx; clobbers rax, rcx, r11.
    fun emit_flush(mut self, asm: &mut x64::Asm) {
        out := asm.new_label()
        again := asm.new_label()
        asm.bind(self.flush_label)
        asm.push(x64::Reg::RDI)
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        asm.lea_symbol(x64::Reg::R11, self.stdout_symbol)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::R11, 8)
        asm.test_rr(x64::Reg::RDX, x64::Reg::RDX)
        asm.jcc(x64::Cc::EQUAL, out)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::R11, 8)
        asm.lea(x64::Reg::RSI, x64::Reg::R11, 16)
        asm.bind(again)
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::LESS_EQUAL, out)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RAX)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RAX)
        asm.jcc(x64::Cc::NOT_EQUAL, again)
        asm.bind(out)
        asm.pop(x64::Reg::RDX)
        asm.pop(x64::Reg::RSI)
        asm.pop(x64::Reg::RDI)
        asm.ret()
    }

    // The runtime routines: `write` (buffer in rsi, length in rdx, to standard output), and the printers of unsigned,
    // signed and boolean values in rax, each followed by nothing (the newline is written by the statement).
    fun runtime(mut self, asm: &mut x64::Asm) {
        self.map_routines(asm)
        when asm.is_pending(self.write_label) && !self.buffered {
            asm.bind(self.write_label)
            asm.mov_ri(x64::Reg::RDI, 1)
            asm.mov_ri(x64::Reg::RAX, 1)
            asm.syscall()
            asm.ret()
        }
        when asm.is_pending(self.write_label) && self.buffered {
            self.emit_buffered_write(asm)
        }
        when self.buffered && asm.is_pending(self.flush_label) {
            self.emit_flush(asm)
        }

        // Digits are written backwards into a 32-byte buffer on the stack, from its last byte.
        when asm.is_pending(self.print_u64_label) {
            asm.bind(self.print_u64_label)
            asm.push(x64::Reg::RBP)
            asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
            asm.alu_ri(5, x64::Reg::RSP, 32)
            asm.lea(x64::Reg::R8, x64::Reg::RSP, 32)
            asm.mov_ri(x64::Reg::RCX, 10)
            digits := asm.new_label()
            asm.bind(digits)
            asm.alu_rr(49, x64::Reg::RDX, x64::Reg::RDX)
            asm.unary(6, x64::Reg::RCX)
            asm.alu_ri(0, x64::Reg::RDX, 48)
            asm.alu_ri(5, x64::Reg::R8, 1)
            asm.store(1, x64::Reg::RDX, x64::Reg::R8, 0)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::NOT_EQUAL, digits)
            asm.lea(x64::Reg::RDX, x64::Reg::RSP, 32)
            asm.alu_rr(41, x64::Reg::RDX, x64::Reg::R8)
            asm.mov_rr(x64::Reg::RSI, x64::Reg::R8)
            asm.call_label(self.write_label)
            asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
            asm.pop(x64::Reg::RBP)
            asm.ret()
        }

        // A negative value is written with its sign first; the magnitude is printed unsigned.
        when asm.is_pending(self.print_i64_label) {
            asm.bind(self.print_i64_label)
            positive := asm.new_label()
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::GREATER_EQUAL, positive)
            asm.push(x64::Reg::RAX)
            asm.alu_ri(5, x64::Reg::RSP, 8)
            asm.mov_ri(x64::Reg::RCX, 45)
            asm.store(1, x64::Reg::RCX, x64::Reg::RSP, 0)
            asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
            asm.mov_ri(x64::Reg::RDX, 1)
            asm.call_label(self.write_label)
            asm.alu_ri(0, x64::Reg::RSP, 8)
            asm.pop(x64::Reg::RAX)
            asm.unary(3, x64::Reg::RAX)
            asm.bind(positive)
            asm.jmp(self.print_u64_label)
        }

        // The SIGSEGV handler: `rsi` is the siginfo (the fault address at 16) and `rdx` the context (the stack pointer
        // of the fault at 160). A fault within 64 KiB of that stack pointer is a stack overflow; any other is an invalid
        // access. The message goes to standard error, and the process exits with status 1.
        // An index past the end of a vector: the message to standard error, and exit with status 1.
        when asm.is_pending(self.index_error_label) {
            self.index_literal = self.literal(String("Ryn runtime error: array index is out of bounds\n"))
            asm.bind(self.index_error_label)
            self.flush_stdout(asm)
            asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[self.index_literal])
            asm.mov_ri(x64::Reg::RDX, self.literal_lengths[self.index_literal])
            asm.mov_ri(x64::Reg::RDI, 2)
            asm.mov_ri(x64::Reg::RAX, 1)
            asm.syscall()
            asm.mov_ri(x64::Reg::RDI, 1)
            asm.mov_ri(x64::Reg::RAX, 231)
            asm.syscall()
        }

        // `Vec::set` past the end: the same, with the message of that operation.
        when asm.is_pending(self.set_error_label) {
            set_literal := self.literal(String("Ryn runtime error: Vec index is out of bounds\n"))
            asm.bind(self.set_error_label)
            self.flush_stdout(asm)
            asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[set_literal])
            asm.mov_ri(x64::Reg::RDX, self.literal_lengths[set_literal])
            asm.mov_ri(x64::Reg::RDI, 2)
            asm.mov_ri(x64::Reg::RAX, 1)
            asm.syscall()
            asm.mov_ri(x64::Reg::RDI, 1)
            asm.mov_ri(x64::Reg::RAX, 231)
            asm.syscall()
        }

        // A division by zero: the message to standard error, and exit with status 1.
        when asm.is_pending(self.division_error_label) {
            self.division_literal = self.literal(String("Ryn runtime error: integer division or remainder by zero\n"))
            asm.bind(self.division_error_label)
            self.flush_stdout(asm)
            asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[self.division_literal])
            asm.mov_ri(x64::Reg::RDX, self.literal_lengths[self.division_literal])
            asm.mov_ri(x64::Reg::RDI, 2)
            asm.mov_ri(x64::Reg::RAX, 1)
            asm.syscall()
            asm.mov_ri(x64::Reg::RDI, 1)
            asm.mov_ri(x64::Reg::RAX, 231)
            asm.syscall()
        }

        when asm.is_pending(self.handler_label) {
            asm.bind(self.handler_label)
            asm.push(x64::Reg::RSI)
            asm.push(x64::Reg::RDX)
            self.flush_stdout(asm)
            asm.pop(x64::Reg::RDX)
            asm.pop(x64::Reg::RSI)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSI, 16)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 160)
            asm.mov_rr(x64::Reg::R8, x64::Reg::RAX)
            asm.alu_rr(41, x64::Reg::R8, x64::Reg::RCX)
            asm.alu_ri(0, x64::Reg::R8, 65536)
            overflow := asm.new_label()
            report := asm.new_label()
            asm.alu_ri(7, x64::Reg::R8, 131072)
            asm.jcc(x64::Cc::BELOW, overflow)
            asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[self.invalid_literal])
            asm.mov_ri(x64::Reg::RDX, self.literal_lengths[self.invalid_literal])
            asm.jmp(report)
            asm.bind(overflow)
            asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[self.overflow_literal])
            asm.mov_ri(x64::Reg::RDX, self.literal_lengths[self.overflow_literal])
            asm.bind(report)
            asm.mov_ri(x64::Reg::RDI, 2)
            asm.mov_ri(x64::Reg::RAX, 1)
            asm.syscall()
            asm.mov_ri(x64::Reg::RDI, 1)
            asm.mov_ri(x64::Reg::RAX, 231)
            asm.syscall()
        }

        // `true` or `false`, from a value that is 0 or 1.
        when asm.is_pending(self.print_bool_label) {
            asm.bind(self.print_bool_label)
            is_false := asm.new_label()
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::EQUAL, is_false)
            self.write_literal(asm, true_literal())
            asm.ret()
            asm.bind(is_false)
            self.write_literal(asm, false_literal())
            asm.ret()
        }
    }

    // Writes a string literal to standard output.
    fun write_literal(mut self, asm: &mut x64::Asm, index: u64) {
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[index])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[index])
        asm.call_label(self.write_label)
    }

    // The name of function `index` for a listing: the one the compiler wrote, without the `#method` mark, or its number.
    fun function_name(self, index: u64) -> String {
        when index < self.program.names.len() {
            mut name := self.program.names[index].clone()
            when name.ends_with("#method") {
                name = name.slice(0, name.len() - 7)
            }
            return name
        }
        mut name := String("function ")
        name.append(String(index))
        return name
    }

    // A function that starts with `when p <op> constant { return p or a constant }`, of scalar parameters that arrive in registers
    // (`fib`, `gcd`, `max` of a base case): the test and the return are written before the frame, so that the base case of a
    // recursion takes four instructions, not twelve. The rest of the function tests again.
    fun early_return(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        definition := self.program.functions[index]
        when self.no_opt || self.profiling || definition.statements.len() == 0 || !self.reg_args(index) || definition.return_type.is_none() {
            return false
        }
        returned := definition.return_type.unwrap()
        when !self.plain_word(returned) || self.value_width(returned) != 8 {
            return false
        }
        mut pair: u64 = 0
        while pair < definition.parameters.len() / 2 {
            ty := definition.parameters[pair * 2 + 1]
            when !self.plain_word(ty) || self.value_width(ty) > 8 || self.is_float(ty) {
                return false
            }
            pair += 1
        }
        guard := choose self.program.stmts[definition.statements[0]] {
            ir::IrStmt::IfStmt(condition, then_body, else_body) => if_text_id(then_body.len() == 1 && self.is_noop_body(else_body), condition),
            _ => 0,
        }
        when guard == 0 {
            return false
        }
        condition := guard - 1
        then_body := choose self.program.stmts[definition.statements[0]] {
            ir::IrStmt::IfStmt(c, then_body, else_body) => then_body,
            _ => Vec(),
        }
        value := choose self.program.stmts[then_body[0]] {
            ir::IrStmt::ReturnStmt(value) => value,
            _ => Option::None,
        }
        when value.is_none() {
            return false
        }
        op := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, ty) => op,
            _ => String(""),
        }
        left := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, ty) => left,
            _ => 0,
        }
        right := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, ty) => right,
            _ => 0,
        }
        compared := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, ty) => ty,
            _ => 0,
        }
        when op != "Eq" && op != "Ne" && op != "Lt" && op != "Le" && op != "Gt" && op != "Ge" {
            return false
        }
        left_pair := self.parameter_pair(definition.parameters.clone(), left)
        when left_pair == 0 || !self.plain_word(compared) {
            return false
        }
        immediate := self.immediate_operand(op.clone(), right)
        when immediate.is_none() {
            return false
        }
        // Where the value comes from: a parameter, or a constant.
        value_pair := self.parameter_pair(definition.parameters.clone(), value.unwrap())
        constant := self.const_value(value.unwrap())
        when value_pair == 0 && constant.is_none() {
            return false
        }
        mut opposite: String = String("Ge")
        when op == "Eq" {
            opposite = String("Ne")
        } else when op == "Ne" {
            opposite = String("Eq")
        } else when op == "Le" {
            opposite = String("Gt")
        } else when op == "Gt" {
            opposite = String("Le")
        } else when op == "Ge" {
            opposite = String("Lt")
        }
        rest := asm.new_label()
        asm.alu_ri(7, arg_register(left_pair - 1), immediate.unwrap() as i64)
        asm.jcc(comparison_condition(opposite, is_signed_word(self.word(compared))), rest)
        when value_pair != 0 {
            asm.mov_rr(x64::Reg::RAX, arg_register(value_pair - 1))
        } else {
            asm.mov_ri(x64::Reg::RAX, constant.unwrap())
        }
        asm.ret()
        asm.bind(rest)
        return true
    }

    // Whether a statement list has `return f(...)` with `f` the function `index` (a call that may become a jump to the start).
    fun returns_own_call(self, statements: Vec<u64>, index: u64) -> bool {
        for statement in statements {
            found := choose self.program.stmts[statement] {
                ir::IrStmt::ReturnStmt(value) => self.is_call_of(value, index),
                ir::IrStmt::BlockStmt(inner) => self.returns_own_call(inner, index),
                ir::IrStmt::IfStmt(condition, then_body, else_body) => self.returns_own_call(then_body, index) || self.returns_own_call(else_body, index),
                ir::IrStmt::WhileStmt(setup, condition, body) => self.returns_own_call(body, index),
                ir::IrStmt::ForStmt(slot, end_slot, ty, start, end, inclusive, body) => self.returns_own_call(body, index),
                _ => false,
            }
            when found {
                return true
            }
        }
        return false
    }

    fun is_call_of(self, value: Option<u64>, index: u64) -> bool {
        when value.is_none() {
            return false
        }
        return choose self.program.exprs[value.unwrap()] {
            ir::IrExpr::CallExpr(target, arguments, ty) => choose target {
                ir::CallTarget::Func(callee) => callee == index,
                _ => false,
            },
            _ => false,
        }
    }

    // Whether a list of statements does nothing: it is empty or holds only blocks without statements and drops of nothing.
    fun is_noop_body(self, statements: Vec<u64>) -> bool {
        for statement in statements {
            ok := choose self.program.stmts[statement] {
                ir::IrStmt::BlockStmt(inner) => self.is_noop_body(inner),
                ir::IrStmt::DropStmt(slots, types) => slots.len() == 0,
                _ => false,
            }
            when !ok {
                return false
            }
        }
        return true
    }

    // The position (plus one) of the parameter that expression `index` reads, or 0.
    fun parameter_pair(self, parameters: Vec<u64>, index: u64) -> u64 {
        slot := choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => slot + 1,
            _ => 0,
        }
        when slot == 0 {
            return 0
        }
        mut pair: u64 = 0
        while pair < parameters.len() / 2 {
            when parameters[pair * 2] + 1 == slot {
                return pair + 1
            }
            pair += 1
        }
        return 0
    }

    // A function: its frame, its parameters from the argument registers, its body, and a return that ends it.
    fun function(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        definition := self.program.functions[index]
        // A foreign function has no body here: its calls go to the C library.
        when definition.external_symbol.is_some() {
            return true
        }
        mut owned: u64 = 0
        while owned < definition.owned_slot_types.len() {
            when definition.owned_slot_types[owned].is_some() && !self.is_leakable(definition.owned_slot_types[owned].unwrap()) && !self.needs_drop(definition.owned_slot_types[owned].unwrap()) {
                return self.fail("an owned value")
            }
            owned += 1
        }
        when asm.listing || self.symbols {
            asm.name_function(self.function_name(index))
        }
        asm.bind(self.labels[index])
        when self.profiling {
            self.count_entry(asm, index)
        }
        skip_first := self.early_return(asm, index)
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        // The frame holds the locals and the scratch cells; its size is patched in once the body is generated.
        asm.alu_ri(5, x64::Reg::RSP, 0)
        frame_at := asm.code.len() - 4
        // Scratch owners may be live on an early return or absent on another branch, so a function that has owners zeroes its
        // whole frame before the parameters are loaded: the code for it is written after the function (see `zero_frame`),
        // and these five bytes jump to it, or stay a `nop` when there is nothing to zero.
        zero_slot := asm.code.len()
        asm.nop5()
        self.scratch_base = definition.local_types.len()
        self.regions_base = Vec()
        self.regions_type = Vec()
        mut parameter: u64 = 0
        while parameter < definition.parameters.len() / 2 {
            when self.contains_array(definition.parameters[parameter * 2 + 1]) {
                self.regions_base.push(definition.parameters[parameter * 2])
                self.regions_type.push(definition.parameters[parameter * 2 + 1])
            }
            parameter += 1
        }
        self.collect_regions(definition.statements.clone())
        self.scan_definitions(definition.statements.clone(), definition.parameters.clone(), definition.local_types.len(), definition.addressed_slot_types.clone())
        self.scratch_used = 0
        self.assign_registers(asm, definition.local_types.len())
        self.shadow_slots = Vec()
        self.shadow_images = Vec()
        self.shadow_ids = Vec()
        self.owner_slots = Vec()
        self.owner_types = Vec()
        mut owner: u64 = 0
        while owner < definition.owned_slot_types.len() {
            when definition.owned_slot_types[owner].is_some() && self.needs_drop(definition.owned_slot_types[owner].unwrap()) {
                self.owner_slots.push(self.phys_slot(owner))
                self.owner_types.push(definition.owned_slot_types[owner].unwrap())
                asm.mov_ri(x64::Reg::RAX, 0)
                asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(owner))
            }
            owner += 1
        }
        // The arguments are on the stack above the return address and the saved frame pointer, the last one lowest.
        mut total: u64 = 0
        mut pair: u64 = 0
        while pair < definition.parameters.len() / 2 {
            cells := self.cells_of(definition.parameters[pair * 2 + 1])
            when cells == 0 {
                return self.fail("a parameter of this type")
            }
            total += cells
            pair += 1
        }
        mut returned: u64 = 0
        mut returned_cells: u64 = 0
        when definition.return_type.is_some() {
            returned = definition.return_type.unwrap()
            returned_cells = self.aggregate_cells(returned)
        }
        self.argument_cells = total
        self.result_type = returned
        self.result_cells = returned_cells
        mut argument: u64 = 0
        pair = 0
        // A function whose parameters are single cells receives them in registers: each goes to its frame cell, and to its
        // own register when it has one.
        when self.reg_args(index) {
            while pair < definition.parameters.len() / 2 {
                base := definition.parameters[pair * 2]
                mut held: u64 = 0
                when self.slot_reg.len() > base {
                    held = self.slot_reg[base]
                }
                self.write_cell(asm, 8, arg_register(pair), base, held)
                when self.slot_reg.len() > base && self.slot_reg[base] != 0 {
                    asm.mov_rr(self.slot_reg[base], arg_register(pair))
                }
                pair += 1
            }
        }
        while pair < definition.parameters.len() / 2 {
            base := definition.parameters[pair * 2]
            cells := self.cells_of(definition.parameters[pair * 2 + 1])
            mut cell: u64 = 0
            while cell < cells {
                asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (16 + 8 * (total - 1 - argument)) as i64)
                asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + cell))
                when self.slot_reg.len() > base + cell && self.slot_reg[base + cell] != 0 {
                    asm.mov_rr(self.slot_reg[base + cell], x64::Reg::RAX)
                }
                argument += 1
                cell += 1
            }
            pair += 1
        }
        self.cur_function = index
        self.tail_ok = self.tail_calls_allowed(index)
        self.tail_label = asm.new_label()
        asm.bind(self.tail_label)
        self.in_function = true
        mut statements: Vec<u64> = Vec()
        mut first: u64 = 0
        // A tail call jumps back to the start of the body, which must then test the base case again.
        when skip_first && !self.returns_own_call(definition.statements.clone(), index) {
            first = 1
        }
        while first < definition.statements.len() {
            statements.push(definition.statements[first])
            first += 1
        }
        when !self.body(asm, statements) {
            return false
        }
        self.in_function = false
        self.def_count = Vec()
        self.def_init = Vec()
        self.def_bad = Vec()
        self.def_addressed = Vec()
        self.def_reads = Vec()
        self.def_weight = Vec()
        self.def_seen = Vec()
        self.def_noreg = Vec()
        bytes := ((self.scratch_base + self.scratch_used) * 8 + 15) / 16 * 16
        asm.patch32(frame_at, bytes)
        // The frame is zeroed so that an owner a branch never reached, or an early return skipped, drops nothing. A function
        // with no owner, scratch owner or shadow cell has nothing to zero.
        // Nothing follows a `return` that ends the body, so the leave that closes every other function is not written.
        when self.no_opt || !self.ends_in_leave(definition.statements.clone()) {
            self.leave(asm)
        }
        when self.no_opt || self.owner_slots.len() > 0 || self.shadow_slots.len() > 0 {
            stub := asm.code.len()
            self.zero_frame(asm, bytes)
            asm.jmp_offset(zero_slot + 5)
            asm.patch_jump(zero_slot, stub)
        }
        self.slot_reg = Vec()
        self.saved_regs = Vec()
        self.saved_cells = Vec()
        return true
    }

    // Chooses the locals that live in registers (r12 to r15, which nothing else in the generated code uses): the scalar
    // locals that are only written by `let`s, assignments, loops and parameters, never addressed, and used most. Each
    // gets a frame cell that saves the caller's value of its register.
    fun assign_registers(mut self, asm: &mut x64::Asm, count: u64) {
        self.slot_reg = Vec()
        self.saved_regs = Vec()
        self.saved_cells = Vec()
        when self.no_opt {
            return
        }
        mut slot: u64 = 0
        while slot < count {
            self.slot_reg.push(0)
            slot += 1
        }
        // The most used locals first; each takes the first of r12 to r15 that no local with an overlapping range holds. A register
        // is saved on entry the first time it is used.
        mut rejected: Vec<bool> = Vec()
        slot = 0
        while slot < count {
            rejected.push(false)
            slot += 1
        }
        while true {
            mut best: u64 = 0
            mut best_weight: u64 = 3
            slot = 0
            while slot < count && slot < self.def_seen.len() {
                when self.def_seen[slot] && !self.def_noreg[slot] && !self.def_addressed[slot] && self.slot_reg[slot] == 0 && !rejected[slot] && self.def_weight[slot] > best_weight && !self.is_constant_slot(slot) {
                    best = slot + 1
                    best_weight = self.def_weight[slot]
                }
                slot += 1
            }
            when best == 0 {
                return
            }
            chosen := best - 1
            mut register: u64 = 12
            mut placed: bool = false
            while register < 16 && !placed {
                mut free: bool = true
                other: u64 = 0
                mut scan: u64 = 0
                while scan < count && free {
                    when self.slot_reg[scan] == register && self.live_overlap(chosen, scan) {
                        free = false
                    }
                    scan += 1
                }
                when free {
                    placed = true
                } else {
                    register += 1
                }
            }
            when !placed {
                rejected.set(chosen, true)
            } else {
                self.slot_reg.set(chosen, register)
                mut saved: bool = false
                mut at: u64 = 0
                while at < self.saved_regs.len() {
                    when self.saved_regs[at] == register {
                        saved = true
                    }
                    at += 1
                }
                when !saved {
                    cell := self.scratch(1)
                    self.saved_regs.push(register)
                    self.saved_cells.push(cell)
                    asm.store(8, register, x64::Reg::RBP, slot_disp(cell))
                }
            }
        }
    }

    // Whether a local is a constant for the whole function: defined once, by a `let` of a constant, and written no other way.
    fun is_constant_slot(mut self, slot: u64) -> bool {
        when slot >= self.def_count.len() || self.def_count[slot] != 1 || self.def_bad[slot] {
            return false
        }
        return self.const_value(self.def_init[slot] - 1).is_some()
    }

    // The register that holds local `slot`, or 0.
    fun reg_of(self, slot: u64) -> u64 {
        when slot < self.slot_reg.len() && self.in_function && !self.inline_active {
            return self.slot_reg[slot]
        }
        return 0
    }

    // The register of the local that expression `index` reads, or 0 when it is not a local in a register.
    fun operand_reg(self, index: u64) -> u64 {
        when self.no_opt || self.slot_reg.len() == 0 {
            return 0
        }
        slot := choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => self.scalar_cell(slot, ty),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.field_cell(value, id, field),
            _ => Option::None,
        }
        when slot.is_none() {
            return 0
        }
        return self.reg_of(slot.unwrap())
    }

    fun scalar_cell(self, slot: u64, ty: u64) -> Option<u64> {
        when self.struct_of(ty).is_some() {
            return Option::None
        }
        return Option::Some(slot)
    }

    // The cell of a field of a structure local (not a field of anything else).
    fun field_cell(self, value: u64, id: u64, field: u64) -> Option<u64> {
        return choose self.program.exprs[value] {
            ir::IrExpr::LocalRef(slot, ty, span) => Option::Some(slot + self.program.structs[id].fields[field].slot_offset),
            _ => Option::None,
        }
    }

    // Reads the 8 bytes of cell `slot` into `dst`: from its register when it has one.
    fun load_slot(mut self, asm: &mut x64::Asm, dst: u64, slot: u64) {
        register := self.reg_of(slot)
        when register != 0 {
            asm.mov_rr(dst, register)
        } else {
            asm.load(8, false, dst, x64::Reg::RBP, slot_disp(slot))
        }
    }

    // Writes `size` bytes of `source` to the frame cell of local `slot`, unless the local lives in a register: nothing reads the
    // cell then, so it is not written (with RYN_REGPOISON it gets a marker, to prove that nothing reads it).
    fun write_cell(mut self, asm: &mut x64::Asm, size: u64, source: u64, slot: u64, held: u64) {
        when held != 0 {
            when self.poison {
                asm.mov_ri(x64::Reg::R10, 6510615555426900570)
                asm.store(8, x64::Reg::R10, x64::Reg::RBP, slot_disp(slot))
            }
            return
        }
        asm.store(size, source, x64::Reg::RBP, slot_disp(slot))
    }

    // Writes rax to the 8 bytes of cell `slot`, and to its register.
    fun store_slot(mut self, asm: &mut x64::Asm, slot: u64) {
        self.write_cell(asm, 8, x64::Reg::RAX, slot, self.reg_of(slot))
        register := self.reg_of(slot)
        when register != 0 {
            asm.mov_rr(register, x64::Reg::RAX)
        }
    }

    // The end of a function: the caller's registers are restored, and the frame is left.
    fun leave(mut self, asm: &mut x64::Asm) {
        mut at: u64 = 0
        while at < self.saved_regs.len() {
            asm.load(8, false, self.saved_regs[at], x64::Reg::RBP, slot_disp(self.saved_cells[at]))
            at += 1
        }
        asm.leave()
        asm.ret()
    }

    // Zeroes the `bytes` of the frame from rsp, using only rax, r10 and r11 (and rdi and rcx, saved around `rep stosb`): the
    // argument registers are live.
    fun zero_frame(mut self, asm: &mut x64::Asm, bytes: u64) {
        asm.mov_rr(x64::Reg::R10, x64::Reg::RSP)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.mov_ri(x64::Reg::R11, bytes)
        // A frame of at most 256 bytes is zeroed by a counted loop of qword stores: the fixed startup cost of `rep stosb`
        // dominates a frame of a few cells. A larger frame keeps `rep stosb`.
        done := asm.new_label()
        top := asm.new_label()
        wide := asm.new_label()
        when bytes > 256 {
            asm.jmp(wide)
        }
        when bytes == 0 {
            asm.jmp(done)
        }
        asm.bind(top)
        asm.store(8, x64::Reg::RAX, x64::Reg::R10, 0)
        asm.alu_ri(0, x64::Reg::R10, 8)
        asm.alu_ri(5, x64::Reg::R11, 8)
        asm.jcc(x64::Cc::NOT_EQUAL, top)
        asm.jmp(done)
        asm.bind(wide)
        asm.push(x64::Reg::RDI)
        asm.push(x64::Reg::RCX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::R10)
        asm.mov_rr(x64::Reg::RCX, x64::Reg::R11)
        asm.rep_stosb()
        asm.pop(x64::Reg::RCX)
        asm.pop(x64::Reg::RDI)
        asm.bind(done)
    }

    fun body(mut self, asm: &mut x64::Asm, statements: Vec<u64>) -> bool {
        for statement in statements {
            when !self.stmt(asm, statement) {
                return false
            }
            // Nothing after a `return`, `break` or `continue` of the same list runs.
            when !self.no_opt && self.leaves_the_list(statement) {
                return true
            }
        }
        return true
    }

    fun leaves_the_list(self, statement: u64) -> bool {
        return choose self.program.stmts[statement] {
            ir::IrStmt::ReturnStmt(value) => true,
            ir::IrStmt::BreakStmt => true,
            ir::IrStmt::ContinueStmt => true,
            _ => false,
        }
    }

    // The analysis of the locals of a function: how often each slot is defined, and which slots are written or addressed
    // some other way (a parameter, an assignment, a loop counter, a match binding, a move, a reference). Only a slot that
    // is defined by exactly one `let` and nothing else can be a constant.
    fun scan_definitions(mut self, statements: Vec<u64>, parameters: Vec<u64>, count: u64, addressed: Vec<Option<u64>>) {
        self.def_count = Vec()
        self.def_init = Vec()
        self.def_bad = Vec()
        self.def_addressed = Vec()
        self.def_reads = Vec()
        self.def_weight = Vec()
        self.def_seen = Vec()
        self.def_noreg = Vec()
        self.scan_depth = 0
        self.live_first = Vec()
        self.live_last = Vec()
        self.loop_starts = Vec()
        self.loop_ends = Vec()
        self.scan_pos = 0
        self.scan_whole = false
        self.bce_vec = Vec()
        self.bce_idx = Vec()
        self.bce_cut = Vec()
        self.bce_on = Vec()
        self.sroa_base = Vec()
        self.sroa_list = Vec()
        when self.no_opt {
            return
        }
        mut slot: u64 = 0
        while slot < count {
            self.def_count.push(0)
            self.def_init.push(0)
            self.def_reads.push(0)
            self.def_weight.push(0)
            self.live_first.push(18446744073709551615)
            self.live_last.push(0)
            self.def_seen.push(false)
            self.def_noreg.push(slot < addressed.len() && addressed[slot].is_some())
            self.def_addressed.push(slot < addressed.len() && addressed[slot].is_some())
            self.def_bad.push(slot < addressed.len() && addressed[slot].is_some())
            self.sroa_base.push(0)
            slot += 1
        }
        mut pair: u64 = 0
        while pair < parameters.len() / 2 {
            self.def_bad_slot(parameters[pair * 2])
            self.note_target(parameters[pair * 2], parameters[pair * 2 + 1])
            self.touch_whole(parameters[pair * 2])
            pair += 1
        }
        self.scan_statements(statements)
        self.sroa_settle()
        self.widen_over_loops()
    }

    fun def_bad_slot(mut self, slot: u64) {
        when slot < self.def_bad.len() {
            self.def_bad.set(slot, true)
        }
    }

    fun scan_statements(mut self, statements: Vec<u64>) -> bool {
        for statement in statements {
            self.scan_statement(statement)
        }
        return true
    }

    fun scan_statement(mut self, index: u64) -> bool {
        self.scan_pos += 1
        return choose self.program.stmts[index] {
            ir::IrStmt::BlockStmt(body) => self.scan_statements(body),
            ir::IrStmt::LetStmt(slot, ty, value, span) => self.scan_let(slot, ty, value),
            ir::IrStmt::AssignStmt(slot, ty, value, span) => self.scan_assign(slot, ty, value),
            ir::IrStmt::ArrayAssignStmt(slot, element, length, at, value, span) => self.scan_write(slot, at, value),
            ir::IrStmt::DereferenceAssignStmt(pointer, ty, value) => self.scan_two(pointer, value),
            ir::IrStmt::FieldAssignStmt(slot, ty, value) => self.scan_field_assign(slot, ty, value),
            ir::IrStmt::ReferenceFieldAssignStmt(pointer, id, field, ty, value) => self.scan_two(pointer, value),
            ir::IrStmt::PrintStmt(value, ty) => self.scan_expression(value),
            ir::IrStmt::PrintTemplateStmt(parts) => self.scan_parts(parts),
            ir::IrStmt::CallStmt(target, arguments) => self.scan_expressions(arguments),
            ir::IrStmt::IfStmt(condition, then_body, else_body) => self.scan_branches(condition, then_body, else_body),
            ir::IrStmt::WhileStmt(setup, condition, body) => self.scan_loop(condition, setup, body),
            ir::IrStmt::ForStmt(slot, end_slot, ty, start, end, inclusive, body) => self.scan_for(slot, end_slot, ty, start, end, body),
            ir::IrStmt::ReturnStmt(value) => self.scan_optional(value),
            _ => true,
        }
    }

    // A `let` of a structure whose fields are all scalars, built by a struct literal: each field is a local of its own, as long
    // as the structure is only ever read and assigned by field (`sroa_settle` checks that when the scan ends).
    fun sroa_candidate(self, ty: u64, value: u64) -> bool {
        id := self.struct_of(ty)
        when id.is_none() || self.has_destructor(ty) || self.program.structs[id.unwrap()].repr_c {
            return false
        }
        literal := choose self.program.exprs[value] {
            ir::IrExpr::StructValue(sid, fields, values) => sid == id.unwrap() && fields.len() == self.program.structs[sid].fields.len(),
            _ => false,
        }
        when !literal || self.program.structs[id.unwrap()].fields.len() == 0 || self.program.structs[id.unwrap()].fields.len() != self.program.structs[id.unwrap()].slot_count {
            return false
        }
        for field in self.program.structs[id.unwrap()].fields.clone() {
            when !self.plain_word(field.ty) || self.value_width(field.ty) > 8 || self.is_float(field.ty) {
                return false
            }
        }
        return true
    }

    fun scan_struct_let(mut self, slot: u64, ty: u64, value: u64) -> bool {
        id := self.struct_of(ty).unwrap()
        when slot + self.program.structs[id].slot_count > self.sroa_base.len() {
            self.no_register(slot, self.program.structs[id].slot_count)
            return self.scan_expression(value)
        }
        when self.sroa_base[slot] == 0 {
            self.sroa_list.push(slot)
            for field in self.program.structs[id].fields.clone() {
                self.sroa_base.set(slot + field.slot_offset, slot + 1)
            }
        }
        for field in self.program.structs[id].fields.clone() {
            self.note_target(slot + field.slot_offset, field.ty)
        }
        return self.scan_expression(value)
    }

    // The scan is over: a structure local that was read as a whole, addressed, or assigned whole keeps its cells in memory.
    fun sroa_settle(mut self) {
        for base in self.sroa_list.clone() {
            mut count: u64 = 0
            mut at: u64 = base
            while at < self.sroa_base.len() && self.sroa_base[at] == base + 1 {
                count += 1
                at += 1
            }
            mut whole: bool = true
            mut cell: u64 = base
            while cell < base + count {
                when self.def_noreg[cell] || self.def_addressed[cell] {
                    whole = false
                }
                cell += 1
            }
            when !whole {
                self.no_register(base, count)
            }
        }
    }

    // A read of field `field` of structure `id`: a field of a structure local that is replaced by scalars is read like a local.
    fun scan_field_read(mut self, value: u64, id: u64, field: u64) -> bool {
        base := choose self.program.exprs[value] {
            ir::IrExpr::LocalRef(slot, ty, span) => slot + 1,
            _ => 0,
        }
        when base != 0 && base - 1 < self.sroa_base.len() && self.sroa_base[base - 1] == base {
            return self.scan_read(base - 1 + self.program.structs[id].fields[field].slot_offset)
        }
        return self.scan_expression(value)
    }

    fun scan_let(mut self, slot: u64, ty: u64, value: u64) -> bool {
        when self.sroa_candidate(ty, value) {
            return self.scan_struct_let(slot, ty, value)
        }
        self.note_target(slot, ty)
        when slot < self.def_count.len() {
            self.def_count.set(slot, self.def_count[slot] + 1)
            self.def_init.set(slot, value + 1)
        }
        return self.scan_expression(value)
    }

    // `slot = value` for a field of a structure local that is replaced by scalars: a write of that local.
    fun scan_field_assign(mut self, slot: u64, ty: u64, value: u64) -> bool {
        when slot < self.sroa_base.len() && self.sroa_base[slot] != 0 {
            self.note_target(slot, ty)
            return self.scan_expression(value)
        }
        return self.scan_write(slot, value, value)
    }

    // A write of `slot`; `first` and `second` are the expressions it evaluates (the same one twice is scanned twice).
    fun scan_write(mut self, slot: u64, first: u64, second: u64) -> bool {
        self.def_bad_slot(slot)
        self.no_register(slot, 1)
        self.scan_expression(first)
        when second != first {
            self.scan_expression(second)
        }
        return true
    }

    fun scan_two(mut self, first: u64, second: u64) -> bool {
        self.scan_expression(first)
        return self.scan_expression(second)
    }

    fun scan_optional(mut self, value: Option<u64>) -> bool {
        when value.is_some() {
            return self.scan_expression(value.unwrap())
        }
        return true
    }

    fun scan_parts(mut self, parts: Vec<u64>) -> bool {
        for part in parts {
            value := choose self.program.parts[part] {
                ir::PrintPart::ValuePart(value, ty) => Option::Some(value),
                _ => Option::None,
            }
            self.scan_optional(value)
        }
        return true
    }

    // `condition` between two statement lists: an `if` (then, else) or a `while` (setup, body).
    fun scan_branches(mut self, condition: u64, first: Vec<u64>, second: Vec<u64>) -> bool {
        self.scan_expression(condition)
        self.scan_statements(first)
        return self.scan_statements(second)
    }

    // The function uses `slot` at the position the scan has reached.
    fun touch(mut self, slot: u64) {
        when slot >= self.live_first.len() {
            return
        }
        self.scan_pos += 1
        when self.scan_whole {
            self.touch_whole(slot)
            return
        }
        when self.live_first[slot] == 18446744073709551615 {
            self.live_first.set(slot, self.scan_pos)
        }
        self.live_last.set(slot, self.scan_pos)
    }

    // `slot` is live in the whole function: a parameter (which a tail call stores again), or a local that a deferred statement
    // uses, which runs when the function ends.
    fun touch_whole(mut self, slot: u64) {
        when slot < self.live_first.len() {
            self.live_first.set(slot, 0)
            self.live_last.set(slot, 18446744073709551615)
        }
    }

    // A local that is defined before a loop and used in it lives to the end of the loop, whichever iteration reads it.
    fun widen_over_loops(mut self) {
        mut changed: bool = true
        while changed {
            changed = false
            mut at: u64 = 0
            while at < self.loop_starts.len() {
                start := self.loop_starts[at]
                end := self.loop_ends[at]
                mut slot: u64 = 0
                while slot < self.live_first.len() {
                    when self.live_first[slot] < start && self.live_last[slot] >= start && self.live_last[slot] < end {
                        self.live_last.set(slot, end)
                        changed = true
                    }
                    slot += 1
                }
                at += 1
            }
        }
    }

    // Whether the ranges of two locals share a position.
    fun live_overlap(self, a: u64, b: u64) -> bool {
        return self.live_first[a] <= self.live_last[b] && self.live_first[b] <= self.live_last[a]
    }

    fun scan_for(mut self, slot: u64, end_slot: u64, ty: u64, start: u64, end: u64, body: Vec<u64>) -> bool {
        self.def_bad_slot(slot)
        self.def_bad_slot(end_slot)
        loop_start := self.scan_pos
        self.scan_two(start, end)
        self.scan_depth += 1
        // The counter and the bound are read, and the counter written, in every iteration.
        self.note_target(slot, ty)
        self.note_target(slot, ty)
        self.note_target(end_slot, ty)
        self.scan_statements(body)
        self.scan_depth -= 1
        // The counter and the bound live to the end of the loop.
        self.touch(slot)
        self.touch(end_slot)
        self.loop_starts.push(loop_start)
        self.loop_ends.push(self.scan_pos)
        return true
    }

    fun scan_assign(mut self, slot: u64, ty: u64, value: u64) -> bool {
        self.note_target(slot, ty)
        return self.scan_write_value(slot, value)
    }

    fun scan_write_value(mut self, slot: u64, value: u64) -> bool {
        self.def_bad_slot(slot)
        return self.scan_expression(value)
    }

    // A `while`: its condition, setup and body run once per iteration.
    fun scan_loop(mut self, condition: u64, setup: Vec<u64>, body: Vec<u64>) -> bool {
        loop_start := self.scan_pos
        self.scan_depth += 1
        self.scan_expression(condition)
        self.scan_statements(setup)
        self.scan_statements(body)
        self.scan_depth -= 1
        self.loop_starts.push(loop_start)
        self.loop_ends.push(self.scan_pos)
        return true
    }

    // How much one use of a local weighs: 1 outside a loop, 8 inside one, 64 inside two (and no more than that).
    fun use_weight(self) -> u64 {
        mut weight: u64 = 1
        mut level: u64 = 0
        while level < self.scan_depth && level < 3 {
            weight = weight * 8
            level += 1
        }
        return weight
    }

    // `slot` is the target of a `let`, an assignment, a loop or a parameter of type `ty`. A scalar target is a candidate for
    // a register; any other type takes its cells (the cells of a structure are written by field, not as a scalar).
    fun note_target(mut self, slot: u64, ty: u64) {
        when slot >= self.def_noreg.len() {
            return
        }
        when self.plain_word(ty) && self.value_width(ty) <= 8 && !self.is_float(ty) {
            self.def_seen.set(slot, true)
            self.def_weight.set(slot, self.def_weight[slot] + self.use_weight())
            self.touch(slot)
        } else {
            mut cells := self.cells_of(ty)
            when cells == 0 {
                cells = 1
            }
            self.no_register(slot, cells)
        }
    }

    fun no_register(mut self, slot: u64, cells: u64) {
        mut at: u64 = 0
        while at < cells {
            when slot + at < self.def_noreg.len() {
                self.def_noreg.set(slot + at, true)
            }
            at += 1
        }
    }

    fun scan_expressions(mut self, values: Vec<u64>) -> bool {
        for value in values {
            self.scan_expression(value)
        }
        return true
    }

    fun scan_expression(mut self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => self.scan_local(slot, ty),
            ir::IrExpr::MoveRef(slot, ty) => self.scan_address(slot),
            ir::IrExpr::AddressOf(slot, ty, pointer_type, span) => self.scan_address(slot),
            ir::IrExpr::StructValue(id, fields, values) => self.scan_expressions(values),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.scan_field_read(value, id, field),
            ir::IrExpr::ReferenceFieldRead(value, id, field, ty, span, borrowed) => self.scan_expression(value),
            ir::IrExpr::ValueAddress(value, ty, pointer_type, span) => self.scan_place(value),
            ir::IrExpr::CallExpr(target, arguments, ty) => self.scan_expressions(arguments),
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => self.scan_three(condition, then_value, else_value),
            ir::IrExpr::EnumMatch(value, id, arms, ty) => self.scan_match(value, arms),
            ir::IrExpr::Propagate(value, input, output, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred) => self.scan_propagate(value, deferred),
            ir::IrExpr::ArrayValue(items) => self.scan_expressions(items),
            ir::IrExpr::ArrayRepeat(value, length) => self.scan_expression(value),
            ir::IrExpr::ArrayAsSlice(value, slice, length) => self.scan_expression(value),
            ir::IrExpr::ArrayIndex(array, at, ty, length) => self.scan_two(array, at),
            ir::IrExpr::SliceIndex(slice, at, ty) => self.scan_two(slice, at),
            ir::IrExpr::SliceElementAddress(slice, at, ty, span) => self.scan_two(slice, at),
            ir::IrExpr::PlaceAddress(place, ty) => self.scan_place(place),
            ir::IrExpr::Dereference(pointer, ty) => self.scan_expression(pointer),
            ir::IrExpr::StringFindOption(value, id) => self.scan_expression(value),
            ir::IrExpr::StringAsStr(value) => self.scan_expression(value),
            ir::IrExpr::Binary(op, left, right, ty) => self.scan_two(left, right),
            ir::IrExpr::Negate(value, ty) => self.scan_expression(value),
            ir::IrExpr::Not(value) => self.scan_expression(value),
            ir::IrExpr::BitNot(value, ty) => self.scan_expression(value),
            ir::IrExpr::FfiArray(array, element, length, index, mutable) => self.scan_two(array, index),
            ir::IrExpr::CastExpr(value, source, target) => self.scan_expression(value),
            _ => true,
        }
    }

    // A local read as a value. A structure local that is replaced by scalars is read by field only: this is a whole read.
    fun scan_local(mut self, slot: u64, ty: u64) -> bool {
        when slot < self.sroa_base.len() && self.sroa_base[slot] == slot + 1 && self.struct_of(ty).is_some() {
            self.def_addressed.set(slot, true)
        }
        return self.scan_read(slot)
    }

    fun scan_read(mut self, slot: u64) -> bool {
        when slot < self.def_reads.len() {
            self.def_reads.set(slot, self.def_reads[slot] + 1)
            self.def_weight.set(slot, self.def_weight[slot] + self.use_weight())
            self.touch(slot)
        }
        return true
    }

    // A `let` of a scalar that nothing reads, whose value cannot fail or have an effect: it is not generated.
    fun dead_let(mut self, slot: u64, ty: u64, value: u64) -> bool {
        when self.no_opt || self.inline_active || slot >= self.def_count.len() {
            return false
        }
        when self.def_count[slot] != 1 || self.def_bad[slot] || self.def_reads[slot] != 0 {
            return false
        }
        word := self.word(ty)
        when !is_integer_word(word.clone()) && word != "Bool" && word != "Char" {
            return false
        }
        return self.cannot_fail(value)
    }

    // An integer, bool or char expression of constants and locals, with no division, call or memory access.
    fun cannot_fail(mut self, index: u64) -> bool {
        when self.const_value(index).is_some() {
            return true
        }
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => self.is_stable_local(slot, ty),
            ir::IrExpr::Binary(op, left, right, ty) => (op != "Div" && op != "Rem" || self.nonzero_constant(right)) && self.plain_word(ty) && self.cannot_fail(left) && self.cannot_fail(right),
            ir::IrExpr::Negate(value, ty) => self.plain_word(ty) && self.cannot_fail(value),
            ir::IrExpr::Not(value) => self.cannot_fail(value),
            ir::IrExpr::BitNot(value, ty) => self.plain_word(ty) && self.cannot_fail(value),
            _ => false,
        }
    }

    // Whether an expression is a constant other than zero: dividing by it cannot fail.
    fun nonzero_constant(mut self, index: u64) -> bool {
        known := self.const_value(index)
        return known.is_some() && known.unwrap() != 0
    }

    fun plain_word(self, ty: u64) -> bool {
        word := self.word(ty)
        return is_integer_word(word.clone()) || word == "Bool" || word == "Char"
    }

    // An expression whose address is taken: a field of a structure local that is replaced by scalars keeps its cell then.
    fun scan_place(mut self, place: u64) -> bool {
        base := choose self.program.exprs[place] {
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.bce_slot_of(value),
            _ => 0,
        }
        when base != 0 && base - 1 < self.sroa_base.len() && self.sroa_base[base - 1] == base {
            self.no_register(base - 1, 1)
            self.def_noreg.set(base - 1, true)
        }
        return self.scan_expression(place)
    }

    fun scan_address(mut self, slot: u64) -> bool {
        self.def_bad_slot(slot)
        self.no_register(slot, 1)
        return true
    }

    fun scan_three(mut self, first: u64, second: u64, third: u64) -> bool {
        self.scan_expression(first)
        return self.scan_two(second, third)
    }

    fun scan_propagate(mut self, value: u64, deferred: Vec<u64>) -> bool {
        self.scan_expression(value)
        // A deferred statement runs when the function ends, wherever it is written.
        was := self.scan_whole
        self.scan_whole = true
        self.scan_statements(deferred)
        self.scan_whole = was
        return true
    }

    // The arms of a `choose`: the slots it binds are written by it.
    fun scan_match(mut self, value: u64, arms: Vec<u64>) -> bool {
        self.scan_expression(value)
        for arm in arms {
            mut at: u64 = 0
            while at < self.program.arms[arm].bindings.len() {
                self.def_bad_slot(self.program.arms[arm].bindings[at])
                self.no_register(self.program.arms[arm].bindings[at], 1)
                at += 3
            }
            self.scan_expression(self.program.arms[arm].body)
        }
        return true
    }

    // The constant a local holds: it is defined once, by a `let` of a constant, and written no other way.
    fun const_local(mut self, slot: u64, ty: u64) -> Option<u64> {
        when self.inline_active || slot >= self.def_count.len() {
            return Option::None
        }
        when self.def_count[slot] != 1 || self.def_bad[slot] {
            return Option::None
        }
        word := self.word(ty)
        when !is_integer_word(word.clone()) && word != "Bool" && word != "Char" {
            return Option::None
        }
        return self.const_value(self.def_init[slot] - 1)
    }

    fun stmt(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        ok := self.stmt_inner(asm, index)
        self.bce_retire(index)
        return ok
    }

    fun stmt_inner(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        self.note_statement(index)
        return choose self.program.stmts[index] {
            ir::IrStmt::BlockStmt(body) => self.body(asm, body),
            ir::IrStmt::DropStmt(slots, types) => self.drops(asm, slots, types),
            ir::IrStmt::LetStmt(slot, ty, value, span) => self.let_statement(asm, value, self.stmt_slot(slot), ty),
            ir::IrStmt::AssignStmt(slot, ty, value, span) => self.assign_value(asm, value, self.stmt_slot(slot), ty),
            ir::IrStmt::PrintStmt(value, ty) => self.echo_statement(asm, value, ty),
            ir::IrStmt::PrintTemplateStmt(parts) => self.template(asm, parts),
            ir::IrStmt::CallStmt(target, arguments) => self.call_statement(asm, target, arguments),
            ir::IrStmt::IfStmt(condition, then_body, else_body) => self.if_statement(asm, condition, then_body, else_body),
            ir::IrStmt::WhileStmt(setup, condition, body) => self.while_statement(asm, setup, condition, body),
            ir::IrStmt::ForStmt(slot, end_slot, ty, start, end, inclusive, body) => self.for_statement(asm, slot, end_slot, ty, start, end, inclusive, body),
            ir::IrStmt::BreakStmt => self.jump_to(asm, true),
            ir::IrStmt::ContinueStmt => self.jump_to(asm, false),
            ir::IrStmt::ReturnStmt(value) => self.return_statement(asm, value),
            ir::IrStmt::FieldAssignStmt(slot, ty, value) => self.field_assign(asm, value, slot, ty),
            ir::IrStmt::ArrayAssignStmt(slot, element, length, index, value, span) => self.array_assign_statement(asm, slot, element, length, index, value),
            ir::IrStmt::DereferenceAssignStmt(pointer, ty, value) => self.dereference_statement(asm, value, pointer, ty),
            ir::IrStmt::ReferenceFieldAssignStmt(pointer, id, field, ty, value) => self.reference_field_statement(asm, value, pointer, id, field, ty),
            _ => self.fail("a statement of this kind"),
        }
    }

    fun let_statement(mut self, asm: &mut x64::Asm, value: u64, slot: u64, ty: u64) -> bool {
        when self.dead_let(slot, ty, value) {
            return true
        }
        return self.store_into(asm, value, slot, ty)
    }

    // A store of an element of a local array: a `repr(C)` copy that a pointer reaches is repacked after it.
    fun array_assign_statement(mut self, asm: &mut x64::Asm, slot: u64, element: u64, length: u64, index: u64, value: u64) -> bool {
        when !self.array_assign(asm, slot, element, length, index, value) {
            return false
        }
        self.repack_shadows_at(asm, slot)
        return true
    }

    // A store through a pointer, and then the `repr(C)` copies are read back: a local whose copy the pointer reaches shows
    // what was stored.
    fun dereference_statement(mut self, asm: &mut x64::Asm, value: u64, pointer: u64, ty: u64) -> bool {
        when !self.store_through(asm, value, pointer, 0, ty) {
            return false
        }
        self.read_back_shadows(asm)
        return true
    }

    fun reference_field_statement(mut self, asm: &mut x64::Asm, value: u64, pointer: u64, id: u64, field: u64, ty: u64) -> bool {
        when !self.store_field_through(asm, value, pointer, id, field, ty) {
            return false
        }
        self.read_back_shadows(asm)
        return true
    }

    fun read_back_shadows(mut self, asm: &mut x64::Asm) {
        when self.shadow_slots.len() > 0 {
            self.sync_shadows(asm, true)
        }
    }

    // The owners that a scope ends with: a destructor value is dropped, and an owned value that is not a destructor must
    // leak, since nothing else frees it.
    // The roots of the arrays of a body: its `let`s with an array in their type, at any depth of its blocks.
    fun collect_regions(mut self, body: Vec<u64>) {
        for index in body {
            let_slot := choose self.program.stmts[index] {
                ir::IrStmt::LetStmt(slot, ty, value, span) => Option::Some(slot),
                _ => Option::None,
            }
            when let_slot.is_some() {
                let_type := choose self.program.stmts[index] {
                    ir::IrStmt::LetStmt(slot, ty, value, span) => ty,
                    _ => 0,
                }
                when self.contains_array(let_type) {
                    self.regions_base.push(let_slot.unwrap())
                    self.regions_type.push(let_type)
                }
            }
            first := choose self.program.stmts[index] {
                ir::IrStmt::BlockStmt(inner) => inner.clone(),
                ir::IrStmt::IfStmt(condition, then_body, else_body) => then_body.clone(),
                ir::IrStmt::WhileStmt(setup, condition, inner) => setup.clone(),
                ir::IrStmt::ForStmt(slot, end_slot, ty, start, end, inclusive, inner) => inner.clone(),
                _ => Vec(),
            }
            second := choose self.program.stmts[index] {
                ir::IrStmt::IfStmt(condition, then_body, else_body) => else_body.clone(),
                ir::IrStmt::WhileStmt(setup, condition, inner) => inner.clone(),
                _ => Vec(),
            }
            self.collect_regions(first)
            self.collect_regions(second)
        }
    }

    // Whether a value of `ty` holds an array: an array, or a structure with one in a field, at any depth.
    fun contains_array(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::ArrayOf(element, length) => true,
            ir::IrTy::StructTy(id) => self.struct_holds_array(id),
            _ => false,
        }
    }

    fun struct_holds_array(self, id: u64) -> bool {
        mut field: u64 = 0
        while field < self.program.structs[id].fields.len() {
            when self.contains_array(self.program.structs[id].fields[field].ty) {
                return true
            }
            field += 1
        }
        return false
    }

    // The cell of a value of `ty` at IR offset `offset`, in gen's frame. The IR numbers an array's cells ascending, element `i` at
    // `i * width`; gen keeps the elements ascending in memory, element `i` at `(length - 1 - i) * width`. Structure fields keep
    // their offsets, and a field that holds an array is mapped inside it.
    fun phys_in(self, ty: u64, offset: u64) -> u64 {
        when !self.contains_array(ty) {
            return offset
        }
        return choose self.program.types[ty] {
            ir::IrTy::ArrayOf(element, length) => self.array_phys(element, length, offset),
            ir::IrTy::StructTy(id) => self.struct_phys(id, offset),
            _ => offset,
        }
    }

    fun array_phys(self, element: u64, length: u64, offset: u64) -> u64 {
        width := self.cells_of(element)
        when width == 0 {
            return offset
        }
        index := offset / width
        return (length - 1 - index) * width + self.phys_in(element, offset % width)
    }

    fun struct_phys(self, id: u64, offset: u64) -> u64 {
        mut field: u64 = 0
        while field < self.program.structs[id].fields.len() {
            start := self.program.structs[id].fields[field].slot_offset
            ty := self.program.structs[id].fields[field].ty
            when offset >= start && offset < start + self.cells_of(ty) {
                return start + self.phys_in(ty, offset - start)
            }
            field += 1
        }
        return offset
    }

    // The frame cell of IR cell `slot`: the cell of the root that holds it, mapped by `phys_in`, or the cell itself.
    fun phys_slot(self, slot: u64) -> u64 {
        mut at: u64 = 0
        while at < self.regions_base.len() {
            base := self.regions_base[at]
            ty := self.regions_type[at]
            when slot >= base && slot < base + self.cells_of(ty) {
                return base + self.phys_in(ty, slot - base)
            }
            at += 1
        }
        return slot
    }

    fun drops(mut self, asm: &mut x64::Asm, slots: Vec<u64>, types: Vec<u64>) -> bool {
        mut position: u64 = 0
        while position < types.len() {
            when !self.needs_drop(types[position]) && !self.is_leakable(types[position]) {
                return self.fail("a drop")
            }
            when self.needs_drop(types[position]) {
                self.drop_slot(asm, self.phys_slot(slots[position]), types[position])
            }
            position += 1
        }
        return true
    }

    // Drops the destructor owners of the function, the last slot first, as a return does.
    fun drop_owners(mut self, asm: &mut x64::Asm) {
        mut at: u64 = self.owner_slots.len()
        while at > 0 {
            at -= 1
            self.drop_slot(asm, self.owner_slots[at], self.owner_types[at])
        }
    }

    // Drops the value of type `ty` at `slot`, and clears its owners.
    fun drop_value(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) {
        self.drop_slot(asm, slot, ty)
    }

    // Whether a value of type `ty` holds a destructor, which its owner drops.
    fun has_destructor(self, ty: u64) -> bool {
        when self.glue_function(ty).is_some() {
            return true
        }
        structure := choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => Option::Some(id),
            _ => Option::None,
        }
        when structure.is_none() {
            return false
        }
        id := structure.unwrap()
        when self.program.structs[id].drop_function.is_some() {
            return true
        }
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            when self.has_destructor(self.program.structs[id].fields[position].ty) {
                return true
            }
            position += 1
        }
        return false
    }

    // `x = value` for a value that holds a destructor: the new value is built, the old value is dropped, and then the
    // cells of the local are replaced.
    // A value stored into a local: a `repr(C)` local whose address was given out keeps its copy in C's layout, which the
    // store brings up to date.
    fun assign_value(mut self, asm: &mut x64::Asm, value: u64, slot: u64, ty: u64) -> bool {
        updated := self.register_update(asm, value, slot, ty)
        when updated.is_some() {
            return updated.unwrap()
        }
        when !self.assign_value_cells(asm, value, slot, ty) {
            return false
        }
        self.repack_shadows_at(asm, slot)
        return true
    }

    // `x = x op y` for a 64-bit integer local in a register: the operation is done on the register, with no copy through
    // rax. `None` when the assignment is not of that form.
    fun register_update(mut self, asm: &mut x64::Asm, value: u64, slot: u64, ty: u64) -> Option<bool> {
        target := self.reg_of(slot)
        when self.no_opt || target == 0 || self.value_width(ty) != 8 || !is_integer_word(self.word(ty)) {
            return Option::None
        }
        op := choose self.program.exprs[value] {
            ir::IrExpr::Binary(op, left, right, bty) => op,
            _ => String(""),
        }
        when op != "Add" && op != "Sub" && op != "Mul" && op != "BitAnd" && op != "BitOr" && op != "BitXor" && op != "Div" && op != "ShiftLeft" && op != "ShiftRight" {
            return Option::None
        }
        left := choose self.program.exprs[value] {
            ir::IrExpr::Binary(op, left, right, bty) => left,
            _ => 0,
        }
        right := choose self.program.exprs[value] {
            ir::IrExpr::Binary(op, left, right, bty) => right,
            _ => 0,
        }
        when self.operand_reg(left) != target {
            return Option::None
        }
        // A constant power of two or shift count: one shift of the register.
        known := self.const_value(right)
        when op == "Div" || op == "ShiftLeft" || op == "ShiftRight" || (op == "Mul" && known.is_some()) {
            when known.is_none() {
                return Option::None
            }
            amount := known.unwrap()
            signed := is_signed_word(self.word(ty))
            mut count: u64 = amount
            when op == "Div" || op == "Mul" {
                when amount < 2 || (amount & (amount - 1)) != 0 || (op == "Div" && signed) {
                    return Option::None
                }
                count = 0
                mut rest: u64 = amount
                while rest > 1 {
                    rest = rest / 2
                    count += 1
                }
            }
            when count == 0 || count > 62 {
                return Option::None
            }
            mut extension: u64 = 4
            when op == "Div" || op == "ShiftRight" {
                extension = 5
                when signed && op == "ShiftRight" {
                    extension = 7
                }
            }
            asm.shift_ri(extension, target, count)
            return Option::Some(true)
        }
        immediate := self.immediate_operand(op.clone(), right)
        when immediate.is_some() && op != "Mul" {
            mut extension: u64 = 0
            when op == "Sub" {
                extension = 5
            } else when op == "BitAnd" {
                extension = 4
            } else when op == "BitOr" {
                extension = 1
            } else when op == "BitXor" {
                extension = 6
            }
            asm.alu_ri(extension, target, immediate.unwrap() as i64)
            return Option::Some(true)
        }
        mut source: u64 = self.operand_reg(right)
        when source == 0 {
            when self.is_stable_operand(right) {
                self.load_stable_operand(asm, right, x64::Reg::RCX)
                source = x64::Reg::RCX
            } else {
                when !self.expr(asm, right) {
                    return Option::Some(false)
                }
                source = x64::Reg::RAX
            }
        }
        when op == "Add" {
            asm.alu_rr(1, target, source)
        } else when op == "Sub" {
            asm.alu_rr(41, target, source)
        } else when op == "Mul" {
            asm.imul_rr(target, source)
        } else when op == "BitAnd" {
            asm.alu_rr(33, target, source)
        } else when op == "BitOr" {
            asm.alu_rr(9, target, source)
        } else {
            asm.alu_rr(49, target, source)
        }
        return Option::Some(true)
    }

    // Packs the copy of each `repr(C)` local that holds `slot`, from the cells of the local.
    fun repack_shadows_at(mut self, asm: &mut x64::Asm, slot: u64) {
        mut at: u64 = 0
        while at < self.shadow_slots.len() {
            base := self.shadow_slots[at]
            count := self.program.structs[self.shadow_ids[at]].slot_count
            when slot >= base && slot < base + count {
                self.sync_shadow(asm, at, false)
            }
            at += 1
        }
    }

    fun assign_value_cells(mut self, asm: &mut x64::Asm, value: u64, slot: u64, ty: u64) -> bool {
        when !self.has_owners(ty) {
            return self.store_into(asm, value, slot, ty)
        }
        when !self.push_value(asm, value, ty) {
            return false
        }
        self.drop_value(asm, slot, ty)
        count := self.cells_of(ty)
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot + cell))
            cell += 1
        }
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    // A field assignment of a destructor is not in the subset: the old field would need its drop as well.
    fun field_assign(mut self, asm: &mut x64::Asm, value: u64, slot: u64, ty: u64) -> bool {
        return self.assign_value(asm, value, slot, ty)
    }

    // The destructor of a structure type, when it has one.
    // A structure that holds a destructor, its own or one of its fields'. A vector or a map of these drops each value with
    // its value drop, which runs every destructor the value owns.
    fun destructor_element(self, ty: u64) -> bool {
        return self.struct_of(ty).is_some() && self.has_destructor(ty)
    }

    fun destructor_of(self, ty: u64) -> Option<u64> {
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.program.structs[id].drop_function,
            _ => Option::None,
        }
    }

    // Whether a value of type `ty` owns storage that is freed when its owner ends: a String, a vector, a map, a set, an enum
    // (always a box), or a structure with a destructor, whose destructor releases the rest of it.
    fun is_owner_type(self, ty: u64) -> bool {
        when self.is_string(ty) {
            return true
        }
        return choose self.program.types[ty] {
            ir::IrTy::VecOf(element) => true,
            ir::IrTy::MapOf(key, value) => true,
            ir::IrTy::SetOf(key, value) => true,
            ir::IrTy::EnumTy(id) => true,
            ir::IrTy::StructTy(id) => self.program.structs[id].drop_function.is_some(),
            _ => false,
        }
    }

    // The owners in a value of type `ty`, as pairs of (cell offset, owner type), in ascending cell order. A structure without a
    // destructor owns what its fields own; a structure with one is a single owner at cell 0.
    fun owner_pairs(self, ty: u64) -> Vec<u64> {
        mut pairs: Vec<u64> = Vec()
        when self.is_owner_type(ty) {
            pairs.push(0)
            pairs.push(ty)
            return pairs
        }
        array_element := choose self.program.types[ty] {
            ir::IrTy::ArrayOf(element, length) => Option::Some(element),
            _ => Option::None,
        }
        when array_element.is_some() {
            // Every element has the same owners at the same offsets, so the pairs of all elements are listed in cell order.
            count := self.array_length_of(ty)
            cells := self.cells_of(array_element.unwrap())
            inner := self.owner_pairs(array_element.unwrap())
            when inner.len() == 0 {
                return pairs
            }
            mut index: u64 = 0
            while index < count {
                mut at: u64 = 0
                while at < inner.len() {
                    pairs.push((count - 1 - index) * cells + inner[at])
                    pairs.push(inner[at + 1])
                    at += 2
                }
                index += 1
            }
            return pairs
        }
        structure := choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => Option::Some(id),
            _ => Option::None,
        }
        when structure.is_none() {
            return pairs
        }
        id := structure.unwrap()
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            field_ty := self.program.structs[id].fields[position].ty
            offset := self.program.structs[id].fields[position].slot_offset
            inner := self.owner_pairs(field_ty)
            mut at: u64 = 0
            while at < inner.len() {
                pairs.push(offset + inner[at])
                pairs.push(inner[at + 1])
                at += 2
            }
            position += 1
        }
        return pairs
    }

    // The type id of the structure `id`, found in the type table.
    fun struct_type(self, id: u64) -> u64 {
        found := self.struct_types.get(id)
        when found.is_some() {
            return found.unwrap()
        }
        return 0
    }

    // A move leaves the owners of the moved value null, so that the drop at the end of its owner's scope does nothing for them.
    fun null_owners(self, asm: &mut x64::Asm, slot: u64, ty: u64) {
        pairs := self.owner_pairs(ty)
        mut at: u64 = 0
        while at < pairs.len() {
            asm.mov_ri(x64::Reg::R11, 0)
            asm.store(8, x64::Reg::R11, x64::Reg::RBP, slot_disp(slot + pairs[at]))
            at += 2
        }
    }

    // The label of the routine that drops the value of type `ty` at the address in rdi: its owners are dropped and their cells
    // cleared, the last first.
    fun value_drop_routine(mut self, asm: &mut x64::Asm, ty: u64, ascending: bool) -> u64 {
        mut key: u64 = ty * 2
        when ascending {
            key += 1
        }
        found := self.drop_value_index.get(key)
        when found.is_some() {
            return self.drop_value_labels[found.unwrap()]
        }
        label := asm.new_label()
        self.drop_value_index.insert(key, self.drop_value_ids.len())
        self.drop_value_ids.push(ty)
        self.drop_value_labels.push(label)
        self.drop_value_ascending.push(ascending)
        return label
    }

    // The displacement from the address of cell 0 to cell `cell` of a value: cells rise in memory when `ascending`, and fall
    // otherwise (as the cells of a local do).
    fun cell_disp(self, ascending: bool, cell: u64) -> i64 {
        mut disp: i64 = (8 * cell) as i64
        when !ascending {
            disp = 0 - disp
        }
        return disp
    }

    // The label of the routine that frees a handle of type `ty` (a String, vector, map, set or enum box) in rdi, with what it
    // owns. The owner of the handle clears its cell.
    fun handle_drop_routine(mut self, asm: &mut x64::Asm, ty: u64) -> u64 {
        found := self.drop_handle_index.get(ty)
        when found.is_some() {
            return self.drop_handle_labels[found.unwrap()]
        }
        label := asm.new_label()
        self.drop_handle_index.insert(ty, self.drop_handle_ids.len())
        self.drop_handle_ids.push(ty)
        self.drop_handle_labels.push(label)
        return label
    }

    // Drops the value of type `ty` in the cells from `slot` on, when it owns something.
    fun drop_slot(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) {
        when !self.has_owners(ty) {
            return
        }
        label := self.value_drop_routine(asm, ty, false)
        asm.lea(x64::Reg::RDI, x64::Reg::RBP, slot_disp(slot))
        asm.call_label(label)
    }

    // The body of a value drop routine: the owners of the value at the address in rdi are dropped, the last first.
    fun emit_value_drop(mut self, asm: &mut x64::Asm, ty: u64, ascending: bool) -> bool {
        pairs := self.owner_pairs(ty)
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 16)
        asm.store(8, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        mut at: u64 = pairs.len()
        while at > 0 {
            at -= 2
            offset := pairs[at]
            owner := pairs[at + 1]
            skip := asm.new_label()
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 8)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, self.cell_disp(ascending, offset))
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::EQUAL, skip)
            when self.destructor_of(owner).is_some() {
                // The destructor takes every cell of the structure, the first pushed first, and releases the rest itself.
                fid := self.destructor_of(owner).unwrap()
                self.needed.set(fid, true)
                count := self.cells_of(owner)
                mut cell: u64 = 0
                while cell < count {
                    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 8)
                    asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, self.cell_disp(ascending, offset + cell))
                    asm.push(x64::Reg::RCX)
                    cell += 1
                }
                asm.call_label(self.labels[fid])
                asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
            }
            when self.destructor_of(owner).is_none() {
                asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
                label := self.handle_drop_routine(asm, owner)
                asm.call_label(label)
            }
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 8)
            asm.mov_ri(x64::Reg::RCX, 0)
            asm.store(8, x64::Reg::RCX, x64::Reg::RDX, self.cell_disp(ascending, offset))
            asm.bind(skip)
        }
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
        return true
    }

    // The body of a handle routine: the handle in rdi is freed with what it owns, by its kind.
    fun emit_handle_drop(mut self, asm: &mut x64::Asm, ty: u64) -> bool {
        when self.is_string(ty) {
            asm.push(x64::Reg::RBP)
            asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
            asm.alu_ri(5, x64::Reg::RSP, 16)
            asm.store(8, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 0)
            self.aligned_call(asm, String("free"))
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
            self.aligned_call(asm, String("free"))
            asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
            asm.pop(x64::Reg::RBP)
            asm.ret()
            return true
        }
        return choose self.program.types[ty] {
            ir::IrTy::VecOf(element) => self.emit_vec_free(asm, element),
            ir::IrTy::MapOf(key, value) => self.emit_map_free(asm, key, value, true),
            ir::IrTy::SetOf(key, value) => self.emit_map_free(asm, key, value, true),
            ir::IrTy::EnumTy(id) => self.emit_enum_free(asm, id),
            _ => self.fail("a handle of this kind"),
        }
    }

    // A vector's handle: {data, len, capacity}. Its elements are dropped last first, then the data and the header are freed.
    fun emit_vec_free(mut self, asm: &mut x64::Asm, element: u64) -> bool {
        cells := self.cells_of(element)
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 32)
        asm.store(8, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        when self.has_owners(element) {
            top := asm.new_label()
            done := asm.new_label()
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RDI, 8)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            asm.bind(top)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 16)
            asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
            asm.jcc(x64::Cc::EQUAL, done)
            asm.alu_ri(5, x64::Reg::RCX, 1)
            asm.store(8, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 16)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 8)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RDX, 0)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RCX)
            self.scale_bytes(asm, x64::Reg::RDI, 8 * cells)
            asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RDX)
            asm.alu_ri(0, x64::Reg::RDI, (8 * (cells - 1)) as i64)
            label := self.value_drop_routine(asm, element, false)
            asm.call_label(label)
            asm.jmp(top)
            asm.bind(done)
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 0)
        self.aligned_call(asm, String("free"))
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        self.aligned_call(asm, String("free"))
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
        return true
    }

    // A map's handle: {buckets, bucket count, length, ...}, and each bucket a chain of nodes {next, hash, key, value}. Every node's
    // owned key and value are dropped, then the node is freed; then the buckets and the header.
    fun emit_map_free(mut self, asm: &mut x64::Asm, key: u64, value: u64, header: bool) -> bool {
        keys := self.has_owners(key) || self.struct_key_ok(key)
        values := self.has_owners(value) && !self.map_value_boxed(value)
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 48)
        asm.store(8, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        asm.mov_ri(x64::Reg::RAX, 40)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
        bucket_top := asm.new_label()
        buckets_done := asm.new_label()
        next_bucket := asm.new_label()
        // The entries are dropped in order: the dense array at [header + 32], from byte offset 40 to len * 40.
        asm.bind(bucket_top)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 16)
        asm.mov_ri(x64::Reg::R11, 40)
        asm.imul_rr(x64::Reg::RCX, x64::Reg::R11)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE, buckets_done)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 32)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 24)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        when keys {
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.alu_ri(0, x64::Reg::RDI, 16)
            when self.struct_key_ok(key) {
                asm.call_label(self.struct_key_drop)
            } else {
                label := self.value_drop_routine(asm, key, false)
                asm.call_label(label)
            }
        }
        when values {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 24)
            asm.alu_ri(0, x64::Reg::RDI, 24)
            label := self.value_drop_routine(asm, value, false)
            asm.call_label(label)
        }
        // A boxed value's owners are dropped where its box lies, the first cell at the box's top.
        when self.map_value_boxed(value) && self.has_owners(value) {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 24)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 24)
            value_cells := self.cells_of(value)
            asm.alu_ri(0, x64::Reg::RDI, (8 * (value_cells - 1)) as i64)
            asm.call_label(self.value_drop_routine(asm, value, false))
        }
        when self.map_value_boxed(value) {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 24)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 24)
            self.aligned_call(asm, String("free"))
        }
        asm.bind(next_bucket)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_ri(0, x64::Reg::RAX, 40)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
        asm.jmp(bucket_top)
        asm.bind(buckets_done)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 32)
        self.aligned_call(asm, String("free"))
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 0)
        self.aligned_call(asm, String("free"))
        when header {
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        self.aligned_call(asm, String("free"))
        }
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
        return true
    }

    // An enum's box: the tag in cell 0, then the payload of the variant. The owned fields of the variant of the tag are dropped,
    // then the box is freed.
    fun emit_enum_free(mut self, asm: &mut x64::Asm, id: u64) -> bool {
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 16)
        asm.store(8, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        mut variant: u64 = 0
        while variant < self.program.enums[id].variants.len() {
            fields := self.program.enums[id].variants[variant].fields.clone()
            mut field: u64 = 0
            while field < fields.len() {
                field_ty := fields[field]
                when self.has_owners(field_ty) {
                    skip := asm.new_label()
                    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 8)
                    asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
                    asm.alu_ri(7, x64::Reg::RCX, variant as i64)
                    asm.jcc(x64::Cc::NOT_EQUAL, skip)
                    payload: u64 = self.enum_field_offset(id, variant, field)
                    disp: u64 = 8 * (1 + payload)
                    asm.alu_ri(0, x64::Reg::RAX, disp as i64)
                    asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
                    label := self.value_drop_routine(asm, field_ty, true)
                    asm.call_label(label)
                    asm.bind(skip)
                }
                field += 1
            }
            variant += 1
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        self.aligned_call(asm, String("free"))
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
        return true
    }

    // With `RYN_SYMBOLS`, starts a symbol for a routine of `ty`, named by its kind and the type.
    fun name_routine(mut self, asm: &mut x64::Asm, kind: String, ty: u64) {
        when !self.symbols {
            return
        }
        mut name := String("<")
        name.append(kind)
        name.append(" ")
        name.append(self.type_label(ty))
        name.append(">")
        asm.name_function(name)
    }

    fun type_label(self, ty: u64) -> String {
        when ty >= self.program.types.len() {
            return String("?")
        }
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => word,
            ir::IrTy::StructTy(id) => self.program.structs[id].name.clone(),
            ir::IrTy::EnumTy(id) => self.program.enums[id].name.clone(),
            ir::IrTy::VecOf(element) => self.vec_label(element),
            _ => String("type"),
        }
    }

    fun vec_label(self, element: u64) -> String {
        mut name := String("Vec ")
        name.append(self.type_label(element))
        return name
    }

    // Emits the drop routines that were asked for and are not written yet, until none is missing. A routine may ask for
    // more, and may make a destructor needed, so the function scan calls this again after each function it generates.
    fun emit_drop_routines(mut self, asm: &mut x64::Asm) -> bool {
        mut changed: bool = true
        while changed {
            changed = false
            while self.drop_values_done < self.drop_value_labels.len() {
                self.name_routine(asm, String("drop value"), self.drop_value_ids[self.drop_values_done])
                asm.bind(self.drop_value_labels[self.drop_values_done])
                when !self.emit_value_drop(asm, self.drop_value_ids[self.drop_values_done], self.drop_value_ascending[self.drop_values_done]) {
                    return false
                }
                self.drop_values_done += 1
                changed = true
            }
            while self.drop_handles_done < self.drop_handle_labels.len() {
                self.name_routine(asm, String("drop handle"), self.drop_handle_ids[self.drop_handles_done])
                asm.bind(self.drop_handle_labels[self.drop_handles_done])
                when !self.emit_handle_drop(asm, self.drop_handle_ids[self.drop_handles_done]) {
                    return false
                }
                self.drop_handles_done += 1
                changed = true
            }
        }
        return true
    }

    // Whether a type is a structure with a destructor that is one cell, a handle: such a value can be a map's value.
    fun is_handle_struct(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.program.structs[id].slot_count == 1 && self.program.structs[id].drop_function.is_some(),
            _ => false,
        }
    }

    // The destructor function that dropping a vector (of structures) or a map (of handle structures) must run on each
    // element or value, when there is one.
    fun glue_function(self, ty: u64) -> Option<u64> {
        return choose self.program.types[ty] {
            ir::IrTy::VecOf(element) => self.destructor_of(element),
            ir::IrTy::MapOf(key, value) => self.handle_destructor(value),
            _ => Option::None,
        }
    }

    fun handle_destructor(self, ty: u64) -> Option<u64> {
        when self.is_handle_struct(ty) {
            return self.destructor_of(ty)
        }
        return Option::None
    }

    // Whether the owner of a value of this type has to drop it: a destructor structure, or a vector or map of them.
    fun needs_drop(self, ty: u64) -> bool {
        return self.has_owners(ty)
    }

    // Whether a value of type `ty` owns storage that its owner frees (see `owner_pairs`).
    fun has_owners(self, ty: u64) -> bool {
        return self.owner_pairs(ty).len() > 0
    }

    // The drop routine of a vector (kind 0) or map (kind 1) whose elements have destructors, asked for once per element type.
    fun glue_routine(mut self, asm: &mut x64::Asm, kind: u64, element: u64) -> u64 {
        key := element * 2 + kind
        found := self.glue_index.get(key)
        when found.is_some() {
            return self.glue_labels[found.unwrap()]
        }
        label := asm.new_label()
        self.glue_index.insert(key, self.glue_labels.len())
        self.glue_kinds.push(kind)
        self.glue_elements.push(element)
        self.glue_labels.push(label)
        when self.destructor_of(element).is_some() {
            self.needed.set(self.destructor_of(element).unwrap(), true)
        }
        return label
    }

    fun glue_is_map(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::MapOf(key, value) => true,
            _ => false,
        }
    }

    // The routine that drops each element of a vector (last first) or each value of a map: the header is in rdi.
    fun emit_glue(mut self, asm: &mut x64::Asm, kind: u64, element: u64) {
        mut fid: u64 = 0
        when self.destructor_of(element).is_some() {
            fid = self.destructor_of(element).unwrap()
        }
        cells := self.cells_of(element)
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 32)
        asm.store(8, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        done := asm.new_label()
        top := asm.new_label()
        when kind == 0 {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RDI, 8)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            asm.bind(top)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::EQUAL, done)
            asm.alu_ri(5, x64::Reg::RAX, 1)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            self.scale_bytes(asm, x64::Reg::RAX, cells * 8)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, (0 as i64) - 8)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RSI, 0)
            asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RAX)
            when self.destructor_of(element).is_some() {
                asm.alu_ri(5, x64::Reg::RSP, (cells * 8) as i64)
                self.copy_block(asm, x64::Reg::RSI, x64::Reg::RSP, cells)
                asm.call_label(self.labels[fid])
                asm.alu_ri(0, x64::Reg::RSP, (cells * 8) as i64)
            }
            // A structure whose destructor is in its fields: its value drop runs them, in place. The value's first cell is
            // at the top of its block, as `value_drop_routine` reads cells that fall in memory.
            when self.destructor_of(element).is_none() {
                asm.lea(x64::Reg::RDI, x64::Reg::RSI, (8 * (cells - 1)) as i64)
                asm.call_label(self.value_drop_routine(asm, element, false))
            }
            asm.jmp(top)
        } else {
            // Buckets in order; each bucket's chain of nodes, whose value is at offset 24.
            asm.mov_ri(x64::Reg::RAX, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            next_bucket := asm.new_label()
            inner := asm.new_label()
            asm.bind(top)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 8)
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
            asm.jcc(x64::Cc::ABOVE_EQUAL, done)
            self.scale_bytes(asm, x64::Reg::RAX, 8)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 0)
            asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RCX, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
            asm.bind(inner)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::EQUAL, next_bucket)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 24)
            asm.push(x64::Reg::RCX)
            asm.call_label(self.labels[fid])
            asm.alu_ri(0, x64::Reg::RSP, 8)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
            asm.jmp(inner)
            asm.bind(next_bucket)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            asm.alu_ri(0, x64::Reg::RAX, 1)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            asm.jmp(top)
        }
        asm.bind(done)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
    }

    // Drops a value of type `ty` that a call left as its result, in rax or on the stack, and removes it from the stack.
    fun drop_pushed(mut self, asm: &mut x64::Asm, ty: u64) {
        when self.aggregate_cells(ty) == 0 {
            skip := asm.new_label()
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::EQUAL, skip)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            label := self.handle_drop_routine(asm, ty)
            asm.call_label(label)
            asm.bind(skip)
            return
        }
        count := self.aggregate_cells(ty)
        slot := self.scratch(count)
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot + cell))
            cell += 1
        }
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        self.drop_slot(asm, slot, ty)
    }

    // The cells, from the first of a structure, that hold the handles of destructors it owns: a destructor value owns its
    // first cell, and a structure without a destructor owns the handles of its fields.
    fun struct_destructor_cells(self, id: u64) -> Vec<u64> {
        mut cells: Vec<u64> = Vec()
        when self.program.structs[id].drop_function.is_some() {
            cells.push(0)
            return cells
        }
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            field_ty := self.program.structs[id].fields[position].ty
            offset := self.program.structs[id].fields[position].slot_offset
            inner := choose self.program.types[field_ty] {
                ir::IrTy::StructTy(field_id) => self.struct_destructor_cells(field_id),
                _ => Vec(),
            }
            mut at: u64 = 0
            while at < inner.len() {
                cells.push(offset + inner[at])
                at += 1
            }
            position += 1
        }
        return cells
    }

    // A move leaves the handles of the destructors it moved out null, so that the scope's drop does nothing for them.
    fun null_moved(mut self, asm: &mut x64::Asm, slot: u64, id: u64) {
        self.null_owners(asm, slot, self.struct_type(id))
    }

    fun string_type(self) -> u64 {
        mut ty: u64 = 0
        while ty < self.program.types.len() {
            when self.is_string(ty) { return ty }
            ty += 1
        }
        return 0
    }

    fun is_string(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => word == "OwnedString",
            _ => false,
        }
    }

    // A structure of one cell used as a value (a map's value): the value of its only field.
    fun handle_value(mut self, asm: &mut x64::Asm, id: u64, values: Vec<u64>) -> bool {
        when self.program.structs[id].slot_count != 1 || values.len() != 1 {
            return self.fail("a structure value")
        }
        return self.expr(asm, values[0])
    }

    // The owned values that are not freed yet: a String or a Vec, whose storage the process frees at its end. An array of
    // plain scalars owns nothing, so dropping it does nothing.
    fun is_leakable(self, ty: u64) -> bool {
        return self.is_string(ty) || choose self.program.types[ty] {
            ir::IrTy::ArrayOf(element, length) => self.is_plain_scalar(element),
            ir::IrTy::SliceOf(element) => true,
            ir::IrTy::VecOf(element) => true,
            ir::IrTy::MapOf(key, value) => true,
            ir::IrTy::SetOf(key, value) => true,
            ir::IrTy::EnumTy(id) => true,
            _ => false,
        }
    }

    fun assign(mut self, asm: &mut x64::Asm, slot: u64, value: u64) -> bool {
        when !self.expr(asm, value) {
            return false
        }
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
        return true
    }

    // `arg_count()`: the number of arguments after the program's name, which is argc less one.
    fun arg_count(mut self, asm: &mut x64::Asm) -> bool {
        asm.lea_symbol(x64::Reg::RAX, self.arguments_symbol)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 0)
        asm.alu_ri(5, x64::Reg::RAX, 1)
        return true
    }

    // `arg(i)`: argument i after the program's name, as a str pushed as its cells. An index past the arguments is the empty
    // text. The argument is a C string, whose length strlen finds.
    fun argument(mut self, asm: &mut x64::Asm, arguments: Vec<u64>) -> bool {
        when arguments.len() != 1 {
            return self.fail("an argument with another number of arguments")
        }
        when !self.expr(asm, arguments[0]) {
            return false
        }
        asm.lea_symbol(x64::Reg::RCX, self.arguments_symbol)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RCX, 8)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::R8, 1)
        empty := asm.new_label()
        have := asm.new_label()
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, empty)
        self.scale_bytes(asm, x64::Reg::R8, 8)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::R8, 0)
        asm.jmp(have)
        asm.bind(empty)
        asm.lea_symbol(x64::Reg::RDI, self.c_literal(String("")))
        asm.bind(have)
        asm.push(x64::Reg::RDI)
        self.aligned_call(asm, String("strlen"))
        asm.push(x64::Reg::RAX)
        return true
    }

    // `echo value`: the value, then a newline.
    fun echo_statement(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        when !self.printed(asm, value, ty) {
            return false
        }
        self.write_literal(asm, newline_literal())
        return true
    }

    fun template(mut self, asm: &mut x64::Asm, parts: Vec<u64>) -> bool {
        for part in parts {
            done := choose self.program.parts[part] {
                ir::PrintPart::TextPart(text) => self.text_part(asm, text),
                ir::PrintPart::ValuePart(value, ty) => self.printed(asm, value, ty),
            }
            when !done {
                return false
            }
        }
        // A template is a line, as `print` writes it.
        self.write_literal(asm, newline_literal())
        return true
    }

    fun text_part(mut self, asm: &mut x64::Asm, text: String) -> bool {
        index := self.literal(text)
        self.write_literal(asm, index)
        return true
    }

    // A value written by `echo` or a template: a string literal as its text, a scalar through its printer.
    fun printed(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        mut arguments: Vec<u64> = Vec()
        arguments.push(value)
        self.lend(arguments.clone(), 0)
        temps := self.borrowed_temporaries(arguments.clone(), 0)
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) { return false }
        ok := self.printed_inner(asm, value, ty)
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    fun printed_inner(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        literal := self.string_literal(value)
        when literal.is_some() {
            return self.text_part(asm, literal.unwrap())
        }
        when self.is_str(ty) {
            when !self.load_string_parts(asm, value) {
                return false
            }
            asm.call_label(self.write_label)
            return true
        }
        when self.is_string(ty) {
            when !self.expr(asm, value) {
                return false
            }
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
            asm.call_label(self.write_label)
            return true
        }
        word := self.word(ty)
        when is_integer_word(word.clone()) {
            when !self.expr(asm, value) {
                return false
            }
            when is_signed_word(word.clone()) {
                asm.call_label(self.print_i64_label)
            } else {
                asm.call_label(self.print_u64_label)
            }
            return true
        }
        when word == "Bool" {
            when !self.expr(asm, value) {
                return false
            }
            asm.call_label(self.print_bool_label)
            return true
        }
        when word == "Char" {
            when !self.expr(asm, value) {
                return false
            }
            self.write_char(asm)
            return true
        }
        when self.is_float(ty) {
            return self.print_float(asm, value, ty)
        }
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.print_value(asm, value, ty),
            ir::IrTy::EnumTy(id) => self.print_value(asm, value, ty),
            _ => self.fail("an echo of this type"),
        }
    }

    // A structure or an enum written by `echo`, as the Rust backend writes it: a value with a place is read from the place;
    // any other is built in scratch cells, and dropped once it is written.
    fun print_value(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        place := self.place_of(value)
        when place.is_some() {
            return self.print_slot(asm, place.unwrap(), ty)
        }
        saved := self.scratch(self.cells_of(ty))
        when !self.store_into(asm, value, saved, ty) {
            return false
        }
        when !self.print_slot(asm, saved, ty) {
            return false
        }
        // A temporary that `printed` takes for its own is dropped by it, once it is written; any other value is dropped here.
        when self.temporary_type(value).is_none() && self.has_owners(ty) {
            self.drop_value(asm, saved, ty)
        }
        return true
    }

    // The value that the frame holds in the cells from `slot`, written as `echo` writes it: a structure as its name and its
    // fields, an enum as its variant and its payload, and a scalar or text as it prints.
    fun print_slot(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        when self.is_str(ty) {
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, slot_disp(slot))
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(slot + 1))
            asm.call_label(self.write_label)
            return true
        }
        when self.is_string(ty) {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
            asm.call_label(self.write_label)
            return true
        }
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.print_struct_slot(asm, slot, id),
            ir::IrTy::EnumTy(id) => self.print_enum_slot(asm, slot, id),
            _ => self.print_scalar_slot(asm, slot, ty),
        }
    }

    fun print_scalar_slot(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        word := self.word(ty)
        when is_integer_word(word.clone()) {
            when !self.load_cell(asm, ty, x64::Reg::RBP, slot_disp(slot)) {
                return false
            }
            when is_signed_word(word.clone()) {
                asm.call_label(self.print_i64_label)
            } else {
                asm.call_label(self.print_u64_label)
            }
            return true
        }
        when word == "Bool" {
            when !self.load_cell(asm, ty, x64::Reg::RBP, slot_disp(slot)) {
                return false
            }
            asm.call_label(self.print_bool_label)
            return true
        }
        when word == "Char" {
            when !self.load_cell(asm, ty, x64::Reg::RBP, slot_disp(slot)) {
                return false
            }
            self.write_char(asm)
            return true
        }
        return self.fail("an echo of this type")
    }

    fun print_struct_slot(mut self, asm: &mut x64::Asm, slot: u64, id: u64) -> bool {
        self.text_part(asm, self.program.structs[id].name.clone())
        self.text_part(asm, String(" { "))
        mut index: u64 = 0
        while index < self.program.structs[id].fields.len() {
            when index != 0 {
                self.text_part(asm, String(", "))
            }
            self.text_part(asm, self.program.structs[id].fields[index].name.clone())
            self.text_part(asm, String(": "))
            field_ty := self.program.structs[id].fields[index].ty
            field_slot := slot + self.program.structs[id].fields[index].slot_offset
            when !self.print_slot(asm, field_slot, field_ty) {
                return false
            }
            index += 1
        }
        self.text_part(asm, String(" }"))
        return true
    }

    // The variant whose tag the box holds is written with its payload, which is copied out of the box into scratch cells
    // as a match copies it.
    fun print_enum_slot(mut self, asm: &mut x64::Asm, slot: u64, id: u64) -> bool {
        end := asm.new_label()
        mut variant: u64 = 0
        while variant < self.program.enums[id].variants.len() {
            next := asm.new_label()
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
            asm.alu_ri(7, x64::Reg::RCX, variant as i64)
            asm.jcc(x64::Cc::NOT_EQUAL, next)
            self.text_part(asm, self.program.enums[id].variants[variant].name.clone())
            count := self.program.enums[id].variants[variant].fields.len()
            when count > 0 {
                self.text_part(asm, String("("))
                mut field: u64 = 0
                while field < count {
                    when field != 0 {
                        self.text_part(asm, String(", "))
                    }
                    field_ty := self.program.enums[id].variants[variant].fields[field]
                    cells := self.cells_of(field_ty)
                    at := self.enum_field_offset(id, variant, field)
                    copies := self.scratch(cells)
                    mut cell: u64 = 0
                    while cell < cells {
                        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
                        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (1 + at + cell)) as i64)
                        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, slot_disp(copies + cell))
                        cell += 1
                    }
                    when !self.print_slot(asm, copies, field_ty) {
                        return false
                    }
                    field += 1
                }
                self.text_part(asm, String(")"))
            }
            asm.jmp(end)
            asm.bind(next)
            variant += 1
        }
        asm.bind(end)
        return true
    }

    // A float written to standard output: its text is formatted into a buffer on the stack and written.
    fun print_float(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        when !self.format_float(asm, value, self.word(ty) == "F32") {
            return false
        }
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
        asm.call_label(self.write_label)
        asm.alu_ri(0, x64::Reg::RSP, 416)
        return true
    }

    // Formats the float that `value` computes as text. The text is at rsp, in 416 bytes that the caller removes, and its
    // length is in rax. The routine itself is written once, after the functions, when a program needs it.
    fun format_float(mut self, asm: &mut x64::Asm, value: u64, single: bool) -> bool {
        when !self.expr(asm, value) {
            return false
        }
        when self.freestanding {
            self.needed.set(self.native_float_format, true)
            asm.push(x64::Reg::RAX)
            asm.mov_ri(x64::Reg::RAX, 0)
            when single { asm.mov_ri(x64::Reg::RAX, 1) }
            asm.push(x64::Reg::RAX)
            asm.call_label(self.labels[self.native_float_format])
            asm.alu_ri(0, x64::Reg::RSP, 16)
            // Copy the owned runtime String into the caller's fixed buffer, then release it.
            asm.alu_ri(5, x64::Reg::RSP, 432)
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 416)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
            asm.store(8, x64::Reg::RDX, x64::Reg::RSP, 424)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RSP)
            self.aligned_call(asm, String("memcpy"))
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 416)
            asm.call_label(self.handle_drop_routine(asm, self.program.functions[self.native_float_format].return_type.unwrap()))
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 424)
            // The caller removes 416 bytes. Move the text up by 16 first.
            asm.push(x64::Reg::RAX)
            asm.lea(x64::Reg::RSI, x64::Reg::RSP, 8)
            asm.lea(x64::Reg::RDI, x64::Reg::RSP, 24)
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            self.aligned_call(asm, String("memmove"))
            asm.pop(x64::Reg::RAX)
            asm.alu_ri(0, x64::Reg::RSP, 16)
            return true
        }
        self.float_format_used = true
        asm.alu_ri(5, x64::Reg::RSP, 416)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RSP)
        asm.mov_ri(x64::Reg::RCX, 0)
        when single {
            asm.mov_ri(x64::Reg::RCX, 1)
        }
        asm.call_label(self.float_format_label)
        return true
    }

    // The routines of the freestanding runtime, with the text `strerror` gives for the common errors.
    // The zero-filled bytes only a Windows image has: the exception handler's state.
    // The mode, the length and the bytes of the standard output buffer.
    fun stdout_state_size(self) -> u64 {
        when !self.windows && !self.no_opt {
            return 65552
        }
        return 0
    }

    // Writes out what standard output holds, when it is buffered. Keeps rdi, rsi and rdx.
    fun flush_stdout(self, asm: &mut x64::Asm) {
        when self.buffered {
            asm.call_label(self.flush_label)
        }
    }

    // Writes the bytes at rsi, of length rdx, to standard output: into the buffer, or at once.
    fun write_stdout(self, asm: &mut x64::Asm) {
        when self.buffered {
            asm.call_label(self.write_label)
            return
        }
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
    }

    fun windows_state_size(self) -> u64 {
        when self.windows {
            return 16
        }
        return 0
    }

    // The Windows routines under the freestanding runtime: the system call emulation, the start-up and the exception handler.
    fun emit_windows(mut self, asm: &mut x64::Asm) {
        win := winrt::WinRt { syscall_label: self.win_syscall, init_label: self.win_init, veh_label: self.win_veh, state_symbol: self.win_state, api_names: self.win_names.clone(), api_symbols: self.win_symbols.clone() }
        winrt::emit_syscall(asm, &win)
        winrt::emit_init(asm, &win)
        winrt::emit_veh(asm, &win)
    }

    fun emit_freestanding(mut self, asm: &mut x64::Asm) {
        // The texts of `strerror` are made only when the code names it: the other routines are written as they are named.
        mut numbers: Vec<u64> = Vec()
        mut texts: Vec<u64> = Vec()
        mut unknown: u64 = 0
        when asm.is_pending(self.rt.strerror) {
            numbers.push(1)
            texts.push(self.c_literal(String("Operation not permitted")))
            numbers.push(2)
            texts.push(self.c_literal(String("No such file or directory")))
            numbers.push(5)
            texts.push(self.c_literal(String("Input/output error")))
            numbers.push(12)
            texts.push(self.c_literal(String("Cannot allocate memory")))
            numbers.push(13)
            texts.push(self.c_literal(String("Permission denied")))
            numbers.push(17)
            texts.push(self.c_literal(String("File exists")))
            numbers.push(20)
            texts.push(self.c_literal(String("Not a directory")))
            numbers.push(21)
            texts.push(self.c_literal(String("Is a directory")))
            numbers.push(22)
            texts.push(self.c_literal(String("Invalid argument")))
            numbers.push(24)
            texts.push(self.c_literal(String("Too many open files")))
            numbers.push(28)
            texts.push(self.c_literal(String("No space left on device")))
            numbers.push(36)
            texts.push(self.c_literal(String("File name too long")))
            unknown = self.c_literal(String("Unknown error"))
        }
        labels := self.rt.clone()
        rt::emit(asm, &labels, numbers, texts, unknown, self.windows)
    }

    // The symbol of a string literal followed by a zero byte.
    fun c_literal(mut self, text: String) -> u64 {
        mut terminated := text
        terminated.push(char_from_u32(0))
        index := self.literal(terminated)
        return self.literal_symbols[index]
    }

    // `trim`, `trim_start` and `trim_end`: a new String of the part of the text that white space does not surround.
    fun string_trim(mut self, asm: &mut x64::Asm, text: u64, op: String) -> bool {
        when !self.text_parts(asm, text, true) {
            return false
        }
        self.textops_used = self.textops_used | 1
        mut mode: u64 = 3
        when op == "TrimStart" {
            mode = 1
        }
        when op == "TrimEnd" {
            mode = 2
        }
        asm.mov_ri(x64::Reg::RCX, mode)
        asm.call_label(self.trim_label)
        return self.string_from_parts(asm)
    }

    // `to_lower` and `to_upper`: a new String with the letters changed.
    fun string_case(mut self, asm: &mut x64::Asm, text: u64, upper: bool) -> bool {
        when !self.text_parts(asm, text, true) {
            return false
        }
        self.textops_used = self.textops_used | 2
        asm.mov_ri(x64::Reg::RCX, 0)
        when upper {
            asm.mov_ri(x64::Reg::RCX, 1)
        }
        asm.call_label(self.case_label)
        // Adopt the allocated buffer rather than copying it and losing its owner.
        return self.string_adopt_parts(asm)
    }

    // `find`: the index in characters of the first match, or -1.
    fun string_find(mut self, asm: &mut x64::Asm, text: u64, pattern: u64, owned: bool) -> bool {
        when !self.find_offset(asm, text, pattern, owned) {
            return false
        }
        // rax is a byte offset or -1; the characters before it are the bytes that are not continuation bytes.
        done := asm.new_label()
        count := asm.new_label()
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::LESS, done)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.mov_ri(x64::Reg::R8, 0)
        asm.bind(count)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::R9)
        asm.jcc(x64::Cc::ABOVE_EQUAL, done)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RDI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::R11, 0)
        asm.alu_ri(4, x64::Reg::RCX, 192)
        asm.alu_ri(7, x64::Reg::RCX, 128)
        skip := asm.new_label()
        asm.jcc(x64::Cc::EQUAL, skip)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.bind(skip)
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.jmp(count)
        asm.bind(done)
        return true
    }

    // Finds the pattern in the text: rax is the byte offset or -1, and rdi is the text's data.
    fun find_offset(mut self, asm: &mut x64::Asm, text: u64, pattern: u64, owned: bool) -> bool {
        when !self.text_parts(asm, text, true) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, pattern, owned) {
            return false
        }
        asm.pop(x64::Reg::RCX)
        asm.pop(x64::Reg::RDI)
        self.textops_used = self.textops_used | 4
        asm.call_label(self.find_label)
        return true
    }

    // The Option<u64> of a `find` result that is -1 or an index.
    fun find_option(mut self, asm: &mut x64::Asm, value: u64, id: u64) -> bool {
        some := self.variant_tag(id, String("Some"))
        none := self.variant_tag(id, String("None"))
        when some.is_none() || none.is_none() {
            return self.fail("a find without its Option")
        }
        when !self.expr(asm, value) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.pop(x64::Reg::RCX)
        found := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
        asm.jcc(x64::Cc::GREATER_EQUAL, found)
        asm.mov_ri(x64::Reg::RDX, none.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.jmp(done)
        asm.bind(found)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.mov_ri(x64::Reg::RDX, some.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `replace(from, to)` with `str` arguments: every match of `from` is replaced, left to right. The result is built in
    // a buffer sized for the most matches there can be, and then copied into a String. The state lives on the stack:
    // the text, `from`, `to`, the buffer, the output position and the position in the text.
    fun string_replace(mut self, asm: &mut x64::Asm, text: u64, from: u64, to: u64) -> bool {
        when self.string_literal(from).is_some() {
            when self.string_literal(from).unwrap().len() == 0 {
                return self.fail("a replace of an empty pattern")
            }
        }
        when !self.text_parts(asm, text, true) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, from, false) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, to, false) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        self.textops_used = self.textops_used | 4
        // rsp: 0 to-length, 8 to, 16 from-length, 24 from, 32 text-length, 40 text.
        nonempty := asm.new_label()
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
        asm.jcc(x64::Cc::NOT_EQUAL, nonempty)
        self.fail_exit(asm, String("Ryn runtime error: replace of an empty pattern\n"))
        asm.bind(nonempty)
        // Capacity: text + (text / from + 1) * to + 1.
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.mov_ri(x64::Reg::RDX, 0)
        asm.unary(6, x64::Reg::RCX)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.imul_rr(x64::Reg::RAX, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 32)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RCX)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("malloc"))
        // Layout: 0 offset of the match, 8 position in the text, 16 output position, 24 buffer, then the six above.
        asm.push(x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.push(x64::Reg::RAX)
        asm.push(x64::Reg::RAX)
        asm.push(x64::Reg::RAX)
        loop_start := asm.new_label()
        tail := asm.new_label()
        asm.bind(loop_start)
        self.sum_at(asm, x64::Reg::RDI, 72, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 64)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 8)
        asm.alu_rr(41, x64::Reg::RCX, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 56)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 48)
        asm.call_label(self.find_label)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::LESS, tail)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 0)
        self.sum_at(asm, x64::Reg::RDI, 24, 16)
        self.sum_at(asm, x64::Reg::RSI, 72, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        self.aligned_call(asm, String("memcpy"))
        self.add_to(asm, 16, 0)
        self.sum_at(asm, x64::Reg::RDI, 24, 16)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 40)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 32)
        self.aligned_call(asm, String("memcpy"))
        self.add_to(asm, 16, 32)
        self.add_to(asm, 8, 0)
        self.add_to(asm, 8, 48)
        asm.jmp(loop_start)
        asm.bind(tail)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 64)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 8)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RAX)
        asm.store(8, x64::Reg::RDX, x64::Reg::RSP, 0)
        self.sum_at(asm, x64::Reg::RDI, 24, 16)
        self.sum_at(asm, x64::Reg::RSI, 72, 8)
        self.aligned_call(asm, String("memcpy"))
        self.add_to(asm, 16, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        when !self.string_from_parts(asm) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 32)
        self.aligned_call(asm, String("free"))
        asm.pop(x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::RSP, 80)
        return true
    }

    // `reg` = the word at rsp + a plus the word at rsp + b. Clobbers r10.
    fun sum_at(self, asm: &mut x64::Asm, reg: u64, a: i64, b: i64) {
        asm.load(8, false, reg, x64::Reg::RSP, a)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RSP, b)
        asm.alu_rr(1, reg, x64::Reg::R10)
    }

    // The word at rsp + to += the word at rsp + from. Clobbers r10 and r11.
    fun add_to(self, asm: &mut x64::Asm, to: i64, from: i64) {
        asm.load(8, false, x64::Reg::R10, x64::Reg::RSP, to)
        asm.load(8, false, x64::Reg::R11, x64::Reg::RSP, from)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::R11)
        asm.store(8, x64::Reg::R10, x64::Reg::RSP, to)
    }

    // `String(float)`: the text of the float, copied into a new String.
    fun string_from_float(mut self, asm: &mut x64::Asm, value: u64, single: bool) -> bool {
        when !self.format_float(asm, value, single) {
            return false
        }
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
        when !self.string_from_parts(asm) {
            return false
        }
        asm.alu_ri(0, x64::Reg::RSP, 416)
        return true
    }

    // Writes the character in rax to standard output as UTF-8: its bytes are built in a buffer on the stack and written
    // with one write call.
    // Encodes the codepoint in rax as UTF-8 at rsp, which must have 4 bytes free: their count is left in rdx.
    fun encode_char(self, asm: &mut x64::Asm) {
        one := asm.new_label()
        two := asm.new_label()
        three := asm.new_label()
        written := asm.new_label()
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.alu_ri(7, x64::Reg::RDX, 128)
        asm.jcc(x64::Cc::BELOW, one)
        asm.alu_ri(7, x64::Reg::RDX, 2048)
        asm.jcc(x64::Cc::BELOW, two)
        asm.alu_ri(7, x64::Reg::RDX, 65536)
        asm.jcc(x64::Cc::BELOW, three)
        self.utf8_byte(asm, 18, 240, 0)
        self.utf8_byte(asm, 12, 128, 1)
        self.utf8_byte(asm, 6, 128, 2)
        self.utf8_byte(asm, 0, 128, 3)
        asm.mov_ri(x64::Reg::RDX, 4)
        asm.jmp(written)
        asm.bind(three)
        self.utf8_byte(asm, 12, 224, 0)
        self.utf8_byte(asm, 6, 128, 1)
        self.utf8_byte(asm, 0, 128, 2)
        asm.mov_ri(x64::Reg::RDX, 3)
        asm.jmp(written)
        asm.bind(two)
        self.utf8_byte(asm, 6, 192, 0)
        self.utf8_byte(asm, 0, 128, 1)
        asm.mov_ri(x64::Reg::RDX, 2)
        asm.jmp(written)
        asm.bind(one)
        asm.store(1, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.mov_ri(x64::Reg::RDX, 1)
        asm.bind(written)
    }

    // `print` of a character: its bytes are written to standard output.
    fun write_char(self, asm: &mut x64::Asm) {
        asm.alu_ri(5, x64::Reg::RSP, 8)
        self.encode_char(asm)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
        self.write_stdout(asm)
        asm.alu_ri(0, x64::Reg::RSP, 8)
    }


    // One byte of the UTF-8 encoding of the codepoint in rdx: its bits from `shift` up, the low six, and `tag`, at `at`
    // in the buffer on the stack.
    fun utf8_byte(self, asm: &mut x64::Asm, shift: u64, tag: u64, at: i64) {
        asm.mov_rr(x64::Reg::R8, x64::Reg::RDX)
        asm.mov_ri(x64::Reg::RCX, shift)
        asm.shift_cl(5, x64::Reg::R8)
        asm.alu_ri(4, x64::Reg::R8, 63)
        asm.alu_ri(1, x64::Reg::R8, tag as i64)
        asm.store(1, x64::Reg::R8, x64::Reg::RSP, at)
    }

    // The text of a string literal expression, or nothing.
    fun string_literal(self, index: u64) -> Option<String> {
        return choose self.program.exprs[index] {
            ir::IrExpr::StrLit(text) => Option::Some(text),
            _ => Option::None,
        }
    }

    // Whether an owned value of type `ty` is one cell: a String, a vector, a map, a set or an enum, which a temporary can be.
    fun is_handle_type(self, ty: u64) -> bool {
        when self.is_string(ty) {
            return true
        }
        return choose self.program.types[ty] {
            ir::IrTy::VecOf(element) => true,
            ir::IrTy::MapOf(key, value) => true,
            ir::IrTy::SetOf(key, value) => true,
            ir::IrTy::EnumTy(id) => true,
            _ => false,
        }
    }

    // The type of a call that yields a temporary of an owned handle type, when the argument is one.
    fun temporary_type(self, index: u64) -> Option<u64> {
        found := choose self.program.exprs[index] {
            ir::IrExpr::CallExpr(target, arguments, ty) => self.call_temporary_type(index, ty),
            ir::IrExpr::MoveRef(slot, ty) => Option::Some(ty),
            ir::IrExpr::IfExpr(condition, yes, no, ty) => Option::Some(ty),
            ir::IrExpr::EnumMatch(value, id, arms, ty) => Option::Some(ty),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.element_field_temporary_type(index, value, ty),
            ir::IrExpr::ArrayIndex(array, aindex, ty, length) => Option::Some(ty),
            ir::IrExpr::StringAsStr(inner) => self.temporary_type(inner),
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => self.reference_temporary_type(ty, borrowed),
            _ => Option::None,
        }
        when found.is_none() {
            return Option::None
        }
        when self.is_handle_type(found.unwrap()) {
            return found
        }
        return Option::None
    }

    // A call yields a temporary, unless it is the read of an element that a builtin borrows in place.
    fun call_temporary_type(self, index: u64, ty: u64) -> Option<u64> {
        when self.lent[index] {
            return Option::None
        }
        return Option::Some(ty)
    }

    // A call in an expression. The read `vector[index]` of an owner that a builtin only borrows is the element where it lies,
    // not a clone of it.
    fun call_or_lent_element(mut self, asm: &mut x64::Asm, index: u64, target: ir::CallTarget, arguments: Vec<u64>, ty: u64) -> bool {
        when self.lent[index] {
            element := self.vec_element_of_target(target, arguments.clone())
            when element != 0 {
                when !self.vec_element_address(asm, element - 1, arguments[0], arguments[1]) {
                    return false
                }
                return self.load_cell(asm, ty, x64::Reg::RAX, 0)
            }
            return self.fail("a lent element")
        }
        return self.call_value(asm, target, arguments, ty)
    }

    fun reference_temporary_type(self, ty: u64, borrowed: bool) -> Option<u64> {
        when borrowed { return Option::None }
        return Option::Some(ty)
    }

    // A field of an element is cloned by its read, so the clone is a temporary of the read, as an element read is.
    fun element_field_temporary_type(self, index: u64, value: u64, ty: u64) -> Option<u64> {
        when self.lent[value] {
            return Option::None
        }
        when choose self.program.exprs[value] {
            ir::IrExpr::ArrayIndex(array, aindex, aty, length) => true,
            ir::IrExpr::SliceIndex(slice, aindex, aty) => true,
            _ => false,
        } {
            return Option::Some(ty)
        }
        return self.field_temporary_type(index, ty)
    }

    fun field_temporary_type(self, index: u64, ty: u64) -> Option<u64> {
        when self.place_of(index).is_some() || self.is_memory_place(index) { return Option::None }
        return Option::Some(ty)
    }

    // The temporaries among the arguments of a builtin that the builtin only borrows, as positions. A position whose bit is set
    // in `kept` is an argument the builtin stores, so it is not dropped. A temporary after an argument that may have effects is
    // evaluated when the builtin first reads it, preserving argument order.
    fun borrowed_temporaries(self, arguments: Vec<u64>, kept: u64) -> Vec<u64> {
        mut found: Vec<u64> = Vec()
        mut position: u64 = 0
        while position < arguments.len() {
            index := arguments[position]
            keeps := bit_set(kept, position)
            when !keeps && self.temporary_type(index).is_some() {
                found.push(position)
            }
            position += 1
        }
        return found
    }

    // Whether bit `position` of `mask` is set.
    fun bit_set(mask: u64, position: u64) -> bool {
        mut rest: u64 = mask
        mut at: u64 = 0
        while at < position {
            rest = rest / 2
            at += 1
        }
        return rest % 2 == 1
    }

    // Evaluates the borrowed temporaries of a builtin call into frame cells, which the call then reads.
    fun begin_temporaries(mut self, asm: &mut x64::Asm, temps: Vec<u64>, arguments: Vec<u64>) -> bool {
        mut at: u64 = 0
        while at < temps.len() {
            original := arguments[temps[at]]
            index := choose self.program.exprs[original] { ir::IrExpr::StringAsStr(inner) => inner, _ => original }
            cell := self.scratch(1)
            asm.mov_ri(x64::Reg::RAX, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(cell))
            self.temp_exprs.push(index)
            self.temp_cells.push(cell)
            self.temp_ready.push(false)
            self.owner_slots.push(cell)
            self.owner_types.push(self.temporary_type(original).unwrap())
            at += 1
        }
        return true
    }

    // Drops the borrowed temporaries of a builtin call, last first, keeping the call's result: rax, and the cells it left on
    // the stack are untouched by the pushes and pops around the drops.
    fun end_temporaries(mut self, asm: &mut x64::Asm, temps: Vec<u64>, arguments: Vec<u64>) {
        mut at: u64 = temps.len()
        while at > 0 {
            at -= 1
            index := arguments[temps[at]]
            ty := self.temporary_type(index).unwrap()
            cell := self.temp_cells.pop().unwrap()
            self.temp_exprs.pop()
            self.temp_ready.pop()
            skip := asm.new_label()
            asm.push(x64::Reg::RAX)
            asm.push(x64::Reg::RDX)
            asm.push(x64::Reg::RSI)
            asm.push(x64::Reg::RCX)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, slot_disp(cell))
            asm.test_rr(x64::Reg::RDI, x64::Reg::RDI)
            asm.jcc(x64::Cc::EQUAL, skip)
            label := self.handle_drop_routine(asm, ty)
            asm.call_label(label)
            asm.bind(skip)
            asm.mov_ri(x64::Reg::R11, 0)
            asm.store(8, x64::Reg::R11, x64::Reg::RBP, slot_disp(cell))
            asm.pop(x64::Reg::RCX)
            asm.pop(x64::Reg::RSI)
            asm.pop(x64::Reg::RDX)
            asm.pop(x64::Reg::RAX)
        }
    }

    // Marks the arguments that a builtin only borrows and that are a field of a vector element read in place: they are lent, so
    // the field is not cloned and dropped around the builtin. `kept` has a bit set for each argument the builtin stores.
    fun lend(mut self, arguments: Vec<u64>, kept: u64) {
        when self.no_opt {
            return
        }
        mut position: u64 = 0
        while position < arguments.len() {
            when !bit_set(kept, position) {
                self.lend_argument(arguments[position])
            }
            position += 1
        }
    }

    fun lend_argument(mut self, index: u64) {
        // `vector[index]` of an owner in one cell (a `String`, a `Vec`): lent where it lies.
        element_value := choose self.program.exprs[index] {
            ir::IrExpr::CallExpr(target, arguments, ty) => self.lendable_element(target, arguments, ty),
            _ => false,
        }
        when element_value {
            self.lent.set(index, true)
            // The vector it reads is borrowed too.
            vector := choose self.program.exprs[index] {
                ir::IrExpr::CallExpr(target, arguments, ty) => arguments[0],
                _ => 0,
            }
            self.lend_argument(vector)
            return
        }
        found := choose self.program.exprs[index] {
            ir::IrExpr::FieldRead(value, id, field, ty, span) => Option::Some(value),
            _ => Option::None,
        }
        when !found.is_some() {
            return
        }
        call := found.unwrap()
        element := self.vec_element_of_call(call)
        when element == 0 {
            return
        }
        id := choose self.program.exprs[index] {
            ir::IrExpr::FieldRead(value, id, field, ty, span) => id,
            _ => 0,
        }
        field := choose self.program.exprs[index] {
            ir::IrExpr::FieldRead(value, id, field, ty, span) => field,
            _ => 0,
        }
        ty := choose self.program.exprs[index] {
            ir::IrExpr::FieldRead(value, id, field, ty, span) => ty,
            _ => 0,
        }
        arguments := self.element_call_arguments(call)
        when self.element_field_in_place(id, field, ty) && arguments.len() == 2 && self.vec_in_place(arguments[0]) {
            self.lent.set(call, true)
            self.lend_argument(arguments[0])
        }
    }

    fun lendable_element(mut self, target: ir::CallTarget, arguments: Vec<u64>, ty: u64) -> bool {
        when arguments.len() != 2 || !self.vec_in_place(arguments[0]) {
            return false
        }
        when self.vec_element_of_target(target, arguments) == 0 {
            return false
        }
        return self.is_cell(ty) && self.cells_of(ty) == 1 && self.has_owners(ty) && !self.is_handle_struct(ty)
    }

    // A string operation: its temporaries are borrowed, so they are dropped after it.
    fun guarded_string(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        when op == "Len" || op == "IsEmpty" || op == "CharCount" || op == "StrCharCount" || op == "StartsWithStr" || op == "StartsWithString" || op == "Clone" {
            self.lend(arguments.clone(), 0)
        }
        temps := self.borrowed_temporaries(arguments.clone(), 0)
        when temps.len() == 0 {
            return self.string_op(asm, op, arguments)
        }
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) {
            return false
        }
        ok := self.string_op(asm, op, arguments.clone())
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    // A vector operation (as a statement or an expression): a value that is pushed, set or inserted is kept, not borrowed.
    fun guarded_vec(mut self, asm: &mut x64::Asm, op: String, ty: u64, arguments: Vec<u64>, statement: bool) -> bool {
        mut kept: u64 = 0
        when op == "Push" {
            kept = 2
        } else when op == "Set" || op == "Insert" {
            kept = 4
        }
        when op == "Len" || op == "IsEmpty" || op == "Index" || op == "Capacity" {
            self.lend(arguments.clone(), kept)
        }
        temps := self.borrowed_temporaries(arguments.clone(), kept)
        when temps.len() == 0 {
            when statement {
                return self.vec_statement(asm, op, ty, arguments)
            }
            return self.vec_op(asm, op, ty, arguments)
        }
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) {
            return false
        }
        mut ok: bool = false
        when statement {
            ok = self.vec_statement(asm, op, ty, arguments.clone())
        } else {
            ok = self.vec_op(asm, op, ty, arguments.clone())
        }
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    // A map or set operation: an inserted key and value are kept.
    fun guarded_map(mut self, asm: &mut x64::Asm, op: String, key: u64, value: u64, arguments: Vec<u64>) -> bool {
        mut kept: u64 = 0
        when op == "Insert" {
            kept = 6
        }
        when op == "ContainsKey" || op == "Len" || op == "IsEmpty" {
            self.lend(arguments.clone(), kept)
        }
        temps := self.borrowed_temporaries(arguments.clone(), kept)
        when temps.len() == 0 {
            return self.map_op(asm, op, key, value, arguments)
        }
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) {
            return false
        }
        ok := self.map_op(asm, op, key, value, arguments.clone())
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    // An Option or Result test: the value it reads is borrowed.
    fun guarded_predicate(mut self, asm: &mut x64::Asm, op: String, id: u64, arguments: Vec<u64>) -> bool {
        self.lend(arguments.clone(), 0)
        temps := self.borrowed_temporaries(arguments.clone(), 0)
        when temps.len() == 0 {
            return self.enum_predicate(asm, op, id, arguments)
        }
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) {
            return false
        }
        ok := self.enum_predicate(asm, op, id, arguments.clone())
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    // `unwrap` and `expect`: the receiver is borrowed (its payload is copied), so a temporary receiver is dropped after it.
    fun guarded_unwrap(mut self, asm: &mut x64::Asm, id: u64, ty: u64, message: bool, tag: u64, failure: String, arguments: Vec<u64>) -> bool {
        temps := self.borrowed_temporaries(arguments.clone(), 0)
        when temps.len() == 0 {
            return self.enum_unwrap(asm, id, ty, message, tag, failure, arguments)
        }
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) {
            return false
        }
        ok := self.enum_unwrap(asm, id, ty, message, tag, failure, arguments.clone())
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    // `unwrap_or`: the fallback is returned when there is no payload, so it is kept; the receiver is borrowed.
    fun guarded_unwrap_or(mut self, asm: &mut x64::Asm, id: u64, ty: u64, arguments: Vec<u64>) -> bool {
        temps := self.borrowed_temporaries(arguments.clone(), 2)
        when temps.len() == 0 {
            return self.enum_unwrap_or(asm, id, ty, arguments)
        }
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) {
            return false
        }
        ok := self.enum_unwrap_or(asm, id, ty, arguments.clone())
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    // An Option returned by a discarded get/pop still owns its box and payload.
    fun discard_vec_option(mut self, asm: &mut x64::Asm, element: u64, option: u64, pop: bool, arguments: Vec<u64>) -> bool {
        when !self.vec_get_option(asm, element, option, pop, arguments) { return false }
        mut ty: u64 = 0
        mut found: bool = false
        while ty < self.program.types.len() && !found {
            found = choose self.program.types[ty] { ir::IrTy::EnumTy(id) => id == option, _ => false }
            when !found { ty += 1 }
        }
        when !found { self.program.types.push(ir::IrTy::EnumTy(option)) }
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.call_label(self.handle_drop_routine(asm, ty))
        return true
    }

    fun call_statement(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>) -> bool {
        return choose target {
            ir::CallTarget::Func(id) => self.call_for_effect(asm, id, arguments),
            ir::CallTarget::StringOp(op) => self.guarded_string(asm, op, arguments),
            ir::CallTarget::VecOp(op, ty) => self.guarded_vec(asm, op, ty, arguments, true),
            ir::CallTarget::SystemOp(op) => self.guarded_system(asm, op, arguments),
            ir::CallTarget::EnumNew(id, variant) => self.enum_new(asm, id, variant, arguments),
            ir::CallTarget::MapOp(op, key, value) => self.guarded_map(asm, op, key, value, arguments),
            ir::CallTarget::SetOp(op, key, value) => self.guarded_map(asm, op, key, value, arguments),
            ir::CallTarget::IndirectFn(id) => self.indirect_call(asm, id, arguments),
            ir::CallTarget::FilesystemOp(op) => self.filesystem(asm, op, arguments),
            ir::CallTarget::ArgCount => self.arg_count(asm),
            ir::CallTarget::VecGetOption(element, option, pop) => self.discard_vec_option(asm, element, option, pop, arguments),
            ir::CallTarget::EnumPredicate(op, id) => self.guarded_predicate(asm, op, id, arguments),
            ir::CallTarget::TryRead(id) => self.fail("a call to the file reading builtin that gives an Option"),
            ir::CallTarget::ReadFileRes(id) => self.fail("a call to the file reading builtin that gives a Result"),
            ir::CallTarget::VecSlice(element) => self.fail("a vector slice outside a slice argument"),
            ir::CallTarget::SliceLen => self.fail("a slice length"),
            _ => self.fail("a builtin call"),
        }
    }

    fun if_statement(mut self, asm: &mut x64::Asm, condition: u64, then_body: Vec<u64>, else_body: Vec<u64>) -> bool {
        // A condition that is a constant keeps only the branch that runs.
        known := self.const_value(condition)
        when !self.no_opt && known.is_some() {
            when known.unwrap() != 0 {
                return self.body(asm, then_body)
            }
            return self.body(asm, else_body)
        }
        selected := self.select_assignment(asm, condition, then_body.clone(), else_body.clone())
        when selected.is_some() {
            return selected.unwrap()
        }
        otherwise := asm.new_label()
        end := asm.new_label()
        when !self.branch(asm, condition, otherwise, false) {
            return false
        }
        when !self.body(asm, then_body.clone()) {
            return false
        }
        // A `then` that ends in `return`, `break` or `continue`, and an absent `else`, need no jump over the `else`.
        when self.no_opt || !(self.is_empty_body(else_body.clone()) || self.ends_in_leave(then_body.clone())) {
            asm.jmp(end)
        }
        asm.bind(otherwise)
        when !self.body(asm, else_body) {
            return false
        }
        asm.bind(end)
        return true
    }

    // The one assignment of a list of statements (the empty drops of its scopes do not count), or None.
    fun single_assignment(self, statements: Vec<u64>) -> Option<u64> {
        mut found: Option<u64> = Option::None
        for statement in statements {
            assigns := choose self.program.stmts[statement] {
                ir::IrStmt::AssignStmt(slot, ty, value, span) => true,
                _ => false,
            }
            empty := choose self.program.stmts[statement] {
                ir::IrStmt::DropStmt(slots, types) => slots.len() == 0,
                _ => false,
            }
            when assigns {
                when found.is_some() {
                    return Option::None
                }
                found = Option::Some(statement)
            } else when !empty {
                return Option::None
            }
        }
        return found
    }

    // The number of nodes of an integer expression of constants, locals and operators, or 99 for any other expression.
    fun expression_nodes(self, index: u64) -> u64 {
        return choose self.program.exprs[index] {
            ir::IrExpr::IntegerLit(text, ty) => 1,
            ir::IrExpr::BoolLit(value) => 1,
            ir::IrExpr::CharLit(scalar) => 1,
            ir::IrExpr::LocalRef(slot, ty, span) => 1,
            ir::IrExpr::Binary(op, left, right, ty) => 1 + self.expression_nodes(left) + self.expression_nodes(right),
            ir::IrExpr::Negate(value, ty) => 1 + self.expression_nodes(value),
            ir::IrExpr::Not(value) => 1 + self.expression_nodes(value),
            ir::IrExpr::BitNot(value, ty) => 1 + self.expression_nodes(value),
            _ => 99,
        }
    }

    // `when c { x = a } else { x = b }` (or with no `else`) of an integer local, where `c` is a comparison and `a`, `b` and the
    // operands of `c` are small expressions that cannot fail: both values are computed (r9 and r8), and a conditional move
    // picks one, so that a condition that is hard to predict costs no mispredicted jump. None when it is not that shape.
    fun select_assignment(mut self, asm: &mut x64::Asm, condition: u64, then_body: Vec<u64>, else_body: Vec<u64>) -> Option<bool> {
        when self.no_opt || self.inline_active {
            return Option::None
        }
        then_assign := self.single_assignment(then_body)
        when then_assign.is_none() {
            return Option::None
        }
        else_assign := self.single_assignment(else_body.clone())
        when else_assign.is_none() && !self.is_empty_body(else_body) {
            return Option::None
        }
        slot := choose self.program.stmts[then_assign.unwrap()] {
            ir::IrStmt::AssignStmt(slot, ty, value, span) => slot,
            _ => 0,
        }
        ty := choose self.program.stmts[then_assign.unwrap()] {
            ir::IrStmt::AssignStmt(slot, ty, value, span) => ty,
            _ => 0,
        }
        then_value := choose self.program.stmts[then_assign.unwrap()] {
            ir::IrStmt::AssignStmt(slot, ty, value, span) => value,
            _ => 0,
        }
        mut else_value: u64 = 0
        when else_assign.is_some() {
            else_slot := choose self.program.stmts[else_assign.unwrap()] {
                ir::IrStmt::AssignStmt(slot, ty, value, span) => slot,
                _ => 0,
            }
            else_value = choose self.program.stmts[else_assign.unwrap()] {
                ir::IrStmt::AssignStmt(slot, ty, value, span) => value,
                _ => 0,
            }
            when else_slot != slot {
                return Option::None
            }
        }
        word := self.word(ty)
        when !(is_integer_word(word.clone()) || word == "Bool" || word == "Char") || width_of(word.clone()) == 0 || self.is_float(ty) {
            return Option::None
        }
        when !self.is_stable_local(slot, ty) || !self.cannot_fail(then_value) || self.expression_nodes(then_value) > 7 {
            return Option::None
        }
        when else_assign.is_some() && (!self.cannot_fail(else_value) || self.expression_nodes(else_value) > 7) {
            return Option::None
        }
        op := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, cty) => op,
            _ => String(""),
        }
        left := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, cty) => left,
            _ => 0,
        }
        right := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, cty) => right,
            _ => 0,
        }
        compared := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, cty) => cty,
            _ => 0,
        }
        when op != "Eq" && op != "Ne" && op != "Lt" && op != "Le" && op != "Gt" && op != "Ge" {
            return Option::None
        }
        compared_word := self.word(compared)
        when !(is_integer_word(compared_word.clone()) || compared_word == "Bool" || compared_word == "Char") || width_of(compared_word.clone()) == 0 || self.is_float(compared) {
            return Option::None
        }
        when !self.cannot_fail(left) || !self.cannot_fail(right) || self.expression_nodes(left) > 7 || self.expression_nodes(right) > 7 {
            return Option::None
        }
        // What the local holds when the condition is false: the `else` value, or its present value.
        when else_assign.is_some() {
            when !self.expr(asm, else_value) {
                return Option::Some(false)
            }
        } else {
            when !self.local(asm, slot, ty) {
                return Option::Some(false)
            }
        }
        asm.mov_rr(x64::Reg::R8, x64::Reg::RAX)
        when !self.expr(asm, then_value) {
            return Option::Some(false)
        }
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        when !self.compare_flags(asm, op.clone(), left, right) {
            return Option::Some(false)
        }
        asm.cmov(comparison_condition(op, is_signed_word(compared_word)), x64::Reg::R8, x64::Reg::R9)
        register := self.reg_of(slot)
        when register != 0 {
            self.write_cell(asm, 8, x64::Reg::R8, slot, register)
            asm.mov_rr(register, x64::Reg::R8)
        } else {
            self.store_cell(asm, ty, x64::Reg::R8, x64::Reg::RBP, slot_disp(slot))
        }
        return Option::Some(true)
    }

    // Whether a list of statements generates nothing: it has no statement, or only blocks of such lists.
    fun is_empty_body(self, statements: Vec<u64>) -> bool {
        for statement in statements {
            nested := choose self.program.stmts[statement] {
                ir::IrStmt::BlockStmt(inner) => Option::Some(inner),
                _ => Option::None,
            }
            when nested.is_none() || !self.is_empty_body(nested.unwrap()) {
                return false
            }
        }
        return true
    }

    // Whether the last statement of a list is a `return`, `break` or `continue`, so that control never falls off its end.
    fun ends_in_leave(self, statements: Vec<u64>) -> bool {
        when statements.len() == 0 {
            return false
        }
        return self.leaves_the_list(statements[statements.len() - 1])
    }

    // Jumps to `target` when the condition is `when_true` (or false, when it is not), and falls through otherwise. A
    // comparison of integers is one `cmp` and one conditional jump; `!`, `&&` and `||` become jumps; anything else is
    // evaluated to a bool and tested.
    fun branch(mut self, asm: &mut x64::Asm, condition: u64, target: u64, when_true: bool) -> bool {
        when !self.no_opt {
            known := self.const_value(condition)
            when known.is_some() {
                when (known.unwrap() != 0) == when_true {
                    asm.jmp(target)
                }
                return true
            }
            fused := self.branch_fused(asm, condition, target, when_true)
            when fused.is_some() {
                return fused.unwrap()
            }
        }
        when !self.expr(asm, condition) {
            return false
        }
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        when when_true {
            asm.jcc(x64::Cc::NOT_EQUAL, target)
        } else {
            asm.jcc(x64::Cc::EQUAL, target)
        }
        return true
    }

    // `branch` for the conditions that need no bool: `None` for any other.
    fun branch_fused(mut self, asm: &mut x64::Asm, condition: u64, target: u64, when_true: bool) -> Option<bool> {
        negated := choose self.program.exprs[condition] {
            ir::IrExpr::Not(inner) => Option::Some(inner),
            _ => Option::None,
        }
        when negated.is_some() {
            return Option::Some(self.branch(asm, negated.unwrap(), target, !when_true))
        }
        op := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, ty) => op,
            _ => String(""),
        }
        left := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, ty) => left,
            _ => 0,
        }
        right := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, ty) => right,
            _ => 0,
        }
        ty := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, ty) => ty,
            _ => 0,
        }
        when op == "And" || op == "Or" {
            // `a && b` jumps when false, and `a || b` jumps when true, as soon as either side decides it.
            when (op == "And") == !when_true {
                when !self.branch(asm, left, target, when_true) {
                    return Option::Some(false)
                }
                return Option::Some(self.branch(asm, right, target, when_true))
            }
            skip := asm.new_label()
            when !self.branch(asm, left, skip, !when_true) {
                return Option::Some(false)
            }
            ok := self.branch(asm, right, target, when_true)
            asm.bind(skip)
            return Option::Some(ok)
        }
        when op != "Eq" && op != "Ne" && op != "Lt" && op != "Le" && op != "Gt" && op != "Ge" {
            return Option::None
        }
        word := self.word(ty)
        when !(is_integer_word(word.clone()) || word == "Bool" || word == "Char") || width_of(word.clone()) == 0 {
            return Option::None
        }
        when self.is_float(ty) || self.struct_of(ty).is_some() || self.is_string(ty) || self.is_str(ty) || self.is_raw_pointer(ty) {
            return Option::None
        }
        when !self.compare_flags(asm, op.clone(), left, right) {
            return Option::Some(false)
        }
        condition_code := comparison_condition(op, is_signed_word(word))
        when when_true {
            asm.jcc(condition_code, target)
        } else {
            asm.jcc(inverse_condition(condition_code), target)
        }
        return Option::Some(true)
    }

    // `test` of the bits that `value` keeps when it is `x & mask` or `x % 2^k` (mask or 2^k a constant that fits an immediate):
    // sets the zero flag when they are all clear. None when `value` is not one of these.
    fun low_bits_test(mut self, asm: &mut x64::Asm, value: u64) -> Option<bool> {
        op := choose self.program.exprs[value] {
            ir::IrExpr::Binary(op, left, right, ty) => op,
            _ => String(""),
        }
        operand := choose self.program.exprs[value] {
            ir::IrExpr::Binary(op, left, right, ty) => left,
            _ => 0,
        }
        constant := choose self.program.exprs[value] {
            ir::IrExpr::Binary(op, left, right, ty) => right,
            _ => 0,
        }
        ty := choose self.program.exprs[value] {
            ir::IrExpr::Binary(op, left, right, bty) => bty,
            _ => 0,
        }
        when op != "BitAnd" && op != "Rem" {
            return Option::None
        }
        word := self.word(ty)
        when !is_integer_word(word.clone()) || self.is_float(ty) {
            return Option::None
        }
        known := self.const_value(constant)
        when known.is_none() {
            return Option::None
        }
        mut mask: u64 = known.unwrap()
        when op == "Rem" {
            // x % 2^k is zero exactly when the low k bits are: for a signed x too.
            when mask < 2 || power_exponent(mask) == 64 {
                return Option::None
            }
            mask = mask - 1
        }
        when mask == 0 || mask > 2147483647 {
            return Option::None
        }
        register := self.operand_reg(operand)
        when register != 0 {
            asm.test_ri(register, mask as i64)
            return Option::Some(true)
        }
        when !self.expr(asm, operand) {
            return Option::Some(false)
        }
        asm.test_ri(x64::Reg::RAX, mask as i64)
        return Option::Some(true)
    }

    // Leaves the flags of `left cmp right` set, without making a bool of them. A local in a register is compared in place.
    fun compare_flags(mut self, asm: &mut x64::Asm, op: String, left: u64, right: u64) -> bool {
        left_register := self.operand_reg(left)
        immediate := self.immediate_operand(op.clone(), right)
        // `x & mask` or `x % 2^k` against zero (equal or not) is one `test`: the flags of the bits are the answer.
        when immediate.is_some() && immediate.unwrap() == 0 && (op == "Eq" || op == "Ne") {
            tested := self.low_bits_test(asm, left)
            when tested.is_some() {
                return tested.unwrap()
            }
        }
        when immediate.is_some() {
            when left_register != 0 {
                asm.alu_ri(7, left_register, immediate.unwrap() as i64)
                return true
            }
            when !self.expr(asm, left) {
                return false
            }
            asm.alu_ri(7, x64::Reg::RAX, immediate.unwrap() as i64)
            return true
        }
        mut right_register := self.operand_reg(right)
        when left_register != 0 && (right_register != 0 || self.is_stable_operand(right)) {
            when right_register == 0 {
                self.load_stable_operand(asm, right, x64::Reg::RCX)
                right_register = x64::Reg::RCX
            }
            asm.alu_rr(57, left_register, right_register)
            return true
        }
        // A register local on the left stays as it is while the right side is computed.
        when left_register != 0 {
            when !self.expr(asm, right) {
                return false
            }
            asm.alu_rr(57, left_register, x64::Reg::RAX)
            return true
        }
        when self.is_stable_operand(left) && !self.is_stable_operand(right) {
            when !self.expr(asm, right) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            self.load_stable_operand(asm, left, x64::Reg::RAX)
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
            return true
        }
        when !self.expr(asm, left) {
            return false
        }
        when !self.is_stable_operand(right) {
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, right) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.pop(x64::Reg::RAX)
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
            return true
        }
        when right_register != 0 {
            asm.alu_rr(57, x64::Reg::RAX, right_register)
        } else {
            self.load_stable_operand(asm, right, x64::Reg::RCX)
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        }
        return true
    }

    fun while_statement(mut self, asm: &mut x64::Asm, setup: Vec<u64>, condition: u64, body: Vec<u64>) -> bool {
        top := asm.new_label()
        end := asm.new_label()
        // The test is at the bottom, so that an iteration takes one jump, not two: the loop is entered by a jump to the test.
        when !self.no_opt {
            start := asm.new_label()
            asm.jmp(top)
            asm.bind(start)
            self.breaks.push(end)
            self.continues.push(top)
            proved := self.bce_enter_while(setup.clone(), condition, body.clone())
            let_ok := self.body(asm, body)
            when proved {
                self.bce_leave()
            }
            self.breaks.pop()
            self.continues.pop()
            when !let_ok {
                return false
            }
            asm.bind(top)
            when !self.body(asm, setup) {
                return false
            }
            when !self.branch(asm, condition, start, true) {
                return false
            }
            asm.bind(end)
            return true
        }
        asm.bind(top)
        when !self.body(asm, setup) {
            return false
        }
        when !self.branch(asm, condition, end, false) {
            return false
        }
        self.breaks.push(end)
        self.continues.push(top)
        let_ok := self.body(asm, body)
        self.breaks.pop()
        self.continues.pop()
        when !let_ok {
            return false
        }
        asm.jmp(top)
        asm.bind(end)
        return true
    }


    // Whether the vector local `vec` is read at `index`, a local, below its length: a loop `while i < v.len()` or
    // `for i in 0..v.len()` proved it, and nothing has changed `i` or the length since.
    fun bce_proved(self, vec: u64, index: u64) -> bool {
        when self.bce_vec.len() == 0 || self.inline_active {
            return false
        }
        mut at: u64 = 0
        while at < self.bce_vec.len() {
            when self.bce_on[at] && self.bce_is_slot(vec, self.bce_vec[at]) && self.bce_is_slot(index, self.bce_idx[at]) {
                return true
            }
            at += 1
        }
        return false
    }

    // The statement `index` ran: a pair that is cut after it no longer holds.
    fun bce_retire(mut self, index: u64) {
        mut at: u64 = 0
        while at < self.bce_cut.len() {
            when self.bce_cut[at] == index + 1 {
                self.bce_on.set(at, false)
            }
            at += 1
        }
    }

    fun bce_is_slot(self, value: u64, slot: u64) -> bool {
        return choose self.program.exprs[value] {
            ir::IrExpr::LocalRef(found, ty, span) => found == slot,
            _ => false,
        }
    }

    fun bce_slot_of(self, value: u64) -> u64 {
        return choose self.program.exprs[value] {
            ir::IrExpr::LocalRef(slot, ty, span) => slot + 1,
            _ => 0,
        }
    }

    // `v.len()` of a local `v`: the slot of `v` plus one, or 0.
    fun bce_len_of(self, value: u64) -> u64 {
        is_len := choose self.program.exprs[value] {
            ir::IrExpr::CallExpr(target, arguments, ty) => choose target {
                ir::CallTarget::VecOp(op, element) => op == "Len" && arguments.len() == 1,
                _ => false,
            },
            _ => false,
        }
        when !is_len {
            return 0
        }
        first := choose self.program.exprs[value] {
            ir::IrExpr::CallExpr(target, arguments, ty) => arguments[0],
            _ => 0,
        }
        return self.bce_slot_of(first)
    }

    fun bce_local_ok(self, slot: u64) -> bool {
        return slot < self.def_addressed.len() && !self.def_addressed[slot] && self.frame_slot(slot).is_some()
    }

    // Whether the statement is `i = i + c`, `c` a small positive constant.
    fun bce_is_step(self, statement: u64, idx: u64) -> bool {
        target := choose self.program.stmts[statement] {
            ir::IrStmt::AssignStmt(slot, ty, value, span) => slot,
            _ => 0 - 1,
        }
        when target != idx {
            return false
        }
        value := choose self.program.stmts[statement] {
            ir::IrStmt::AssignStmt(slot, ty, value, span) => value,
            _ => 0,
        }
        return choose self.program.exprs[value] {
            ir::IrExpr::Binary(op, left, right, ty) => op == "Add" && self.bce_is_slot(left, idx) && self.step_constant(right),
            _ => false,
        }
    }

    fun step_constant(self, value: u64) -> bool {
        constant := self.const_value(value)
        return constant.is_some() && constant.unwrap() >= 1 && constant.unwrap() <= 4096
    }

    // Starts the proof for a `while` whose condition is `i < v.len()`: pushes the pair when the body keeps `v` and `i` as
    // the proof needs. Returns whether it pushed.
    fun bce_enter_while(mut self, setup: Vec<u64>, condition: u64, body: Vec<u64>) -> bool {
        when self.no_opt || self.inline_active || setup.len() != 0 {
            return false
        }
        less := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, ty) => op == "Lt" && !is_signed_word(self.word(ty)),
            _ => false,
        }
        when !less {
            return false
        }
        left := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, ty) => left,
            _ => 0,
        }
        right := choose self.program.exprs[condition] {
            ir::IrExpr::Binary(op, left, right, ty) => right,
            _ => 0,
        }
        idx := self.bce_slot_of(left)
        vec := self.bce_len_of(right)
        when idx == 0 || vec == 0 {
            return false
        }
        i := idx - 1
        v := vec - 1
        when !self.bce_local_ok(i) || !self.bce_local_ok(v) || i == v {
            return false
        }
        // The statements before the first top-level write of `i` must be that step, and must not change `v` or `i`.
        mut stop: u64 = body.len()
        mut at: u64 = 0
        while at < body.len() {
            writes := choose self.program.stmts[body[at]] {
                ir::IrStmt::AssignStmt(slot, ty, value, span) => slot == i,
                _ => false,
            }
            when writes {
                when !self.bce_is_step(body[at], i) {
                    return false
                }
                stop = at
                at = body.len()
            } else {
                at += 1
            }
        }
        at = 0
        while at < stop {
            when !self.bce_statement_ok(body[at], v, i) {
                return false
            }
            at += 1
        }
        mut cut: u64 = 0
        when stop < body.len() {
            cut = body[stop] + 1
        }
        self.bce_vec.push(v)
        self.bce_idx.push(i)
        self.bce_cut.push(cut)
        self.bce_on.push(true)
        return true
    }

    // The same for `for i in start..v.len()`: the counter is never written by the body.
    fun bce_enter_for(mut self, slot: u64, ty: u64, start: u64, end: u64, inclusive: bool, body: Vec<u64>) -> bool {
        when self.no_opt || self.inline_active || inclusive {
            return false
        }
        vec := self.bce_len_of(end)
        when vec == 0 {
            return false
        }
        v := vec - 1
        when !self.bce_local_ok(slot) || !self.bce_local_ok(v) || slot == v {
            return false
        }
        when is_signed_word(self.word(ty)) {
            first := self.const_value(start)
            when first.is_none() || first.unwrap() >= 9223372036854775808 {
                return false
            }
        }
        mut at: u64 = 0
        while at < body.len() {
            when !self.bce_statement_ok(body[at], v, slot) {
                return false
            }
            at += 1
        }
        self.bce_vec.push(v)
        self.bce_idx.push(slot)
        self.bce_cut.push(0)
        self.bce_on.push(true)
        return true
    }

    fun bce_leave(mut self) {
        self.bce_vec.pop()
        self.bce_idx.pop()
        self.bce_cut.pop()
        self.bce_on.pop()
    }

    fun bce_body_ok(self, statements: Vec<u64>, vec: u64, idx: u64) -> bool {
        for statement in statements {
            when !self.bce_statement_ok(statement, vec, idx) {
                return false
            }
        }
        return true
    }

    fun bce_exprs_ok(self, values: Vec<u64>, vec: u64, idx: u64) -> bool {
        for value in values {
            when !self.bce_expr_ok(value, vec, idx) {
                return false
            }
        }
        return true
    }

    fun bce_two_ok(self, a: u64, b: u64, vec: u64, idx: u64) -> bool {
        return self.bce_expr_ok(a, vec, idx) && self.bce_expr_ok(b, vec, idx)
    }

    // A call keeps the length of `vec` when it only reads it or sets an element; any other use of the local does not.
    fun bce_call_ok(self, target: ir::CallTarget, arguments: Vec<u64>, vec: u64, idx: u64) -> bool {
        keeps := choose target {
            ir::CallTarget::VecOp(op, element) => op == "Index" || op == "Len" || op == "IsEmpty" || op == "Capacity" || op == "Set",
            _ => false,
        }
        when keeps && arguments.len() > 0 && self.bce_is_slot(arguments[0], vec) {
            mut at: u64 = 1
            while at < arguments.len() {
                when !self.bce_expr_ok(arguments[at], vec, idx) {
                    return false
                }
                at += 1
            }
            return true
        }
        return self.bce_exprs_ok(arguments, vec, idx)
    }

    fun bce_expr_ok(self, index: u64, vec: u64, idx: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::IntegerLit(text, ty) => true,
            ir::IrExpr::FloatLit(bits, ty) => true,
            ir::IrExpr::StrLit(text) => true,
            ir::IrExpr::CharLit(value) => true,
            ir::IrExpr::BoolLit(value) => true,
            ir::IrExpr::FunctionAddress(function, ty) => true,
            ir::IrExpr::LocalRef(slot, ty, span) => slot != vec,
            ir::IrExpr::MoveRef(slot, ty) => slot != vec && slot != idx,
            ir::IrExpr::AddressOf(slot, ty, pointer_type, span) => slot != vec && slot != idx,
            ir::IrExpr::StructValue(id, fields, values) => self.bce_exprs_ok(values, vec, idx),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.bce_expr_ok(value, vec, idx),
            ir::IrExpr::ReferenceFieldRead(value, id, field, ty, span, borrowed) => self.bce_expr_ok(value, vec, idx),
            ir::IrExpr::ValueAddress(value, ty, pointer_type, span) => self.bce_expr_ok(value, vec, idx),
            ir::IrExpr::CallExpr(target, arguments, ty) => self.bce_call_ok(target, arguments, vec, idx),
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => self.bce_expr_ok(condition, vec, idx) && self.bce_two_ok(then_value, else_value, vec, idx),
            ir::IrExpr::ArrayValue(items) => self.bce_exprs_ok(items, vec, idx),
            ir::IrExpr::ArrayRepeat(value, length) => self.bce_expr_ok(value, vec, idx),
            ir::IrExpr::ArrayAsSlice(value, slice, length) => self.bce_expr_ok(value, vec, idx),
            ir::IrExpr::ArrayIndex(array, at, ty, length) => self.bce_two_ok(array, at, vec, idx),
            ir::IrExpr::SliceIndex(slice, at, ty) => self.bce_two_ok(slice, at, vec, idx),
            ir::IrExpr::SliceElementAddress(slice, at, ty, span) => self.bce_two_ok(slice, at, vec, idx),
            ir::IrExpr::PlaceAddress(place, ty) => self.bce_expr_ok(place, vec, idx),
            ir::IrExpr::Dereference(pointer, ty) => self.bce_expr_ok(pointer, vec, idx),
            ir::IrExpr::StringAsStr(value) => self.bce_expr_ok(value, vec, idx),
            ir::IrExpr::StringFindOption(value, id) => self.bce_expr_ok(value, vec, idx),
            ir::IrExpr::Binary(op, left, right, ty) => self.bce_two_ok(left, right, vec, idx),
            ir::IrExpr::Negate(value, ty) => self.bce_expr_ok(value, vec, idx),
            ir::IrExpr::Not(value) => self.bce_expr_ok(value, vec, idx),
            ir::IrExpr::BitNot(value, ty) => self.bce_expr_ok(value, vec, idx),
            ir::IrExpr::FfiArray(array, element, length, index, mutable) => self.bce_two_ok(array, index, vec, idx),
            ir::IrExpr::CastExpr(value, source, target) => self.bce_expr_ok(value, vec, idx),
            _ => false,
        }
    }

    // A statement that neither changes the length of `vec` nor writes `idx` (any other use of the two is a read).
    fun bce_statement_ok(self, index: u64, vec: u64, idx: u64) -> bool {
        return choose self.program.stmts[index] {
            ir::IrStmt::BlockStmt(body) => self.bce_body_ok(body, vec, idx),
            ir::IrStmt::DropStmt(slots, types) => !slots.contains(vec),
            ir::IrStmt::LetStmt(slot, ty, value, span) => slot != vec && slot != idx && self.bce_expr_ok(value, vec, idx),
            ir::IrStmt::AssignStmt(slot, ty, value, span) => slot != vec && slot != idx && self.bce_expr_ok(value, vec, idx),
            ir::IrStmt::ArrayAssignStmt(slot, element, length, at, value, span) => slot != vec && slot != idx && self.bce_two_ok(at, value, vec, idx),
            ir::IrStmt::DereferenceAssignStmt(pointer, ty, value) => self.bce_two_ok(pointer, value, vec, idx),
            ir::IrStmt::FieldAssignStmt(slot, ty, value) => slot != vec && slot != idx && self.bce_expr_ok(value, vec, idx),
            ir::IrStmt::ReferenceFieldAssignStmt(pointer, id, field, ty, value) => self.bce_two_ok(pointer, value, vec, idx),
            ir::IrStmt::PrintStmt(value, ty) => self.bce_expr_ok(value, vec, idx),
            ir::IrStmt::PrintTemplateStmt(parts) => self.bce_parts_ok(parts, vec, idx),
            ir::IrStmt::CallStmt(target, arguments) => self.bce_call_ok(target, arguments, vec, idx),
            ir::IrStmt::IfStmt(condition, then_body, else_body) => self.bce_expr_ok(condition, vec, idx) && self.bce_body_ok(then_body, vec, idx) && self.bce_body_ok(else_body, vec, idx),
            ir::IrStmt::WhileStmt(setup, condition, body) => self.bce_body_ok(setup, vec, idx) && self.bce_expr_ok(condition, vec, idx) && self.bce_body_ok(body, vec, idx),
            ir::IrStmt::ForStmt(slot, end_slot, ty, start, end, inclusive, body) => slot != vec && slot != idx && self.bce_two_ok(start, end, vec, idx) && self.bce_body_ok(body, vec, idx),
            ir::IrStmt::BreakStmt => true,
            ir::IrStmt::ContinueStmt => true,
            ir::IrStmt::ReturnStmt(value) => value.is_none() || self.bce_expr_ok(value.unwrap(), vec, idx),
        }
    }

    fun bce_parts_ok(self, parts: Vec<u64>, vec: u64, idx: u64) -> bool {
        for part in parts {
            value := choose self.program.parts[part] {
                ir::PrintPart::ValuePart(value, ty) => Option::Some(value),
                _ => Option::None,
            }
            when value.is_some() && !self.bce_expr_ok(value.unwrap(), vec, idx) {
                return false
            }
        }
        return true
    }

    // `for slot in start..end` (or `..=`): the counter starts at `start`, and the loop stops at `end` (`end` is included
    // for `..=`). The test runs before each iteration, and for `..=` the counter stops before it would step past `end`.
    fun for_statement(mut self, asm: &mut x64::Asm, slot: u64, end_slot: u64, ty: u64, start: u64, end: u64, inclusive: bool, body: Vec<u64>) -> bool {
        when !self.expr(asm, start) {
            return false
        }
        self.store_slot(asm, slot)
        when !self.expr(asm, end) {
            return false
        }
        self.store_slot(asm, end_slot)
        signed := is_signed_word(self.word(ty))
        mut stays: u64 = x64::Cc::BELOW_EQUAL
        when signed {
            stays = x64::Cc::LESS_EQUAL
        }
        when !inclusive {
            stays = x64::Cc::BELOW
            when signed {
                stays = x64::Cc::LESS
            }
        }
        top := asm.new_label()
        step := asm.new_label()
        end_label := asm.new_label()
        // The test is at the bottom (see `while_statement`); the loop is entered by a jump to it.
        when !self.no_opt {
            body_top := asm.new_label()
            asm.jmp(top)
            asm.bind(body_top)
            self.breaks.push(end_label)
            self.continues.push(step)
            proved := self.bce_enter_for(slot, ty, start, end, inclusive, body.clone())
            let_ok := self.body(asm, body)
            when proved {
                self.bce_leave()
            }
            self.breaks.pop()
            self.continues.pop()
            when !let_ok {
                return false
            }
            asm.bind(step)
            // `..=` ends after the iteration that reaches `end`, before the counter would step past it.
            when inclusive {
                self.compare_slots(asm, slot, end_slot)
                asm.jcc(x64::Cc::EQUAL, end_label)
            }
            self.load_slot(asm, x64::Reg::RAX, slot)
            asm.alu_ri(0, x64::Reg::RAX, 1)
            self.normalize(asm, self.word(ty))
            self.store_slot(asm, slot)
            asm.bind(top)
            self.compare_slots(asm, slot, end_slot)
            asm.jcc(stays, body_top)
            asm.bind(end_label)
            return true
        }
        asm.bind(top)
        self.load_slot(asm, x64::Reg::RAX, slot)
        self.load_slot(asm, x64::Reg::RCX, end_slot)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(negated_condition(stays), end_label)
        self.breaks.push(end_label)
        self.continues.push(step)
        let_ok := self.body(asm, body)
        self.breaks.pop()
        self.continues.pop()
        when !let_ok {
            return false
        }
        asm.bind(step)
        when inclusive {
            self.load_slot(asm, x64::Reg::RAX, slot)
            self.load_slot(asm, x64::Reg::RCX, end_slot)
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
            asm.jcc(x64::Cc::EQUAL, end_label)
        }
        self.load_slot(asm, x64::Reg::RAX, slot)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        step_word := self.word(ty)
        self.normalize(asm, step_word)
        self.store_slot(asm, slot)
        asm.jmp(top)
        asm.bind(end_label)
        return true
    }

    // Sets the flags of the 8 bytes of cell `a` against those of cell `b`, from registers when they have them.
    fun compare_slots(mut self, asm: &mut x64::Asm, a: u64, b: u64) {
        first := self.reg_of(a)
        second := self.reg_of(b)
        when first != 0 && second != 0 {
            asm.alu_rr(57, first, second)
            return
        }
        self.load_slot(asm, x64::Reg::RAX, a)
        self.load_slot(asm, x64::Reg::RCX, b)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
    }

    fun jump_to(mut self, asm: &mut x64::Asm, is_break: bool) -> bool {
        when is_break {
            when self.breaks.is_empty() {
                return self.fail("a break outside a loop")
            }
            asm.jmp(self.breaks[self.breaks.len() - 1])
        } else {
            when self.continues.is_empty() {
                return self.fail("a continue outside a loop")
            }
            asm.jmp(self.continues[self.continues.len() - 1])
        }
        return true
    }

    // Whether a call of function `definition` by itself, as the value it returns, can reuse its frame: nothing in the frame
    // is owned, addressed or kept in another layout, and each parameter is one scalar cell.
    fun tail_calls_allowed(self, index: u64) -> bool {
        definition := self.program.functions[index]
        when self.no_opt || self.profiling || self.regions_base.len() > 0 {
            return false
        }
        when definition.reference_return_parameter.is_some() {
            return false
        }
        when definition.return_type.is_some() && self.aggregate_cells(definition.return_type.unwrap()) > 0 {
            return false
        }
        for owned in definition.owned_slot_types {
            when owned.is_some() {
                return false
            }
        }
        for addressed in definition.addressed_slot_types {
            when addressed.is_some() {
                return false
            }
        }
        mut pair: u64 = 0
        while pair < definition.parameters.len() / 2 {
            ty := definition.parameters[pair * 2 + 1]
            when self.cells_of(ty) != 1 || !self.is_cell(ty) || self.is_handle_struct(ty) {
                return false
            }
            pair += 1
        }
        return true
    }

    // The arguments of `value` when it is a call of the function being generated, and None when it is not.
    fun self_call_arguments(self, value: u64) -> Option<Vec<u64>> {
        return choose self.program.exprs[value] {
            ir::IrExpr::CallExpr(target, arguments, ty) => self.self_call_target(target, arguments),
            _ => Option::None,
        }
    }

    fun self_call_target(self, target: ir::CallTarget, arguments: Vec<u64>) -> Option<Vec<u64>> {
        return choose target {
            ir::CallTarget::Func(id) => self.self_call_arguments_of(id, arguments),
            _ => Option::None,
        }
    }

    fun self_call_arguments_of(self, id: u64, arguments: Vec<u64>) -> Option<Vec<u64>> {
        when id == self.cur_function && arguments.len() * 2 == self.program.functions[id].parameters.len() {
            return Option::Some(arguments)
        }
        return Option::None
    }

    // `return f(...)` inside `f`: the arguments are evaluated, stored over the parameters, and the body starts again. The
    // stack does not grow, so a recursion that ends in this call runs in constant space. None when the return is not one.
    fun tail_call(mut self, asm: &mut x64::Asm, value: u64) -> Option<bool> {
        when !self.tail_ok || self.inline_active || self.owner_slots.len() > 0 || self.shadow_slots.len() > 0 {
            return Option::None
        }
        found := self.self_call_arguments(value)
        when !found.is_some() {
            return Option::None
        }
        arguments := found.unwrap()
        parameters := self.program.functions[self.cur_function].parameters.clone()
        mut position: u64 = 0
        while position < arguments.len() {
            when !self.push_value(asm, arguments[position], parameters[position * 2 + 1]) {
                return Option::Some(false)
            }
            position += 1
        }
        while position > 0 {
            position -= 1
            asm.pop(x64::Reg::RAX)
            self.store_slot(asm, parameters[position * 2])
        }
        asm.jmp(self.tail_label)
        return Option::Some(true)
    }

    fun return_statement(mut self, asm: &mut x64::Asm, value: Option<u64>) -> bool {
        // In a body inlined as statements, a `return` leaves the body, not the function.
        when self.inline_exits.len() > 0 {
            when value.is_some() && !self.expr(asm, value.unwrap()) {
                return false
            }
            asm.jmp(self.inline_exits[self.inline_exits.len() - 1])
            return true
        }
        when value.is_some() {
            tail := self.tail_call(asm, value.unwrap())
            when tail.is_some() {
                return tail.unwrap()
            }
        }
        when value.is_some() && self.result_cells > 0 {
            when !self.return_aggregate(asm, value.unwrap()) {
                return false
            }
        }
        when value.is_some() && self.result_cells == 0 {
            when !self.expr(asm, value.unwrap()) {
                return false
            }
        }
        mut saved: bool = false
        when self.owner_slots.len() > 0 {
            saved = self.result_cells == 0
            when saved {
                asm.push(x64::Reg::RAX)
            }
            self.drop_owners(asm)
            when saved {
                asm.pop(x64::Reg::RAX)
            }
        }
        self.leave(asm)
        return true
    }

    // Returns a string or structure value: it is pushed as its cells, then copied to the result cells, which lie above the
    // arguments. Once pushed, cell k of the value is at rsp + 8 * (count - 1 - k), and the caller reads the result in the
    // same order. A structure returned directly (see `direct_return`) skips the pushed copy.
    fun return_aggregate(mut self, asm: &mut x64::Asm, value: u64) -> bool {
        when self.direct_return(value) {
            return self.return_direct(asm, value)
        }
        count := self.result_cells
        when !self.push_value(asm, value, self.result_type) {
            return false
        }
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (16 + 8 * (self.argument_cells + count - 1 - cell)) as i64)
            cell += 1
        }
        return true
    }

    // Whether a return of a structure value can write its cells straight into the result cells, with no pushed copy: the
    // structure has no owners and is not `repr(C)`, and the value is either a literal whose fields are all single cells,
    // or a local of the structure (its cells are copied). Those cells are the ones `push_value` would have pushed.
    fun direct_return(self, value: u64) -> bool {
        structure := self.struct_of(self.result_type)
        when structure.is_none() {
            return false
        }
        id := structure.unwrap()
        when self.program.structs[id].repr_c || self.has_owners(self.result_type) {
            return false
        }
        return choose self.program.exprs[value] {
            ir::IrExpr::StructValue(sid, fields, values) => sid == id && self.literal_cells_are_single(id, fields.clone(), values.clone()),
            ir::IrExpr::LocalRef(slot, lty, span) => self.struct_of(lty).is_some() && self.struct_of(lty).unwrap() == id,
            _ => false,
        }
    }

    // Whether every field of structure `id` is one cell, so that a literal's field i lies in cell i of the structure, and
    // the literal names each field once (the fields of a literal are in the same order as its values).
    fun literal_cells_are_single(self, id: u64, fields: Vec<u64>, values: Vec<u64>) -> bool {
        when fields.len() != self.program.structs[id].fields.len() || values.len() != fields.len() {
            return false
        }
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            when !self.is_cell(self.program.structs[id].fields[position].ty) || self.program.structs[id].fields[position].slot_offset != position {
                return false
            }
            position += 1
        }
        return true
    }

    // Writes a direct return (see `direct_return`) into the result cells. A literal computes its fields in the order they are
    // written, as `push_fields` does, and each lands in its own cell; a local's cells are copied from its frame.
    fun return_direct(mut self, asm: &mut x64::Asm, value: u64) -> bool {
        return choose self.program.exprs[value] {
            ir::IrExpr::StructValue(sid, fields, values) => self.return_literal(asm, sid, fields, values),
            ir::IrExpr::LocalRef(slot, lty, span) => self.return_local(asm, slot),
            _ => self.fail_at("a structure return", value),
        }
    }

    fun return_literal(mut self, asm: &mut x64::Asm, id: u64, fields: Vec<u64>, values: Vec<u64>) -> bool {
        count := self.result_cells
        mut position: u64 = 0
        while position < fields.len() {
            offset := self.program.structs[id].fields[fields[position]].slot_offset
            when !self.expr(asm, values[position]) {
                return false
            }
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (16 + 8 * (self.argument_cells + count - 1 - offset)) as i64)
            position += 1
        }
        return true
    }

    fun return_local(mut self, asm: &mut x64::Asm, slot: u64) -> bool {
        count := self.result_cells
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot + cell))
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (16 + 8 * (self.argument_cells + count - 1 - cell)) as i64)
            cell += 1
        }
        return true
    }

    // Whether a parameter, a result or a field of an inlined function is one cell that holds a scalar, a reference or a raw
    // pointer. A string, a vector, a structure and an enum are not.
    fun inline_cell_type(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => width_of(word) > 0,
            ir::IrTy::ReferenceTo(target, mutable) => true,
            ir::IrTy::RawPointerTo(target) => true,
            _ => false,
        }
    }

    // The expression of a function whose body is one `return`, or `None`.
    fun return_expression(self, index: u64) -> Option<u64> {
        return choose self.program.stmts[index] {
            ir::IrStmt::ReturnStmt(value) => value,
            _ => Option::None,
        }
    }

    fun is_parameter(self, function: u64, slot: u64) -> bool {
        definition := self.program.functions[function]
        mut at: u64 = 0
        while at < definition.parameters.len() / 2 {
            when definition.parameters[at * 2] == slot {
                return true
            }
            at += 1
        }
        return false
    }

    // Whether a call of function `id` is inlined: a leaf whose body is one `return` of an expression over its parameters
    // (scalars, references or raw pointers), and that has no other local, no owned value and no address-taken local. Its
    // expression is generated at each call, so it is kept small, and it calls only the C functions it declares and the
    // `std::math` builtins, which take their operands from `expr` as well. Nothing in the body is a destructor or a
    // structure, so no drop, move or borrow of the callee needs a frame of its own.
    fun inline_function(mut self, id: u64, count: u64) -> bool {
        return self.inline_kind(id, count) != 0
    }

    // How a call of function `id` is inlined: 1 for a body that is one `return`, 2 for a small body of statements (`let`,
    // assignment, `if` and `return` of scalars, with every path ending in a `return`), 0 for no inlining.
    fun inline_kind(mut self, id: u64, count: u64) -> u64 {
        when self.inline_kinds.len() == 0 {
            mut at: u64 = 0
            while at < self.program.functions.len() {
                self.inline_kinds.push(9)
                at += 1
            }
        }
        when self.inline_kinds[id] != 9 {
            return self.inline_kinds[id]
        }
        mut kind: u64 = 0
        self.inline_nodes = 0
        self.inline_limit = 32
        self.inline_locals = false
        when self.inline_callee(id, count) {
            kind = 1
        } else when !self.no_opt && self.inline_statements_callee(id, count) {
            kind = 2
        }
        self.inline_kinds.set(id, kind)
        return kind
    }

    // The check of kind 2: scalar parameters (at most four) and locals (at most eight), no owned value and no address taken,
    // and a body of at most 40 nodes whose every path returns a scalar.
    fun inline_statements_callee(mut self, id: u64, count: u64) -> bool {
        definition := self.program.functions[id]
        when definition.external_symbol.is_some() || definition.return_type.is_none() || definition.statements.len() == 0 {
            return false
        }
        when definition.parameters.len() / 2 != count || count > 4 || definition.local_types.len() > 8 {
            return false
        }
        when !self.inline_cell_type(definition.return_type.unwrap()) {
            return false
        }
        mut at: u64 = 0
        while at < definition.parameters.len() / 2 {
            when !self.inline_cell_type(definition.parameters[at * 2 + 1]) {
                return false
            }
            at += 1
        }
        for owned in definition.owned_slot_types {
            when owned.is_some() {
                return false
            }
        }
        for addressed in definition.addressed_slot_types {
            when addressed.is_some() {
                return false
            }
        }
        self.inline_nodes = 0
        self.inline_limit = 40
        self.inline_locals = true
        ok := self.inline_statements_ok(definition.statements.clone(), id) && self.always_returns(definition.statements.clone())
        self.inline_locals = false
        self.inline_limit = 32
        return ok
    }

    fun inline_statements_ok(mut self, statements: Vec<u64>, function: u64) -> bool {
        for statement in statements {
            self.inline_nodes += 1
            ok := choose self.program.stmts[statement] {
                ir::IrStmt::LetStmt(slot, ty, value, span) => self.inline_cell_type(ty) && self.inline_ok(value, function),
                ir::IrStmt::AssignStmt(slot, ty, value, span) => self.inline_cell_type(ty) && self.inline_ok(value, function),
                ir::IrStmt::IfStmt(condition, then_body, else_body) => self.inline_ok(condition, function) && self.inline_statements_ok(then_body, function) && self.inline_statements_ok(else_body, function),
                ir::IrStmt::ReturnStmt(value) => value.is_some() && self.inline_ok(value.unwrap(), function),
                ir::IrStmt::DropStmt(slots, types) => slots.len() == 0,
                _ => false,
            }
            when !ok {
                return false
            }
        }
        return true
    }

    // Whether every path through a list of statements ends in a `return` of a value.
    fun always_returns(self, statements: Vec<u64>) -> bool {
        // A scope that ends drops nothing here, so the empty drops after the last statement do not count.
        mut last: u64 = statements.len()
        while last > 0 {
            empty_drop := choose self.program.stmts[statements[last - 1]] {
                ir::IrStmt::DropStmt(slots, types) => slots.len() == 0,
                _ => false,
            }
            when !empty_drop {
                break
            }
            last -= 1
        }
        when last == 0 {
            return false
        }
        return choose self.program.stmts[statements[last - 1]] {
            ir::IrStmt::ReturnStmt(value) => value.is_some(),
            ir::IrStmt::IfStmt(condition, then_body, else_body) => self.always_returns(then_body) && self.always_returns(else_body),
            _ => false,
        }
    }

    // The check of `inline_function` for function `id` and its body; a body that calls leaves is checked with them, and the
    // node count bounds the nesting, so a recursive call is never inlined.
    fun inline_callee(mut self, id: u64, count: u64) -> bool {
        definition := self.program.functions[id]
        when definition.external_symbol.is_some() || definition.return_type.is_none() || definition.statements.len() != 1 {
            return false
        }
        when definition.parameters.len() / 2 != count {
            return false
        }
        when !self.inline_cell_type(definition.return_type.unwrap()) {
            return false
        }
        when definition.local_types.len() != definition.parameters.len() / 2 {
            return false
        }
        mut at: u64 = 0
        while at < definition.parameters.len() / 2 {
            when !self.inline_cell_type(definition.parameters[at * 2 + 1]) {
                return false
            }
            at += 1
        }
        at = 0
        while at < definition.owned_slot_types.len() {
            when definition.owned_slot_types[at].is_some() {
                return false
            }
            at += 1
        }
        at = 0
        while at < definition.addressed_slot_types.len() {
            when definition.addressed_slot_types[at].is_some() {
                return false
            }
            at += 1
        }
        value := self.return_expression(definition.statements[0])
        when value.is_none() {
            return false
        }
        return self.inline_ok(value.unwrap(), id)
    }

    // Whether the expression `index` of the body of function `function` can be generated inside a caller: its operators and
    // builtins read their operands through `expr`, its locals are parameters, and it has at most 32 nodes.
    fun inline_ok(mut self, index: u64, function: u64) -> bool {
        self.inline_nodes += 1
        when self.inline_nodes > self.inline_limit {
            return false
        }
        return choose self.program.exprs[index] {
            ir::IrExpr::IntegerLit(text, ty) => true,
            ir::IrExpr::FloatLit(bits, ty) => true,
            ir::IrExpr::BoolLit(value) => true,
            ir::IrExpr::CharLit(scalar) => true,
            ir::IrExpr::LocalRef(slot, ty, span) => (self.is_parameter(function, slot) || (self.inline_locals && slot < self.program.functions[function].local_types.len())) && self.inline_cell_type(ty),
            ir::IrExpr::Binary(op, left, right, ty) => self.inline_ok(left, function) && self.inline_ok(right, function),
            ir::IrExpr::Negate(value, ty) => self.inline_ok(value, function),
            ir::IrExpr::Not(value) => self.inline_ok(value, function),
            ir::IrExpr::BitNot(value, ty) => self.inline_ok(value, function),
            ir::IrExpr::FfiArray(array, element, length, index, mutable) => false,
            ir::IrExpr::CastExpr(value, source, target) => self.inline_ok(value, function),
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => self.inline_ok(condition, function) && self.inline_ok(then_value, function) && self.inline_ok(else_value, function),
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => self.inline_cell_type(ty) && self.inline_ok(pointer, function),
            ir::IrExpr::CallExpr(target, arguments, ty) => self.inline_cell_type(ty) && self.inline_call(target, arguments, function),
            _ => false,
        }
    }

    // A call in a body: a `std::math` builtin, a C function of the program, or another inlinable leaf, whose body is checked
    // in its own parameters. The arguments are checked in the body's function.
    fun inline_call(mut self, target: ir::CallTarget, arguments: Vec<u64>, function: u64) -> bool {
        for argument in arguments.clone() {
            when !self.inline_ok(argument, function) {
                return false
            }
        }
        return choose target {
            ir::CallTarget::SystemOp(op) => op.starts_with("Math"),
            ir::CallTarget::Func(id) => self.inline_target_function(id, arguments.len()),
            _ => false,
        }
    }

    fun inline_target_function(mut self, id: u64, count: u64) -> bool {
        when self.program.functions[id].external_symbol.is_some() {
            return true
        }
        return self.inline_callee(id, count)
    }

    // Generates a call of an inlined function: each argument is evaluated in order into a scratch cell of the frame, and the
    // body is generated with its parameters read from those cells. Nothing is pushed or called, so the result is in rax, as
    // after a call. A repr(C) local whose address was given out is synchronised around the body, as around a call.
    fun call_inline(mut self, asm: &mut x64::Asm, id: u64, arguments: Vec<u64>) -> bool {
        definition := self.program.functions[id]
        value := self.return_expression(definition.statements[0]).unwrap()
        mut cells: Vec<u64> = Vec()
        for argument in arguments.clone() {
            cell := self.scratch(1)
            when !self.expr(asm, argument) {
                return false
            }
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(cell))
            cells.push(cell)
        }
        // The parameters go on the mapping, above those of an enclosing inlined body, which the body does not read.
        mapped := self.inline_slots.len()
        mut position: u64 = 0
        while position < cells.len() {
            self.inline_slots.push(definition.parameters[position * 2])
            self.inline_cells.push(cells[position])
            position += 1
        }
        was_active := self.inline_active
        self.inline_active = true
        when self.shadow_slots.len() > 0 {
            self.sync_shadows(asm, false)
        }
        when !self.expr(asm, value) {
            return false
        }
        when self.shadow_slots.len() > 0 {
            asm.push(x64::Reg::RAX)
            self.sync_shadows(asm, true)
            asm.pop(x64::Reg::RAX)
        }
        self.inline_active = was_active
        while self.inline_slots.len() > mapped {
            self.inline_slots.pop()
            self.inline_cells.pop()
        }
        return true
    }

    // A call of a function inlined as statements: the arguments go to scratch cells as for `call_inline`, every other local of
    // the body gets a scratch cell too, and the body is generated here with its `return`s jumping to the end, which leaves
    // the result in rax.
    fun call_inline_statements(mut self, asm: &mut x64::Asm, id: u64, arguments: Vec<u64>) -> bool {
        definition := self.program.functions[id]
        mut cells: Vec<u64> = Vec()
        for argument in arguments.clone() {
            cell := self.scratch(1)
            when !self.expr(asm, argument) {
                return false
            }
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(cell))
            cells.push(cell)
        }
        mapped := self.inline_slots.len()
        mut slot: u64 = 0
        while slot < definition.local_types.len() {
            mut cell: u64 = 0
            mut found: bool = false
            mut position: u64 = 0
            while position < cells.len() {
                when definition.parameters[position * 2] == slot {
                    cell = cells[position]
                    found = true
                }
                position += 1
            }
            when !found {
                cell = self.scratch(1)
            }
            self.inline_slots.push(slot)
            self.inline_cells.push(cell)
            slot += 1
        }
        was_active := self.inline_active
        self.inline_active = true
        exit := asm.new_label()
        self.inline_exits.push(exit)
        when self.shadow_slots.len() > 0 {
            self.sync_shadows(asm, false)
        }
        when !self.body(asm, definition.statements.clone()) {
            return false
        }
        asm.bind(exit)
        self.inline_exits.pop()
        when self.shadow_slots.len() > 0 {
            asm.push(x64::Reg::RAX)
            self.sync_shadows(asm, true)
            asm.pop(x64::Reg::RAX)
        }
        self.inline_active = was_active
        while self.inline_slots.len() > mapped {
            self.inline_slots.pop()
            self.inline_cells.pop()
        }
        return true
    }

    // The frame cell that statement `slot` of the code being generated writes: a local of the function, or, in a body that is
    // inlined as statements, the scratch cell of that local.
    fun stmt_slot(self, slot: u64) -> u64 {
        when self.inline_exits.len() > 0 {
            found := self.frame_slot(slot)
            when found.is_some() {
                return found.unwrap()
            }
        }
        return slot
    }

    // Calls function `id` with the arguments, which are pushed in order and then loaded into the argument registers
    // from the last. The result is in rax, or for a string or structure, on the stack in the order of a pushed value.
    // Whether the arguments of calls of function `id` travel in registers (rdi, rsi, rdx, rcx, r8, r9, in order), not on
    // the stack: at most six parameters, each one cell, and a result that is not a string or structure (which the callee
    // writes above the stack arguments). The float helpers of the runtime are called from generated code that pushes.
    fun reg_args(self, id: u64) -> bool {
        when self.no_opt || id == self.native_float_format || id == self.native_float_parse {
            return false
        }
        definition := self.program.functions[id]
        count := definition.parameters.len() / 2
        when definition.external_symbol.is_some() || count == 0 || count > 6 {
            return false
        }
        when definition.return_type.is_some() && self.aggregate_cells(definition.return_type.unwrap()) > 0 {
            return false
        }
        mut pair: u64 = 0
        while pair < count {
            ty := definition.parameters[pair * 2 + 1]
            when self.cells_of(ty) != 1 || !self.is_cell(ty) || self.is_handle_struct(ty) {
                return false
            }
            pair += 1
        }
        return true
    }

    // A call of a function that takes its arguments in registers: each is evaluated in order, the last one stays in rax, and
    // the others are popped into their registers just before the call. Nothing is left on the stack.
    fun call_in_registers(mut self, asm: &mut x64::Asm, id: u64, arguments: Vec<u64>) -> bool {
        count := arguments.len()
        last_in_rax := self.shadow_slots.len() == 0
        // An argument that is a constant, a local, or a register local plus a constant is loaded straight into its register
        // after the others are computed: it has no effect and nothing changes it, so it need not wait on the stack.
        mut last_complex: u64 = count
        mut position: u64 = 0
        while position < count {
            when !self.is_simple_argument(arguments[position]) {
                last_complex = position
            }
            position += 1
        }
        position = 0
        while position < count {
            when !self.is_simple_argument(arguments[position]) {
                when !self.expr(asm, arguments[position]) {
                    return false
                }
                when position != last_complex || !last_in_rax {
                    asm.push(x64::Reg::RAX)
                }
            }
            position += 1
        }
        // A `repr(C)` local whose address was given out is kept in its C layout by a copy, packed before the call.
        when self.shadow_slots.len() > 0 {
            self.sync_shadows(asm, false)
        }
        mut at: u64 = count
        while at > 0 {
            at -= 1
            when !self.is_simple_argument(arguments[at]) {
                when at == last_complex && last_in_rax {
                    asm.mov_rr(arg_register(at), x64::Reg::RAX)
                } else {
                    asm.pop(arg_register(at))
                }
            }
        }
        position = 0
        while position < count {
            when self.is_simple_argument(arguments[position]) {
                self.load_simple_argument(asm, arguments[position], arg_register(position))
            }
            position += 1
        }
        asm.call_label(self.labels[id])
        when self.shadow_slots.len() > 0 {
            asm.push(x64::Reg::RAX)
            self.sync_shadows(asm, true)
            asm.pop(x64::Reg::RAX)
        }
        return true
    }

    // `register + constant` or `register - constant` for a 64-bit local in a register: the offset to add.
    fun register_offset(mut self, index: u64) -> Option<i64> {
        when self.no_opt {
            return Option::None
        }
        plain := choose self.program.exprs[index] {
            ir::IrExpr::Binary(op, left, right, ty) => (op == "Add" || op == "Sub") && self.value_width(ty) == 8 && is_integer_word(self.word(ty)),
            _ => false,
        }
        when !plain {
            return Option::None
        }
        name := choose self.program.exprs[index] {
            ir::IrExpr::Binary(op, left, right, ty) => op,
            _ => String(""),
        }
        left := choose self.program.exprs[index] {
            ir::IrExpr::Binary(op, left, right, ty) => left,
            _ => 0,
        }
        right := choose self.program.exprs[index] {
            ir::IrExpr::Binary(op, left, right, ty) => right,
            _ => 0,
        }
        when self.operand_reg(left) == 0 {
            return Option::None
        }
        immediate := self.immediate_operand(name.clone(), right)
        when immediate.is_none() || (immediate.unwrap() as i64) <= (0 as i64) - 2147483647 {
            return Option::None
        }
        mut offset := immediate.unwrap() as i64
        when name == "Sub" {
            offset = (0 as i64) - offset
        }
        return Option::Some(offset)
    }

    fun is_simple_argument(mut self, index: u64) -> bool {
        return self.is_stable_operand(index) || self.register_offset(index).is_some()
    }

    // Reads a simple argument (see `is_simple_argument`) into `reg`.
    fun load_simple_argument(mut self, asm: &mut x64::Asm, index: u64, reg: u64) {
        offset := self.register_offset(index)
        when offset.is_some() {
            left := choose self.program.exprs[index] {
                ir::IrExpr::Binary(op, left, right, ty) => left,
                _ => 0,
            }
            asm.lea(reg, self.operand_reg(left), offset.unwrap())
            return
        }
        self.load_stable_operand(asm, index, reg)
    }

    fun call(mut self, asm: &mut x64::Asm, id: u64, arguments: Vec<u64>) -> bool {
        // A leaf function is inlined: its body is generated here, so the function itself is not generated for this call.
        when self.in_function {
            kind := self.inline_kind(id, arguments.len())
            when kind == 1 {
                return self.call_inline(asm, id, arguments)
            }
            when kind == 2 {
                return self.call_inline_statements(asm, id, arguments)
            }
        }
        self.needed.set(id, true)
        callee := self.program.functions[id]
        when callee.external_symbol.is_some() {
            return self.call_foreign(asm, callee.parameters.clone(), callee.return_type, callee.external_symbol.unwrap(), arguments)
        }
        when arguments.len() != callee.parameters.len() / 2 {
            return self.fail("a call with another number of arguments")
        }
        when self.reg_args(id) {
            return self.call_in_registers(asm, id, arguments)
        }
        // A string or structure result gets its cells first, above the arguments, where the callee writes them.
        mut reserved: u64 = 0
        when callee.return_type.is_some() {
            reserved = self.aggregate_cells(callee.return_type.unwrap())
        }
        when reserved > 0 {
            asm.alu_ri(5, x64::Reg::RSP, (8 * reserved) as i64)
        }
        // Each argument is pushed as its cells, in order: a scalar is one cell, and a structure local is the cells it
        // occupies. The callee reads them from the stack, and the caller removes them after the call.
        mut total: u64 = 0
        mut position: u64 = 0
        for argument in arguments.clone() {
            ty := callee.parameters[position * 2 + 1]
            cells := self.cells_of(ty)
            when cells == 0 {
                return self.fail("an argument of this type")
            }
            when !self.push_value(asm, argument, ty) {
                return false
            }
            total += cells
            position += 1
        }
        // A `repr(C)` local whose address was given out is kept in its C layout by a copy: the callee may write through the
        // address, so the copies are packed before the call and read back after it.
        when self.shadow_slots.len() > 0 {
            self.sync_shadows(asm, false)
        }
        asm.call_label(self.labels[id])
        when self.shadow_slots.len() > 0 {
            asm.push(x64::Reg::RAX)
            self.sync_shadows(asm, true)
            asm.pop(x64::Reg::RAX)
        }
        asm.alu_ri(0, x64::Reg::RSP, (total * 8) as i64)
        return true
    }

    // A call statement: a string or structure result that the call left on the stack is removed, since nothing reads it.
    fun call_for_effect(mut self, asm: &mut x64::Asm, id: u64, arguments: Vec<u64>) -> bool {
        when !self.call(asm, id, arguments) {
            return false
        }
        callee := self.program.functions[id]
        when callee.return_type.is_some() && self.has_owners(callee.return_type.unwrap()) {
            self.drop_pushed(asm, callee.return_type.unwrap())
            return true
        }
        mut discarded: u64 = 0
        when callee.return_type.is_some() {
            discarded = self.aggregate_cells(callee.return_type.unwrap())
        }
        when discarded > 0 {
            asm.alu_ri(0, x64::Reg::RSP, (8 * discarded) as i64)
        }
        return true
    }

    // A call in an expression that yields one cell. A string or structure result is not one: the code that stores or
    // pushes it reads it from the stack.
    fun call_value(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>, ty: u64) -> bool {
        when self.aggregate_cells(ty) > 0 {
            return self.fail("a structure value")
        }
        return self.call_expression(asm, target, arguments)
    }

    // Stores a string or structure result, which the call leaves on the stack, into the cells from `base` on, and removes
    // it from the stack.
    fun call_into(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>, base: u64, count: u64) -> bool {
        when !self.call_expression(asm, target, arguments) {
            return false
        }
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + cell))
            cell += 1
        }
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    // A cell of a structure that a call returns: it is read from the pushed result, which is then removed.
    // `vector[index].field`: a field of an element of a vector is read where the element lies, after the index is checked; only
    // the field is copied (an owner is cloned). The element itself is not copied and dropped around the read, which cost a
    // copy of everything it owns for every field read. Any other call result is pushed and its field taken.
    fun call_or_element_field(mut self, asm: &mut x64::Asm, call: u64, target: ir::CallTarget, arguments: Vec<u64>, id: u64, field: u64, ty: u64) -> bool {
        element := self.vec_element_of_call(call)
        when element != 0 && self.element_field_in_place(id, field, ty) && self.vec_in_place(arguments[0]) {
            self.lend_argument(arguments[0])
            return self.vec_field_read(asm, element - 1, arguments[0], arguments[1], id, field, ty, self.lent[call])
        }
        return self.call_field(asm, target, arguments, id, field, ty)
    }

    // Whether a field read of a vector element is done in place: the field is one cell that is a scalar, or an owner that
    // a copy routine clones, and the structure is not `repr(C)`.
    fun element_field_in_place(mut self, id: u64, field: u64, ty: u64) -> bool {
        when self.no_opt || self.program.structs[id].repr_c || !self.is_cell(ty) || self.is_handle_struct(ty) {
            return false
        }
        when !self.has_owners(ty) {
            return true
        }
        owned := self.owned_cells(ty)
        return owned.is_some() && owned.unwrap().len() == 3
    }

    // Whether the vector expression `vec` is read as its handle, with no clone to drop: a local, a field that a reference
    // lends or that holds no owner, a field of a local, or a field of an element that is itself read in place.
    fun vec_in_place(mut self, vec: u64) -> bool {
        return choose self.program.exprs[vec] {
            ir::IrExpr::LocalRef(slot, ty, span) => true,
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => borrowed || !self.has_owners(ty),
            ir::IrExpr::FieldRead(inner, id, field, ty, span) => self.field_vec_in_place(inner, id, field, ty),
            _ => false,
        }
    }

    fun field_vec_in_place(mut self, inner: u64, id: u64, field: u64, ty: u64) -> bool {
        local := choose self.program.exprs[inner] {
            ir::IrExpr::LocalRef(slot, lty, span) => true,
            _ => false,
        }
        when local {
            return true
        }
        arguments := self.element_call_arguments(inner)
        when arguments.len() != 2 {
            return false
        }
        return self.vec_element_of_call(inner) != 0 && self.element_field_in_place(id, field, ty) && self.vec_in_place(arguments[0])
    }

    // The arguments of a call `vector[index]`; empty for any other expression.
    fun element_call_arguments(self, call: u64) -> Vec<u64> {
        return choose self.program.exprs[call] {
            ir::IrExpr::CallExpr(target, arguments, cty) => self.index_arguments(target, arguments),
            _ => Vec(),
        }
    }

    fun index_arguments(self, target: ir::CallTarget, arguments: Vec<u64>) -> Vec<u64> {
        return choose target {
            ir::CallTarget::VecOp(op, element) => self.index_operands(op, arguments),
            _ => Vec(),
        }
    }

    fun index_operands(self, op: String, arguments: Vec<u64>) -> Vec<u64> {
        when op == "Index" && arguments.len() == 2 {
            return arguments
        }
        return Vec()
    }

    // The element type (plus one) of a read `vector[index]` of a vector without effects, which can be read in place; 0 for
    // any other expression.
    fun vec_element_of_call(self, call: u64) -> u64 {
        return choose self.program.exprs[call] {
            ir::IrExpr::CallExpr(target, arguments, cty) => self.vec_element_of_target(target, arguments),
            _ => 0,
        }
    }

    fun vec_element_of_target(self, target: ir::CallTarget, arguments: Vec<u64>) -> u64 {
        return choose target {
            ir::CallTarget::VecOp(op, element) => if_text_id(op == "Index" && arguments.len() == 2 && self.is_pure(arguments[0]), element),
            _ => 0,
        }
    }

    // The address of element `index` of the vector `vec` (the address of its lowest cell), in rax, after the bounds check.
    fun vec_element_address(mut self, asm: &mut x64::Asm, element: u64, vec: u64, index: u64) -> bool {
        cells := self.cells_of(element)
        when !self.expr(asm, vec) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, index) {
            return false
        }
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        when !self.bce_proved(vec, index) {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
            asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        }
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        self.scale_bytes(asm, x64::Reg::RAX, 8 * cells)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        return true
    }

    fun vec_field_read(mut self, asm: &mut x64::Asm, element: u64, vec: u64, index: u64, id: u64, field: u64, ty: u64, lent: bool) -> bool {
        when !self.vec_element_address(asm, element, vec, index) {
            return false
        }
        when lent || !self.has_owners(ty) {
            return self.load_cell(asm, ty, x64::Reg::RAX, self.field_displacement(id, field))
        }
        copies := self.owned_cells(ty).unwrap()
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RAX, self.field_displacement(id, field))
        asm.call_label(self.copy_routine(asm, copies[1], copies[2]))
        return true
    }

    fun call_field(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>, id: u64, field: u64, ty: u64) -> bool {
        when self.program.structs[id].drop_function.is_some() {
            return self.fail("a field of a temporary destructor")
        }
        when !self.call_expression(asm, target, arguments) {
            return false
        }
        count := self.program.structs[id].slot_count
        when !self.load_cell(asm, ty, x64::Reg::RSP, self.pushed_field_disp(id, field)) {
            return false
        }
        self.drop_field_remainder(asm, id, self.pushed_field_disp(id, field), ty)
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    // The data and length of a string expression (a literal, a str local, or a String local), in rsi and rdx.
    // A String or `str` field, read where it lies: in a local's frame, or in memory at the address of the field.
    fun load_field_string(mut self, asm: &mut x64::Asm, index: u64, ty: u64) -> bool {
        place := self.place_of(index)
        when place.is_some() {
            return self.load_string_local(asm, place.unwrap(), ty)
        }
        when !self.is_memory_place(index) {
            return self.fail("a string field that is not in a local or in memory")
        }
        // A `str` field through a reference is not in the subset of the reference compiler, so it is not read here.
        when self.is_str(ty) {
            return self.fail("a str field through a reference")
        }
        when !self.memory_address(asm, index) {
            return false
        }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
        return true
    }

    // A String used as a str: the data and length of its header, which the expression `inner` gives, are pushed, the
    // pointer first.
    fun push_string_as_str(mut self, asm: &mut x64::Asm, inner: u64) -> bool {
        when !self.expr(asm, inner) {
            return false
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.push(x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.push(x64::Reg::RCX)
        return true
    }

    // A String used as a str: its data and length are in rsi and rdx.
    fun load_string_as_str(mut self, asm: &mut x64::Asm, inner: u64) -> bool {
        when !self.expr(asm, inner) {
            return false
        }
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
        return true
    }

    // A `str` field of a local, pushed as its two cells, the pointer first.
    fun push_field_str(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        place := self.place_of(index)
        when place.is_some() {
            return self.push_local_cells(asm, place.unwrap(), 2)
        }
        return self.fail("a str field through a reference")
    }

    // A `str` field of a local stored into the cells from `base` on.
    fun store_field_str(mut self, asm: &mut x64::Asm, index: u64, base: u64) -> bool {
        place := self.place_of(index)
        when place.is_some() {
            return self.copy_cells(asm, place.unwrap(), base, 2)
        }
        return self.fail("a str field through a reference")
    }

    fun load_string_parts(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        when self.string_literal(index).is_some() {
            literal := self.literal(self.string_literal(index).unwrap())
            asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[literal])
            asm.mov_ri(x64::Reg::RDX, self.literal_lengths[literal])
            return true
        }
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => self.load_string_local(asm, slot, ty),
            ir::IrExpr::MoveRef(slot, ty) => self.moved_string_parts(asm, index, slot, ty),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_string_parts(asm, index, cty),
            ir::IrExpr::FieldRead(value, id, field, fty, span) => self.load_field_string(asm, index, fty),
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, fty, span, borrowed) => self.load_field_string(asm, index, fty),
            ir::IrExpr::StringAsStr(inner) => self.load_string_as_str(asm, inner),
            ir::IrExpr::ArrayIndex(array, aindex, aty, length) => self.load_element_str(asm, array, aindex, aty, length),
            // A String read through a `&mut String` receiver: its handle is loaded from the reference's home.
            ir::IrExpr::Dereference(pointer, dty) => self.call_string_parts(asm, index, dty),
            _ => self.fail("a string argument that is not a literal or a local"),
        }
    }

    // A `str` element of a local array: its cells are read where the element lies, the pointer above the length.
    fun load_element_str(mut self, asm: &mut x64::Asm, array: u64, index: u64, element: u64, length: u64) -> bool {
        when !self.is_str(element) || self.array_local_of(array).is_none() {
            return self.fail("a str element of this array")
        }
        when !self.array_element_address(asm, array, index, element, length) {
            return false
        }
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 0)
        return true
    }

    // The data and length of a `str` that a call returns: its cells are on the stack, the length on top.
    fun str_call_parts(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>) -> bool {
        when !self.call_expression(asm, target, arguments) {
            return false
        }
        asm.pop(x64::Reg::RDX)
        asm.pop(x64::Reg::RSI)
        return true
    }

    // The data and length of a String that a call returns, read through its header.
    fun call_string_parts(mut self, asm: &mut x64::Asm, index: u64, ty: u64) -> bool {
        when self.is_str(ty) {
            return choose self.program.exprs[index] {
                ir::IrExpr::CallExpr(target, arguments, cty) => self.str_call_parts(asm, target, arguments),
                _ => self.fail("a string argument that is not a literal or a local"),
            }
        }
        when !self.is_string(ty) {
            return self.fail("a string argument that is not a literal or a local")
        }
        when !self.expr(asm, index) {
            return false
        }
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
        return true
    }

    fun moved_string_parts(mut self, asm: &mut x64::Asm, index: u64, slot: u64, ty: u64) -> bool {
        when self.is_str(ty) { return self.load_string_local(asm, slot, ty) }
        when !self.expr(asm, index) { return false }
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
        return true
    }

    fun load_string_local(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        when self.is_str(ty) {
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, slot_disp(slot))
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(slot + 1))
            return true
        }
        when self.is_string(ty) {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
            return true
        }
        return self.fail("a string of this type")
    }

    // `len()` is the byte length, and `char_count()` counts the bytes that begin a character (not continuation bytes).
    fun string_query(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        when arguments.len() != 1 {
            return self.op_fail("a string operation ", op)
        }
        when !self.load_string_parts(asm, arguments[0]) {
            return false
        }
        when op == "Len" {
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
            return true
        }
        // rsi walks the bytes up to rdi; rcx counts the character starts.
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RDX)
        asm.mov_ri(x64::Reg::RCX, 0)
        top := asm.new_label()
        skip := asm.new_label()
        done := asm.new_label()
        asm.bind(top)
        asm.alu_rr(57, x64::Reg::RSI, x64::Reg::RDI)
        asm.jcc(x64::Cc::EQUAL, done)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::RSI, 0)
        asm.alu_ri(4, x64::Reg::RAX, 192)
        asm.alu_ri(7, x64::Reg::RAX, 128)
        asm.jcc(x64::Cc::EQUAL, skip)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.bind(skip)
        asm.alu_ri(0, x64::Reg::RSI, 1)
        asm.jmp(top)
        asm.bind(done)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        return true
    }

    // The operations on a vector of destructor values: they are moved in, counted, and dropped by `clear` and by the owner.
    fun vec_of_destructors(mut self, asm: &mut x64::Asm, op: String, element: u64, arguments: Vec<u64>) -> bool {
        when op == "New" && arguments.len() == 0 {
            return self.vec_new(asm)
        }
        when op == "Push" && arguments.len() == 2 {
            return self.vec_push(asm, element, arguments[0], arguments[1])
        }
        when (op == "Len" || op == "IsEmpty") && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 8)
            when op == "IsEmpty" {
                asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
                asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            }
            return true
        }
        when op == "Clear" && arguments.len() == 1 {
            cells := self.cells_of(element)
            when !self.expr(asm, arguments[0]) {
                return false
            }
            label := self.glue_routine(asm, 0, element)
            asm.push(x64::Reg::RAX)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.call_label(label)
            asm.pop(x64::Reg::RAX)
            asm.mov_ri(x64::Reg::RCX, 0)
            asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
            return true
        }
        // `set` drops the element it replaces, before the new one is stored; `take` moves the element out, with no drop.
        when op == "Set" && arguments.len() == 3 {
            return self.vec_set(asm, element, arguments[0], arguments[1], arguments[2])
        }
        when op == "Take" && arguments.len() == 2 {
            return self.vec_take(asm, element, arguments[0], arguments[1])
        }
        return self.op_fail("a vector of destructor values and ", op)
    }

    // A vector operation. An element takes `cells_of` cells, eight bytes each, laid out as the cells of a pushed value
    // (the first cell highest), so a structure element is one block that is copied whole. A vector of scalars or Strings
    // is one array of cells. The header is {data, len, capacity}, with the data from malloc and grown by realloc.
    fun vec_op(mut self, asm: &mut x64::Asm, op: String, element: u64, arguments: Vec<u64>) -> bool {
        when self.destructor_element(element) {
            return self.vec_of_destructors(asm, op, element, arguments)
        }
        when !self.is_cell(element) && !self.is_plain_structure(element) {
            return self.fail("a vector of this element type")
        }
        when op == "New" && arguments.len() == 0 {
            return self.vec_new(asm)
        }
        when op == "Len" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 8)
            return true
        }
        when op == "IsEmpty" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 8)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            return true
        }
        when op == "Push" && arguments.len() == 2 {
            return self.vec_push(asm, element, arguments[0], arguments[1])
        }
        when op == "Index" && arguments.len() == 2 {
            return self.vec_index(asm, element, arguments[0], arguments[1])
        }
        when op == "Capacity" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 16)
            return true
        }
        when op == "Clear" && arguments.len() == 1 {
            cells := self.cells_of(element)
            when !self.expr(asm, arguments[0]) {
                return false
            }
            when self.has_owners(element) {
                asm.push(x64::Reg::RAX)
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 8)
                asm.push(x64::Reg::RCX)
                top := asm.new_label()
                done := asm.new_label()
                asm.bind(top)
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
                asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
                asm.jcc(x64::Cc::EQUAL, done)
                asm.alu_ri(5, x64::Reg::RCX, 1)
                asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 0)
                asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 8)
                asm.load(8, false, x64::Reg::RDI, x64::Reg::RAX, 0)
                self.scale_bytes(asm, x64::Reg::RCX, 8 * cells)
                asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RCX)
                asm.alu_ri(0, x64::Reg::RDI, (8 * (cells - 1)) as i64)
                asm.call_label(self.value_drop_routine(asm, element, false))
                asm.jmp(top)
                asm.bind(done)
                asm.alu_ri(0, x64::Reg::RSP, 8)
                asm.pop(x64::Reg::RAX)
            }
            asm.mov_ri(x64::Reg::RCX, 0)
            asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
            return true
        }
        when op == "Clone" && arguments.len() == 1 {
            return self.vec_clone(asm, element, arguments[0])
        }
        when op == "Reverse" && arguments.len() == 1 {
            return self.vec_reverse(asm, element, arguments[0])
        }
        when op == "Sort" && arguments.len() == 1 {
            when !self.is_cell(element) {
                return self.fail("a sort of structures")
            }
            return self.vec_sort(asm, element, arguments[0])
        }
        when op == "Contains" && arguments.len() == 2 {
            when !self.is_cell(element) {
                return self.fail("a search of structures")
            }
            return self.vec_contains(asm, element, arguments[0], arguments[1])
        }
        when op == "Set" && arguments.len() == 3 {
            return self.vec_set(asm, element, arguments[0], arguments[1], arguments[2])
        }
        when op == "Take" && arguments.len() == 2 {
            return self.vec_take(asm, element, arguments[0], arguments[1])
        }
        when op == "Insert" && arguments.len() == 3 {
            return self.vec_insert(asm, element, arguments[0], arguments[1], arguments[2])
        }
        return self.op_fail("a vector operation ", op)
    }

    // A vector operation as a statement. An Index or Take of a structure leaves its cells on the stack, which nothing reads.
    fun vec_statement(mut self, asm: &mut x64::Asm, op: String, element: u64, arguments: Vec<u64>) -> bool {
        discards := (op == "Index" || op == "Take") && !self.is_cell(element)
        // A taken destructor value that nothing names is dropped at the end of its statement, as a named one is.
        drops := op == "Take" && self.destructor_element(element)
        cells := self.cells_of(element)
        when !self.vec_op(asm, op, element, arguments) {
            return false
        }
        when discards && drops {
            self.drop_pushed(asm, element)
            return true
        }
        when discards {
            asm.alu_ri(0, x64::Reg::RSP, (8 * cells) as i64)
        }
        return true
    }

    // Whether a structure can be an element: a destructor would have to run for each element, which a vector does not do.
    fun is_plain_structure(self, ty: u64) -> bool {
        when self.has_destructor(ty) {
            return false
        }
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.program.structs[id].slot_count > 0,
            _ => false,
        }
    }

    // The owned cells of a value of type `ty` in memory, as triples: the offset of the cell from the start of the value, a
    // code (1 for a String, 2 for a vector) and the type (the String, or the element type of the vector). None when the value
    // owns something a clone does not copy: a map or a set, an enum whose payloads own memory, or a vector of such.
    fun owned_cells(self, ty: u64) -> Option<Vec<u64>> {
        when self.has_destructor(ty) { return Option::None }
        mut cells: Vec<u64> = Vec()
        when self.is_string(ty) {
            cells.push(0)
            cells.push(1)
            cells.push(ty)
            return Option::Some(cells)
        }
        element := choose self.program.types[ty] {
            ir::IrTy::VecOf(e) => Option::Some(e),
            _ => Option::None,
        }
        when element.is_some() {
            when self.owned_cells(element.unwrap()).is_none() {
                return Option::None
            }
            cells.push(0)
            cells.push(2)
            cells.push(element.unwrap())
            return Option::Some(cells)
        }
        when self.is_map_or_set(ty) {
            key := choose self.program.types[ty] { ir::IrTy::MapOf(k, v) => k, ir::IrTy::SetOf(k, v) => k, _ => 0 }
            value := choose self.program.types[ty] { ir::IrTy::MapOf(k, v) => v, ir::IrTy::SetOf(k, v) => v, _ => 0 }
            when !self.map_cell(key) || !self.map_cell(value) || self.is_handle_struct(key) || self.is_handle_struct(value) {
                return Option::None
            }
            cells.push(0)
            cells.push(4)
            cells.push(ty)
            return Option::Some(cells)
        }
        enum_id := choose self.program.types[ty] {
            ir::IrTy::EnumTy(id) => Option::Some(id),
            _ => Option::None,
        }
        when enum_id.is_some() {
            owned := self.enum_owned_fields(enum_id.unwrap())
            when owned.is_none() {
                return Option::None
            }
            // An enum is always a box of its own, so a copy always makes a new one.
            cells.push(0)
            cells.push(3)
            cells.push(ty)
            return Option::Some(cells)
        }
        // An array's elements lie in memory from its start, `8 * cells` apart, and each element's owners are at their offsets.
        array_element := choose self.program.types[ty] {
            ir::IrTy::ArrayOf(e, n) => Option::Some(e),
            _ => Option::None,
        }
        when array_element.is_some() {
            inner := self.owned_cells(array_element.unwrap())
            when inner.is_none() {
                return Option::None
            }
            list := inner.unwrap()
            each := self.cells_of(array_element.unwrap())
            count := self.array_length_of(ty)
            mut index: u64 = 0
            while index < count {
                mut at: u64 = 0
                while at < list.len() {
                    cells.push(8 * each * index + list[at])
                    cells.push(list[at + 1])
                    cells.push(list[at + 2])
                    at += 3
                }
                index += 1
            }
            return Option::Some(cells)
        }
        structure := choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => Option::Some(id),
            _ => Option::None,
        }
        when structure.is_none() {
            return Option::Some(cells)
        }
        id := structure.unwrap()
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            inner := self.owned_cells(self.program.structs[id].fields[position].ty)
            when inner.is_none() {
                return Option::None
            }
            base := self.sub_displacement(id, position) as u64
            list := inner.unwrap()
            mut at: u64 = 0
            while at < list.len() {
                cells.push(base + list[at])
                cells.push(list[at + 1])
                cells.push(list[at + 2])
                at += 3
            }
            position += 1
        }
        return Option::Some(cells)
    }

    fun is_map_or_set(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::MapOf(a, b) => true,
            ir::IrTy::SetOf(a, b) => true,
            _ => false,
        }
    }

    // The owned payload fields of an enum, as quadruples: the variant, the byte offset in the box, the code (1 String, 2 vector,
    // 3 enum) and the type. None when a payload owns something this backend cannot copy (more than a cell, a map).
    fun enum_owned_fields(self, id: u64) -> Option<Vec<u64>> {
        mut list: Vec<u64> = Vec()
        mut variant: u64 = 0
        while variant < self.program.enums[id].variants.len() {
            fields := self.program.enums[id].variants[variant].fields.clone()
            mut field: u64 = 0
            while field < fields.len() {
                inner := self.owned_cells(fields[field])
                when inner.is_none() {
                    return Option::None
                }
                owned := inner.unwrap()
                mut at: u64 = 0
                while at < owned.len() {
                    // Stack/element offsets run backwards; enum payload cells run forwards.
                    list.push(variant)
                    list.push(8 * (self.enum_field_offset(id, variant, field) + self.cells_of(fields[field])) - owned[at])
                    list.push(owned[at + 1])
                    list.push(owned[at + 2])
                    at += 3
                }
                field += 1
            }
            variant += 1
        }
        return Option::Some(list)
    }

    fun enum_id_of(self, ty: u64) -> u64 {
        return choose self.program.types[ty] {
            ir::IrTy::EnumTy(id) => id,
            _ => 0,
        }
    }

    // The label of the routine that copies an enum value whose payloads own memory.
    fun enum_routine(mut self, asm: &mut x64::Asm, id: u64) -> u64 {
        mut at: u64 = 0
        while at < self.enum_clone_ids.len() {
            when self.enum_clone_ids[at] == id {
                return self.enum_clone_labels[at]
            }
            at += 1
        }
        label := asm.new_label()
        self.enum_clone_ids.push(id)
        self.enum_clone_labels.push(label)
        return label
    }

    // The routine that copies the enum value (a box) in rdi: the box is copied by variant, and each owned payload in the copy
    // is replaced by its own copy. The new box is left in rax.
    fun emit_enum_clone(mut self, asm: &mut x64::Asm, id: u64) -> bool {
        owned := self.enum_owned_fields(id)
        when owned.is_none() {
            return self.fail("a copy of an enum with this payload")
        }
        list := owned.unwrap()
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.push(x64::Reg::RDI)
        asm.push(x64::Reg::RDI)
        done := asm.new_label()
        mut variant: u64 = 0
        while variant < self.program.enums[id].variants.len() {
            next := asm.new_label()
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 8)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
            asm.alu_ri(7, x64::Reg::RCX, variant as i64)
            asm.jcc(x64::Cc::NOT_EQUAL, next)
            fields := self.program.enums[id].variants[variant].fields.clone()
            mut cells: u64 = 0
            for field in fields.clone() {
                cells += self.cells_of(field)
            }
            asm.mov_ri(x64::Reg::RDI, 8 * (1 + cells))
            self.aligned_call(asm, String("malloc"))
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
            mut cell: u64 = 0
            while cell < 1 + cells {
                asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 8)
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, (8 * cell) as i64)
                asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
                asm.store(8, x64::Reg::RCX, x64::Reg::RAX, (8 * cell) as i64)
                cell += 1
            }
            mut at: u64 = 0
            while at < list.len() {
                when list[at] == variant {
                    target := self.copy_routine(asm, list[at + 2], list[at + 3])
                    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
                    asm.load(8, false, x64::Reg::RDI, x64::Reg::RAX, list[at + 1] as i64)
                    asm.call_label(target)
                    asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 16)
                    asm.store(8, x64::Reg::RAX, x64::Reg::RDX, list[at + 1] as i64)
                }
                at += 4
            }
            asm.jmp(done)
            asm.bind(next)
            variant += 1
        }
        asm.bind(done)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
        return true
    }

    // Whether no payload of the enum owns memory, so that a copy of the enum may share its box: a box is never changed or
    // freed, and the payloads are not moved out of an element.
    fun enum_payloads_own_nothing(self, id: u64) -> bool {
        mut variant: u64 = 0
        while variant < self.program.enums[id].variants.len() {
            fields := self.program.enums[id].variants[variant].fields.clone()
            mut field: u64 = 0
            while field < fields.len() {
                inner := self.owned_cells(fields[field])
                when inner.is_none() {
                    return false
                }
                when inner.unwrap().len() > 0 {
                    return false
                }
                field += 1
            }
            variant += 1
        }
        return true
    }

    // `reg *= bytes`: the byte offset of an element, through r11.
    fun scale_bytes(self, asm: &mut x64::Asm, reg: u64, bytes: u64) {
        when !self.no_opt && bytes > 0 && bytes % 2 == 0 || bytes == 1 {
            // A power of two is a shift; the loop finds its exponent.
            mut power: u64 = 1
            mut exponent: u64 = 0
            while power < bytes {
                power = power * 2
                exponent += 1
            }
            when power == bytes && !self.no_opt {
                when exponent > 0 {
                    asm.shift_ri(4, reg, exponent)
                }
                return
            }
        }
        asm.mov_ri(x64::Reg::R11, bytes)
        asm.imul_rr(reg, x64::Reg::R11)
    }

    // Copies `count` cells from the memory at `source` to the memory at `target`, both addresses in registers, through rax.
    // The cells of an element keep their order in memory, so the copy is word for word.
    fun copy_block(self, asm: &mut x64::Asm, source: u64, target: u64, count: u64) {
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, source, (8 * cell) as i64)
            asm.store(8, x64::Reg::RAX, target, (8 * cell) as i64)
            cell += 1
        }
    }

    // `clone` of a vector: the header is passed to the routine that clones a vector of this element type.
    fun vec_clone(mut self, asm: &mut x64::Asm, element: u64, vec: u64) -> bool {
        when self.owned_cells(element).is_none() {
            return self.fail("a vector clone of owned elements")
        }
        when !self.expr(asm, vec) {
            return false
        }
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        label := self.vec_routine(asm, element)
        asm.call_label(label)
        return true
    }

    // The label of the routine that clones a vector whose element type is `element`: the header in rdi, the copy in rax. The
    // routine is made once, after the functions, by `emit_vec_routines`, which may ask for more.
    fun vec_routine(mut self, asm: &mut x64::Asm, element: u64) -> u64 {
        mut position: u64 = 0
        while position < self.vec_routine_elements.len() {
            when self.vec_routine_elements[position] == element {
                return self.vec_routine_labels[position]
            }
            position += 1
        }
        label := asm.new_label()
        self.vec_routine_elements.push(element)
        self.vec_routine_labels.push(label)
        return label
    }

    // The routines of the vector clones that were asked for.
    fun emit_vec_routines(mut self, asm: &mut x64::Asm) -> bool {
        // A routine may ask for others (a vector of enums asks for the enum's copy, which asks for a vector's), so the three
        // lists are walked together until none has a routine left that is not written. The walk goes on from where the last
        // pass stopped: the passes of `build_listing` may add routines.
        mut progress: bool = true
        while progress {
            progress = false
            while self.enum_clone_done < self.enum_clone_ids.len() {
                self.name_routine(asm, String("clone enum"), self.program.types.len())
                asm.bind(self.enum_clone_labels[self.enum_clone_done])
                when !self.emit_enum_clone(asm, self.enum_clone_ids[self.enum_clone_done]) {
                    return false
                }
                self.enum_clone_done += 1
                progress = true
            }
            while self.glue_done < self.glue_labels.len() {
                self.name_routine(asm, String("glue"), self.glue_elements[self.glue_done])
                asm.bind(self.glue_labels[self.glue_done])
                self.emit_glue(asm, self.glue_kinds[self.glue_done], self.glue_elements[self.glue_done])
                self.glue_done += 1
                progress = true
            }
            // A glue routine of nested elements asks for their value drop routines, which the drop pass has already
            // walked past: they are written here, and the walk goes on while they ask for more.
            drops := self.drop_values_done + self.drop_handles_done
            when !self.emit_drop_routines(asm) {
                return false
            }
            when self.drop_values_done + self.drop_handles_done != drops {
                progress = true
            }
            while self.vec_clone_done < self.vec_routine_elements.len() {
                self.name_routine(asm, String("clone vec of"), self.vec_routine_elements[self.vec_clone_done])
                asm.bind(self.vec_routine_labels[self.vec_clone_done])
                when !self.emit_vec_clone(asm, self.vec_routine_elements[self.vec_clone_done]) {
                    return false
                }
                asm.ret()
                self.vec_clone_done += 1
                progress = true
            }
        }
        return self.emit_drop_routines(asm)
    }

    // The body of a vector clone: the header in rdi is copied with its elements, each owned cell of the copy is replaced by
    // its clone, and the copy's header is left in rax.
    fun emit_vec_clone(mut self, asm: &mut x64::Asm, element: u64) -> bool {
        cells := self.cells_of(element)
        bytes := 8 * cells
        owned := self.owned_cells(element)
        when owned.is_none() {
            return self.fail("a vector clone of owned elements")
        }
        asm.push(x64::Reg::RDI)
        // The copy of the elements: malloc(bytes * len), then memcpy(copy, data, bytes * len).
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 8)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::RDI, bytes)
        self.aligned_call(asm, String("malloc"))
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RCX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        self.scale_bytes(asm, x64::Reg::RDX, bytes)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("memcpy"))
        self.clone_owned(asm, owned.unwrap(), bytes)
        // The header: the copy, the length, and the capacity of the length.
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 16)
        asm.alu_ri(0, x64::Reg::RSP, 16)
        return true
    }

    // Replaces each owned cell of each element of the copy by its clone: a String by the String clone, and a vector by the
    // routine of its element type. The stack holds the copy at 0 and the source header at 8; the loop keeps the element
    // index, the length and the copy on the stack, as the clone calls clobber the registers.
    fun clone_owned(mut self, asm: &mut x64::Asm, cells: Vec<u64>, bytes: u64) {
        when cells.len() == 0 {
            return
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RCX, 8)
        asm.push(x64::Reg::RCX)
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.push(x64::Reg::RCX)
        // [rsp] is the index, [rsp + 8] the length, [rsp + 16] the copy and [rsp + 24] the source header.
        top := asm.new_label()
        done := asm.new_label()
        asm.bind(top)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, done)
        mut at: u64 = 0
        while at < cells.len() {
            offset := cells[at]
            code := cells[at + 1]
            ty := cells[at + 2]
            target := self.copy_routine(asm, code, ty)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
            self.scale_bytes(asm, x64::Reg::RAX, bytes)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
            asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RDX)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RAX, offset as i64)
            asm.call_label(target)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
            self.scale_bytes(asm, x64::Reg::RDX, bytes)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
            asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RCX)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, offset as i64)
            at += 3
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.jmp(top)
        asm.bind(done)
        asm.alu_ri(0, x64::Reg::RSP, 16)
    }

    fun vec_new(mut self, asm: &mut x64::Asm) -> bool {
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        return true
    }

    // `vec.push(value)`: when the length has reached the capacity, the capacity doubles (at least to four), and the data
    // is grown by realloc; then the value's cells are copied to the end.
    fun vec_push(mut self, asm: &mut x64::Asm, element: u64, vec: u64, value: u64) -> bool {
        cells := self.cells_of(element)
        when !self.expr(asm, vec) {
            return false
        }
        // An element of one cell with nothing to drop: the header and the value meet in registers.
        when !self.no_opt && cells == 1 && self.is_cell(element) && !self.is_str(element) && !self.has_owners(element) {
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            when self.is_stable_operand(value) {
                self.load_stable_operand(asm, value, x64::Reg::R9)
            } else {
                asm.push(x64::Reg::RDX)
                when !self.expr(asm, value) {
                    return false
                }
                asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
                asm.pop(x64::Reg::RDX)
            }
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RDX, 16)
            asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RAX)
            room := asm.new_label()
            asm.jcc(x64::Cc::BELOW, room)
            self.grow_capacity(asm)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 16)
            asm.mov_rr(x64::Reg::RSI, x64::Reg::RAX)
            asm.shift_ri(4, x64::Reg::RSI, 3)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
            asm.push(x64::Reg::RDX)
            asm.push(x64::Reg::R9)
            self.aligned_call(asm, String("realloc"))
            asm.pop(x64::Reg::R9)
            asm.pop(x64::Reg::RDX)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
            asm.bind(room)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
            asm.indexed(true, x64::Reg::R9, x64::Reg::RSI, x64::Reg::RCX)
            asm.alu_ri(0, x64::Reg::RCX, 1)
            asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
            return true
        }
        asm.push(x64::Reg::RAX)
        when !self.push_value(asm, value, element) {
            return false
        }
        // The header is under the value's cells; rcx is the length, and rax the capacity.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * cells) as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RDX, 16)
        room := asm.new_label()
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RAX)
        asm.jcc(x64::Cc::BELOW, room)
        self.grow_capacity(asm)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 16)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RAX)
        self.scale_bytes(asm, x64::Reg::RSI, 8 * cells)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        self.aligned_call(asm, String("realloc"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * cells) as i64)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.bind(room)
        // The value goes at data + len * bytes, and the length grows by one.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * cells) as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::RDI, 8 * cells)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RSI)
        self.copy_block(asm, x64::Reg::RSP, x64::Reg::RDI, cells)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.alu_ri(0, x64::Reg::RSP, (8 * (cells + 1)) as i64)
        return true
    }

    // `Enum::Variant(fields)`: a box {tag, one cell per field} from malloc, which is the enum's one cell.
    fun enum_new(mut self, asm: &mut x64::Asm, id: u64, variant: u64, arguments: Vec<u64>) -> bool {
        fields := self.program.enums[id].variants[variant].fields.clone()
        when fields.len() != arguments.len() {
            return self.fail("an enum value with another number of fields")
        }
        mut cells: u64 = 0
        for field in fields.clone() {
            cells += self.cells_of(field)
        }
        asm.mov_ri(x64::Reg::RDI, (8 * (1 + cells)) as u64)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RCX, variant)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.push(x64::Reg::RAX)
        // Each field takes its cells after the tag, in declaration order.
        mut offset: u64 = 0
        mut position: u64 = 0
        while position < arguments.len() {
            field_ty := fields[position]
            when !self.store_into_box(asm, arguments[position], offset, field_ty) {
                return false
            }
            offset += self.cells_of(field_ty)
            position += 1
        }
        asm.pop(x64::Reg::RAX)
        return true
    }

    // Stores a value of type `ty` into the box whose pointer is on the stack top, at `offset` cells after the tag: a
    // scalar or an owned value in one cell, a str in two, and a structure field by field, in the order they are written.
    fun store_into_box(mut self, asm: &mut x64::Asm, value: u64, offset: u64, ty: u64) -> bool {
        when self.is_str(ty) {
            return self.store_str_in_box(asm, value, offset)
        }
        when self.is_cell(ty) {
            when !self.expr(asm, value) {
                return false
            }
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (1 + offset)) as i64)
            return true
        }
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.store_structure_in_box(asm, value, offset, id),
            ir::IrTy::ArrayOf(element, length) => self.store_array_in_box(asm, value, offset, ty),
            _ => self.fail("an enum field of this type"),
        }
    }

    // An array field of an enum value: the array is built in scratch cells, which the box then takes cell by cell, in the
    // order that the frame and the box share.
    fun store_array_in_box(mut self, asm: &mut x64::Asm, value: u64, offset: u64, ty: u64) -> bool {
        count := self.cells_of(ty)
        when count == 0 {
            return self.fail("an enum field of this type")
        }
        saved := self.scratch(count)
        when !self.store_into(asm, value, saved, ty) {
            return false
        }
        return self.copy_local_to_box(asm, saved, offset, count)
    }

    fun store_structure_in_box(mut self, asm: &mut x64::Asm, value: u64, offset: u64, id: u64) -> bool {
        place := self.place_of(value)
        when place.is_some() && self.struct_destructor_cells(id).len() == 0 {
            return self.copy_local_to_box(asm, place.unwrap(), offset, self.program.structs[id].slot_count)
        }
        when self.is_memory_place(value) && self.struct_destructor_cells(id).len() == 0 {
            when !self.memory_borrowed(value) && self.has_owners(self.struct_type(id)) {
                saved := self.scratch(self.program.structs[id].slot_count)
                when !self.store_struct(asm, value, saved, id) { return false }
                return self.copy_local_to_box(asm, saved, offset, self.program.structs[id].slot_count)
            }
            when !self.memory_address(asm, value) {
                return false
            }
            when self.program.structs[id].repr_c {
                return self.fail("a repr(C) structure in an enum payload")
            }
            return self.copy_memory_to_box(asm, offset, self.program.structs[id].slot_count)
        }
        return choose self.program.exprs[value] {
            ir::IrExpr::StructValue(sid, fields, values) => self.store_fields_in_box(asm, offset, sid, fields, values),
            ir::IrExpr::LocalRef(slot, ty, span) => self.copy_local_to_box(asm, slot, offset, self.program.structs[id].slot_count),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_into_box(asm, target, arguments, offset, id),
            ir::IrExpr::MoveRef(slot, mty) => self.store_moved_to_box(asm, slot, offset, id),
            ir::IrExpr::Propagate(inner, input, output, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred) => self.store_propagated_in_box(asm, inner, id, failure_type, success_variant, output_failure_variant, deferred, offset),
            _ => self.fail_at("a structure field that is not a value or a local", value),
        }
    }

    // A propagated structure stored in an enum box: it is taken into scratch cells first, then copied.
    fun store_propagated_in_box(mut self, asm: &mut x64::Asm, inner: u64, id: u64, failure_type: Option<u64>, success_variant: u64, output_failure_variant: u64, deferred: Vec<u64>, offset: u64) -> bool {
        count := self.program.structs[id].slot_count
        held := self.scratch(count)
        when !self.propagate_struct(asm, inner, id, failure_type, success_variant, output_failure_variant, deferred, held) {
            return false
        }
        return self.copy_local_to_box(asm, held, offset, count)
    }

    fun store_fields_in_box(mut self, asm: &mut x64::Asm, offset: u64, id: u64, fields: Vec<u64>, values: Vec<u64>) -> bool {
        mut position: u64 = 0
        while position < fields.len() {
            field := fields[position]
            field_offset := self.program.structs[id].fields[field].slot_offset
            field_ty := self.program.structs[id].fields[field].ty
            when !self.store_into_box(asm, values[position], offset + field_offset, field_ty) {
                return false
            }
            position += 1
        }
        return true
    }

    // Copies `count` cells of the local at `slot` into the box, from `offset` cells after the tag.
    fun copy_local_to_box(mut self, asm: &mut x64::Asm, slot: u64, offset: u64, count: u64) -> bool {
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot + cell))
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (1 + offset + cell)) as i64)
            cell += 1
        }
        return true
    }

    // Stores a str value into the box whose pointer is on the stack top, at `offset` cells after the tag.
    fun store_str_in_box(mut self, asm: &mut x64::Asm, value: u64, offset: u64) -> bool {
        when self.string_literal(value).is_some() {
            index := self.literal(self.string_literal(value).unwrap())
            asm.lea_symbol(x64::Reg::RAX, self.literal_symbols[index])
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (1 + offset)) as i64)
            asm.mov_ri(x64::Reg::RAX, self.literal_lengths[index])
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (2 + offset)) as i64)
            return true
        }
        source := self.struct_local_of(value)
        when source.is_none() {
            return self.fail("a string field that is not a literal or a local")
        }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(source.unwrap()))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (1 + offset)) as i64)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(source.unwrap() + 1))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (2 + offset)) as i64)
        return true
    }

    // The cell offset of a field of a variant, after the tag, from the cells of the fields before it.
    fun enum_field_offset(self, id: u64, variant: u64, field: u64) -> u64 {
        fields := self.program.enums[id].variants[variant].fields.clone()
        mut offset: u64 = 0
        mut position: u64 = 0
        while position < field {
            offset += self.cells_of(fields[position])
            position += 1
        }
        return offset
    }
    // A match of an enum value: the tag of the box is compared with each arm's variant in order (an arm with no variant
    // always matches); the arm's fields are copied into their slots, and its body is the value. No arm for the tag is a
    // trap, which the exhaustive matches of checked programs do not reach.
    fun enum_match(mut self, asm: &mut x64::Asm, value: u64, id: u64, arms: Vec<u64>, ty: u64) -> bool {
        when self.cells_of(ty) == 0 {
            return self.fail("an enum match with a result of this type")
        }
        aggregate := !self.is_cell(ty)
        // The matched enum waits in a cell of the frame, so that a result pushed on the stack needs nothing removed.
        held := self.scratch(1)
        when !self.expr(asm, value) {
            return false
        }
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(held))
        end := asm.new_label()
        for arm in arms {
            record := self.program.arms[arm]
            next := asm.new_label()
            when record.variant.is_some() {
                asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(held))
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 0)
                asm.alu_ri(7, x64::Reg::RCX, record.variant.unwrap() as i64)
                asm.jcc(x64::Cc::NOT_EQUAL, next)
            }
            mut binding: u64 = 0
            while binding < record.bindings.len() {
                slot := record.bindings[binding]
                field_ty := record.bindings[binding + 1]
                field := record.bindings[binding + 2]
                when record.variant.is_none() {
                    return self.fail("a binding without a variant")
                }
                at := self.enum_field_offset(id, record.variant.unwrap(), field)
                cells := self.cells_of(field_ty)
                when cells == 0 {
                    return self.fail("an enum field of this type")
                }
                asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(held))
                mut cell: u64 = 0
                while cell < cells {
                    asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, (8 * (1 + at + cell)) as i64)
                    asm.store(8, x64::Reg::RCX, x64::Reg::RBP, slot_disp(slot + cell))
                    cell += 1
                }
                // Pattern bindings take ownership of payload owners, just as the Rust backend does.
                owners := self.owner_pairs(field_ty)
                mut owner: u64 = 0
                while owner < owners.len() {
                    asm.mov_ri(x64::Reg::RCX, 0)
                    asm.store(8, x64::Reg::RCX, x64::Reg::RDX, (8 * (1 + at + owners[owner])) as i64)
                    owner += 2
                }
                binding += 3
            }
            when aggregate {
                when !self.push_value(asm, record.body, ty) {
                    return false
                }
            } else {
                when !self.expr(asm, record.body) {
                    return false
                }
            }
            asm.push(x64::Reg::RAX)
            mut remaining: u64 = record.bindings.len()
            while remaining > 0 {
                remaining -= 3
                self.drop_slot(asm, record.bindings[remaining], record.bindings[remaining + 1])
            }
            when self.temporary_type(value).is_some() {
                asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, slot_disp(held))
                asm.call_label(self.handle_drop_routine(asm, self.temporary_type(value).unwrap()))
            }
            asm.pop(x64::Reg::RAX)
            asm.jmp(end)
            asm.bind(next)
        }
        asm.trap()
        asm.bind(end)
        return true
    }

    // An `if` whose value is a string or a structure: the chosen branch is pushed as its cells.
    fun push_if(mut self, asm: &mut x64::Asm, condition: u64, then_value: u64, else_value: u64, ty: u64) -> bool {
        when !self.expr(asm, condition) {
            return false
        }
        otherwise := asm.new_label()
        end := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, otherwise)
        when !self.push_value(asm, then_value, ty) {
            return false
        }
        asm.jmp(end)
        asm.bind(otherwise)
        when !self.push_value(asm, else_value, ty) {
            return false
        }
        asm.bind(end)
        return true
    }

    // The value of a match, an `if` or a field, of a type that takes several cells, stored into the cells from `base` on: it is
    // pushed by the code for arguments and then moved.
    fun store_aggregate_result(mut self, asm: &mut x64::Asm, value: u64, base: u64, count: u64, ty: u64) -> bool {
        when !self.push_value(asm, value, ty) {
            return false
        }
        return self.store_pushed(asm, base, count)
    }

    // Moves the `count` cells that were just pushed into the cells from `base` on, and removes them.
    fun store_pushed(mut self, asm: &mut x64::Asm, base: u64, count: u64) -> bool {
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + cell))
            cell += 1
        }
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    // A structure that is a field of another structure value: the outer one is pushed, and the field's cells are moved up to
    // take its place on the stack.
    fun push_field_struct(mut self, asm: &mut x64::Asm, outer: u64, outer_id: u64, field: u64, inner_id: u64) -> bool {
        when !self.push_structure(asm, outer, outer_id) {
            return false
        }
        total := self.program.structs[outer_id].slot_count
        count := self.program.structs[inner_id].slot_count
        offset := self.program.structs[outer_id].fields[field].slot_offset
        saved := self.scratch(count)
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (total - 1 - offset - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(saved + cell))
            cell += 1
        }
        owners := self.owner_pairs(self.struct_type(inner_id))
        mut at: u64 = 0
        while at < owners.len() {
            asm.mov_ri(x64::Reg::RAX, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, (8 * (total - 1 - offset - owners[at])) as i64)
            at += 2
        }
        asm.lea(x64::Reg::RDI, x64::Reg::RSP, (8 * (total - 1)) as i64)
        asm.call_label(self.value_drop_routine(asm, self.struct_type(outer_id), false))
        asm.alu_ri(0, x64::Reg::RSP, (8 * total) as i64)
        when !self.push_local_cells(asm, saved, count) { return false }
        return true
    }

    // `vec[index]`: the index is checked against the length, and an index past it is a runtime error.
    // Writes a message and a newline to standard error and exits with status 1, as the runtime does for a failed check.
    fun fail_exit(mut self, asm: &mut x64::Asm, text: String) {
        index := self.literal(text)
        self.flush_stdout(asm)
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[index])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[index])
        asm.mov_ri(x64::Reg::RDI, 2)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RAX, 231)
        asm.syscall()
    }

    // The capacity of a vector after it grows, from the capacity in rax: 4 when it was empty, and double otherwise.
    fun grow_capacity(self, asm: &mut x64::Asm) {
        doubled := asm.new_label()
        grown := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::NOT_EQUAL, doubled)
        asm.mov_ri(x64::Reg::RAX, 4)
        asm.jmp(grown)
        asm.bind(doubled)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RAX)
        asm.bind(grown)
    }

    // `set(index, value)`: the element at index is replaced; an index past the length fails.
    fun vec_set(mut self, asm: &mut x64::Asm, element: u64, vec: u64, index: u64, value: u64) -> bool {
        cells := self.cells_of(element)
        // An element of one cell with nothing to drop, and an index that is a constant or a local: the header, the value and
        // the index meet in registers, with nothing pushed.
        when !self.no_opt && cells == 1 && self.is_cell(element) && !self.is_str(element) && !self.has_owners(element) && self.is_stable_operand(index) {
            when !self.expr(asm, vec) {
                return false
            }
            when self.is_stable_operand(value) {
                asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
                self.load_stable_operand(asm, value, x64::Reg::R9)
            } else {
                asm.push(x64::Reg::RAX)
                when !self.expr(asm, value) {
                    return false
                }
                asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
                asm.pop(x64::Reg::RDX)
            }
            when self.bce_proved(vec, index) {
                mut index_register := self.operand_reg(index)
                when index_register == 0 {
                    self.load_stable_operand(asm, index, x64::Reg::RCX)
                    index_register = x64::Reg::RCX
                }
                asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
                asm.indexed(true, x64::Reg::R9, x64::Reg::RDI, index_register)
                return true
            }
            self.load_stable_operand(asm, index, x64::Reg::RCX)
            when !self.bce_proved(vec, index) {
                asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 8)
                asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDI)
                asm.jcc(x64::Cc::ABOVE_EQUAL, self.set_error_label)
            }
            asm.shift_ri(4, x64::Reg::RCX, 3)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
            asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RDI)
            asm.store(8, x64::Reg::R9, x64::Reg::RCX, 0)
            return true
        }
        when !self.expr(asm, vec) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, index) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.push_value(asm, value, element) {
            return false
        }
        // The value's cells are on top, then the index, then the header.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * (cells + 1)) as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, (8 * cells) as i64)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDI)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.set_error_label)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::R8, 8 * cells)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::RDI)
        when self.has_owners(element) {
            asm.push(x64::Reg::R8)
            asm.lea(x64::Reg::RDI, x64::Reg::R8, (8 * (cells - 1)) as i64)
            asm.call_label(self.value_drop_routine(asm, element, false))
            asm.pop(x64::Reg::R8)
        }
        self.copy_block(asm, x64::Reg::RSP, x64::Reg::R8, cells)
        asm.alu_ri(0, x64::Reg::RSP, (8 * (cells + 2)) as i64)
        return true
    }

    // `take(index)`: the element at index is removed, the elements after it move down one, and the element is the value. A
    // structure is left on the stack as its cells, as a call returns it.
    fun vec_take(mut self, asm: &mut x64::Asm, element: u64, vec: u64, index: u64) -> bool {
        cells := self.cells_of(element)
        when !self.expr(asm, vec) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, index) {
            return false
        }
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDI)
        in_range := asm.new_label()
        asm.jcc(x64::Cc::BELOW, in_range)
        self.fail_exit(asm, String("Ryn runtime error: Vec index is out of bounds\n"))
        asm.bind(in_range)
        // r8 is the element's address, r10 the bytes of the elements after it, and the length drops by one.
        asm.mov_rr(x64::Reg::R8, x64::Reg::RAX)
        self.scale_bytes(asm, x64::Reg::R8, 8 * cells)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDX, 0)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R9)
        asm.mov_rr(x64::Reg::R10, x64::Reg::RDI)
        asm.alu_rr(41, x64::Reg::R10, x64::Reg::RAX)
        asm.alu_ri(5, x64::Reg::R10, 1)
        self.scale_bytes(asm, x64::Reg::R10, 8 * cells)
        asm.alu_ri(5, x64::Reg::RDI, 1)
        asm.store(8, x64::Reg::RDI, x64::Reg::RDX, 8)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        // The element is copied to the stack, and the elements after it move down over it.
        asm.alu_ri(5, x64::Reg::RSP, (8 * cells) as i64)
        self.copy_block(asm, x64::Reg::R8, x64::Reg::RSP, cells)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::R8)
        asm.lea(x64::Reg::RSI, x64::Reg::R8, (8 * cells) as i64)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::R10)
        self.aligned_call(asm, String("memmove"))
        when self.is_cell(element) {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
            asm.alu_ri(0, x64::Reg::RSP, 8)
        }
        return true
    }

    // `insert(index, value)`: the elements from index on move up one, and the value takes index; an index past the
    // length fails, and a full vector grows first.
    fun vec_insert(mut self, asm: &mut x64::Asm, element: u64, vec: u64, index: u64, value: u64) -> bool {
        cells := self.cells_of(element)
        when !self.expr(asm, vec) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, index) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.push_value(asm, value, element) {
            return false
        }
        // The value's cells are on top, then the index, then the header.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * (cells + 1)) as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, (8 * cells) as i64)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDI)
        in_range := asm.new_label()
        asm.jcc(x64::Cc::BELOW_EQUAL, in_range)
        self.fail_exit(asm, String("Ryn runtime error: Vec insert index is out of bounds\n"))
        asm.bind(in_range)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RDX, 16)
        room := asm.new_label()
        asm.alu_rr(57, x64::Reg::RDI, x64::Reg::RAX)
        asm.jcc(x64::Cc::BELOW, room)
        self.grow_capacity(asm)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 16)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RAX)
        self.scale_bytes(asm, x64::Reg::RSI, 8 * cells)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        self.aligned_call(asm, String("realloc"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * (cells + 1)) as i64)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.bind(room)
        // The elements from the index on move up one element: memmove(at + bytes, at, (len - index) * bytes), where `at` is
        // the element at the index. The length grows by one.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * (cells + 1)) as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, (8 * cells) as i64)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 8)
        asm.mov_rr(x64::Reg::R10, x64::Reg::RDI)
        asm.alu_rr(41, x64::Reg::R10, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::R10, 8 * cells)
        asm.alu_ri(0, x64::Reg::RDI, 1)
        asm.store(8, x64::Reg::RDI, x64::Reg::RDX, 8)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::R8, 8 * cells)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDX, 0)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R9)
        asm.lea(x64::Reg::RDI, x64::Reg::R8, (8 * cells) as i64)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::R8)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::R10)
        self.aligned_call(asm, String("memmove"))
        // The value's cells go to `at`, found again because the call clobbered the registers.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * (cells + 1)) as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, (8 * cells) as i64)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::R8, 8 * cells)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDX, 0)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R9)
        self.copy_block(asm, x64::Reg::RSP, x64::Reg::R8, cells)
        asm.alu_ri(0, x64::Reg::RSP, (8 * (cells + 2)) as i64)
        return true
    }

    // `vec[index]`: the element is at data + index * bytes. A scalar is its value; a structure is pushed as its cells, as a
    // call returns it.
    fun vec_index(mut self, asm: &mut x64::Asm, element: u64, vec: u64, index: u64) -> bool {
        cells := self.cells_of(element)
        when !self.expr(asm, vec) {
            return false
        }
        // An element of one cell with nothing to copy, read at an index a loop has proved in range: the data pointer and the
        // index meet in an addressing mode.
        when cells == 1 && self.is_cell(element) && !self.is_str(element) && !self.has_owners(element) && self.is_stable_operand(index) && self.bce_proved(vec, index) {
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 0)
            mut index_register := self.operand_reg(index)
            when index_register == 0 {
                self.load_stable_operand(asm, index, x64::Reg::RCX)
                index_register = x64::Reg::RCX
            }
            asm.indexed(false, x64::Reg::RAX, x64::Reg::RDX, index_register)
            return true
        }
        // An index that is a constant or a local nothing else can change is read after the vector, so the vector need not wait
        // on the stack while it is computed.
        direct := self.is_stable_operand(index)
        when direct {
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            self.load_stable_operand(asm, index, x64::Reg::RAX)
        } else {
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, index) {
                return false
            }
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        }
        when !self.bce_proved(vec, index) {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
            asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        }
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        self.scale_bytes(asm, x64::Reg::RAX, 8 * cells)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RAX)
        when !direct {
            asm.alu_ri(0, x64::Reg::RSP, 8)
        }
        owned := self.owned_cells(element)
        mut copies: Vec<u64> = Vec()
        when owned.is_some() {
            copies = owned.unwrap()
        }
        when self.is_cell(element) {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSI, 0)
            // A String, vector or enum element is copied with what it owns, as the runtime's indexing copies it: the value
            // read must not share memory with the vector.
            when copies.len() == 3 {
                asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
                asm.call_label(self.copy_routine(asm, copies[1], copies[2]))
            }
            return true
        }
        asm.alu_ri(5, x64::Reg::RSP, (8 * cells) as i64)
        self.copy_block(asm, x64::Reg::RSI, x64::Reg::RSP, cells)
        mut at: u64 = 0
        while at < copies.len() {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, copies[at] as i64)
            asm.call_label(self.copy_routine(asm, copies[at + 1], copies[at + 2]))
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, copies[at] as i64)
            at += 3
        }
        return true
    }

    // The label of the routine that copies a value that owns memory: code 1 a String, 2 a vector (of `ty`), 3 an enum (`ty`).
    fun copy_routine(mut self, asm: &mut x64::Asm, code: u64, ty: u64) -> u64 {
        when code == 2 {
            return self.vec_routine(asm, ty)
        }
        when code == 3 {
            return self.enum_routine(asm, self.enum_id_of(ty))
        }
        when code == 4 {
            key := choose self.program.types[ty] { ir::IrTy::MapOf(k, v) => k, ir::IrTy::SetOf(k, v) => k, _ => 0 }
            value := choose self.program.types[ty] { ir::IrTy::MapOf(k, v) => v, ir::IrTy::SetOf(k, v) => v, _ => 0 }
            when self.key_is_text(key) && self.is_string(value) { return self.map_clone_both_text }
            when self.key_is_text(key) { return self.map_clone_key_text }
            when self.is_string(value) { return self.map_clone_value_text }
            return self.map_clone_plain
        }
        return self.string_clone_label
    }

    // Whether a type is a float: `f32` or `f64`, held as its IEEE bits in a cell.
    fun is_float(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => word == "F32" || word == "F64",
            _ => false,
        }
    }

    // The top bit of a float's width, which negation flips.
    fun float_sign_bit(self, ty: u64) -> u64 {
        when self.word(ty) == "F64" {
            return 9223372036854775808 as u64
        }
        return 2147483648 as u64
    }

    // A float literal: its f64 bits, narrowed to single precision for `f32`.
    fun float_literal(mut self, asm: &mut x64::Asm, bits: u64, ty: u64) -> bool {
        asm.mov_ri(x64::Reg::RAX, bits)
        when self.word(ty) == "F32" {
            asm.movq_to_xmm(true, 0, x64::Reg::RAX)
            asm.cvt_precision(8, 0, 0)
            asm.movq_from_xmm(false, x64::Reg::RAX, 0)
        }
        return true
    }

    // `a op b` of floats: the operands are in xmm0 and xmm1, and an ordered comparison is false for a NaN, as in Rust.
    // The structure type of a type, when it is one.
    fun struct_of(self, ty: u64) -> Option<u64> {
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => Option::Some(id),
            _ => Option::None,
        }
    }

    // `left == right` (or `!=`) on structures, as the Rust backend compares them: every field in order, a text by its characters,
    // a float by the IEEE equality, and a nested structure field by field. An operand that is not a place is built in scratch
    // cells and dropped once compared.
    fun struct_equal(mut self, asm: &mut x64::Asm, negate: bool, left: u64, right: u64, ty: u64) -> bool {
        id := self.struct_of(ty).unwrap()
        cells := self.cells_of(ty)
        mut left_slot: u64 = 0
        mut left_temp := false
        when self.place_of(left).is_some() {
            left_slot = self.place_of(left).unwrap()
        } else {
            left_slot = self.scratch(cells)
            left_temp = true
            when !self.store_into(asm, left, left_slot, ty) {
                return false
            }
        }
        mut right_slot: u64 = 0
        mut right_temp := false
        when self.place_of(right).is_some() {
            right_slot = self.place_of(right).unwrap()
        } else {
            right_slot = self.scratch(cells)
            right_temp = true
            when !self.store_into(asm, right, right_slot, ty) {
                return false
            }
        }
        acc := self.scratch(1)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(acc))
        when !self.compare_struct_slots(asm, left_slot, right_slot, id, acc) {
            return false
        }
        when left_temp && self.has_owners(ty) {
            self.drop_value(asm, left_slot, ty)
        }
        when right_temp && self.has_owners(ty) {
            self.drop_value(asm, right_slot, ty)
        }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(acc))
        when negate {
            asm.alu_ri(6, x64::Reg::RAX, 1)
        }
        return true
    }

    // Ands into the accumulator at `acc` the equality of each field of the structures at `left` and `right`.
    fun compare_struct_slots(mut self, asm: &mut x64::Asm, left: u64, right: u64, id: u64, acc: u64) -> bool {
        mut field: u64 = 0
        while field < self.program.structs[id].fields.len() {
            field_ty := self.program.structs[id].fields[field].ty
            at := self.program.structs[id].fields[field].slot_offset
            when self.struct_of(field_ty).is_some() {
                when !self.compare_struct_slots(asm, left + at, right + at, self.struct_of(field_ty).unwrap(), acc) {
                    return false
                }
            } else {
                when !self.field_equal_slots(asm, left + at, right + at, field_ty) {
                    return false
                }
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, slot_disp(acc))
                asm.alu_rr(33, x64::Reg::RAX, x64::Reg::RCX)
                asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(acc))
            }
            field += 1
        }
        return true
    }

    // The equality of a field of a structure at two slots, in RAX as 0 or 1.
    fun field_equal_slots(mut self, asm: &mut x64::Asm, left: u64, right: u64, ty: u64) -> bool {
        when self.is_string(ty) || self.is_str(ty) {
            return self.text_slots_equal(asm, left, right, self.is_string(ty))
        }
        when self.is_float(ty) {
            wide := self.word(ty) == "F64"
            mut precision: u64 = 4
            when wide {
                precision = 8
            }
            when !self.load_cell(asm, ty, x64::Reg::RBP, slot_disp(left)) {
                return false
            }
            asm.movq_to_xmm(wide, 0, x64::Reg::RAX)
            when !self.load_cell(asm, ty, x64::Reg::RBP, slot_disp(right)) {
                return false
            }
            asm.movq_to_xmm(wide, 1, x64::Reg::RAX)
            asm.ucomis(precision, 0, 1)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.setcc(x64::Cc::NOT_PARITY, x64::Reg::RAX)
            asm.alu_rr(33, x64::Reg::RAX, x64::Reg::RDX)
            return true
        }
        word := self.word(ty)
        when is_integer_word(word.clone()) || word == "Bool" || word == "Char" {
            when !self.load_cell(asm, ty, x64::Reg::RBP, slot_disp(left)) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.load_cell(asm, ty, x64::Reg::RBP, slot_disp(right)) {
                return false
            }
            asm.pop(x64::Reg::RCX)
            asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RAX)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            asm.alu_ri(4, x64::Reg::RAX, 1)
            return true
        }
        return self.fail("a structure field of this type")
    }

    // The equality of two texts in the cells from `left` and `right`, in RAX as 0 or 1: an owner holds the text's record, a
    // `str` holds its pointer and its length.
    fun text_slots_equal(mut self, asm: &mut x64::Asm, left: u64, right: u64, owned: bool) -> bool {
        self.load_text_slot(asm, left, owned)
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        self.load_text_slot(asm, right, owned)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RSI)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RDX)
        asm.pop(x64::Reg::R9)
        asm.pop(x64::Reg::R10)
        self.text_compare_registers(asm)
        return true
    }

    // The text in the cells from `slot` into RSI (pointer) and RDX (length).
    fun load_text_slot(self, asm: &mut x64::Asm, slot: u64, owned: bool) {
        when owned {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot))
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
        } else {
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, slot_disp(slot))
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(slot + 1))
        }
    }

    fun float_binary(mut self, asm: &mut x64::Asm, op: String, left: u64, right: u64, ty: u64) -> bool {
        mut precision: u64 = 4
        when self.word(ty) == "F64" {
            precision = 8
        }
        wide := precision == 8
        when !self.expr(asm, left) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, right) {
            return false
        }
        asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
        asm.pop(x64::Reg::RAX)
        asm.movq_to_xmm(wide, 0, x64::Reg::RAX)
        asm.movq_to_xmm(wide, 1, x64::Reg::RCX)
        when op == "Add" || op == "Sub" || op == "Mul" || op == "Div" {
            mut opcode: u64 = 88
            when op == "Sub" {
                opcode = 92
            }
            when op == "Mul" {
                opcode = 89
            }
            when op == "Div" {
                opcode = 94
            }
            asm.sse_op(precision, opcode, 0, 1)
            asm.movq_from_xmm(wide, x64::Reg::RAX, 0)
            return true
        }
        when op == "Lt" {
            asm.ucomis(precision, 1, 0)
            asm.setcc(x64::Cc::ABOVE, x64::Reg::RAX)
            return true
        }
        when op == "Le" {
            asm.ucomis(precision, 1, 0)
            asm.setcc(x64::Cc::ABOVE_EQUAL, x64::Reg::RAX)
            return true
        }
        when op == "Gt" {
            asm.ucomis(precision, 0, 1)
            asm.setcc(x64::Cc::ABOVE, x64::Reg::RAX)
            return true
        }
        when op == "Ge" {
            asm.ucomis(precision, 0, 1)
            asm.setcc(x64::Cc::ABOVE_EQUAL, x64::Reg::RAX)
            return true
        }
        when op == "Eq" || op == "Ne" {
            // Equal when the comparison sets zero and not the unordered flag.
            // `setcc` always writes `al`, so the first result is moved aside before the second is made.
            asm.ucomis(precision, 0, 1)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.setcc(x64::Cc::NOT_PARITY, x64::Reg::RAX)
            asm.alu_rr(33, x64::Reg::RAX, x64::Reg::RDX)
            when op == "Ne" {
                asm.alu_ri(6, x64::Reg::RAX, 1)
            }
            return true
        }
        return self.fail("an operator on this type")
    }

    // A conversion to a float: from a float of the other width, or from a signed integer (an unsigned 64-bit value does
    // not fit the signed conversion, and is declined).
    fun float_cast(mut self, asm: &mut x64::Asm, value: u64, source: u64, target: u64) -> bool {
        mut target_precision: u64 = 4
        when self.word(target) == "F64" {
            target_precision = 8
        }
        when self.is_float(source) {
            mut source_precision: u64 = 4
            when self.word(source) == "F64" {
                source_precision = 8
            }
            when !self.expr(asm, value) {
                return false
            }
            when source_precision != target_precision {
                asm.movq_to_xmm(source_precision == 8, 0, x64::Reg::RAX)
                asm.cvt_precision(source_precision, 0, 0)
                asm.movq_from_xmm(target_precision == 8, x64::Reg::RAX, 0)
            }
            return true
        }
        when is_integer_word(self.word(source)) && self.word(source) != "U64" {
            when !self.expr(asm, value) {
                return false
            }
            asm.cvt_from_int(target_precision, 0, x64::Reg::RAX)
            asm.movq_from_xmm(target_precision == 8, x64::Reg::RAX, 0)
            return true
        }
        when self.word(source) == "U64" {
            when !self.expr(asm, value) {
                return false
            }
            // A value with the top bit set does not fit the signed conversion: it is halved, keeping the lowest bit so
            // that the rounding is right, converted, and doubled.
            simple := asm.new_label()
            done := asm.new_label()
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::GREATER_EQUAL, simple)
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.mov_ri(x64::Reg::RCX, 1)
            asm.shift_cl(5, x64::Reg::RAX)
            asm.alu_ri(4, x64::Reg::RDX, 1)
            asm.alu_rr(9, x64::Reg::RAX, x64::Reg::RDX)
            asm.cvt_from_int(target_precision, 0, x64::Reg::RAX)
            asm.sse_op(target_precision, 88, 0, 0)
            asm.jmp(done)
            asm.bind(simple)
            asm.cvt_from_int(target_precision, 0, x64::Reg::RAX)
            asm.bind(done)
            asm.movq_from_xmm(target_precision == 8, x64::Reg::RAX, 0)
            return true
        }
        return self.fail("a conversion to a float from this type")
    }

    // The bits of the double 2^`power`, negated when `negative`.
    fun power_of_two_bits(self, power: u64, negative: bool) -> u64 {
        mut bits: u64 = (1023 + power) << (52 as u32)
        when negative {
            bits = bits | ((1 as u64) << 63)
        }
        return bits
    }

    // A float converted to an integer type as Rust's `as` does: the fraction is dropped, a value past the range gives the
    // nearest end of the range, and NaN gives zero. The value is held as a double (a single is widened, which is exact),
    // and compared with the ends of the range, which are powers of two, before the truncating conversion runs.
    fun float_to_integer(mut self, asm: &mut x64::Asm, value: u64, source: u64, target: u64) -> bool {
        word := self.word(target)
        when !is_integer_word(word.clone()) {
            return self.fail("a conversion from a float to this type")
        }
        when !self.expr(asm, value) {
            return false
        }
        when self.word(source) == "F32" {
            asm.movq_to_xmm(false, 0, x64::Reg::RAX)
            asm.cvt_precision(4, 0, 0)
        } else {
            asm.movq_to_xmm(true, 0, x64::Reg::RAX)
        }
        width := width_of(word.clone()) * 8
        done := asm.new_label()
        not_a_number := asm.new_label()
        high := asm.new_label()
        low := asm.new_label()
        asm.ucomis(8, 0, 0)
        asm.jcc(x64::Cc::PARITY, not_a_number)
        when is_signed_word(word.clone()) {
            asm.mov_ri(x64::Reg::RAX, self.power_of_two_bits(width - 1, false))
            asm.movq_to_xmm(true, 1, x64::Reg::RAX)
            asm.ucomis(8, 0, 1)
            asm.jcc(x64::Cc::ABOVE_EQUAL, high)
            asm.mov_ri(x64::Reg::RAX, self.power_of_two_bits(width - 1, true))
            asm.movq_to_xmm(true, 1, x64::Reg::RAX)
            asm.ucomis(8, 0, 1)
            asm.jcc(x64::Cc::BELOW_EQUAL, low)
            asm.cvt_to_int(8, x64::Reg::RAX, 0)
            asm.jmp(done)
            asm.bind(high)
            asm.mov_ri(x64::Reg::RAX, ((1 as u64) << ((width - 1) as u32)) - 1)
            asm.jmp(done)
            asm.bind(low)
            asm.mov_ri(x64::Reg::RAX, (0 as u64) - ((1 as u64) << ((width - 1) as u32)))
            asm.jmp(done)
        } else {
            // Negative values, and the fractions between -1 and 0, give zero; the top is the largest value of the type.
            asm.mov_ri(x64::Reg::RAX, 0)
            asm.movq_to_xmm(true, 1, x64::Reg::RAX)
            asm.ucomis(8, 0, 1)
            asm.jcc(x64::Cc::BELOW, not_a_number)
            asm.mov_ri(x64::Reg::RAX, self.power_of_two_bits(width, false))
            asm.movq_to_xmm(true, 1, x64::Reg::RAX)
            asm.ucomis(8, 0, 1)
            asm.jcc(x64::Cc::ABOVE_EQUAL, high)
            when width == 64 {
                // Past 2^63 the signed conversion overflows: convert the excess over 2^63, and add 2^63 back.
                small := asm.new_label()
                asm.mov_ri(x64::Reg::RAX, self.power_of_two_bits(63, false))
                asm.movq_to_xmm(true, 1, x64::Reg::RAX)
                asm.ucomis(8, 0, 1)
                asm.jcc(x64::Cc::BELOW, small)
                asm.sse_op(8, 92, 0, 1)
                asm.cvt_to_int(8, x64::Reg::RAX, 0)
                asm.mov_ri(x64::Reg::RCX, (1 as u64) << 63)
                asm.alu_rr(49, x64::Reg::RAX, x64::Reg::RCX)
                asm.jmp(done)
                asm.bind(small)
            }
            asm.cvt_to_int(8, x64::Reg::RAX, 0)
            asm.jmp(done)
            asm.bind(high)
            when width == 64 {
                asm.mov_ri(x64::Reg::RAX, (0 as u64) - 1)
            } else {
                asm.mov_ri(x64::Reg::RAX, ((1 as u64) << (width as u32)) - 1)
            }
            asm.jmp(done)
            asm.bind(low)
        }
        asm.bind(not_a_number)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `String(text)` for a str: the header {data, len, capacity} from malloc, and the data, a copy of the text from malloc.
    fun string_op(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        // `__native_string_from_raw(pointer, length)`: a new String with a copy of the bytes, for the native runtime.
        when op == "FromRaw" && arguments.len() == 2 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.pop(x64::Reg::RSI)
            return self.string_from_parts(asm)
        }
        when op == "Len" || op == "CharCount" || op == "StrCharCount" {
            return self.string_query(asm, op, arguments)
        }
        when op == "Clone" && arguments.len() == 1 {
            return self.string_clone(asm, arguments[0])
        }
        when op == "AppendStr" && arguments.len() == 2 {
            return self.string_append(asm, arguments[0], arguments[1], false)
        }
        when op == "Push" && arguments.len() == 2 {
            return self.string_push(asm, arguments[0], arguments[1])
        }
        // `clear` keeps the buffer and sets the length to zero.
        when op == "Clear" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.mov_ri(x64::Reg::RCX, 0)
            asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
            return true
        }
        when op == "AppendString" && arguments.len() == 2 {
            return self.string_append(asm, arguments[0], arguments[1], true)
        }
        when op == "IsEmpty" && arguments.len() == 1 {
            when !self.text_parts(asm, arguments[0], true) {
                return false
            }
            asm.test_rr(x64::Reg::RDX, x64::Reg::RDX)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            return true
        }
        when op == "StartsWithStr" && arguments.len() == 2 {
            return self.string_starts_with(asm, arguments[0], arguments[1], false)
        }
        when op == "StartsWithString" && arguments.len() == 2 {
            return self.string_starts_with(asm, arguments[0], arguments[1], true)
        }
        when op == "Slice" && arguments.len() == 3 {
            return self.string_slice(asm, arguments[0], arguments[1], arguments[2])
        }
        when op == "TryParse" && arguments.len() == 2 {
            return self.string_try_parse(asm, arguments[0], arguments[1])
        }
        when op == "ConcatString" && arguments.len() == 2 {
            return self.string_concat(asm, arguments[0], arguments[1])
        }
        when op == "ConcatStr" && arguments.len() == 2 {
            return self.string_concat_text(asm, arguments[0], arguments[1])
        }
        when op == "SplitStr" && arguments.len() == 2 {
            return self.string_split(asm, arguments[0], arguments[1], false)
        }
        when op == "SplitString" && arguments.len() == 2 {
            return self.string_split(asm, arguments[0], arguments[1], true)
        }
        when op == "ContainsStr" && arguments.len() == 2 {
            return self.string_search(asm, arguments[0], arguments[1], false, false)
        }
        when op == "ContainsString" && arguments.len() == 2 {
            return self.string_search(asm, arguments[0], arguments[1], true, false)
        }
        when op == "EndsWithStr" && arguments.len() == 2 {
            return self.string_search(asm, arguments[0], arguments[1], false, true)
        }
        when op == "EndsWithString" && arguments.len() == 2 {
            return self.string_search(asm, arguments[0], arguments[1], true, true)
        }
        when op == "CharAt" && arguments.len() == 2 {
            return self.string_char_at(asm, arguments[0], arguments[1], String("Ryn runtime error: String character index is out of bounds\n"))
        }
        when (op == "FromI8" || op == "FromI16" || op == "FromI32" || op == "FromI64") && arguments.len() == 1 {
            return self.string_from_integer(asm, arguments[0], true)
        }
        when (op == "FromU8" || op == "FromU16" || op == "FromU32" || op == "FromU64") && arguments.len() == 1 {
            return self.string_from_integer(asm, arguments[0], false)
        }
        when (op == "FromF32" || op == "FromF64") && arguments.len() == 1 {
            return self.string_from_float(asm, arguments[0], op == "FromF32")
        }
        when (op == "Trim" || op == "TrimStart" || op == "TrimEnd") && arguments.len() == 1 {
            return self.string_trim(asm, arguments[0], op)
        }
        when op == "Reverse" && arguments.len() == 1 {
            when !self.text_parts(asm, arguments[0], true) {
                return false
            }
            self.textops_used = self.textops_used | 8
            asm.call_label(self.reverse_label)
            return self.string_adopt_parts(asm)
        }
        when (op == "ToLower" || op == "ToUpper") && arguments.len() == 1 {
            return self.string_case(asm, arguments[0], op == "ToUpper")
        }
        when (op == "FindStr" || op == "FindString") && arguments.len() == 2 {
            return self.string_find(asm, arguments[0], arguments[1], op == "FindString")
        }
        when op == "ReplaceStr" && arguments.len() == 3 {
            return self.string_replace(asm, arguments[0], arguments[1], arguments[2])
        }
        when op == "CharFromU32" && arguments.len() == 1 {
            // The value must be a Unicode scalar value: below 0x110000 and not a surrogate.
            when !self.expr(asm, arguments[0]) {
                return false
            }
            valid := asm.new_label()
            invalid := asm.new_label()
            asm.alu_ri(7, x64::Reg::RAX, 1114112)
            asm.jcc(x64::Cc::ABOVE_EQUAL, invalid)
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.alu_ri(5, x64::Reg::RCX, 55296)
            asm.alu_ri(7, x64::Reg::RCX, 2047)
            asm.jcc(x64::Cc::ABOVE, valid)
            asm.bind(invalid)
            self.fail_exit(asm, String("Ryn runtime error: integer is not a valid Unicode scalar value\n"))
            asm.bind(valid)
            return true
        }
        when op == "ByteAt" && arguments.len() == 2 {
            return self.string_byte_at(asm, arguments[0], arguments[1], String("Ryn runtime error: String byte index is out of bounds\n"))
        }
        // `str.len()` and `str.byte_at(index)` read the view's length and one of its bytes.
        when op == "StrByteAt" && arguments.len() == 2 {
            return self.string_byte_at(asm, arguments[0], arguments[1], String("Ryn runtime error: str byte index is out of bounds\n"))
        }
        when op == "StrLen" && arguments.len() == 1 {
            when !self.load_string_parts(asm, arguments[0]) {
                return false
            }
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
            return true
        }
        when op == "SliceChars" && arguments.len() == 3 {
            return self.string_slice_chars(asm, arguments[0], arguments[1], arguments[2])
        }
        when op == "StrCharAt" && arguments.len() == 2 {
            return self.string_char_at(asm, arguments[0], arguments[1], String("Ryn runtime error: str character index is out of bounds\n"))
        }
        when op != "New" || arguments.len() != 1 {
            return self.op_fail("a string operation ", op)
        }
        when !self.load_string_parts(asm, arguments[0]) {
            return false
        }
        return self.string_from_parts(asm)
    }

    // A new String with the text in rsi and rdx: its bytes are copied, and its header is left in rax.
    // Takes ownership of a malloc'd buffer in rsi of length rdx.
    fun string_adopt_parts(mut self, asm: &mut x64::Asm) -> bool {
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.pop(x64::Reg::RDX)
        asm.pop(x64::Reg::RSI)
        asm.store(8, x64::Reg::RSI, x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 16)
        return true
    }

    fun string_from_parts(mut self, asm: &mut x64::Asm) -> bool {
        // The source and its length stay on the stack while the allocations run.
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RDX)
        self.aligned_call(asm, String("malloc"))
        asm.push(x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("memcpy"))
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        return true
    }

    // Whether a text is a choice between two string literals, as `bool` is when it is printed.
    fun is_text_choice(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => self.string_literal(then_value).is_some() && self.string_literal(else_value).is_some(),
            _ => false,
        }
    }

    // The text of a choice between two string literals: the condition picks the literal, whose data and length go to rsi
    // and rdx.
    fun text_choice(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        condition := choose self.program.exprs[index] {
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => condition,
            _ => 0,
        }
        then_value := choose self.program.exprs[index] {
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => then_value,
            _ => 0,
        }
        else_value := choose self.program.exprs[index] {
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => else_value,
            _ => 0,
        }
        when !self.expr(asm, condition) {
            return false
        }
        otherwise := asm.new_label()
        end := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, otherwise)
        text := self.literal(self.string_literal(then_value).unwrap())
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[text])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[text])
        asm.jmp(end)
        asm.bind(otherwise)
        other := self.literal(self.string_literal(else_value).unwrap())
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[other])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[other])
        asm.bind(end)
        return true
    }

    // The routines of the Map representation, emitted once. A header is {buckets, bucket count, length, sequence}; a node
    // is {next, hash, key cell, value cell, sequence}. The hash of a key cell in rsi is left in rax; the node for the key
    // rsi in the map header rdi is left in rax, or 0; and the buckets of the header rdi are doubled.
    fun map_routines(mut self, asm: &mut x64::Asm) {
        when asm.is_pending(self.struct_key_drop) {
            self.struct_key_drop_routine(asm, self.struct_key_drop)
        }
        // The hash of a scalar key (in rsi): a multiplication by an odd constant, whose high bits depend on every bit of the key,
        // folded onto the low bits that pick the bucket. Four instructions, where eight rounds of FNV-1a took forty.
        when asm.is_pending(self.map_hash_scalar) {
            asm.bind(self.map_hash_scalar)
            asm.mov_ri(x64::Reg::RAX, 11400714819323198485 as u64)
            asm.imul_rr(x64::Reg::RAX, x64::Reg::RSI)
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.shift_ri(5, x64::Reg::RDX, 32)
            asm.alu_rr(49, x64::Reg::RAX, x64::Reg::RDX)
            asm.ret()
        }
        // FNV-1a over the bytes of a String key, whose header is in rsi.
        when asm.is_pending(self.map_hash_string) {
            asm.bind(self.map_hash_string)
            asm.load(8, false, x64::Reg::R9, x64::Reg::RSI, 0)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSI, 8)
            asm.mov_ri(x64::Reg::RAX, 14695981039346656037 as u64)
            hashing := asm.new_label()
            hashed := asm.new_label()
            asm.bind(hashing)
            asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
            asm.jcc(x64::Cc::EQUAL, hashed)
            asm.load(1, false, x64::Reg::RDX, x64::Reg::R9, 0)
            asm.alu_rr(49, x64::Reg::RAX, x64::Reg::RDX)
            asm.mov_ri(x64::Reg::RDX, 1099511628211)
            asm.imul_rr(x64::Reg::RAX, x64::Reg::RDX)
            asm.alu_ri(0, x64::Reg::R9, 1)
            asm.alu_ri(5, x64::Reg::RCX, 1)
            asm.jmp(hashing)
            asm.bind(hashed)
            asm.ret()
        }
        when asm.is_pending(self.string_clone_label) {
            self.string_clone_routine(asm)
        }
        when asm.is_pending(self.map_clone_plain) {
            self.map_clone_routine(asm, self.map_clone_plain, false, false, 0, Vec())
        }
        when asm.is_pending(self.map_clone_key_text) {
            self.map_clone_routine(asm, self.map_clone_key_text, true, false, 0, Vec())
        }
        when asm.is_pending(self.map_clone_value_text) {
            self.map_clone_routine(asm, self.map_clone_value_text, false, true, 0, Vec())
        }
        when asm.is_pending(self.map_clone_both_text) {
            self.map_clone_routine(asm, self.map_clone_both_text, true, true, 0, Vec())
        }
        when asm.is_pending(self.string_less_label) {
            asm.bind(self.string_less_label)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 8)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSI, 8)
            asm.load(8, false, x64::Reg::R8, x64::Reg::RDI, 0)
            asm.load(8, false, x64::Reg::R9, x64::Reg::RSI, 0)
            asm.mov_rr(x64::Reg::R10, x64::Reg::RCX)
            shorter := asm.new_label()
            asm.alu_rr(57, x64::Reg::R10, x64::Reg::RDX)
            asm.jcc(x64::Cc::BELOW_EQUAL, shorter)
            asm.mov_rr(x64::Reg::R10, x64::Reg::RDX)
            asm.bind(shorter)
            asm.mov_ri(x64::Reg::R11, 0)
            common := asm.new_label()
            differ := asm.new_label()
            prefix := asm.new_label()
            asm.bind(common)
            asm.alu_rr(57, x64::Reg::R11, x64::Reg::R10)
            asm.jcc(x64::Cc::ABOVE_EQUAL, prefix)
            asm.mov_rr(x64::Reg::RAX, x64::Reg::R8)
            asm.alu_rr(1, x64::Reg::RAX, x64::Reg::R11)
            asm.load(1, false, x64::Reg::RAX, x64::Reg::RAX, 0)
            asm.mov_rr(x64::Reg::RCX, x64::Reg::R9)
            asm.alu_rr(1, x64::Reg::RCX, x64::Reg::R11)
            asm.load(1, false, x64::Reg::RDX, x64::Reg::RCX, 0)
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDX)
            asm.jcc(x64::Cc::NOT_EQUAL, differ)
            asm.alu_ri(0, x64::Reg::R11, 1)
            asm.jmp(common)
            asm.bind(differ)
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDX)
            asm.setcc(x64::Cc::BELOW, x64::Reg::RAX)
            asm.ret()
            asm.bind(prefix)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 8)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSI, 8)
            asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
            asm.setcc(x64::Cc::BELOW, x64::Reg::RAX)
            asm.ret()
        }
        when asm.is_pending(self.map_find_scalar) {
            self.map_find_routine(asm, self.map_find_scalar, self.map_hash_scalar, false)
        }
        when asm.is_pending(self.map_find_string) {
            self.map_find_routine(asm, self.map_find_string, self.map_hash_string, true)
        }
        // Doubling: the slots become twice as many and are filled again from the entries, which are read in order.
        when asm.is_pending(self.map_grow) {
            asm.bind(self.map_grow)
            asm.push(x64::Reg::RDI)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RDI, 8)
            asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RAX)
            asm.push(x64::Reg::RAX)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.mov_ri(x64::Reg::RSI, 16)
            self.aligned_call(asm, String("calloc"))
            asm.push(x64::Reg::RAX)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
            asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 32)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 16)
            asm.mov_ri(x64::Reg::R11, 40)
            asm.imul_rr(x64::Reg::RCX, x64::Reg::R11)
            asm.mov_ri(x64::Reg::R9, 40)
            each := asm.new_label()
            each_done := asm.new_label()
            probe := asm.new_label()
            placed := asm.new_label()
            asm.bind(each)
            asm.alu_rr(57, x64::Reg::R9, x64::Reg::RCX)
            asm.jcc(x64::Cc::ABOVE, each_done)
            asm.mov_rr(x64::Reg::R10, x64::Reg::R9)
            asm.alu_rr(1, x64::Reg::R10, x64::Reg::R8)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::R10, 8)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
            asm.alu_ri(5, x64::Reg::RSI, 1)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.alu_rr(33, x64::Reg::RDI, x64::Reg::RSI)
            asm.bind(probe)
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RDI)
            asm.shift_ri(4, x64::Reg::RDX, 4)
            asm.load(8, false, x64::Reg::R11, x64::Reg::RSP, 0)
            asm.alu_rr(1, x64::Reg::RDX, x64::Reg::R11)
            asm.load(8, false, x64::Reg::R11, x64::Reg::RDX, 8)
            asm.test_rr(x64::Reg::R11, x64::Reg::R11)
            asm.jcc(x64::Cc::EQUAL, placed)
            asm.alu_ri(0, x64::Reg::RDI, 1)
            asm.alu_rr(33, x64::Reg::RDI, x64::Reg::RSI)
            asm.jmp(probe)
            asm.bind(placed)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
            asm.store(8, x64::Reg::R9, x64::Reg::RDX, 8)
            asm.alu_ri(0, x64::Reg::R9, 40)
            asm.jmp(each)
            asm.bind(each_done)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
            self.aligned_call(asm, String("free"))
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
            asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
            asm.alu_ri(0, x64::Reg::RSP, 24)
            asm.ret()
        }
    }

    // Three doublings: the value in the register is multiplied by eight.
    fun scale8(self, asm: &mut x64::Asm, reg: u64) {
        asm.alu_rr(1, reg, reg)
        asm.alu_rr(1, reg, reg)
        asm.alu_rr(1, reg, reg)
    }

    // `contains(value)` of a vector of plain cells: the elements are scanned in order, a String equal when neither is
    // less than the other, and a scalar equal when its word is. The frame holds the index, the value and the vector.
    fun vec_contains(mut self, asm: &mut x64::Asm, element: u64, vec: u64, value: u64) -> bool {
        text := self.is_string(element)
        when !self.expr(asm, vec) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, value) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.alu_ri(5, x64::Reg::RSP, 8)
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 0)
        scan := asm.new_label()
        next := asm.new_label()
        found := asm.new_label()
        missing := asm.new_label()
        done := asm.new_label()
        asm.bind(scan)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RSI)
        asm.jcc(x64::Cc::ABOVE_EQUAL, missing)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        self.scale8(asm, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RAX, 0)
        when text {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
            asm.mov_rr(x64::Reg::RSI, x64::Reg::R8)
            asm.call_label(self.string_less_label)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::NOT_EQUAL, next)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
            self.scale8(asm, x64::Reg::RAX)
            asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RSI)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
            asm.call_label(self.string_less_label)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::NOT_EQUAL, next)
            asm.jmp(found)
        }
        when !text {
            asm.load(8, false, x64::Reg::R9, x64::Reg::RSP, 8)
            asm.alu_rr(57, x64::Reg::R8, x64::Reg::R9)
            asm.jcc(x64::Cc::EQUAL, found)
        }
        asm.bind(next)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.jmp(scan)
        asm.bind(found)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.jmp(done)
        asm.bind(missing)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.bind(done)
        return true
    }

    // `sort()` of a vector of plain cells: an insertion sort, which is stable as the Rust sort is. A String is compared by
    // its bytes, and a scalar by its value, signed or unsigned as its type is. The frame holds the header, the index i,
    // the index j, and the key being placed.
    // `reverse()`: the elements swap places pairwise, cell by cell, so the owners move with their elements.
    fun vec_reverse(mut self, asm: &mut x64::Asm, element: u64, vec: u64) -> bool {
        cells := self.cells_of(element)
        when !self.expr(asm, vec) {
            return false
        }
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDI, 8)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RDI, 0)
        asm.mov_ri(x64::Reg::R8, 0)
        top := asm.new_label()
        done := asm.new_label()
        asm.bind(top)
        asm.mov_rr(x64::Reg::RCX, x64::Reg::R9)
        asm.alu_ri(5, x64::Reg::RCX, 1)
        asm.alu_rr(41, x64::Reg::RCX, x64::Reg::R8)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, done)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::R8)
        self.scale_bytes(asm, x64::Reg::RSI, 8 * cells)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::R10)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::RDX, 8 * cells)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::R10)
        mut cell: u64 = 0
        while cell < cells {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSI, (8 * cell) as i64)
            asm.load(8, false, x64::Reg::R11, x64::Reg::RDX, (8 * cell) as i64)
            asm.store(8, x64::Reg::R11, x64::Reg::RSI, (8 * cell) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * cell) as i64)
            cell += 1
        }
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.jmp(top)
        asm.bind(done)
        return true
    }

    fun vec_sort(mut self, asm: &mut x64::Asm, element: u64, vec: u64) -> bool {
        text := self.is_string(element)
        signed := choose self.program.types[element] {
            ir::IrTy::Scalar(word) => is_signed_word(word),
            _ => false,
        }
        when !self.expr(asm, vec) {
            return false
        }
        asm.alu_ri(5, x64::Reg::RSP, 48)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.mov_ri(x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 8)
        outer := asm.new_label()
        done := asm.new_label()
        asm.bind(outer)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RSI)
        asm.jcc(x64::Cc::ABOVE_EQUAL, done)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        self.scale8(asm, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::R8, x64::Reg::RSP, 24)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 16)
        inner := asm.new_label()
        place := asm.new_label()
        asm.bind(inner)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
        asm.jcc(x64::Cc::EQUAL, place)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        asm.alu_ri(5, x64::Reg::RAX, 1)
        self.scale8(asm, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RSP, 24)
        // The key moves before the previous element only when it is less.
        when text {
            asm.mov_rr(x64::Reg::RDI, x64::Reg::R8)
            asm.mov_rr(x64::Reg::RSI, x64::Reg::R10)
            asm.call_label(self.string_less_label)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::EQUAL, place)
        }
        // Floats compare as floats: the key is in its slot, the element at rax.
        when !text && self.is_float(element) {
            precision := if_f32(self.word(element) == "F32")
            asm.sse_load(precision, 0, x64::Reg::RSP, 24)
            asm.sse_load(precision, 1, x64::Reg::RAX, 0)
            asm.ucomis(precision, 0, 1)
            asm.jcc(x64::Cc::ABOVE_EQUAL, place)
        }
        when !text && !self.is_float(element) {
            asm.alu_rr(57, x64::Reg::R8, x64::Reg::R10)
            when signed {
                asm.jcc(x64::Cc::GREATER_EQUAL, place)
            }
            when !signed {
                asm.jcc(x64::Cc::ABOVE_EQUAL, place)
            }
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        self.scale8(asm, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RAX, -8)
        asm.store(8, x64::Reg::R10, x64::Reg::RAX, 0)
        asm.alu_ri(5, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.jmp(inner)
        asm.bind(place)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        self.scale8(asm, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RSP, 24)
        asm.store(8, x64::Reg::R8, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.jmp(outer)
        asm.bind(done)
        asm.alu_ri(0, x64::Reg::RSP, 48)
        return true
    }

    // A lookup routine for one kind of key: the bucket of the key's hash is scanned for a node with that hash whose key
    // is equal, a String key comparing by its bytes and a scalar key by its word.
    fun map_find_routine(mut self, asm: &mut x64::Asm, label: u64, hash: u64, text: bool) {
        // rdi is the header, rsi the key (a cell, or a String header). The index is an open-addressed array of slots {hash, node}: the
        // probe starts at `hash & mask` and walks forward to an empty slot, so one cache line usually holds the whole probe. A slot
        // holds the hash and the byte offset of its entry in the dense array of entries at [header + 32] (offset 0 is never used). The
        // node is left in rax (0 when the key is missing) and its slot in rdx.
        asm.bind(label)
        asm.call_label(hash)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RSI)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RDI, 8)
        asm.alu_ri(5, x64::Reg::R10, 1)
        asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
        asm.alu_rr(33, x64::Reg::RCX, x64::Reg::R10)
        top := asm.new_label()
        next := asm.new_label()
        miss := asm.new_label()
        hit := asm.new_label()
        out := asm.new_label()
        asm.bind(top)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RCX)
        asm.shift_ri(4, x64::Reg::RDX, 4)
        asm.load(8, false, x64::Reg::R11, x64::Reg::RDI, 0)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::R11)
        asm.load(8, false, x64::Reg::R11, x64::Reg::RDX, 8)
        asm.test_rr(x64::Reg::R11, x64::Reg::R11)
        asm.jcc(x64::Cc::EQUAL, miss)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDX, 0)
        asm.alu_rr(57, x64::Reg::R9, x64::Reg::RAX)
        asm.jcc(x64::Cc::NOT_EQUAL, next)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDI, 32)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R9)
        when text {
            matched := asm.new_label()
            different := asm.new_label()
            asm.push(x64::Reg::RCX)
            asm.push(x64::Reg::R10)
            asm.push(x64::Reg::RDX)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::R11, 16)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
            asm.load(8, false, x64::Reg::R10, x64::Reg::R8, 8)
            asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R10)
            asm.jcc(x64::Cc::NOT_EQUAL, different)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::R8, 0)
            asm.load(8, false, x64::Reg::R9, x64::Reg::RDX, 0)
            bytes := asm.new_label()
            asm.bind(bytes)
            asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
            asm.jcc(x64::Cc::EQUAL, matched)
            asm.load(1, false, x64::Reg::R10, x64::Reg::RSI, 0)
            asm.load(1, false, x64::Reg::RDX, x64::Reg::R9, 0)
            asm.alu_rr(57, x64::Reg::R10, x64::Reg::RDX)
            asm.jcc(x64::Cc::NOT_EQUAL, different)
            asm.alu_ri(0, x64::Reg::RSI, 1)
            asm.alu_ri(0, x64::Reg::R9, 1)
            asm.alu_ri(5, x64::Reg::RCX, 1)
            asm.jmp(bytes)
            asm.bind(different)
            asm.pop(x64::Reg::RDX)
            asm.pop(x64::Reg::R10)
            asm.pop(x64::Reg::RCX)
            asm.jmp(next)
            asm.bind(matched)
            asm.pop(x64::Reg::RDX)
            asm.pop(x64::Reg::R10)
            asm.pop(x64::Reg::RCX)
            asm.jmp(hit)
        }
        when !text {
            asm.load(8, false, x64::Reg::R9, x64::Reg::R11, 16)
            asm.alu_rr(57, x64::Reg::R9, x64::Reg::R8)
            asm.jcc(x64::Cc::NOT_EQUAL, next)
            asm.jmp(hit)
        }
        asm.bind(next)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.alu_rr(33, x64::Reg::RCX, x64::Reg::R10)
        asm.jmp(top)
        asm.bind(hit)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::R11)
        asm.jmp(out)
        asm.bind(miss)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.bind(out)
        asm.ret()
    }

    // The clone of the String whose header is in rdi, left in rax: a new header with a copy of the bytes.
    fun string_clone_routine(mut self, asm: &mut x64::Asm) {
        asm.bind(self.string_clone_label)
        asm.push(x64::Reg::RDI)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 8)
        self.aligned_call(asm, String("malloc"))
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RCX, 0)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
        self.aligned_call(asm, String("memcpy"))
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 16)
        asm.alu_ri(0, x64::Reg::RSP, 16)
        asm.ret()
    }

    // The clone of the map whose header is in rdi, left in rax: a new header with the same buckets count, length and
    // sequence, and a copy of every node in its bucket. A String key or value is copied as a String. The frame holds the
    // bucket index, the new buckets, the new header, the source header, the node being copied and its copy.
    fun map_clone_routine(mut self, asm: &mut x64::Asm, label: u64, text_key: bool, text_value: bool, boxed: u64, owned: Vec<u64>) {
        // The frame: 0 the offset of the entry being cloned, 8 the new slots, 16 the new header, 24 the source header, 32 and
        // 40 the entry being cloned (the arrays are copied first, so the source and its copy are one memory).
        asm.bind(label)
        asm.alu_ri(5, x64::Reg::RSP, 48)
        asm.store(8, x64::Reg::RDI, x64::Reg::RSP, 24)
        asm.mov_ri(x64::Reg::RDI, 48)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 24)
        mut header_word: u64 = 1
        while header_word < 6 {
            asm.load(8, false, x64::Reg::R8, x64::Reg::RCX, (8 * header_word) as i64)
            asm.store(8, x64::Reg::R8, x64::Reg::RAX, (8 * header_word) as i64)
            header_word += 1
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RCX, 8)
        asm.shift_ri(4, x64::Reg::RDI, 4)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RCX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        asm.shift_ri(4, x64::Reg::RDX, 4)
        self.aligned_call(asm, String("memcpy"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RCX, 40)
        asm.alu_ri(0, x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::R11, 40)
        asm.imul_rr(x64::Reg::RDI, x64::Reg::R11)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 32)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RCX, 32)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 16)
        asm.alu_ri(0, x64::Reg::RDX, 1)
        asm.mov_ri(x64::Reg::R11, 40)
        asm.imul_rr(x64::Reg::RDX, x64::Reg::R11)
        self.aligned_call(asm, String("memcpy"))
        asm.mov_ri(x64::Reg::RAX, 40)
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 0)
        outer := asm.new_label()
        inner := asm.new_label()
        next := asm.new_label()
        done := asm.new_label()
        asm.bind(outer)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 16)
        asm.mov_ri(x64::Reg::R11, 40)
        asm.imul_rr(x64::Reg::R8, x64::Reg::R11)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::ABOVE, done)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDX, 32)
        asm.alu_rr(1, x64::Reg::R9, x64::Reg::RCX)
        asm.store(8, x64::Reg::R9, x64::Reg::RSP, 32)
        asm.store(8, x64::Reg::R9, x64::Reg::RSP, 40)
        asm.bind(inner)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 32)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
        asm.store(8, x64::Reg::R8, x64::Reg::RCX, 8)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 32)
        asm.store(8, x64::Reg::R8, x64::Reg::RCX, 32)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 16)
        when text_key {
            asm.call_label(self.string_clone_label)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
            asm.store(8, x64::Reg::RAX, x64::Reg::RCX, 16)
        }
        when !text_key {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
            asm.store(8, x64::Reg::RDI, x64::Reg::RCX, 16)
        }
        when boxed == 0 {
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 32)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 24)
            when text_value {
                asm.call_label(self.string_clone_label)
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
                asm.store(8, x64::Reg::RAX, x64::Reg::RCX, 24)
            }
            when !text_value && owned.len() == 0 {
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
                asm.store(8, x64::Reg::RDI, x64::Reg::RCX, 24)
            }
            // A handle value: the copy takes a clone of the handle.
            when !text_value && owned.len() > 0 {
                asm.call_label(self.copy_routine(asm, owned[1], owned[2]))
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
                asm.store(8, x64::Reg::RAX, x64::Reg::RCX, 24)
            }
        }
        // A boxed value: the source box is kept in the new node's value cell while the new box is allocated, then its
        // words are copied, and each owner in it is replaced by its clone.
        when boxed > 0 {
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 32)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 24)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
            asm.store(8, x64::Reg::RDI, x64::Reg::RCX, 24)
            asm.mov_ri(x64::Reg::RDI, 8 * boxed)
            self.aligned_call(asm, String("malloc"))
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 24)
            mut word: u64 = 0
            while word < boxed {
                asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, (8 * word) as i64)
                asm.store(8, x64::Reg::R8, x64::Reg::RAX, (8 * word) as i64)
                word += 1
            }
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
            asm.store(8, x64::Reg::RAX, x64::Reg::RCX, 24)
            mut at: u64 = 0
            while at < owned.len() {
                offset := owned[at]
                code := owned[at + 1]
                owner := owned[at + 2]
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
                asm.load(8, false, x64::Reg::RDI, x64::Reg::RCX, 24)
                asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, offset as i64)
                asm.call_label(self.copy_routine(asm, code, owner))
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
                asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 24)
                asm.store(8, x64::Reg::RAX, x64::Reg::RDX, offset as i64)
                at += 3
            }
        }
        asm.bind(next)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.alu_ri(0, x64::Reg::RCX, 40)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.jmp(outer)
        asm.bind(done)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 16)
        asm.alu_ri(0, x64::Reg::RSP, 48)
        asm.ret()
    }

    // The map header of a new map: no node, and the slots as a zeroed array of eight (16 bytes each).
    fun map_new(mut self, asm: &mut x64::Asm) -> bool {
        asm.mov_ri(x64::Reg::RDI, 48)
        self.aligned_call(asm, String("malloc"))
        asm.push(x64::Reg::RAX)
        self.map_arrays(asm)
        asm.pop(x64::Reg::RAX)
        return true
    }

    // Gives the header at [rsp] its first arrays: eight empty slots (16 bytes each) and room for four entries (40 bytes each,
    // and the unused entry 0), with a length of zero. Leaves the header in rdx.
    fun map_arrays(mut self, asm: &mut x64::Asm) {
        asm.mov_ri(x64::Reg::RDI, 8)
        asm.mov_ri(x64::Reg::RSI, 16)
        self.aligned_call(asm, String("calloc"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.mov_ri(x64::Reg::RDI, 200)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 32)
        asm.mov_ri(x64::Reg::RCX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.mov_ri(x64::Reg::RCX, 4)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 40)
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 16)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 24)
    }

    // The Option whose payload is `value`, when the program has one.
    fun option_of(self, value: u64) -> Option<u64> {
        mut index: u64 = 0
        while index < self.program.enums.len() {
            when self.program.enums[index].name.contains("RynOption#") {
                mut variant: u64 = 0
                while variant < self.program.enums[index].variants.len() {
                    when self.program.enums[index].variants[variant].name == "Some" && self.program.enums[index].variants[variant].fields.len() == 1 && self.same_type(self.program.enums[index].variants[variant].fields[0], value) {
                        return Option::Some(index)
                    }
                    variant += 1
                }
            }
            index += 1
        }
        return Option::None
    }

    // Whether two type ids name the same type: a scalar by its word, since the IR may name it under several ids.
    fun same_type(self, a: u64, b: u64) -> bool {
        when a == b {
            return true
        }
        // A structure may have more than one entry in the type table, so structures are the same when their ids are.
        return choose self.program.types[a] {
            ir::IrTy::Scalar(word) => choose self.program.types[b] {
                ir::IrTy::Scalar(other) => word == other,
                _ => false,
            },
            ir::IrTy::StructTy(id) => choose self.program.types[b] {
                ir::IrTy::StructTy(other) => id == other,
                _ => false,
            },
            ir::IrTy::EnumTy(id) => choose self.program.types[b] {
                ir::IrTy::EnumTy(other) => id == other,
                _ => false,
            },
            ir::IrTy::VecOf(element) => choose self.program.types[b] {
                ir::IrTy::VecOf(other) => self.same_type(element, other),
                _ => false,
            },
            ir::IrTy::MapOf(key, value) => choose self.program.types[b] {
                ir::IrTy::MapOf(other_key, other_value) => self.same_type(key, other_key) && self.same_type(value, other_value),
                _ => false,
            },
            ir::IrTy::SetOf(key, value) => choose self.program.types[b] {
                ir::IrTy::SetOf(other_key, other_value) => self.same_type(key, other_key) && self.same_type(value, other_value),
                _ => false,
            },
            _ => false,
        }
    }

    // A map's value that is a box of its own: a structure without owners. The node holds the box's pointer; the box holds the
    // structure's cells in the layout of one Vec element (cell `k` at `8 * (cells - 1 - k)` from its start).
    fun map_value_boxed(self, ty: u64) -> bool {
        return (self.is_element_structure(ty) || self.destructor_element(ty)) && !self.is_handle_struct(ty)
    }

    // A one-cell handle value that is not a String: a vector, map, set or enum. The node holds the handle itself.
    fun map_handle_value(self, ty: u64) -> bool {
        return self.is_owner_cell(ty) && !self.is_string(ty) && !self.is_handle_struct(ty)
    }

    // The owned cells of a boxed value, with their byte offsets from the box (see `owned_cells`), or an empty list.
    fun map_box_owned(self, ty: u64) -> Vec<u64> {
        mut list: Vec<u64> = Vec()
        owned := self.owned_cells(ty)
        when owned.is_some() {
            list = owned.unwrap()
        }
        return list
    }

    fun map_box_cells(self, ty: u64) -> u64 {
        when self.map_value_boxed(ty) {
            return self.cells_of(ty)
        }
        return 0
    }

    // A key or value of a map: a scalar or a String, one cell.
    // A structure key: a structure of integer, boolean and character fields, with no owner and no float. Its key is a text of
    // its words in slot order, which is the order the Rust runtime hashes and compares a key's words in.
    fun struct_key_ok(self, ty: u64) -> bool {
        id := self.struct_of(ty)
        when id.is_none() || self.has_owners(ty) {
            return false
        }
        mut field: u64 = 0
        while field < self.program.structs[id.unwrap()].fields.len() {
            field_ty := self.program.structs[id.unwrap()].fields[field].ty
            when self.struct_of(field_ty).is_some() {
                when !self.struct_key_ok(field_ty) {
                    return false
                }
            } else {
                word := self.word(field_ty)
                when !(is_integer_word(word.clone()) || word == "Bool" || word == "Char") {
                    return false
                }
            }
            field += 1
        }
        return true
    }

    // Whether a map key is kept as a text: a String, or a structure key.
    fun key_is_text(self, key: u64) -> bool {
        return self.is_string(key) || self.struct_key_ok(key)
    }

    // Writes the words of the structure at the slots from `base` into the key text whose data is in the slot `bytes`: word
    // `key_word` is the cell of each scalar field, normalized to its value as an eight-byte word.
    fun key_words(mut self, asm: &mut x64::Asm, base: u64, id: u64, bytes: u64) -> bool {
        mut field: u64 = 0
        while field < self.program.structs[id].fields.len() {
            field_ty := self.program.structs[id].fields[field].ty
            offset := self.program.structs[id].fields[field].slot_offset
            when self.struct_of(field_ty).is_some() {
                when !self.key_words(asm, base + offset, self.struct_of(field_ty).unwrap(), bytes) {
                    return false
                }
            } else {
                when !self.load_cell(asm, field_ty, x64::Reg::RBP, slot_disp(base + offset)) {
                    return false
                }
                // A narrow field is a word of its own bits, as the runtime reads it: its value is not sign-extended.
                width := width_of(self.word(field_ty))
                when width > 0 && width < 8 {
                    mut mask: u64 = 1
                    mask = (mask << ((8 * width) as u32)) - 1
                    asm.mov_ri(x64::Reg::RCX, mask)
                    asm.alu_rr(33, x64::Reg::RAX, x64::Reg::RCX)
                }
                asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(bytes))
                asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (offset + base - self.key_base)) as i64)
            }
            field += 1
        }
        return true
    }

    // The key text of a structure key, in rax: a text header whose data holds the words of the structure, so that the
    // text routines hash and compare it as the runtime does its words.
    fun struct_key_header(mut self, asm: &mut x64::Asm, key: u64, ty: u64) -> bool {
        id := self.struct_of(ty).unwrap()
        count := self.cells_of(ty)
        mut base: u64 = 0
        when self.place_of(key).is_some() {
            base = self.place_of(key).unwrap()
        } else {
            base = self.scratch(count)
            when !self.store_into(asm, key, base, ty) {
                return false
            }
        }
        bytes := self.scratch(1)
        asm.mov_ri(x64::Reg::RDI, 8 * count)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(bytes))
        self.key_base = base
        when !self.key_words(asm, base, id, bytes) {
            return false
        }
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, slot_disp(bytes))
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.mov_ri(x64::Reg::RCX, 8 * count)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        return true
    }

    // The key of a map operation, in rax: a structure key is built as its text, any other key is evaluated.
    fun map_key_value(mut self, asm: &mut x64::Asm, key: u64, struct_ty: u64) -> bool {
        when struct_ty != 0 {
            return self.struct_key_header(asm, key, struct_ty)
        }
        return self.expr(asm, key)
    }

    // Frees a structure key's text: its data, then its header.
    // The key cell is at rdi: its header is the text, and the header's data is freed before the header.
    fun struct_key_drop_routine(mut self, asm: &mut x64::Asm, label: u64) {
        asm.bind(label)
        asm.push(x64::Reg::RDI)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 0)
        asm.push(x64::Reg::RDI)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 0)
        self.aligned_call(asm, String("free"))
        asm.pop(x64::Reg::RDI)
        self.aligned_call(asm, String("free"))
        asm.pop(x64::Reg::RDI)
        asm.ret()
    }

    fun map_cell(self, ty: u64) -> bool {
        return self.is_string(ty) || self.is_handle_struct(ty) || choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => string_width(word) != 0,
            _ => false,
        }
    }

    // A map operation. A key is hashed and compared by its word, or by its text for a String; the values are cells.
    fun map_op(mut self, asm: &mut x64::Asm, op: String, key: u64, value: u64, arguments: Vec<u64>) -> bool {
        self.map_value_type = value
        when !(self.map_cell(key) || self.struct_key_ok(key)) || !(self.map_cell(value) || self.map_value_boxed(value) || self.map_handle_value(value)) {
            return self.fail("a map of this type")
        }
        // A boxed value with a destructor is dropped where its box lies, by insert, remove, clear and the scope's drop. The
        // operations that copy a value out (get, values, clone) are not written for it.
        when self.map_value_boxed(value) && self.destructor_element(value) && !(op == "New" || op == "Len" || op == "IsEmpty" || op == "Keys" || op == "ContainsKey" || op == "Insert" || op == "Remove" || op == "Clear") {
            return self.op_fail("a map of destructor values and ", op)
        }
        // A structure key is a text of its words; the structure is passed to the key evaluation, which builds that text.
        text_key := self.key_is_text(key)
        mut struct_ty: u64 = 0
        when self.struct_of(key).is_some() {
            struct_ty = key
        }
        when op == "New" && arguments.len() == 0 {
            return self.map_new(asm)
        }
        when op == "Len" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 16)
            return true
        }
        when op == "IsEmpty" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 16)
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            return true
        }
        when (op == "Keys" || op == "Values") && arguments.len() == 1 {
            mut key_cells: u64 = 0
            when op == "Keys" && struct_ty != 0 {
                key_cells = self.cells_of(struct_ty)
            }
            return self.map_collect(asm, arguments[0], op == "Keys", if_text(op == "Keys", text_key, self.is_string(value)), self.is_handle_struct(value), key_cells)
        }
        when op == "Clear" && arguments.len() == 1 {
            clear := asm.new_label()
            skip := asm.new_label()
            asm.jmp(skip)
            asm.bind(clear)
            when !self.emit_map_free(asm, key, value, false) { return false }
            asm.bind(skip)
            when !self.expr(asm, arguments[0]) { return false }
            asm.push(x64::Reg::RAX)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.call_label(clear)
            asm.pop(x64::Reg::RAX)
            asm.push(x64::Reg::RAX)
            self.map_arrays(asm)
            asm.pop(x64::Reg::RAX)
            return true
        }
        when op == "ContainsKey" && arguments.len() == 2 {
            when !self.find_key(asm, arguments[0], arguments[1], text_key, struct_ty) {
                return false
            }
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.setcc(x64::Cc::NOT_EQUAL, x64::Reg::RAX)
            return true
        }
        when op == "Insert" && arguments.len() == 3 {
            return self.map_insert(asm, arguments[0], arguments[1], arguments[2], text_key, self.map_box_cells(value), struct_ty)
        }
        when op == "Get" && arguments.len() == 2 {
            return self.map_get(asm, arguments[0], arguments[1], value, text_key, struct_ty)
        }
        when op == "Remove" && arguments.len() == 2 {
            return self.map_remove(asm, arguments[0], arguments[1], text_key, struct_ty)
        }
        when op == "Clone" && arguments.len() == 1 && (self.map_value_boxed(value) || self.map_handle_value(value)) {
            skip := asm.new_label()
            label := asm.new_label()
            asm.jmp(skip)
            self.map_clone_routine(asm, label, text_key, false, self.map_box_cells(value), self.map_box_owned(value))
            asm.bind(skip)
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.call_label(label)
            return true
        }
        when op == "Clone" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            when text_key && self.is_string(value) {
                asm.call_label(self.map_clone_both_text)
            }
            when text_key && !self.is_string(value) {
                asm.call_label(self.map_clone_key_text)
            }
            when !text_key && self.is_string(value) {
                asm.call_label(self.map_clone_value_text)
            }
            when !text_key && !self.is_string(value) {
                asm.call_label(self.map_clone_plain)
            }
            return true
        }
        return self.op_fail("a map operation ", op)
    }

    // `keys()` and `values()`: a new vector of copies, in the order of the hashes of the keys (the order the runtime walks its
    // map in; keys with the same hash are in an unspecified order). The nodes are collected, sorted by hash with a shell
    // sort, and copied; a String is copied with its text.
    fun map_collect(mut self, asm: &mut x64::Asm, map: u64, keys: bool, text: bool, handle: bool, key_cells: u64) -> bool {
        when handle && !keys {
            return self.fail("the values of a map of values with destructors")
        }
        boxed := !keys && self.map_box_cells(self.map_value_type) > 0
        mut width: u64 = 1
        when boxed {
            width = self.cells_of(self.map_value_type)
        }
        when key_cells > 0 {
            width = key_cells
        }
        when !self.expr(asm, map) {
            return false
        }
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 64)
        // Locals: -8 map, -16 nodes, -24 count, -32 i, -40 data, -48 header, -56 j, -64 gap.
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 24)
        asm.lea(x64::Reg::RDI, x64::Reg::RCX, 1)
        self.scale_bytes(asm, x64::Reg::RDI, 8)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 16)
        // The nodes, bucket by bucket.
        asm.mov_ri(x64::Reg::RAX, 40)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        bucket_top := asm.new_label()
        bucket_done := asm.new_label()
        asm.bind(bucket_top)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 8)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 16)
        asm.mov_ri(x64::Reg::R11, 40)
        asm.imul_rr(x64::Reg::RCX, x64::Reg::R11)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE, bucket_done)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 32)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        self.scale_bytes(asm, x64::Reg::R9, 8)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::R9)
        asm.store(8, x64::Reg::R8, x64::Reg::R10, 0)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.alu_ri(0, x64::Reg::RAX, 40)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.jmp(bucket_top)
        asm.bind(bucket_done)
        // A shell sort of the nodes by hash: -64 is the gap, -32 the position i, -56 the position j.
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
        asm.mov_ri(x64::Reg::RCX, 1)
        asm.shift_cl(5, x64::Reg::RAX)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 64)
        gap_top := asm.new_label()
        gap_done := asm.new_label()
        i_top := asm.new_label()
        i_done := asm.new_label()
        j_top := asm.new_label()
        j_done := asm.new_label()
        asm.bind(gap_top)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 64)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, gap_done)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.bind(i_top)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 24)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, i_done)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        // The node being placed is kept in -48 for the duration of the inner loop.
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::R8, x64::Reg::R10, 0)
        asm.store(8, x64::Reg::R8, x64::Reg::RBP, (0 as i64) - 48)
        asm.bind(j_top)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 64)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::BELOW, j_done)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::RDX)
        asm.load(8, false, x64::Reg::R9, x64::Reg::R10, 0)
        asm.load(8, false, x64::Reg::R11, x64::Reg::R9, 8)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RBP, (0 as i64) - 48)
        asm.load(8, false, x64::Reg::R8, x64::Reg::R8, 8)
        asm.alu_rr(57, x64::Reg::R11, x64::Reg::R8)
        asm.jcc(x64::Cc::BELOW_EQUAL, j_done)
        // nodes[j] = nodes[j - gap]
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::RAX)
        asm.store(8, x64::Reg::R9, x64::Reg::R10, 0)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        asm.alu_rr(41, x64::Reg::RAX, x64::Reg::RCX)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        asm.jmp(j_top)
        asm.bind(j_done)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 56)
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RBP, (0 as i64) - 48)
        asm.store(8, x64::Reg::R8, x64::Reg::R10, 0)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.jmp(i_top)
        asm.bind(i_done)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 64)
        asm.mov_ri(x64::Reg::RCX, 1)
        asm.shift_cl(5, x64::Reg::RAX)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 64)
        asm.jmp(gap_top)
        asm.bind(gap_done)
        // The vector: its header and a data block of one element per node, each the cells of a boxed structure value.
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 48)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 24)
        asm.alu_ri(0, x64::Reg::RDI, 1)
        self.scale_bytes(asm, x64::Reg::RDI, 8 * width)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 40)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 48)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 24)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 16)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        copy_top := asm.new_label()
        copy_done := asm.new_label()
        asm.bind(copy_top)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 24)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, copy_done)
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RBP, (0 as i64) - 16)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::R10, x64::Reg::R10, 0)
        mut field: i64 = 24
        when keys {
            field = 16
        }
        // A structure key: the words of its text are the cells of the element, the first word at the top of the element, as a
        // structure in memory lies.
        when key_cells > 0 {
            asm.load(8, false, x64::Reg::RSI, x64::Reg::R10, 16)
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RSI, 0)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
            self.scale_bytes(asm, x64::Reg::RAX, 8 * width)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 40)
            asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RAX)
            mut word: u64 = 0
            while word < key_cells {
                asm.load(8, false, x64::Reg::R8, x64::Reg::RSI, (8 * word) as i64)
                asm.store(8, x64::Reg::R8, x64::Reg::RDX, (8 * (key_cells - 1 - word)) as i64)
                word += 1
            }
        }
        when !boxed && key_cells == 0 {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::R10, field)
            when text {
                asm.call_label(self.string_clone_label)
                asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            }
            when !keys && self.map_handle_value(self.map_value_type) {
                asm.call_label(self.copy_routine(asm, self.map_box_owned(self.map_value_type)[1], self.map_box_owned(self.map_value_type)[2]))
                asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
            self.scale_bytes(asm, x64::Reg::RAX, 8)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 40)
            asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RAX)
            asm.store(8, x64::Reg::RDI, x64::Reg::RDX, 0)
        }
        // A boxed value: its cells are copied from the box, word for word, into the element's cells.
        when boxed {
            asm.load(8, false, x64::Reg::RSI, x64::Reg::R10, 24)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
            self.scale_bytes(asm, x64::Reg::RAX, 8 * width)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 40)
            asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RAX)
            mut word: u64 = 0
            while word < width {
                asm.load(8, false, x64::Reg::R8, x64::Reg::RSI, (8 * word) as i64)
                asm.store(8, x64::Reg::R8, x64::Reg::RDX, (8 * word) as i64)
                word += 1
            }
            owned := self.map_box_owned(self.map_value_type)
            mut at: u64 = 0
            while at < owned.len() {
                asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
                self.scale_bytes(asm, x64::Reg::RAX, 8 * width)
                asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 40)
                asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RAX)
                asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, owned[at] as i64)
                asm.call_label(self.copy_routine(asm, owned[at + 1], owned[at + 2]))
                asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
                asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
                self.scale_bytes(asm, x64::Reg::RAX, 8 * width)
                asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 40)
                asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RAX)
                asm.store(8, x64::Reg::RCX, x64::Reg::RDX, owned[at] as i64)
                at += 3
            }
        }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
        asm.jmp(copy_top)
        asm.bind(copy_done)
        // The temporary array of the nodes is freed; the vector keeps its own data block.
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 16)
        self.aligned_call(asm, String("free"))
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 48)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        return true
    }

    // The node of a key in a map, left in rax: the map is evaluated first, then the key.
    fun find_key(mut self, asm: &mut x64::Asm, map: u64, key: u64, text: bool, struct_ty: u64) -> bool {
        when !self.expr(asm, map) {
            return false
        }
        asm.push(x64::Reg::RAX)
        temp := self.scratch(1)
        when !self.map_key_value(asm, key, struct_ty) {
            return false
        }
        when struct_ty != 0 {
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(temp))
        }
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RAX)
        asm.pop(x64::Reg::RDI)
        when text {
            asm.call_label(self.map_find_string)
        }
        when !text {
            asm.call_label(self.map_find_scalar)
        }
        // A structure key built for the lookup is not kept by the map: its text is freed once the lookup is done.
        when struct_ty != 0 {
            asm.push(x64::Reg::RAX)
            asm.lea(x64::Reg::RDI, x64::Reg::RBP, slot_disp(temp))
            asm.call_label(self.struct_key_drop)
            asm.pop(x64::Reg::RAX)
        }
        return true
    }

    // `insert(key, value)`: an existing key takes the new value and the call returns 1; a new key gets a node, is linked
    // into its bucket, and the map doubles when it has more nodes than buckets. The call returns 0.
    fun map_insert(mut self, asm: &mut x64::Asm, map: u64, key: u64, value: u64, text: bool, boxed: u64, struct_ty: u64) -> bool {
        when !self.expr(asm, map) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.map_key_value(asm, key, struct_ty) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when boxed == 0 {
            when !self.expr(asm, value) {
                return false
            }
            asm.push(x64::Reg::RAX)
        }
        when boxed > 0 {
            // The value is evaluated into cells of its own, then copied into a new box, whose pointer is the value.
            held := self.scratch(boxed)
            when !self.store_into(asm, value, held, self.map_value_type) {
                return false
            }
            asm.mov_ri(x64::Reg::RDI, 8 * boxed)
            self.aligned_call(asm, String("malloc"))
            mut cell: u64 = 0
            while cell < boxed {
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, slot_disp(held + cell))
                asm.store(8, x64::Reg::RCX, x64::Reg::RAX, (8 * (boxed - 1 - cell)) as i64)
                cell += 1
            }
            asm.push(x64::Reg::RAX)
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
        when text {
            asm.call_label(self.map_find_string)
        }
        when !text {
            asm.call_label(self.map_find_scalar)
        }
        fresh := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, fresh)
        when boxed > 0 {
            asm.push(x64::Reg::RAX)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RAX, 24)
            when self.has_owners(self.map_value_type) {
                asm.push(x64::Reg::RDI)
                asm.lea(x64::Reg::RDI, x64::Reg::RDI, (8 * (boxed - 1)) as i64)
                asm.call_label(self.value_drop_routine(asm, self.map_value_type, false))
                asm.pop(x64::Reg::RDI)
            }
            self.aligned_call(asm, String("free"))
            asm.pop(x64::Reg::RAX)
        }
        when self.handle_destructor(self.map_value_type).is_some() {
            fid := self.handle_destructor(self.map_value_type).unwrap()
            self.needed.set(fid, true)
            asm.push(x64::Reg::RAX)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 24)
            asm.push(x64::Reg::RCX)
            asm.call_label(self.labels[fid])
            asm.alu_ri(0, x64::Reg::RSP, 8)
            asm.pop(x64::Reg::RAX)
        }
        when self.handle_destructor(self.map_value_type).is_none() && self.has_owners(self.map_value_type) && !self.map_value_boxed(self.map_value_type) {
            asm.push(x64::Reg::RAX)
            asm.lea(x64::Reg::RDI, x64::Reg::RAX, 24)
            asm.call_label(self.value_drop_routine(asm, self.map_value_type, false))
            asm.pop(x64::Reg::RAX)
        }
        when text {
            asm.push(x64::Reg::RAX)
            when struct_ty != 0 {
                asm.lea(x64::Reg::RDI, x64::Reg::RSP, 16)
                asm.call_label(self.struct_key_drop)
            } else {
                asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
                asm.call_label(self.handle_drop_routine(asm, self.string_type()))
            }
            asm.pop(x64::Reg::RAX)
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 24)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.jmp(done)
        asm.bind(fresh)
        // The entry array has room for one more, or doubles (the slots hold offsets, so they stay valid).
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 16)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RDI, 40)
        room := asm.new_label()
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        asm.jcc(x64::Cc::BELOW, room)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RDX)
        asm.store(8, x64::Reg::RDX, x64::Reg::RDI, 40)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RDX)
        asm.alu_ri(0, x64::Reg::RSI, 1)
        asm.mov_ri(x64::Reg::R11, 40)
        asm.imul_rr(x64::Reg::RSI, x64::Reg::R11)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 32)
        self.aligned_call(asm, String("realloc"))
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDI, 32)
        asm.bind(room)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
        when text {
            asm.call_label(self.map_hash_string)
        }
        when !text {
            asm.call_label(self.map_hash_scalar)
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 16)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDI, 16)
        asm.mov_ri(x64::Reg::R11, 40)
        asm.imul_rr(x64::Reg::RCX, x64::Reg::R11)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RDI, 32)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::RCX)
        asm.store(8, x64::Reg::RAX, x64::Reg::R10, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::R10, 16)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::R10, 24)
        asm.mov_ri(x64::Reg::RDX, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::R10, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::R10, 32)
        // The entry takes the first empty slot from `hash & mask` on.
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDI, 8)
        asm.alu_ri(5, x64::Reg::R8, 1)
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        asm.alu_rr(33, x64::Reg::R9, x64::Reg::R8)
        place := asm.new_label()
        free_slot := asm.new_label()
        asm.bind(place)
        asm.mov_rr(x64::Reg::R10, x64::Reg::R9)
        asm.shift_ri(4, x64::Reg::R10, 4)
        asm.load(8, false, x64::Reg::R11, x64::Reg::RDI, 0)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::R11)
        asm.load(8, false, x64::Reg::R11, x64::Reg::R10, 8)
        asm.test_rr(x64::Reg::R11, x64::Reg::R11)
        asm.jcc(x64::Cc::EQUAL, free_slot)
        asm.alu_ri(0, x64::Reg::R9, 1)
        asm.alu_rr(33, x64::Reg::R9, x64::Reg::R8)
        asm.jmp(place)
        asm.bind(free_slot)
        asm.store(8, x64::Reg::RAX, x64::Reg::R10, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::R10, 8)
        // More than half the slots taken: the slots double.
        nogrow := asm.new_label()
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 16)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDI, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::BELOW_EQUAL, nogrow)
        asm.call_label(self.map_grow)
        asm.bind(nogrow)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.bind(done)
        return true
    }

    // `get(key)`: the Option of the value of a scalar value, or None; the value is copied into the box.
    fun map_get(mut self, asm: &mut x64::Asm, map: u64, key: u64, value: u64, text: bool, struct_ty: u64) -> bool {
        option := self.option_of(value)
        when option.is_none() {
            return self.fail("a map get without an Option of its value")
        }
        some := self.variant_tag(option.unwrap(), String("Some"))
        none := self.variant_tag(option.unwrap(), String("None"))
        when some.is_none() || none.is_none() {
            return self.fail("a map get without an Option of its value")
        }
        when !self.find_key(asm, map, key, text, struct_ty) {
            return false
        }
        missing := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, missing)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 24)
        when self.map_box_cells(value) > 0 {
            // The value is a box: the Option holds its cells, word `m` of the box at `8 * (cells - m)`, as `vec_get_option` lays them.
            cells := self.map_box_cells(value)
            asm.push(x64::Reg::RAX)
            asm.mov_ri(x64::Reg::RDI, 8 * (1 + cells))
            self.aligned_call(asm, String("malloc"))
            asm.pop(x64::Reg::RDX)
            asm.mov_ri(x64::Reg::RCX, some.unwrap())
            asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
            mut word: u64 = 0
            while word < cells {
                asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, (8 * word) as i64)
                asm.store(8, x64::Reg::R8, x64::Reg::RAX, (8 * (cells - word)) as i64)
                word += 1
            }
            // The owners of the copy are clones: a box word at `offset` is the Option's word at `8 * (cells - offset / 8)`.
            owned := self.map_box_owned(value)
            asm.push(x64::Reg::RAX)
            mut at: u64 = 0
            while at < owned.len() {
                disp := (8 * (cells - owned[at] / 8)) as i64
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
                asm.load(8, false, x64::Reg::RDI, x64::Reg::RCX, disp)
                asm.call_label(self.copy_routine(asm, owned[at + 1], owned[at + 2]))
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
                asm.store(8, x64::Reg::RAX, x64::Reg::RCX, disp)
                at += 3
            }
            asm.pop(x64::Reg::RAX)
            asm.jmp(done)
        }
        when self.map_box_cells(value) == 0 {
        when self.map_handle_value(value) {
            owned := self.map_box_owned(value)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.call_label(self.copy_routine(asm, owned[1], owned[2]))
        }
        when self.is_string(value) {
            self.clone_header(asm)
        }
        asm.push(x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.pop(x64::Reg::RCX)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.mov_ri(x64::Reg::RDX, some.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.jmp(done)
        }
        asm.bind(missing)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RDX, none.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `remove(key)`: the node is unlinked from its bucket and the call returns 1; a key that is not there gives 0.
    fun map_remove(mut self, asm: &mut x64::Asm, map: u64, key: u64, text: bool, struct_ty: u64) -> bool {
        when !self.expr(asm, map) {
            return false
        }
        asm.push(x64::Reg::RAX)
        temp := self.scratch(1)
        when !self.map_key_value(asm, key, struct_ty) {
            return false
        }
        when struct_ty != 0 {
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(temp))
        }
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        when text {
            asm.call_label(self.map_find_string)
        }
        when !text {
            asm.call_label(self.map_find_scalar)
        }
        missing := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, missing)
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
        when text {
            asm.call_label(self.map_hash_string)
        }
        when !text {
            asm.call_label(self.map_hash_scalar)
        }
        // The slot of the node is found again from its hash.
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDI, 8)
        asm.alu_ri(5, x64::Reg::R8, 1)
        asm.alu_rr(33, x64::Reg::RAX, x64::Reg::R8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDI, 32)
        asm.alu_rr(41, x64::Reg::RCX, x64::Reg::R9)
        // Linear probing from the home slot to the one that holds the node, then a backward shift: each later slot of the run whose
        // home is not between the hole and itself moves into the hole.
        find_slot := asm.new_label()
        found_slot := asm.new_label()
        asm.bind(find_slot)
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        asm.shift_ri(4, x64::Reg::R9, 4)
        asm.load(8, false, x64::Reg::R10, x64::Reg::RDI, 0)
        asm.alu_rr(1, x64::Reg::R9, x64::Reg::R10)
        asm.load(8, false, x64::Reg::R10, x64::Reg::R9, 8)
        asm.alu_rr(57, x64::Reg::R10, x64::Reg::RCX)
        asm.jcc(x64::Cc::EQUAL, found_slot)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.alu_rr(33, x64::Reg::RAX, x64::Reg::R8)
        asm.jmp(find_slot)
        asm.bind(found_slot)
        // rax is the hole's index, r8 the mask. r10 scans forward.
        shift_top := asm.new_label()
        shift_done := asm.new_label()
        shift_next := asm.new_label()
        asm.mov_rr(x64::Reg::R10, x64::Reg::RAX)
        asm.bind(shift_top)
        asm.alu_ri(0, x64::Reg::R10, 1)
        asm.alu_rr(33, x64::Reg::R10, x64::Reg::R8)
        asm.mov_rr(x64::Reg::R11, x64::Reg::R10)
        asm.shift_ri(4, x64::Reg::R11, 4)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RDI, 0)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::RDX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::R11, 8)
        asm.test_rr(x64::Reg::RDX, x64::Reg::RDX)
        asm.jcc(x64::Cc::EQUAL, shift_done)
        // The home slot of the node at r10 is `hash & mask` (rsi); it may move into the hole (rax) unless its home lies cyclically
        // in (hole, scan]: that is, unless (home - hole - 1) & mask < (scan - hole) & mask.
        asm.load(8, false, x64::Reg::RSI, x64::Reg::R11, 0)
        asm.alu_rr(33, x64::Reg::RSI, x64::Reg::R8)
        asm.alu_rr(41, x64::Reg::RSI, x64::Reg::RAX)
        asm.alu_ri(5, x64::Reg::RSI, 1)
        asm.alu_rr(33, x64::Reg::RSI, x64::Reg::R8)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::R10)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RAX)
        asm.alu_rr(33, x64::Reg::RDX, x64::Reg::R8)
        asm.alu_rr(57, x64::Reg::RSI, x64::Reg::RDX)
        asm.jcc(x64::Cc::BELOW, shift_next)
        // Move the slot at r10 into the hole at rax; the hole becomes r10.
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        asm.shift_ri(4, x64::Reg::R9, 4)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RDI, 0)
        asm.alu_rr(1, x64::Reg::R9, x64::Reg::RDX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::R11, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::R9, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::R11, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::R9, 8)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::R10)
        asm.bind(shift_next)
        asm.jmp(shift_top)
        asm.bind(shift_done)
        // The last hole is emptied.
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        asm.shift_ri(4, x64::Reg::R9, 4)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RDI, 0)
        asm.alu_rr(1, x64::Reg::R9, x64::Reg::RDX)
        asm.mov_ri(x64::Reg::RDX, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::R9, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::R9, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 16)
        asm.alu_ri(5, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDI, 16)
        when self.handle_destructor(self.map_value_type).is_some() {
            fid := self.handle_destructor(self.map_value_type).unwrap()
            self.needed.set(fid, true)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 24)
            asm.push(x64::Reg::RAX)
            asm.call_label(self.labels[fid])
            asm.alu_ri(0, x64::Reg::RSP, 8)
        }
        when self.handle_destructor(self.map_value_type).is_none() && self.has_owners(self.map_value_type) && !self.map_value_boxed(self.map_value_type) {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
            asm.alu_ri(0, x64::Reg::RDI, 24)
            asm.call_label(self.value_drop_routine(asm, self.map_value_type, false))
        }
        when text && struct_ty != 0 {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
            asm.alu_ri(0, x64::Reg::RDI, 16)
            asm.call_label(self.struct_key_drop)
        }
        when text && struct_ty == 0 {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
            asm.alu_ri(0, x64::Reg::RDI, 16)
            asm.call_label(self.value_drop_routine(asm, self.string_type(), false))
        }
        when self.map_value_boxed(self.map_value_type) && self.has_owners(self.map_value_type) {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 24)
            kept_cells := self.cells_of(self.map_value_type)
            asm.alu_ri(0, x64::Reg::RDI, (8 * (kept_cells - 1)) as i64)
            asm.call_label(self.value_drop_routine(asm, self.map_value_type, false))
        }
        when self.map_value_boxed(self.map_value_type) {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 24)
            self.aligned_call(asm, String("free"))
        }
        // The last entry moves into the hole the removed one leaves, and the slot of the moved entry follows it.
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, 16)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.mov_ri(x64::Reg::R11, 40)
        asm.imul_rr(x64::Reg::RCX, x64::Reg::R11)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RDI, 32)
        asm.mov_rr(x64::Reg::R10, x64::Reg::R9)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        stay := asm.new_label()
        asm.alu_rr(57, x64::Reg::RDX, x64::Reg::R10)
        asm.jcc(x64::Cc::EQUAL, stay)
        mut word: u64 = 0
        while word < 5 {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::R10, (8 * word) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * word) as i64)
            word += 1
        }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDI, 8)
        asm.alu_ri(5, x64::Reg::RSI, 1)
        asm.alu_rr(33, x64::Reg::RAX, x64::Reg::RSI)
        refix := asm.new_label()
        refixed := asm.new_label()
        asm.bind(refix)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RAX)
        asm.shift_ri(4, x64::Reg::R8, 4)
        asm.load(8, false, x64::Reg::R11, x64::Reg::RDI, 0)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R11)
        asm.load(8, false, x64::Reg::R11, x64::Reg::R8, 8)
        asm.alu_rr(57, x64::Reg::R11, x64::Reg::RCX)
        asm.jcc(x64::Cc::EQUAL, refixed)
        asm.alu_ri(0, x64::Reg::RAX, 1)
        asm.alu_rr(33, x64::Reg::RAX, x64::Reg::RSI)
        asm.jmp(refix)
        asm.bind(refixed)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::R9)
        asm.store(8, x64::Reg::RDX, x64::Reg::R8, 8)
        asm.bind(stay)
        self.free_lookup_key(asm, temp, struct_ty)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.jmp(done)
        asm.bind(missing)
        self.free_lookup_key(asm, temp, struct_ty)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.alu_ri(0, x64::Reg::RSP, 16)
        asm.bind(done)
        return true
    }

    // Frees the text of a structure key that a lookup built, which the map does not keep.
    fun free_lookup_key(mut self, asm: &mut x64::Asm, temp: u64, struct_ty: u64) {
        when struct_ty != 0 {
            asm.lea(x64::Reg::RDI, x64::Reg::RBP, slot_disp(temp))
            asm.call_label(self.struct_key_drop)
        }
    }

    // The owned String that a `str` argument is converted from, when the argument is one.
    fun as_str_inner(self, index: u64) -> Option<u64> {
        return choose self.program.exprs[index] {
            ir::IrExpr::StringAsStr(inner) => Option::Some(inner),
            _ => Option::None,
        }
    }

    // `String(n)` of an integer: its digits are written backwards into a frame buffer, then copied into a malloc'd text,
    // and the header is {data, length, length}. A negative signed value takes a minus sign first. The frame holds the
    // buffer (24 bytes), the text's length, its data, the digit position and the header.
    fun string_from_integer(mut self, asm: &mut x64::Asm, value: u64, signed: bool) -> bool {
        when !self.expr(asm, value) {
            return false
        }
        asm.alu_ri(5, x64::Reg::RSP, 56)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RAX)
        asm.mov_ri(x64::Reg::R9, 0)
        when signed {
            positive := asm.new_label()
            asm.test_rr(x64::Reg::R11, x64::Reg::R11)
            asm.jcc(x64::Cc::GREATER_EQUAL, positive)
            asm.unary(3, x64::Reg::R11)
            asm.mov_ri(x64::Reg::R9, 1)
            asm.bind(positive)
        }
        // The digits, the last first: r10 is the position, starting past the buffer's end.
        asm.mov_ri(x64::Reg::R10, 24)
        digits := asm.new_label()
        asm.bind(digits)
        asm.alu_ri(5, x64::Reg::R10, 1)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::R11)
        asm.mov_ri(x64::Reg::RDX, 0)
        asm.mov_ri(x64::Reg::RCX, 10)
        asm.unary(6, x64::Reg::RCX)
        asm.alu_ri(0, x64::Reg::RDX, 48)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RSP)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R10)
        asm.store(1, x64::Reg::RDX, x64::Reg::R8, 0)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RAX)
        asm.test_rr(x64::Reg::R11, x64::Reg::R11)
        asm.jcc(x64::Cc::NOT_EQUAL, digits)
        // The minus sign of a negative value, then the length of the text and its position in the buffer.
        unsigned := asm.new_label()
        asm.test_rr(x64::Reg::R9, x64::Reg::R9)
        asm.jcc(x64::Cc::EQUAL, unsigned)
        asm.alu_ri(5, x64::Reg::R10, 1)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RSP)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R10)
        asm.mov_ri(x64::Reg::RDX, 45)
        asm.store(1, x64::Reg::RDX, x64::Reg::R8, 0)
        asm.bind(unsigned)
        asm.mov_ri(x64::Reg::RCX, 24)
        asm.alu_rr(41, x64::Reg::RCX, x64::Reg::R10)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 24)
        asm.store(8, x64::Reg::R10, x64::Reg::RSP, 40)
        // The text is copied from the buffer into its own memory, and the header is made.
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RCX)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 40)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 24)
        self.aligned_call(asm, String("memcpy"))
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 48)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 32)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 24)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 48)
        asm.alu_ri(0, x64::Reg::RSP, 56)
        return true
    }

    // The byte at `index` of a String, which fails past its end, as the runtime does.
    fun string_byte_at(mut self, asm: &mut x64::Asm, text: u64, index: u64, message: String) -> bool {
        when !self.expr(asm, index) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.load_string_parts(asm, text) {
            return false
        }
        asm.pop(x64::Reg::RCX)
        ok := asm.new_label()
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        asm.jcc(x64::Cc::BELOW, ok)
        self.fail_exit(asm, message)
        asm.bind(ok)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::RCX)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::R8, 0)
        return true
    }

    // Fails unless the offset in the frame at `offset` is on a character boundary of the text, whose data is at 0 and
    // length at 8 of the frame: the end of the text, the start, or a byte that is not a continuation byte.
    fun slice_boundary(mut self, asm: &mut x64::Asm, offset: i64, message: String) {
        ok := asm.new_label()
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, offset)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        asm.jcc(x64::Cc::EQUAL, ok)
        asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
        asm.jcc(x64::Cc::EQUAL, ok)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::RSI, 0)
        asm.alu_ri(4, x64::Reg::RAX, 192)
        asm.alu_ri(7, x64::Reg::RAX, 128)
        asm.jcc(x64::Cc::NOT_EQUAL, ok)
        self.fail_exit(asm, message)
        asm.bind(ok)
    }

    // `slice(start, end)` of a String by bytes: a new String with the bytes from start to end. The range must be in order
    // and within the text, and each end must lie on a character boundary, as the runtime checks. The frame has the same
    // slots as `substring`: the data, length, the two offsets, the copy and its header, and the end and start above.
    fun string_slice(mut self, asm: &mut x64::Asm, text: u64, start: u64, end: u64) -> bool {
        message := String("Ryn runtime error: String slice must use ordered in-bounds UTF-8 byte boundaries\n")
        when !self.expr(asm, start) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, end) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.alu_ri(5, x64::Reg::RSP, 48)
        when !self.load_string_parts(asm, text) {
            return false
        }
        asm.store(8, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 56)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 48)
        ordered := asm.new_label()
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::BELOW_EQUAL, ordered)
        self.fail_exit(asm, message.clone())
        asm.bind(ordered)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        inside := asm.new_label()
        asm.jcc(x64::Cc::BELOW_EQUAL, inside)
        self.fail_exit(asm, message.clone())
        asm.bind(inside)
        // Each end is on a boundary: the start or end is the length or 0, or else its byte is not a continuation byte.
        self.slice_boundary(asm, 56, message.clone())
        self.slice_boundary(asm, 48, message.clone())
        // The copy: malloc(end - start), then memcpy(copy, data + start, end - start).
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 48)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 56)
        asm.alu_rr(41, x64::Reg::RDI, x64::Reg::RCX)
        asm.store(8, x64::Reg::RDI, x64::Reg::RSP, 24)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 56)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 24)
        self.aligned_call(asm, String("memcpy"))
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 40)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 32)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 24)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 40)
        asm.alu_ri(0, x64::Reg::RSP, 64)
        return true
    }

    // `substring(start, end)` of a String, by character: a new String with the bytes between the two character offsets.
    // The offsets are found with the same walk as `char_at`, and an out-of-order or out-of-range pair fails. The values
    // live in one frame of 48 bytes: the text's data, length, the two byte offsets, the copy and its header; the end and
    // start indices are the two words above them.
    fun string_slice_chars(mut self, asm: &mut x64::Asm, text: u64, start: u64, end: u64) -> bool {
        message := String("Ryn runtime error: String character slice must use ordered in-bounds Unicode scalar indices\n")
        when !self.expr(asm, start) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, end) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.alu_ri(5, x64::Reg::RSP, 48)
        when !self.load_string_parts(asm, text) {
            return false
        }
        asm.store(8, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RDX, x64::Reg::RSP, 8)
        // The start must not come after the end.
        ordered := asm.new_label()
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 56)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 48)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::BELOW_EQUAL, ordered)
        self.fail_exit(asm, message.clone())
        asm.bind(ordered)
        // The byte offset of the start, then of the end.
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 56)
        self.char_offset_code(asm, message.clone())
        asm.store(8, x64::Reg::R8, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 48)
        self.char_offset_code(asm, message.clone())
        asm.store(8, x64::Reg::R8, x64::Reg::RSP, 24)
        // The copy: malloc(finish - begin), then memcpy(copy, data + begin, finish - begin).
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.alu_rr(41, x64::Reg::RDI, x64::Reg::RCX)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 24)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RCX)
        self.aligned_call(asm, String("memcpy"))
        // The header: the copy, the length and the capacity of the length.
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 40)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 32)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RCX)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 16)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 40)
        asm.alu_ri(0, x64::Reg::RSP, 64)
        return true
    }

    // The character at `index` of a String or str: the index is evaluated first, then the text's data and length are read.
    fun string_char_at(mut self, asm: &mut x64::Asm, text: u64, index: u64, message: String) -> bool {
        when !self.expr(asm, index) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.load_string_parts(asm, text) {
            return false
        }
        asm.pop(x64::Reg::RCX)
        self.char_at_code(asm, message)
        return true
    }

    // Walks the UTF-8 text at rsi, of rdx bytes, to the character index that rcx names, and leaves its byte offset in r8.
    // The index of the length is the end of the text; an index past it fails with `message`. Uses r8 to r11.
    fun char_offset_code(mut self, asm: &mut x64::Asm, message: String) {
        top := asm.new_label()
        fail := asm.new_label()
        done := asm.new_label()
        asm.mov_ri(x64::Reg::R8, 0)
        asm.mov_ri(x64::Reg::R9, 0)
        asm.bind(top)
        asm.alu_rr(57, x64::Reg::R9, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, done)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, fail)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::R10, x64::Reg::R11, 0)
        // The width of the character from its lead byte: one below 0x80, two below 0xE0, three below 0xF0, else four.
        width := asm.new_label()
        asm.mov_ri(x64::Reg::R11, 1)
        asm.alu_ri(7, x64::Reg::R10, 128)
        asm.jcc(x64::Cc::BELOW, width)
        asm.mov_ri(x64::Reg::R11, 2)
        asm.alu_ri(7, x64::Reg::R10, 224)
        asm.jcc(x64::Cc::BELOW, width)
        asm.mov_ri(x64::Reg::R11, 3)
        asm.alu_ri(7, x64::Reg::R10, 240)
        asm.jcc(x64::Cc::BELOW, width)
        asm.mov_ri(x64::Reg::R11, 4)
        asm.bind(width)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R11)
        asm.alu_ri(0, x64::Reg::R9, 1)
        asm.jmp(top)
        asm.bind(fail)
        self.fail_exit(asm, message)
        asm.bind(done)
    }

    // The character at the index in rcx, decoded into rax; an index past the last character fails with `message`.
    fun char_at_code(mut self, asm: &mut x64::Asm, message: String) {
        self.char_offset_code(asm, message.clone())
        ok := asm.new_label()
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::BELOW, ok)
        self.fail_exit(asm, message)
        asm.bind(ok)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::R11, 0)
        // Decoding: the lead byte's bits, then six bits from each continuation byte.
        done := asm.new_label()
        two := asm.new_label()
        three := asm.new_label()
        asm.alu_ri(7, x64::Reg::RAX, 128)
        asm.jcc(x64::Cc::BELOW, done)
        asm.alu_ri(7, x64::Reg::RAX, 224)
        asm.jcc(x64::Cc::BELOW, two)
        asm.alu_ri(7, x64::Reg::RAX, 240)
        asm.jcc(x64::Cc::BELOW, three)
        asm.alu_ri(4, x64::Reg::RAX, 7)
        asm.mov_ri(x64::Reg::RCX, 18)
        asm.shift_cl(4, x64::Reg::RAX)
        self.continuation(asm, 1, 12)
        self.continuation(asm, 2, 6)
        self.continuation(asm, 3, 0)
        asm.jmp(done)
        asm.bind(three)
        asm.alu_ri(4, x64::Reg::RAX, 15)
        asm.mov_ri(x64::Reg::RCX, 12)
        asm.shift_cl(4, x64::Reg::RAX)
        self.continuation(asm, 1, 6)
        self.continuation(asm, 2, 0)
        asm.jmp(done)
        asm.bind(two)
        asm.alu_ri(4, x64::Reg::RAX, 31)
        asm.mov_ri(x64::Reg::RCX, 6)
        asm.shift_cl(4, x64::Reg::RAX)
        self.continuation(asm, 1, 0)
        asm.bind(done)
    }

    // ORs the six bits of the continuation byte at `offset` from the character in r11, shifted left by `shift`, into rax.
    fun continuation(self, asm: &mut x64::Asm, offset: i64, shift: u64) {
        asm.load(1, false, x64::Reg::R10, x64::Reg::R11, offset)
        asm.alu_ri(4, x64::Reg::R10, 63)
        asm.mov_ri(x64::Reg::RCX, shift)
        asm.shift_cl(4, x64::Reg::R10)
        asm.alu_rr(9, x64::Reg::RAX, x64::Reg::R10)
    }

    // `try_to_<int>()` of a String or str: the decimal text, an optional sign, then digits and nothing else, as Rust's
    // integer parse reads it, is an Option of the integer whose type the tag names (0 i8 to 7 u64). A value past the
    // range, an empty text, or any other text gives None.
    fun string_try_parse(mut self, asm: &mut x64::Asm, text: u64, tag: u64) -> bool {
        when self.integer_literal(tag).is_none() {
            return self.fail("a parse of a type that is not an integer")
        }
        kind := self.integer_literal(tag).unwrap()
        when kind == 8 || kind == 9 {
            return self.string_try_parse_float(asm, text, kind == 8)
        }
        when kind > 7 {
            return self.fail("a parse of a type that is not an integer")
        }
        signed := kind < 4
        // The largest value of the type; a negative signed value may be one more in magnitude.
        mut largest: u64 = 0
        when kind == 0 {
            largest = 127 as u64
        }
        when kind == 1 {
            largest = 32767 as u64
        }
        when kind == 2 {
            largest = 2147483647 as u64
        }
        when kind == 3 {
            largest = 9223372036854775807 as u64
        }
        when kind == 4 {
            largest = 255 as u64
        }
        when kind == 5 {
            largest = 65535 as u64
        }
        when kind == 6 {
            largest = 4294967295 as u64
        }
        when kind == 7 {
            largest = 18446744073709551615 as u64
        }
        mut name := String("I8")
        when kind == 1 {
            name = String("I16")
        }
        when kind == 2 {
            name = String("I32")
        }
        when kind == 3 {
            name = String("I64")
        }
        when kind == 4 {
            name = String("U8")
        }
        when kind == 5 {
            name = String("U16")
        }
        when kind == 6 {
            name = String("U32")
        }
        when kind == 7 {
            name = String("U64")
        }
        scalar := self.scalar_type_id(name)
        mut option: Option<u64> = Option::None
        when scalar.is_some() {
            option = self.option_of(scalar.unwrap())
        }
        when option.is_none() {
            return self.fail("a parse without its Option")
        }
        some := self.variant_tag(option.unwrap(), String("Some"))
        none := self.variant_tag(option.unwrap(), String("None"))
        when some.is_none() || none.is_none() {
            return self.fail("a parse without its Option")
        }
        when !self.load_string_parts(asm, text) {
            return false
        }
        bad := asm.new_label()
        parsed := asm.new_label()
        done := asm.new_label()
        digits := asm.new_label()
        finish := asm.new_label()
        asm.test_rr(x64::Reg::RDX, x64::Reg::RDX)
        asm.jcc(x64::Cc::EQUAL, bad)
        asm.mov_ri(x64::Reg::R8, 0)
        asm.mov_ri(x64::Reg::R9, 0)
        asm.mov_ri(x64::Reg::R10, 0)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::RSI, 0)
        sign := asm.new_label()
        asm.alu_ri(7, x64::Reg::RCX, 43)
        asm.jcc(x64::Cc::EQUAL, sign)
        when signed {
            asm.alu_ri(7, x64::Reg::RCX, 45)
            asm.jcc(x64::Cc::NOT_EQUAL, digits)
            asm.mov_ri(x64::Reg::R10, 1)
            asm.jmp(sign)
        }
        when !signed {
            asm.alu_ri(7, x64::Reg::RCX, 45)
            asm.jcc(x64::Cc::EQUAL, bad)
            asm.jmp(digits)
        }
        asm.bind(sign)
        asm.mov_ri(x64::Reg::R8, 1)
        asm.bind(digits)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, bad)
        digit := asm.new_label()
        asm.bind(digit)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, finish)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::R11, x64::Reg::R11, 0)
        asm.alu_ri(5, x64::Reg::R11, 48)
        asm.alu_ri(7, x64::Reg::R11, 9)
        asm.jcc(x64::Cc::ABOVE, bad)
        // The digit fits when the value so far is at most (limit - digit) / 10.
        asm.push(x64::Reg::RDX)
        asm.mov_ri(x64::Reg::RAX, largest)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::R10)
        asm.alu_rr(41, x64::Reg::RAX, x64::Reg::R11)
        asm.mov_ri(x64::Reg::RCX, 10)
        asm.mov_ri(x64::Reg::RDX, 0)
        asm.unary(6, x64::Reg::RCX)
        asm.pop(x64::Reg::RDX)
        asm.alu_rr(57, x64::Reg::R9, x64::Reg::RAX)
        asm.jcc(x64::Cc::ABOVE, bad)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::R9)
        asm.mov_ri(x64::Reg::RCX, 10)
        asm.imul_rr(x64::Reg::RAX, x64::Reg::RCX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::R11)
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.jmp(digit)
        asm.bind(finish)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::R9)
        asm.test_rr(x64::Reg::R10, x64::Reg::R10)
        asm.jcc(x64::Cc::EQUAL, parsed)
        asm.unary(3, x64::Reg::RAX)
        asm.bind(parsed)
        asm.push(x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.pop(x64::Reg::RCX)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.mov_ri(x64::Reg::RDX, some.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.jmp(done)
        asm.bind(bad)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RDX, none.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // The case-folded comparison of `word` with the text at rsi + r8, r10 bytes of which remain: jumps to `matched` when the
    // text is that word in any case, and falls through otherwise. Clobbers rcx and r11.
    fun match_word(self, asm: &mut x64::Asm, word: String, matched: u64) {
        next := asm.new_label()
        asm.alu_ri(7, x64::Reg::R10, word.len() as i64)
        asm.jcc(x64::Cc::NOT_EQUAL, next)
        mut at: u64 = 0
        while at < word.len() {
            asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
            asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
            asm.load(1, false, x64::Reg::RCX, x64::Reg::R11, at as i64)
            asm.alu_ri(1, x64::Reg::RCX, 32)
            asm.alu_ri(7, x64::Reg::RCX, word.byte_at(at) as i64)
            asm.jcc(x64::Cc::NOT_EQUAL, next)
            at += 1
        }
        asm.jmp(matched)
        asm.bind(next)
    }

    // Counts the ASCII digits at rsi + r8 (bounded by the length in rdx), moving r8 past them and adding to r9. Clobbers
    // rcx and r11.
    fun skip_digits(self, asm: &mut x64::Asm) {
        again := asm.new_label()
        stop := asm.new_label()
        asm.bind(again)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, stop)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::R11, 0)
        asm.alu_ri(5, x64::Reg::RCX, 48)
        asm.alu_ri(7, x64::Reg::RCX, 9)
        asm.jcc(x64::Cc::ABOVE, stop)
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.alu_ri(0, x64::Reg::R9, 1)
        asm.jmp(again)
        asm.bind(stop)
    }

    // `try_to_f32` and `try_to_f64`: the text must be what Rust's parser accepts (an optional sign, then `inf`, `infinity` or
    // `nan` in any case, or digits with an optional point and an optional exponent, with at least one mantissa digit and no
    // other character), and the value is then read by `strtod` or `strtof` from a terminated copy of the text.
    fun string_try_parse_float(mut self, asm: &mut x64::Asm, text: u64, single: bool) -> bool {
        mut name := String("F64")
        when single {
            name = String("F32")
        }
        scalar := self.scalar_type_id(name)
        mut option: Option<u64> = Option::None
        when scalar.is_some() {
            option = self.option_of(scalar.unwrap())
        }
        when option.is_none() {
            return self.fail("a parse without its Option")
        }
        some := self.variant_tag(option.unwrap(), String("Some"))
        none := self.variant_tag(option.unwrap(), String("None"))
        when some.is_none() || none.is_none() {
            return self.fail("a parse without its Option")
        }
        when !self.load_string_parts(asm, text) {
            return false
        }
        bad := asm.new_label()
        valid := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RDX, x64::Reg::RDX)
        asm.jcc(x64::Cc::EQUAL, bad)
        asm.mov_ri(x64::Reg::R8, 0)
        asm.mov_ri(x64::Reg::R9, 0)
        // An optional sign, and something after it.
        asm.load(1, false, x64::Reg::RCX, x64::Reg::RSI, 0)
        unsigned := asm.new_label()
        asm.alu_ri(7, x64::Reg::RCX, 43)
        asm.jcc(x64::Cc::EQUAL, unsigned)
        asm.alu_ri(7, x64::Reg::RCX, 45)
        after_sign := asm.new_label()
        asm.jcc(x64::Cc::NOT_EQUAL, after_sign)
        asm.bind(unsigned)
        asm.mov_ri(x64::Reg::R8, 1)
        asm.bind(after_sign)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, bad)
        // The words `inf`, `infinity` and `nan`; r10 is the number of characters after the sign.
        asm.mov_rr(x64::Reg::R10, x64::Reg::RDX)
        asm.alu_rr(41, x64::Reg::R10, x64::Reg::R8)
        self.match_word(asm, String("inf"), valid)
        self.match_word(asm, String("infinity"), valid)
        self.match_word(asm, String("nan"), valid)
        // Digits, a point and digits, then an exponent: r9 counts the mantissa digits.
        self.skip_digits(asm)
        no_point := asm.new_label()
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, no_point)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::R11, 0)
        asm.alu_ri(7, x64::Reg::RCX, 46)
        asm.jcc(x64::Cc::NOT_EQUAL, no_point)
        asm.alu_ri(0, x64::Reg::R8, 1)
        self.skip_digits(asm)
        asm.bind(no_point)
        asm.test_rr(x64::Reg::R9, x64::Reg::R9)
        asm.jcc(x64::Cc::EQUAL, bad)
        no_exponent := asm.new_label()
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, no_exponent)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::R11, 0)
        asm.alu_ri(1, x64::Reg::RCX, 32)
        asm.alu_ri(7, x64::Reg::RCX, 101)
        asm.jcc(x64::Cc::NOT_EQUAL, no_exponent)
        asm.alu_ri(0, x64::Reg::R8, 1)
        // The exponent's own sign, then at least one digit.
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, bad)
        exponent_digits := asm.new_label()
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::R11, 0)
        exponent_sign := asm.new_label()
        asm.alu_ri(7, x64::Reg::RCX, 43)
        asm.jcc(x64::Cc::EQUAL, exponent_sign)
        asm.alu_ri(7, x64::Reg::RCX, 45)
        asm.jcc(x64::Cc::NOT_EQUAL, exponent_digits)
        asm.bind(exponent_sign)
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.bind(exponent_digits)
        asm.mov_ri(x64::Reg::R9, 0)
        self.skip_digits(asm)
        asm.test_rr(x64::Reg::R9, x64::Reg::R9)
        asm.jcc(x64::Cc::EQUAL, bad)
        asm.bind(no_exponent)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::RDX)
        asm.jcc(x64::Cc::NOT_EQUAL, bad)
        // The freestanding routine returns the same tagged one-cell Option layout,
        // with IEEE bits in the payload. Its str argument borrows the original text.
        asm.bind(valid)
        when self.freestanding {
            self.needed.set(self.native_float_parse, true)
            asm.push(x64::Reg::RSI)
            asm.push(x64::Reg::RDX)
            asm.mov_ri(x64::Reg::RAX, 0)
            when single { asm.mov_ri(x64::Reg::RAX, 1) }
            asm.push(x64::Reg::RAX)
            asm.call_label(self.labels[self.native_float_parse])
            asm.alu_ri(0, x64::Reg::RSP, 24)
            // Translate the runtime's Option tag to this program's Option definition.
            asm.mov_ri(x64::Reg::RDX, some.unwrap())
            asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
            asm.jmp(done)
        } else {
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        asm.lea(x64::Reg::RDI, x64::Reg::RDX, 1)
        self.aligned_call(asm, String("malloc"))
        asm.push(x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("memcpy"))
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RCX)
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.store(1, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
        asm.mov_ri(x64::Reg::RSI, 0)
        when single {
            self.aligned_call(asm, String("strtof"))
            asm.movq_from_xmm(false, x64::Reg::RAX, 0)
        } else {
            self.aligned_call(asm, String("strtod"))
            asm.movq_from_xmm(true, x64::Reg::RAX, 0)
        }
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("free"))
        asm.pop(x64::Reg::RCX)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.push(x64::Reg::RCX)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.pop(x64::Reg::RCX)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.mov_ri(x64::Reg::RDX, some.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.jmp(done)
        }
        asm.bind(bad)
        asm.mov_ri(x64::Reg::RDI, 16)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RDX, none.unwrap())
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // The type id of a scalar by its word, as the IR names it.
    fun scalar_type_id(self, word: String) -> Option<u64> {
        mut index: u64 = 0
        while index < self.program.types.len() {
            when choose self.program.types[index] {
                ir::IrTy::Scalar(name) => name == word,
                _ => false,
            } {
                return Option::Some(index)
            }
            index += 1
        }
        return Option::None
    }

    // The value of an integer literal expression.
    fun integer_literal(self, index: u64) -> Option<u64> {
        return choose self.program.exprs[index] {
            ir::IrExpr::IntegerLit(text, ty) => Option::Some(literal_bits(text)),
            _ => Option::None,
        }
    }

    // `concat` of two Strings: a new String holding the first, then the second, with the capacity of the length. Both
    // operands are String values, read through their headers; the operands are consumed, as the Rust call does.
    fun string_concat(mut self, asm: &mut x64::Asm, first: u64, second: u64) -> bool {
        when !self.expr(asm, first) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, second) {
            return false
        }
        asm.push(x64::Reg::RAX)
        return self.concat_pushed(asm, false)
    }

    // `concat(suffix)` of a String with a `str`: the suffix is copied into a String, which is then joined to the first.
    fun string_concat_text(mut self, asm: &mut x64::Asm, first: u64, second: u64) -> bool {
        when !self.expr(asm, first) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.text_parts(asm, second, false) {
            return false
        }
        when !self.string_from_parts(asm) {
            return false
        }
        asm.push(x64::Reg::RAX)
        // The suffix was copied into a String that nothing else owns: it is freed once it has been joined.
        return self.concat_pushed(asm, true)
    }

    // Joins the two Strings whose headers are the two topmost cells of the stack, the first below the second. The result's
    // header is left in rax, and both are popped; `free_second` frees the second (a copy made for the join).
    fun concat_pushed(mut self, asm: &mut x64::Asm, free_second: bool) -> bool {
        // The frame: the data of the copy at 0, its length at 8, and the header at 16; the second header is at 24 and the
        // first at 32.
        asm.alu_ri(5, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::R8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RCX)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 0)
        // The first text, then the second after it.
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 32)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RCX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("memcpy"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 32)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RCX, 8)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::R8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 24)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RDX, 8)
        self.aligned_call(asm, String("memcpy"))
        // The header: the copy, and its length as both length and capacity.
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 16)
        when free_second {
            asm.push(x64::Reg::RAX)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 32)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
            self.aligned_call(asm, String("free"))
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 32)
            self.aligned_call(asm, String("free"))
            asm.pop(x64::Reg::RAX)
        }
        asm.alu_ri(0, x64::Reg::RSP, 40)
        return true
    }

    // `contains(pattern)`, or `ends_with(pattern)` when `at_end`: the pattern's bytes are compared where it may start in the
    // text. The pattern is a `str`, or a String when `owned` is set.
    fun string_search(mut self, asm: &mut x64::Asm, text: u64, pattern: u64, owned: bool, at_end: bool) -> bool {
        when !self.text_parts(asm, text, true) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, pattern, owned) {
            return false
        }
        // rdi and rcx are the text's data and length, rsi and rdx the pattern's; r9 is the last position where it may start.
        asm.pop(x64::Reg::RCX)
        asm.pop(x64::Reg::RDI)
        yes := asm.new_label()
        no := asm.new_label()
        done := asm.new_label()
        attempt := asm.new_label()
        next := asm.new_label()
        compare := asm.new_label()
        asm.alu_rr(57, x64::Reg::RDX, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE, no)
        asm.mov_rr(x64::Reg::R9, x64::Reg::RCX)
        asm.alu_rr(41, x64::Reg::R9, x64::Reg::RDX)
        asm.mov_ri(x64::Reg::R8, 0)
        when at_end {
            asm.mov_rr(x64::Reg::R8, x64::Reg::R9)
        }
        asm.bind(attempt)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::R9)
        asm.jcc(x64::Cc::ABOVE, no)
        asm.mov_ri(x64::Reg::R10, 0)
        asm.bind(compare)
        asm.alu_rr(57, x64::Reg::R10, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, yes)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RDI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R8)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R10)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::R11, 0)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R10)
        asm.load(1, false, x64::Reg::R11, x64::Reg::R11, 0)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::R11)
        asm.jcc(x64::Cc::NOT_EQUAL, next)
        asm.alu_ri(0, x64::Reg::R10, 1)
        asm.jmp(compare)
        asm.bind(next)
        when at_end {
            asm.jmp(no)
        }
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.jmp(attempt)
        asm.bind(yes)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.jmp(done)
        asm.bind(no)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `split(separator)` of a String: the pieces, as a vector of Strings. The pieces are the parts between the matches, left to
    // right, as in Rust; an empty separator matches between each pair of characters, so the first and the last piece are
    // empty. The separator is a `str`, or a String when `owned` is set.
    fun string_split(mut self, asm: &mut x64::Asm, text: u64, pattern: u64, owned: bool) -> bool {
        when !self.text_parts(asm, text, true) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, pattern, owned) {
            return false
        }
        asm.pop(x64::Reg::RCX)
        asm.pop(x64::Reg::RDI)
        // rdi and rcx are the text's data and length, rsi and rdx the separator's. The frame, below rbp: the text's data at
        // -8, its length at -16, the separator's data at -24, its length at -32, the start of the piece at -40, the index at
        // -48 and the vector's header at -56.
        past := asm.new_label()
        piece := asm.new_label()
        asm.jmp(past)
        // The piece from the start to the end in rdx is copied into a String, which is appended to the vector.
        asm.bind(piece)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -40)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, -8)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        when !self.string_from_parts(asm) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -56)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 16)
        room := asm.new_label()
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::BELOW, room)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::R8)
        self.grow_capacity(asm)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -56)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 16)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RAX)
        self.scale_bytes(asm, x64::Reg::RSI, 8)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        self.aligned_call(asm, String("realloc"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -56)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.bind(room)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -56)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::R9, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::R9, 8)
        asm.alu_rr(1, x64::Reg::R9, x64::Reg::RDI)
        asm.store(8, x64::Reg::RAX, x64::Reg::R9, 0)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        asm.ret()
        asm.bind(past)
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 64)
        asm.store(8, x64::Reg::RDI, x64::Reg::RBP, -8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -16)
        asm.store(8, x64::Reg::RSI, x64::Reg::RBP, -24)
        asm.store(8, x64::Reg::RDX, x64::Reg::RBP, -32)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, -40)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, -48)
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RCX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, -56)
        finish := asm.new_label()
        empty := asm.new_label()
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -32)
        asm.test_rr(x64::Reg::RDX, x64::Reg::RDX)
        asm.jcc(x64::Cc::EQUAL, empty)
        // A separator of bytes: each match, leftmost first, ends a piece, and the rest of the text is the last piece.
        looping := asm.new_label()
        matched := asm.new_label()
        mismatch := asm.new_label()
        comparing := asm.new_label()
        ended := asm.new_label()
        asm.bind(looping)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -32)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RCX)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::RDX)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RBP, -16)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::R9)
        asm.jcc(x64::Cc::ABOVE, ended)
        asm.mov_ri(x64::Reg::R10, 0)
        asm.bind(comparing)
        asm.alu_rr(57, x64::Reg::R10, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, matched)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, -8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RDI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::RCX)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R10)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::R11, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, -24)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R10)
        asm.load(1, false, x64::Reg::R11, x64::Reg::R11, 0)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::R11)
        asm.jcc(x64::Cc::NOT_EQUAL, mismatch)
        asm.alu_ri(0, x64::Reg::R10, 1)
        asm.jmp(comparing)
        asm.bind(matched)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -48)
        asm.call_label(piece)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -32)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RDX)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -40)
        asm.jmp(looping)
        asm.bind(mismatch)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.jmp(looping)
        asm.bind(ended)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -16)
        asm.call_label(piece)
        asm.jmp(finish)
        // An empty separator: the boundaries between characters are the matches, the first at the start of the text.
        asm.bind(empty)
        each := asm.new_label()
        each_done := asm.new_label()
        skipping := asm.new_label()
        skipped := asm.new_label()
        asm.bind(each)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -48)
        asm.call_label(piece)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -40)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RBP, -16)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::ABOVE_EQUAL, each_done)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.bind(skipping)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RBP, -16)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::ABOVE_EQUAL, skipped)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, -8)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RCX)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::RDI, 0)
        asm.alu_ri(4, x64::Reg::RAX, 192)
        asm.alu_ri(7, x64::Reg::RAX, 128)
        asm.jcc(x64::Cc::NOT_EQUAL, skipped)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RBP, -48)
        asm.jmp(skipping)
        asm.bind(skipped)
        asm.jmp(each)
        asm.bind(each_done)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, -16)
        asm.call_label(piece)
        asm.bind(finish)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, -56)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        return true
    }

    // `get(index)`, `first()`, `last()` and `pop()` of a vector: an Option whose payload is a copy of the element, and None past
    // the end (and for `last` and `pop` of an empty vector). A `get` clones the owned cells of its copy; a `pop` moves the last
    // element out and shortens the vector, so its copy is not cloned. The payload is in the box in the order of the frame's
    // cells, while a vector keeps a structure's cells in memory order, so each cell is reversed.
    fun vec_get_option(mut self, asm: &mut x64::Asm, element: u64, option: u64, pop: bool, arguments: Vec<u64>) -> bool {
        mut expected: u64 = 2
        when pop {
            expected = 1
        }
        when arguments.len() != expected {
            return self.fail("a get with another number of arguments")
        }
        owned := self.owned_cells(element)
        when owned.is_none() {
            return self.fail("a get of owned elements that a clone does not copy")
        }
        when self.variant_tag(option, String("Some")).is_none() || self.variant_tag(option, String("None")).is_none() {
            return self.fail("a get of an enum that is not an Option")
        }
        some := self.variant_tag(option, String("Some")).unwrap()
        none := self.variant_tag(option, String("None")).unwrap()
        cells := self.cells_of(element)
        bytes := 8 * cells
        resolved := asm.new_label()
        absent := asm.new_label()
        done := asm.new_label()
        when pop {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
            asm.test_rr(x64::Reg::R8, x64::Reg::R8)
            asm.jcc(x64::Cc::EQUAL, absent)
            asm.mov_rr(x64::Reg::RCX, x64::Reg::R8)
            asm.alu_ri(5, x64::Reg::RCX, 1)
            asm.jmp(resolved)
        }
        when !pop {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.pop(x64::Reg::RDX)
            asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
            asm.alu_ri(7, x64::Reg::RCX, -1)
            asm.jcc(x64::Cc::NOT_EQUAL, resolved)
            asm.test_rr(x64::Reg::R8, x64::Reg::R8)
            asm.jcc(x64::Cc::EQUAL, absent)
            asm.mov_rr(x64::Reg::RCX, x64::Reg::R8)
            asm.alu_ri(5, x64::Reg::RCX, 1)
        }
        asm.bind(resolved)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::ABOVE_EQUAL, absent)
        asm.push(x64::Reg::RDX)
        asm.push(x64::Reg::RCX)
        asm.mov_ri(x64::Reg::RDI, (8 * (1 + cells)) as u64)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RCX, some)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.push(x64::Reg::RAX)
        // rsi is the element's address: the header's data plus the index times the element's bytes.
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        self.scale_bytes(asm, x64::Reg::RCX, bytes)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        mut memory: u64 = 0
        while memory < cells {
            asm.load(8, false, x64::Reg::R8, x64::Reg::RSI, (8 * memory) as i64)
            asm.store(8, x64::Reg::R8, x64::Reg::RAX, (8 * (1 + cells - 1 - memory)) as i64)
            memory += 1
        }
        // The owned cells of a copy by `get` are replaced by their clones.
        list := owned.unwrap()
        mut at: u64 = 0
        while at < list.len() && !pop {
            offset := list[at]
            code := list[at + 1]
            ty := list[at + 2]
            disp := (8 * (1 + cells - 1 - offset / 8)) as i64
            mut target: u64 = self.string_clone_label
            when code == 2 {
                target = self.vec_routine(asm, ty)
            }
            when code == 3 {
                target = self.enum_routine(asm, self.enum_id_of(ty))
            }
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RAX, disp)
            asm.call_label(target)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
            asm.store(8, x64::Reg::RAX, x64::Reg::RCX, disp)
            at += 3
        }
        // A pop shortens the vector once its last element is copied out.
        when pop {
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
            asm.alu_ri(5, x64::Reg::RCX, 1)
            asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
        }
        asm.pop(x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::RSP, 16)
        asm.jmp(done)
        asm.bind(absent)
        asm.mov_ri(x64::Reg::RDI, (8 * (1 + cells)) as u64)
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RCX, none)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // The file builtins, through the C library: `read_file` gives the file's text as a String, or reports the error and exits
    // as the runtime does; `write_file` says whether the file was written.
    fun filesystem(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        when op == "ReadFile" && arguments.len() == 1 {
            return self.read_file(asm, arguments[0])
        }
        when op == "WriteFile" && arguments.len() == 2 {
            return self.write_file(asm, arguments[0], arguments[1])
        }
        when (op == "Exists" || op == "IsFile") && arguments.len() == 1 {
            // `access(path, F_OK)` through the system call: zero means the path exists.
            when !self.text_parts(asm, arguments[0], false) {
                return false
            }
            self.c_string(asm)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.mov_ri(x64::Reg::RSI, 0)
            asm.mov_ri(x64::Reg::RAX, 21)
            asm.syscall()
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            return true
        }
        return self.op_fail("a filesystem operation ", op)
    }

    // The text in rsi and rdx as a C string, with a NUL after it, whose address is left in rax.
    fun c_string(mut self, asm: &mut x64::Asm) {
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RDX)
        asm.alu_ri(0, x64::Reg::RDI, 1)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
        asm.push(x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("memcpy"))
        asm.pop(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RDX)
        asm.mov_ri(x64::Reg::R8, 0)
        asm.store(1, x64::Reg::R8, x64::Reg::RCX, 0)
        asm.alu_ri(0, x64::Reg::RSP, 16)
    }

    // Writes the bytes at rsi, of length rdx, to standard error.
    fun stderr_bytes(self, asm: &mut x64::Asm) {
        self.flush_stdout(asm)
        asm.mov_ri(x64::Reg::RDI, 2)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
    }

    fun literal_to_stderr(mut self, asm: &mut x64::Asm, text: String) {
        index := self.literal(text)
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[index])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[index])
        self.stderr_bytes(asm)
    }

    // The unsigned number at rsp (one cell, which is removed) in decimal, to standard error.
    fun decimal_to_stderr(self, asm: &mut x64::Asm) {
        asm.alu_ri(5, x64::Reg::RSP, 32)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 32)
        asm.lea(x64::Reg::R8, x64::Reg::RSP, 32)
        asm.mov_ri(x64::Reg::R9, 10)
        digits := asm.new_label()
        asm.bind(digits)
        asm.mov_ri(x64::Reg::RDX, 0)
        asm.unary(6, x64::Reg::R9)
        asm.alu_ri(0, x64::Reg::RDX, 48)
        asm.alu_ri(5, x64::Reg::R8, 1)
        asm.store(1, x64::Reg::RDX, x64::Reg::R8, 0)
        asm.alu_ri(7, x64::Reg::RAX, 0)
        asm.jcc(x64::Cc::NOT_EQUAL, digits)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::R8)
        asm.lea(x64::Reg::RDX, x64::Reg::RSP, 32)
        asm.alu_rr(41, x64::Reg::RDX, x64::Reg::R8)
        self.stderr_bytes(asm)
        asm.alu_ri(0, x64::Reg::RSP, 32)
    }

    // The error of a file that cannot be read: `Ryn runtime error: could not read `path`: strerror (os error n)`, and exit
    // with status 1. The path, a C string, is at rsp.
    fun read_error(mut self, asm: &mut x64::Asm) {
        self.aligned_call(asm, String("__errno_location"))
        asm.load(4, true, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.push(x64::Reg::RCX)
        self.literal_to_stderr(asm, String("Ryn runtime error: could not read `"))
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("strlen"))
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
        self.stderr_bytes(asm)
        self.literal_to_stderr(asm, String("`: "))
        asm.load(4, true, x64::Reg::RDI, x64::Reg::RSP, 0)
        self.aligned_call(asm, String("strerror"))
        asm.push(x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("strlen"))
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 0)
        self.stderr_bytes(asm)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        self.literal_to_stderr(asm, String(" (os error "))
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.push(x64::Reg::RAX)
        self.decimal_to_stderr(asm)
        self.literal_to_stderr(asm, String(")\n"))
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RAX, 231)
        asm.syscall()
    }

    // Jumps to `invalid` unless the bytes at the buffer (its address at rsp, its length at rsp + 8) are UTF-8, by the rules of
    // Rust's `str`: the lead byte, the number of continuation bytes, and the range of the first of them.
    fun utf8_check(mut self, asm: &mut x64::Asm, invalid: u64) {
        top := asm.new_label()
        ok := asm.new_label()
        ascii := asm.new_label()
        check := asm.new_label()
        rest := asm.new_label()
        next := asm.new_label()
        c2 := asm.new_label()
        c3 := asm.new_label()
        c4 := asm.new_label()
        c5 := asm.new_label()
        c6 := asm.new_label()
        asm.load(8, false, x64::Reg::R10, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::R9, x64::Reg::RSP, 8)
        asm.mov_ri(x64::Reg::R8, 0)
        asm.bind(top)
        asm.alu_rr(57, x64::Reg::R8, x64::Reg::R9)
        asm.jcc(x64::Cc::ABOVE_EQUAL, ok)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::R10)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RAX, x64::Reg::RDI, 0)
        asm.alu_ri(7, x64::Reg::RAX, 128)
        asm.jcc(x64::Cc::BELOW, ascii)
        asm.mov_ri(x64::Reg::R11, 1)
        asm.mov_ri(x64::Reg::RCX, 128)
        asm.mov_ri(x64::Reg::RDX, 191)
        asm.alu_ri(7, x64::Reg::RAX, 194)
        asm.jcc(x64::Cc::BELOW, invalid)
        asm.alu_ri(7, x64::Reg::RAX, 223)
        asm.jcc(x64::Cc::ABOVE, c2)
        asm.jmp(check)
        asm.bind(c2)
        asm.alu_ri(7, x64::Reg::RAX, 224)
        asm.jcc(x64::Cc::NOT_EQUAL, c3)
        asm.mov_ri(x64::Reg::R11, 2)
        asm.mov_ri(x64::Reg::RCX, 160)
        asm.jmp(check)
        asm.bind(c3)
        asm.alu_ri(7, x64::Reg::RAX, 237)
        asm.jcc(x64::Cc::NOT_EQUAL, c4)
        asm.mov_ri(x64::Reg::R11, 2)
        asm.mov_ri(x64::Reg::RDX, 159)
        asm.jmp(check)
        asm.bind(c4)
        asm.alu_ri(7, x64::Reg::RAX, 225)
        asm.jcc(x64::Cc::BELOW, c5)
        asm.alu_ri(7, x64::Reg::RAX, 239)
        asm.jcc(x64::Cc::ABOVE, c5)
        asm.mov_ri(x64::Reg::R11, 2)
        asm.jmp(check)
        asm.bind(c5)
        asm.alu_ri(7, x64::Reg::RAX, 240)
        asm.jcc(x64::Cc::NOT_EQUAL, c6)
        asm.mov_ri(x64::Reg::R11, 3)
        asm.mov_ri(x64::Reg::RCX, 144)
        asm.jmp(check)
        asm.bind(c6)
        asm.alu_ri(7, x64::Reg::RAX, 241)
        asm.jcc(x64::Cc::BELOW, invalid)
        asm.alu_ri(7, x64::Reg::RAX, 244)
        asm.jcc(x64::Cc::ABOVE, invalid)
        asm.mov_ri(x64::Reg::R11, 3)
        asm.alu_ri(7, x64::Reg::RAX, 244)
        asm.jcc(x64::Cc::NOT_EQUAL, check)
        asm.mov_ri(x64::Reg::RDX, 143)
        asm.bind(check)
        // The continuation bytes must all be in the text, and the first in its range.
        asm.mov_rr(x64::Reg::RSI, x64::Reg::R8)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::R11)
        asm.alu_rr(57, x64::Reg::RSI, x64::Reg::R9)
        asm.jcc(x64::Cc::ABOVE_EQUAL, invalid)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::R10)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::R8)
        asm.load(1, false, x64::Reg::RSI, x64::Reg::RDI, 1)
        asm.alu_rr(57, x64::Reg::RSI, x64::Reg::RCX)
        asm.jcc(x64::Cc::BELOW, invalid)
        asm.alu_rr(57, x64::Reg::RSI, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE, invalid)
        asm.mov_ri(x64::Reg::RSI, 2)
        asm.bind(rest)
        asm.alu_rr(57, x64::Reg::RSI, x64::Reg::R11)
        asm.jcc(x64::Cc::ABOVE, next)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::R10)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::R8)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RSI)
        asm.load(1, false, x64::Reg::RDI, x64::Reg::RDI, 0)
        asm.alu_ri(7, x64::Reg::RDI, 128)
        asm.jcc(x64::Cc::BELOW, invalid)
        asm.alu_ri(7, x64::Reg::RDI, 191)
        asm.jcc(x64::Cc::ABOVE, invalid)
        asm.alu_ri(0, x64::Reg::RSI, 1)
        asm.jmp(rest)
        asm.bind(next)
        asm.alu_rr(1, x64::Reg::R8, x64::Reg::R11)
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.jmp(top)
        asm.bind(ascii)
        asm.alu_ri(0, x64::Reg::R8, 1)
        asm.jmp(top)
        asm.bind(ok)
    }

    // `read_file(path)`: the file is read whole with its length by fseek and ftell, and its bytes are checked as UTF-8.
    fun read_file(mut self, asm: &mut x64::Asm, path: u64) -> bool {
        when !self.text_parts(asm, path, false) {
            return false
        }
        self.c_string(asm)
        asm.push(x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RCX, 25202)
        asm.push(x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
        self.aligned_call(asm, String("fopen"))
        asm.alu_ri(0, x64::Reg::RSP, 8)
        failed := asm.new_label()
        invalid := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, failed)
        // The stack: the file at 0 and the path at 8.
        asm.push(x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RSI, 0)
        asm.mov_ri(x64::Reg::RDX, 2)
        self.aligned_call(asm, String("fseek"))
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
        self.aligned_call(asm, String("ftell"))
        // The stack: the length at 0, the file at 8 and the path at 16.
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        asm.mov_ri(x64::Reg::RSI, 0)
        asm.mov_ri(x64::Reg::RDX, 0)
        self.aligned_call(asm, String("fseek"))
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
        asm.alu_ri(0, x64::Reg::RDI, 1)
        self.aligned_call(asm, String("malloc"))
        // The stack: the buffer at 0, the length at 8, the file at 16 and the path at 24.
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 0)
        asm.mov_ri(x64::Reg::RSI, 1)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 16)
        self.aligned_call(asm, String("fread"))
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
        self.aligned_call(asm, String("fclose"))
        self.utf8_check(asm, invalid)
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 8)
        asm.alu_ri(0, x64::Reg::RCX, 1)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 16)
        asm.alu_ri(0, x64::Reg::RSP, 32)
        asm.jmp(done)
        asm.bind(failed)
        self.read_error(asm)
        asm.bind(invalid)
        self.fail_exit(asm, String("Ryn runtime error: file contents are not valid UTF-8\n"))
        asm.bind(done)
        return true
    }

    // `write_file(path, text)`: the file is created or truncated and the text written; the result is whether that succeeded.
    fun write_file(mut self, asm: &mut x64::Asm, path: u64, data: u64) -> bool {
        when !self.text_parts(asm, path, false) {
            return false
        }
        self.c_string(asm)
        asm.push(x64::Reg::RAX)
        when !self.text_parts(asm, data, false) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        // The stack: the length at 0, the text at 8 and the path at 16.
        asm.mov_ri(x64::Reg::RCX, 25207)
        asm.push(x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 24)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
        self.aligned_call(asm, String("fopen"))
        asm.alu_ri(0, x64::Reg::RSP, 8)
        failed := asm.new_label()
        bad := asm.new_label()
        done := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, failed)
        // The stack: the file at 0, the length at 8, the text at 16 and the path at 24.
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 16)
        asm.mov_ri(x64::Reg::RSI, 1)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        self.aligned_call(asm, String("fwrite"))
        // The stack: the bytes written at 0, the file at 8, the length at 16, the text at 24 and the path at 32.
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("fclose"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 16)
        asm.alu_ri(0, x64::Reg::RSP, 40)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        asm.jcc(x64::Cc::NOT_EQUAL, bad)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::NOT_EQUAL, bad)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.jmp(done)
        asm.bind(bad)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.jmp(done)
        asm.bind(failed)
        asm.alu_ri(0, x64::Reg::RSP, 24)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `starts_with(prefix)` of a String: the prefix's bytes are the first bytes of the text. The prefix is a `str`, or
    // a String when `owned` is set.
    fun string_starts_with(mut self, asm: &mut x64::Asm, text: u64, prefix: u64, owned: bool) -> bool {
        when !self.text_parts(asm, text, true) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, prefix, owned) {
            return false
        }
        // rsi and rdx are the prefix's data and length; the text's length is popped first, then its data.
        asm.pop(x64::Reg::RCX)
        asm.pop(x64::Reg::RDI)
        no := asm.new_label()
        yes := asm.new_label()
        done := asm.new_label()
        looping := asm.new_label()
        asm.alu_rr(57, x64::Reg::RDX, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE, no)
        asm.mov_ri(x64::Reg::R9, 0)
        asm.bind(looping)
        asm.alu_rr(57, x64::Reg::R9, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, yes)
        asm.mov_rr(x64::Reg::R10, x64::Reg::RDI)
        asm.alu_rr(1, x64::Reg::R10, x64::Reg::R9)
        asm.load(1, false, x64::Reg::R10, x64::Reg::R10, 0)
        asm.mov_rr(x64::Reg::R11, x64::Reg::RSI)
        asm.alu_rr(1, x64::Reg::R11, x64::Reg::R9)
        asm.load(1, false, x64::Reg::R11, x64::Reg::R11, 0)
        asm.alu_rr(57, x64::Reg::R10, x64::Reg::R11)
        asm.jcc(x64::Cc::NOT_EQUAL, no)
        asm.alu_ri(0, x64::Reg::R9, 1)
        asm.jmp(looping)
        asm.bind(yes)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.jmp(done)
        asm.bind(no)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `clone` of a String: a new header and a copy of its bytes, with the capacity of the length.
    fun string_clone(mut self, asm: &mut x64::Asm, source: u64) -> bool {
        when !self.expr(asm, source) {
            return false
        }
        self.clone_header(asm)
        return true
    }

    // The clone of the String whose header is in rax, left in rax.
    fun clone_header(mut self, asm: &mut x64::Asm) {
        asm.push(x64::Reg::RAX)
        // The copy of the bytes: malloc(len), then memcpy(copy, data, len).
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RAX, 8)
        self.aligned_call(asm, String("malloc"))
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RCX, 0)
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("memcpy"))
        // The header: the copy, the length, and the capacity of the length. Stack: the copy at 0, the source header at 8.
        asm.mov_ri(x64::Reg::RDI, 24)
        self.aligned_call(asm, String("malloc"))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 0)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RCX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 8)
        asm.store(8, x64::Reg::RDX, x64::Reg::RAX, 16)
        asm.alu_ri(0, x64::Reg::RSP, 16)
    }

    // `push(c)` of a String: the character's UTF-8 bytes are encoded in an 8-byte buffer on the stack, and appended. The
    // stack is then: the text's length, its data (the buffer), the buffer, and the header.
    fun string_push(mut self, asm: &mut x64::Asm, receiver: u64, ch: u64) -> bool {
        when !self.expr(asm, receiver) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, ch) {
            return false
        }
        asm.alu_ri(5, x64::Reg::RSP, 8)
        self.encode_char(asm)
        asm.lea(x64::Reg::RSI, x64::Reg::RSP, 0)
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        return self.append_pushed(asm, 24)
    }

    // `push_str` of a String: the text is appended, growing the buffer by doubling (at least to the new length) when it is
    // full. The header and the text stay on the stack while the calls run.
    fun string_append(mut self, asm: &mut x64::Asm, receiver: u64, text: u64, owned: bool) -> bool {
        when !self.expr(asm, receiver) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.text_parts(asm, text, owned) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        return self.append_pushed(asm, 16)
    }

    // The append of a text on the stack: its length at 0, its data at 8, and the String's header `header` bytes up, which
    // the three and whatever lies between them are popped from. The header is removed with them.
    fun append_pushed(mut self, asm: &mut x64::Asm, header: u64) -> bool {
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, header as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 16)
        room := asm.new_label()
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::BELOW_EQUAL, room)
        // The new capacity: twice the old one, but at least the new length and at least eight bytes.
        asm.mov_rr(x64::Reg::RSI, x64::Reg::R8)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RSI)
        big := asm.new_label()
        asm.alu_rr(57, x64::Reg::RSI, x64::Reg::RCX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, big)
        asm.mov_rr(x64::Reg::RSI, x64::Reg::RCX)
        asm.bind(big)
        eight := asm.new_label()
        asm.alu_ri(7, x64::Reg::RSI, 8)
        asm.jcc(x64::Cc::ABOVE_EQUAL, eight)
        asm.mov_ri(x64::Reg::RSI, 8)
        asm.bind(eight)
        asm.store(8, x64::Reg::RSI, x64::Reg::RDX, 16)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        self.aligned_call(asm, String("realloc"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, header as i64)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, 0)
        asm.bind(room)
        // memcpy(data + len, text, n), then len += n.
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, header as i64)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, 0)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RCX)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RSP, 8)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
        self.aligned_call(asm, String("memcpy"))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, header as i64)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, 0)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
        asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
        asm.alu_ri(0, x64::Reg::RSP, (header + 8) as i64)
        return true
    }

    // A call of a C function with its arguments already in the registers, from an aligned stack.
    fun aligned_call(mut self, asm: &mut x64::Asm, name: String) {
        when ffi_helpers::is_helper(name.clone()) {
            asm.call_label(self.helper_label(asm, name))
            return
        }
        when self.freestanding {
            self.call_runtime(asm, name)
            return
        }
        symbol := self.foreign_symbol(name)
        asm.call_aligned(symbol)
    }

    // A call of a C function in a freestanding object: the runtime routine of that name, or a decline.
    fun call_runtime(mut self, asm: &mut x64::Asm, name: String) {
        when ffi_helpers::is_helper(name.clone()) {
            asm.call_label(self.helper_label(asm, name))
            return
        }
        label := self.runtime_label(name.clone())
        when label.is_none() {
            mut message := String("the C library function ")
            message.append(name)
            message.append(String(" in a freestanding program"))
            self.failed = true
            when self.reason.is_empty() {
                self.reason = message
            }
            return
        }
        asm.call_label(label.unwrap())
    }

    // The label of a `ryn_ffi_*` routine, which is written once at the end of the code.
    fun helper_label(mut self, asm: &mut x64::Asm, name: String) -> u64 {
        mut at: u64 = 0
        while at < self.helper_names.len() {
            when self.helper_names[at] == name {
                return self.helper_labels[at]
            }
            at += 1
        }
        label := asm.new_label()
        self.helper_names.push(name)
        self.helper_labels.push(label)
        return label
    }

    fun runtime_label(self, name: String) -> Option<u64> {
        when name == "ryn_native_live_allocations" { return Option::Some(self.rt.live_allocations) }
        when name == "ryn_native_live_bytes" { return Option::Some(self.rt.live_bytes) }
        when name == "malloc" { return Option::Some(self.rt.malloc) }
        when name == "free" { return Option::Some(self.rt.free) }
        when name == "realloc" { return Option::Some(self.rt.realloc) }
        when name == "calloc" { return Option::Some(self.rt.calloc) }
        when name == "memcpy" { return Option::Some(self.rt.memcpy) }
        when name == "memmove" { return Option::Some(self.rt.memmove) }
        when name == "strlen" { return Option::Some(self.rt.strlen) }
        when name == "fopen" { return Option::Some(self.rt.fopen) }
        when name == "fseek" { return Option::Some(self.rt.fseek) }
        when name == "ftell" { return Option::Some(self.rt.ftell) }
        when name == "fread" { return Option::Some(self.rt.fread) }
        when name == "fwrite" { return Option::Some(self.rt.fwrite) }
        when name == "fclose" { return Option::Some(self.rt.fclose) }
        when name == "strerror" { return Option::Some(self.rt.strerror) }
        when name == "__errno_location" { return Option::Some(self.rt.errno_location) }
        when name == "putchar" { return Option::Some(self.rt.putchar) }
        when name == "chmod" { return Option::Some(self.rt.chmod) }
        when name == "rename" { return Option::Some(self.rt.rename) }
        when name == "unlink" { return Option::Some(self.rt.unlink) }
        when name == "getpid" { return Option::Some(self.rt.getpid) }
        return Option::None
    }

    // A message with no effects of its own: a literal, or a local string.
    fun is_plain_message(self, index: u64) -> bool {
        return self.string_literal(index).is_some() || self.struct_local_of(index).is_some()
    }

    // Writes `text` to the file descriptor `descriptor` from a literal of the program.
    fun write_fixed(mut self, asm: &mut x64::Asm, descriptor: u64, text: String) {
        index := self.literal(text.clone())
        asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[index])
        asm.mov_ri(x64::Reg::RDX, self.literal_lengths[index])
        when descriptor == 1 {
            self.write_stdout(asm)
            return
        }
        self.flush_stdout(asm)
        asm.mov_ri(x64::Reg::RDI, descriptor)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.syscall()
    }

    // The failure exit: the owners of the function are dropped, as a return does, and the process exits with status 1.
    fun exit_failure(mut self, asm: &mut x64::Asm) {
        self.drop_owners(asm)
        self.flush_stdout(asm)
        asm.mov_ri(x64::Reg::RDI, 1)
        asm.mov_ri(x64::Reg::RAX, 231)
        asm.syscall()
    }

    // The stream builtins: a write sends a string to standard output or error, and a flush has nothing to do.
    fun guarded_system(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        temps := self.borrowed_temporaries(arguments.clone(), 0)
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) { return false }
        ok := self.system_call(asm, op, arguments.clone())
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    fun system_call(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        when op == "FlushStdout" {
            self.flush_stdout(asm)
            return true
        }
        when op == "FlushStderr" {
            return true
        }
        // A program that starts a thread writes standard output at once from then on: the buffer has no lock.
        when op == "StdoutDirect" {
            when self.buffered {
                asm.call_label(self.flush_label)
                asm.lea_symbol(x64::Reg::R11, self.stdout_symbol)
                asm.mov_ri(x64::Reg::RAX, 2)
                asm.store(8, x64::Reg::RAX, x64::Reg::R11, 0)
            }
            return true
        }
        when op == "Exit" && arguments.len() == 1 {
            // The status is evaluated first, then the owners are dropped, as the runtime's exit does, and the process ends.
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            self.drop_owners(asm)
            asm.pop(x64::Reg::RDI)
            self.flush_stdout(asm)
            asm.mov_ri(x64::Reg::RAX, 231)
            asm.syscall()
            return true
        }
        // The address of the runtime cell, for the Ryn runtime functions that keep state across calls.
        when op == "RuntimeCell" && arguments.len() == 0 {
            asm.lea_symbol(x64::Reg::RAX, self.runtime_cell_symbol)
            return true
        }
        when op == "PointerIsNull" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
            return true
        }
        when op.starts_with("Atomic") {
            return self.atomic_call(asm, op, arguments)
        }
        when op.starts_with("Simd") || op.starts_with("Cpu") || op == "XGetBv" || op == "MmxBin" {
            return self.simd_call(asm, op, arguments)
        }
        when op.starts_with("Bit") || op.starts_with("Mem") || op == "Prefetch" {
            return self.bit_call(asm, op, arguments)
        }
        when op.starts_with("Math") {
            return self.math_call(asm, op, arguments)
        }
        // A panic or a failed assertion writes its message to standard error, drops the owners of the function, and exits with
        // status 1. A message is written only on failure, so it must have no effects of its own: a literal or a local.
        when op == "Panic" && arguments.len() == 1 {
            when !self.is_plain_message(arguments[0]) {
                return self.fail("a panic message that is not a literal or a local")
            }
            self.write_fixed(asm, 2, String("Ryn panic: "))
            when !self.system_call(asm, String("WriteStderr"), arguments.clone()) {
                return false
            }
            self.write_fixed(asm, 2, String("\n"))
            self.exit_failure(asm)
            return true
        }
        when op == "Assert" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            held := asm.new_label()
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::NOT_EQUAL, held)
            self.write_fixed(asm, 2, String("Ryn panic: assertion failed\n"))
            self.exit_failure(asm)
            asm.bind(held)
            return true
        }
        when op == "AssertMessage" && arguments.len() == 2 {
            when !self.is_plain_message(arguments[1]) {
                return self.fail("an assertion message that is not a literal or a local")
            }
            when !self.expr(asm, arguments[0]) {
                return false
            }
            held := asm.new_label()
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::NOT_EQUAL, held)
            self.write_fixed(asm, 2, String("Ryn panic: "))
            mut message: Vec<u64> = Vec()
            message.push(arguments[1])
            when !self.system_call(asm, String("WriteStderr"), message) {
                return false
            }
            self.write_fixed(asm, 2, String("\n"))
            self.exit_failure(asm)
            asm.bind(held)
            return true
        }
        when (op != "WriteStdout" && op != "WriteStderr") || arguments.len() != 1 {
            return self.op_fail("a system call ", op)
        }
        when self.string_literal(arguments[0]).is_some() {
            index := self.literal(self.string_literal(arguments[0]).unwrap())
            asm.lea_symbol(x64::Reg::RSI, self.literal_symbols[index])
            asm.mov_ri(x64::Reg::RDX, self.literal_lengths[index])
        }
        when self.is_text_choice(arguments[0]) {
            when !self.text_choice(asm, arguments[0]) {
                return false
            }
        }
        when self.as_str_inner(arguments[0]).is_some() && self.is_text_choice(self.as_str_inner(arguments[0]).unwrap()) {
            when !self.text_choice(asm, self.as_str_inner(arguments[0]).unwrap()) {
                return false
            }
        }
        when self.as_str_inner(arguments[0]).is_some() && !self.is_text_choice(self.as_str_inner(arguments[0]).unwrap()) {
            // An owned String written as text: its header is the value, and the text is the header's data and length.
            when !self.expr(asm, self.as_str_inner(arguments[0]).unwrap()) {
                return false
            }
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
        }
        when self.string_literal(arguments[0]).is_none() && self.as_str_inner(arguments[0]).is_none() && !self.is_text_choice(arguments[0]) {
            source := self.struct_local_of(arguments[0])
            when source.is_none() {
                return self.fail("a string argument that is not a literal or a local")
            }
            asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, slot_disp(source.unwrap()))
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(source.unwrap() + 1))
        }
        when op == "WriteStderr" {
            self.flush_stdout(asm)
            asm.mov_ri(x64::Reg::RDI, 2)
            asm.mov_ri(x64::Reg::RAX, 1)
            asm.syscall()
        } else {
            self.write_stdout(asm)
        }
        return true
    }

    // The vector and CPU-identification operations of `std::simd` and `std::cpu`. A vector operand is the address of 16 or 32
    // bytes (lane 0 first, little-endian), read and written with unaligned moves, so no alignment is assumed. The first
    // argument of an operation is a literal `code`, which the standard library builds and this function decodes:
    //     bits 0-7 immediate byte, 8-15 opcode, 16-17 map (1 = 0F, 2 = 0F 38, 3 = 0F 3A), 18-19 prefix (1 = 66, 2 = F3,
    //     3 = F2), bit 20 an immediate follows, bit 21 the 256-bit VEX form (AVX2), bit 22 VEX.W.
    // Nothing here runs unless the program calls it, so a 256-bit instruction is executed only after the program checked
    // `std::cpu` (CPUID bits plus the operating system's XCR0 state). The operations are `SimdBin` (dst, a, b),
    // `SimdUn` (dst, a), `SimdMask` (a, gives the mask in a general register), `SimdCopy` (dst, source, bytes).
    fun simd_call(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        when op == "CpuCell" && arguments.len() == 0 {
            asm.lea_symbol(x64::Reg::RAX, self.cpu_cell_symbol)
            return true
        }
        when op == "CpuId" && arguments.len() == 3 {
            // leaf, sub-leaf, which register of eax, ebx, ecx, edx (0 to 3). rbx is callee-saved, so it is kept.
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[2]) {
                return false
            }
            asm.mov_rr(x64::Reg::R8, x64::Reg::RAX)
            asm.pop(x64::Reg::RCX)
            asm.pop(x64::Reg::RAX)
            asm.push(x64::Reg::RBX)
            asm.cpuid()
            asm.mov_rr(x64::Reg::R10, x64::Reg::RBX)
            asm.pop(x64::Reg::RBX)
            asm.alu_ri(7, x64::Reg::R8, 1)
            asm.cmov(x64::Cc::EQUAL, x64::Reg::RAX, x64::Reg::R10)
            asm.alu_ri(7, x64::Reg::R8, 2)
            asm.cmov(x64::Cc::EQUAL, x64::Reg::RAX, x64::Reg::RCX)
            asm.alu_ri(7, x64::Reg::R8, 3)
            asm.cmov(x64::Cc::EQUAL, x64::Reg::RAX, x64::Reg::RDX)
            return true
        }
        when op == "XGetBv" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.xgetbv()
            asm.mov_ri(x64::Reg::RCX, 32)
            asm.shift_cl(4, x64::Reg::RDX)
            asm.alu_rr(9, x64::Reg::RAX, x64::Reg::RDX)
            return true
        }
        when arguments.len() == 0 {
            return self.fail("a vector operation")
        }
        code_value := self.integer_literal(arguments[0])
        when code_value.is_none() {
            return self.fail("a vector operation whose code is not a literal")
        }
        code := code_value.unwrap()
        immediate := code & 255
        opcode := (code >> (8 as u32)) & 255
        map := (code >> (16 as u32)) & 3
        prefix := (code >> (18 as u32)) & 3
        has_immediate := ((code >> (20 as u32)) & 1) != 0
        long := ((code >> (21 as u32)) & 1) != 0
        wide := (code >> (22 as u32)) & 1
        zmm := ((code >> (23 as u32)) & 1) != 0
        mut size: u64 = 16
        when long {
            size = 32
        }
        when op.starts_with("SimdFused") {
            return self.simd_fused(asm, op, long, arguments)
        }
        when op == "SimdCopy" && arguments.len() == 4 {
            // dst, source, bytes (16 or 32)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[2]) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.pop(x64::Reg::RDI)
            when long {
                asm.vex_move(111, true, 0, x64::Reg::RCX)
                asm.vex_move(127, true, 0, x64::Reg::RDI)
                asm.vzeroupper()
            } else {
                asm.movdqu_load(0, x64::Reg::RCX, 0)
                asm.movdqu_store(0, x64::Reg::RDI, 0)
            }
            return true
        }
        // `MmxBin` (code, dst, a, b): the 8-byte operands are loaded into mm0 and mm1, the MMX operation runs, the result is
        // stored and `emms` frees the x87 registers again. The code is the MMX opcode with map 1 (0F), no prefix.
        when op == "MmxBin" && arguments.len() == 4 {
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[2]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[3]) {
                return false
            }
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.pop(x64::Reg::RCX)
            asm.pop(x64::Reg::RDI)
            asm.movq_mm_move_at(false, 0, x64::Reg::RCX, 0)
            asm.movq_mm_move_at(false, 1, x64::Reg::RDX, 0)
            asm.mmx_rr(mmx_name(opcode), opcode, 0, 1)
            asm.movq_mm_move_at(true, 0, x64::Reg::RDI, 0)
            asm.emms()
            return true
        }
        when op == "SimdBin" && arguments.len() == 4 {
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[2]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[3]) {
                return false
            }
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.pop(x64::Reg::RCX)
            asm.pop(x64::Reg::RDI)
            when zmm {
                // The 512-bit form: one EVEX instruction on zmm0 and zmm1, which the program runs only after std::cpu
                // reports AVX-512F. The code has no immediate form.
                when has_immediate {
                    return self.fail("a 512-bit vector operation with an immediate")
                }
                asm.zmm_move_at(false, 0, x64::Reg::RCX, 0, 0)
                asm.zmm_move_at(false, 1, x64::Reg::RDX, 0, 0)
                asm.evex_rr(String("evex"), prefix, map, opcode, wide, 2, 0, 0, 1, 0, 0)
                asm.zmm_move_at(true, 0, x64::Reg::RDI, 0, 0)
                asm.vzeroupper()
            } else when long {
                asm.vex_move(111, true, 0, x64::Reg::RCX)
                asm.vex_move(111, true, 1, x64::Reg::RDX)
                asm.vex_rr(prefix, map, opcode, wide, true, 0, 0, 1, has_immediate, immediate)
                asm.vex_move(127, true, 0, x64::Reg::RDI)
                asm.vzeroupper()
            } else {
                asm.movdqu_load(0, x64::Reg::RCX, 0)
                asm.movdqu_load(1, x64::Reg::RDX, 0)
                asm.simd_rr(prefix, map, opcode, 0, 1, has_immediate, immediate)
                asm.movdqu_store(0, x64::Reg::RDI, 0)
            }
            return true
        }
        when op == "SimdUn" && arguments.len() == 3 {
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[2]) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.pop(x64::Reg::RDI)
            when long {
                asm.vex_move(111, true, 0, x64::Reg::RCX)
                asm.vex_rr(prefix, map, opcode, wide, true, 0, 15, 0, has_immediate, immediate)
                asm.vex_move(127, true, 0, x64::Reg::RDI)
                asm.vzeroupper()
            } else {
                asm.movdqu_load(0, x64::Reg::RCX, 0)
                asm.simd_rr(prefix, map, opcode, 0, 0, has_immediate, immediate)
                asm.movdqu_store(0, x64::Reg::RDI, 0)
            }
            return true
        }
        when op == "SimdMask" && arguments.len() == 2 {
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            when long {
                asm.vex_move(111, true, 0, x64::Reg::RCX)
                asm.vex_rr(prefix, map, opcode, wide, true, 0, 15, 0, false, 0)
                asm.vzeroupper()
            } else {
                asm.movdqu_load(0, x64::Reg::RCX, 0)
                asm.simd_rr(prefix, map, opcode, 0, 0, false, 0)
            }
            return true
        }
        return self.fail("a vector operation")
    }

    // The fused array operations of `std::simd` (`__simd_fused_*`; the loops are in back/fused.ryn). The first argument is the
    // code, of which only bit 21 matters here: the AVX2 form (`long`). The other arguments are evaluated left to right and
    // pushed, then popped into the registers the loop reads: rdi, rsi, rdx and rcx.
    //     SimdFusedSumF32 (values, count, result), SimdFusedSumI32 (values, count, result),
    //     SimdFusedDotF32 (a, b, count, result), SimdFusedAddF32 (dst, a, b, count)
    // A result is written to the 4 bytes at its pointer. The caller checks `std::cpu` before it asks for the AVX2 form.
    fun simd_fused(mut self, asm: &mut x64::Asm, op: String, long: bool, arguments: Vec<u64>) -> bool {
        when (op == "SimdFusedSumF32" || op == "SimdFusedSumI32") && arguments.len() == 4 {
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[2]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[3]) {
                return false
            }
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.pop(x64::Reg::RCX)
            asm.pop(x64::Reg::RDI)
            when op == "SimdFusedSumF32" {
                fused::sum_f32(asm, long)
            } else {
                fused::sum_i32(asm, long)
            }
            return true
        }
        when op == "SimdFusedDotF32" && arguments.len() == 5 {
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[2]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[3]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[4]) {
                return false
            }
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.pop(x64::Reg::RCX)
            asm.pop(x64::Reg::RSI)
            asm.pop(x64::Reg::RDI)
            fused::dot_f32(asm, long)
            return true
        }
        when op == "SimdFusedAddF32" && arguments.len() == 5 {
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[2]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[3]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[4]) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.pop(x64::Reg::RDX)
            asm.pop(x64::Reg::RSI)
            asm.pop(x64::Reg::RDI)
            fused::add_f32(asm, long)
            return true
        }
        return self.fail("a fused vector operation")
    }

    // The atomic operations of `std::atomic`, on the raw pointer given first. The width is the suffix of the operation name
    // (`AtomicLoad32`). On x86-64 an aligned load already has acquire and a store release ordering, so those are plain `mov`s;
    // an exchange, `lock xadd` and `lock cmpxchg` are full barriers; a sequentially consistent store is an `xchg`. All results
    // are zero-extended to 64 bits, and a compare-exchange gives the value that was in memory (the caller compares it).
    fun atomic_call(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        when op == "AtomicFence" && arguments.len() == 0 {
            asm.mfence()
            return true
        }
        mut size: u64 = 8
        when op.ends_with("32") {
            size = 4
        } else when op.ends_with("16") {
            size = 2
        } else when op.ends_with("64") {
            size = 8
        } else when op.ends_with("8") {
            size = 1
        }
        when op.starts_with("AtomicLoad") && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.load(size, false, x64::Reg::RAX, x64::Reg::RAX, 0)
            return true
        }
        when op.starts_with("AtomicStoreSeq") && arguments.len() == 2 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.pop(x64::Reg::RCX)
            asm.atomic_rmw(0, size, x64::Reg::RDX, x64::Reg::RCX)
            return true
        }
        when op.starts_with("AtomicStore") && arguments.len() == 2 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.pop(x64::Reg::RCX)
            asm.store(size, x64::Reg::RAX, x64::Reg::RCX, 0)
            return true
        }
        when (op.starts_with("AtomicXchg") || op.starts_with("AtomicAdd")) && arguments.len() == 2 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.pop(x64::Reg::RCX)
            when op.starts_with("AtomicXchg") {
                asm.atomic_rmw(0, size, x64::Reg::RDX, x64::Reg::RCX)
            } else {
                asm.atomic_rmw(1, size, x64::Reg::RDX, x64::Reg::RCX)
            }
            asm.zext_rr(x64::Reg::RAX, x64::Reg::RDX, size)
            return true
        }
        when op.starts_with("AtomicCas") && arguments.len() == 3 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[2]) {
                return false
            }
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.pop(x64::Reg::RAX)
            asm.pop(x64::Reg::RCX)
            asm.atomic_rmw(2, size, x64::Reg::RDX, x64::Reg::RCX)
            asm.zext_rr(x64::Reg::RAX, x64::Reg::RAX, size)
            return true
        }
        return self.fail("an atomic operation")
    }

    // The bit and memory intrinsics of `std::bits` and `std::mem`, all at 64 bits; the narrower widths are built from them in
    // Ryn. Population count is the portable parallel sum, so no instruction outside baseline x86-64 is emitted: `popcnt`,
    // `lzcnt` and `tzcnt` would run as other instructions (or fault) on older processors. `bsr` and `bsf` leave their
    // destination undefined for zero, so the zero case is tested first and gives 64.
    fun bit_call(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        when (op == "BitClz" || op == "BitCtz" || op == "BitPopcount" || op == "BitBswap" || op == "Prefetch") && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            when op == "Prefetch" {
                asm.prefetch(x64::Reg::RAX)
                return true
            }
            when op == "BitBswap" {
                asm.bswap(x64::Reg::RAX)
                return true
            }
            when op == "BitPopcount" {
                asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
                asm.mov_ri(x64::Reg::RCX, 1)
                asm.shift_cl(5, x64::Reg::RDX)
                asm.mov_ri(x64::Reg::R8, 6148914691236517205)
                asm.alu_rr(33, x64::Reg::RDX, x64::Reg::R8)
                asm.alu_rr(41, x64::Reg::RAX, x64::Reg::RDX)
                asm.mov_ri(x64::Reg::R8, 3689348814741910323)
                asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
                asm.alu_rr(33, x64::Reg::RAX, x64::Reg::R8)
                asm.mov_ri(x64::Reg::RCX, 2)
                asm.shift_cl(5, x64::Reg::RDX)
                asm.alu_rr(33, x64::Reg::RDX, x64::Reg::R8)
                asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RDX)
                asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
                asm.mov_ri(x64::Reg::RCX, 4)
                asm.shift_cl(5, x64::Reg::RDX)
                asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RDX)
                asm.mov_ri(x64::Reg::R8, 1085102592571150095)
                asm.alu_rr(33, x64::Reg::RAX, x64::Reg::R8)
                asm.mov_ri(x64::Reg::R8, 72340172838076673)
                asm.imul_rr(x64::Reg::RAX, x64::Reg::R8)
                asm.mov_ri(x64::Reg::RCX, 56)
                asm.shift_cl(5, x64::Reg::RAX)
                return true
            }
            zero := asm.new_label()
            done := asm.new_label()
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::EQUAL, zero)
            asm.bit_scan(op == "BitClz", x64::Reg::RAX, x64::Reg::RAX)
            when op == "BitClz" {
                asm.alu_ri(6, x64::Reg::RAX, 63)
            }
            asm.jmp(done)
            asm.bind(zero)
            asm.mov_ri(x64::Reg::RAX, 64)
            asm.bind(done)
            return true
        }
        when (op == "BitRotl" || op == "BitRotr") && arguments.len() == 2 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.pop(x64::Reg::RAX)
            when op == "BitRotl" {
                asm.shift_cl(0, x64::Reg::RAX)
            } else {
                asm.shift_cl(1, x64::Reg::RAX)
            }
            return true
        }
        when (op == "MemCopy" || op == "MemMove" || op == "MemSet") && arguments.len() == 3 {
            // destination, source (or the fill byte), count
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[2]) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.pop(x64::Reg::RSI)
            asm.pop(x64::Reg::RDI)
            when op == "MemSet" {
                asm.mov_rr(x64::Reg::RAX, x64::Reg::RSI)
                asm.rep_stosb()
                return true
            }
            when op == "MemCopy" {
                asm.rep_movsb()
                return true
            }
            // memmove: forward when the destination is below the source or past its end, else backward from the last byte.
            forward := asm.new_label()
            done := asm.new_label()
            asm.alu_rr(57, x64::Reg::RDI, x64::Reg::RSI)
            asm.jcc(x64::Cc::BELOW_EQUAL, forward)
            asm.lea(x64::Reg::RAX, x64::Reg::RSI, 0)
            asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RCX)
            asm.alu_rr(57, x64::Reg::RDI, x64::Reg::RAX)
            asm.jcc(x64::Cc::ABOVE_EQUAL, forward)
            asm.lea(x64::Reg::RSI, x64::Reg::RSI, -1)
            asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
            asm.lea(x64::Reg::RDI, x64::Reg::RDI, -1)
            asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RCX)
            asm.std()
            asm.rep_movsb()
            asm.cld()
            asm.jmp(done)
            asm.bind(forward)
            asm.rep_movsb()
            asm.bind(done)
            return true
        }
        return self.fail("an intrinsic")
    }

    // The C library function that computes a math builtin of one argument, and "" for the others.
    fun math_function(self, op: String) -> String {
        when op == "MathSqrt" { return String("sqrt") }
        when op == "MathFloor" { return String("floor") }
        when op == "MathCeil" { return String("ceil") }
        when op == "MathRound" { return String("round") }
        when op == "MathSin" { return String("sin") }
        when op == "MathCos" { return String("cos") }
        when op == "MathTan" { return String("tan") }
        when op == "MathLog" { return String("log") }
        when op == "MathLog2" { return String("log2") }
        when op == "MathLog10" { return String("log10") }
        return String("")
    }

    // The `std::math` builtins, which take and give `f64`. Most call the C math library (which the program is linked with);
    // `abs`, `min`, `max` and `clamp` are computed here, with the rules of Rust's float methods: `min` and `max` give the
    // other value when one is NaN, and `clamp` gives NaN when the bounds are in the wrong order.
    fun math_call(mut self, asm: &mut x64::Asm, op: String, arguments: Vec<u64>) -> bool {
        when op == "MathAbs" && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.mov_ri(x64::Reg::RCX, 1)
            asm.shift_cl(4, x64::Reg::RAX)
            asm.shift_cl(5, x64::Reg::RAX)
            return true
        }
        function := self.math_function(op.clone())
        when !function.is_empty() && arguments.len() == 1 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            when self.freestanding { math::emit(asm, op) return true }
            asm.movq_to_xmm(true, 0, x64::Reg::RAX)
            self.aligned_call(asm, function)
            asm.movq_from_xmm(true, x64::Reg::RAX, 0)
            return true
        }
        when op == "MathPow" && arguments.len() == 2 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            when self.freestanding {
                asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
                asm.pop(x64::Reg::RAX)
                math::emit(asm, op)
                return true
            }
            asm.movq_to_xmm(true, 1, x64::Reg::RAX)
            asm.pop(x64::Reg::RAX)
            asm.movq_to_xmm(true, 0, x64::Reg::RAX)
            self.aligned_call(asm, String("pow"))
            asm.movq_from_xmm(true, x64::Reg::RAX, 0)
            return true
        }
        when (op == "MathMin" || op == "MathMax") && arguments.len() == 2 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            // rax is the first value and rcx the second, each also in an xmm register.
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.pop(x64::Reg::RAX)
            asm.movq_to_xmm(true, 0, x64::Reg::RAX)
            asm.movq_to_xmm(true, 1, x64::Reg::RCX)
            first := asm.new_label()
            second := asm.new_label()
            done := asm.new_label()
            asm.ucomis(8, 0, 0)
            asm.jcc(x64::Cc::PARITY, second)
            asm.ucomis(8, 1, 1)
            asm.jcc(x64::Cc::PARITY, first)
            asm.ucomis(8, 0, 1)
            when op == "MathMax" {
                asm.jcc(x64::Cc::ABOVE, first)
            } else {
                asm.jcc(x64::Cc::BELOW, first)
            }
            asm.bind(second)
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
            asm.bind(first)
            asm.bind(done)
            return true
        }
        when op == "MathClamp" && arguments.len() == 3 {
            when !self.expr(asm, arguments[0]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[1]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, arguments[2]) {
                return false
            }
            // rax is the value, rcx the lower bound and rdx the upper bound.
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.pop(x64::Reg::RCX)
            asm.pop(x64::Reg::RAX)
            asm.movq_to_xmm(true, 0, x64::Reg::RAX)
            asm.movq_to_xmm(true, 1, x64::Reg::RCX)
            asm.movq_to_xmm(true, 2, x64::Reg::RDX)
            not_a_number := asm.new_label()
            keep := asm.new_label()
            lower := asm.new_label()
            upper := asm.new_label()
            done := asm.new_label()
            asm.ucomis(8, 1, 2)
            asm.jcc(x64::Cc::ABOVE, not_a_number)
            asm.ucomis(8, 0, 0)
            asm.jcc(x64::Cc::PARITY, keep)
            asm.ucomis(8, 0, 1)
            asm.jcc(x64::Cc::BELOW, lower)
            asm.ucomis(8, 0, 2)
            asm.jcc(x64::Cc::ABOVE, upper)
            asm.jmp(done)
            asm.bind(keep)
            asm.jmp(done)
            asm.bind(lower)
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
            asm.jmp(done)
            asm.bind(upper)
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
            asm.jmp(done)
            asm.bind(not_a_number)
            asm.mov_ri(x64::Reg::RAX, 0x7FF8000000000000)
            asm.bind(done)
            return true
        }
        return self.op_fail("a math function ", op)
    }

    // The tag of the variant of an enum that is called `name`, when the enum has one.
    fun variant_tag(self, id: u64, name: String) -> Option<u64> {
        mut index: u64 = 0
        while index < self.program.enums[id].variants.len() {
            when self.program.enums[id].variants[index].name == name {
                return Option::Some(index)
            }
            index += 1
        }
        return Option::None
    }

    // The tag of the variant that an unwrap takes: `Ok` of a Result, or `Some` of an Option.
    fun success_tag(self, id: u64) -> Option<u64> {
        when self.variant_tag(id, String("Ok")).is_some() {
            return self.variant_tag(id, String("Ok"))
        }
        return self.variant_tag(id, String("Some"))
    }

    // `is_some`, `is_none`, `is_ok` and `is_err`: the tag of the box is compared with the variant the predicate names.
    fun enum_predicate(mut self, asm: &mut x64::Asm, op: String, id: u64, arguments: Vec<u64>) -> bool {
        when arguments.len() != 1 {
            return self.fail("an enum predicate with another number of arguments")
        }
        mut name := String("")
        when op == "IsSome" {
            name = String("Some")
        }
        when op == "IsNone" {
            name = String("None")
        }
        when op == "IsOk" {
            name = String("Ok")
        }
        when op == "IsErr" {
            name = String("Err")
        }
        when name.len() == 0 {
            return self.fail("an enum predicate that is not in the subset")
        }
        found := self.variant_tag(id, name)
        when found.is_none() {
            return self.fail("an enum predicate on an enum without its variant")
        }
        when !self.expr(asm, arguments[0]) {
            return false
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.alu_ri(7, x64::Reg::RCX, found.unwrap() as i64)
        asm.setcc(x64::Cc::EQUAL, x64::Reg::RAX)
        return true
    }

    // `unwrap_or` of an Option or a Result whose payload is one cell: the payload of the box when its tag is the success
    // tag, and otherwise the default, which is evaluated after the receiver, as the arguments are in order.
    fun enum_unwrap_or(mut self, asm: &mut x64::Asm, id: u64, ty: u64, arguments: Vec<u64>) -> bool {
        when arguments.len() != 2 {
            return self.fail("an unwrap with another number of arguments")
        }
        when !self.is_cell(ty) && self.aggregate_cells(ty) == 0 {
            return self.fail("an unwrap of a payload of this type")
        }
        when self.success_tag(id).is_none() {
            return self.fail("an unwrap of an enum that is not an Option or a Result")
        }
        tag := self.success_tag(id).unwrap()
        when !self.is_cell(ty) {
            return self.enum_unwrap_or_aggregate(asm, ty, tag, arguments)
        }
        when !self.expr(asm, arguments[0]) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, arguments[1]) {
            return false
        }
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.pop(x64::Reg::RAX)
        fallback := asm.new_label()
        done := asm.new_label()
        // The result is an owner of its own: a payload is copied from the box, and a borrowed fallback is copied too.
        owned := self.owned_cells(ty)
        mut copy: u64 = 0
        when owned.is_some() && owned.unwrap().len() == 3 {
            copy = 1
        }
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.alu_ri(7, x64::Reg::RCX, tag as i64)
        asm.jcc(x64::Cc::NOT_EQUAL, fallback)
        when self.has_owners(ty) && !self.is_local_expr(arguments[1]) {
            asm.push(x64::Reg::RAX)
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RDX)
            asm.call_label(self.handle_drop_routine(asm, ty))
            asm.pop(x64::Reg::RAX)
        }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 8)
        when copy == 1 {
            copies := self.owned_cells(ty).unwrap()
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.call_label(self.copy_routine(asm, copies[1], copies[2]))
        }
        asm.jmp(done)
        asm.bind(fallback)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
        when copy == 1 && self.is_local_expr(arguments[1]) {
            copies := self.owned_cells(ty).unwrap()
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.call_label(self.copy_routine(asm, copies[1], copies[2]))
        }
        asm.bind(done)
        return true
    }

    // Whether an expression reads a local without moving it: its value is borrowed, and a copy of it is an owner of its own.
    fun is_local_expr(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => true,
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.place_of(index).is_some(),
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => borrowed,
            _ => false,
        }
    }

    // `unwrap_or` of a string or structure payload: the payload's cells are pushed, as a call returns them, or else the
    // fallback is. The fallback is evaluated only on the fallback path, so it must be pure to keep the program's meaning.
    fun enum_unwrap_or_aggregate(mut self, asm: &mut x64::Asm, ty: u64, tag: u64, arguments: Vec<u64>) -> bool {
        when self.has_destructor(ty) { return self.fail("an unwrap of a payload with a destructor") }
        box := self.scratch(1)
        count := self.aggregate_cells(ty)
        default := self.scratch(count)
        when !self.expr(asm, arguments[0]) { return false }
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(box))
        when !self.push_value(asm, arguments[1], ty) { return false }
        when !self.store_pushed(asm, default, count) { return false }
        fallback := asm.new_label()
        done := asm.new_label()
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(box))
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.alu_ri(7, x64::Reg::RCX, tag as i64)
        asm.jcc(x64::Cc::NOT_EQUAL, fallback)
        when !self.is_local_expr(arguments[1]) { self.drop_slot(asm, default, ty) }
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(box))
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (1 + cell)) as i64)
            asm.push(x64::Reg::RCX)
            cell += 1
        }
        when !self.clone_stack_value(asm, ty) { return false }
        asm.jmp(done)
        asm.bind(fallback)
        when !self.push_local_cells(asm, default, count) { return false }
        when self.is_local_expr(arguments[1]) {
            when !self.clone_stack_value(asm, ty) { return false }
        }
        asm.bind(done)
        return true
    }

    // Replaces each owning cell of a pushed value with an independent copy.
    fun clone_stack_value(mut self, asm: &mut x64::Asm, ty: u64) -> bool {
        copies := self.owned_cells(ty)
        when copies.is_none() { return self.fail("a copy of this payload") }
        list := copies.unwrap()
        mut at: u64 = 0
        while at < list.len() {
            asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, list[at] as i64)
            asm.call_label(self.copy_routine(asm, list[at + 1], list[at + 2]))
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, list[at] as i64)
            at += 3
        }
        return true
    }

    // `unwrap`, `expect` and `unwrap_err` of an Option or a Result whose payload is one cell. The wrong variant writes the
    // runtime's message to standard error and exits with status 1. An `expect` message must be a string literal, so that
    // the message is known when the code is generated.
    fun enum_unwrap(mut self, asm: &mut x64::Asm, id: u64, ty: u64, message: bool, tag: u64, failure: String, arguments: Vec<u64>) -> bool {
        mut expected: u64 = 1
        when message {
            expected = 2
        }
        when arguments.len() != expected {
            return self.fail("an unwrap with another number of arguments")
        }
        when !self.is_cell(ty) && self.aggregate_cells(ty) == 0 {
            return self.fail("an unwrap of a payload of this type")
        }
        moving := self.owned_cells(ty).is_none()
        mut text := String("")
        when failure == "OptionUnwrapFailed" {
            text = String("Ryn runtime error: called Option.unwrap() on None\n")
        }
        when failure == "ResultUnwrapFailed" {
            text = String("Ryn runtime error: called Result extraction on the wrong variant\n")
        }
        when failure == "OptionExpectFailed" {
            when !message {
                return self.fail("an expect without a message")
            }
            literal := self.string_literal(arguments[1])
            when literal.is_none() {
                return self.fail("an expect message that is not a literal")
            }
            text = String("Ryn runtime error: ")
            text.append(literal.unwrap())
            text.append(String("\n"))
        }
        when text.len() == 0 {
            return self.fail("an unwrap failure that is not in the subset")
        }
        when !self.expr(asm, arguments[0]) {
            return false
        }
        done := asm.new_label()
        failed := asm.new_label()
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.alu_ri(7, x64::Reg::RCX, tag as i64)
        asm.jcc(x64::Cc::NOT_EQUAL, failed)
        when self.is_cell(ty) {
            asm.mov_rr(x64::Reg::RDX, x64::Reg::RAX)
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 8)
            when moving {
                asm.mov_ri(x64::Reg::RCX, 0)
                asm.store(8, x64::Reg::RCX, x64::Reg::RDX, 8)
            }
            // The payload is a copy of what the box owns, as the runtime's unwrap copies it; the box keeps its own.
            owned := self.owned_cells(ty)
            when owned.is_some() && owned.unwrap().len() == 3 {
                copies := self.owned_cells(ty).unwrap()
                asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
                asm.call_label(self.copy_routine(asm, copies[1], copies[2]))
            }
        } else {
            // A string or structure payload is pushed as its cells, as a call returns it.
            count := self.aggregate_cells(ty)
            mut cell: u64 = 0
            while cell < count {
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (1 + cell)) as i64)
                asm.push(x64::Reg::RCX)
                cell += 1
            }
            when moving {
                asm.mov_ri(x64::Reg::RDX, 0)
                cell = 0
                while cell < count {
                    asm.store(8, x64::Reg::RDX, x64::Reg::RAX, (8 * (1 + cell)) as i64)
                    cell += 1
                }
            }
            // The payload's owners are copies too: each is replaced on the stack by its copy.
            copies := self.owned_cells(ty)
            when copies.is_some() {
                list := copies.unwrap()
                mut at: u64 = 0
                while at < list.len() {
                    asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, list[at] as i64)
                    asm.call_label(self.copy_routine(asm, list[at + 1], list[at + 2]))
                    asm.store(8, x64::Reg::RAX, x64::Reg::RSP, list[at] as i64)
                    at += 3
                }
            }
        }
        asm.jmp(done)
        asm.bind(failed)
        self.fail_exit(asm, text)
        asm.bind(done)
        return true
    }

    // A call of a C function with scalar, pointer and bool arguments and result: the arguments go to the System V
    // registers, the stack is aligned for the call, and the result is in rax, brought to its width.
    fun call_foreign(mut self, asm: &mut x64::Asm, parameters: Vec<u64>, result: Option<u64>, name: String, arguments: Vec<u64>) -> bool {
        // Lowering passes more arguments than the parameters only to a variadic C function, and casts each one to its type.
        when arguments.len() < parameters.len() / 2 {
            return self.fail("a foreign call with this number of arguments")
        }
        when arguments.len() > parameters.len() / 2 && self.windows {
            return self.fail("a variadic C call on Windows")
        }
        outer_copies := self.ffi_copies.clone()
        self.ffi_copies = Vec()
        // A `ryn_` shim belongs to the runtime; one the native compiler does not provide would not resolve when it runs.
        when name.starts_with("ryn_") && !rt_provides(name.clone()) {
            return self.fail("a runtime shim that the native compiler does not provide")
        }
        // The live counters belong to the freestanding allocator; a program linked against the C library allocates with
        // libc's `malloc`, which they do not count, so the counter is declined rather than left unresolved at run time.
        when !self.freestanding && (name == "ryn_native_live_allocations" || name == "ryn_native_live_bytes") {
            return self.fail("the live allocation counter of a program that uses the C library")
        }
        mut types: Vec<u64> = Vec()
        mut position: u64 = 0
        for argument in arguments.clone() {
            // A variable argument has the type of its cast, since it has no declared parameter.
            mut ty: u64 = 0
            when position < parameters.len() / 2 {
                ty = parameters[position * 2 + 1]
            } else {
                found := self.variadic_type(argument)
                when found.is_none() {
                    return self.fail("a variable argument without its type")
                }
                ty = found.unwrap()
            }
            types.push(ty)
            when !self.push_value(asm, argument, ty) {
                return false
            }
            position += 1
        }
        // The System V convention passes in al the number of vector registers that hold arguments, for a variadic callee.
        mut vector_registers: u64 = 0
        for ty in types.clone() {
            when self.is_sse(ty) {
                vector_registers += 1
            } else {
                for class in self.c_classes(ty) {
                    when class == 1 {
                        vector_registers += 1
                    }
                }
            }
        }
        // A Windows program reaches the operating system through the emulated system calls (`write`, `read`, `open`,
        // `close`) or the scalar functions of the C runtime library (`ucrtbase.dll`), called with the Windows convention.
        mine := self.ffi_copies.clone()
        self.ffi_copies = outer_copies
        windows_call := self.windows && self.freestanding && !rt_provides(name.clone()) && !ffi_helpers::is_helper(name.clone())
        system_number := windows_system_number(name.clone())
        when windows_call && system_number == 0 {
            // The arguments stay on the stack as pushed; the call copies them where Windows expects them.
            self.sync_shadows(asm, false)
            when !self.windows_import_call(asm, name.clone(), types) {
                return false
            }
            self.ffi_copy_back(asm, mine.clone())
            return self.finish_c_call(asm, result)
        }
        when !self.load_c_arguments(asm, types) {
            return false
        }
        self.sync_shadows(asm, false)
        when windows_call {
            when system_number != 0 {
                // The emulated call answers with a negative error number; a C function answers -1.
                asm.mov_ri(x64::Reg::RAX, system_number - 1000)
                asm.syscall()
                nonnegative := asm.new_label()
                asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
                asm.jcc(x64::Cc::GREATER_EQUAL, nonnegative)
                asm.unary(3, x64::Reg::RAX)
                asm.lea_symbol(x64::Reg::RCX, self.rt.state)
                asm.store(4, x64::Reg::RAX, x64::Reg::RCX, 16)
                asm.mov_ri(x64::Reg::RAX, 18446744073709551615)
                asm.bind(nonnegative)
                // `getcwd` answers its buffer, or a null pointer on failure; the call answered a length, or -1.
                when name == "getcwd" {
                    failed_cwd := asm.new_label()
                    cwd_done := asm.new_label()
                    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
                    asm.jcc(x64::Cc::LESS, failed_cwd)
                    asm.mov_rr(x64::Reg::RAX, x64::Reg::RDI)
                    asm.jmp(cwd_done)
                    asm.bind(failed_cwd)
                    asm.mov_ri(x64::Reg::RAX, 0)
                    asm.bind(cwd_done)
                }
            }
        } else when self.freestanding && !rt_provides(name.clone()) {
            // A freestanding program cannot make this call: it is built again against the C library.
            self.wants_libc = true
            asm.trap()
        } else when self.c_overflow.len() > 0 {
            when !self.stack_argument_call(asm, name.clone(), arguments.len(), vector_registers) {
                return false
            }
        } else {
            asm.mov_ri(x64::Reg::RAX, vector_registers)
            self.aligned_call(asm, name)
        }
        self.ffi_copy_back(asm, mine.clone())
        return self.finish_c_call(asm, result)
    }

    // A pointer to element `index` of the local array `array`, for a C call (see `FfiArray` in ir.ryn). The elements are
    // packed, one `width`-byte element each, into a frame buffer that the call reads and, when the pointer is mutable, the
    // copy-back after the call writes into the array's cells. The index is checked against the length.
    fun ffi_array(mut self, asm: &mut x64::Asm, array: u64, element: u64, length: u64, index: u64, mutable: bool) -> bool {
        slot := self.array_local_of(array)
        when slot.is_none() {
            return self.fail("a pointer into an array that is not a local")
        }
        word := self.word(element)
        width := ffi_width_of(word.clone())
        when width == 0 || length == 0 {
            return self.fail("a pointer into an array of this element type")
        }
        cells := ffi_cells(length, width)
        buffer := self.scratch(cells)
        when !self.expr(asm, index) {
            return false
        }
        asm.mov_ri(x64::Reg::RDX, length)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        asm.push(x64::Reg::RAX)
        // Element k of the array is the cell at 8 * k above the lowest address of the array (see `array_as_slice`).
        asm.lea(x64::Reg::R10, x64::Reg::RBP, slot_disp(slot.unwrap() + length - 1))
        asm.lea(x64::Reg::RCX, x64::Reg::RBP, slot_disp(buffer + cells - 1))
        mut k: u64 = 0
        while k < length {
            asm.load(8, false, x64::Reg::R11, x64::Reg::R10, (k * 8) as i64)
            asm.store(width, x64::Reg::R11, x64::Reg::RCX, (k * width) as i64)
            k += 1
        }
        asm.pop(x64::Reg::RAX)
        self.scale_bytes(asm, x64::Reg::RAX, width)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RCX)
        mut flag: u64 = 0
        when mutable {
            flag = 1
        }
        mut signed: u64 = 0
        when ffi_signed_word(word) {
            signed = 1
        }
        self.ffi_copies.push(slot.unwrap())
        self.ffi_copies.push(width)
        self.ffi_copies.push(signed)
        self.ffi_copies.push(length)
        self.ffi_copies.push(buffer)
        self.ffi_copies.push(flag)
        return true
    }

    // Writes the elements of the mutable buffers of a finished C call back into their arrays (six words per entry).
    fun ffi_copy_back(mut self, asm: &mut x64::Asm, entries: Vec<u64>) {
        mut at: u64 = 0
        while at + 6 <= entries.len() {
            when entries[at + 5] == 1 {
                width := entries[at + 1]
                length := entries[at + 3]
                asm.lea(x64::Reg::R10, x64::Reg::RBP, slot_disp(entries[at] + length - 1))
                asm.lea(x64::Reg::RCX, x64::Reg::RBP, slot_disp(entries[at + 4] + ffi_cells(length, width) - 1))
                mut k: u64 = 0
                while k < length {
                    asm.load(width, entries[at + 2] == 1, x64::Reg::R11, x64::Reg::RCX, (k * width) as i64)
                    asm.store(8, x64::Reg::R11, x64::Reg::R10, (k * 8) as i64)
                    k += 1
                }
            }
            at += 6
        }
    }

    // The type of a variable argument: lowering wraps it in a cast to its own type.
    fun variadic_type(self, argument: u64) -> Option<u64> {
        return choose self.program.exprs[argument] {
            ir::IrExpr::FfiArray(array, element, length, index, mutable) => Option::None,
            ir::IrExpr::CastExpr(value, source, target) => Option::Some(target),
            _ => Option::None,
        }
    }

    // A call of a C function some of whose arguments (`self.c_overflow`, by position) go to the stack, of the `count`
    // arguments that are pushed in order: the stack is aligned, the stack arguments are pushed last one first, and
    // all the pushed cells are dropped after the call.
    fun stack_argument_call(mut self, asm: &mut x64::Asm, name: String, count: u64, vector_registers: u64) -> bool {
        when self.freestanding || self.windows {
            return self.fail("a foreign call with this many arguments")
        }
        spilled := self.c_overflow.clone()
        asm.push(x64::Reg::RBX)
        asm.mov_rr(x64::Reg::RBX, x64::Reg::RSP)
        asm.alu_ri(4, x64::Reg::RSP, (0 as i64) - 16)
        when spilled.len() % 2 == 1 {
            asm.alu_ri(5, x64::Reg::RSP, 8)
        }
        mut at: u64 = spilled.len()
        while at > 0 {
            at -= 1
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBX, (8 + 8 * (count - 1 - spilled[at])) as i64)
            asm.push(x64::Reg::RAX)
        }
        // The loads above use rax, so al is set after them.
        asm.mov_ri(x64::Reg::RAX, vector_registers)
        asm.call_symbol(self.foreign_symbol(name))
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBX)
        asm.pop(x64::Reg::RBX)
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    // A call of a Windows function with the arguments `types` on the stack (the first pushed first): the first four go to
    // rcx, rdx, r8 and r9 by position (a float to the xmm register of its position), the rest to the stack above 32 bytes
    // of shadow space, and the pushed cells are dropped after the call. Nothing is passed by value that is larger than a
    // register, and no function pointer is passed, since the callee would call it with the System V convention.
    fun windows_import_call(mut self, asm: &mut x64::Asm, name: String, types: Vec<u64>) -> bool {
        // Windows has no symbolic-link query by this name: the call answers -1, as for a path that is not a link.
        when name == "readlink" {
            asm.alu_ri(0, x64::Reg::RSP, (8 * types.len()) as i64)
            asm.mov_ri(x64::Reg::RAX, 18446744073709551615)
            return true
        }
        when windows_unavailable(name.clone()) {
            mut reason := String("the C library function `")
            reason.append(name)
            reason.append("` is not available in a Windows program yet")
            self.failed = true
            when self.reason.is_empty() {
                self.reason = reason
            }
            return false
        }
        imported := self.foreign_symbol(windows_import_name(name))
        return self.windows_call_core(asm, imported, false, types)
    }

    // The call itself: `indirect` takes the target from the cell below the arguments (a function pointer), otherwise it is
    // the symbol `imported`.
    fun windows_call_core(mut self, asm: &mut x64::Asm, imported: u64, indirect: bool, types: Vec<u64>) -> bool {
        count := types.len()
        for ty in types.clone() {
            when self.c_classes(ty).len() > 0 || self.cells_of(ty) != 1 {
                return self.fail("a record argument of a foreign call in a Windows program")
            }
        }
        mut extra: u64 = 0
        when count > 4 {
            extra = count - 4
        }
        frame := (32 + 8 * extra + 15) / 16 * 16
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        when indirect {
            asm.load(8, false, x64::Reg::R11, x64::Reg::RBP, (8 + 8 * count) as i64)
        }
        asm.alu_ri(4, x64::Reg::RSP, (0 as i64) - 16)
        asm.alu_ri(5, x64::Reg::RSP, frame as i64)
        mut index: u64 = 4
        while index < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (8 + 8 * (count - 1 - index)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RSP, (32 + 8 * (index - 4)) as i64)
            index += 1
        }
        index = 0
        while index < count && index < 4 {
            offset := (8 + 8 * (count - 1 - index)) as i64
            when self.is_sse(types[index]) {
                asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, offset)
                asm.movq_to_xmm(self.word(types[index]) == "F64", index, x64::Reg::RAX)
            } else {
                asm.load(8, false, windows_argument_register(index), x64::Reg::RBP, offset)
            }
            index += 1
        }
        when indirect {
            asm.call_reg(x64::Reg::R11)
        } else {
            asm.call_symbol(imported)
        }
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        mut cells := count
        when indirect {
            cells += 1
        }
        when cells > 0 {
            asm.alu_ri(0, x64::Reg::RSP, (8 * cells) as i64)
        }
        return true
    }

    fun is_function_pointer(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::FunctionPointerTo(parameters, result, external) => true,
            _ => false,
        }
    }

    // After a foreign call: the result is taken, and the `repr(C)` locals whose address was given out are read back from
    // their C layout (the result in rax is kept across that).
    fun finish_c_call(mut self, asm: &mut x64::Asm, result: Option<u64>) -> bool {
        when !self.take_c_result(asm, result) {
            return false
        }
        when self.shadow_slots.len() > 0 {
            asm.push(x64::Reg::RAX)
            self.sync_shadows(asm, true)
            asm.pop(x64::Reg::RAX)
        }
        return true
    }

    // Pushes the cells of a value of type `ty`, in cell order: a scalar is one, a str is its address and length, and a
    // structure is its fields in declaration order, each taking its own cells. A structure value is pushed in field
    // order only, because the fields are evaluated in the order they are written.
    fun push_value(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        when self.is_str(ty) {
            literal := self.string_literal(value)
            when literal.is_some() {
                index := self.literal(literal.unwrap())
                asm.lea_symbol(x64::Reg::RAX, self.literal_symbols[index])
                asm.push(x64::Reg::RAX)
                asm.mov_ri(x64::Reg::RAX, self.literal_lengths[index])
                asm.push(x64::Reg::RAX)
                return true
            }
            source := self.struct_local_of(value)
            when source.is_none() {
                return choose self.program.exprs[value] {
                    ir::IrExpr::MoveRef(slot, mty) => self.push_local_cells(asm, slot, 2),
                    ir::IrExpr::CallExpr(target, arguments, cty) => self.call_expression(asm, target, arguments),
                    ir::IrExpr::FieldRead(fv, fid, field, fty, fspan) => self.push_field_str(asm, value),
                    ir::IrExpr::ReferenceFieldRead(rp, rid, rfield, rty, rspan, rborrowed) => self.push_field_str(asm, value),
                    ir::IrExpr::StringAsStr(inner) => self.push_string_as_str(asm, inner),
                    ir::IrExpr::IfExpr(condition, then_value, else_value, ity) => self.push_if(asm, condition, then_value, else_value, ity),
                    ir::IrExpr::EnumMatch(matched, mid, arms, mty) => self.enum_match(asm, matched, mid, arms, mty),
                    _ => self.fail_at("a string argument that is not a literal or a local", value),
                }
            }
            return self.push_local_cells(asm, source.unwrap(), 2)
        }
        when self.is_cell(ty) {
            when !self.expr(asm, value) {
                return false
            }
            asm.push(x64::Reg::RAX)
            return true
        }
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.push_structure(asm, value, id),
            ir::IrTy::ArrayOf(element, length) => self.push_array(asm, value, ty),
            ir::IrTy::SliceOf(element) => self.push_slice(asm, value),
            _ => self.fail("an argument of this type"),
        }
    }

    fun push_structure(mut self, asm: &mut x64::Asm, value: u64, id: u64) -> bool {
        base := self.place_of(value)
        when base.is_some() && self.struct_destructor_cells(id).len() == 0 {
            return self.push_local_cells(asm, base.unwrap(), self.program.structs[id].slot_count)
        }
        when self.is_memory_place(value) && self.struct_destructor_cells(id).len() == 0 {
            when !self.memory_address(asm, value) {
                return false
            }
            self.copy_ty_id = 0
            when self.program.structs[id].repr_c {
                self.copy_ty_id = id + 1
            }
            result := self.push_memory_cells(asm, self.program.structs[id].slot_count)
            self.copy_ty_id = 0
            when result && !self.memory_borrowed(value) {
                return self.clone_stack_value(asm, self.struct_type(id))
            }
            return result
        }
        return choose self.program.exprs[value] {
            ir::IrExpr::Propagate(v, input, output, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred) => self.push_propagated(asm, v, id, failure_type, success_variant, output_failure_variant, deferred),
            ir::IrExpr::LocalRef(slot, ty, span) => self.push_local_cells(asm, slot, self.program.structs[id].slot_count),
            ir::IrExpr::StructValue(sid, fields, values) => self.push_fields(asm, sid, fields, values),
            ir::IrExpr::MoveRef(slot, mty) => self.push_moved(asm, slot, id),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_expression(asm, target, arguments),
            ir::IrExpr::EnumMatch(matched, mid, arms, mty) => self.enum_match(asm, matched, mid, arms, mty),
            ir::IrExpr::IfExpr(condition, then_value, else_value, ity) => self.push_if(asm, condition, then_value, else_value, ity),
            ir::IrExpr::FieldRead(outer, oid, field, fty, fspan) => self.push_field_struct(asm, outer, oid, field, id),
            _ => self.fail_at("a structure argument", value),
        }
    }

    fun push_fields(mut self, asm: &mut x64::Asm, id: u64, fields: Vec<u64>, values: Vec<u64>) -> bool {
        when fields.len() != self.program.structs[id].fields.len() {
            return self.fail("a structure value with missing fields")
        }
        mut in_order := true
        mut position: u64 = 0
        while position < fields.len() {
            when fields[position] != position {
                in_order = false
            }
            position += 1
        }
        // Fields written out of declaration order are evaluated in the order they are written, into scratch cells, and the
        // cells are then pushed in declaration order.
        when !in_order {
            count := self.program.structs[id].slot_count
            saved := self.scratch(count)
            when !self.store_fields(asm, saved, id, id, fields.clone(), values.clone()) {
                return false
            }
            return self.push_local_cells(asm, saved, count)
        }
        position = 0
        while position < fields.len() {
            field_ty := self.program.structs[id].fields[position].ty
            when !self.push_value(asm, values[position], field_ty) {
                return false
            }
            position += 1
        }
        return true
    }

    // A structure local moved out: its cells are pushed, and its destructor handles are nulled.
    fun push_moved(mut self, asm: &mut x64::Asm, slot: u64, id: u64) -> bool {
        when !self.push_local_cells(asm, slot, self.program.structs[id].slot_count) {
            return false
        }
        self.null_moved(asm, slot, id)
        return true
    }

    // A structure local moved into the cells from `base` on: copied, and its destructor handles are nulled.
    fun store_moved(mut self, asm: &mut x64::Asm, slot: u64, base: u64, id: u64) -> bool {
        when !self.copy_cells(asm, slot, base, self.program.structs[id].slot_count) {
            return false
        }
        self.null_moved(asm, slot, id)
        return true
    }

    // Pushes `count` cells of the local at `slot`, from its first cell.
    fun push_local_cells(mut self, asm: &mut x64::Asm, slot: u64, count: u64) -> bool {
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot + cell))
            asm.push(x64::Reg::RAX)
            cell += 1
        }
        return true
    }

    // The number of cells a parameter of type `ty` takes: a structure takes its slot count.
    fun cells_of(self, ty: u64) -> u64 {
        when self.is_str(ty) {
            return 2
        }
        structure_cells := choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.program.structs[id].slot_count,
            _ => 0,
        }
        when structure_cells > 0 {
            return structure_cells
        }
        when self.array_element_of(ty).is_some() {
            return self.array_cells(ty)
        }
        when self.slice_element(ty).is_some() {
            return 2
        }
        when self.is_cell(ty) {
            return 1
        }
        return 0
    }

    // The cells that a string, array or structure value takes on the stack, and zero for any other type.
    fun aggregate_cells(self, ty: u64) -> u64 {
        when self.is_str(ty) {
            return 2
        }
        when self.array_element_of(ty).is_some() {
            return self.array_cells(ty)
        }
        when self.slice_element(ty).is_some() {
            return 2
        }
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.program.structs[id].slot_count,
            _ => 0,
        }
    }

    // The first cell of a structure local, when the expression is one.
    fun struct_local_of(self, index: u64) -> Option<u64> {
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => Option::Some(slot),
            _ => Option::None,
        }
    }

    // The slot of an array local, when the expression is one.
    fun array_local_of(self, index: u64) -> Option<u64> {
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => Option::Some(slot),
            ir::IrExpr::MoveRef(slot, ty) => Option::Some(slot),
            _ => Option::None,
        }
    }

    // Whether a type is a scalar of one cell with no ownership: an integer, bool, char or float. Arrays hold only these.
    fun is_plain_scalar(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => width_of(word) != 0,
            _ => false,
        }
    }

    // The element type of an array of plain scalars, or None for any other type. An array takes one cell per element,
    // element `i` in cell `slot + i`, as the frame layout of a structure's fields does.
    fun array_element_of(self, ty: u64) -> Option<u64> {
        found := choose self.program.types[ty] {
            ir::IrTy::ArrayOf(element, length) => Option::Some(element),
            _ => Option::None,
        }
        when found.is_none() {
            return Option::None
        }
        when !self.is_plain_scalar(found.unwrap()) && !self.is_array_element_structure(found.unwrap()) && !self.is_owner_cell(found.unwrap()) && !self.is_plain_array(found.unwrap()) && !self.is_str(found.unwrap()) {
            return Option::None
        }
        return found
    }

    // A value that is one cell and owns memory: a String, vector, map, set or enum. Such an element is cloned when read.
    fun is_owner_cell(self, ty: u64) -> bool {
        return self.is_cell(ty) && self.has_owners(ty)
    }

    // A structure that holds no owner and no destructor: its value is only its cells, so it can be an array element.
    fun is_value_structure(self, ty: u64) -> bool {
        return self.is_plain_structure(ty) && !self.has_owners(ty)
    }

    // An array of plain scalars, as an element of a nested array: it takes its own cells, element `j` above element `j - 1`.
    fun is_plain_array(self, ty: u64) -> bool {
        element := choose self.program.types[ty] {
            ir::IrTy::ArrayOf(e, n) => Option::Some(e),
            _ => Option::None,
        }
        when element.is_none() {
            return false
        }
        return self.is_plain_scalar(element.unwrap())
    }

    // A structure element: any structure without a destructor whose owners a clone can copy (see `owned_cells`).
    // A structure element of an array: any structure whose owners a clone can copy, destructors included. The array's drops run
    // the owners in the bootstrap's order (see `phys_slot`).
    fun is_array_element_structure(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.program.structs[id].slot_count > 0 && self.owned_cells(ty).is_some(),
            _ => false,
        }
    }

    // A structure without a destructor, of its own or in a field: a map keeps its value in a box only when it can clone it.
    fun is_element_structure(self, ty: u64) -> bool {
        return self.is_plain_structure(ty) && self.owned_cells(ty).is_some()
    }

    // The cells of an array value: each of its elements takes `cells_of(element)` cells.
    fun array_cells(self, ty: u64) -> u64 {
        element := self.array_element_of(ty)
        when element.is_none() {
            return self.array_length_of(ty)
        }
        return self.array_length_of(ty) * self.cells_of(element.unwrap())
    }

    // The number of elements of an array type, and zero for any other type.
    fun array_length_of(self, ty: u64) -> u64 {
        return choose self.program.types[ty] {
            ir::IrTy::ArrayOf(element, length) => length,
            _ => 0,
        }
    }

    // Leaves rdx at the address that element `index` of an array is found from: element 0 of an array of `n` at slot `s` is
    // its lowest cell, `s + n - 1`, and element `i` is `8 * i` above it, at `rdx + slot_disp(s + n - 1)`. The index is
    // copied to rcx and scaled there, so rcx and r11 are clobbered and the index register is kept.
    fun element_base(self, asm: &mut x64::Asm, index: u64) {
        self.element_base_stride(asm, index, 1)
    }

    // The same for elements of `cells` cells: element `i` is `8 * cells * i` above element 0.
    fun element_base_stride(self, asm: &mut x64::Asm, index: u64, cells: u64) {
        asm.mov_rr(x64::Reg::RCX, index)
        self.scale_bytes(asm, x64::Reg::RCX, 8 * cells)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RBP)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RCX)
    }

    // The address in rax of element `index` of an array local, as `memory_address` takes it: the lowest cell of the element.
    // Element `i` lies `8 * cells` above element `i - 1`, and the cell `k` of an element is `8 * (cells - 1 - k)` above its
    // lowest cell, so the frame's cells are read as memory the same way a structure in memory is.
    fun array_element_address(mut self, asm: &mut x64::Asm, array: u64, index: u64, element: u64, length: u64) -> bool {
        slot := self.array_local_of(array)
        when slot.is_none() {
            return self.memory_array_element_address(asm, array, index, element, length)
        }
        cells := self.cells_of(element)
        when !self.expr(asm, index) {
            return false
        }
        asm.alu_ri(7, x64::Reg::RAX, length as i64)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        self.element_base_stride(asm, x64::Reg::RAX, cells)
        asm.lea(x64::Reg::RAX, x64::Reg::RDX, slot_disp(slot.unwrap() + length * cells - 1))
        return true
    }

    // The address in rax of element `index` of an array that lies in memory (a field reached through a reference): the array's
    // lowest cell is at `memory_address`, and element `i` is `8 * cells * i` above it.
    fun memory_array_element_address(mut self, asm: &mut x64::Asm, array: u64, index: u64, element: u64, length: u64) -> bool {
        when !self.is_memory_place(array) {
            return self.fail("an index into an array that is not a local")
        }
        cells := self.cells_of(element)
        when !self.memory_address(asm, array) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, index) {
            return false
        }
        asm.alu_ri(7, x64::Reg::RAX, length as i64)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        self.scale_bytes(asm, x64::Reg::RAX, 8 * cells)
        asm.pop(x64::Reg::RDX)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RDX)
        return true
    }

    // Pushes the value of each item in order, so that item `i` is the cell that a pushed array has at position `i`.
    fun push_array_items(mut self, asm: &mut x64::Asm, items: Vec<u64>) -> bool {
        mut position: u64 = 0
        while position < items.len() {
            when !self.expr(asm, items[position]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            position += 1
        }
        return true
    }

    // `[item; count]`: the item is evaluated once, and its value is pushed `count` times.
    fun push_array_repeat(mut self, asm: &mut x64::Asm, item: u64, count: u64) -> bool {
        when !self.expr(asm, item) {
            return false
        }
        mut at: u64 = 0
        while at < count {
            asm.push(x64::Reg::RAX)
            at += 1
        }
        return true
    }

    // An array of plain scalars pushed as its cells, element 0 first, as an argument or a returned value is pushed.
    fun push_array(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        when self.array_element_of(ty).is_none() {
            return self.fail("an array of this element type")
        }
        cells := self.array_cells(ty)
        return choose self.program.exprs[value] {
            ir::IrExpr::ArrayValue(items) => self.push_array_through_scratch(asm, value, ty),
            ir::IrExpr::ArrayRepeat(item, count) => self.push_array_through_scratch(asm, value, ty),
            ir::IrExpr::LocalRef(slot, lty, span) => self.push_local_array(asm, slot, ty),
            ir::IrExpr::MoveRef(slot, mty) => self.push_moved_array(asm, slot, ty),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_expression(asm, target, arguments),
            _ => self.fail("an array argument of this kind"),
        }
    }

    // Stores an array of plain scalars into the cells from `base` on. The items of a value are all evaluated before any
    // cell is written, since the value may read the array it replaces.
    fun store_array(mut self, asm: &mut x64::Asm, value: u64, base: u64, ty: u64) -> bool {
        when self.array_element_of(ty).is_none() {
            return self.fail("an array of this element type")
        }
        when self.has_owners(ty) && self.array_local_of(value).is_some() && !self.is_move_expr(value) {
            return self.fail("an owning array read without a move")
        }
        result := self.store_array_parts(asm, value, base, self.array_element_of(ty).unwrap(), self.array_length_of(ty))
        when result && self.is_move_expr(value) && self.has_owners(ty) {
            self.null_owners(asm, self.array_local_of(value).unwrap(), ty)
        }
        return result
    }

    // Whether an expression moves a local (as opposed to reading it).
    fun is_move_expr(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::MoveRef(slot, mty) => true,
            _ => false,
        }
    }

    // An owning array read from a local would alias its owners, so only a moved one is pushed.
    fun push_local_array(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        when self.has_owners(ty) {
            return self.fail("an owning array read without a move")
        }
        return self.push_local_cells(asm, slot, self.array_cells(ty))
    }

    // A moved array: its cells are pushed, and the owners in them are cleared, so the local no longer frees them.
    fun push_moved_array(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        when !self.push_local_cells(asm, slot, self.array_cells(ty)) {
            return false
        }
        self.null_owners(asm, slot, ty)
        return true
    }

    // An array value pushed as its cells: it is built in scratch cells first, since its cells are in the reverse of the
    // order its items are evaluated in.
    fun push_array_through_scratch(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        cells := self.array_cells(ty)
        base := self.scratch(cells)
        when !self.store_array(asm, value, base, ty) {
            return false
        }
        return self.push_local_cells(asm, base, cells)
    }

    // `count` scratch cells of the function being generated, as the slot of the first.
    fun scratch(mut self, count: u64) -> u64 {
        slot := self.scratch_base + self.scratch_used
        self.scratch_used += count
        return slot
    }

    fun store_array_parts(mut self, asm: &mut x64::Asm, value: u64, base: u64, element: u64, length: u64) -> bool {
        cells := length * self.cells_of(element)
        return choose self.program.exprs[value] {
            ir::IrExpr::ArrayValue(items) => self.store_array_items(asm, items, base, element),
            ir::IrExpr::ArrayRepeat(item, count) => self.store_array_repeat(asm, item, base, element, count),
            ir::IrExpr::LocalRef(slot, lty, span) => self.copy_cells(asm, slot, base, cells),
            ir::IrExpr::MoveRef(slot, mty) => self.copy_cells(asm, slot, base, cells),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_into(asm, target, arguments, base, cells),
            _ => self.fail("an array value of this kind"),
        }
    }

    // The items are pushed, then stored last to first. Element `i` of an array of `n` is in cell `base + n - 1 - i`, so the
    // elements ascend in memory from the lowest cell, as a slice of them reads them.
    fun store_array_items(mut self, asm: &mut x64::Asm, items: Vec<u64>, base: u64, element: u64) -> bool {
        when !self.is_plain_scalar(element) {
            return self.store_structure_items(asm, items, base, element)
        }
        count := items.len()
        mut at: u64 = count
        when !self.push_array_items(asm, items) {
            return false
        }
        while at > 0 {
            at -= 1
            asm.pop(x64::Reg::RAX)
            self.store_cell(asm, element, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + count - 1 - at))
        }
        return true
    }

    // Structure elements: every item is evaluated into cells of its own before any element is written, since an item may
    // read the array it is written into. Element `i` of `n` is `(n - 1 - i)` elements below `base`'s top, as for scalars.
    fun store_structure_items(mut self, asm: &mut x64::Asm, items: Vec<u64>, base: u64, element: u64) -> bool {
        cells := self.cells_of(element)
        count := items.len()
        mut held: Vec<u64> = Vec()
        mut position: u64 = 0
        while position < count {
            slot := self.scratch(cells)
            when !self.store_into(asm, items[position], slot, element) {
                return false
            }
            held.push(slot)
            position += 1
        }
        position = 0
        while position < count {
            mut cell: u64 = 0
            while cell < cells {
                asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(held[position] + cell))
                asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + (count - 1 - position) * cells + cell))
                cell += 1
            }
            position += 1
        }
        return true
    }

    // `[item; count]` stored into the cells from `base` on: the item is evaluated once, and its value goes to every cell.
    fun store_array_repeat(mut self, asm: &mut x64::Asm, item: u64, base: u64, element: u64, count: u64) -> bool {
        when self.has_owners(element) {
            return self.fail("a repeat of an array element that owns memory")
        }
        when !self.is_plain_scalar(element) {
            cells := self.cells_of(element)
            held := self.scratch(cells)
            when !self.store_into(asm, item, held, element) {
                return false
            }
            mut at: u64 = 0
            while at < count {
                mut cell: u64 = 0
                while cell < cells {
                    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(held + cell))
                    asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + at * cells + cell))
                    cell += 1
                }
                at += 1
            }
            return true
        }
        when !self.expr(asm, item) {
            return false
        }
        mut at: u64 = 0
        while at < count {
            self.store_cell(asm, element, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + at))
            at += 1
        }
        return true
    }

    // `array[index]` of an array local. The index is checked as unsigned against the length: a negative index of a signed
    // type is a huge unsigned value, so it fails the same check as one past the end. The element is loaded from its cell.
    fun array_index(mut self, asm: &mut x64::Asm, array: u64, index: u64, element: u64, length: u64) -> bool {
        when !self.is_plain_scalar(element) {
            when self.is_owner_cell(element) {
                return self.array_owner_index(asm, array, index, element, length)
            }
            return self.fail("an element of this array type")
        }
        slot := self.array_local_of(array)
        when slot.is_none() {
            // An element of a nested array: the element is read in the cells of the element that holds it.
            return choose self.program.exprs[array] {
                ir::IrExpr::ArrayIndex(outer, outer_index, inner, outer_length) => self.nested_index(asm, outer, outer_index, inner, outer_length, index, element, length),
                _ => self.memory_array_index(asm, array, index, element, length),
            }
        }
        when !self.expr(asm, index) {
            return false
        }
        asm.alu_ri(7, x64::Reg::RAX, length as i64)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        self.element_base(asm, x64::Reg::RAX)
        return self.load_cell(asm, element, x64::Reg::RDX, slot_disp(slot.unwrap() + length - 1))
    }

    // `array[index]` of an array that lies in memory.
    fun memory_array_index(mut self, asm: &mut x64::Asm, array: u64, index: u64, element: u64, length: u64) -> bool {
        when !self.memory_array_element_address(asm, array, index, element, length) {
            return false
        }
        return self.load_cell(asm, element, x64::Reg::RAX, 0)
    }

    // `outer[outer_index][index]`: the inner array is the element `outer_index` of the local `outer`, whose address is found
    // first; the element `index` of it is `8 * index` above the inner array's lowest cell, as in any array in memory.
    fun nested_index(mut self, asm: &mut x64::Asm, outer: u64, outer_index: u64, inner: u64, outer_length: u64, index: u64, element: u64, length: u64) -> bool {
        when !self.is_plain_array(inner) {
            return self.fail("an index into a nested array of this kind")
        }
        when !self.array_element_address(asm, outer, outer_index, inner, outer_length) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, index) {
            return false
        }
        asm.alu_ri(7, x64::Reg::RAX, length as i64)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.pop(x64::Reg::RDX)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RAX)
        return self.load_cell(asm, element, x64::Reg::RDX, 0)
    }

    // `array[index]` of an owning element: the element is cloned, as `vec_index` clones a vector's element, so the value read is
    // an owner of its own. An element whose clone is not defined is declined rather than shared.
    fun array_owner_index(mut self, asm: &mut x64::Asm, array: u64, index: u64, element: u64, length: u64) -> bool {
        slot := self.array_local_of(array)
        when slot.is_none() {
            return self.fail("an index into an array that is not a local")
        }
        owned := self.owned_cells(element)
        when owned.is_none() {
            return self.fail("a clone of this array element")
        }
        copies := owned.unwrap()
        when copies.len() != 3 {
            return self.fail("a clone of this array element")
        }
        when !self.expr(asm, index) {
            return false
        }
        asm.alu_ri(7, x64::Reg::RAX, length as i64)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        self.element_base(asm, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RDX, slot_disp(slot.unwrap() + length - 1))
        asm.call_label(self.copy_routine(asm, copies[1], copies[2]))
        return true
    }

    // The element type of a slice type, or None for any other type. A slice is two cells: the address of its first
    // element and its length; its elements ascend in memory, `8 * cells` apart.
    fun slice_element(self, ty: u64) -> Option<u64> {
        return choose self.program.types[ty] {
            ir::IrTy::SliceOf(element) => Option::Some(element),
            _ => Option::None,
        }
    }

    // The address and length of a slice, in rax and rdx: a slice local, a view of a Vec, or a view of an array (a
    // temporary array is built in scratch cells, which live as long as the function's frame).
    fun slice_parts(mut self, asm: &mut x64::Asm, value: u64) -> bool {
        local := self.array_local_of(value)
        when local.is_some() {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(local.unwrap()))
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(local.unwrap() + 1))
            return true
        }
        return choose self.program.exprs[value] {
            ir::IrExpr::ArrayAsSlice(array, slice_ty, length) => self.array_as_slice(asm, array, slice_ty, length),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.slice_call(asm, target, arguments),
            _ => self.fail("a slice of this kind"),
        }
    }

    fun slice_call(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>) -> bool {
        return choose target {
            ir::CallTarget::VecSlice(element) => self.vec_slice(asm, element, arguments),
            _ => self.fail("a slice from this call"),
        }
    }

    // `array` viewed as a slice; the IR names the element type.
    fun array_as_slice(mut self, asm: &mut x64::Asm, array: u64, element_ty: u64, length: u64) -> bool {
        element: Option<u64> = Option::Some(element_ty)
        // An element is one cell: a scalar, or an owner whose slice reads clone it.
        when !self.is_plain_scalar(element.unwrap()) && !self.is_owner_cell(element.unwrap()) {
            return self.fail("a slice of an array of this element type")
        }
        when length == 0 {
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RBP)
            asm.mov_ri(x64::Reg::RDX, 0)
            return true
        }
        mut slot: u64 = 0
        local := self.array_local_of(array)
        when local.is_some() {
            slot = local.unwrap()
        } else {
            when !self.is_plain_scalar(element.unwrap()) {
                return self.fail("a slice of a temporary array of this element type")
            }
            slot = self.scratch(length)
            when !self.store_array_parts(asm, array, slot, element.unwrap(), length) {
                return false
            }
        }
        asm.lea(x64::Reg::RAX, x64::Reg::RBP, slot_disp(slot + length - 1))
        asm.mov_ri(x64::Reg::RDX, length)
        return true
    }

    // `vec.slice(start, end)` and `vec.as_slice()`: the range is checked as the runtime checks it, and the view starts at
    // element `start` of the vector's data.
    fun vec_slice(mut self, asm: &mut x64::Asm, element: u64, arguments: Vec<u64>) -> bool {
        when arguments.len() != 3 {
            return self.fail("a vector slice with this number of arguments")
        }
        stride := self.cells_of(element) * 8
        when stride == 0 {
            return self.fail("a vector slice of this element type")
        }
        when !self.expr(asm, arguments[0]) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, arguments[1]) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, arguments[2]) {
            return false
        }
        asm.pop(x64::Reg::RCX)
        asm.pop(x64::Reg::RDX)
        bad_start := asm.new_label()
        bad_end := asm.new_label()
        done := asm.new_label()
        asm.load(8, false, x64::Reg::R8, x64::Reg::RDX, 8)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
        asm.jcc(x64::Cc::ABOVE, bad_start)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
        asm.jcc(x64::Cc::BELOW, bad_end)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::R8)
        asm.jcc(x64::Cc::ABOVE, bad_end)
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RDX, 0)
        asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
        asm.alu_rr(41, x64::Reg::R9, x64::Reg::RCX)
        self.scale_bytes(asm, x64::Reg::RCX, stride)
        asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RSI)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::R9)
        asm.jmp(done)
        asm.bind(bad_start)
        self.fail_exit(asm, String("Ryn runtime error: Vec slice start is out of bounds\n"))
        asm.bind(bad_end)
        self.fail_exit(asm, String("Ryn runtime error: Vec slice end is out of bounds\n"))
        asm.bind(done)
        return true
    }

    fun store_slice(mut self, asm: &mut x64::Asm, value: u64, base: u64) -> bool {
        when !self.slice_parts(asm, value) {
            return false
        }
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base))
        asm.store(8, x64::Reg::RDX, x64::Reg::RBP, slot_disp(base + 1))
        return true
    }

    fun push_slice(mut self, asm: &mut x64::Asm, value: u64) -> bool {
        when !self.slice_parts(asm, value) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.push(x64::Reg::RDX)
        return true
    }

    fun slice_len(mut self, asm: &mut x64::Asm, arguments: Vec<u64>) -> bool {
        when arguments.len() != 1 {
            return self.fail("a slice length with this number of arguments")
        }
        when !self.slice_parts(asm, arguments[0]) {
            return false
        }
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
        return true
    }

    // `slice[index]` (or `&slice[index]` when `address`): the index is checked against the length, and the element, a
    // value of one cell that owns nothing, is read at its place (or its address is the value).
    // The address in rax of element `index` of a slice of structures: the slice's pointer is the lowest cell of its first
    // element, and element `i` lies `8 * cells` above element `i - 1`, as in an array.
    fun slice_element_address(mut self, asm: &mut x64::Asm, slice: u64, index: u64, element: u64) -> bool {
        cells := self.cells_of(element)
        when !self.slice_parts(asm, slice) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.push(x64::Reg::RDX)
        when !self.expr(asm, index) {
            return false
        }
        asm.pop(x64::Reg::RDX)
        asm.pop(x64::Reg::RCX)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        self.scale_bytes(asm, x64::Reg::RAX, 8 * cells)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        return true
    }

    // A read of an element of a slice that owns memory is a clone of it, as an array element read is.
    fun slice_owner_index(mut self, asm: &mut x64::Asm, slice: u64, index: u64, element: u64) -> bool {
        owned := self.owned_cells(element)
        when owned.is_none() {
            return self.fail("a clone of this slice element")
        }
        copies := owned.unwrap()
        when copies.len() != 3 {
            return self.fail("a clone of this slice element")
        }
        when !self.slice_parts(asm, slice) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.push(x64::Reg::RDX)
        when !self.expr(asm, index) {
            return false
        }
        asm.pop(x64::Reg::RDX)
        asm.pop(x64::Reg::RCX)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RCX, 0)
        asm.call_label(self.copy_routine(asm, copies[1], copies[2]))
        return true
    }

    fun slice_index(mut self, asm: &mut x64::Asm, slice: u64, index: u64, element: u64, address: bool) -> bool {
        when !address && self.is_owner_cell(element) {
            return self.slice_owner_index(asm, slice, index, element)
        }
        when !self.is_cell(element) || self.is_leakable(element) {
            return self.fail("a slice element of this type")
        }
        when !self.slice_parts(asm, slice) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.push(x64::Reg::RDX)
        when !self.expr(asm, index) {
            return false
        }
        asm.pop(x64::Reg::RDX)
        asm.pop(x64::Reg::RCX)
        asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDX)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        self.scale_bytes(asm, x64::Reg::RAX, 8)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
        when address {
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
            return true
        }
        return self.load_cell(asm, element, x64::Reg::RCX, 0)
    }

    // The address of a function, as a function pointer: the address of its C-convention entry point, so that C code and
    // indirect calls both call it with the arguments in registers.
    fun function_address(mut self, asm: &mut x64::Asm, function: u64) -> bool {
        when self.program.functions[function].external_symbol.is_some() {
            return self.fail("the address of a foreign function")
        }
        self.needed.set(function, true)
        mut at: u64 = 0
        while at < self.thunk_functions.len() {
            when self.thunk_functions[at] == function {
                asm.lea_label(x64::Reg::RAX, self.thunk_labels[at])
                return true
            }
            at += 1
        }
        label := asm.new_label()
        self.thunk_functions.push(function)
        self.thunk_labels.push(label)
        asm.lea_label(x64::Reg::RAX, label)
        return true
    }

    // Whether a parameter or result type travels in an SSE register in a C call.
    fun is_sse(self, ty: u64) -> bool {
        return self.is_float(ty)
    }

    // The entry points of the functions whose address is taken: each takes its arguments in the C registers, pushes them
    // as the function's own calls do, calls it, and gives the result in rax (xmm0 for a float).
    fun emit_thunks(mut self, asm: &mut x64::Asm) -> bool {
        mut at: u64 = self.thunks_done
        while at < self.thunk_functions.len() {
            definition := self.program.functions[self.thunk_functions[at]]
            asm.bind(self.thunk_labels[at])
            asm.push(x64::Reg::RBP)
            asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
            when self.windows {
                // Windows callers keep rbx, rdi, rsi and r12 to r15; the generated code uses them freely.
                asm.push(x64::Reg::RBX)
                asm.push(x64::Reg::RDI)
                asm.push(x64::Reg::RSI)
                asm.push(12)
                asm.push(13)
                asm.push(14)
                asm.push(15)
            }
            mut integers: u64 = 0
            mut floats: u64 = 0
            mut pair: u64 = 0
            while pair < definition.parameters.len() / 2 {
                ty := definition.parameters[pair * 2 + 1]
                when self.cells_of(ty) != 1 {
                    return self.fail("a function pointer to a function with a parameter of this type")
                }
                when self.windows {
                    // By position: the first four in rcx, rdx, r8, r9 or xmm0 to xmm3, the rest above the shadow space.
                    when pair < 4 {
                        when self.is_sse(ty) {
                            asm.movq_from_xmm(self.word(ty) == "F64", x64::Reg::RAX, pair)
                            asm.push(x64::Reg::RAX)
                        } else {
                            asm.push(windows_argument_register(pair))
                        }
                    } else {
                        asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (48 + 8 * (pair - 4)) as i64)
                        asm.push(x64::Reg::RAX)
                    }
                } else when self.is_sse(ty) {
                    when floats >= 8 {
                        return self.fail("a function pointer to a function with this many float parameters")
                    }
                    asm.movq_from_xmm(self.word(ty) == "F64", x64::Reg::RAX, floats)
                    asm.push(x64::Reg::RAX)
                    floats += 1
                } else {
                    when integers >= 6 {
                        return self.fail("a function pointer to a function with this many parameters")
                    }
                    asm.push(arg_register(integers))
                    integers += 1
                }
                pair += 1
            }
            when definition.return_type.is_some() {
                when self.aggregate_cells(definition.return_type.unwrap()) > 0 {
                    return self.fail("a function pointer to a function with a result of this type")
                }
            }
            // The parameters were pushed in order; a function that takes them in registers gets them from the stack.
            when self.reg_args(self.thunk_functions[at]) {
                mut moved: u64 = definition.parameters.len() / 2
                while moved > 0 {
                    moved -= 1
                    asm.pop(arg_register(moved))
                }
            }
            asm.call_label(self.labels[self.thunk_functions[at]])
            when definition.return_type.is_some() {
                when self.is_sse(definition.return_type.unwrap()) {
                    asm.movq_to_xmm(self.word(definition.return_type.unwrap()) == "F64", 0, x64::Reg::RAX)
                }
            }
            when self.windows {
                asm.lea(x64::Reg::RSP, x64::Reg::RBP, (0 as i64) - 56)
                asm.pop(15)
                asm.pop(14)
                asm.pop(13)
                asm.pop(12)
                asm.pop(x64::Reg::RSI)
                asm.pop(x64::Reg::RDI)
                asm.pop(x64::Reg::RBX)
                asm.pop(x64::Reg::RBP)
                asm.ret()
            } else {
                asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
                asm.pop(x64::Reg::RBP)
                asm.ret()
            }
            at += 1
            self.thunks_done = at
        }
        return true
    }

    // The System V classes of the eightbytes of a `repr(C)` structure of plain scalars no larger than 16 bytes: 0 for an
    // eightbyte that goes in an integer register, 1 for one that goes in an SSE register (all its fields are floats). Empty
    // for any other type.
    fun c_classes(self, ty: u64) -> Vec<u64> {
        id := choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => id,
            _ => 0,
        }
        mut classes: Vec<u64> = Vec()
        when !self.is_repr_c_structure(ty) {
            return classes
        }
        when !self.c_fields_are_scalars(id) {
            return classes
        }
        // A packed or over-aligned record is classified differently by C (an unaligned field puts it in memory): not passed by value.
        when self.program.structs[id].layout != 0 {
            return classes
        }
        size := self.struct_c_size(id)
        when size == 0 {
            return classes
        }
        when size > 16 {
            return classes
        }
        mut count: u64 = (size + 7) / 8
        mut at: u64 = 0
        while at < count {
            classes.push(1)
            at += 1
        }
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            when !self.is_float(self.program.structs[id].fields[position].ty) {
                classes.set(self.c_field_offset(id, position) / 8, 0)
            }
            position += 1
        }
        return classes
    }

    // Moves the arguments that were pushed in order into the C argument registers: integers and pointers to rdi, rsi, rdx,
    // rcx, r8 and r9 in turn, floats to xmm0 to xmm7, and each eightbyte of a small `repr(C)` structure to the next register
    // of its class. A scalar was pushed as one cell; a structure as its cells, whose first eightbyte is on top.
    fun load_c_arguments(mut self, asm: &mut x64::Asm, types: Vec<u64>) -> bool {
        mut registers: Vec<u64> = Vec()
        mut sse: Vec<bool> = Vec()
        mut firsts: Vec<u64> = Vec()
        mut integers: u64 = 0
        mut floats: u64 = 0
        mut overflow: Vec<u64> = Vec()
        for ty in types.clone() {
            firsts.push(registers.len())
            classes := self.c_classes(ty)
            when classes.len() > 0 {
                for class in classes {
                    when class == 1 {
                        when floats >= 8 {
                            return self.fail("a foreign call with this many float arguments")
                        }
                        registers.push(floats)
                        sse.push(true)
                        floats += 1
                    } else {
                        when integers >= 6 {
                            return self.fail("a foreign call with this many arguments")
                        }
                        registers.push(arg_register(integers))
                        sse.push(false)
                        integers += 1
                    }
                }
            } else {
                when self.cells_of(ty) != 1 {
                    return self.fail("a foreign argument of this type")
                }
                when self.is_sse(ty) {
                    when floats >= 8 {
                        return self.fail("a foreign call with this many float arguments")
                    }
                    registers.push(floats)
                    sse.push(true)
                    floats += 1
                } else when integers >= 6 {
                    // Past the sixth integer register a scalar goes to the stack.
                    overflow.push(firsts.len() - 1)
                    registers.push(0)
                    sse.push(false)
                } else {
                    registers.push(arg_register(integers))
                    sse.push(false)
                    integers += 1
                }
            }
        }
        self.c_overflow = overflow.clone()
        when overflow.len() > 0 {
            // The pushed cells stay where they are for the call to copy the overflowing ones; the register arguments are
            // read from them in place. Only scalars are mixed with stack arguments.
            count := types.len()
            mut at: u64 = 0
            while at < count {
                when self.c_classes(types[at]).len() > 0 {
                    return self.fail("a foreign call with this many arguments")
                }
                at += 1
            }
            mut position: u64 = 0
            while position < count {
                mut spilled := false
                for given in overflow.clone() {
                    when given == position {
                        spilled = true
                    }
                }
                when !spilled {
                    asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (count - 1 - position)) as i64)
                    when sse[position] {
                        asm.movq_to_xmm(self.word(types[position]) == "F64", registers[position], x64::Reg::RAX)
                    } else {
                        asm.mov_rr(registers[position], x64::Reg::RAX)
                    }
                }
                position += 1
            }
            return true
        }
        mut index: u64 = types.len()
        while index > 0 {
            index -= 1
            classes := self.c_classes(types[index])
            when classes.len() > 0 {
                // The structure's fields go into a two-word image in C layout below its cells, and the words are loaded.
                asm.alu_ri(5, x64::Reg::RSP, 16)
                asm.mov_ri(x64::Reg::RAX, 0)
                asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 0)
                asm.store(8, x64::Reg::RAX, x64::Reg::RSP, 8)
                asm.lea(x64::Reg::RSI, x64::Reg::RSP, 16)
                self.pack_to_image(asm, self.struct_id_of(types[index]), x64::Reg::RSI, x64::Reg::RSP)
                mut word: u64 = 0
                while word < classes.len() {
                    asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * word) as i64)
                    when sse[firsts[index] + word] {
                        asm.movq_to_xmm(true, registers[firsts[index] + word], x64::Reg::RAX)
                    } else {
                        asm.mov_rr(registers[firsts[index] + word], x64::Reg::RAX)
                    }
                    word += 1
                }
                asm.alu_ri(0, x64::Reg::RSP, (self.cells_of(types[index]) * 8 + 16) as i64)
            } else {
                when sse[firsts[index]] {
                    asm.pop(x64::Reg::RAX)
                    asm.movq_to_xmm(self.word(types[index]) == "F64", registers[firsts[index]], x64::Reg::RAX)
                } else {
                    asm.pop(registers[firsts[index]])
                }
            }
        }
        return true
    }

    // The result of a C call: a small `repr(C)` structure from its registers (rax and rdx for integer eightbytes, xmm0 and
    // xmm1 for float ones, in order), left on the stack as the cells of a pushed value; any other result into rax: a float
    // from xmm0, an integer extended as its type says.
    fun take_c_result(mut self, asm: &mut x64::Asm, result: Option<u64>) -> bool {
        when result.is_none() {
            return true
        }
        ty := result.unwrap()
        classes := self.c_classes(ty)
        when classes.len() > 0 && self.windows {
            return self.fail("a record result of a foreign call in a Windows program")
        }
        when classes.len() > 0 {
            cells := self.cells_of(ty)
            asm.alu_ri(5, x64::Reg::RSP, (8 * cells + 16) as i64)
            mut integers: u64 = 0
            mut floats: u64 = 0
            mut word: u64 = 0
            while word < classes.len() {
                when classes[word] == 1 {
                    asm.sse_store(8, floats, x64::Reg::RSP, (8 * word) as i64)
                    floats += 1
                } else {
                    when integers == 0 {
                        asm.store(8, x64::Reg::RAX, x64::Reg::RSP, (8 * word) as i64)
                    } else {
                        asm.store(8, x64::Reg::RDX, x64::Reg::RSP, (8 * word) as i64)
                    }
                    integers += 1
                }
                word += 1
            }
            asm.lea(x64::Reg::RSI, x64::Reg::RSP, 16)
            self.unpack_from_image(asm, self.struct_id_of(ty), x64::Reg::RSP, x64::Reg::RSI)
            asm.alu_ri(0, x64::Reg::RSP, 16)
            return true
        }
        when self.cells_of(ty) != 1 {
            return self.fail("a foreign result of this type")
        }
        when self.is_sse(ty) {
            asm.movq_from_xmm(self.word(ty) == "F64", x64::Reg::RAX, 0)
            return true
        }
        self.normalize(asm, self.word(ty))
        return true
    }

    // The parameter types of a function pointer type.
    fun pointer_parameters(self, id: u64) -> Vec<u64> {
        return choose self.program.types[id] {
            ir::IrTy::FunctionPointerTo(parameters, result, external) => parameters,
            _ => Vec(),
        }
    }

    // The result type of a function pointer type, if it has one.
    fun pointer_result(self, id: u64) -> Option<u64> {
        return choose self.program.types[id] {
            ir::IrTy::FunctionPointerTo(parameters, result, external) => result,
            _ => Option::None,
        }
    }

    // A call through a function pointer: the pointer is evaluated first, then the arguments, which go to the C registers.
    fun indirect_call(mut self, asm: &mut x64::Asm, id: u64, arguments: Vec<u64>) -> bool {
        parameters := self.pointer_parameters(id)
        when arguments.len() != parameters.len() + 1 {
            return self.fail("a call through a value that is not a function pointer")
        }
        mut position: u64 = 0
        while position < arguments.len() {
            when !self.expr(asm, arguments[position]) {
                return false
            }
            asm.push(x64::Reg::RAX)
            position += 1
        }
        when self.windows {
            when !self.windows_call_core(asm, 0, true, parameters) {
                return false
            }
            return self.finish_c_call(asm, self.pointer_result(id))
        }
        when !self.load_c_arguments(asm, parameters) {
            return false
        }
        when self.c_overflow.len() > 0 {
            // The function pointer is the lowest pushed cell; the arguments above it that do not fit the registers go to
            // the stack, as for a call of a named function.
            count := arguments.len() - 1
            spilled := self.c_overflow.clone()
            asm.load(8, false, x64::Reg::R11, x64::Reg::RSP, (8 * count) as i64)
            asm.push(x64::Reg::RBX)
            asm.mov_rr(x64::Reg::RBX, x64::Reg::RSP)
            asm.alu_ri(4, x64::Reg::RSP, (0 as i64) - 16)
            when spilled.len() % 2 == 1 {
                asm.alu_ri(5, x64::Reg::RSP, 8)
            }
            mut at: u64 = spilled.len()
            while at > 0 {
                at -= 1
                asm.load(8, false, x64::Reg::RAX, x64::Reg::RBX, (8 + 8 * (count - 1 - spilled[at])) as i64)
                asm.push(x64::Reg::RAX)
            }
            asm.call_reg(x64::Reg::R11)
            asm.mov_rr(x64::Reg::RSP, x64::Reg::RBX)
            asm.pop(x64::Reg::RBX)
            asm.alu_ri(0, x64::Reg::RSP, (8 * (count + 1)) as i64)
            return self.finish_c_call(asm, self.pointer_result(id))
        }
        asm.pop(x64::Reg::R11)
        asm.push(x64::Reg::RBX)
        asm.mov_rr(x64::Reg::RBX, x64::Reg::RSP)
        asm.alu_ri(4, x64::Reg::RSP, (0 as i64) - 16)
        asm.call_reg(x64::Reg::R11)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBX)
        asm.pop(x64::Reg::RBX)
        return self.finish_c_call(asm, self.pointer_result(id))
    }

    // `array[index] = value` for a mutable array local. The index is checked before the value is evaluated, as the
    // bootstrap compiler does, and it waits on the stack while the value is computed.
    fun array_assign(mut self, asm: &mut x64::Asm, slot: u64, element: u64, length: u64, index: u64, value: u64) -> bool {
        when !self.is_plain_scalar(element) && self.is_owner_cell(element) {
            return self.assign_owner_element(asm, slot, element, length, index, value)
        }
        // A structure element that owns memory is dropped where it lies, after its new value is evaluated.
        when !self.is_plain_scalar(element) {
            return self.assign_structure_element(asm, slot, element, length, index, value)
        }
        when !self.expr(asm, index) {
            return false
        }
        asm.alu_ri(7, x64::Reg::RAX, length as i64)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, value) {
            return false
        }
        asm.pop(x64::Reg::RCX)
        self.element_base(asm, x64::Reg::RCX)
        return self.store_cell(asm, element, x64::Reg::RAX, x64::Reg::RDX, slot_disp(slot + length - 1))
    }

    // `array[index] = value` for a structure element: the index is checked, the value is evaluated into cells of its own, and
    // only then are its cells copied into the element.
    fun assign_structure_element(mut self, asm: &mut x64::Asm, slot: u64, element: u64, length: u64, index: u64, value: u64) -> bool {
        cells := self.cells_of(element)
        when !self.expr(asm, index) {
            return false
        }
        asm.alu_ri(7, x64::Reg::RAX, length as i64)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        asm.push(x64::Reg::RAX)
        held := self.scratch(cells)
        when !self.store_into(asm, value, held, element) {
            return false
        }
        asm.pop(x64::Reg::RCX)
        self.element_base_stride(asm, x64::Reg::RCX, cells)
        when self.has_owners(element) {
            asm.lea(x64::Reg::RDI, x64::Reg::RDX, slot_disp(slot + (length - 1) * cells))
            asm.push(x64::Reg::RDX)
            asm.call_label(self.value_drop_routine(asm, element, false))
            asm.pop(x64::Reg::RDX)
        }
        mut cell: u64 = 0
        while cell < cells {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(held + cell))
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, slot_disp(slot + (length - 1) * cells + cell))
            cell += 1
        }
        return true
    }

    // `array[index] = value` for an owning element: the value is evaluated first, then the old element is dropped where it
    // lies, and the new value takes its cell. As `vec_set` does, so a value that reads the element is safe.
    fun assign_owner_element(mut self, asm: &mut x64::Asm, slot: u64, element: u64, length: u64, index: u64, value: u64) -> bool {
        when !self.expr(asm, index) {
            return false
        }
        asm.alu_ri(7, x64::Reg::RAX, length as i64)
        asm.jcc(x64::Cc::ABOVE_EQUAL, self.index_error_label)
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, value) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, 8)
        self.element_base(asm, x64::Reg::RCX)
        asm.lea(x64::Reg::RDI, x64::Reg::RDX, slot_disp(slot + length - 1))
        asm.push(x64::Reg::RDX)
        asm.call_label(self.value_drop_routine(asm, element, false))
        asm.pop(x64::Reg::RDX)
        asm.pop(x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        asm.store(8, x64::Reg::RAX, x64::Reg::RDX, slot_disp(slot + length - 1))
        return true
    }

    // The bits `expr` would leave in rax for an integer, bool or char expression made of literals, or None when the value is
    // not a constant: a local, a call, a float, or an operation that is not folded (a zero divisor).
    fun const_value(mut self, index: u64) -> Option<u64> {
        when self.const_state[index] == 2 {
            return Option::Some(self.const_bits[index])
        }
        when self.const_state[index] == 1 {
            return Option::None
        }
        known := self.const_compute(index)
        when !known.is_some() {
            self.const_state.set(index, 1)
            return Option::None
        }
        bits := known.unwrap()
        self.const_state.set(index, 2)
        self.const_bits.set(index, bits)
        return Option::Some(bits)
    }

    fun const_compute(mut self, index: u64) -> Option<u64> {
        return choose self.program.exprs[index] {
            ir::IrExpr::IntegerLit(text, ty) => self.const_integer(text, ty),
            ir::IrExpr::BoolLit(value) => Option::Some(bool_bits(value)),
            ir::IrExpr::CharLit(scalar) => Option::Some(scalar),
            ir::IrExpr::LocalRef(slot, ty, span) => self.const_local(slot, ty),
            ir::IrExpr::Binary(op, left, right, ty) => self.const_binary(op, left, right, ty),
            ir::IrExpr::Negate(value, ty) => self.const_negate(value, ty),
            ir::IrExpr::Not(value) => self.const_not(value),
            ir::IrExpr::BitNot(value, ty) => self.const_bit_not(value, ty),
            ir::IrExpr::FfiArray(array, element, length, index, mutable) => Option::None,
            ir::IrExpr::CastExpr(value, source, target) => self.const_cast(value, target),
            _ => Option::None,
        }
    }

    fun const_integer(self, text: String, ty: u64) -> Option<u64> {
        when !is_integer_word(self.word(ty)) {
            return Option::None
        }
        return Option::Some(literal_bits(text))
    }

    // A comparison's operand type is the type of its operands, and its result is a bool.
    fun const_binary(mut self, op: String, left: u64, right: u64, ty: u64) -> Option<u64> {
        word := self.word(ty)
        when !is_integer_word(word.clone()) && word != "Bool" && word != "Char" {
            return Option::None
        }
        lhs := self.const_value(left)
        when !lhs.is_some() {
            return Option::None
        }
        rhs := self.const_value(right)
        when !rhs.is_some() {
            return Option::None
        }
        return fold_binary(op, word, lhs.unwrap(), rhs.unwrap())
    }

    fun const_negate(mut self, value: u64, ty: u64) -> Option<u64> {
        word := self.word(ty)
        when !is_integer_word(word.clone()) {
            return Option::None
        }
        operand := self.const_value(value)
        when !operand.is_some() {
            return Option::None
        }
        return Option::Some(canonical_bits((0 as u64) - operand.unwrap(), word))
    }

    fun const_not(mut self, value: u64) -> Option<u64> {
        operand := self.const_value(value)
        when !operand.is_some() {
            return Option::None
        }
        return Option::Some(operand.unwrap() ^ 1)
    }

    fun const_bit_not(mut self, value: u64, ty: u64) -> Option<u64> {
        word := self.word(ty)
        when !is_integer_word(word.clone()) {
            return Option::None
        }
        operand := self.const_value(value)
        when !operand.is_some() {
            return Option::None
        }
        return Option::Some(canonical_bits(operand.unwrap() ^ ((0 as u64) - 1), word))
    }

    fun const_cast(mut self, value: u64, target: u64) -> Option<u64> {
        word := self.word(target)
        when !is_integer_word(word.clone()) {
            return Option::None
        }
        operand := self.const_value(value)
        when !operand.is_some() {
            return Option::None
        }
        return Option::Some(canonical_bits(operand.unwrap(), word))
    }

    // `x / c` and `x % c` for a constant `c` other than zero (a zero divisor stays a run-time error), where the power of
    // two of an unsigned type was done by `power_of_two`. An unsigned quotient is a multiplication by the reciprocal of
    // `c` (the round-up method: the high half of x * m, then the correction `(t + ((x - t) >> 1)) >> (l - 1)`, exact for
    // every 64-bit x, so for every narrower type); a signed one by a power of two adds the bias that makes the shift round
    // toward zero; any other signed `c` skips the checks for a zero divisor and for -1. None when it is not one of these.
    fun constant_division(mut self, asm: &mut x64::Asm, op: String, left: u64, right: u64, word: String) -> Option<bool> {
        when self.no_opt || (op != "Div" && op != "Rem") || !is_integer_word(word.clone()) {
            return Option::None
        }
        known := self.const_value(right)
        when !known.is_some() || known.unwrap() == 0 {
            return Option::None
        }
        divisor := known.unwrap()
        when !is_signed_word(word.clone()) {
            when divisor == 1 || power_exponent(divisor) != 64 {
                return Option::None
            }
            when !self.expr(asm, left) {
                return Option::Some(false)
            }
            self.unsigned_by_reciprocal(asm, op == "Div", divisor)
            return Option::Some(true)
        }
        when !self.expr(asm, left) {
            return Option::Some(false)
        }
        signed := divisor as i64
        when signed > 1 && power_exponent(divisor) != 64 {
            self.signed_by_power(asm, op == "Div", power_exponent(divisor))
            return Option::Some(true)
        }
        when signed == (0 as i64) - 1 {
            // The least value divided by -1 wraps: the checked division handles it.
            asm.mov_ri(x64::Reg::RCX, divisor)
            return Option::Some(self.division(asm, op == "Div", true, word))
        }
        // A divisor of 1 leaves the value, or no remainder.
        when signed == 1 {
            when op == "Rem" {
                asm.mov_ri(x64::Reg::RAX, 0)
            }
            return Option::Some(true)
        }
        // Any other divisor: the quotient is the high half of x * m, corrected (Hacker's Delight, signed magic numbers).
        self.signed_by_magic(asm, op == "Div", divisor)
        self.normalize(asm, word)
        return Option::Some(true)
    }

    // rax = rax / d or rax % d for a signed d that is not 0, 1, -1 or a positive power of two: clobbers rcx and rdx. The
    // multiplier m and the shift s are found at compile time (the divisor is `d` as 64 bits); then
    // q = ((x * m) >> 64, plus or minus x when m and d differ in sign) >> s, plus 1 when that is negative.
    fun signed_by_magic(mut self, asm: &mut x64::Asm, quotient: bool, d: u64) {
        two63: u64 = 9223372036854775808
        negative := d >= two63
        mut magnitude: u64 = d
        when negative {
            magnitude = (0 as u64) - d
        }
        mut t: u64 = two63
        when negative {
            t = two63 + 1
        }
        anc := t - 1 - t % magnitude
        mut p: u64 = 63
        mut q1: u64 = two63 / anc
        mut r1: u64 = two63 - q1 * anc
        mut q2: u64 = two63 / magnitude
        mut r2: u64 = two63 - q2 * magnitude
        mut again: bool = true
        while again {
            p += 1
            q1 = q1 * 2
            r1 = r1 * 2
            when r1 >= anc {
                q1 += 1
                r1 -= anc
            }
            q2 = q2 * 2
            r2 = r2 * 2
            when r2 >= magnitude {
                q2 += 1
                r2 -= magnitude
            }
            delta := magnitude - r2
            again = q1 < delta || (q1 == delta && r1 == 0)
        }
        mut multiplier: u64 = q2 + 1
        when negative {
            multiplier = (0 as u64) - multiplier
        }
        shift := p - 64
        asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RAX, multiplier)
        asm.unary(5, x64::Reg::RCX)
        when !negative && multiplier >= two63 {
            asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RCX)
        }
        when negative && multiplier < two63 {
            asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RCX)
        }
        when shift > 0 {
            asm.shift_ri(7, x64::Reg::RDX, shift)
        }
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
        asm.shift_ri(5, x64::Reg::RAX, 63)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RAX)
        when quotient {
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
            return
        }
        asm.mov_ri(x64::Reg::RAX, d)
        asm.imul_rr(x64::Reg::RDX, x64::Reg::RAX)
        asm.alu_rr(41, x64::Reg::RCX, x64::Reg::RDX)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
    }

    // rax = rax / d or rax % d for an unsigned d that is not 1 and not a power of two: clobbers rcx and rdx.
    fun unsigned_by_reciprocal(mut self, asm: &mut x64::Asm, quotient: bool, d: u64) {
        mut l: u64 = 1
        mut reach: u64 = 2
        while reach < d && l < 64 {
            reach = reach * 2
            l += 1
        }
        // m = floor(2^64 * (2^l - d) / d) + 1, by long division one bit at a time.
        mut r: u64 = (0 as u64) - d
        when l < 64 {
            r = reach - d
        }
        mut m: u64 = 0
        mut bit: u64 = 0
        while bit < 64 {
            top := r >= 9223372036854775808
            r = r * 2
            m = m * 2
            when top || r >= d {
                r = r - d
                m = m + 1
            }
            bit += 1
        }
        m = m + 1
        asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RAX, m)
        asm.unary(4, x64::Reg::RCX)
        asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        asm.alu_rr(41, x64::Reg::RAX, x64::Reg::RDX)
        asm.shift_ri(5, x64::Reg::RAX, 1)
        asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RDX)
        asm.shift_ri(5, x64::Reg::RAX, l - 1)
        when !quotient {
            asm.mov_ri(x64::Reg::RDX, d)
            asm.imul_rr(x64::Reg::RAX, x64::Reg::RDX)
            asm.alu_rr(41, x64::Reg::RCX, x64::Reg::RAX)
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
        }
    }

    // rax = rax / 2^k or rax % 2^k for a signed value (k >= 1), rounding toward zero: clobbers rcx and rdx.
    fun signed_by_power(mut self, asm: &mut x64::Asm, quotient: bool, k: u64) {
        asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
        asm.shift_ri(7, x64::Reg::RCX, 63)
        asm.shift_ri(5, x64::Reg::RCX, 64 - k)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
        when quotient {
            asm.shift_ri(7, x64::Reg::RCX, k)
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RCX)
            return
        }
        // x - ((x + bias) with the low k bits cleared)
        asm.shift_ri(7, x64::Reg::RCX, k)
        asm.shift_ri(4, x64::Reg::RCX, k)
        asm.alu_rr(41, x64::Reg::RAX, x64::Reg::RCX)
    }

    // `x * 2^k`, `x / 2^k` and `x % 2^k` on an unsigned integer, with a constant power of two below the width of the type:
    // a shift left, a shift right and a mask. The constant of a multiplication may be its left operand. None when the
    // operation is not one of these; otherwise whether the emitted code succeeded.
    // `3 * x`, `5 * x` or `9 * x` (either order) for a 64-bit local `x` in a register: the register in the bits above 8 and
    // the scale of its `lea` (2, 4 or 8) in the low byte; 0 for any other expression.
    fun scaled_register(mut self, index: u64) -> u64 {
        when self.no_opt {
            return 0
        }
        multiply := choose self.program.exprs[index] {
            ir::IrExpr::Binary(op, left, right, ty) => op == "Mul" && self.value_width(ty) == 8 && is_integer_word(self.word(ty)),
            _ => false,
        }
        when !multiply {
            return 0
        }
        mut first := choose self.program.exprs[index] {
            ir::IrExpr::Binary(op, left, right, ty) => left,
            _ => 0,
        }
        mut second := choose self.program.exprs[index] {
            ir::IrExpr::Binary(op, left, right, ty) => right,
            _ => 0,
        }
        mut constant := self.const_value(second)
        mut register := self.operand_reg(first)
        when constant.is_none() {
            constant = self.const_value(first)
            register = self.operand_reg(second)
        }
        when constant.is_none() || register == 0 {
            return 0
        }
        mut scale: u64 = 0
        when constant.unwrap() == 3 {
            scale = 2
        } else when constant.unwrap() == 5 {
            scale = 4
        } else when constant.unwrap() == 9 {
            scale = 8
        }
        when scale == 0 {
            return 0
        }
        return (register << (8 as u32)) | scale
    }

    fun power_of_two(mut self, asm: &mut x64::Asm, op: String, left: u64, right: u64, word: String) -> Option<bool> {
        when !is_integer_word(word.clone()) {
            return Option::None
        }
        // Only a multiplication is a shift for a signed type: a division rounds toward zero, which a shift does not.
        when is_signed_word(word.clone()) && op != "Mul" {
            return Option::None
        }
        when op != "Mul" && op != "Div" && op != "Rem" {
            return Option::None
        }
        mut value := left
        mut constant := self.const_value(right)
        when op == "Mul" && !constant.is_some() {
            value = right
            constant = self.const_value(left)
        }
        when !constant.is_some() {
            return Option::None
        }
        power := constant.unwrap()
        exponent := power_exponent(power)
        when exponent >= width_of(word.clone()) * 8 {
            return Option::None
        }
        when !self.expr(asm, value) {
            return Option::Some(false)
        }
        when op == "Mul" {
            when exponent > 0 {
                asm.shift_ri(4, x64::Reg::RAX, exponent)
            }
            self.normalize(asm, word)
        } else when op == "Div" {
            when exponent > 0 {
                asm.shift_ri(5, x64::Reg::RAX, exponent)
            }
        } else {
            // The divisor is nonzero, so no zero check is needed. The mask is below 2^width, so the result is canonical.
            mask := power - 1
            when mask <= 2147483647 {
                asm.alu_ri(4, x64::Reg::RAX, mask as i64)
            } else {
                asm.mov_ri(x64::Reg::RCX, mask)
                asm.alu_rr(33, x64::Reg::RAX, x64::Reg::RCX)
            }
        }
        return Option::Some(true)
    }

    fun expr(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        self.note_expression(index)
        mut at: u64 = 0
        while at < self.temp_exprs.len() {
            when self.temp_exprs[at] == index {
                when !self.temp_ready[at] {
                    self.temp_ready.set(at, true)
                    when !self.expr_inner(asm, index) { return false }
                    asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(self.temp_cells[at]))
                }
                asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(self.temp_cells[at]))
                return true
            }
            at += 1
        }
        return self.expr_inner(asm, index)
    }

    fun expr_inner(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        // An expression made of literals is one immediate.
        folded := self.const_value(index)
        when folded.is_some() {
            asm.mov_ri(x64::Reg::RAX, folded.unwrap())
            return true
        }
        return choose self.program.exprs[index] {
            ir::IrExpr::IntegerLit(text, ty) => self.integer(asm, text, ty),
            ir::IrExpr::BoolLit(value) => self.boolean(asm, value),
            ir::IrExpr::CharLit(scalar) => self.char_value(asm, scalar),
            ir::IrExpr::LocalRef(slot, ty, span) => self.local(asm, slot, ty),
            ir::IrExpr::Binary(op, left, right, ty) => self.binary(asm, op, left, right, ty),
            ir::IrExpr::Negate(value, ty) => self.negate(asm, value, ty),
            ir::IrExpr::Not(value) => self.not(asm, value),
            ir::IrExpr::BitNot(value, ty) => self.bit_not(asm, value, ty),
            ir::IrExpr::FfiArray(array, element, length, index, mutable) => self.ffi_array(asm, array, element, length, index, mutable),
            ir::IrExpr::CastExpr(value, source, target) => self.cast(asm, value, source, target),
            ir::IrExpr::CallExpr(target, arguments, ty) => self.call_or_lent_element(asm, index, target, arguments, ty),
            ir::IrExpr::IfExpr(condition, then_value, else_value, ty) => self.if_expression(asm, condition, then_value, else_value),
            ir::IrExpr::StrLit(text) => self.fail("a string value"),
            ir::IrExpr::StringAsStr(value) => self.fail("a string as str"),
            ir::IrExpr::StructValue(id, fields, values) => self.handle_value(asm, id, values),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.field_read(asm, value, id, field, ty),
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => self.read_reference_field(asm, pointer, id, field, ty, borrowed),
            ir::IrExpr::ArrayValue(items) => self.fail("an array value"),
            ir::IrExpr::ArrayRepeat(value, length) => self.fail("an array repeat"),
            ir::IrExpr::ArrayIndex(array, index, ty, length) => self.array_index(asm, array, index, ty, length),
            ir::IrExpr::SliceIndex(slice, index, ty) => self.slice_index(asm, slice, index, ty, false),
            ir::IrExpr::AddressOf(slot, ty, pointer, span) => self.address_of(asm, slot, ty),
            ir::IrExpr::ValueAddress(value, ty, pointer, span) => self.value_address(asm, value, ty),
            ir::IrExpr::Dereference(pointer, ty) => self.load_through(asm, pointer, 0, ty),
            ir::IrExpr::PlaceAddress(place, ty) => self.memory_address(asm, place),
            ir::IrExpr::MoveRef(slot, ty) => self.move_local(asm, slot, ty),
            ir::IrExpr::FloatLit(bits, ty) => self.float_literal(asm, bits, ty),
            ir::IrExpr::FunctionAddress(function, ty) => self.function_address(asm, function),
            ir::IrExpr::EnumMatch(value, id, arms, ty) => self.enum_match(asm, value, id, arms, ty),
            ir::IrExpr::Propagate(value, input, output, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred) => self.propagate(asm, value, success_type, failure_type, success_variant, output_failure_variant, deferred),
            ir::IrExpr::StringFindOption(value, id) => self.find_option(asm, value, id),
            ir::IrExpr::SliceElementAddress(slice, index, ty, span) => self.slice_index(asm, slice, index, ty, true),
            ir::IrExpr::ArrayAsSlice(array, id, length) => self.fail("an array as a slice"),
        }
    }

    // `value?`: a success gives its payload. Otherwise the enclosing function returns the failure of its own enum, which
    // carries the error of a Result, after the `defer` bodies of the scopes it leaves have run. A payload and an error are
    // one cell each.
    fun propagate(mut self, asm: &mut x64::Asm, value: u64, success_type: u64, failure_type: Option<u64>, success_variant: u64, output_failure_variant: u64, deferred: Vec<u64>) -> bool {
        when !self.is_cell(success_type) || self.is_str(success_type) {
            return self.fail("a propagated value of this type")
        }
        when !self.propagate_box(asm, value, failure_type, success_variant, output_failure_variant, deferred) {
            return false
        }
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 8)
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("free"))
        asm.pop(x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        return true
    }

    // The part of `value?` up to the success: rax is then the box of the success, whose payload is the cell after the tag.
    // A failure returns from the function, after the `defer` bodies of the scopes it leaves have run.
    fun propagate_box(mut self, asm: &mut x64::Asm, value: u64, failure_type: Option<u64>, success_variant: u64, output_failure_variant: u64, deferred: Vec<u64>) -> bool {
        when failure_type.is_some() && self.cells_of(failure_type.unwrap()) == 0 {
            return self.fail("a propagated error of this type")
        }
        mut errors: u64 = 0
        when failure_type.is_some() {
            errors = self.cells_of(failure_type.unwrap())
        }
        when !self.expr(asm, value) {
            return false
        }
        succeeded := asm.new_label()
        asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, 0)
        asm.alu_ri(7, x64::Reg::RCX, success_variant as i64)
        asm.jcc(x64::Cc::EQUAL, succeeded)
        // The failure is a new box with the output's failure tag, and the error of the input box for a Result.
        asm.push(x64::Reg::RAX)
        asm.mov_ri(x64::Reg::RDI, 8 * (1 + errors))
        self.aligned_call(asm, String("malloc"))
        asm.mov_ri(x64::Reg::RCX, output_failure_variant)
        asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
        when failure_type.is_some() {
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
            mut cell: u64 = 0
            while cell < errors {
                asm.load(8, false, x64::Reg::RCX, x64::Reg::RDX, (8 * (1 + cell)) as i64)
                asm.store(8, x64::Reg::RCX, x64::Reg::RAX, (8 * (1 + cell)) as i64)
                cell += 1
            }
        }
        // The payload has moved into the output box; release only the input shell.
        asm.push(x64::Reg::RAX)
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RSP, 8)
        self.aligned_call(asm, String("free"))
        asm.pop(x64::Reg::RAX)
        asm.alu_ri(0, x64::Reg::RSP, 8)
        // The box survives the `defer` bodies, which clobber the registers.
        asm.push(x64::Reg::RAX)
        when !self.body(asm, deferred) {
            return false
        }
        self.drop_owners(asm)
        asm.pop(x64::Reg::RAX)
        self.leave(asm)
        asm.bind(succeeded)
        return true
    }

    // `value?` of a structure, pushed as its cells, as a call returns it.
    fun push_propagated(mut self, asm: &mut x64::Asm, value: u64, id: u64, failure_type: Option<u64>, success_variant: u64, output_failure_variant: u64, deferred: Vec<u64>) -> bool {
        when !self.propagate_box(asm, value, failure_type, success_variant, output_failure_variant, deferred) {
            return false
        }
        held := self.scratch(1)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(held))
        count := self.program.structs[id].slot_count
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (1 + cell)) as i64)
            asm.push(x64::Reg::RCX)
            cell += 1
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, slot_disp(held))
        self.aligned_call(asm, String("free"))
        return true
    }

    // `value?` of a structure: its cells are copied from the success box into the frame from `base` on.
    fun propagate_struct(mut self, asm: &mut x64::Asm, value: u64, id: u64, failure_type: Option<u64>, success_variant: u64, output_failure_variant: u64, deferred: Vec<u64>, base: u64) -> bool {
        when !self.propagate_box(asm, value, failure_type, success_variant, output_failure_variant, deferred) {
            return false
        }
        count := self.program.structs[id].slot_count
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (1 + cell)) as i64)
            asm.store(8, x64::Reg::RCX, x64::Reg::RBP, slot_disp(base + cell))
            cell += 1
        }
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
        self.aligned_call(asm, String("free"))
        return true
    }

    fun integer(mut self, asm: &mut x64::Asm, text: String, ty: u64) -> bool {
        when !is_integer_word(self.word(ty)) {
            return self.fail("an integer literal of this type")
        }
        asm.mov_ri(x64::Reg::RAX, literal_bits(text))
        return true
    }

    fun boolean(mut self, asm: &mut x64::Asm, value: bool) -> bool {
        when value {
            asm.mov_ri(x64::Reg::RAX, 1)
        } else {
            asm.mov_ri(x64::Reg::RAX, 0)
        }
        return true
    }

    fun char_value(mut self, asm: &mut x64::Asm, scalar: u64) -> bool {
        asm.mov_ri(x64::Reg::RAX, scalar)
        return true
    }

    fun local(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        when !self.is_cell(ty) && !self.is_handle_struct(ty) {
            return self.fail("a structure value")
        }
        cell_slot := self.frame_slot(slot)
        when cell_slot.is_none() {
            return self.fail("a local of an inlined function")
        }
        when self.is_handle_struct(ty) {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(cell_slot.unwrap()))
            return true
        }
        register := self.reg_of(cell_slot.unwrap())
        when register != 0 {
            asm.mov_rr(x64::Reg::RAX, register)
            return true
        }
        return self.load_cell(asm, ty, x64::Reg::RBP, slot_disp(cell_slot.unwrap()))
    }

    // The frame cell of a local of the function being generated. In an inlined body a parameter is the caller's cell that
    // holds its argument; `inline_function` admits no other local there, so a slot that is not a parameter is `None`. The
    // latest inlined body is searched first, since a body inlined in another reads its own parameters.
    fun frame_slot(self, slot: u64) -> Option<u64> {
        when !self.inline_active {
            return Option::Some(slot)
        }
        mut at: u64 = self.inline_slots.len()
        while at > 0 {
            at -= 1
            when self.inline_slots[at] == slot {
                return Option::Some(self.inline_cells[at])
            }
        }
        return Option::None
    }

    // A local moved out: its value is read, and a vector or map that has to be dropped (or a handle) leaves the slot null,
    // so that its owner drops nothing.
    fun move_local(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        when !self.local(asm, slot, ty) {
            return false
        }
        self.null_owners(asm, slot, ty)
        return true
    }

    // Whether a type occupies one cell of its own: a scalar, a reference or a raw pointer. Structures, strings and arrays
    // take several cells, and are not values of an expression here.
    // The width in bytes of a value of a type in memory: a scalar's width, or 8 for a reference or a raw pointer.
    fun value_width(self, ty: u64) -> u64 {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => string_width(word),
            _ => 8,
        }
    }

    // Loads a scalar of type `ty` from `displacement` past `base` into rax, extended to 64 bits as its type says.
    fun load_cell(mut self, asm: &mut x64::Asm, ty: u64, base: u64, displacement: i64) -> bool {
        signed := choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => is_signed_word(word),
            _ => false,
        }
        asm.load(self.value_width(ty), signed, x64::Reg::RAX, base, displacement)
        return true
    }

    fun store_cell(mut self, asm: &mut x64::Asm, ty: u64, source: u64, base: u64, displacement: i64) -> bool {
        asm.store(self.value_width(ty), source, base, displacement)
        return true
    }

    fun is_str(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => word == "Str",
            _ => false,
        }
    }

    fun is_cell(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => string_width(word) != 0,
            ir::IrTy::ReferenceTo(target, mutable) => true,
            ir::IrTy::RawPointerTo(target) => true,
            ir::IrTy::VecOf(element) => true,
            ir::IrTy::MapOf(key, value) => true,
            ir::IrTy::SetOf(key, value) => true,
            ir::IrTy::EnumTy(id) => true,
            ir::IrTy::FunctionPointerTo(parameters, result, external) => true,
            _ => false,
        }
    }

    // Stores a value of type `ty` into the cells from `base` on: one cell for a scalar, and each field of a structure
    // at its own offset, a structure value being stored field by field and a structure local copied cell by cell.
    fun store_into(mut self, asm: &mut x64::Asm, value: u64, base: u64, ty: u64) -> bool {
        when self.is_str(ty) {
            return self.store_str(asm, value, base)
        }
        when self.array_element_of(ty).is_some() {
            return self.store_array(asm, value, base, ty)
        }
        when self.slice_element(ty).is_some() {
            return self.store_slice(asm, value, base)
        }
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.store_struct(asm, value, base, id),
            _ => self.store_scalar(asm, value, base, ty),
        }
    }

    fun store_scalar(mut self, asm: &mut x64::Asm, value: u64, base: u64, ty: u64) -> bool {
        when !self.is_cell(ty) {
            return self.fail("a value of this type")
        }
        // `x = x op y` of a 64-bit local in a register is one instruction on the register.
        register := self.reg_of(base)
        when register != 0 && self.update_in_place(asm, value, base, ty, register) {
            return true
        }
        when !self.expr(asm, value) {
            return false
        }
        when register == 0 {
            return self.store_cell(asm, ty, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base))
        }
        self.write_cell(asm, 8, x64::Reg::RAX, base, register)
        asm.mov_rr(register, x64::Reg::RAX)
        return true
    }

    // `x = x op y` where `x` lives in `register`, has 64 bits, and `op` is add, subtract, and, or or xor, with `y` a constant
    // or a local nothing else changes: `op register, y`, and the frame cell follows. False when it is not that shape.
    fun update_in_place(mut self, asm: &mut x64::Asm, value: u64, base: u64, ty: u64, register: u64) -> bool {
        when self.value_width(ty) != 8 || self.no_opt {
            return false
        }
        op := choose self.program.exprs[value] {
            ir::IrExpr::Binary(op, left, right, bty) => op,
            _ => String(""),
        }
        left := choose self.program.exprs[value] {
            ir::IrExpr::Binary(op, left, right, bty) => left,
            _ => 0,
        }
        right := choose self.program.exprs[value] {
            ir::IrExpr::Binary(op, left, right, bty) => right,
            _ => 0,
        }
        when op != "Add" && op != "Sub" && op != "BitAnd" && op != "BitOr" && op != "BitXor" {
            return false
        }
        when self.operand_reg(left) != register {
            return false
        }
        mut extension: u64 = 0
        mut opcode: u64 = 1
        when op == "Sub" {
            extension = 5
            opcode = 41
        } else when op == "BitAnd" {
            extension = 4
            opcode = 33
        } else when op == "BitOr" {
            extension = 1
            opcode = 9
        } else when op == "BitXor" {
            extension = 6
            opcode = 49
        }
        immediate := self.immediate_operand(op.clone(), right)
        when immediate.is_some() {
            asm.alu_ri(extension, register, immediate.unwrap() as i64)
        } else when self.operand_reg(right) != 0 {
            asm.alu_rr(opcode, register, self.operand_reg(right))
        } else when self.is_stable_operand(right) {
            self.load_stable_operand(asm, right, x64::Reg::RCX)
            asm.alu_rr(opcode, register, x64::Reg::RCX)
        } else {
            return false
        }
        self.write_cell(asm, 8, register, base, register)
        return true
    }

    fun store_str(mut self, asm: &mut x64::Asm, value: u64, base: u64) -> bool {
        return choose self.program.exprs[value] {
            ir::IrExpr::StrLit(text) => self.store_literal_cells(asm, text, base),
            ir::IrExpr::LocalRef(slot, ty, span) => self.copy_cells(asm, slot, base, 2),
            ir::IrExpr::MoveRef(slot, mty) => self.copy_cells(asm, slot, base, 2),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_into(asm, target, arguments, base, 2),
            ir::IrExpr::FieldRead(fv, fid, field, fty, fspan) => self.store_field_str(asm, value, base),
            ir::IrExpr::ReferenceFieldRead(rp, rid, rfield, rty, rspan, rborrowed) => self.store_field_str(asm, value, base),
            ir::IrExpr::ArrayIndex(array, aindex, aty, length) => self.store_element_str(asm, array, aindex, aty, length, base),
            ir::IrExpr::IfExpr(condition, then_value, else_value, ity) => self.store_aggregate_result(asm, value, base, 2, ity),
            ir::IrExpr::EnumMatch(matched, mid, arms, mty) => self.store_aggregate_result(asm, value, base, 2, mty),
            _ => self.fail_at("a string value", value),
        }
    }

    // A `str` element copied into the cells from `base` on, from the element's lowest cell as memory (see `memory_address`).
    fun store_element_str(mut self, asm: &mut x64::Asm, array: u64, index: u64, element: u64, length: u64, base: u64) -> bool {
        when self.array_local_of(array).is_none() || !self.is_str(element) {
            return self.fail("a str element of this array")
        }
        when !self.array_element_address(asm, array, index, element, length) {
            return false
        }
        self.copy_ty_id = 0
        return self.copy_memory_to_cells(asm, base, 2)
    }

    fun store_literal_cells(mut self, asm: &mut x64::Asm, text: String, base: u64) -> bool {
        index := self.literal(text.clone())
        asm.lea_symbol(x64::Reg::RAX, self.literal_symbols[index])
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base))
        asm.mov_ri(x64::Reg::RAX, text.len())
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + 1))
        return true
    }

    // Writes a str local to standard output: its pointer and length are its two cells.
    fun write_str_local(mut self, asm: &mut x64::Asm, slot: u64) -> bool {
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, slot_disp(slot))
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_disp(slot + 1))
        asm.call_label(self.write_label)
        return true
    }

    fun store_struct(mut self, asm: &mut x64::Asm, value: u64, base: u64, id: u64) -> bool {
        place := self.place_of(value)
        when place.is_some() && self.struct_destructor_cells(id).len() == 0 {
            return self.copy_cells(asm, place.unwrap(), base, self.program.structs[id].slot_count)
        }
        when self.is_memory_place(value) && self.struct_destructor_cells(id).len() == 0 {
            when !self.memory_borrowed(value) && self.has_owners(self.struct_type(id)) {
                return self.store_aggregate_result(asm, value, base, self.program.structs[id].slot_count, self.struct_type(id))
            }
            when !self.memory_address(asm, value) {
                return false
            }
            self.copy_ty_id = 0
            when self.program.structs[id].repr_c {
                self.copy_ty_id = id + 1
            }
            result := self.copy_memory_to_cells(asm, base, self.program.structs[id].slot_count)
            self.copy_ty_id = 0
            return result
        }
        return choose self.program.exprs[value] {
            ir::IrExpr::StructValue(sid, fields, values) => self.store_fields(asm, base, id, sid, fields, values),
            ir::IrExpr::LocalRef(slot, ty, span) => self.copy_cells(asm, slot, base, self.program.structs[id].slot_count),
            ir::IrExpr::MoveRef(slot, mty) => self.store_moved(asm, slot, base, id),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_into(asm, target, arguments, base, self.program.structs[id].slot_count),
            ir::IrExpr::Propagate(value, input, output, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred) => self.propagate_struct(asm, value, id, failure_type, success_variant, output_failure_variant, deferred, base),
            ir::IrExpr::EnumMatch(matched, mid, arms, mty) => self.store_aggregate_result(asm, value, base, self.program.structs[id].slot_count, mty),
            ir::IrExpr::IfExpr(condition, then_value, else_value, ity) => self.store_aggregate_result(asm, value, base, self.program.structs[id].slot_count, ity),
            ir::IrExpr::FieldRead(outer, oid, field, fty, fspan) => self.store_aggregate_result(asm, value, base, self.program.structs[id].slot_count, fty),
            _ => self.fail_at("a structure value", value),
        }
    }

    fun store_fields(mut self, asm: &mut x64::Asm, base: u64, id: u64, sid: u64, fields: Vec<u64>, values: Vec<u64>) -> bool {
        when sid != id {
            return self.fail("a structure value of another structure")
        }
        mut position: u64 = 0
        while position < fields.len() {
            field_index := fields[position]
            offset := self.program.structs[id].fields[field_index].slot_offset
            field_ty := self.program.structs[id].fields[field_index].ty
            when !self.store_into(asm, values[position], base + offset, field_ty) {
                return false
            }
            position += 1
        }
        return true
    }

    // Copies `count` cells from the local at `source` to the cells from `base` on.
    fun copy_cells(mut self, asm: &mut x64::Asm, source: u64, base: u64, count: u64) -> bool {
        mut position: u64 = 0
        while position < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_disp(source + position))
            asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_disp(base + position))
            position += 1
        }
        return true
    }

    // A field of a structure local, read from its cell.
    fun field_read(mut self, asm: &mut x64::Asm, value: u64, id: u64, field: u64, ty: u64) -> bool {
        when !self.is_cell(ty) {
            return self.fail("a structure field of a structure type")
        }
        return choose self.program.exprs[value] {
            ir::IrExpr::LocalRef(slot, lty, span) => self.local_field(asm, slot, id, field, ty),
            ir::IrExpr::MoveRef(slot, mty) => self.moved_local_field(asm, slot, id, field, ty, mty),
            ir::IrExpr::Dereference(pointer, dty) => self.field_through(asm, pointer, id, field, ty),
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_or_element_field(asm, value, target, arguments, id, field, ty),
            ir::IrExpr::ArrayIndex(array, index, aty, length) => self.element_field_read(asm, value, id, field, ty),
            ir::IrExpr::SliceIndex(slice, index, aty) => self.element_field_read(asm, value, id, field, ty),
            _ => self.field_of_value(asm, value, id, field, ty),
        }
    }

    // A field of a structure value that is not a local: the value is pushed and the field read from its cells, which
    // are then removed. The value is evaluated once for each field read, so only a value without effects is read here.
    // Whether an expression builds a structure from its fields, so that all of them are evaluated once, in order, as a push does.
    fun is_struct_literal(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::StructValue(id, fields, values) => true,
            _ => false,
        }
    }

    // A field of a structure that is itself a field (at any depth) of the result of a call, `call().a.b`: the result of the
    // call is the root. Answers the call expression, the root's structure and the cell offset of `value` inside it; an
    // empty list for any other value.
    fun nested_call_root(self, value: u64) -> Vec<u64> {
        mut none: Vec<u64> = Vec()
        return choose self.program.exprs[value] {
            ir::IrExpr::FieldRead(inner, iid, ifield, ity, span) => self.nested_call_step(inner, iid, ifield),
            _ => none,
        }
    }

    fun nested_call_step(self, inner: u64, id: u64, field: u64) -> Vec<u64> {
        mut none: Vec<u64> = Vec()
        offset := self.program.structs[id].fields[field].slot_offset
        return choose self.program.exprs[inner] {
            ir::IrExpr::CallExpr(target, arguments, cty) => self.nested_call_found(inner, id, offset),
            ir::IrExpr::FieldRead(deeper, did, dfield, dty, span) => self.nested_call_deeper(deeper, did, dfield, offset),
            _ => none,
        }
    }

    fun nested_call_found(self, call: u64, id: u64, offset: u64) -> Vec<u64> {
        mut found: Vec<u64> = Vec()
        found.push(call)
        found.push(id)
        found.push(offset)
        return found
    }

    fun nested_call_deeper(self, inner: u64, id: u64, field: u64, offset: u64) -> Vec<u64> {
        found := self.nested_call_step(inner, id, field)
        when found.len() == 0 {
            return found
        }
        mut shifted: Vec<u64> = Vec()
        shifted.push(found[0])
        shifted.push(found[1])
        shifted.push(found[2] + offset)
        return shifted
    }

    // The cell of a field read from a structure nested in the result of a call: the result is pushed, the cell loaded, and
    // the rest of the result dropped.
    fun nested_call_field(mut self, asm: &mut x64::Asm, nested: Vec<u64>, id: u64, field: u64, ty: u64) -> bool {
        root := nested[1]
        when self.program.structs[root].drop_function.is_some() {
            return self.fail("a field of a temporary destructor")
        }
        pushed := choose self.program.exprs[nested[0]] {
            ir::IrExpr::CallExpr(target, arguments, cty) => self.call_expression(asm, target, arguments),
            _ => self.fail("a field of a value that is not a local"),
        }
        when !pushed {
            return false
        }
        count := self.program.structs[root].slot_count
        offset := nested[2] + self.program.structs[id].fields[field].slot_offset
        disp := (8 * (count - 1 - offset)) as i64
        when !self.load_cell(asm, ty, x64::Reg::RSP, disp) {
            return false
        }
        self.drop_field_remainder(asm, root, disp, ty)
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    fun field_of_value(mut self, asm: &mut x64::Asm, value: u64, id: u64, field: u64, ty: u64) -> bool {
        base := self.place_of(value)
        when base.is_some() {
            return self.local_field(asm, base.unwrap(), id, field, ty)
        }
        when self.is_memory_place(value) {
            return self.field_through_place(asm, value, id, field, ty)
        }
        when self.program.structs[id].drop_function.is_some() {
            return self.fail("a field of a temporary destructor")
        }
        nested := self.nested_call_root(value)
        when nested.len() > 0 {
            return self.nested_call_field(asm, nested, id, field, ty)
        }
        when !self.is_pure(value) && !self.is_propagation(value) && !self.is_struct_literal(value) {
            return self.fail("a field of a value that is not a local")
        }
        when !self.push_structure(asm, value, id) {
            return false
        }
        count := self.program.structs[id].slot_count
        when !self.load_cell(asm, ty, x64::Reg::RSP, self.pushed_field_disp(id, field)) {
            return false
        }
        self.drop_field_remainder(asm, id, self.pushed_field_disp(id, field), ty)
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    // Whether evaluating an expression has no effect: a literal, a local, or a structure or cast of such values.
    fun is_pure(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::IntegerLit(text, ty) => true,
            ir::IrExpr::BoolLit(flag) => true,
            ir::IrExpr::CharLit(scalar) => true,
            ir::IrExpr::LocalRef(slot, ty, span) => true,
            ir::IrExpr::MoveRef(slot, ty) => true,
            ir::IrExpr::FfiArray(array, element, length, index, mutable) => false,
            ir::IrExpr::CastExpr(inner, source, target) => self.is_pure(inner),
            ir::IrExpr::StructValue(id, fields, values) => self.all_pure(values),
            ir::IrExpr::FieldRead(inner, id, field, ty, span) => self.is_pure(inner),
            ir::IrExpr::ReferenceFieldRead(inner, id, field, ty, span, borrowed) => self.is_pure(inner),
            ir::IrExpr::Dereference(inner, ty) => self.is_pure(inner),
            ir::IrExpr::PlaceAddress(inner, ty) => self.is_pure(inner),
            ir::IrExpr::Binary(op, left, right, ty) => self.is_pure(left) && self.is_pure(right),
            ir::IrExpr::CallExpr(target, arguments, ty) => self.is_pure_call(target, arguments),
            _ => false,
        }
    }

    // A vector read (an element, the length) with arguments that are pure: it has no effect but a failed bounds check.
    fun is_pure_call(self, target: ir::CallTarget, arguments: Vec<u64>) -> bool {
        return choose target {
            ir::CallTarget::VecOp(op, element) => (op == "Index" || op == "Len") && self.all_pure(arguments),
            _ => false,
        }
    }

    fun all_pure(self, values: Vec<u64>) -> bool {
        for value in values {
            when !self.is_pure(value) {
                return false
            }
        }
        return true
    }

    fun is_propagation(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::Propagate(v, input, output, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred) => true,
            _ => false,
        }
    }

    // Whether a structure is in memory, reached through a reference: a field of a reference's structure, or what a
    // reference points at.
    fun is_memory_place(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => true,
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.is_memory_place(value),
            ir::IrExpr::Dereference(pointer, ty) => true,
            ir::IrExpr::ArrayIndex(array, index, ty, length) => self.is_element_structure(ty) || self.is_plain_array(ty),
            ir::IrExpr::SliceIndex(slice, index, ty) => self.is_element_structure(ty),
            _ => false,
        }
    }

    fun memory_borrowed(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => borrowed,
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.memory_borrowed(value),
            // A read of an element is a copy of it, so the copy clones the owners it holds.
            ir::IrExpr::ArrayIndex(array, index, ty, length) => false,
            ir::IrExpr::SliceIndex(slice, index, ty) => false,
            _ => true,
        }
    }

    // A field of an element: a scalar is loaded from the element; an owner is cloned, as `vec_index` clones an owner.
    fun element_field_read(mut self, asm: &mut x64::Asm, value: u64, id: u64, field: u64, ty: u64) -> bool {
        when !self.has_owners(ty) {
            return self.field_through_place(asm, value, id, field, ty)
        }
        owned := self.owned_cells(ty)
        when owned.is_none() || !self.is_cell(ty) {
            return self.fail("a field of an array element that owns memory")
        }
        copies := owned.unwrap()
        when copies.len() != 3 {
            return self.fail("a field of an array element that owns memory")
        }
        when !self.memory_address(asm, value) {
            return false
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RAX, self.field_displacement(id, field))
        asm.call_label(self.copy_routine(asm, copies[1], copies[2]))
        return true
    }

    // The address of a structure in memory, in rax: its lowest cell, and its cell k lies `8 * (N - 1 - k)` above that.
    fun memory_address(mut self, asm: &mut x64::Asm, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::ReferenceFieldRead(pointer, id, field, ty, span, borrowed) => self.reference_field_address(asm, pointer, id, field),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.value_field_address(asm, value, id, field),
            ir::IrExpr::Dereference(pointer, ty) => self.expr(asm, pointer),
            ir::IrExpr::LocalRef(slot, ty, span) => self.address_of(asm, slot, ty),
            ir::IrExpr::ArrayIndex(array, index, ty, length) => self.array_element_address(asm, array, index, ty, length),
            ir::IrExpr::SliceIndex(slice, index, ty) => self.slice_element_address(asm, slice, index, ty),
            _ => self.fail("a structure in memory that is not reached through a reference"),
        }
    }

    // The address of field `field` of the structure that the reference `pointer` holds, in rax.
    fun reference_field_address(mut self, asm: &mut x64::Asm, pointer: u64, id: u64, field: u64) -> bool {
        when !self.expr(asm, pointer) {
            return false
        }
        asm.lea(x64::Reg::RAX, x64::Reg::RAX, self.sub_displacement(id, field))
        return true
    }

    // The address of field `field` of the structure in memory at `value`, in rax.
    fun value_field_address(mut self, asm: &mut x64::Asm, value: u64, id: u64, field: u64) -> bool {
        when !self.memory_address(asm, value) {
            return false
        }
        asm.lea(x64::Reg::RAX, x64::Reg::RAX, self.sub_displacement(id, field))
        return true
    }

    // The distance from the lowest cell of a structure to the lowest cell of its field, which takes `cells` cells above it.
    fun sub_displacement(self, id: u64, field: u64) -> i64 {
        when self.program.structs[id].repr_c {
            return self.c_field_offset(id, field) as i64
        }
        count := self.program.structs[id].slot_count
        offset := self.program.structs[id].fields[field].slot_offset
        cells := self.cells_of(self.program.structs[id].fields[field].ty)
        return (8 * (count - offset - cells)) as i64
    }

    // A cell of a structure in memory, read at the address of the structure.
    fun field_through_place(mut self, asm: &mut x64::Asm, value: u64, id: u64, field: u64, ty: u64) -> bool {
        when !self.is_cell(ty) {
            return self.fail("a structure field of a structure type")
        }
        when !self.memory_address(asm, value) {
            return false
        }
        return self.load_cell(asm, ty, x64::Reg::RAX, self.field_displacement(id, field))
    }

    // Pushes the `count` cells of the structure at the address in rax, the first cell first.
    fun push_memory_cells(mut self, asm: &mut x64::Asm, count: u64) -> bool {
        when self.copy_ty_id != 0 {
            asm.mov_rr(x64::Reg::RSI, x64::Reg::RAX)
            asm.alu_ri(5, x64::Reg::RSP, (8 * count) as i64)
            self.unpack_from_image(asm, self.copy_ty_id - 1, x64::Reg::RSI, x64::Reg::RSP)
            return true
        }
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (count - 1 - cell)) as i64)
            asm.push(x64::Reg::RCX)
            cell += 1
        }
        return true
    }

    // Copies the `count` cells of the structure at the address in rax into the frame from `base` on.
    fun copy_memory_to_cells(mut self, asm: &mut x64::Asm, base: u64, count: u64) -> bool {
        when self.copy_ty_id != 0 {
            asm.mov_rr(x64::Reg::RSI, x64::Reg::RAX)
            asm.lea(x64::Reg::RDI, x64::Reg::RBP, slot_disp(base + count - 1))
            self.unpack_from_image(asm, self.copy_ty_id - 1, x64::Reg::RSI, x64::Reg::RDI)
            return true
        }
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RCX, x64::Reg::RBP, slot_disp(base + cell))
            cell += 1
        }
        return true
    }

    // Copies the `count` cells of the structure at the address in rax into the box on the stack, after the tag and `offset`.
    fun copy_memory_to_box(mut self, asm: &mut x64::Asm, offset: u64, count: u64) -> bool {
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RAX, (8 * (count - 1 - cell)) as i64)
            asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, 0)
            asm.store(8, x64::Reg::RCX, x64::Reg::RDX, (8 * (1 + offset + cell)) as i64)
            cell += 1
        }
        return true
    }

    // A structure local moved into the box at the payload `offset`.
    fun store_moved_to_box(mut self, asm: &mut x64::Asm, slot: u64, offset: u64, id: u64) -> bool {
        when !self.copy_local_to_box(asm, slot, offset, self.program.structs[id].slot_count) {
            return false
        }
        self.null_moved(asm, slot, id)
        return true
    }

    // A structure that a call returns, stored into the box at the payload `offset`: its cells are on the stack above the box.
    fun call_into_box(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>, offset: u64, id: u64) -> bool {
        count := self.program.structs[id].slot_count
        when !self.call_expression(asm, target, arguments) {
            return false
        }
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RSP, (8 * count) as i64)
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RAX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RAX, x64::Reg::RDX, (8 * (1 + offset + cell)) as i64)
            cell += 1
        }
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    // The first cell of a local place: a structure local, or a field of one, which the frame holds at its offset.
    fun place_of(self, index: u64) -> Option<u64> {
        // A local that lives in a register is not a place: it is read as a value, not from its cells.
        when self.operand_reg(index) != 0 {
            return Option::None
        }
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => self.frame_slot(slot),
            ir::IrExpr::FieldRead(value, id, field, ty, span) => self.field_place(value, id, field),
            _ => Option::None,
        }
    }

    // Where field `field` of a structure that was pushed as its cells lies above the stack pointer: the cell of the field, or
    // for a `repr(C)` structure its place in the structure's bytes, which start at the stack pointer.
    fun pushed_field_disp(self, id: u64, field: u64) -> i64 {
        count := self.program.structs[id].slot_count
        offset := self.program.structs[id].fields[field].slot_offset
        return (8 * (count - 1 - offset)) as i64
    }

    fun field_place(self, value: u64, id: u64, field: u64) -> Option<u64> {
        base := self.place_of(value)
        when base.is_none() {
            return Option::None
        }
        return Option::Some(base.unwrap() + self.program.structs[id].fields[field].slot_offset)
    }

    // A field of a moved structure local: the whole structure is moved, so none of its owners is left for its scope to drop.
    fun moved_local_field(mut self, asm: &mut x64::Asm, slot: u64, id: u64, field: u64, ty: u64, structure: u64) -> bool {
        when !self.local_field(asm, slot, id, field, ty) {
            return false
        }
        asm.push(x64::Reg::RAX)
        self.null_owners(asm, slot + self.program.structs[id].fields[field].slot_offset, ty)
        self.drop_slot(asm, slot, structure)
        asm.pop(x64::Reg::RAX)
        return true
    }

    // A field taken from a temporary leaves its owner alive and drops the other fields.
    fun drop_field_remainder(mut self, asm: &mut x64::Asm, id: u64, disp: i64, ty: u64) {
        count := self.program.structs[id].slot_count
        asm.push(x64::Reg::RAX)
        when self.has_owners(ty) {
            asm.mov_ri(x64::Reg::RCX, 0)
            asm.store(8, x64::Reg::RCX, x64::Reg::RSP, 8 + disp)
        }
        asm.lea(x64::Reg::RDI, x64::Reg::RSP, (8 * count) as i64)
        asm.call_label(self.value_drop_routine(asm, self.struct_type(id), false))
        asm.pop(x64::Reg::RAX)
    }

    fun local_field(mut self, asm: &mut x64::Asm, slot: u64, id: u64, field: u64, ty: u64) -> bool {
        register := self.reg_of(slot + self.program.structs[id].fields[field].slot_offset)
        when register != 0 {
            asm.mov_rr(x64::Reg::RAX, register)
            return true
        }
        displacement := slot_disp(slot + self.program.structs[id].fields[field].slot_offset)
        return self.load_cell(asm, ty, x64::Reg::RBP, displacement)
    }

    // A field read through a reference: the reference is the address of the structure's first cell, and the cells
    // of a structure lie at lower addresses as their slots rise.
    fun field_through(mut self, asm: &mut x64::Asm, pointer: u64, id: u64, field: u64, ty: u64) -> bool {
        when !self.is_cell(ty) {
            return self.fail("a structure field of a structure type")
        }
        when !self.expr(asm, pointer) {
            return false
        }
        return self.load_cell(asm, ty, x64::Reg::RAX, self.field_displacement(id, field))
    }

    // Reading an owning field through a reference clones it unless the IR explicitly lends it.
    fun read_reference_field(mut self, asm: &mut x64::Asm, pointer: u64, id: u64, field: u64, ty: u64, borrowed: bool) -> bool {
        when !self.field_through(asm, pointer, id, field, ty) {
            return false
        }
        when !borrowed && self.has_owners(ty) {
            owned := self.owned_cells(ty)
            when owned.is_none() || owned.unwrap().len() != 3 {
                return self.fail("a copy of this reference field")
            }
            cells := owned.unwrap()
            asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
            asm.call_label(self.copy_routine(asm, cells[1], cells[2]))
        }
        return true
    }

    // A structure field stored through a pointer: its cells go to the lowest cell of the field on. A field of a `repr(C)`
    // structure keeps the C layout.
    fun store_field_cells_through(mut self, asm: &mut x64::Asm, value: u64, pointer: u64, id: u64, field: u64, ty: u64) -> bool {
        displacement := self.sub_displacement(id, field)
        when self.program.structs[id].repr_c {
            return self.store_through(asm, value, pointer, displacement, ty)
        }
        when self.cells_of(ty) == 0 {
            return self.fail("an assignment of a structure through a pointer")
        }
        return self.store_cells_through(asm, value, pointer, displacement, ty)
    }

    fun store_field_through(mut self, asm: &mut x64::Asm, value: u64, pointer: u64, id: u64, field: u64, ty: u64) -> bool {
        // A field that is itself a structure (a `Vec`, a `String`, a nested structure) is stored as its cells, from the
        // lowest cell of the field on.
        when !self.is_cell(ty) {
            return self.store_field_cells_through(asm, value, pointer, id, field, ty)
        }
        return self.store_through(asm, value, pointer, self.field_displacement(id, field), ty)
    }

    // A structure stored through a pointer as its cells, the first cell at the highest offset, as a field read through
    // the pointer reads it; `displacement` is the offset of its lowest cell.
    fun store_cells_through(mut self, asm: &mut x64::Asm, value: u64, pointer: u64, displacement: i64, ty: u64) -> bool {
        // A structure is pushed as its cells, the pointer is evaluated, and each cell is stored through it, the
        // first cell at the highest offset, as a field read through the pointer reads it.
        count := self.cells_of(ty)
        when !self.push_value(asm, value, ty) {
            return false
        }
        when !self.expr(asm, pointer) {
            return false
        }
        when self.has_owners(ty) {
            asm.push(x64::Reg::RAX)
            asm.lea(x64::Reg::RDI, x64::Reg::RAX, displacement + (8 * (count - 1)) as i64)
            asm.call_label(self.value_drop_routine(asm, ty, false))
            asm.pop(x64::Reg::RAX)
        }
        mut cell: u64 = 0
        while cell < count {
            asm.load(8, false, x64::Reg::RCX, x64::Reg::RSP, (8 * (count - 1 - cell)) as i64)
            asm.store(8, x64::Reg::RCX, x64::Reg::RAX, displacement + (8 * (count - 1 - cell)) as i64)
            cell += 1
        }
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    fun is_place_address(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::PlaceAddress(place, ty) => true,
            ir::IrExpr::AddressOf(slot, ty, pointer_type, span) => true,
            _ => false,
        }
    }

    // Stores a scalar through a pointer, at `displacement` from the address the pointer holds.
    fun store_through(mut self, asm: &mut x64::Asm, value: u64, pointer: u64, displacement: i64, ty: u64) -> bool {
        when !self.is_cell(ty) {
            when self.is_repr_c_structure(ty) {
                return self.store_c_struct_through(asm, value, pointer, displacement, ty)
            }
            when self.cells_of(ty) > 0 && !self.is_str(ty) && self.c_size_of(ty) == 8 * self.cells_of(ty) {
                return self.store_cells_through(asm, value, pointer, displacement, ty)
            }
            // The address of a place in Ryn's own memory (an element of an array of structures, a field) holds the cells of the
            // structure as they are, whatever size C would give it.
            when self.cells_of(ty) > 0 && !self.is_str(ty) && self.struct_of(ty).is_some() && self.is_place_address(pointer) {
                return self.store_cells_through(asm, value, pointer, displacement, ty)
            }
            return self.fail("an assignment of a structure through a pointer")
        }
        when !self.expr(asm, value) {
            return false
        }
        asm.push(x64::Reg::RAX)
        when !self.expr(asm, pointer) {
            return false
        }
        when self.has_owners(ty) {
            asm.push(x64::Reg::RAX)
            asm.lea(x64::Reg::RDI, x64::Reg::RAX, displacement)
            asm.call_label(self.value_drop_routine(asm, ty, false))
            asm.pop(x64::Reg::RAX)
        }
        asm.pop(x64::Reg::RCX)
        return self.store_cell(asm, ty, x64::Reg::RCX, x64::Reg::RAX, displacement)
    }

    // A `repr(C)` structure stored through a pointer: its bytes, `sizeof` of them, from its lowest cell to the address.
    fun store_c_struct_through(mut self, asm: &mut x64::Asm, value: u64, pointer: u64, displacement: i64, ty: u64) -> bool {
        count := self.cells_of(ty)
        when !self.push_value(asm, value, ty) {
            return false
        }
        when !self.expr(asm, pointer) {
            return false
        }
        asm.lea(x64::Reg::RDI, x64::Reg::RAX, displacement)
        self.pack_to_image(asm, self.struct_id_of(ty), x64::Reg::RSP, x64::Reg::RDI)
        asm.alu_ri(0, x64::Reg::RSP, (8 * count) as i64)
        return true
    }

    fun struct_id_of(self, ty: u64) -> u64 {
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => id,
            _ => 0,
        }
    }

    // Writes the fields of a `repr(C)` structure whose cells are at `cells` (the structure's lowest cell; cell k is `8 *
    // (N - 1 - k)` above it) into the C layout at `image`. Clobbers rax.
    fun pack_to_image(self, asm: &mut x64::Asm, id: u64, cells: u64, image: u64) {
        count := self.program.structs[id].slot_count
        mut field: u64 = 0
        while field < self.program.structs[id].fields.len() {
            offset := self.program.structs[id].fields[field].slot_offset
            ty := self.program.structs[id].fields[field].ty
            when self.array_element_of(ty).is_some() {
                // An array's element i is the cell `length - 1 - i` above the array's first cell, and C lays it out in order.
                element := self.array_element_of(ty).unwrap()
                length := self.array_length_of(ty)
                width := self.value_width(element)
                mut index: u64 = 0
                while index < length {
                    cell := offset + length - 1 - index
                    asm.load(width, false, x64::Reg::RAX, cells, (8 * (count - 1 - cell)) as i64)
                    asm.store(width, x64::Reg::RAX, image, (self.c_field_offset(id, field) + index * self.c_size_of(element)) as i64)
                    index += 1
                }
            } else {
                width := self.value_width(ty)
                asm.load(width, false, x64::Reg::RAX, cells, (8 * (count - 1 - offset)) as i64)
                asm.store(width, x64::Reg::RAX, image, self.c_field_offset(id, field) as i64)
            }
            field += 1
        }
    }

    // The reverse: reads the fields from the C layout at `image` into the cells at `cells`, each extended as its type says.
    fun unpack_from_image(self, asm: &mut x64::Asm, id: u64, image: u64, cells: u64) {
        count := self.program.structs[id].slot_count
        mut field: u64 = 0
        while field < self.program.structs[id].fields.len() {
            offset := self.program.structs[id].fields[field].slot_offset
            ty := self.program.structs[id].fields[field].ty
            when self.array_element_of(ty).is_some() {
                element := self.array_element_of(ty).unwrap()
                length := self.array_length_of(ty)
                width := self.value_width(element)
                signed := choose self.program.types[element] {
                    ir::IrTy::Scalar(word) => is_signed_word(word),
                    _ => false,
                }
                mut index: u64 = 0
                while index < length {
                    cell := offset + length - 1 - index
                    asm.load(width, signed, x64::Reg::RAX, image, (self.c_field_offset(id, field) + index * self.c_size_of(element)) as i64)
                    asm.store(8, x64::Reg::RAX, cells, (8 * (count - 1 - cell)) as i64)
                    index += 1
                }
            } else {
                width := self.value_width(ty)
                signed := choose self.program.types[ty] {
                    ir::IrTy::Scalar(word) => is_signed_word(word),
                    _ => false,
                }
                asm.load(width, signed, x64::Reg::RAX, image, self.c_field_offset(id, field) as i64)
                asm.store(8, x64::Reg::RAX, cells, (8 * (count - 1 - offset)) as i64)
            }
            field += 1
        }
    }

    // Copies `size` bytes from the memory at `source` to the memory at `target` (both registers), in moves of 8, 4, 2 and
    // 1 bytes, so that no byte past the end is read or written. Clobbers rax.
    fun copy_bytes(self, asm: &mut x64::Asm, source: u64, target: u64, size: u64) {
        mut at: u64 = 0
        while at + 8 <= size {
            asm.load(8, false, x64::Reg::RAX, source, at as i64)
            asm.store(8, x64::Reg::RAX, target, at as i64)
            at += 8
        }
        when at + 4 <= size {
            asm.load(4, false, x64::Reg::RAX, source, at as i64)
            asm.store(4, x64::Reg::RAX, target, at as i64)
            at += 4
        }
        when at + 2 <= size {
            asm.load(2, false, x64::Reg::RAX, source, at as i64)
            asm.store(2, x64::Reg::RAX, target, at as i64)
            at += 2
        }
        when at + 1 <= size {
            asm.load(1, false, x64::Reg::RAX, source, at as i64)
            asm.store(1, x64::Reg::RAX, target, at as i64)
        }
    }

    fun load_through(mut self, asm: &mut x64::Asm, pointer: u64, displacement: i64, ty: u64) -> bool {
        when !self.is_cell(ty) {
            return self.fail("a read of a structure through a pointer")
        }
        when !self.expr(asm, pointer) {
            return false
        }
        return self.load_cell(asm, ty, x64::Reg::RAX, displacement)
    }

    // The address of a value that is not a local, as an operator method takes its operand: a place is addressed where it lies,
    // and any other value is built in scratch cells, which live as long as the frame. A value that owns memory is declined,
    // since its drop would have to wait until the call is over.
    fun value_address(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        when self.place_of(value).is_some() {
            return self.address_of(asm, self.place_of(value).unwrap(), ty)
        }
        when self.has_owners(ty) {
            return self.fail("an address of a temporary that owns memory")
        }
        saved := self.scratch(self.cells_of(ty))
        when !self.store_into(asm, value, saved, ty) {
            return false
        }
        return self.address_of(asm, saved, ty)
    }

    // The address of a local: the frame address of its first cell.
    fun address_of(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        // A `repr(C)` structure is laid out in memory as C lays it out, which the cells of a frame are not: its address
        // is not given out.
        when self.is_repr_c_structure(ty) {
            return self.shadow_address(asm, slot, ty)
        }
        asm.lea(x64::Reg::RAX, x64::Reg::RBP, slot_disp(self.pointed_slot(slot, ty)))
        return true
    }

    // The address of a `repr(C)` local: the frame holds one cell per field, not C's layout, so a copy in C's layout is made
    // in scratch cells and its address given out. Foreign calls bring the copy up to date before they run and read it back
    // after, which is where C code can look at it or change it.
    fun shadow_address(mut self, asm: &mut x64::Asm, slot: u64, ty: u64) -> bool {
        id := self.struct_id_of(ty)
        when !self.c_shadow_fields_ok(id) {
            return self.fail("the address of a repr(C) structure with a field that is not a plain scalar")
        }
        mut image: u64 = 0
        mut at: u64 = 0
        mut known: bool = false
        while at < self.shadow_slots.len() {
            when self.shadow_slots[at] == slot {
                image = self.shadow_images[at]
                known = true
            }
            at += 1
        }
        when !known {
            image = self.scratch(self.program.structs[id].slot_count)
            self.shadow_slots.push(slot)
            self.shadow_images.push(image)
            self.shadow_ids.push(id)
        }
        self.sync_shadow(asm, self.shadow_slots.len() - 1, false)
        asm.lea(x64::Reg::RAX, x64::Reg::RBP, slot_disp(image + self.program.structs[id].slot_count - 1))
        return true
    }

    // Copies the shadow `which` (the index in the lists) to or from its local: `read_back` reads C's layout into the cells.
    fun sync_shadow(self, asm: &mut x64::Asm, which: u64, read_back: bool) {
        id := self.shadow_ids[which]
        count := self.program.structs[id].slot_count
        asm.lea(x64::Reg::R10, x64::Reg::RBP, slot_disp(self.shadow_slots[which] + count - 1))
        asm.lea(x64::Reg::R11, x64::Reg::RBP, slot_disp(self.shadow_images[which] + count - 1))
        when read_back {
            self.unpack_from_image(asm, id, x64::Reg::R11, x64::Reg::R10)
        } else {
            self.pack_to_image(asm, id, x64::Reg::R10, x64::Reg::R11)
        }
    }

    fun sync_shadows(self, asm: &mut x64::Asm, read_back: bool) {
        mut at: u64 = 0
        while at < self.shadow_slots.len() {
            self.sync_shadow(asm, at, read_back)
            at += 1
        }
    }

    // The slot whose cell is the lowest in memory for a value at `slot`: a structure's last slot, since its cells rise
    // from its last slot down to its first, and every other value's first slot.
    fun pointed_slot(self, slot: u64, ty: u64) -> u64 {
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => slot + self.program.structs[id].slot_count - 1,
            _ => slot,
        }
    }

    // The offset above a structure's lowest cell at which its field's cell lies: the cells of a structure rise from its
    // last slot down, so a field at slot offset k lies 8 * (count - 1 - k) above the structure's address.
    fun field_displacement(self, id: u64, field: u64) -> i64 {
        when self.program.structs[id].repr_c {
            return self.c_field_offset(id, field) as i64
        }
        count := self.program.structs[id].slot_count
        offset := self.program.structs[id].fields[field].slot_offset
        return (8 * (count - 1 - offset)) as i64
    }

    // The size and alignment that C gives a value, as the `sizeof` and `alignof` of a program are.
    fun c_size_of(self, ty: u64) -> u64 {
        when self.is_str(ty) {
            return 16
        }
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => string_width(word),
            ir::IrTy::StructTy(id) => self.struct_c_size(id),
            ir::IrTy::ArrayOf(element, length) => length * self.c_size_of(element),
            _ => 8,
        }
    }

    fun c_align_of(self, ty: u64) -> u64 {
        when self.is_str(ty) {
            return 8
        }
        return choose self.program.types[ty] {
            ir::IrTy::Scalar(word) => string_width(word),
            ir::IrTy::StructTy(id) => self.struct_c_align(id),
            ir::IrTy::ArrayOf(element, length) => self.c_align_of(element),
            _ => 8,
        }
    }

    // The byte offset that C gives field `field` of a structure: the fields follow each other, each at a multiple of its
    // alignment. A `repr(C)` structure keeps this layout in its cells: its bytes start at its lowest cell.
    fun c_field_offset(self, id: u64, field: u64) -> u64 {
        mut size: u64 = 0
        mut position: u64 = 0
        while position <= field {
            field_ty := self.program.structs[id].fields[position].ty
            a := self.c_field_align(id, field_ty)
            size = (size + a - 1) / a * a
            when position == field {
                return size
            }
            size += self.c_size_of(field_ty)
            position += 1
        }
        return size
    }

    // The alignment a field keeps in structure `id`: its own, or at most the structure's packing.
    fun c_field_align(self, id: u64, field_ty: u64) -> u64 {
        mut a := self.c_align_of(field_ty)
        pack := self.program.structs[id].layout & 65535
        when pack != 0 && a > pack {
            a = pack
        }
        return a
    }

    // Whether every field of a `repr(C)` structure, for its copy in C's layout, is a plain scalar or an array of them.
    fun c_shadow_fields_ok(self, id: u64) -> bool {
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            field_ty := self.program.structs[id].fields[position].ty
            element := self.array_element_of(field_ty)
            when element.is_some() {
                when !self.is_plain_scalar(element.unwrap()) {
                    return false
                }
            } else {
                when !self.is_plain_scalar(field_ty) {
                    return false
                }
            }
            position += 1
        }
        return true
    }

    // Whether every field of a `repr(C)` structure is a plain scalar, as the layout supports.
    fun c_fields_are_scalars(self, id: u64) -> bool {
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            when !self.is_plain_scalar(self.program.structs[id].fields[position].ty) {
                return false
            }
            position += 1
        }
        return true
    }

    fun struct_c_size(self, id: u64) -> u64 {
        mut size: u64 = 0
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            field_ty := self.program.structs[id].fields[position].ty
            a := self.c_field_align(id, field_ty)
            size = (size + a - 1) / a * a + self.c_size_of(field_ty)
            position += 1
        }
        align := self.struct_c_align(id)
        return (size + align - 1) / align * align
    }

    // The alignment of a structure: the largest alignment a field keeps (at most the packing), raised to the `align(N)` of its
    // `repr`.
    fun struct_c_align(self, id: u64) -> u64 {
        mut align: u64 = 1
        mut position: u64 = 0
        while position < self.program.structs[id].fields.len() {
            a := self.c_field_align(id, self.program.structs[id].fields[position].ty)
            when a > align {
                align = a
            }
            position += 1
        }
        minimum := self.program.structs[id].layout >> (16 as u32)
        when minimum > align {
            align = minimum
        }
        return align
    }

    // The constant `right` of an operator that has an immediate form (add, sub, and, or, xor, and the comparisons), when it
    // fits a sign-extended 32-bit immediate: its bits as they are in a canonical register.
    fun immediate_operand(mut self, op: String, right: u64) -> Option<u64> {
        when self.no_opt {
            return Option::None
        }
        when op != "Add" && op != "Sub" && op != "BitAnd" && op != "BitOr" && op != "BitXor" && op != "Eq" && op != "Ne" && op != "Lt" && op != "Le" && op != "Gt" && op != "Ge" {
            return Option::None
        }
        known := self.const_value(right)
        when !known.is_some() {
            return Option::None
        }
        value := known.unwrap() as i64
        when value < (0 as i64) - 2147483648 || value > 2147483647 {
            return Option::None
        }
        return known
    }

    // `rax op immediate`, the operator of `immediate_operand`.
    fun binary_immediate(mut self, asm: &mut x64::Asm, op: String, bits: u64, operand: String) -> bool {
        value := bits as i64
        when op == "Eq" || op == "Ne" || op == "Lt" || op == "Le" || op == "Gt" || op == "Ge" {
            asm.alu_ri(7, x64::Reg::RAX, value)
            asm.setcc(comparison_condition(op, is_signed_word(operand.clone())), x64::Reg::RAX)
            return true
        }
        when op == "Add" {
            asm.alu_ri(0, x64::Reg::RAX, value)
        } else when op == "Sub" {
            asm.alu_ri(5, x64::Reg::RAX, value)
        } else when op == "BitAnd" {
            asm.alu_ri(4, x64::Reg::RAX, value)
        } else when op == "BitOr" {
            asm.alu_ri(1, x64::Reg::RAX, value)
        } else {
            asm.alu_ri(6, x64::Reg::RAX, value)
        }
        self.normalize(asm, operand)
        return true
    }

    // Whether `index` is a constant, or an integer, bool or char local that no code but an assignment in this function can
    // change (its address is never taken): its value is the same whenever it is read between two statements, so it can be
    // read after another operand is evaluated, whatever that does.
    fun is_stable_operand(mut self, index: u64) -> bool {
        when self.no_opt {
            return false
        }
        when self.const_value(index).is_some() {
            return true
        }
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => self.is_stable_local(slot, ty),
            _ => false,
        }
    }

    fun is_stable_local(self, slot: u64, ty: u64) -> bool {
        word := self.word(ty)
        when !is_integer_word(word.clone()) && word != "Bool" && word != "Char" {
            return false
        }
        when self.frame_slot(slot).is_none() {
            return false
        }
        return self.inline_active || (slot < self.def_addressed.len() && !self.def_addressed[slot])
    }

    // Reads a stable operand into `reg`.
    fun load_stable_operand(mut self, asm: &mut x64::Asm, index: u64, reg: u64) {
        constant := self.const_value(index)
        when constant.is_some() {
            asm.mov_ri(reg, constant.unwrap())
            return
        }
        slot := choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => slot,
            _ => 0,
        }
        ty := choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => ty,
            _ => 0,
        }
        self.note_expression(index)
        register := self.reg_of(self.frame_slot(slot).unwrap())
        when register != 0 {
            asm.mov_rr(reg, register)
            return
        }
        asm.load(self.value_width(ty), is_signed_word(self.word(ty)), reg, x64::Reg::RBP, slot_disp(self.frame_slot(slot).unwrap()))
    }

    fun binary(mut self, asm: &mut x64::Asm, op: String, left: u64, right: u64, ty: u64) -> bool {
        when (op == "Eq" || op == "Ne") && self.struct_of(ty).is_some() {
            return self.struct_equal(asm, op == "Ne", left, right, ty)
        }
        when self.is_float(ty) {
            return self.float_binary(asm, op, left, right, ty)
        }
        when (self.is_string(ty) || self.is_str(ty)) && (op == "Eq" || op == "Ne") {
            return self.text_equal(asm, op == "Ne", left, right, self.is_string(ty))
        }
        when self.is_raw_pointer(ty) && (op == "Eq" || op == "Ne") {
            when !self.expr(asm, left) {
                return false
            }
            asm.push(x64::Reg::RAX)
            when !self.expr(asm, right) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            asm.pop(x64::Reg::RAX)
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
            asm.setcc(comparison_condition(op, false), x64::Reg::RAX)
            return true
        }
        operand := self.word(ty)
        when width_of(operand.clone()) == 0 {
            return self.fail("an operator on this type")
        }
        when op == "And" || op == "Or" {
            return self.logical(asm, op == "And", left, right)
        }
        reduced := self.power_of_two(asm, op.clone(), left, right, operand.clone())
        when reduced.is_some() {
            return reduced.unwrap()
        }
        divided := self.constant_division(asm, op.clone(), left, right, operand.clone())
        when divided.is_some() {
            return divided.unwrap()
        }
        // A constant right operand that fits an immediate is part of the instruction.
        immediate := self.immediate_operand(op.clone(), right)
        when immediate.is_some() {
            // A local in a register times 3, 5 or 9, plus or minus a constant, is one `lea`.
            scaled := self.scaled_register(left)
            when scaled != 0 && (op == "Add" || op == "Sub") && (immediate.unwrap() as i64) > (0 as i64) - 2147483647 {
                mut offset := immediate.unwrap() as i64
                when op == "Sub" {
                    offset = (0 as i64) - offset
                }
                asm.lea_scaled(x64::Reg::RAX, scaled >> (8 as u32), scaled >> (8 as u32), scaled & 255, offset)
                self.normalize(asm, operand)
                return true
            }
            // A local in a register plus or minus a constant is one `lea`.
            left_register := self.operand_reg(left)
            when left_register != 0 && (op == "Add" || op == "Sub") && (immediate.unwrap() as i64) > (0 as i64) - 2147483647 {
                mut offset := immediate.unwrap() as i64
                when op == "Sub" {
                    offset = (0 as i64) - offset
                }
                asm.lea(x64::Reg::RAX, left_register, offset)
                self.normalize(asm, operand)
                return true
            }
            when !self.expr(asm, left) {
                return false
            }
            return self.binary_immediate(asm, op, immediate.unwrap(), operand)
        }
        // The register of the right operand: rcx, or the register of a local that lives in one.
        mut right_register: u64 = x64::Reg::RCX
        // A left operand that is a constant or a local nothing else can change is read after the right one is evaluated, so
        // that it need not be kept on the stack meanwhile.
        when self.is_stable_operand(left) && !self.is_stable_operand(right) {
            when !self.expr(asm, right) {
                return false
            }
            asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
            self.load_stable_operand(asm, left, x64::Reg::RAX)
        } else {
            when !self.expr(asm, left) {
                return false
            }
            // A right operand that is a constant or a local is read into rcx directly, without the push and pop; a local in
            // a register is the operand itself.
            when !self.is_stable_operand(right) {
                asm.push(x64::Reg::RAX)
                when !self.expr(asm, right) {
                    return false
                }
                // For an operator whose operands may swap, the left value is popped into rcx, and rax keeps the right.
                when op == "Add" || op == "Mul" || op == "BitAnd" || op == "BitOr" || op == "BitXor" || op == "Eq" || op == "Ne" {
                    asm.pop(x64::Reg::RCX)
                } else {
                    asm.mov_rr(x64::Reg::RCX, x64::Reg::RAX)
                    asm.pop(x64::Reg::RAX)
                }
            } else {
                register := self.operand_reg(right)
                when register != 0 && op != "Div" && op != "Rem" && op != "ShiftLeft" && op != "ShiftRight" {
                    right_register = register
                } else {
                    self.load_stable_operand(asm, right, x64::Reg::RCX)
                }
            }
        }
        when op == "Eq" || op == "Ne" || op == "Lt" || op == "Le" || op == "Gt" || op == "Ge" {
            asm.alu_rr(57, x64::Reg::RAX, right_register)
            asm.setcc(comparison_condition(op, is_signed_word(operand.clone())), x64::Reg::RAX)
            return true
        }
        when op == "Add" {
            asm.alu_rr(1, x64::Reg::RAX, right_register)
        } else when op == "Sub" {
            asm.alu_rr(41, x64::Reg::RAX, right_register)
        } else when op == "Mul" {
            asm.imul_rr(x64::Reg::RAX, right_register)
        } else when op == "BitAnd" {
            asm.alu_rr(33, x64::Reg::RAX, right_register)
        } else when op == "BitOr" {
            asm.alu_rr(9, x64::Reg::RAX, right_register)
        } else when op == "BitXor" {
            asm.alu_rr(49, x64::Reg::RAX, right_register)
        } else when op == "Div" || op == "Rem" {
            return self.division(asm, op == "Div", is_signed_word(operand.clone()), operand)
        } else when op == "ShiftLeft" || op == "ShiftRight" {
            return self.shift(asm, op == "ShiftLeft", is_signed_word(operand.clone()), operand)
        } else {
            return self.fail("an operator that is not in the subset")
        }
        self.normalize(asm, operand)
        return true
    }

    // The quotient or remainder of rax by rcx at a width. A zero divisor is a runtime error; for a signed type the least
    // value divided by -1 wraps to itself (its quotient is the least value, and its remainder 0), so the divisor is 1 then.
    fun division(mut self, asm: &mut x64::Asm, is_quotient: bool, signed: bool, word: String) -> bool {
        asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
        asm.jcc(x64::Cc::EQUAL, self.division_error_label)
        when signed {
            asm.mov_ri(x64::Reg::RDX, min_bits(word.clone()))
            unchanged := asm.new_label()
            asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDX)
            asm.jcc(x64::Cc::NOT_EQUAL, unchanged)
            asm.alu_ri(7, x64::Reg::RCX, (0 as i64) - 1)
            asm.jcc(x64::Cc::NOT_EQUAL, unchanged)
            asm.mov_ri(x64::Reg::RCX, 1)
            asm.bind(unchanged)
            asm.cqo()
            asm.unary(7, x64::Reg::RCX)
        } else {
            asm.alu_rr(49, x64::Reg::RDX, x64::Reg::RDX)
            asm.unary(6, x64::Reg::RCX)
        }
        when !is_quotient {
            asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
        }
        self.normalize(asm, word)
        return true
    }

    // A shift of rax by rcx at a width: a count below the width shifts the value; a count at or above it gives zero, or
    // all ones for a signed right shift of a negative value.
    fun shift(mut self, asm: &mut x64::Asm, is_left: bool, signed: bool, word: String) -> bool {
        bits := width_of(word.clone()) * 8
        out_of_range := asm.new_label()
        done := asm.new_label()
        asm.alu_ri(7, x64::Reg::RCX, bits as i64)
        asm.jcc(x64::Cc::ABOVE_EQUAL, out_of_range)
        when is_left {
            asm.shift_cl(4, x64::Reg::RAX)
        } else when signed {
            asm.shift_cl(7, x64::Reg::RAX)
        } else {
            asm.shift_cl(5, x64::Reg::RAX)
        }
        self.normalize(asm, word)
        asm.jmp(done)
        asm.bind(out_of_range)
        zero := asm.new_label()
        when !is_left && signed {
            asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
            asm.jcc(x64::Cc::GREATER_EQUAL, zero)
            asm.mov_ri(x64::Reg::RAX, 18446744073709551615)
            asm.jmp(done)
        }
        asm.bind(zero)
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.bind(done)
        return true
    }

    // `left && right` or `left || right`: the right side runs only when the left does not decide the result.
    // The data and length of a String or str value, in rsi and rdx: a literal or a local reads them directly, and any other
    // String is read through its header.
    fun text_parts(mut self, asm: &mut x64::Asm, index: u64, owned: bool) -> bool {
        when self.as_str_inner(index).is_some() {
            return self.text_parts(asm, self.as_str_inner(index).unwrap(), true)
        }
        when self.string_literal(index).is_some() || self.is_text_local(index) || !owned {
            return self.load_string_parts(asm, index)
        }
        when !self.expr(asm, index) {
            return false
        }
        asm.load(8, false, x64::Reg::RSI, x64::Reg::RAX, 0)
        asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, 8)
        return true
    }

    fun is_text_local(self, index: u64) -> bool {
        return choose self.program.exprs[index] {
            ir::IrExpr::LocalRef(slot, ty, span) => true,
            ir::IrExpr::MoveRef(slot, ty) => true,
            _ => false,
        }
    }

    // Equality of two Strings or two `str`s: the lengths are compared, and then the bytes, one at a time. `negate` gives
    // the inequality.
    fun text_equal(mut self, asm: &mut x64::Asm, negate: bool, left: u64, right: u64, owned: bool) -> bool {
        mut arguments: Vec<u64> = Vec()
        arguments.push(left)
        arguments.push(right)
        self.lend(arguments.clone(), 0)
        temps := self.borrowed_temporaries(arguments.clone(), 0)
        when !self.begin_temporaries(asm, temps.clone(), arguments.clone()) { return false }
        ok := self.text_equal_inner(asm, negate, left, right, owned)
        self.end_temporaries(asm, temps, arguments)
        return ok
    }

    fun text_equal_inner(mut self, asm: &mut x64::Asm, negate: bool, left: u64, right: u64, owned: bool) -> bool {
        when !self.text_parts(asm, left, owned) {
            return false
        }
        asm.push(x64::Reg::RSI)
        asm.push(x64::Reg::RDX)
        when !self.text_parts(asm, right, owned) {
            return false
        }
        asm.mov_rr(x64::Reg::RDI, x64::Reg::RSI)
        asm.mov_rr(x64::Reg::R8, x64::Reg::RDX)
        asm.pop(x64::Reg::R9)
        asm.pop(x64::Reg::R10)
        self.text_compare_registers(asm)
        when negate {
            asm.alu_ri(6, x64::Reg::RAX, 1)
        }
        return true
    }

    // Whether the text of R10 (length R9) equals the text of RDI (length R8): RAX is 1 when it does, else 0.
    fun text_compare_registers(self, asm: &mut x64::Asm) {
        end := asm.new_label()
        same := asm.new_label()
        looping := asm.new_label()
        asm.mov_ri(x64::Reg::RAX, 0)
        asm.alu_rr(57, x64::Reg::R9, x64::Reg::R8)
        asm.jcc(x64::Cc::NOT_EQUAL, end)
        asm.mov_ri(x64::Reg::R11, 0)
        asm.bind(looping)
        asm.alu_rr(57, x64::Reg::R11, x64::Reg::R9)
        asm.jcc(x64::Cc::ABOVE_EQUAL, same)
        asm.mov_rr(x64::Reg::RCX, x64::Reg::R10)
        asm.alu_rr(1, x64::Reg::RCX, x64::Reg::R11)
        asm.load(1, false, x64::Reg::RCX, x64::Reg::RCX, 0)
        asm.mov_rr(x64::Reg::RDX, x64::Reg::RDI)
        asm.alu_rr(1, x64::Reg::RDX, x64::Reg::R11)
        asm.load(1, false, x64::Reg::RDX, x64::Reg::RDX, 0)
        asm.alu_rr(57, x64::Reg::RCX, x64::Reg::RDX)
        asm.jcc(x64::Cc::NOT_EQUAL, end)
        asm.alu_ri(0, x64::Reg::R11, 1)
        asm.jmp(looping)
        asm.bind(same)
        asm.mov_ri(x64::Reg::RAX, 1)
        asm.bind(end)
    }

    fun logical(mut self, asm: &mut x64::Asm, is_and: bool, left: u64, right: u64) -> bool {
        when !self.expr(asm, left) {
            return false
        }
        end := asm.new_label()
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        when is_and {
            asm.jcc(x64::Cc::EQUAL, end)
        } else {
            asm.jcc(x64::Cc::NOT_EQUAL, end)
        }
        when !self.expr(asm, right) {
            return false
        }
        asm.bind(end)
        return true
    }

    fun negate(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        when self.is_float(ty) {
            when !self.expr(asm, value) {
                return false
            }
            // The sign is the top bit of the value's width.
            asm.mov_ri(x64::Reg::RCX, self.float_sign_bit(ty))
            asm.alu_rr(49, x64::Reg::RAX, x64::Reg::RCX)
            return true
        }
        operand := self.word(ty)
        when !is_integer_word(operand.clone()) {
            return self.fail("a negation of this type")
        }
        when !self.expr(asm, value) {
            return false
        }
        asm.unary(3, x64::Reg::RAX)
        self.normalize(asm, operand)
        return true
    }

    fun not(mut self, asm: &mut x64::Asm, value: u64) -> bool {
        when !self.expr(asm, value) {
            return false
        }
        asm.alu_ri(6, x64::Reg::RAX, 1)
        return true
    }

    fun bit_not(mut self, asm: &mut x64::Asm, value: u64, ty: u64) -> bool {
        operand := self.word(ty)
        when !is_integer_word(operand.clone()) {
            return self.fail("a bitwise not of this type")
        }
        when !self.expr(asm, value) {
            return false
        }
        asm.unary(2, x64::Reg::RAX)
        self.normalize(asm, operand)
        return true
    }

    // A conversion between integer types: the value is brought to the target's width and signedness.
    fun cast(mut self, asm: &mut x64::Asm, value: u64, source: u64, target: u64) -> bool {
        when self.is_float(target) {
            return self.float_cast(asm, value, source, target)
        }
        when self.is_float(source) {
            return self.float_to_integer(asm, value, source, target)
        }
        target_word := self.word(target)
        when is_integer_word(target_word.clone()) {
            when !self.expr(asm, value) {
                return false
            }
            self.normalize(asm, target_word)
            return true
        }
        // A raw pointer keeps the bits of its address, from an integer or from another pointer.
        when self.is_raw_pointer(target) {
            return self.expr(asm, value)
        }
        // A function pointer is the address of its entry point, so a pointer converts to it with the same bits.
        when choose self.program.types[target] {
            ir::IrTy::FunctionPointerTo(parameters, result, external) => true,
            _ => false,
        } {
            return self.expr(asm, value)
        }
        return self.fail("a conversion to this type")
    }

    fun is_repr_c_structure(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::StructTy(id) => self.program.structs[id].repr_c,
            _ => false,
        }
    }

    fun op_fail(mut self, what: str, op: String) -> bool {
        mut message := String(what)
        message.append(op)
        when !self.failed {
            self.failed = true
            self.reason = message
        }
        return false
    }

    fun is_raw_pointer(self, ty: u64) -> bool {
        return choose self.program.types[ty] {
            ir::IrTy::RawPointerTo(target) => true,
            _ => false,
        }
    }

    fun call_expression(mut self, asm: &mut x64::Asm, target: ir::CallTarget, arguments: Vec<u64>) -> bool {
        return choose target {
            ir::CallTarget::Func(id) => self.call(asm, id, arguments),
            ir::CallTarget::StringOp(op) => self.guarded_string(asm, op, arguments),
            ir::CallTarget::VecOp(op, ty) => self.guarded_vec(asm, op, ty, arguments, false),
            ir::CallTarget::SystemOp(op) => self.guarded_system(asm, op, arguments),
            ir::CallTarget::EnumNew(id, variant) => self.enum_new(asm, id, variant, arguments),
            ir::CallTarget::EnumPredicate(op, id) => self.guarded_predicate(asm, op, id, arguments),
            ir::CallTarget::EnumUnwrapOr(id, ty) => self.guarded_unwrap_or(asm, id, ty, arguments),
            ir::CallTarget::EnumUnwrap(id, ty, message, tag, failure) => self.guarded_unwrap(asm, id, ty, message, tag, failure, arguments),
            ir::CallTarget::MapOp(op, key, value) => self.guarded_map(asm, op, key, value, arguments),
            ir::CallTarget::SetOp(op, key, value) => self.guarded_map(asm, op, key, value, arguments),
            ir::CallTarget::IndirectFn(id) => self.indirect_call(asm, id, arguments),
            ir::CallTarget::ArgCount => self.arg_count(asm),
            ir::CallTarget::SliceLen => self.slice_len(asm, arguments),
            ir::CallTarget::Arg => self.argument(asm, arguments),
            ir::CallTarget::FilesystemOp(op) => self.filesystem(asm, op, arguments),
            ir::CallTarget::VecGetOption(element, option, pop) => self.vec_get_option(asm, element, option, pop, arguments),
            ir::CallTarget::TryRead(id) => self.fail("a call to the file reading builtin that gives an Option"),
            ir::CallTarget::ReadFileRes(id) => self.fail("a call to the file reading builtin that gives a Result"),
            ir::CallTarget::VecSlice(element) => self.fail("a vector slice outside a slice argument"),
            _ => self.fail("a builtin call"),
        }
    }

    fun if_expression(mut self, asm: &mut x64::Asm, condition: u64, then_value: u64, else_value: u64) -> bool {
        otherwise := asm.new_label()
        end := asm.new_label()
        when !self.branch(asm, condition, otherwise, false) {
            return false
        }
        when !self.expr(asm, then_value) {
            return false
        }
        asm.jmp(end)
        asm.bind(otherwise)
        when !self.expr(asm, else_value) {
            return false
        }
        asm.bind(end)
        return true
    }

    // The object of the program: `_start`, the runtime and the functions, and the string literals as local symbols.
    fun object(self, asm: &mut x64::Asm, start_size: u64) -> elf::ObjectInput {
        mut sizes: Vec<u64> = Vec()
        mut position: u64 = 0
        while position < self.symbol_sizes.len() {
            when position == 0 {
                sizes.push(start_size)
            } else {
                sizes.push(self.symbol_sizes[position])
            }
            position += 1
        }
        // The functions that were generated get local symbols, `ryn_function_<index>`, so a debugger can name them.
        mut names: Vec<String> = self.symbol_names.clone()
        mut sections: Vec<u64> = self.symbol_sections.clone()
        mut values: Vec<u64> = self.symbol_values.clone()
        mut globals: Vec<bool> = self.symbol_global.clone()
        mut function: u64 = 0
        while function < self.labels.len() {
            when self.needed[function] && self.program.functions[function].external_symbol.is_none() {
                mut name := String("ryn_function_")
                name.append(String(function))
                names.push(name)
                sections.push(elf::Where::TEXT)
                values.push(asm.label_offsets[self.labels[function]])
                sizes.push(0)
                globals.push(false)
            }
            function += 1
        }
        return elf::ObjectInput {
            text: asm.code.clone(),
            rodata: self.rodata.clone(),
            bss_size: self.profile_offset() + self.profile_size(),
            symbol_names: names,
            symbol_sections: sections,
            symbol_values: values,
            symbol_sizes: sizes,
            symbol_global: globals,
            reloc_offsets: asm.reloc_offsets.clone(),
            reloc_symbols: asm.reloc_symbols.clone(),
            reloc_kinds: asm.reloc_kinds.clone(),
            reloc_addends: asm.reloc_addends.clone(),
        }
    }
}

// Profile-guided code layout. A profile is text, one line per function, `count<TAB>name`, as the instrumented program
// writes it at exit. It changes only the order in which the functions are generated: a line that does not read, or a
// function it does not name, leaves that function with no entries, so a damaged profile costs speed and nothing else.
extend Gen {
    // The offset of the entry counters in the zero-filled section: after the runtime state and the Windows state.
    fun profile_offset(self) -> u64 {
        return 16 + rt::state_size() + 16 + self.windows_state_size() + self.stdout_state_size()
    }

    // The size of the entry counters: one u64 for each function of the program, when the program is instrumented.
    fun profile_size(self) -> u64 {
        when self.profiling {
            return 8 * self.program.functions.len()
        }
        return 0
    }

    // Adds one to the entry count of function `index`. Only R10 and R11 are used: a function may be entered with its
    // arguments in the other registers.
    fun count_entry(self, asm: &mut x64::Asm, index: u64) {
        asm.lea_symbol(x64::Reg::R10, self.profile_symbol)
        asm.load(8, false, x64::Reg::R11, x64::Reg::R10, (8 * index) as i64)
        asm.alu_ri(0, x64::Reg::R11, 1)
        asm.store(8, x64::Reg::R11, x64::Reg::R10, (8 * index) as i64)
    }

    // The order in which the functions are generated. Without a profile it is the program's order. With one, the functions
    // are grouped by the bit length of their entry count, the most entered first, and the functions the profile does not
    // show come last, each group in the program's order.
    fun generation_order(self, profile: String) -> Vec<u64> {
        mut order: Vec<u64> = Vec()
        mut position: u64 = 0
        when profile.is_empty() {
            while position < self.program.functions.len() {
                order.push(position)
                position += 1
            }
            return order
        }
        classes := self.profile_classes(profile)
        mut level: u64 = 65
        while level > 0 {
            level -= 1
            position = 0
            while position < classes.len() {
                when classes[position] == level {
                    order.push(position)
                }
                position += 1
            }
        }
        return order
    }

    // The class of each function: the bit length of its entry count in the profile, so 0 for a function it does not show.
    fun profile_classes(self, profile: String) -> Vec<u64> {
        mut counts: Map<String, u64> = Map<String, u64>()
        // Every line ends with a newline, so the last one is read like the others.
        mut text := profile.clone()
        text.push(char_from_u32(10))
        mut line_start: u64 = 0
        mut at: u64 = 0
        while at < text.len() {
            when text.byte_at(at) == 10 {
                line := text.slice(line_start, at)
                mut tab: u64 = 0
                while tab < line.len() {
                    when line.byte_at(tab) == 9 {
                        break
                    }
                    tab += 1
                }
                when tab > 0 && tab < line.len() {
                    mut value: u64 = 0
                    mut valid := true
                    mut digit_at: u64 = 0
                    while digit_at < tab {
                        digit := line.byte_at(digit_at) as u64
                        when digit < 48 || digit > 57 {
                            valid = false
                            break
                        }
                        value = value * 10 + (digit - 48)
                        digit_at += 1
                    }
                    when valid {
                        counts.insert(line.slice(tab + 1, line.len()), value)
                    }
                }
                line_start = at + 1
            }
            at += 1
        }
        mut classes: Vec<u64> = Vec()
        mut position: u64 = 0
        while position < self.program.functions.len() {
            name := self.function_name(position)
            mut bits: u64 = 0
            when counts.contains_key(name.clone()) {
                mut shifted := counts.get(name).unwrap()
                while shifted > 0 {
                    shifted = shifted / 2
                    bits += 1
                }
            }
            classes.push(bits)
            position += 1
        }
        return classes
    }

    // The routine that writes the counters when the program exits, registered with `__cxa_atexit`: the file at `path` is opened for
    // writing and each function gets a line, `count<TAB>name`, with `fprintf`. It is unrolled, one call for each function
    // of the program, since a call's arguments are constants and the counter of each function is at a known place.
    fun emit_profile_dump(mut self, asm: &mut x64::Asm, path: String) {
        fopen := self.foreign_symbol(String("fopen"))
        fprintf := self.foreign_symbol(String("fprintf"))
        fclose := self.foreign_symbol(String("fclose"))
        mut path_text := path
        path_text.push(char_from_u32(0))
        path_literal := self.literal(path_text)
        path_symbol := self.literal_symbols[path_literal]
        mode_literal := self.literal(profile_c_text(String("w")))
        mode_symbol := self.literal_symbols[mode_literal]
        mut template := String("%llu")
        template.push(char_from_u32(9))
        template.append(String("%s"))
        template.push(char_from_u32(10))
        format_literal := self.literal(profile_c_text(template))
        format_symbol := self.literal_symbols[format_literal]
        done := asm.new_label()
        // The stack holds the file at -8 from the frame pointer; the frame keeps the stack aligned for the calls.
        asm.bind(self.profile_dump_label)
        asm.push(x64::Reg::RBP)
        asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
        asm.alu_ri(5, x64::Reg::RSP, 16)
        asm.lea_symbol(x64::Reg::RDI, path_symbol)
        asm.lea_symbol(x64::Reg::RSI, mode_symbol)
        asm.call_symbol(fopen)
        asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 8)
        asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
        asm.jcc(x64::Cc::EQUAL, done)
        mut position: u64 = 0
        while position < self.program.functions.len() {
            when self.program.functions[position].external_symbol.is_none() {
                name_literal := self.literal(profile_c_text(self.function_name(position)))
                name_symbol := self.literal_symbols[name_literal]
                asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
                asm.lea_symbol(x64::Reg::RSI, format_symbol)
                asm.lea_symbol(x64::Reg::RAX, self.profile_symbol)
                asm.load(8, false, x64::Reg::RDX, x64::Reg::RAX, (8 * position) as i64)
                asm.lea_symbol(x64::Reg::RCX, name_symbol)
                asm.mov_ri(x64::Reg::RAX, 0)
                asm.call_symbol(fprintf)
            }
            position += 1
        }
        asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
        asm.call_symbol(fclose)
        asm.bind(done)
        asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
        asm.pop(x64::Reg::RBP)
        asm.ret()
    }
}

// A C string: the text with its terminating zero.
fun profile_c_text(text: String) -> String {
    mut out := text
    out.push(char_from_u32(0))
    return out
}

// POSIX functions that have no counterpart in the Windows runtime yet: processes by `fork`, pipes, `poll`, threads and sockets.
fun windows_unavailable(name: String) -> bool {
    return name == "pipe" || name == "fork" || name == "execvp" || name == "waitpid" || name == "fcntl" || name == "dup2" || name == "kill" || name == "poll" || name == "pthread_create" || name == "pthread_join" || name == "pthread_detach" || name == "opendir" || name == "readdir" || name == "closedir" || name == "socket" || name == "bind" || name == "listen" || name == "accept" || name == "connect" || name == "setsockopt" || name == "send" || name == "recv" || name == "getaddrinfo" || name == "freeaddrinfo" || name == "inet_pton" || name == "inet_ntop" || name == "htons" || name == "sigaction" || name == "sigaltstack"
}

// The register of the argument at `index` in the Windows convention.
fun windows_argument_register(index: u64) -> u64 {
    when index == 0 {
        return x64::Reg::RCX
    }
    when index == 1 {
        return x64::Reg::RDX
    }
    when index == 2 {
        return x64::Reg::R8
    }
    return x64::Reg::R9
}

// The C functions that a Windows program makes through the emulated system calls: 1000 plus the call number, or 0.
fun windows_system_number(name: String) -> u64 {
    when name == "write" {
        return 1001
    }
    when name == "read" {
        return 1000
    }
    when name == "open" {
        return 1002
    }
    when name == "close" {
        return 1003
    }
    when name == "mkdir" {
        return 1083
    }
    when name == "rmdir" {
        return 1084
    }
    when name == "unlink" {
        return 1087
    }
    when name == "rename" {
        return 1082
    }
    when name == "chdir" {
        return 1080
    }
    when name == "getcwd" {
        return 1079
    }
    when name == "stat" {
        return 1004
    }
    when name == "lstat" {
        return 1006
    }
    return 0
}

// The import that a C function is called through in a Windows program.
fun windows_import_name(name: String) -> String {
    when name == "GetAsyncKeyState" {
        return String("user32!GetAsyncKeyState")
    }
    first := name.byte_at(0) as u64
    when first >= 65 && first <= 90 {
        mut kernel := String("kernel32!")
        kernel.append(name)
        return kernel
    }
    mut text := String("ucrtbase!")
    // `long` has 32 bits on Windows, so a 64-bit `labs` is `llabs`; some functions have an underscore there.
    when name == "labs" {
        text.append("llabs")
    } else when name == "time" {
        text.append("_time64")
    } else when name == "setenv" {
        text.append("_putenv_s")
    } else when name == "getcwd" || name == "chdir" || name == "rmdir" || name == "unlink" || name == "getpid" || name == "strdup" || name == "isatty" || name == "dup" || name == "dup2" || name == "fileno" {
        text.append("_")
        text.append(name)
    } else {
        text.append(name)
    }
    return text
}

// The least value of a signed type, as the 64-bit pattern of its sign-extended value.
fun min_bits(word: String) -> u64 {
    when word == "I8" { return (0 as u64) - 128 }
    when word == "I16" { return (0 as u64) - 32768 }
    when word == "I32" { return (0 as u64) - 2147483648 }
    return 9223372036854775808
}

// The condition code of a comparison, for signed or unsigned operands.
// The condition code that is true exactly when `condition_code` is false: the codes come in pairs that differ in bit 0.
fun inverse_condition(condition_code: u64) -> u64 {
    when condition_code % 2 == 0 {
        return condition_code + 1
    }
    return condition_code - 1
}

fun comparison_condition(op: String, signed: bool) -> u64 {
    when op == "Eq" {
        return x64::Cc::EQUAL
    }
    when op == "Ne" {
        return x64::Cc::NOT_EQUAL
    }
    when op == "Lt" {
        when signed { return x64::Cc::LESS }
        return x64::Cc::BELOW
    }
    when op == "Le" {
        when signed { return x64::Cc::LESS_EQUAL }
        return x64::Cc::BELOW_EQUAL
    }
    when op == "Gt" {
        when signed { return x64::Cc::GREATER }
        return x64::Cc::ABOVE
    }
    when signed { return x64::Cc::GREATER_EQUAL }
    return x64::Cc::ABOVE_EQUAL
}
