// The freestanding runtime of the native backend: the few C library functions that generated code calls, written as machine
// code in the object itself, so that a program that calls no other C function needs no C library and no `cc`. They keep the C
// calling convention (arguments in rdi, rsi, rdx, rcx; the result in rax), and use Linux system calls only.
//
// Memory comes from `mmap` in chunks of at least a megabyte. A block has a 16-byte header holding its size class, and sizes are
// rounded up to a power of two (16 bytes and up); `free` puts a block on the list of its class, which `malloc` takes first.
//
// The state is in the zero-filled section, at `state`: 0 the next free byte of the chunk, 8 the end of the chunk, 16 `errno`,
// and from 32 the list heads, one per class.

use back::x64

// The labels of the routines, and the symbol of the state.
#[derive(Clone)]
pub struct Labels {
    pub malloc: u64,
    pub free: u64,
    pub realloc: u64,
    pub calloc: u64,
    pub memcpy: u64,
    pub memmove: u64,
    pub strlen: u64,
    pub fopen: u64,
    pub fseek: u64,
    pub ftell: u64,
    pub fread: u64,
    pub fwrite: u64,
    pub fclose: u64,
    pub strerror: u64,
    pub errno_location: u64,
    pub putchar: u64,
    pub chmod: u64,
    pub sigreturn: u64,
    pub live_allocations: u64,
    pub live_bytes: u64,
    pub state: u64,
}

// The size in bytes of the state.
pub fun state_size() -> u64 {
    return 48 + 64 * 8
}


// The offset of the list head of the class in rcx, added to the state address in r11 and left in r8: the head is at [r8 + 32].
fun list_head(asm: &mut x64::Asm) {
    asm.mov_rr(x64::Reg::R8, x64::Reg::RCX)
    asm.alu_rr(1, x64::Reg::R8, x64::Reg::R8)
    asm.alu_rr(1, x64::Reg::R8, x64::Reg::R8)
    asm.alu_rr(1, x64::Reg::R8, x64::Reg::R8)
    asm.alu_rr(1, x64::Reg::R8, x64::Reg::R11)
}

// Writes every routine. `messages` pairs an `errno` value with the symbol of its zero-terminated text for `strerror`, and
// `unknown` is the symbol of the text for the others.
pub fun emit(asm: &mut x64::Asm, labels: &Labels, error_numbers: Vec<u64>, error_texts: Vec<u64>, unknown: u64) {
    // malloc(rdi = size) -> rax
    asm.bind(labels.malloc)
    asm.mov_ri(x64::Reg::RAX, 16)
    asm.mov_ri(x64::Reg::RCX, 0)
    grow_class := asm.new_label()
    have_class := asm.new_label()
    asm.bind(grow_class)
    asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RDI)
    asm.jcc(x64::Cc::ABOVE_EQUAL, have_class)
    asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RAX)
    asm.alu_ri(0, x64::Reg::RCX, 1)
    asm.jmp(grow_class)
    asm.bind(have_class)
    dedicated := asm.new_label()
    asm.alu_ri(7, x64::Reg::RAX, 1048576)
    asm.jcc(x64::Cc::ABOVE_EQUAL, dedicated)
    asm.lea_symbol(x64::Reg::R11, labels.state)
    list_head(asm)
    reuse := asm.new_label()
    bump := asm.new_label()
    asm.load(8, false, x64::Reg::RDX, x64::Reg::R8, 32)
    asm.test_rr(x64::Reg::RDX, x64::Reg::RDX)
    asm.jcc(x64::Cc::EQUAL, bump)
    asm.bind(reuse)
    asm.load(8, false, x64::Reg::R9, x64::Reg::RDX, 0)
    asm.store(8, x64::Reg::R9, x64::Reg::R8, 32)
    asm.mov_ri(x64::Reg::R9, 1)
    asm.store(8, x64::Reg::R9, x64::Reg::RDX, (0 as i64) - 8)
    account_allocation(asm)
    asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
    asm.ret()
    // rax is the size of the block, rcx its class, r11 the state.
    asm.bind(bump)
    asm.lea(x64::Reg::R9, x64::Reg::RAX, 16)
    retry := asm.new_label()
    asm.bind(retry)
    asm.load(8, false, x64::Reg::R10, x64::Reg::R11, 0)
    asm.mov_rr(x64::Reg::RDX, x64::Reg::R10)
    asm.alu_rr(1, x64::Reg::RDX, x64::Reg::R9)
    asm.load(8, false, x64::Reg::RSI, x64::Reg::R11, 8)
    out_of_chunk := asm.new_label()
    asm.alu_rr(57, x64::Reg::RDX, x64::Reg::RSI)
    asm.jcc(x64::Cc::ABOVE, out_of_chunk)
    asm.store(8, x64::Reg::RDX, x64::Reg::R11, 0)
    asm.store(8, x64::Reg::RCX, x64::Reg::R10, 0)
    asm.mov_ri(x64::Reg::RSI, 1)
    asm.store(8, x64::Reg::RSI, x64::Reg::R10, 8)
    asm.lea(x64::Reg::RAX, x64::Reg::R9, (0 as i64) - 16)
    account_allocation(asm)
    asm.lea(x64::Reg::RAX, x64::Reg::R10, 16)
    asm.ret()
    // A new chunk: a megabyte, or the block's size rounded up to a page.
    asm.bind(out_of_chunk)
    asm.mov_ri(x64::Reg::RSI, 1048576)
    big := asm.new_label()
    sized := asm.new_label()
    asm.alu_rr(57, x64::Reg::R9, x64::Reg::RSI)
    asm.jcc(x64::Cc::BELOW_EQUAL, sized)
    asm.bind(big)
    asm.lea(x64::Reg::RSI, x64::Reg::R9, 4095)
    asm.alu_ri(4, x64::Reg::RSI, (0 as i64) - 4096)
    asm.bind(sized)
    asm.push(x64::Reg::RCX)
    asm.push(x64::Reg::R9)
    asm.push(x64::Reg::RSI)
    asm.mov_ri(x64::Reg::RAX, 9)
    asm.mov_ri(x64::Reg::RDI, 0)
    asm.mov_ri(x64::Reg::RDX, 3)
    asm.mov_ri(x64::Reg::R10, 34)
    asm.mov_ri(x64::Reg::R8, 0)
    asm.alu_ri(5, x64::Reg::R8, 1)
    asm.mov_ri(x64::Reg::R9, 0)
    asm.syscall()
    asm.pop(x64::Reg::RSI)
    asm.pop(x64::Reg::R9)
    asm.pop(x64::Reg::RCX)
    failed := asm.new_label()
    asm.alu_ri(7, x64::Reg::RAX, (0 as i64) - 4095)
    asm.jcc(x64::Cc::ABOVE_EQUAL, failed)
    asm.lea_symbol(x64::Reg::R11, labels.state)
    asm.store(8, x64::Reg::RAX, x64::Reg::R11, 0)
    asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RSI)
    asm.store(8, x64::Reg::RAX, x64::Reg::R11, 8)
    asm.jmp(retry)
    // Large blocks own their mapping, so free can return it directly to the operating system.
    asm.bind(dedicated)
    asm.push(x64::Reg::RCX)
    asm.push(x64::Reg::RAX)
    asm.lea(x64::Reg::RSI, x64::Reg::RAX, 4111)
    asm.alu_ri(4, x64::Reg::RSI, (0 as i64) - 4096)
    asm.mov_ri(x64::Reg::RDI, 0)
    asm.mov_ri(x64::Reg::RDX, 3)
    asm.mov_ri(x64::Reg::R10, 34)
    asm.mov_ri(x64::Reg::R8, 0)
    asm.alu_ri(5, x64::Reg::R8, 1)
    asm.mov_ri(x64::Reg::R9, 0)
    asm.mov_ri(x64::Reg::RAX, 9)
    asm.syscall()
    asm.pop(x64::Reg::RDX)
    asm.pop(x64::Reg::RCX)
    asm.alu_ri(7, x64::Reg::RAX, (0 as i64) - 4095)
    asm.jcc(x64::Cc::ABOVE_EQUAL, failed)
    asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
    asm.mov_ri(x64::Reg::R9, 2)
    asm.store(8, x64::Reg::R9, x64::Reg::RAX, 8)
    asm.mov_rr(x64::Reg::R10, x64::Reg::RAX)
    asm.mov_rr(x64::Reg::RAX, x64::Reg::RDX)
    asm.lea_symbol(x64::Reg::R11, labels.state)
    account_allocation(asm)
    asm.lea(x64::Reg::RAX, x64::Reg::R10, 16)
    asm.ret()
    asm.bind(failed)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.ret()

    // free(rdi = block)
    asm.bind(labels.free)
    free_done := asm.new_label()
    asm.test_rr(x64::Reg::RDI, x64::Reg::RDI)
    asm.jcc(x64::Cc::EQUAL, free_done)
    live := asm.new_label()
    asm.load(8, false, x64::Reg::R9, x64::Reg::RDI, (0 as i64) - 8)
    asm.test_rr(x64::Reg::R9, x64::Reg::R9)
    asm.jcc(x64::Cc::NOT_EQUAL, live)
    asm.trap()
    asm.bind(live)
    unmap := asm.new_label()
    asm.alu_ri(7, x64::Reg::R9, 2)
    asm.jcc(x64::Cc::EQUAL, unmap)
    asm.mov_ri(x64::Reg::R9, 0)
    asm.store(8, x64::Reg::R9, x64::Reg::RDI, (0 as i64) - 8)
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, (0 as i64) - 16)
    asm.lea_symbol(x64::Reg::R11, labels.state)
    asm.mov_ri(x64::Reg::R9, 16)
    asm.shift_cl(4, x64::Reg::R9)
    asm.load(8, false, x64::Reg::R8, x64::Reg::R11, 544)
    asm.alu_ri(5, x64::Reg::R8, 1)
    asm.store(8, x64::Reg::R8, x64::Reg::R11, 544)
    asm.load(8, false, x64::Reg::R8, x64::Reg::R11, 552)
    asm.alu_rr(41, x64::Reg::R8, x64::Reg::R9)
    asm.store(8, x64::Reg::R8, x64::Reg::R11, 552)
    list_head(asm)
    asm.load(8, false, x64::Reg::RDX, x64::Reg::R8, 32)
    asm.store(8, x64::Reg::RDX, x64::Reg::RDI, 0)
    asm.store(8, x64::Reg::RDI, x64::Reg::R8, 32)
    asm.bind(free_done)
    asm.ret()

    asm.bind(unmap)
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, (0 as i64) - 16)
    asm.mov_ri(x64::Reg::R9, 16)
    asm.shift_cl(4, x64::Reg::R9)
    asm.lea_symbol(x64::Reg::R11, labels.state)
    asm.load(8, false, x64::Reg::R8, x64::Reg::R11, 544)
    asm.alu_ri(5, x64::Reg::R8, 1)
    asm.store(8, x64::Reg::R8, x64::Reg::R11, 544)
    asm.load(8, false, x64::Reg::R8, x64::Reg::R11, 552)
    asm.alu_rr(41, x64::Reg::R8, x64::Reg::R9)
    asm.store(8, x64::Reg::R8, x64::Reg::R11, 552)
    asm.lea(x64::Reg::RSI, x64::Reg::R9, 4111)
    asm.alu_ri(4, x64::Reg::RSI, (0 as i64) - 4096)
    asm.alu_ri(5, x64::Reg::RDI, 16)
    asm.mov_ri(x64::Reg::RAX, 11)
    asm.syscall()
    asm.ret()

    asm.bind(labels.live_allocations)
    asm.lea_symbol(x64::Reg::RAX, labels.state)
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 544)
    asm.ret()
    asm.bind(labels.live_bytes)
    asm.lea_symbol(x64::Reg::RAX, labels.state)
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RAX, 552)
    asm.ret()

    // memcpy(rdi = target, rsi = source, rdx = count) -> target, and memmove: the same routine. Blocks of 64 bytes go through
    // four xmm registers (all four are loaded before any is stored, so a copy over itself in the right direction is safe),
    // then 16, 8 and 1 bytes. It runs upward when the target is below the source and downward otherwise. (`rep movsb` is
    // slow on overlapping blocks, and the shifts of `insert` and `take` are that.)
    asm.bind(labels.memcpy)
    asm.bind(labels.memmove)
    asm.mov_rr(x64::Reg::RAX, x64::Reg::RDI)
    asm.mov_rr(x64::Reg::RCX, x64::Reg::RDX)
    descending := asm.new_label()
    asm.alu_rr(57, x64::Reg::RDI, x64::Reg::RSI)
    asm.jcc(x64::Cc::ABOVE, descending)
    big_up := asm.new_label()
    mid_up := asm.new_label()
    word_up := asm.new_label()
    byte_up := asm.new_label()
    up_done := asm.new_label()
    asm.bind(big_up)
    asm.alu_ri(7, x64::Reg::RCX, 64)
    asm.jcc(x64::Cc::BELOW, mid_up)
    asm.movdqu_load(0, x64::Reg::RSI, 0)
    asm.movdqu_load(1, x64::Reg::RSI, 16)
    asm.movdqu_load(2, x64::Reg::RSI, 32)
    asm.movdqu_load(3, x64::Reg::RSI, 48)
    asm.movdqu_store(0, x64::Reg::RDI, 0)
    asm.movdqu_store(1, x64::Reg::RDI, 16)
    asm.movdqu_store(2, x64::Reg::RDI, 32)
    asm.movdqu_store(3, x64::Reg::RDI, 48)
    asm.alu_ri(0, x64::Reg::RSI, 64)
    asm.alu_ri(0, x64::Reg::RDI, 64)
    asm.alu_ri(5, x64::Reg::RCX, 64)
    asm.jmp(big_up)
    asm.bind(mid_up)
    asm.alu_ri(7, x64::Reg::RCX, 16)
    asm.jcc(x64::Cc::BELOW, word_up)
    asm.movdqu_load(0, x64::Reg::RSI, 0)
    asm.movdqu_store(0, x64::Reg::RDI, 0)
    asm.alu_ri(0, x64::Reg::RSI, 16)
    asm.alu_ri(0, x64::Reg::RDI, 16)
    asm.alu_ri(5, x64::Reg::RCX, 16)
    asm.jmp(mid_up)
    asm.bind(word_up)
    asm.alu_ri(7, x64::Reg::RCX, 8)
    asm.jcc(x64::Cc::BELOW, byte_up)
    asm.load(8, false, x64::Reg::R8, x64::Reg::RSI, 0)
    asm.store(8, x64::Reg::R8, x64::Reg::RDI, 0)
    asm.alu_ri(0, x64::Reg::RSI, 8)
    asm.alu_ri(0, x64::Reg::RDI, 8)
    asm.alu_ri(5, x64::Reg::RCX, 8)
    asm.bind(byte_up)
    asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
    asm.jcc(x64::Cc::EQUAL, up_done)
    asm.load(1, false, x64::Reg::R8, x64::Reg::RSI, 0)
    asm.store(1, x64::Reg::R8, x64::Reg::RDI, 0)
    asm.alu_ri(0, x64::Reg::RSI, 1)
    asm.alu_ri(0, x64::Reg::RDI, 1)
    asm.alu_ri(5, x64::Reg::RCX, 1)
    asm.jmp(byte_up)
    asm.bind(up_done)
    asm.ret()
    big_down := asm.new_label()
    mid_down := asm.new_label()
    word_down := asm.new_label()
    byte_down := asm.new_label()
    down_done := asm.new_label()
    asm.bind(descending)
    asm.alu_rr(1, x64::Reg::RDI, x64::Reg::RCX)
    asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
    asm.bind(big_down)
    asm.alu_ri(7, x64::Reg::RCX, 64)
    asm.jcc(x64::Cc::BELOW, mid_down)
    asm.alu_ri(5, x64::Reg::RSI, 64)
    asm.alu_ri(5, x64::Reg::RDI, 64)
    asm.movdqu_load(0, x64::Reg::RSI, 0)
    asm.movdqu_load(1, x64::Reg::RSI, 16)
    asm.movdqu_load(2, x64::Reg::RSI, 32)
    asm.movdqu_load(3, x64::Reg::RSI, 48)
    asm.movdqu_store(0, x64::Reg::RDI, 0)
    asm.movdqu_store(1, x64::Reg::RDI, 16)
    asm.movdqu_store(2, x64::Reg::RDI, 32)
    asm.movdqu_store(3, x64::Reg::RDI, 48)
    asm.alu_ri(5, x64::Reg::RCX, 64)
    asm.jmp(big_down)
    asm.bind(mid_down)
    asm.alu_ri(7, x64::Reg::RCX, 16)
    asm.jcc(x64::Cc::BELOW, word_down)
    asm.alu_ri(5, x64::Reg::RSI, 16)
    asm.alu_ri(5, x64::Reg::RDI, 16)
    asm.movdqu_load(0, x64::Reg::RSI, 0)
    asm.movdqu_store(0, x64::Reg::RDI, 0)
    asm.alu_ri(5, x64::Reg::RCX, 16)
    asm.jmp(mid_down)
    asm.bind(word_down)
    asm.alu_ri(7, x64::Reg::RCX, 8)
    asm.jcc(x64::Cc::BELOW, byte_down)
    asm.alu_ri(5, x64::Reg::RSI, 8)
    asm.alu_ri(5, x64::Reg::RDI, 8)
    asm.load(8, false, x64::Reg::R8, x64::Reg::RSI, 0)
    asm.store(8, x64::Reg::R8, x64::Reg::RDI, 0)
    asm.alu_ri(5, x64::Reg::RCX, 8)
    asm.bind(byte_down)
    asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
    asm.jcc(x64::Cc::EQUAL, down_done)
    asm.alu_ri(5, x64::Reg::RSI, 1)
    asm.alu_ri(5, x64::Reg::RDI, 1)
    asm.load(1, false, x64::Reg::R8, x64::Reg::RSI, 0)
    asm.store(1, x64::Reg::R8, x64::Reg::RDI, 0)
    asm.alu_ri(5, x64::Reg::RCX, 1)
    asm.jmp(byte_down)
    asm.bind(down_done)
    asm.ret()

    // strlen(rdi = text) -> length
    asm.bind(labels.strlen)
    asm.mov_rr(x64::Reg::RAX, x64::Reg::RDI)
    scan := asm.new_label()
    scanned := asm.new_label()
    asm.bind(scan)
    asm.load(1, false, x64::Reg::RCX, x64::Reg::RAX, 0)
    asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
    asm.jcc(x64::Cc::EQUAL, scanned)
    asm.alu_ri(0, x64::Reg::RAX, 1)
    asm.jmp(scan)
    asm.bind(scanned)
    asm.alu_rr(41, x64::Reg::RAX, x64::Reg::RDI)
    asm.ret()

    // calloc(rdi = count, rsi = size)
    asm.bind(labels.calloc)
    asm.imul_rr(x64::Reg::RDI, x64::Reg::RSI)
    asm.push(x64::Reg::RDI)
    asm.call_label(labels.malloc)
    asm.pop(x64::Reg::RCX)
    calloc_done := asm.new_label()
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, calloc_done)
    asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
    asm.mov_rr(x64::Reg::R8, x64::Reg::RAX)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.rep_stosb()
    asm.mov_rr(x64::Reg::RAX, x64::Reg::R8)
    asm.bind(calloc_done)
    asm.ret()

    // realloc(rdi = block, rsi = size): the same block when its class is large enough, else a new block and a copy.
    asm.bind(labels.realloc)
    have_block := asm.new_label()
    asm.test_rr(x64::Reg::RDI, x64::Reg::RDI)
    asm.jcc(x64::Cc::NOT_EQUAL, have_block)
    asm.mov_rr(x64::Reg::RDI, x64::Reg::RSI)
    asm.jmp(labels.malloc)
    asm.bind(have_block)
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RDI, (0 as i64) - 16)
    asm.mov_ri(x64::Reg::RAX, 16)
    asm.shift_cl(4, x64::Reg::RAX)
    fits := asm.new_label()
    asm.alu_rr(57, x64::Reg::RSI, x64::Reg::RAX)
    asm.jcc(x64::Cc::BELOW_EQUAL, fits)
    asm.push(x64::Reg::RDI)
    asm.push(x64::Reg::RAX)
    asm.mov_rr(x64::Reg::RDI, x64::Reg::RSI)
    asm.call_label(labels.malloc)
    asm.pop(x64::Reg::RDX)
    asm.pop(x64::Reg::RSI)
    no_memory := asm.new_label()
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, no_memory)
    asm.push(x64::Reg::RAX)
    asm.push(x64::Reg::RSI)
    asm.mov_rr(x64::Reg::RDI, x64::Reg::RAX)
    asm.call_label(labels.memcpy)
    asm.pop(x64::Reg::RDI)
    asm.call_label(labels.free)
    asm.pop(x64::Reg::RAX)
    asm.bind(no_memory)
    asm.ret()
    asm.bind(fits)
    asm.mov_rr(x64::Reg::RAX, x64::Reg::RDI)
    asm.ret()

    // __errno_location() -> the address of errno
    asm.bind(labels.errno_location)
    asm.lea_symbol(x64::Reg::RAX, labels.state)
    asm.alu_ri(0, x64::Reg::RAX, 16)
    asm.ret()

    // A failed system call leaves -errno in rax: it is stored in errno, and the call gives `failure` (in rdx on entry).
    // fopen(rdi = path, rsi = mode) -> a handle (a block holding the descriptor), or 0.
    asm.bind(labels.fopen)
    asm.load(1, false, x64::Reg::RCX, x64::Reg::RSI, 0)
    asm.mov_ri(x64::Reg::RSI, 0)
    not_write := asm.new_label()
    not_append := asm.new_label()
    opened := asm.new_label()
    asm.alu_ri(7, x64::Reg::RCX, 119)
    asm.jcc(x64::Cc::NOT_EQUAL, not_write)
    asm.mov_ri(x64::Reg::RSI, 577)
    asm.jmp(opened)
    asm.bind(not_write)
    asm.alu_ri(7, x64::Reg::RCX, 97)
    asm.jcc(x64::Cc::NOT_EQUAL, not_append)
    asm.mov_ri(x64::Reg::RSI, 1089)
    asm.bind(not_append)
    asm.bind(opened)
    asm.mov_ri(x64::Reg::RAX, 2)
    asm.mov_ri(x64::Reg::RDX, 420)
    asm.syscall()
    open_failed := asm.new_label()
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::LESS, open_failed)
    asm.push(x64::Reg::RAX)
    asm.mov_ri(x64::Reg::RDI, 8)
    asm.call_label(labels.malloc)
    asm.pop(x64::Reg::RCX)
    asm.store(8, x64::Reg::RCX, x64::Reg::RAX, 0)
    asm.ret()
    asm.bind(open_failed)
    asm.unary(3, x64::Reg::RAX)
    asm.lea_symbol(x64::Reg::R11, labels.state)
    asm.store(8, x64::Reg::RAX, x64::Reg::R11, 16)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.ret()

    // fseek(rdi = handle, rsi = offset, rdx = whence) -> 0, or -1; ftell(rdi = handle) -> the position
    asm.bind(labels.fseek)
    asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 0)
    asm.mov_ri(x64::Reg::RAX, 8)
    asm.syscall()
    seek_failed := asm.new_label()
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::LESS, seek_failed)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.ret()
    asm.bind(seek_failed)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.alu_ri(5, x64::Reg::RAX, 1)
    asm.ret()
    asm.bind(labels.ftell)
    asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 0)
    asm.mov_ri(x64::Reg::RSI, 0)
    asm.mov_ri(x64::Reg::RDX, 1)
    asm.mov_ri(x64::Reg::RAX, 8)
    asm.syscall()
    asm.ret()

    // fread(rdi = buffer, rsi = size, rdx = count, rcx = handle) and fwrite with the same arguments: the transfer repeats
    // until all bytes are moved or the call gives nothing; the result is the number of whole items.
    transfer(asm, labels.fread, 0)
    transfer(asm, labels.fwrite, 1)

    // fclose(rdi = handle)
    asm.bind(labels.fclose)
    asm.push(x64::Reg::RDI)
    asm.load(8, false, x64::Reg::RDI, x64::Reg::RDI, 0)
    asm.mov_ri(x64::Reg::RAX, 3)
    asm.syscall()
    asm.pop(x64::Reg::RDI)
    asm.call_label(labels.free)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.ret()

    // putchar(rdi = character) -> the character
    asm.bind(labels.putchar)
    asm.push(x64::Reg::RDI)
    asm.mov_rr(x64::Reg::RSI, x64::Reg::RSP)
    asm.mov_ri(x64::Reg::RDX, 1)
    asm.mov_ri(x64::Reg::RDI, 1)
    asm.mov_ri(x64::Reg::RAX, 1)
    asm.syscall()
    asm.pop(x64::Reg::RAX)
    asm.ret()

    // chmod(rdi = path, rsi = mode) -> 0, or -1
    asm.bind(labels.chmod)
    asm.mov_ri(x64::Reg::RAX, 90)
    asm.syscall()
    chmod_failed := asm.new_label()
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::LESS, chmod_failed)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.ret()
    asm.bind(chmod_failed)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.alu_ri(5, x64::Reg::RAX, 1)
    asm.ret()

    // strerror(rdi = errno) -> the text
    asm.bind(labels.strerror)
    mut at: u64 = 0
    while at < error_numbers.len() {
        next := asm.new_label()
        asm.alu_ri(7, x64::Reg::RDI, error_numbers[at] as i64)
        asm.jcc(x64::Cc::NOT_EQUAL, next)
        asm.lea_symbol(x64::Reg::RAX, error_texts[at])
        asm.ret()
        asm.bind(next)
        at += 1
    }
    asm.lea_symbol(x64::Reg::RAX, unknown)
    asm.ret()

    // The return stub for signal handlers: `rt_sigreturn`.
    asm.bind(labels.sigreturn)
    asm.mov_ri(x64::Reg::RAX, 15)
    asm.syscall()
}

// A `read` (kind 0) or `write` (kind 1) of size * count bytes at the label.
fun transfer(asm: &mut x64::Asm, label: u64, kind: u64) {
    asm.bind(label)
    asm.push(x64::Reg::RBP)
    asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
    // Locals: the buffer, the total, the descriptor, the bytes done, and the item size.
    asm.alu_ri(5, x64::Reg::RSP, 48)
    asm.store(8, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 8)
    asm.store(8, x64::Reg::RSI, x64::Reg::RBP, (0 as i64) - 40)
    asm.imul_rr(x64::Reg::RDX, x64::Reg::RSI)
    asm.store(8, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 16)
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RCX, 0)
    asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 24)
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.store(8, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
    again := asm.new_label()
    finished := asm.new_label()
    asm.bind(again)
    asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, (0 as i64) - 16)
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
    asm.alu_rr(41, x64::Reg::RDX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, finished)
    asm.load(8, false, x64::Reg::RSI, x64::Reg::RBP, (0 as i64) - 8)
    asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RAX)
    asm.load(8, false, x64::Reg::RDI, x64::Reg::RBP, (0 as i64) - 24)
    asm.mov_ri(x64::Reg::RAX, kind)
    asm.syscall()
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::LESS_EQUAL, finished)
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 32)
    asm.alu_rr(1, x64::Reg::RCX, x64::Reg::RAX)
    asm.store(8, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 32)
    asm.jmp(again)
    asm.bind(finished)
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, (0 as i64) - 32)
    asm.mov_ri(x64::Reg::RDX, 0)
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, (0 as i64) - 40)
    skip := asm.new_label()
    asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
    asm.jcc(x64::Cc::EQUAL, skip)
    asm.unary(6, x64::Reg::RCX)
    asm.bind(skip)
    asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
    asm.pop(x64::Reg::RBP)
    asm.ret()
}

// Successful allocations account for their rounded payload size; the header is excluded.
fun account_allocation(asm: &mut x64::Asm) {
    asm.load(8, false, x64::Reg::R8, x64::Reg::R11, 544)
    asm.alu_ri(0, x64::Reg::R8, 1)
    asm.store(8, x64::Reg::R8, x64::Reg::R11, 544)
    asm.load(8, false, x64::Reg::R8, x64::Reg::R11, 552)
    asm.alu_rr(1, x64::Reg::R8, x64::Reg::RAX)
    asm.store(8, x64::Reg::R8, x64::Reg::R11, 552)
}
