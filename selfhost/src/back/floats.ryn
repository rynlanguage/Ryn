// Float text for the native backend. `emit_float_format` writes one runtime routine that turns a float into the text
// that Rust's `Display` gives it: the shortest digits that read back as the same value, without an exponent, `NaN`,
// `inf` and `-inf`, and `-0` for a negative zero.
//
// The digits come from the C library: `snprintf("%.*e")` with a growing precision is parsed back by `strtod` (or
// `strtof` for a single-precision value) until the value is the same. That finds the shortest digit count, and the
// digits of the correctly rounded decimal of that length, which Rust's shortest printer also chooses.
//
// Registers on entry: rax the value's bits (the low 32 for a single), rcx the kind (0 double, 1 single), rdi a buffer of
// at least 400 bytes. On return rax is the length of the text written at rdi. Nothing else is preserved.

use back::x64

// The routine's frame, as distances below the frame pointer.
fun slot_out() -> i64 { return (0 as i64) - 8 }
fun slot_kind() -> i64 { return (0 as i64) - 16 }
fun slot_abs() -> i64 { return (0 as i64) - 24 }
fun slot_orig() -> i64 { return (0 as i64) - 32 }
fun slot_precision() -> i64 { return (0 as i64) - 40 }
fun slot_sign() -> i64 { return (0 as i64) - 48 }
fun slot_exponent() -> i64 { return (0 as i64) - 56 }
fun slot_digits() -> i64 { return (0 as i64) - 64 }
fun slot_format() -> i64 { return (0 as i64) - 72 }
fun slot_start() -> i64 { return (0 as i64) - 80 }
fun slot_text() -> i64 { return (0 as i64) - 144 }
fun slot_exact() -> i64 { return (0 as i64) - 976 }

// Appends the byte `value` to the output, whose position is in the frame. Clobbers rax and rdx.
fun put_byte(asm: &mut x64::Asm, value: u64) {
    asm.load(8, false, x64::Reg::RDX, x64::Reg::RBP, slot_out())
    asm.mov_ri(x64::Reg::RAX, value)
    asm.store(1, x64::Reg::RAX, x64::Reg::RDX, 0)
    asm.alu_ri(0, x64::Reg::RDX, 1)
    asm.store(8, x64::Reg::RDX, x64::Reg::RBP, slot_out())
}

// Writes the routine at `label`, calling the three C functions by their symbols.
// Formats the value at the current precision with the current rounding mode, then reads it back: jumps to `found` when
// the text gives the same value.
fun attempt_text(asm: &mut x64::Asm, snprintf: u64, strtod: u64, strtof: u64, found: u64) {
    asm.lea(x64::Reg::RDI, x64::Reg::RBP, slot_text())
    asm.mov_ri(x64::Reg::RSI, 64)
    asm.lea(x64::Reg::RDX, x64::Reg::RBP, slot_format())
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, slot_precision())
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_abs())
    asm.movq_to_xmm(true, 0, x64::Reg::RAX)
    asm.mov_ri(x64::Reg::RAX, 1)
    asm.call_aligned(snprintf)
    read_back(asm, strtod, strtof, found)
}

// Reads the text back with `strtod` (or `strtof` for a single) and jumps to `found` when it is the original magnitude.
fun read_back(asm: &mut x64::Asm, strtod: u64, strtof: u64, found: u64) {
    asm.lea(x64::Reg::RDI, x64::Reg::RBP, slot_text())
    asm.mov_ri(x64::Reg::RSI, 0)
    single := asm.new_label()
    compare := asm.new_label()
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, slot_kind())
    asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
    asm.jcc(x64::Cc::NOT_EQUAL, single)
    asm.call_aligned(strtod)
    asm.movq_from_xmm(true, x64::Reg::RAX, 0)
    asm.jmp(compare)
    asm.bind(single)
    asm.call_aligned(strtof)
    asm.movq_from_xmm(false, x64::Reg::RAX, 0)
    asm.bind(compare)
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, slot_orig())
    asm.alu_rr(57, x64::Reg::RAX, x64::Reg::RCX)
    asm.jcc(x64::Cc::EQUAL, found)
}

pub fun emit_float_format(asm: &mut x64::Asm, label: u64, snprintf: u64, strtod: u64, strtof: u64, fesetround: u64) {
    asm.bind(label)
    asm.push(x64::Reg::RBP)
    asm.mov_rr(x64::Reg::RBP, x64::Reg::RSP)
    asm.alu_ri(5, x64::Reg::RSP, 976)
    asm.store(8, x64::Reg::RDI, x64::Reg::RBP, slot_out())
    asm.store(8, x64::Reg::RDI, x64::Reg::RBP, slot_start())
    asm.store(8, x64::Reg::RCX, x64::Reg::RBP, slot_kind())
    // The format "%.*e" and its terminating zero, in the frame.
    asm.mov_ri(x64::Reg::R8, 0x652A2E25)
    asm.store(8, x64::Reg::R8, x64::Reg::RBP, slot_format())

    // The magnitude in its own precision (for comparing what `strtod` reads back), and the value as a double.
    double := asm.new_label()
    have_bits := asm.new_label()
    asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
    asm.jcc(x64::Cc::EQUAL, double)
    asm.mov_rr(x64::Reg::R8, x64::Reg::RAX)
    asm.zext_rr(x64::Reg::R8, x64::Reg::R8, 4)
    asm.mov_rr(x64::Reg::R9, x64::Reg::R8)
    asm.alu_ri(4, x64::Reg::R9, 2147483647)
    asm.store(8, x64::Reg::R9, x64::Reg::RBP, slot_orig())
    asm.movq_to_xmm(false, 0, x64::Reg::RAX)
    asm.cvt_precision(4, 0, 0)
    asm.movq_from_xmm(true, x64::Reg::RAX, 0)
    asm.jmp(have_bits)
    asm.bind(double)
    asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
    asm.mov_ri(x64::Reg::RCX, 1)
    asm.shift_cl(4, x64::Reg::R9)
    asm.shift_cl(5, x64::Reg::R9)
    asm.store(8, x64::Reg::R9, x64::Reg::RBP, slot_orig())
    asm.bind(have_bits)
    // rax holds the double's bits: the sign, and the magnitude without it.
    asm.mov_rr(x64::Reg::R8, x64::Reg::RAX)
    asm.mov_ri(x64::Reg::RCX, 63)
    asm.shift_cl(5, x64::Reg::R8)
    asm.store(8, x64::Reg::R8, x64::Reg::RBP, slot_sign())
    asm.mov_ri(x64::Reg::RCX, 1)
    asm.shift_cl(4, x64::Reg::RAX)
    asm.shift_cl(5, x64::Reg::RAX)
    asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_abs())

    // NaN has no sign; an infinity or zero keeps it.
    not_nan := asm.new_label()
    finished := asm.new_label()
    asm.mov_ri(x64::Reg::R8, 0x7FF0000000000000)
    asm.alu_rr(57, x64::Reg::RAX, x64::Reg::R8)
    asm.jcc(x64::Cc::BELOW_EQUAL, not_nan)
    put_byte(asm, 78)
    put_byte(asm, 97)
    put_byte(asm, 78)
    asm.jmp(finished)
    asm.bind(not_nan)
    no_sign := asm.new_label()
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, slot_sign())
    asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
    asm.jcc(x64::Cc::EQUAL, no_sign)
    put_byte(asm, 45)
    asm.bind(no_sign)
    not_inf := asm.new_label()
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_abs())
    asm.mov_ri(x64::Reg::R8, 0x7FF0000000000000)
    asm.alu_rr(57, x64::Reg::RAX, x64::Reg::R8)
    asm.jcc(x64::Cc::NOT_EQUAL, not_inf)
    put_byte(asm, 105)
    put_byte(asm, 110)
    put_byte(asm, 102)
    asm.jmp(finished)
    asm.bind(not_inf)
    not_zero := asm.new_label()
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::NOT_EQUAL, not_zero)
    put_byte(asm, 48)
    asm.jmp(finished)
    asm.bind(not_zero)

    // Precisions 0 to 16: the first whose text reads back as the same value gives the digits.
    asm.mov_ri(x64::Reg::RAX, 0)
    asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_precision())
    attempt := asm.new_label()
    found := asm.new_label()
    asm.bind(attempt)
    nearest_ok := asm.new_label()
    attempt_text(asm, snprintf, strtod, strtof, nearest_ok)
    // At a power of two the values above are twice as far apart as those below, so the shortest digits can lie above the
    // nearest decimal: the text is tried again rounded upward (glibc's printf follows the rounding mode).
    asm.mov_ri(x64::Reg::RDI, 2048)
    asm.call_aligned(fesetround)
    asm.lea(x64::Reg::RDI, x64::Reg::RBP, slot_text())
    asm.mov_ri(x64::Reg::RSI, 64)
    asm.lea(x64::Reg::RDX, x64::Reg::RBP, slot_format())
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, slot_precision())
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_abs())
    asm.movq_to_xmm(true, 0, x64::Reg::RAX)
    asm.mov_ri(x64::Reg::RAX, 1)
    asm.call_aligned(snprintf)
    asm.mov_ri(x64::Reg::RDI, 0)
    asm.call_aligned(fesetround)
    read_back(asm, strtod, strtof, found)
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_precision())
    asm.alu_ri(7, x64::Reg::RAX, 16)
    asm.jcc(x64::Cc::GREATER_EQUAL, found)
    asm.alu_ri(0, x64::Reg::RAX, 1)
    asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_precision())
    asm.jmp(attempt)
    // The nearest decimal reads back. When the value lies exactly halfway between two decimals of this length, Rust takes
    // the upper one while printf takes the even one, so the exact expansion is checked for a 5 followed by zeros there.
    asm.bind(nearest_ok)
    asm.lea(x64::Reg::RDI, x64::Reg::RBP, slot_exact())
    asm.mov_ri(x64::Reg::RSI, 830)
    asm.lea(x64::Reg::RDX, x64::Reg::RBP, slot_format())
    asm.mov_ri(x64::Reg::RCX, 780)
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_abs())
    asm.movq_to_xmm(true, 0, x64::Reg::RAX)
    asm.mov_ri(x64::Reg::RAX, 1)
    asm.call_aligned(snprintf)
    asm.lea(x64::Reg::RSI, x64::Reg::RBP, slot_exact())
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, slot_precision())
    asm.alu_rr(1, x64::Reg::RSI, x64::Reg::RCX)
    asm.load(1, false, x64::Reg::RCX, x64::Reg::RSI, 2)
    asm.alu_ri(7, x64::Reg::RCX, 53)
    asm.jcc(x64::Cc::NOT_EQUAL, found)
    asm.alu_ri(0, x64::Reg::RSI, 3)
    zeros := asm.new_label()
    tie := asm.new_label()
    asm.bind(zeros)
    asm.load(1, false, x64::Reg::RCX, x64::Reg::RSI, 0)
    asm.alu_ri(7, x64::Reg::RCX, 101)
    asm.jcc(x64::Cc::EQUAL, tie)
    asm.alu_ri(7, x64::Reg::RCX, 48)
    asm.jcc(x64::Cc::NOT_EQUAL, found)
    asm.alu_ri(0, x64::Reg::RSI, 1)
    asm.jmp(zeros)
    // A tie: the upper decimal, when it reads back too; otherwise the nearest one again.
    asm.bind(tie)
    asm.mov_ri(x64::Reg::RDI, 2048)
    asm.call_aligned(fesetround)
    asm.lea(x64::Reg::RDI, x64::Reg::RBP, slot_text())
    asm.mov_ri(x64::Reg::RSI, 64)
    asm.lea(x64::Reg::RDX, x64::Reg::RBP, slot_format())
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, slot_precision())
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_abs())
    asm.movq_to_xmm(true, 0, x64::Reg::RAX)
    asm.mov_ri(x64::Reg::RAX, 1)
    asm.call_aligned(snprintf)
    asm.mov_ri(x64::Reg::RDI, 0)
    asm.call_aligned(fesetround)
    read_back(asm, strtod, strtof, found)
    attempt_text(asm, snprintf, strtod, strtof, found)
    asm.bind(found)

    // The text is "d[.ddd]e[+-]XX". The exponent is read from past the 'e', which is at index 1 for one digit and
    // `precision + 2` otherwise; the digits are then closed up over the point.
    asm.load(8, false, x64::Reg::R9, x64::Reg::RBP, slot_precision())
    asm.mov_rr(x64::Reg::RAX, x64::Reg::R9)
    asm.alu_ri(0, x64::Reg::RAX, 1)
    asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_digits())
    asm.lea(x64::Reg::R10, x64::Reg::RBP, slot_text())
    have_e := asm.new_label()
    asm.mov_ri(x64::Reg::RSI, 1)
    asm.test_rr(x64::Reg::R9, x64::Reg::R9)
    asm.jcc(x64::Cc::EQUAL, have_e)
    asm.lea(x64::Reg::RSI, x64::Reg::R9, 2)
    asm.bind(have_e)
    asm.alu_rr(1, x64::Reg::RSI, x64::Reg::R10)
    asm.load(1, false, x64::Reg::R8, x64::Reg::RSI, 1)
    asm.alu_ri(0, x64::Reg::RSI, 2)
    asm.mov_ri(x64::Reg::RAX, 0)
    exponent_digit := asm.new_label()
    exponent_done := asm.new_label()
    asm.bind(exponent_digit)
    asm.load(1, false, x64::Reg::RCX, x64::Reg::RSI, 0)
    asm.test_rr(x64::Reg::RCX, x64::Reg::RCX)
    asm.jcc(x64::Cc::EQUAL, exponent_done)
    asm.alu_ri(5, x64::Reg::RCX, 48)
    asm.mov_ri(x64::Reg::RDX, 10)
    asm.imul_rr(x64::Reg::RAX, x64::Reg::RDX)
    asm.alu_rr(1, x64::Reg::RAX, x64::Reg::RCX)
    asm.alu_ri(0, x64::Reg::RSI, 1)
    asm.jmp(exponent_digit)
    asm.bind(exponent_done)
    positive_exponent := asm.new_label()
    asm.alu_ri(7, x64::Reg::R8, 45)
    asm.jcc(x64::Cc::NOT_EQUAL, positive_exponent)
    asm.unary(3, x64::Reg::RAX)
    asm.bind(positive_exponent)
    asm.store(8, x64::Reg::RAX, x64::Reg::RBP, slot_exponent())
    // Close up the digits: text[i] = text[i + 1] for i from 1 to precision.
    closed := asm.new_label()
    close := asm.new_label()
    asm.mov_ri(x64::Reg::RCX, 1)
    asm.bind(close)
    asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R9)
    asm.jcc(x64::Cc::ABOVE, closed)
    asm.mov_rr(x64::Reg::RDX, x64::Reg::R10)
    asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RCX)
    asm.load(1, false, x64::Reg::RAX, x64::Reg::RDX, 1)
    asm.store(1, x64::Reg::RAX, x64::Reg::RDX, 0)
    asm.alu_ri(0, x64::Reg::RCX, 1)
    asm.jmp(close)
    asm.bind(closed)

    // Place the point. r10 is the digits, r8 their count, rax the exponent, r11 the output.
    asm.load(8, false, x64::Reg::R11, x64::Reg::RBP, slot_out())
    asm.load(8, false, x64::Reg::R8, x64::Reg::RBP, slot_digits())
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_exponent())
    fractional := asm.new_label()
    wrote := asm.new_label()
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::LESS, fractional)
    // An exponent of zero or more: `exponent + 1` integer digits, padded with zeros past the digits there are.
    asm.mov_rr(x64::Reg::R9, x64::Reg::RAX)
    asm.alu_ri(0, x64::Reg::R9, 1)
    asm.mov_ri(x64::Reg::RCX, 0)
    integer_digit := asm.new_label()
    integer_done := asm.new_label()
    asm.bind(integer_digit)
    asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R9)
    asm.jcc(x64::Cc::GREATER_EQUAL, integer_done)
    pad := asm.new_label()
    stored := asm.new_label()
    asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
    asm.jcc(x64::Cc::GREATER_EQUAL, pad)
    asm.mov_rr(x64::Reg::RDX, x64::Reg::R10)
    asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RCX)
    asm.load(1, false, x64::Reg::RAX, x64::Reg::RDX, 0)
    asm.jmp(stored)
    asm.bind(pad)
    asm.mov_ri(x64::Reg::RAX, 48)
    asm.bind(stored)
    asm.store(1, x64::Reg::RAX, x64::Reg::R11, 0)
    asm.alu_ri(0, x64::Reg::R11, 1)
    asm.alu_ri(0, x64::Reg::RCX, 1)
    asm.jmp(integer_digit)
    asm.bind(integer_done)
    // The digits past the integer part follow a point.
    asm.alu_rr(57, x64::Reg::R8, x64::Reg::R9)
    asm.jcc(x64::Cc::LESS_EQUAL, wrote)
    asm.mov_ri(x64::Reg::RAX, 46)
    asm.store(1, x64::Reg::RAX, x64::Reg::R11, 0)
    asm.alu_ri(0, x64::Reg::R11, 1)
    fraction_digit := asm.new_label()
    asm.mov_rr(x64::Reg::RCX, x64::Reg::R9)
    asm.bind(fraction_digit)
    asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
    asm.jcc(x64::Cc::GREATER_EQUAL, wrote)
    asm.mov_rr(x64::Reg::RDX, x64::Reg::R10)
    asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RCX)
    asm.load(1, false, x64::Reg::RAX, x64::Reg::RDX, 0)
    asm.store(1, x64::Reg::RAX, x64::Reg::R11, 0)
    asm.alu_ri(0, x64::Reg::R11, 1)
    asm.alu_ri(0, x64::Reg::RCX, 1)
    asm.jmp(fraction_digit)
    // A negative exponent: "0.", then `-exponent - 1` zeros, then all the digits.
    asm.bind(fractional)
    asm.mov_ri(x64::Reg::RCX, 48)
    asm.store(1, x64::Reg::RCX, x64::Reg::R11, 0)
    asm.mov_ri(x64::Reg::RCX, 46)
    asm.store(1, x64::Reg::RCX, x64::Reg::R11, 1)
    asm.alu_ri(0, x64::Reg::R11, 2)
    asm.unary(3, x64::Reg::RAX)
    asm.alu_ri(5, x64::Reg::RAX, 1)
    zero_run := asm.new_label()
    zeros_done := asm.new_label()
    asm.bind(zero_run)
    asm.test_rr(x64::Reg::RAX, x64::Reg::RAX)
    asm.jcc(x64::Cc::EQUAL, zeros_done)
    asm.mov_ri(x64::Reg::RCX, 48)
    asm.store(1, x64::Reg::RCX, x64::Reg::R11, 0)
    asm.alu_ri(0, x64::Reg::R11, 1)
    asm.alu_ri(5, x64::Reg::RAX, 1)
    asm.jmp(zero_run)
    asm.bind(zeros_done)
    all_digit := asm.new_label()
    asm.mov_ri(x64::Reg::RCX, 0)
    asm.bind(all_digit)
    asm.alu_rr(57, x64::Reg::RCX, x64::Reg::R8)
    asm.jcc(x64::Cc::GREATER_EQUAL, wrote)
    asm.mov_rr(x64::Reg::RDX, x64::Reg::R10)
    asm.alu_rr(1, x64::Reg::RDX, x64::Reg::RCX)
    asm.load(1, false, x64::Reg::RAX, x64::Reg::RDX, 0)
    asm.store(1, x64::Reg::RAX, x64::Reg::R11, 0)
    asm.alu_ri(0, x64::Reg::R11, 1)
    asm.alu_ri(0, x64::Reg::RCX, 1)
    asm.jmp(all_digit)
    asm.bind(wrote)
    asm.store(8, x64::Reg::R11, x64::Reg::RBP, slot_out())

    // The length is the output position less the start.
    asm.bind(finished)
    asm.load(8, false, x64::Reg::RAX, x64::Reg::RBP, slot_out())
    asm.load(8, false, x64::Reg::RCX, x64::Reg::RBP, slot_start())
    asm.alu_rr(41, x64::Reg::RAX, x64::Reg::RCX)
    asm.mov_rr(x64::Reg::RSP, x64::Reg::RBP)
    asm.pop(x64::Reg::RBP)
    asm.ret()
}
