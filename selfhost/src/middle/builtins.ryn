// The standard-library functions the compiler knows without a declaration: their names, the IR
// call target, parameter types, and result type. Generated from the table in `sema.rs`.
//
// Each row is `names;target;parameters;result` with names and parameters separated by commas
// (a parameter type word may hold spaces) and an empty result for none.

pub struct Builtin {
    pub target: String,
    pub params: Vec<String>,
    pub ret: String,
}

fun builtin_rows() -> Vec<String> {
    mut rows: Vec<String> = Vec()
    rows.push(String("char_from_u32;String CharFromU32;U32;Char"))
    rows.push(String("read_file,__fs_read_file;Filesystem ReadFile;Str;OwnedString"))
    rows.push(String("write_file,__fs_write_file;Filesystem WriteFile;Str,Str;Bool"))
