fun split_words(text: String) -> Vec<String> {
    mut words: Vec<String> = Vec()
    when text.is_empty() {
        return words
    }
    return text.split(",")
}

// The builtin with this name, if any.
pub fun builtin_named(name: String) -> Option<Builtin> {
    rows := builtin_rows()
    for row in rows {
        fields := row.split(";")
        names := split_words(fields[0].clone())
        for candidate in names {
            when candidate == name {
                return Option::Some(Builtin { target: fields[1].clone(), params: split_words(fields[2].clone()), ret: fields[3].clone() })
            }
        }
    }
    return Option::None
}
