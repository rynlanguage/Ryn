// Lowers the subset of programs that the syntax tree model can express into the textual IR
// that `ryn::ir_codec::encode_ir` writes, as the bootstrap compiler's `sema` and `guard` do.
//
// The subset is one function, `main`, with no parameters and an optional `-> i32` result;
// `i32`, `i64`, and `str` locals; integer arithmetic; string literals; `echo` and template
// prints; `let`; `=`; and compound assignment. Anything else is reported as `unsupported`.

use middle::ast
use middle::floatlib
use middle::builtins
use middle::methods

pub struct Local {
    name: String,
    slot: u64,
    ty: String,
    mutable: bool,
}

#[derive(Clone)]
pub struct Lowered {
    text: String,
    ty: String,
}

// A function's IR-level signature: parameter type words and the result word ("" for none), and
// the visibility the bootstrap checks for a call from another module (`R0425`).
// Whether a move with this name and span is in `moved`.
fun moved_in(moved: Vec<MovedValue>, name: String, start: u64, end: u64) -> bool {
    for item in moved {
        when item.name == name && item.start == start && item.end == end {
            return true
        }
    }
    return false
}

// A reference argument of a call: the local it borrows, whether it is mutable, and the `&` expression's span.
pub struct ExplicitBorrow {
    local: u64,
    mutable: bool,
    start: u64,
    end: u64,
}

// A reference or raw pointer local and the local it points at, both as indices into `locals`.
pub struct LocalOrigin {
    holder: u64,
    source: u64,
}

// A reference local that borrows another local: `holder` is the index of the reference in `locals`, and it is in
// scope until that block ends. A mutable borrow makes any use of the borrowed local an error.
pub struct ActiveBorrow {
    slot: u64,
    holder: u64,
    mutable: bool,
}

// An owned local that a move has left, with the span of the move. The guard reports a later use of it.
pub struct MovedValue {
    name: String,
    slot: u64,
    start: u64,
    end: u64,
}

pub struct Signature {
    name: String,
    params: Vec<String>,
    ret: String,
    public: bool,
    module: String,
    // The parameter that a function returns, when it returns a reference from one parameter.
    return_param: Option<u64>,
}

// A structure definition: field names and IR type words, and whether each field is public.
pub struct StructInfo {
    name: String,
    field_names: Vec<String>,
    field_types: Vec<String>,
    field_public: Vec<u64>,
    repr_c: u64,
    derives_clone: u64,
    derives_hash: u64,
    drop_name: String,
    module_path: String,
    public: bool,
}

// A storage location a value can be read from or written to: a slot run and its type.
pub struct Place {
    slot: u64,
    ty: String,
    mutable: bool,
}

// An enum: its variant names and field counts, and every variant's field types in order.
pub struct EnumInfo {
    name: String,
    variant_names: Vec<String>,
    variant_counts: Vec<u64>,
    field_types: Vec<String>,
}

// A `defer` body, with the locals that were visible where it was written.
pub struct Deferred {
    body: Vec<u64>,
    visible: u64,
}

// The lowered statements of one branch, and whether control falls off its end.
pub struct Block {
    items: Vec<String>,
    falls: bool,
}

pub struct Lowering {
    program: ast::Program,
    signatures: Vec<Signature>,
    locals: Vec<Local>,
    local_types: Vec<String>,
    addressed_types: Vec<String>,
    next_slot: u64,
    statements: Vec<String>,
    return_ty: String,
    loop_depth: u64,
    visible: u64,
    loop_floors: Vec<u64>,
    owners: Vec<String>,
    enums: Vec<EnumInfo>,
    defers: Vec<Deferred>,
    defer_count: u64,
    // How many deferred bodies are being lowered; a `return`, `break`, or `continue` there is an error.
    defer_depth: u64,
    frame_marks: Vec<u64>,
    loop_frames: Vec<u64>,
    scope_floors: Vec<u64>,
    chained: bool,
    borrow_chain: bool,
    returned_refs: Vec<String>,
    // Owned locals that a top-level statement of the function has moved, so that a later use is `R0240`; and
    // the moves of the statement being lowered, which become moved once that statement is done.
    moved_names: Vec<MovedValue>,
    pending_moves: Vec<MovedValue>,
    // The moves at each `break` and each `continue` of the innermost loop being lowered.
    break_moves: Vec<MovedValue>,
    continue_moves: Vec<MovedValue>,
    // The references in scope that borrow a local.
    borrows: Vec<ActiveBorrow>,
    // Which local each reference or raw pointer local points at.
    origins: Vec<LocalOrigin>,
    param_slots: Vec<u64>,
    structs: Vec<StructInfo>,
    type_names: Vec<String>,
    type_words: Vec<String>,
    scope_path: String,
    current_function: String,
    call_scope: String,
    module: String,
    alias_names: Vec<String>,
    private_alias_names: Vec<String>,
    private_alias_targets: Vec<String>,
    alias_targets: Vec<u64>,
    // The statements that a statement needs before it runs, such as the temporaries that its method receivers borrow.
    setup: Vec<String>,
}

// The IEEE bit pattern of a float literal's text, as the IR writes it.
fun float_bits(text: String) -> Result<String, String> {
    parsed := floatlib::parse_f64(text)
    when parsed.is_none() {
        return Result::Err(unsupported("float literal"))
    }
    return Result::Ok(String(parsed.unwrap()))
}

// Joins tokens with single spaces. A token may hold spaces itself, as a length-prefixed string does.
fun join(tokens: Vec<String>) -> String {
    mut out := String("")
    mut first := true
    for token in tokens {
        when !first {
            out.append(" ")
        }
        out.append(token)
        first = false
    }
    return out
}

fun num(value: u64) -> String {
    return String(value)
}

// `<byte length>:<bytes>`, the form the IR uses for strings.
fun length_prefixed(text: String) -> String {
    mut out := String(text.len())
    out.append(":")
    out.append(text)
    return out
}

// A diagnostic the Ryn analysis reports itself. The text is `diagnostic <code> <start> <end>
// <message> <help>` with the message and help in the `<byte length>:<bytes>` form; the help is
// empty when there is none. `main.ryn` writes it out and the caller compares it with the
// bootstrap analyzer's diagnostics.
pub fun diagnostic(code: str, start: u64, end: u64, message: String, help: String) -> String {
    mut out := String("diagnostic ")
    out.append(code)
    out.push(' ')
    out.append(String(start))
    out.push(' ')
    out.append(String(end))
    out.push(' ')
    out.append(length_prefixed(message))
    out.push(' ')
    out.append(length_prefixed(help))
    return out
}

// `R0204` for an assignment to a binding declared without `mut`. The hint is
// `declare `mut <name> := ...` followed by `reason`.
fun immutable_binding(name: String, start: u64, end: u64, reason: str) -> String {
    mut message := String("`")
    message.append(name.clone())
    message.append("` is immutable")
    mut help := String("declare `mut ")
    help.append(name)
    help.append(" := ...` ")
    help.append(reason)
    return diagnostic("R0204", start, end, message, help)
}

// The optimal-string-alignment distance (insertions, deletions, substitutions, and swaps of two
// neighbouring bytes), the measure behind `did you mean` suggestions.
fun edit_distance(left: String, right: String) -> u64 {
    n := left.len()
    m := right.len()
    mut before: Vec<u64> = Vec()
    mut previous: Vec<u64> = Vec()
    mut current: Vec<u64> = Vec()
    mut index: u64 = 0
    while index <= m {
        before.push(0)
        previous.push(index)
        current.push(0)
        index += 1
    }
    mut i: u64 = 1
    while i <= n {
        current.set(0, i)
        mut j: u64 = 1
        while j <= m {
            mut cost: u64 = 1
            when left.byte_at(i - 1) == right.byte_at(j - 1) {
                cost = 0
            }
            mut distance := previous[j] + 1
            when current[j - 1] + 1 < distance {
                distance = current[j - 1] + 1
            }
            when previous[j - 1] + cost < distance {
                distance = previous[j - 1] + cost
            }
            when i > 1 && j > 1 && left.byte_at(i - 1) == right.byte_at(j - 2) && left.byte_at(i - 2) == right.byte_at(j - 1) {
                when before[j - 2] + 1 < distance {
                    distance = before[j - 2] + 1
                }
            }
            current.set(j, distance)
            j += 1
        }
        mut k: u64 = 0
        while k <= m {
            before.set(k, previous[k])
            previous.set(k, current[k])
            k += 1
        }
        i += 1
    }
    return previous[m]
}

// The one candidate within the typo limit, or an empty string when there is none or two tie.
fun closest_name(name: String, candidates: Vec<String>) -> String {
    when name.len() > 64 {
        return String()
    }
    mut limit: u64 = name.len() / 3
    when limit < 1 {
        limit = 1
    }
    when limit > 2 {
        limit = 2
    }
    mut closest := String()
    mut best: u64 = limit + 1
    mut ambiguous := false
    for candidate in candidates {
        when candidate.len() > 64 {
            continue
        }
        mut gap: u64 = 0
        when candidate.len() > name.len() {
            gap = candidate.len() - name.len()
        } else {
            gap = name.len() - candidate.len()
        }
        when gap > limit {
            continue
        }
        distance := edit_distance(name.clone(), candidate.clone())
        when distance > limit {
            continue
        }
        when distance < best {
            closest = candidate
            best = distance
            ambiguous = false
        } else when distance == best {
            ambiguous = true
        }
    }
    when ambiguous {
        return String()
    }
    return closest
}

fun bare_variant_hint(name: String) -> String {
    when name == "None" { return String("write the empty option as `Option::None`") }
    when name == "Some" { return String("write a present option as `Option::Some(value)`") }
    when name == "Ok" { return String("write a success result as `Result::Ok(value)`") }
    when name == "Err" { return String("write a failed result as `Result::Err(error)`") }
    return String()
}

// The text of a bare name expression, or an empty string for any other expression.
fun match_name(node: ast::ExprTree) -> String {
    return choose node {
        ast::ExprTree::NameRef(name, span) => name,
        _ => String()
    }
}

fun unsupported(what: str) -> String {
    mut out := String("unsupported: ")
    out.append(what)
    return out
}

// `EnumMatch <value> <enum> <arm count> <arms> <type>`; the arms' tokens are already joined.
fun choose_tokens(value: String, id: u64, arm_count: u64, arms: Vec<String>, ty: String) -> Vec<String> {
    mut tokens: Vec<String> = Vec()
    tokens.push(String("EnumMatch"))
    tokens.push(value)
    tokens.push(num(id))
    tokens.push(num(arm_count))
    for token in arms {
        tokens.push(token)
    }
    tokens.push(ty)
    return tokens
}

fun no_items() -> Vec<String> {
    return Vec()
}

// `Block <count> <statements>`: a nested block of statements, as the IR writes one.
fun block_of(statements: Vec<String>) -> Vec<String> {
    mut tokens: Vec<String> = Vec()
    tokens.push(String("Block"))
    tokens.push(num(statements.len()))
    for statement in statements {
        tokens.push(statement)
    }
    return tokens
}

fun words2(a: String, b: String) -> Vec<String> {
    mut items: Vec<String> = Vec()
    items.push(a)
    items.push(b)
    return items
}

fun words3(a: String, b: String, c: String) -> Vec<String> {
    mut items: Vec<String> = Vec()
    items.push(a)
    items.push(b)
    items.push(c)
    return items
}

fun words4(a: String, b: String, c: String, d: String) -> Vec<String> {
    mut items: Vec<String> = Vec()
    items.push(a)
    items.push(b)
    items.push(c)
    items.push(d)
    return items
}

fun words5(a: String, b: String, c: String, d: String, e: String) -> Vec<String> {
    mut items: Vec<String> = Vec()
    items.push(a)
    items.push(b)
    items.push(c)
    items.push(d)
    items.push(e)
    return items
}

fun words7(a: String, b: String, c: String, d: String, e: String, f: String, g: String) -> Vec<String> {
    mut items: Vec<String> = Vec()
    items.push(a)
    items.push(b)
    items.push(c)
    items.push(d)
    items.push(e)
    items.push(f)
    items.push(g)
    return items
}

fun words6(a: String, b: String, c: String, d: String, e: String, f: String) -> Vec<String> {
    mut items: Vec<String> = Vec()
    items.push(a)
    items.push(b)
    items.push(c)
    items.push(d)
    items.push(e)
    items.push(f)
    return items
}

// The IR word for a binary operator the subset supports.
fun operator_word(op: String) -> Result<String, String> {
    when op == "Shl" {
        return Result::Ok(String("ShiftLeft"))
    }
    when op == "Shr" {
        return Result::Ok(String("ShiftRight"))
    }
    when op == "Add" || op == "Sub" || op == "Mul" || op == "Div" || op == "Rem" || is_bitwise_op(op.clone()) {
        return Result::Ok(op)
    }
    return Result::Err(unsupported("operator"))
}

// `-N` folds into one literal only when N alone is out of range for the type, as sema does for
// the smallest value of a type. Otherwise the negation stays a separate node.
fun needs_folding(value: u64, ty: String) -> bool {
    when ty == "I8" {
        return value > 127
    }
    when ty == "I16" {
        return value > 32767
    }
    when ty == "I32" {
        return value > 2147483647
    }
    when ty == "I64" {
        return value > 9223372036854775807
    }
    return false
}

fun is_float_word(ty: String) -> bool {
    return ty == "F32" || ty == "F64"
}

fun is_numeric_word(ty: String) -> bool {
    return is_integer_word(ty.clone()) || is_float_word(ty)
}

// The source spelling of a scalar or string type word, as the bootstrap's messages print it.
// Other types have no spelling here, so a diagnostic that names them is left to the bootstrap.
fun scalar_type_name(ty: String) -> Option<String> {
    when ty == "I8" { return Option::Some(String("i8")) }
    when ty == "I16" { return Option::Some(String("i16")) }
    when ty == "I32" { return Option::Some(String("i32")) }
    when ty == "I64" { return Option::Some(String("i64")) }
    when ty == "U8" { return Option::Some(String("u8")) }
    when ty == "U16" { return Option::Some(String("u16")) }
    when ty == "U32" { return Option::Some(String("u32")) }
    when ty == "U64" { return Option::Some(String("u64")) }
    when ty == "F32" { return Option::Some(String("f32")) }
    when ty == "F64" { return Option::Some(String("f64")) }
    when ty == "Bool" { return Option::Some(String("bool")) }
    when ty == "Char" { return Option::Some(String("char")) }
    when ty == "Str" { return Option::Some(String("str")) }
    when ty == "OwnedString" { return Option::Some(String("String")) }
    return Option::None
}

// `R0206` with the operand types spelled as the bootstrap does: `<prefix> found `<left>` and `<right>``.
fun operator_error(prefix: str, left: String, right: String, help: str, span: ast::Span) -> Option<String> {
    mut message := String(prefix)
    message.push(' ')
    message.append("found `")
    message.append(left)
    message.append("` and `")
    message.append(right)
    message.push('`')
    return Option::Some(diagnostic("R0206", span.start, span.end, message, String(help)))
}

// The `R0206` the bootstrap reports for an operator applied to scalar operands of these types, at the
// operand or operation span it names. Operands of other types are declined (`None`).
fun operator_mismatch(op: String, left: String, right: String, left_span: ast::Span, right_span: ast::Span, span: ast::Span) -> Option<String> {
    left_name := scalar_type_name(left.clone())
    right_name := scalar_type_name(right.clone())
    when left_name.is_none() || right_name.is_none() {
        return Option::None
    }
    left_text := left_name.unwrap()
    right_text := right_name.unwrap()
    when op == "Rem" && left == right && !is_integer_word(left.clone()) {
        return operator_error("`%` requires integer operands,", left_text, right_text, "use `%` only with integer operands; use `/` for floating-point division", span)
    }
    when op == "Add" || op == "Sub" || op == "Mul" || op == "Div" || op == "Rem" {
        when !is_numeric_word(left.clone()) {
            return operator_error("arithmetic operands must have matching numeric types,", left_text, right_text, "use numeric operands for arithmetic operators", left_span)
        }
        when left != right && !is_numeric_word(right.clone()) {
            return operator_error("arithmetic operands must have matching numeric types,", left_text, right_text, "use numeric operands for arithmetic operators", right_span)
        }
        when left != right {
            return operator_error("arithmetic operands must have matching numeric types,", left_text, right_text, "use matching numeric types; Ryn does not implicitly convert numeric values", right_span)
        }
        return Option::None
    }
    when op == "BitAnd" || op == "BitXor" || op == "BitOr" {
        when !is_integer_word(left.clone()) {
            return operator_error("bitwise operands must have matching integer types,", left_text, right_text, "use integer operands of the same type with bitwise operators", left_span)
        }
        when !is_integer_word(right.clone()) || left != right {
            return operator_error("bitwise operands must have matching integer types,", left_text, right_text, "use integer operands of the same type with bitwise operators", right_span)
        }
        return Option::None
    }
    when op == "Shl" || op == "Shr" {
        when !is_integer_word(left.clone()) {
            return operator_error("shift requires an integer value and a `u32` count,", left_text, right_text, "use an integer value on the left and a `u32` shift count on the right", left_span)
        }
        when right != "U32" {
            return operator_error("shift requires an integer value and a `u32` count,", left_text, right_text, "use an integer value on the left and a `u32` shift count on the right", right_span)
        }
        return Option::None
    }
    when op == "Eq" || op == "Ne" {
        when !is_equality_word(left.clone()) {
            return operator_error("equality operands are incompatible:", left_text, right_text, "compare values with the same type", left_span)
        }
        when left != right {
            return operator_error("equality operands are incompatible:", left_text, right_text, "compare values with the same type", right_span)
        }
        return Option::None
    }
    when op == "Lt" || op == "Le" || op == "Gt" || op == "Ge" {
        when !(is_numeric_word(left.clone()) || left == "Char") {
            return operator_error("ordering operands are incompatible:", left_text, right_text, "use numeric values with ordering operators such as `<` and `>=`", left_span)
        }
        when left != right {
            return operator_error("ordering operands are incompatible:", left_text, right_text, "use numeric values with ordering operators such as `<` and `>=`", right_span)
        }
        return Option::None
    }
    return Option::None
}

// `R0230` for a path whose first part names no enum, at the expression's span.
fun unknown_enum_error(name: String, start: u64, end: u64) -> String {
    mut message := String("unknown enum `")
    message.append(name)
    message.append("`")
    return diagnostic("R0230", start, end, message, String("declare the enum before constructing it"))
}

// `R0230` for a path into a module whose module does not declare the item, at the expression's span.
fun unknown_module_item_error(module: String, item: String, start: u64, end: u64) -> String {
    mut message := String("unknown item `")
    message.append(item.clone())
    message.append("` in module `")
    message.append(module.clone())
    message.append("`")
    mut help := String("declare `")
    help.append(item)
    help.append("` as a public item of module `")
    help.append(module)
    help.append("`, or check its spelling")
    return diagnostic("R0230", start, end, message, help)
}

// `R0234` for a `choose` (or a `??`, which is one) over a value that is not an enum, at the expression's span.
fun choose_enum_error(start: u64, end: u64) -> String {
    return diagnostic("R0234", start, end, String("`choose` requires an enum value"), String("match one of this enum's variants over a value of enum type"))
}

// `R0235` for a `choose` that leaves out variants and has no `_` arm, at the `choose`'s span. `missing` lists
// the variants in declaration order.
fun choose_missing_error(missing: String, start: u64, end: u64) -> String {
    mut message := String("`choose` is not exhaustive; missing variant(s): ")
    message.append(missing)
    return diagnostic("R0235", start, end, message, String("add the missing variant arm(s) or a `_` fallback"))
}

// `R0233` for an enum that has no variant of the given name, at `start`..`end`; the help lists the variants
// in declaration order. Built-in generic enums are declined by the callers.
fun unknown_variant_error(enum_name: String, variant: String, variants: Vec<String>, start: u64, end: u64) -> String {
    mut message := String("enum `")
    message.append(enum_name.clone())
    message.append("` has no variant `")
    message.append(variant)
    message.append("`")
    mut listed := String("")
    mut index: u64 = 0
    while index < variants.len() {
        when index > 0 {
            listed.append(", ")
        }
        listed.push('`')
        listed.append(variants[index].clone())
        listed.push('`')
        index += 1
    }
    mut help := String("the variants of `")
    help.append(enum_name)
    help.append("` are ")
    help.append(listed)
    return diagnostic("R0233", start, end, message, help)
}

// `R0233` for an enum variant built with the wrong number of field values, at the call's span. The name
// is the one the call writes.
fun enum_arity_error(name: String, variant: String, expected: u64, count: u64, start: u64, end: u64) -> String {
    mut message := String("enum variant `")
    message.append(name)
    message.append("::")
    message.append(variant)
    message.append("` expects ")
    message.append(String(expected))
    message.append(" field value(s), got ")
    message.append(String(count))
    return diagnostic("R0233", start, end, message, String(""))
}

// The error for `break` or `continue` outside a loop: `R0268` inside a `defer` body, which cannot leave
// it, and `R0016` or `R0017` anywhere else.
fun jump_error(keyword: str, in_defer: bool, start: u64, end: u64) -> String {
    mut quoted := String("`")
    quoted.append(keyword)
    quoted.append("`")
    when in_defer {
        mut inside := quoted.clone()
        inside.append(" cannot leave a `defer` block")
        return diagnostic("R0268", start, end, inside, String("move the loop inside the `defer` block"))
    }
    mut outside := quoted
    outside.append(" can only be used inside a loop")
    when keyword == "break" {
        return diagnostic("R0016", start, end, outside, String("move `break` into the body of a `while` or `for` loop"))
    }
    return diagnostic("R0017", start, end, outside, String("move `continue` into the body of a `while` or `for` loop"))
}

// `R0205` for a structure field initialized with a value of another type, at the value's span. Scalar and
// string types only; other types are declined.
fun field_type_error(field: String, expected: String, actual: String, span: ast::Span) -> Option<String> {
    expected_name := scalar_type_name(expected)
    actual_name := scalar_type_name(actual)
    when expected_name.is_none() || actual_name.is_none() {
        return Option::None
    }
    expected_text := expected_name.unwrap()
    mut message := String("field `")
    message.append(field.clone())
    message.append("` requires `")
    message.append(expected_text.clone())
    message.append("` but the value has type `")
    message.append(actual_name.unwrap())
    message.append("`")
    mut help := String("provide a `")
    help.append(expected_text)
    help.append("` value for `")
    help.append(field)
    help.append("`")
    return Option::Some(diagnostic("R0205", span.start, span.end, message, help))
}

// `R0240` for an array repeat whose length differs from the expected array's, at the repeat's span.
fun repeat_length_error(length: u64, expected: u64, start: u64, end: u64) -> String {
    mut message := String("array repeat has length ")
    message.append(String(length))
    message.append(" but the expected array needs ")
    message.append(String(expected))
    return diagnostic("R0240", start, end, message, String(""))
}

// `R0205` for an array element of another scalar or string type than the array's, at the element's span.
fun element_type_error(expected: String, actual: String, span: ast::Span) -> Option<String> {
    expected_name := scalar_type_name(expected)
    actual_name := scalar_type_name(actual)
    when expected_name.is_none() || actual_name.is_none() {
        return Option::None
    }
    mut message := String("array element requires `")
    message.append(expected_name.unwrap())
    message.append("` but has type `")
    message.append(actual_name.unwrap())
    message.append("`")
    return Option::Some(diagnostic("R0205", span.start, span.end, message, String("")))
}

// `R0205` for an array repeat where a scalar or string type other than an array is expected, at the repeat's span.
fun repeat_type_error(expected: String, start: u64, end: u64) -> Option<String> {
    expected_name := scalar_type_name(expected)
    when expected_name.is_none() {
        return Option::None
    }
    mut message := String("array repeat does not match expected type `")
    message.append(expected_name.unwrap())
    message.append("`")
    return Option::Some(diagnostic("R0205", start, end, message, String("")))
}

// `R0256` for an array repeat of an element that cannot be copied, at the repeat's span.
fun repeat_copy_error(element: str, start: u64, end: u64) -> String {
    mut message := String("array repeat cannot copy `")
    message.append(element)
    message.append("` elements")
    return diagnostic("R0256", start, end, message, String("repeat expressions evaluate the element once and copy the bits; write an element list for String, Vec, Map, Set, or enum values"))
}

// `R0232` for a structure that contains itself by value. The structures are visited in order and each one's
// by-value fields in order, depth first, as the bootstrap's layout pass does; the first field that reaches a
// structure still in progress is reported. Structure `s`'s edges are `first[s]` .. `first[s] + count[s]`.
fun struct_cycle_error(names: Vec<String>, first: Vec<u64>, count: Vec<u64>, targets: Vec<u64>, starts: Vec<u64>, ends: Vec<u64>) -> Option<String> {
    mut states: Vec<u64> = Vec()
    mut slot: u64 = 0
    while slot < names.len() {
        states.push(0)
        slot += 1
    }
    mut start: u64 = 0
    while start < names.len() {
        when states[start] == 0 {
            states.set(start, 1)
            mut nodes: Vec<u64> = Vec()
            mut steps: Vec<u64> = Vec()
            nodes.push(start)
            steps.push(0)
            while nodes.len() > 0 {
                top := nodes.len() - 1
                node := nodes[top]
                step := steps[top]
                when step == count[node] {
                    states.set(node, 2)
                    nodes.pop()
                    steps.pop()
                } else {
                    steps.set(top, step + 1)
                    edge := first[node] + step
                    child := targets[edge]
                    when states[child] == 0 {
                        states.set(child, 1)
                        nodes.push(child)
                        steps.push(0)
                    } else when states[child] == 1 {
                        mut message := String("structure `")
                        message.append(names[child].clone())
                        message.append("` contains itself by value")
                        return Option::Some(diagnostic("R0232", starts[edge], ends[edge], message, String("break the recursive field chain; Ryn does not support indirect or recursive storage yet")))
                    }
                }
            }
        }
        start += 1
    }
    return Option::None
}

// `R0221` for a structure that declares no field, at the structure's span.
fun empty_structure_error(start: u64, end: u64) -> String {
    return diagnostic("R0221", start, end, String("a structure must declare at least one field"), String("add one or more typed fields to the structure"))
}

// `R0222` for a structure field whose name an earlier field of the structure has, at the field's span.
fun duplicate_field_error(name: String, start: u64, end: u64) -> String {
    mut message := String("duplicate field `")
    message.append(name)
    message.append("`")
    return diagnostic("R0222", start, end, message, String("give each field in a structure a unique name"))
}

// The C size of a scalar word a `#[repr(C)]` record may hold (`c_abi_scalar_field_layout`); its alignment is the same.
// Zero for any other word.
fun c_field_size(word: String) -> u64 {
    when word == "I8" || word == "U8" || word == "Bool" {
        return 1
    }
    when word == "I16" || word == "U16" {
        return 2
    }
    when word == "I32" || word == "U32" || word == "Char" || word == "F32" {
        return 4
    }
    when word == "I64" || word == "U64" || word == "F64" {
        return 8
    }
    return 0
}

// `value` rounded up to a multiple of `alignment`, as the bootstrap's `align_up`.
fun align_to(value: u64, alignment: u64) -> u64 {
    return (value + alignment - 1) / alignment * alignment
}

// The scalars that the C ABI passes as they are, besides records and callbacks: numbers, `bool`, `char` and raw pointers.
fun c_scalar_or_pointer(word: String) -> bool {
    return is_numeric_word(word.clone()) || word == "Bool" || word == "Char" || word.starts_with("RawPointer ")
}

// How a parameter of an `extern "C"` function fares: 0 when the C ABI passes it, and 1 when it never can. A record or
// a callback is judged by its layout and signature, as the bootstrap's `is_c_abi_parameter` judges it.
extend Lowering {
    fun c_parameter_status(self, word: String) -> u64 {
        when c_scalar_or_pointer(word.clone()) {
            return 0
        }
        when word.starts_with("FunctionPointer ") {
            when self.c_callback_ok(word) {
                return 0
            }
            return 1
        }
        when self.c_record_word_ok(word) {
            return 0
        }
        return 1
    }

    // How a result of an `extern "C"` function fares, with the codes of `c_parameter_status`. `char` is not a C result.
    fun c_return_status(self, word: String) -> u64 {
        when is_numeric_word(word.clone()) || word == "Bool" || word.starts_with("RawPointer ") {
            return 0
        }
        when self.c_record_word_ok(word) {
            return 0
        }
        return 1
    }

    // Whether a structure word names a `#[repr(C)]` record the C ABI passes (`is_c_abi_record`).
    fun c_record_word_ok(self, word: String) -> bool {
        id := struct_id_of(word)
        when id.is_none() {
            return false
        }
        return self.c_record_ok(id.unwrap())
    }

    // Whether a structure is a `#[repr(C)]` record of scalar fields whose packed layout is 1, 2, 4 or 8 bytes, or 9 to
    // 16 bytes (`c_abi_packed_record_layout`; the 9 to 16 byte case holds on the non-Windows targets).
    fun c_record_ok(self, id: u64) -> bool {
        info := self.structs[id]
        when info.repr_c != 1 {
            return false
        }
        mut offset: u64 = 0
        mut aggregate: u64 = 1
        for word in info.field_types.clone() {
            size := c_field_size(word)
            when size == 0 {
                return false
            }
            offset = align_to(offset, size) + size
            when size > aggregate {
                aggregate = size
            }
        }
        total := align_to(offset, aggregate)
        return total == 1 || total == 2 || total == 4 || total == 8 || (total >= 9 && total <= 16)
    }

    // Whether a function-pointer word is an `extern "C"` callback whose parameters and result are C-compatible
    // (`is_c_callback`): scalars and pointers as parameters, and a scalar, pointer, record or no result.
    fun c_callback_ok(self, word: String) -> bool {
        tokens := word.split(" ")
        when tokens.len() == 0 || tokens[tokens.len() - 1] != "1" {
            return false
        }
        parts_option := function_pointer_parts(word.clone())
        when parts_option.is_none() {
            return false
        }
        parts := parts_option.unwrap()
        mut index: u64 = 0
        for part in parts.clone() {
            index += 1
            // The last part is the result, which is empty when there is none.
            when index == parts.len() {
                when !part.is_empty() && !c_scalar_or_pointer(part.clone()) && !self.c_record_word_ok(part) {
                    return false
                }
            } else {
                when !c_scalar_or_pointer(part) {
                    return false
                }
            }
        }
        return true
    }
}

// `R0247` for an `extern "C"` signature with a value the C ABI does not pass, at the function's span.
fun c_abi_error(start: u64, end: u64) -> String {
    return diagnostic("R0247", start, end, String("`extern \"C\"` supports scalar values, one-field scalar records, and packed integer/float `#[repr(C)]` records of 1, 2, 4, or 8 bytes"), String("use scalar values, a one-field scalar record, or an integer record whose C layout is 1, 2, 4, or 8 bytes"))
}

// `R0247` for an `extern "C"` function named `main`, which the Ryn program must define.
fun extern_main_error(start: u64, end: u64) -> String {
    return diagnostic("R0247", start, end, String("`main` must be defined by the Ryn program, not imported from C"), String(""))
}

// `R0248` for a raw pointer result that is the address of a local, at the returned expression's span.
fun raw_local_error(start: u64, end: u64) -> String {
    return diagnostic("R0248", start, end, String("a raw pointer to a local value cannot escape its stack frame"), String("return a pointer that was passed in, or allocate storage that outlives the function"))
}

// `R0248` for a reference result that does not come from a reference parameter, at the returned expression's span.
fun local_reference_error(start: u64, end: u64) -> String {
    return diagnostic("R0248", start, end, String("a reference to a local value cannot escape its stack frame"), String("return a reference derived directly from a reference parameter"))
}

// `R0206` for `&` of an operand that is neither a local nor a borrowed slice element, at the `&`'s span.
fun address_operand_error(start: u64, end: u64) -> String {
    return diagnostic("R0206", start, end, String("address-of currently requires a local variable or a borrowed slice element"), String(""))
}

// `R0206` for an assignment through a shared reference, at the assignment's span.
fun shared_assign_error(start: u64, end: u64) -> String {
    return diagnostic("R0206", start, end, String("cannot assign through a shared reference"), String("create the reference with `&mut value`"))
}

// `R0251` for a reference that comes to point at a local of a deeper block, at the assignment's span.
fun reference_escape_error(start: u64, end: u64) -> String {
    return diagnostic("R0251", start, end, String("a reference to a local value would outlive its block"), String("keep the reference within the block that declares the value, or declare the value in the outer block"))
}

// `R0248` for `&raw` of a local of a deeper block assigned in place, at the assignment's span.
fun raw_pointer_outlives_error(start: u64, end: u64) -> String {
    return diagnostic("R0248", start, end, String("a raw pointer to a local value would outlive its block"), String("declare the value in the block where the pointer is used"))
}

// `R0240` for a borrowed slice bound to a name, at the value.
fun slice_binding_error(start: u64, end: u64) -> String {
    return diagnostic("R0240", start, end, String("a borrowed slice cannot be stored in a local binding"), String("use the slice immediately or pass it to a function"))
}

// `R0250` for a reference bound from a slice element whose source is not a known local or parameter, at the `let`.
fun unknown_provenance_error(start: u64, end: u64) -> String {
    return diagnostic("R0250", start, end, String("cannot store a reference with unknown lifetime provenance"), String("bind references only when their source is a known local or parameter"))
}

// `R0248` for a structure result that holds the address of a local, at the first field's value.
fun raw_result_local_error(start: u64, end: u64) -> String {
    return diagnostic("R0248", start, end, String("a raw pointer to a local value would outlive its function"), String("return a pointer to memory that outlives the call, such as an allocation or a parameter"))
}

// `R0252` for a raw pointer that comes to point at a local of a deeper block, at the assignment's span.
fun raw_escape_error(start: u64, end: u64) -> String {
    return diagnostic("R0252", start, end, String("a raw pointer to a local value would outlive its block"), String("keep the pointer within the block that declares the value, or declare the value in the outer block"))
}

// `R0249` for a use of a local while a mutable reference to it is in scope, at the use's span.
fun borrowed_use_error(start: u64, end: u64) -> String {
    return diagnostic("R0249", start, end, String("cannot use a value while a mutable reference to it is active"), String("use the reference instead, or end its scope before using the value"))
}

// `R0249` for a move of a local while a reference to it is in scope, at the moved value's span.
fun borrowed_move_error(start: u64, end: u64) -> String {
    return diagnostic("R0249", start, end, String("cannot move a value while a reference to it is active"), String("end the reference's scope before moving this value"))
}

// `R0249` for an assignment to a borrowed local, at the assignment's span.
fun borrowed_assign_error(start: u64, end: u64) -> String {
    return diagnostic("R0249", start, end, String("cannot assign to a value while it is borrowed"), String("write through the active mutable reference, or end the reference's scope first"))
