// The types a custom destructor's structure may have as fields: scalars, raw pointers and `String`.
fun destructor_field_type(ty: String) -> bool {
    when ty.starts_with("RawPointer ") || ty == "OwnedString" {
        return true
    }
    return scalar_type_name(ty.clone()).is_some() && ty != "Str"
}

// `R0255` for a custom destructor on a structure whose layout the destructor cannot release, at the structure.
fun destructor_layout_error(start: u64, end: u64) -> String {
    return diagnostic("R0255", start, end, String("custom destructors currently require non-`repr(C)` structs with scalar or raw-pointer fields"), String(""))
}

// `R0255` for an owned field moved out of a value with a custom destructor, at the field expression's span.
fun destructor_field_error(start: u64, end: u64) -> String {
    return diagnostic("R0255", start, end, String("cannot move an owned field out of a value with a custom destructor"), String("use `.clone()` to copy the field instead"))
}

// `R0210` for a call of `module::item` that the program does not declare, with the closest function name as a hint.
fun unknown_module_function_error(name: String, suggestion: String, start: u64, end: u64) -> String {
    mut message := String("unknown function `")
    message.append(name)
    message.append("`")
    mut help := String("")
    when !suggestion.is_empty() {
        help = String("did you mean `")
        help.append(suggestion)
        help.append("`?")
    }
    return diagnostic("R0210", start, end, message, help)
}

// `R0227` for a structure that the program does not declare to the module that names it, at the literal.
fun unknown_structure_error(name: String, start: u64, end: u64) -> String {
    mut message := String("unknown structure `")
    message.append(name)
    message.append("`")
    return diagnostic("R0227", start, end, message, String("declare the structure before constructing it"))
}

// `R0210` for a call of a name that is no function, with the hint the bootstrap gives for a bare variant name.
fun unknown_function_error(name: String, start: u64, end: u64) -> String {
    mut message := String("unknown function `")
    message.append(name.clone())
    message.append("`")
    return diagnostic("R0210", start, end, message, bare_variant_hint(name))
}

// `R0204` for a method that takes `mut self` called on a receiver whose root binding is not `mut`.
fun mutable_receiver_error(name: String, start: u64, end: u64) -> String {
    mut message := String("method `")
    message.append(name)
    message.append("` requires a mutable receiver")
    return diagnostic("R0204", start, end, message, String("declare the receiver's root binding with `mut`"))
}

// `R0204` for a `String` method that changes the string, called on a binding that is not `mut`.
fun mutable_string_error(name: String, start: u64, end: u64) -> String {
    mut message := String("method `")
    message.append(name)
    message.append("` requires a mutable String")
    return diagnostic("R0204", start, end, message, String("declare the receiver's root binding with `mut`"))
}

// `R0426` for a field that its structure does not mark `pub`, read from another module, at the field's name.
fun private_field_error(structure: String, name: String, start: u64, end: u64) -> String {
    mut message := String("field `")
    message.append(name)
    message.append("` of `")
    message.append(structure)
    message.append("` is private")
    return diagnostic("R0426", start, end, message, String("mark the field `pub` to read it outside its module"))
}

// `R0425` for a method that its `extend` block does not mark `pub`, called from another module, at the call.
fun private_method_error(name: String, structure: String, start: u64, end: u64) -> String {
    mut message := String("method `")
    message.append(name)
    message.append("` is private to `")
    message.append(structure)
    message.append("`'s module")
    return diagnostic("R0425", start, end, message, String("mark the method `pub` inside its `extend` block"))
}

// `R0425` for a call to a function that its module does not make public, at the call's span.
fun private_function_error(name: String, start: u64, end: u64) -> String {
    mut message := String("function `")
    message.append(name)
    message.append("` is private to its module")
    return diagnostic("R0425", start, end, message, String(""))
}

// `R0208` for a `main` that takes parameters or returns a type other than `i32`, at the function's span.
fun main_signature_error(start: u64, end: u64) -> String {
    return diagnostic("R0208", start, end, String("`main` must take no parameters and return either no value or `i32`"), String("use `fun main() { ... }` or `fun main() -> i32 { ... }`; move reusable work into another function"))
}

// `R0013` for `return VALUE` in a function without a `->` result type, at the `return`'s span.
fun return_value_error(name: String, start: u64, end: u64) -> String {
    message := String("a function with a return value must declare its type after `->`")
    mut help := String("add a `-> TYPE` result type to `")
    help.append(name)
    help.append("` before using `return VALUE`")
    return diagnostic("R0013", start, end, message, help)
}

// `R0214` for a function without a `->` result type that has a result expression, at the function's span.
fun result_without_type_error(name: String, start: u64, end: u64) -> String {
    mut message := String("function `")
    message.append(name.clone())
    message.append("` has a result expression but no `->` type")
    mut help := String("add a `-> TYPE` result type to `")
    help.append(name)
    help.append("` or remove its result expression")
    return diagnostic("R0214", start, end, message, help)
}

// `R0213` for a function with a result type whose body can end without returning a value, at the function's
// span. A scalar or string result type has a spelling here; other types are declined.
fun missing_return_error(return_ty: String, name: String, start: u64, end: u64) -> Option<String> {
    result := scalar_type_name(return_ty)
    when result.is_none() {
        return Option::None
    }
    result_text := result.unwrap()
    mut message := String("function `")
    message.append(name)
    message.append("` must return a `")
    message.append(result_text.clone())
    message.append("` value")
    mut help := String("return a `")
    help.append(result_text)
    help.append("` value from this function")
    return Option::Some(diagnostic("R0213", start, end, message, help))
}

// `R0201` for a function whose name an earlier function of the program already has, at the function's span.
fun duplicate_function_error(name: String, start: u64, end: u64) -> String {
    mut message := String("duplicate function `")
    message.append(name)
    message.append("`")
    return diagnostic("R0201", start, end, message, String("give each function a unique name; function overloading is not supported"))
}

// `R0229` for a structure literal that leaves out `field`, at the literal's span.
fun missing_field_error(field: String, literal: String, start: u64, end: u64) -> String {
    mut message := String("missing field `")
    message.append(field.clone())
    message.append("` in `")
    message.append(literal)
    message.append("` literal")
    mut help := String("provide a value for `")
    help.append(field)
    help.append("`")
    return diagnostic("R0229", start, end, message, help)
}

// `R0240` (ownership) for a use of an owned local after a top-level statement has moved it, at the use's span.
fun moved_value_error(start: u64, end: u64) -> String {
    return diagnostic("R0240", start, end, String("use of a moved value"), String("use `.clone()` before transferring ownership if both values are needed"))
}

// `R0240` for an owned value read through a reference by value, at the reference's span.
fun moved_out_of_reference_error(start: u64, end: u64) -> String {
    return diagnostic("R0240", start, end, String("cannot move a value out of a reference"), String("clone the value explicitly with `.clone()`"))
}

// `R0240` for a `choose` over a value read through a reference that binds an owned payload, at the reference's span.
fun owned_payload_through_reference_error(start: u64, end: u64) -> String {
    return diagnostic("R0240", start, end, String("cannot move an owned payload out of a reference"), String("bind only copy payloads when matching through a reference"))
}

// The number of `{}` placeholders in a format string of a built-in output call; `{{` and `}}` write a brace.
// `R0014` for any other brace, at the call.
fun output_placeholders(name: String, text: String, span: ast::Span) -> Result<u64, String> {
    mut placeholders: u64 = 0
    mut at: u64 = 0
    while at < text.len() {
        byte := text.byte_at(at)
        when at + 1 < text.len() && (byte == (123 as u8) || byte == (125 as u8)) && text.byte_at(at + 1) == byte {
            at += 2
            continue
        }
        when at + 1 < text.len() && byte == (123 as u8) && text.byte_at(at + 1) == (125 as u8) {
            placeholders += 1
            at += 2
            continue
        }
        when byte == (123 as u8) || byte == (125 as u8) {
            mut message := String("malformed format string in `")
            message.append(name)
            message.append("`")
            return Result::Err(diagnostic("R0014", span.start, span.end, message, String("use `{}` for a value and `{{` or `}}` for literal braces")))
        }
        at += 1
    }
    return Result::Ok(placeholders)
}

// `R0210` for a built-in output call whose first argument is not a string literal, with an example of the call.
// The pieces of a built-in output format string, split as the bootstrap's `lower_output_call` splits it: each run of
// literal text (with `{{` and `}}` written as one brace), and an empty piece for each `{}` placeholder. The string was
// checked by `output_placeholders`, so it is well formed here.
fun output_pieces(template: String) -> Vec<String> {
    mut pieces: Vec<String> = Vec()
    mut text := String("")
    mut run: u64 = 0
    mut at: u64 = 0
    while at < template.len() {
        byte := template.byte_at(at)
        when at + 1 < template.len() && (byte == (123 as u8) || byte == (125 as u8)) && template.byte_at(at + 1) == byte {
            text.append(template.slice(run, at + 1))
            at += 2
            run = at
            continue
        }
        when at + 1 < template.len() && byte == (123 as u8) && template.byte_at(at + 1) == (125 as u8) {
            text.append(template.slice(run, at))
            when text.len() > 0 {
                pieces.push(text.clone())
                text = String("")
            }
            pieces.push(String(""))
            at += 2
            run = at
            continue
        }
        at += 1
    }
    text.append(template.slice(run, template.len()))
    when text.len() > 0 {
        pieces.push(text)
    }
    return pieces
}

// Whether a type word is one of the numeric types that `eprint` and `write` format through `String(...)`.
fun numeric_word(ty: String) -> bool {
    when ty == "I8" || ty == "I16" || ty == "I32" || ty == "I64" || ty == "U8" || ty == "U16" || ty == "U32" || ty == "U64" || ty == "F32" || ty == "F64" {
        return true
    }
    return false
}

// The element word of an `Array <element> <length>` type word.
fun array_element_word(word: String) -> String {
    mut end: u64 = word.len()
    while end > 6 && word.slice(end - 1, end) != " " {
        end -= 1
    }
    return word.slice(6, end - 1)
}

fun output_format_error(name: String, start: u64, end: u64) -> String {
    mut message := String("`")
    message.append(name.clone())
    message.append("` expects a format string literal as its first argument")
    mut help := String("write `")
    help.append(name)
    help.append("(\"value: {}\", value)`")
    return diagnostic("R0210", start, end, message, help)
}

// `R0207` for a `when` condition that is not a `bool`, at the condition. `message` says whether it is a statement or an expression.
fun condition_type_error(message: String, start: u64, end: u64) -> String {
    return diagnostic("R0207", start, end, message, String("use a boolean expression, such as a comparison, for the condition"))
}

// `R0234` for `?` on a value that is neither an `Option` nor a `Result`, at the `?` expression.
fun propagate_operand_error(start: u64, end: u64) -> String {
    return diagnostic("R0234", start, end, String("the `?` operator requires an `Option<T>` or `Result<T, E>` value"), String(""))
}

// `R0234` for `?` in a function that does not return an `Option` or `Result`, at the `?` expression.
fun propagate_return_error(start: u64, end: u64) -> String {
    return diagnostic("R0234", start, end, String("`?` can only be used in a function returning the matching `Option` or `Result` type"), String(""))
}

// `R0234` for `?` in a function that returns the other family, at the `?` expression.
fun propagate_family_error(start: u64, end: u64) -> String {
    return diagnostic("R0234", start, end, String("the enclosing function must return the same generic type used with `?`"), String(""))
}

// `R0203` for `null` where no raw pointer type is expected, at the `null`.
fun null_context_error(start: u64, end: u64) -> String {
    return diagnostic("R0203", start, end, String("`null` needs a raw pointer type from its context"), String("pass it where a `*T` is expected, assign it to a `*T` variable, or write `(0 as u64) as *T`"))
}

// `R0255` for a call of a structure's destructor, which Ryn Guard runs by itself, at the call.
fun destructor_call_error(start: u64, end: u64) -> String {
    return diagnostic("R0255", start, end, String("destructor functions are called automatically by Ryn Guard"), String(""))
}

// `R0257` for a literal index that an array of `length` elements has no element for, at the indexing expression.
fun index_out_of_bounds_error(index: u64, length: u64, start: u64, end: u64) -> String {
    mut message := String("array index ")
    message.append(num(index))
    message.append(" is out of bounds for an array of length ")
    message.append(num(length))
    return diagnostic("R0257", start, end, message, String("valid indices are 0 up to the length minus one"))
}

// `R0208` for a format string whose placeholders do not match the values of a built-in output call, at the call.
fun output_arity_error(name: String, placeholders: u64, values: u64, start: u64, end: u64) -> String {
    mut message := String("`")
    message.append(name)
    message.append("` format string has ")
    message.append(num(placeholders))
    message.append(" placeholder(s) but ")
    message.append(num(values))
    message.append(" value(s) were given")
    return diagnostic("R0208", start, end, message, String(""))
}

// `R0249` for a reference argument that overlaps another reference argument of the same call, at the argument's span.
fun conflicting_argument_error(start: u64, end: u64) -> String {
    return diagnostic("R0249", start, end, String("conflicting references to the same value in one call"), String("avoid overlapping a mutable borrow with any other reference to this value"))
}

// `R0240` for a raw pointer used after the value it points at was moved out of its owner, at the pointer's span.
fun moved_raw_pointer_error(start: u64, end: u64) -> String {
    return diagnostic("R0240", start, end, String("use of a raw pointer to a moved value"), String("the pointer's target was moved out; point at the new owner, or reassign the value before using the pointer"))
}

// `R0202` for a collection loop variable whose name is already declared, at the variable's span.
fun collection_loop_redeclared(name: String, start: u64, end: u64) -> String {
    mut message := String("`")
    message.append(name)
    message.append("` is already declared in this scope")
    return diagnostic("R0202", start, end, message, String("choose a unique name for the collection loop variable"))
}

// `R0206` for a `for element in` collection that is none of the iterable types, at the collection's
// span. A scalar collection has a spelling here; other types are declined.
fun iterable_error(found: String, start: u64, end: u64) -> Option<String> {
    found_name := scalar_type_name(found)
    when found_name.is_none() {
        return Option::None
    }
    mut message := String("`for element in ...` requires a Vec, String, str, or range, found `")
    message.append(found_name.unwrap())
    message.push('`')
    return Option::Some(diagnostic("R0206", start, end, message, String("iterate a `Vec<T>`, `String`, `str`, or range value directly, or use a numeric range with `..`")))
}

// `R0202` for a range loop variable whose name is already declared, at the variable's span.
fun range_loop_redeclared(name: String, start: u64, end: u64) -> String {
    mut message := String("`")
    message.append(name)
    message.append("` is already declared in this scope")
    return diagnostic("R0202", start, end, message, String("choose a unique name for the range loop variable"))
}

// `R0206` for a range bound that is not an integer, at the loop variable's span. Integer bounds
// return `None`, and so does a type with no spelling here.
fun range_bound_error(found: String, start: u64, end: u64) -> Option<String> {
    when is_integer_word(found.clone()) {
        return Option::None
    }
    found_name := scalar_type_name(found)
    when found_name.is_none() {
        return Option::None
    }
    mut message := String("`for` range bounds must be integers, found `")
    message.append(found_name.unwrap())
    message.push('`')
    return Option::Some(diagnostic("R0206", start, end, message, String("use matching signed or unsigned integer bounds for the range")))
}

// `R0206` for range bounds of different integer types, at the loop variable's span.
fun range_mismatch_error(first: String, second: String, start: u64, end: u64) -> Option<String> {
    first_name := scalar_type_name(first)
    second_name := scalar_type_name(second)
    when first_name.is_none() || second_name.is_none() {
        return Option::None
    }
    mut message := String("`for` range bounds must have the same integer type, found `")
    message.append(first_name.unwrap())
    message.append("` and `")
    message.append(second_name.unwrap())
    message.push('`')
    return Option::Some(diagnostic("R0206", start, end, message, String("use the same integer type for both range bounds")))
}

// `R0206` for `&&` or `||` with an operand that is not `bool`, at the span of the first such operand
// (`bad`). Operands of other types have no spelling here, so they are declined.
fun logical_error(left: String, right: String, bad: ast::Span) -> Option<String> {
    left_name := scalar_type_name(left)
    right_name := scalar_type_name(right)
    when left_name.is_none() || right_name.is_none() {
        return Option::None
    }
    return operator_error("logical operators require `bool` operands,", left_name.unwrap(), right_name.unwrap(), "use boolean values or comparisons with `&&` and `||`", bad)
}

// `R0206` for a unary operator applied to a value it does not accept, at the operation's span.
fun unary_diagnostic(message: str, help: str, start: u64, end: u64) -> String {
    return diagnostic("R0206", start, end, String(message), String(help))
}

// The scalar operand types that `==` and `!=` accept.
fun is_equality_word(ty: String) -> bool {
    return is_numeric_word(ty.clone()) || ty == "Str" || ty == "OwnedString" || ty == "Char" || ty == "Bool"
}

fun is_bitwise_op(op: String) -> bool {
    return op == "BitAnd" || op == "BitXor" || op == "BitOr" || op == "Shl" || op == "Shr"
}

fun is_shift_op(op: String) -> bool {
    return op == "Shl" || op == "Shr"
}

fun is_comparison(op: String) -> bool {
    return op == "Eq" || op == "Ne" || op == "Lt" || op == "Le" || op == "Gt" || op == "Ge"
}

fun is_logical(op: String) -> bool {
    return op == "And" || op == "Or"
}

fun is_integer_word(ty: String) -> bool {
    return ty == "I8" || ty == "I16" || ty == "I32" || ty == "I64" || ty == "U8" || ty == "U16" || ty == "U32" || ty == "U64"
}

// The enum id of an `Enum <id>` type word.
fun enum_id_of(ty: String) -> Option<u64> {
    when ty.len() <= 5 || ty.slice(0, 5) != "Enum " {
        return Option::None
    }
    parsed := ty.slice(5, ty.len()).try_parse::<u64>()
    when parsed.is_none() {
        return Option::None
    }
    return Option::Some(parsed.unwrap())
}

// Types whose values own storage and are dropped at the end of their scope.
fun is_owned_type(ty: String) -> bool {
    return ty == "OwnedString" || enum_id_of(ty.clone()).is_some() || is_collection_word(ty.clone())
}

// A growable collection: `Vec <element>`, `Map <key> <value>`, or `Set <element> Bool`.
fun is_collection_word(ty: String) -> bool {
    return ty.starts_with("Vec ") || ty.starts_with("Map ") || ty.starts_with("Set ")
}

// The scope_path a declaration lives in: its name without the module path and last segment.
fun declaration_namespace(name: String, module_path: String) -> String {
    mut local := name.clone()
    when !module_path.is_empty() {
        mut prefix := module_path.clone()
        prefix.append("::")
        when !name.starts_with(prefix.clone()) {
            return String("")
        }
        local = name.slice(prefix.len(), name.len())
    }
    cut := last_index_of(local.clone(), String("::"))
    when cut.is_none() {
        return String("")
    }
    return local.slice(0, cut.unwrap())
}

// `scope_path::name`, or the name itself where there is no scope_path or it is already qualified.
fun qualified_in(scope_path: String, name: String) -> String {
    when scope_path.is_empty() || name.contains("::") {
        return String("")
    }
    mut out := scope_path
    out.append("::")
    out.append(name)
    return out
}

// The number of tokens before the end of the type word that starts at token `at`.
fun type_end(tokens: Vec<String>, at: u64) -> u64 {
    word := tokens[at].clone()
    when word == "Struct" || word == "Enum" {
        return at + 2
    }
    when word == "Vec" || word == "Slice" || word == "RawPointer" {
        return type_end(tokens.clone(), at + 1)
    }
    when word == "Reference" || word == "Array" {
        return type_end(tokens.clone(), at + 1) + 1
    }
    when word == "FunctionPointer" {
        count := tokens[at + 1].try_parse::<u64>().unwrap_or(0)
        mut position: u64 = at + 2
        mut seen: u64 = 0
        while seen < count {
            position = type_end(tokens.clone(), position)
            seen += 1
        }
        when tokens[position] == "+" {
            position = type_end(tokens.clone(), position + 1)
        } else {
            position += 1
        }
        return position + 1
    }
    when word == "Map" || word == "Set" {
        first := type_end(tokens.clone(), at + 1)
        return type_end(tokens.clone(), first)
    }
    return at + 1
}

fun join_tokens(tokens: Vec<String>, from: u64, to: u64) -> String {
    mut out := String("")
    mut at: u64 = from
    while at < to {
        when at > from {
            out.append(" ")
        }
        out.append(tokens[at].clone())
        at += 1
    }
    return out
}

// The key and value type words of a `Map <key> <value>` or `Set <element> Bool` word.
fun map_parts(ty: String) -> Option<Vec<String>> {
    when !ty.starts_with("Map ") && !ty.starts_with("Set ") {
        return Option::None
    }
    tokens := ty.split(" ")
    middle := type_end(tokens.clone(), 1)
    end := type_end(tokens.clone(), middle)
    mut parts: Vec<String> = Vec()
    parts.push(join_tokens(tokens.clone(), 1, middle))
    parts.push(join_tokens(tokens, middle, end))
    return Option::Some(parts)
}

// The parameter words and result word ("" for none) of a `FunctionPointer` word.
fun function_pointer_parts(ty: String) -> Option<Vec<String>> {
    when !ty.starts_with("FunctionPointer ") {
        return Option::None
    }
    tokens := ty.split(" ")
    count := tokens[1].try_parse::<u64>().unwrap_or(0)
    mut parts: Vec<String> = Vec()
    mut position: u64 = 2
    mut seen: u64 = 0
    while seen < count {
        next := type_end(tokens.clone(), position)
        parts.push(join_tokens(tokens.clone(), position, next))
        position = next
        seen += 1
    }
    when tokens[position] == "+" {
        end := type_end(tokens.clone(), position + 1)
        parts.push(join_tokens(tokens.clone(), position + 1, end))
    } else {
        parts.push(String(""))
    }
    return Option::Some(parts)
}

// The element type word and length of an `Array <element> <length>` word.
fun array_parts(ty: String) -> Option<Vec<String>> {
    when !ty.starts_with("Array ") {
        return Option::None
    }
    tokens := ty.split(" ")
    last := tokens.len() - 1
    mut parts: Vec<String> = Vec()
    parts.push(join_tokens(tokens.clone(), 1, last))
    parts.push(tokens[last].clone())
    return Option::Some(parts)
}

fun array_length_of(parts: Vec<String>) -> u64 {
    return parts[1].try_parse::<u64>().unwrap_or(0)
}

// The pointee of a `Reference <pointee> <mutable>` word.
fun reference_inner(ty: String) -> Option<String> {
    when !ty.starts_with("Reference ") {
        return Option::None
    }
    return Option::Some(ty.slice(10, ty.len() - 2))
}

fun reference_is_mutable(ty: String) -> bool {
    return ty.ends_with(" 1")
}

// The element type of a `Vec <element>` word.
fun vec_element_of(ty: String) -> Option<String> {
    when !ty.starts_with("Vec ") {
        return Option::None
    }
    return Option::Some(ty.slice(4, ty.len()))
}

fun is_signed_word(ty: String) -> bool {
    return ty == "I8" || ty == "I16" || ty == "I32" || ty == "I64"
}

// The IR word for a simple type name in the subset.
fun type_word(word: String) -> Result<String, String> {
    when word == "i32" {
        return Result::Ok(String("I32"))
    }
    when word == "i8" {
        return Result::Ok(String("I8"))
    }
    when word == "i16" {
        return Result::Ok(String("I16"))
    }
    when word == "i64" {
        return Result::Ok(String("I64"))
    }
    when word == "u8" {
        return Result::Ok(String("U8"))
    }
    when word == "u16" {
        return Result::Ok(String("U16"))
    }
    when word == "u32" {
        return Result::Ok(String("U32"))
    }
    when word == "u64" {
        return Result::Ok(String("U64"))
    }
    when word == "str" {
        return Result::Ok(String("Str"))
    }
    when word == "bool" {
        return Result::Ok(String("Bool"))
    }
    when word == "f32" {
        return Result::Ok(String("F32"))
    }
    when word == "f64" {
        return Result::Ok(String("F64"))
    }
    when word == "char" {
        return Result::Ok(String("Char"))
    }
    when word == "String" {
        return Result::Ok(String("OwnedString"))
    }
    mut message := String("type ")
    message.append(word)
    return Result::Err(unsupported(message))
}

fun ryn_preamble_words() -> Vec<String> {
    mut items: Vec<String> = Vec()
    items.push(String("I8"))
    items.push(String("I16"))
    items.push(String("I32"))
    items.push(String("I64"))
    items.push(String("U8"))
    items.push(String("U16"))
    items.push(String("U32"))
    items.push(String("U64"))
    items.push(String("F32"))
    items.push(String("F64"))
    items.push(String("OwnedString"))
    return items
}

fun text_part(text: String) -> Result<String, String> {
    return Result::Ok(join(words2(String("Text"), length_prefixed(text))))
}

fun enum_info(name: String, names: Vec<String>, counts: Vec<u64>, fields: Vec<String>) -> EnumInfo {
    return EnumInfo { name: name, variant_names: names, variant_counts: counts, field_types: fields }
}

// `$RynOption#<name>`: `Some(payload)` and `None`, as the bootstrap compiler registers it.
fun option_info(name: String, payload: String) -> EnumInfo {
    mut names: Vec<String> = Vec()
    names.push(String("Some"))
    names.push(String("None"))
    mut counts: Vec<u64> = Vec()
    counts.push(1)
    counts.push(0)
    mut fields: Vec<String> = Vec()
    fields.push(payload)
    return enum_info(name, names, counts, fields)
}

// `$RynResult#...`: `Ok(ok)` and `Err(err)`.
fun result_info(name: String, ok: String, err: String) -> EnumInfo {
    mut names: Vec<String> = Vec()
    names.push(String("Ok"))
    names.push(String("Err"))
    mut counts: Vec<u64> = Vec()
    counts.push(1)
    counts.push(1)
    mut fields: Vec<String> = Vec()
    fields.push(ok)
    fields.push(err)
    return enum_info(name, names, counts, fields)
}

fun is_option_payload(info: EnumInfo, payload: String) -> bool {
    return info.name.starts_with("$RynOption") && info.variant_names.len() == 2 && info.variant_names[0] == "Some" && info.variant_counts[0] == 1 && info.field_types[0] == payload && info.variant_names[1] == "None" && info.variant_counts[1] == 0
}

fun any_option_payload(enums: Vec<EnumInfo>, payload: String) -> bool {
    for info in enums {
        when is_option_payload(info, payload.clone()) {
            return true
        }
    }
    return false
}

fun any_named(enums: Vec<EnumInfo>, name: String) -> bool {
    for info in enums {
        when info.name == name {
            return true
        }
    }
    return false
}

// Appends the generated enums `sema::analyze` registers after the program's own: the option
// types for `find`, files, and parsing, and a result type for every pair of numeric types.
fun with_builtin_enums(program_enums: Vec<EnumInfo>) -> Vec<EnumInfo> {
    mut enums: Vec<EnumInfo> = program_enums
    when !any_option_payload(enums.clone(), String("U64")) {
        enums.push(option_info(String("$RynOption#FindU64"), String("U64")))
    }
    when !any_option_payload(enums.clone(), String("OwnedString")) {
        enums.push(option_info(String("$RynOption#FileString"), String("OwnedString")))
    }
    mut try_parse: Vec<String> = Vec()
    try_parse.push(String("I8"))
    try_parse.push(String("I16"))
    try_parse.push(String("I32"))
    try_parse.push(String("I64"))
    try_parse.push(String("U8"))
    try_parse.push(String("U16"))
    try_parse.push(String("U32"))
    try_parse.push(String("U64"))
    try_parse.push(String("F32"))
    try_parse.push(String("F64"))
    try_parse.push(String("Bool"))
    try_parse.push(String("Char"))
    mut index: u64 = 0
    while index < try_parse.len() {
        when !any_option_payload(enums.clone(), try_parse[index].clone()) {
            mut name := String("$RynOption#TryParse")
            name.append(try_parse[index].clone())
            enums.push(option_info(name, try_parse[index].clone()))
        }
        index += 1
    }
    primitive := ryn_preamble_words()
    mut left: u64 = 0
    while left < primitive.len() {
        mut right: u64 = 0
        while right < primitive.len() {
            mut name := String("$RynResult#")
            name.append(String(left))
            name.append("#")
            name.append(String(right))
            when !any_named(enums.clone(), name.clone()) {
                enums.push(result_info(name, primitive[left].clone(), primitive[right].clone()))
            }
            right += 1
        }
        left += 1
    }
    mut parse_index: u64 = 0
    while parse_index < 10 {
        mut name := String("$RynResult#Parse")
        name.append(String(parse_index))
        name.append("String")
        when !any_named(enums.clone(), name.clone()) {
            enums.push(result_info(name, primitive[parse_index].clone(), String("OwnedString")))
        }
        parse_index += 1
    }
    return enums
}

extend Lowering {
    // Adds a local to the visible scope, reusing a hidden entry when one is there.
    fun declare(mut self, local: Local) {
        slot_index := self.visible
        when slot_index < self.locals.len() {
            self.locals.set(slot_index, local)
        } else {
            self.locals.push(local)
        }
        self.visible += 1
    }

    fun find(self, name: String) -> Result<u64, String> {
        mut index: u64 = self.visible
        while index > 0 {
            index -= 1
            when self.locals[index].name == name {
                return Result::Ok(index)
            }
        }
        return Result::Err(unsupported("unknown name"))
    }

    // `R0203` for a name that is no local: a typo suggestion from the visible locals.
    fun unknown_variable(self, name: String, span: ast::Span) -> String {
        message := String("unknown variable `")
        mut text := message
        text.append(name.clone())
        text.push('`')
        mut help := bare_variant_hint(name.clone())
        when help.is_empty() {
            mut candidates: Vec<String> = Vec()
            mut index: u64 = 0
            while index < self.visible {
                candidate := self.locals[index].name.clone()
                mut seen := false
                for earlier in candidates.clone() {
                    when earlier == candidate {
                        seen = true
                    }
                }
                when !seen {
                    candidates.push(candidate)
                }
                index += 1
            }
            suggestion := closest_name(name, candidates)
            when !suggestion.is_empty() {
                help = String("did you mean `")
                help.append(suggestion)
                help.append("`?")
            }
        }
        return diagnostic("R0203", span.start, span.end, text, help)
    }

    fun declared(self, name: String) -> bool {
        mut index: u64 = 0
        while index < self.visible {
            when self.locals[index].name == name {
                return true
            }
            index += 1
        }
        return false
    }

    // Allocates the slots a value of `ty` takes, as `sema` does: `str` takes a pointer and a
    // length, and each scalar takes one. Each allocation adds one addressed entry.
    fun allocate(mut self, ty: String) -> Result<u64, String> {
        when struct_id_of(ty.clone()).is_some() {
            id := struct_id_of(ty).unwrap()
            base := self.next_slot
            mut field: u64 = 0
            while field < self.structs[id].field_types.len() {
                field_ty := self.structs[id].field_types[field].clone()
                allocated := self.allocate(field_ty)?
                field += 1
            }
            when !self.structs[id].drop_name.is_empty() {
                // The destructor consumes the whole value and releases its remaining
                // owned fields itself; only the destructor's own parameter keeps them.
                when self.structs[id].drop_name != self.current_function {
                    mut cleared: u64 = base
                    while cleared < self.next_slot {
                        self.owners.set(cleared, String(""))
                        cleared += 1
                    }
                }
                self.owners.set(base, struct_word(id))
            }
            return Result::Ok(base)
        }
        when array_parts(ty.clone()).is_some() {
            parts := array_parts(ty).unwrap()
            base := self.next_slot
            mut index: u64 = 0
            while index < array_length_of(parts.clone()) {
                allocated := self.allocate(parts[0].clone())?
                index += 1
            }
            return Result::Ok(base)
        }
        slot := self.next_slot
        self.addressed_types.push(String(""))
        when ty == "I8" || ty == "U8" {
            self.local_types.push(String("I8"))
            self.owners.push(String(""))
            self.next_slot += 1
            return Result::Ok(slot)
        }
        when ty == "I16" || ty == "U16" {
            self.local_types.push(String("I16"))
            self.owners.push(String(""))
            self.next_slot += 1
            return Result::Ok(slot)
        }
        when ty == "I32" || ty == "U32" {
            self.local_types.push(String("I32"))
            self.owners.push(String(""))
            self.next_slot += 1
            return Result::Ok(slot)
        }
        when ty == "I64" || ty == "U64" {
            self.local_types.push(String("I64"))
            self.owners.push(String(""))
            self.next_slot += 1
            return Result::Ok(slot)
        }
        when ty == "Bool" {
            self.local_types.push(String("I8"))
            self.owners.push(String(""))
            self.next_slot += 1
            return Result::Ok(slot)
        }
        when ty == "Char" {
            self.local_types.push(String("I32"))
            self.owners.push(String(""))
            self.next_slot += 1
            return Result::Ok(slot)
        }
        when ty == "F32" || ty == "F64" {
            self.local_types.push(ty.clone())
            self.owners.push(String(""))
            self.next_slot += 1
            return Result::Ok(slot)
        }
        when enum_id_of(ty.clone()).is_some() || is_collection_word(ty.clone()) {
            self.local_types.push(String("OwnedPtr"))
            self.owners.push(ty.clone())
            self.next_slot += 1
            return Result::Ok(slot)
        }
        when ty.starts_with("Reference ") || ty.starts_with("RawPointer ") || ty.starts_with("FunctionPointer ") {
            self.local_types.push(String("Ptr"))
            self.owners.push(String(""))
            self.next_slot += 1
            return Result::Ok(slot)
        }
        when ty.starts_with("Slice ") {
            self.local_types.push(String("Ptr"))
            self.owners.push(String(""))
            self.local_types.push(String("I64"))
            self.owners.push(String(""))
            self.next_slot += 2
            return Result::Ok(slot)
        }
        when ty == "OwnedString" {
            self.local_types.push(String("OwnedPtr"))
            self.owners.push(String("OwnedString"))
            self.next_slot += 1
            return Result::Ok(slot)
        }
        when ty == "Str" {
            self.local_types.push(String("Ptr"))
            self.owners.push(String(""))
            self.local_types.push(String("I64"))
            self.owners.push(String(""))
            self.next_slot += 2
            return Result::Ok(slot)
        }
        return Result::Err(unsupported("local type"))
    }

    fun annotation(self, index: u64) -> Result<String, String> {
        return self.resolve(index)
    }

    fun struct_names(self) -> Vec<String> {
        mut names: Vec<String> = Vec()
        mut id: u64 = 0
        while id < self.structs.len() {
            names.push(self.structs[id].name.clone())
            id += 1
        }
        return names
    }

    fun struct_id(self, name: String) -> Result<u64, String> {
        mut id: u64 = 0
        while id < self.structs.len() {
            when self.structs[id].name == name {
                return Result::Ok(id)
            }
            id += 1
        }
        // A module alias names the structure too: `lexer::Token`.
        aliased := self.named_word(name.clone())
        when aliased.is_ok() && struct_id_of(aliased.unwrap()).is_some() {
            return Result::Ok(struct_id_of(self.named_word(name)?).unwrap())
        }
        qualified := qualified_in(self.scope_path.clone(), name)
        when !qualified.is_empty() {
            return self.struct_id(qualified)
        }
        return Result::Err(unsupported("unknown structure"))
    }

    fun field_index(self, id: u64, name: String) -> Result<u64, String> {
        mut field: u64 = 0
        while field < self.structs[id].field_names.len() {
            when self.structs[id].field_names[field] == name {
                return Result::Ok(field)
            }
            field += 1
        }
        return Result::Err(unsupported("unknown field"))
    }

    // The slots a value of `ty` occupies: two for `str`, one for a scalar, and the sum for a structure.
    fun slot_count(self, ty: String) -> u64 {
        when ty == "Str" || ty.starts_with("Slice ") {
            return 2
        }
        when array_parts(ty.clone()).is_some() {
            parts := array_parts(ty).unwrap()
            return self.slot_count(parts[0].clone()) * array_length_of(parts)
        }
        when struct_id_of(ty.clone()).is_some() {
            id := struct_id_of(ty).unwrap()
            mut total: u64 = 0
            mut field: u64 = 0
            while field < self.structs[id].field_types.len() {
                total += self.slot_count(self.structs[id].field_types[field].clone())
                field += 1
            }
            return total
        }
        return 1
    }

    fun field_offset(self, id: u64, field: u64) -> u64 {
        mut offset: u64 = 0
        mut earlier: u64 = 0
        while earlier < field {
            offset += self.slot_count(self.structs[id].field_types[earlier].clone())
            earlier += 1
        }
        return offset
    }

    // The place a name, or a chain of field accesses on one, refers to.
    fun name_place(self, name: String) -> Result<Place, String> {
        index := self.find(name)?
        return Result::Ok(Place { slot: self.locals[index].slot, ty: self.locals[index].ty.clone(), mutable: self.locals[index].mutable })
    }

    fun field_step(self, base: Place, name: String) -> Result<Place, String> {
        mut base_ty := base.ty.clone()
        inner := reference_inner(base_ty.clone())
        when inner.is_some() {
            base_ty = inner.unwrap()
        }
        id := struct_id_of(base_ty.clone()).unwrap_or(0)
        when struct_id_of(base_ty.clone()).is_none() {
            return Result::Err(unsupported("field of a value that is not a structure"))
        }
        field := self.field_index(id, name)?
        offset := self.field_offset(id, field)
        return Result::Ok(Place { slot: base.slot + offset, ty: self.structs[id].field_types[field].clone(), mutable: base.mutable })
    }

    fun place_of(self, index: u64) -> Result<Place, String> {
        choose self.program.exprs[index] {
            ast::ExprTree::NameRef(name, span) => self.name_place(name),
            ast::ExprTree::FieldE(value, name, name_span, span) => self.field_of(value, name),
            _ => Result::Err(unsupported("place")),
        }
    }

    fun field_of(self, value: u64, name: String) -> Result<Place, String> {
        base := self.place_of(value)?
        return self.field_step(base, name)
    }

    // A field read is a read of its slots, with the span of the whole field expression.
    // The type of a `when` expression from its branches, when they say.
    fun if_type(self, then_value: u64, else_value: u64) -> Result<String, String> {
        ty := self.infer(then_value)?
        when !ty.is_empty() {
            return Result::Ok(ty)
        }
        return self.infer(else_value)
    }

    // `when c { a } else { b }` as a value: both branches have one type, which is the expected
    // type when there is one, else the branches' type, else i64.
    fun if_expression(mut self, condition: u64, then_value: u64, else_value: u64, expected: String) -> Result<Lowered, String> {
        test := self.condition_expression(condition)?
        when test.ty != "Bool" {
            // `R0207`: a scalar condition, at the condition.
            when scalar_type_name(test.ty.clone()).is_some() {
                condition_span := self.expr_span_of(condition)
                return Result::Err(condition_type_error(String("`when` expression condition must have type `bool`"), condition_span.start, condition_span.end))
            }
            return Result::Err(unsupported("condition is not a boolean"))
        }
        then_branch := self.moved_expression(then_value, expected)?
        else_branch := self.moved_expression(else_value, then_branch.ty.clone())?
        when else_branch.ty != then_branch.ty {
            return Result::Err(unsupported("branches of different types"))
        }
        ty := then_branch.ty.clone()
        return Result::Ok(Lowered { text: join(words5(String("If"), test.text, then_branch.text, else_branch.text, ty.clone())), ty: ty })
    }

    // Notes which reference parameter a returned value is, if it is one: the text is that of a lowered value.
    // Whether a reference result is derived directly from a reference parameter: the parameter itself, or an
    // element of a slice parameter. These are the only reference results the bootstrap accepts.
    fun reference_from_parameter(self, text: String, ty: String) -> bool {
        when !ty.starts_with("Reference ") {
            return false
        }
        mut slot_at: u64 = 1
        when text.starts_with("SliceElementAddress Local ") {
            slot_at = 2
        } else when !text.starts_with("Local ") {
            return false
        }
        parts := text.split(" ")
        slot := parts[slot_at].try_parse::<u64>().unwrap_or(0)
        mut position: u64 = 0
        while position < self.param_slots.len() {
            when self.param_slots[position] == slot {
                return true
            }
            position += 1
        }
        return false
    }

    fun note_return(mut self, text: String, ty: String) {
        mut found := String("")
        mut slot_at: u64 = 1
        mut direct := text.starts_with("Local ")
        when text.starts_with("SliceElementAddress Local ") {
            direct = true
            slot_at = 2
        }
        when ty.starts_with("Reference ") && direct {
            parts := text.split(" ")
            slot := parts[slot_at].try_parse::<u64>().unwrap_or(0)
            mut position: u64 = 0
            while position < self.param_slots.len() {
                when self.param_slots[position] == slot {
                    found = String(position)
                }
                position += 1
            }
        }
        self.returned_refs.push(found)
    }

    // A value held in a fresh slot while `defer` bodies run is returned from it: moved when it owns storage.
    fun returned_slot(self, slot: u64, start: u64, end: u64) -> String {
        when self.owns(self.return_ty.clone()) {
            return join(words3(String("Move"), num(slot), self.return_ty.clone()))
        }
        return join(words5(String("Local"), num(slot), self.return_ty.clone(), num(start), num(end)))
    }

    // The first visible local of the innermost scope, where the guard's scope drop starts.
    fun scope_floor(self) -> u64 {
        when self.scope_floors.is_empty() {
            return 0
        }
        return self.scope_floors[self.scope_floors.len() - 1]
    }

    fun open_frame(mut self) {
        self.frame_marks.push(self.defer_count)
    }

    // The first registered defer that belongs to frame `frame` or a later one.
    fun frame_start(self, frame: u64) -> u64 {
        when frame < self.frame_marks.len() {
            return self.frame_marks[frame]
        }
        return self.defer_count
    }

    // Lowers the defers from `start` on, last registered first, each in the locals it saw.
    fun run_defers(mut self, start: u64) -> Result<Vec<String>, String> {
        mut items: Vec<String> = Vec()
        mut index: u64 = self.defer_count
        while index > start {
            index -= 1
            body := self.defers[index].body.clone()
            outer_visible := self.visible
            outer_depth := self.loop_depth
            self.visible = self.defers[index].visible
            self.loop_depth = 0
            self.defer_depth += 1
            inline := self.inline(body)?
            self.defer_depth -= 1
            self.visible = outer_visible
            self.loop_depth = outer_depth
            for item in inline {
                items.push(item)
            }
        }
        return Result::Ok(items)
    }

    // Lowers a deferred body's statements as they are, without a scope of their own.
    fun inline(mut self, body: Vec<u64>) -> Result<Vec<String>, String> {
        start := self.statements.len()
        mut position: u64 = 0
        while position < body.len() {
            self.statement(body[position])?
            self.commit_moves()
            position += 1
        }
        mut reversed: Vec<String> = Vec()
        while self.statements.len() > start {
            reversed.push(self.statements.pop().unwrap())
        }
        mut items: Vec<String> = Vec()
        mut index: u64 = reversed.len()
        while index > 0 {
            index -= 1
            items.push(reversed[index].clone())
        }
        return Result::Ok(items)
    }

    // Closes the innermost frame: its defers, last registered first; they are forgotten after.
    fun close_frame(mut self) -> Result<Vec<String>, String> {
        mark := self.frame_marks[self.frame_marks.len() - 1]
        items := self.run_defers(mark)?
        self.defer_count = mark
        self.frame_marks.pop()
        return Result::Ok(items)
    }

    // Whether a value of `ty` owns storage: an owned string, an enum, or a structure with one.
    fun owns(self, ty: String) -> bool {
        when is_owned_type(ty.clone()) || self.has_destructor(ty.clone()) {
            return true
        }
        when array_parts(ty.clone()).is_some() {
            return self.owns(array_parts(ty).unwrap()[0].clone())
        }
        when struct_id_of(ty.clone()).is_some() {
            id := struct_id_of(ty).unwrap()
            mut field: u64 = 0
            while field < self.structs[id].field_types.len() {
                when self.owns(self.structs[id].field_types[field].clone()) {
                    return true
                }
                field += 1
            }
        }
        return false
    }

    // The owned parts of a value of `ty` stored at `base`, as (slot, owner type) pairs in slot order.
    fun owned_parts(self, ty: String, base: u64) -> Vec<String> {
        mut parts: Vec<String> = Vec()
        when is_owned_type(ty.clone()) || self.has_destructor(ty.clone()) {
            parts.push(num(base))
            parts.push(ty)
            return parts
        }
        when array_parts(ty.clone()).is_some() {
            pieces := array_parts(ty).unwrap()
            width := self.slot_count(pieces[0].clone())
            mut index: u64 = 0
            while index < array_length_of(pieces.clone()) {
                inner := self.owned_parts(pieces[0].clone(), base + index * width)
                for token in inner {
                    parts.push(token)
                }
                index += 1
            }
            return parts
        }
        when struct_id_of(ty.clone()).is_some() {
            id := struct_id_of(ty).unwrap()
            mut field: u64 = 0
            while field < self.structs[id].field_types.len() {
                inner := self.owned_parts(self.structs[id].field_types[field].clone(), base + self.field_offset(id, field))
                for token in inner {
                    parts.push(token)
                }
                field += 1
            }
        }
        return parts
    }

    // The first visible local of the innermost loop; 0 outside any loop.
    fun loop_floor(self) -> u64 {
        when self.loop_floors.is_empty() {
            return 0
        }
        return self.loop_floors[self.loop_floors.len() - 1]
    }

    // A value that is used by value: an owned string named here is moved out of its local.
    fun moved_expression(mut self, index: u64, expected: String) -> Result<Lowered, String> {
        choose self.program.exprs[index] {
            ast::ExprTree::NameRef(name, span) => self.moved_name(index, name, expected),
            ast::ExprTree::FieldE(value, name, name_span, span) => self.moved_field_checked(value, name, name_span, span, expected),
            ast::ExprTree::DerefE(pointer, span) => self.moved_dereference(pointer),
            _ => self.expression(index, expected),
        }
    }

    // A value read through a reference is copied, never moved out of it: an owned pointee is `R0240`, at the pointer.
    fun moved_dereference(mut self, pointer: u64) -> Result<Lowered, String> {
        lowered := self.dereference(pointer)?
        when self.owns(lowered.ty.clone()) {
            pointer_span := self.expr_span_of(pointer)
            return Result::Err(moved_out_of_reference_error(pointer_span.start, pointer_span.end))
        }
        return Result::Ok(lowered)
    }

    // The pointer of a dereference, when the value is read through a reference.
    fun dereferenced_pointer(self, index: u64) -> Option<u64> {
        choose self.program.exprs[index] {
            ast::ExprTree::DerefE(pointer, span) => Option::Some(pointer),
            _ => Option::None,
        }
    }

    // The scrutinee of a `choose`: a value read through a reference is matched in place, so it is not moved.
    fun matched_expression(mut self, index: u64) -> Result<Lowered, String> {
        when self.dereferenced_pointer(index).is_some() {
            return self.expression(index, String(""))
        }
        return self.moved_expression(index, String(""))
    }

    // Whether an arm of a `choose` over the enum `id` binds a payload that owns storage.
    fun arms_bind_owned(self, arms: Vec<u64>, id: u64) -> bool {
        mut position: u64 = 0
        while position < arms.len() {
            arm := self.program.arms[arms[position]]
            when arm.variant.is_some() {
                found := self.variant_index(id, arm.variant.unwrap())
                when found.is_ok() {
                    start := self.variant_field_start(id, found.unwrap())
                    mut binding: u64 = 0
                    while binding < arm.bindings.len() {
                        when self.owns(self.enums[id].field_types[start + binding].clone()) {
                            return true
                        }
                        binding += 1
                    }
                }
            }
            position += 1
        }
        return false
    }

    // A field of a local that owns storage is moved out of its slot when used by value.
    // `R0225` for a field that the structure of a local value does not declare, at the field's name span.
    // Tuples (their names start with `$`) and values that are not local structures are declined.
    fun unknown_field(self, value: u64, name: String, name_span: ast::Span) -> Option<String> {
        place := self.place_of(value)
        when place.is_err() {
            return Option::None
        }
        id := struct_id_of(place.unwrap().ty)
        when id.is_none() {
            return Option::None
        }
        definition := id.unwrap()
        when self.structs[definition].name.starts_with("$") || self.field_index(definition, name.clone()).is_ok() {
            return Option::None
        }
        return Option::Some(self.unknown_struct_field(definition, name, name_span.start, name_span.end))
    }

    // `R0426` for a field that its structure does not mark `pub`, read from another module, at the field's name.
    fun private_field(self, value: u64, name: String, name_span: ast::Span) -> Option<String> {
        place := self.place_of(value)
        when place.is_err() {
            return Option::None
        }
        return self.private_field_of(place.unwrap().ty, name, name_span.start, name_span.end)
    }

    // The same check for a field of a value of type `ty`, the field's name at `start`..`end`.
    fun private_field_of(self, ty: String, name: String, start: u64, end: u64) -> Option<String> {
        id := struct_id_of(ty)
        when id.is_none() {
            return Option::None
        }
        definition := id.unwrap()
        when self.structs[definition].name.starts_with("$") || self.structs[definition].module_path == self.module {
            return Option::None
        }
        field := self.field_index(definition, name.clone())
        when field.is_err() || self.structs[definition].field_public[field.unwrap()] == 1 {
            return Option::None
        }
        return Option::Some(private_field_error(self.structs[definition].name.clone(), name, start, end))
    }

    // `R0225` for a field that structure `definition` does not declare, at `start`..`end`.
    fun unknown_struct_field(self, definition: u64, name: String, start: u64, end: u64) -> String {
        mut message := String("structure `")
        message.append(self.structs[definition].name.clone())
        message.append("` has no field `")
        message.append(name.clone())
        message.append("`")
        suggestion := closest_name(name, self.structs[definition].field_names.clone())
        mut help := String("use a field declared by this structure")
        when !suggestion.is_empty() {
            help = String("did you mean `")
            help.append(suggestion)
            help.append("`?")
        }
        return diagnostic("R0225", start, end, message, help)
    }

    // Whether `name` is an owned field of a local whose structure has a custom destructor.
    fun owned_field_of_destructor(self, value: u64, name: String) -> bool {
        place := self.place_of(value)
        when place.is_err() {
            return false
        }
        id := struct_id_of(place.unwrap().ty)
        when id.is_none() {
            return false
        }
        when self.structs[id.unwrap()].drop_name.is_empty() {
            return false
        }
        field := self.field_index(id.unwrap(), name)
        when field.is_err() {
            return false
        }
        field_ty := self.structs[id.unwrap()].field_types[field.unwrap()].clone()
        return self.owns(field_ty)
    }

    fun field_read_checked(mut self, value: u64, name: String, name_span: ast::Span, span: ast::Span, expected: String) -> Result<Lowered, String> {
        unknown := self.unknown_field(value, name.clone(), name_span)
        when unknown.is_some() {
            return Result::Err(unknown.unwrap())
        }
        private := self.private_field(value, name.clone(), name_span)
        when private.is_some() {
            return Result::Err(private.unwrap())
        }
        return self.field_read(value, name, span, expected)
    }

    fun moved_field_checked(mut self, value: u64, name: String, name_span: ast::Span, span: ast::Span, expected: String) -> Result<Lowered, String> {
        unknown := self.unknown_field(value, name.clone(), name_span)
        when unknown.is_some() {
            return Result::Err(unknown.unwrap())
        }
        private := self.private_field(value, name.clone(), name_span)
        when private.is_some() {
            return Result::Err(private.unwrap())
        }
        // `R0255`: an owned field of a value with a custom destructor is not moved out on its own.
        when self.owned_field_of_destructor(value, name.clone()) {
            return Result::Err(destructor_field_error(span.start, span.end))
        }
        return self.moved_field(value, name, span, expected)
    }

    fun moved_field(mut self, value: u64, name: String, span: ast::Span, expected: String) -> Result<Lowered, String> {
        through := self.reference_field(value, name.clone(), span)?
        when through.is_some() || self.place_of(value).is_err() {
            return self.field_read(value, name, span, expected)
        }
        place := self.field_of(value, name.clone())?
        when !self.owns(place.ty.clone()) {
            return self.field_read(value, name, span, expected)
        }
        when !expected.is_empty() && expected != place.ty {
            return Result::Err(unsupported("owned field where another type is expected"))
        }
        return Result::Ok(Lowered { text: join(words3(String("Move"), num(place.slot), place.ty.clone())), ty: place.ty })
    }

    fun moved_name(mut self, expression: u64, name: String, expected: String) -> Result<Lowered, String> {
        when self.borrowed_name(name.clone(), true) {
            use_span := self.expr_span_of(expression)
            return Result::Err(borrowed_use_error(use_span.start, use_span.end))
        }
        when self.is_moved(name.clone()) {
            span := self.expr_span_of(expression)
            return Result::Err(moved_value_error(span.start, span.end))
        }
        when name == "null" && self.find(name.clone()).is_err() {
            null_span := self.expr_span_of(expression)
            return self.null_expression(expected, null_span)
        }
        when self.find(name.clone()).is_err() && expected.starts_with("FunctionPointer ") {
            return self.function_address(name, expected)
        }
        found := self.find(name.clone())
        when found.is_err() && name != "null" {
            name_span := self.expr_span_of(expression)
            return Result::Err(self.unknown_variable(name, name_span))
        }
        when found.is_err() {
            return Result::Err(unsupported("unknown name"))
        }
        index := found.unwrap()
        ty := self.locals[index].ty.clone()
        when !self.owns(ty.clone()) {
            return self.expression(expression, expected)
        }
        when !expected.is_empty() && expected != ty {
            return Result::Err(unsupported("owned string where another type is expected"))
        }
        when self.borrowed_name(name.clone(), false) {
            move_span := self.expr_span_of(expression)
            return Result::Err(borrowed_move_error(move_span.start, move_span.end))
        }
        slot := self.locals[index].slot
        // A move holds from the end of its statement on (see `commit_moves`).
        moved := self.expr_span_of(expression)
        self.pending_moves.push(MovedValue { name: name, slot: slot, start: moved.start, end: moved.end })
        return Result::Ok(Lowered { text: join(words3(String("Move"), num(slot), ty.clone())), ty: ty })
    }

    // Whether the local that `name` now refers to has been moved: in an earlier statement, or earlier in this one.
    fun is_moved(self, name: String) -> bool {
        found := self.find(name.clone())
        when found.is_err() {
            return false
        }
        return self.is_moved_local(found.unwrap())
    }

    // A raw pointer whose target local has been moved out of its owner, and not reassigned since.
    fun raw_target_moved(self, name: String) -> bool {
        found := self.find(name.clone())
        when found.is_err() || !self.locals[found.unwrap()].ty.starts_with("RawPointer ") {
            return false
        }
        source := self.origin_of_name(name)
        when source.is_none() {
            return false
        }
        return self.is_moved_local(source.unwrap())
    }

    // Whether the local at `index` has been moved, matched by its name and slot.
    fun is_moved_local(self, index: u64) -> bool {
        name := self.locals[index].name.clone()
        slot := self.locals[index].slot
        mut position: u64 = 0
        while position < self.moved_names.len() {
            when self.moved_names[position].name == name && self.moved_names[position].slot == slot {
                return true
            }
            position += 1
        }
        position = 0
        while position < self.pending_moves.len() {
            when self.pending_moves[position].name == name && self.pending_moves[position].slot == slot {
                return true
            }
            position += 1
        }
        return false
    }

    // The moves of `second` after those of `first`, without merging: a loop's `continue` states keep every move.
    fun concat_moves(self, first: Vec<MovedValue>, second: Vec<MovedValue>) -> Vec<MovedValue> {
        mut merged := first
        for moved in second {
            merged.push(moved)
        }
        return merged
    }

    // The moves whose local is still the one that was moved: a shadowed name that went out of scope is not.
    fun visible_moves(self, moved: Vec<MovedValue>) -> Vec<MovedValue> {
        mut kept: Vec<MovedValue> = Vec()
        for item in moved {
            found := self.find(item.name.clone())
            when found.is_ok() && self.locals[found.unwrap()].slot == item.slot {
                kept.push(item)
            }
        }
        return kept
    }

    // Whether the local that `name` now refers to is borrowed by a reference in scope (a mutable one, if asked).
    fun borrowed_name(self, name: String, mutable_only: bool) -> bool {
        found := self.find(name)
        when found.is_err() {
            return false
        }
        slot := self.locals[found.unwrap()].slot
        mut position: u64 = 0
        while position < self.borrows.len() {
            when self.borrows[position].slot == slot && (!mutable_only || self.borrows[position].mutable) {
                return true
            }
            position += 1
        }
        return false
    }

    // The references that are declared at `start` or later go out of scope with their block.
    fun drop_borrows_from(mut self, start: u64) {
        mut kept: Vec<ActiveBorrow> = Vec()
        for item in self.borrows.clone() {
            when item.holder < start {
                kept.push(item)
            }
        }
        self.borrows = kept
    }

    // The local that a reference or raw pointer value points at, as an index into `locals`, when it is known:
    // `&name`, `&mut name`, `&raw mut name`, or a reference local whose origin is known.
    fun pointed_local(self, value: u64) -> Option<u64> {
        choose self.program.exprs[value] {
            ast::ExprTree::AddressOfE(mutable, raw, inner, span) => self.local_named(inner),
            ast::ExprTree::NameRef(name, span) => self.origin_of_name(name),
            ast::ExprTree::CallE(name, type_arguments, arguments, span) => self.call_origin(name, arguments),
            _ => Option::None,
        }
    }

    // The local that a call's reference result points at: the argument for the parameter that the callee returns.
    fun call_origin(self, name: String, arguments: Vec<u64>) -> Option<u64> {
        found := self.signature_index(name)
        when found.is_err() {
            return Option::None
        }
        returned := self.signatures[found.unwrap()].return_param
        when returned.is_none() {
            return Option::None
        }
        position := returned.unwrap()
        when position >= arguments.len() {
            return Option::None
        }
        return self.pointed_local(arguments[position])
    }

    // The parameter that a function returns, when it returns a reference and every `return` names that parameter.
    fun returned_parameter(self, body: Vec<u64>, return_value: Option<u64>, parameters: Vec<u64>, ret: String) -> Option<u64> {
        when !ret.starts_with("Reference ") {
            return Option::None
        }
        mut returned: Vec<String> = Vec()
        returned = self.returned_names(body, returned)
        when return_value.is_some() {
            returned.push(self.name_of_value(return_value.unwrap()))
        }
        when returned.is_empty() {
            return Option::None
        }
        first := returned[0].clone()
        for name in returned {
            when name != first {
                return Option::None
            }
        }
        mut position: u64 = 0
        while position < parameters.len() {
            parameter := self.program.parameters[parameters[position]]
            when parameter.name == first {
                return Option::Some(position)
            }
            position += 1
        }
        return Option::None
    }

    // The names that the `return` statements of a body return, at any depth; a value that is not a name is "".
    fun returned_names(self, body: Vec<u64>, found: Vec<String>) -> Vec<String> {
        mut names := found
        for index in body {
            names = self.returned_in_statement(index, names)
        }
        return names
    }

    fun returned_in_statement(self, index: u64, names: Vec<String>) -> Vec<String> {
        choose self.program.stmts[index] {
            ast::Stmt::ReturnS(value, span) => self.returned_value_name(value, names),
            ast::Stmt::IfS(condition, then_body, else_body, span) => self.returned_names(else_body, self.returned_names(then_body, names)),
            ast::Stmt::WhileS(condition, body, span) => self.returned_names(body, names),
            ast::Stmt::DeferS(body, span) => self.returned_names(body, names),
            ast::Stmt::ForS(name, name_span, start, end, inclusive, body, span) => self.returned_names(body, names),
            ast::Stmt::ForEachS(name, name_span, iterable, body, span) => self.returned_names(body, names),
            _ => names,
        }
    }

    fun returned_value_name(self, value: Option<u64>, names: Vec<String>) -> Vec<String> {
        mut found := names
        when value.is_some() {
            found.push(self.name_of_value(value.unwrap()))
        } else {
            found.push(String(""))
        }
        return found
    }

    // The name of a value that is a plain name, and "" for any other value.
    fun name_of_value(self, index: u64) -> String {
        choose self.program.exprs[index] {
            ast::ExprTree::NameRef(name, span) => name,
            _ => String(""),
        }
    }

    fun local_named(self, value: u64) -> Option<u64> {
        choose self.program.exprs[value] {
            ast::ExprTree::NameRef(name, span) => self.local_index(name),
            _ => Option::None,
        }
    }

    fun local_index(self, name: String) -> Option<u64> {
        found := self.find(name)
        when found.is_err() {
            return Option::None
        }
        return Option::Some(found.unwrap())
    }

    fun origin_of_name(self, name: String) -> Option<u64> {
        found := self.find(name)
        when found.is_err() {
            return Option::None
        }
        holder := found.unwrap()
        mut position: u64 = 0
        while position < self.origins.len() {
            when self.origins[position].holder == holder {
                return Option::Some(self.origins[position].source)
            }
            position += 1
        }
        return Option::None
    }

    // The number of open blocks that a local is declared in, counting the function's own block as 0.
    fun block_depth(self, index: u64) -> u64 {
        mut depth: u64 = 0
        mut floor: u64 = 0
        while floor < self.scope_floors.len() {
            when self.scope_floors[floor] <= index {
                depth += 1
            }
            floor += 1
        }
        return depth
    }

    // Whether assigning `value` to the reference or raw pointer local `target` makes it point at a local that its
    // block does not outlive.
    fun outlives_block(self, target: u64, value: u64) -> bool {
        when self.pointed_local(value).is_none() {
            return false
        }
        source := self.pointed_local(value).unwrap()
        return self.block_depth(source) > self.block_depth(target)
    }

    // The references and raw pointers declared at `start` or later go out of scope with their block.
    fun drop_origins_from(mut self, start: u64) {
        mut kept: Vec<LocalOrigin> = Vec()
        for item in self.origins.clone() {
            when item.holder < start && item.source < start {
                kept.push(item)
            }
        }
        self.origins = kept
    }

    // The value expressions of a structure literal's fields, in the order they are written.
    fun literal_values(self, value: u64) -> Option<Vec<u64>> {
        choose self.program.exprs[value] {
            ast::ExprTree::StructLit(name, fields, span) => Option::Some(self.init_values(fields)),
            _ => Option::None,
        }
    }

    fun init_values(self, fields: Vec<u64>) -> Vec<u64> {
        mut values: Vec<u64> = Vec()
        for field in fields {
            init := self.program.inits[field]
            values.push(init.value)
        }
        return values
    }

    // The local that a raw pointer field's value points at: the address of a local, or a raw pointer local with an origin.
    fun raw_source(self, value: u64) -> Option<u64> {
        choose self.program.exprs[value] {
            ast::ExprTree::AddressOfE(mutable, raw, inner, span) => self.raw_address_source(raw, inner),
            ast::ExprTree::NameRef(name, span) => self.raw_name_source(name),
            _ => Option::None,
        }
    }

    fun raw_address_source(self, raw: bool, inner: u64) -> Option<u64> {
        when !raw {
            return Option::None
        }
        return self.local_named(inner)
    }

    fun raw_name_source(self, name: String) -> Option<u64> {
        found := self.find(name.clone())
        when found.is_err() || !self.locals[found.unwrap()].ty.starts_with("RawPointer ") {
            return Option::None
        }
        return self.origin_of_name(name)
    }

    // The locals that the raw pointers of a structure value point at: the raw fields of a structure literal, or the
    // origins that a structure local carries.
    fun struct_sources(self, value: u64) -> Vec<u64> {
        mut sources: Vec<u64> = Vec()
        values := self.literal_values(value)
        when values.is_some() {
            for field in values.unwrap() {
                source := self.raw_source(field)
                when source.is_some() {
                    sources.push(source.unwrap())
                }
            }
            return sources
        }
        holder := self.local_named(value)
        when holder.is_some() {
            for item in self.origins.clone() {
                when item.holder == holder.unwrap() {
                    sources.push(item.source)
                }
            }
        }
        return sources
    }

    // Whether a value is `&base[i]` with a base that is not a name: a slice element that no known local or parameter holds.
    fun unknown_element_source(self, value: u64) -> bool {
        choose self.program.exprs[value] {
            ast::ExprTree::AddressOfE(mutable, raw, inner, span) => self.indexed_non_name(inner),
            _ => false,
        }
    }

    fun indexed_non_name(self, index: u64) -> bool {
        choose self.program.exprs[index] {
            ast::ExprTree::IndexE(base, position, span) => !self.is_name(base),
            _ => false,
        }
    }

    fun is_name(self, index: u64) -> bool {
        choose self.program.exprs[index] {
            ast::ExprTree::NameRef(name, span) => true,
            _ => false,
        }
    }

    // The span of a structure result for `R0248`: its first field's value, or the value itself.
    fun struct_result_span(self, value: u64) -> ast::Span {
        values := self.literal_values(value)
        when values.is_some() {
            first := values.unwrap()
            when !first.is_empty() {
                return self.expr_span_of(first[0])
            }
        }
        return self.expr_span_of(value)
    }

    // The origins after an `if` statement: those of the branches that fall through, joined where both do.
    fun join_branch_origins(self, then_origins: Vec<LocalOrigin>, then_falls: bool, else_origins: Vec<LocalOrigin>, else_falls: bool) -> Vec<LocalOrigin> {
        when then_falls && else_falls {
            return self.join_origins(then_origins, else_origins)
        }
        when then_falls {
            return then_origins
        }
        return else_origins
    }

    // A holder keeps a source only when both branches give it one. A reference keeps it only when the two agree; a raw
    // pointer keeps the deeper source, which dies first, as the bootstrap does.
    fun join_origins(self, left: Vec<LocalOrigin>, right: Vec<LocalOrigin>) -> Vec<LocalOrigin> {
        mut joined: Vec<LocalOrigin> = Vec()
        for item in left {
            other := self.origin_in(right.clone(), item.holder)
            when other.is_some() {
                source := other.unwrap()
                when self.locals[item.holder].ty.starts_with("Reference ") {
                    when source == item.source {
                        joined.push(item)
                    }
                } else {
                    when self.block_depth(source) > self.block_depth(item.source) {
                        joined.push(LocalOrigin { holder: item.holder, source: source })
                    } else {
                        joined.push(item)
                    }
                }
            }
        }
        return joined
    }

    fun origin_in(self, origins: Vec<LocalOrigin>, holder: u64) -> Option<u64> {
        mut position: u64 = 0
        while position < origins.len() {
            when origins[position].holder == holder {
                return Option::Some(origins[position].source)
            }
            position += 1
        }
        return Option::None
    }

    // The holder now carries exactly the origins `sources`.
    fun replace_origins(mut self, holder: u64, sources: Vec<u64>) {
        mut kept: Vec<LocalOrigin> = Vec()
        for item in self.origins.clone() {
            when item.holder != holder {
                kept.push(item)
            }
        }
        for source in sources {
            kept.push(LocalOrigin { holder: holder, source: source })
        }
        self.origins = kept
    }

    // The reference or raw pointer local `holder` now points where `value` points.
    fun set_origin(mut self, holder: u64, value: u64) {
        source := self.pointed_local(value)
        mut kept: Vec<LocalOrigin> = Vec()
        for item in self.origins.clone() {
            when item.holder != holder {
                kept.push(item)
            }
        }
        when source.is_some() {
            kept.push(LocalOrigin { holder: holder, source: source.unwrap() })
        }
        self.origins = kept
    }

    // The name that `&name` or `&mut name` borrows, for a value that is such a borrow of a plain local.
    fun borrow_target(self, index: u64) -> Option<String> {
        choose self.program.exprs[index] {
            ast::ExprTree::AddressOfE(mutable, raw, value, span) => self.borrow_name_of(mutable, raw, value),
            _ => Option::None,
        }
    }

    // Whether `value` is `&raw mut name` or `&raw name` written in place, rather than a pointer held in a local.
    fun direct_raw_address(self, index: u64) -> bool {
        choose self.program.exprs[index] {
            ast::ExprTree::AddressOfE(mutable, raw, inner, span) => raw,
            _ => false,
        }
    }

    fun address_is_mutable(self, index: u64) -> bool {
        choose self.program.exprs[index] {
            ast::ExprTree::AddressOfE(mutable, raw, value, span) => mutable,
            _ => false,
        }
    }

    fun borrow_name_of(self, mutable: bool, raw: bool, value: u64) -> Option<String> {
        when raw {
            return Option::None
        }
        choose self.program.exprs[value] {
            ast::ExprTree::NameRef(name, span) => Option::Some(name),
            _ => Option::None,
        }
    }

    // The moves after a `when` whose branches start from `before`: those of the branches that fall through.
    fun merge_branch_moves(before: Vec<MovedValue>, first: Vec<MovedValue>, first_falls: bool, second: Vec<MovedValue>, second_falls: bool) -> Vec<MovedValue> {
        when first_falls && second_falls {
            return union_moves(first, second)
        }
        when first_falls {
            return first
        }
        when second_falls {
            return second
        }
        return before
    }

    // The moves of `first`, and those of `second` that `first` does not have.
    fun union_moves(first: Vec<MovedValue>, second: Vec<MovedValue>) -> Vec<MovedValue> {
        mut merged := first
        for moved in second {
            mut known := false
            for item in merged.clone() {
                when item.name == moved.name {
                    known = true
                }
            }
            when !known {
                merged.push(moved)
            }
        }
        return merged
    }

    // `R0241` for a loop body that moves an owned value declared outside the loop, when the body falls through to
    // the next iteration: the first such value by slot, at its last move. `before` is the state before the loop.
    fun loop_move_error(self, before: Vec<MovedValue>, falls: bool, continues: Vec<MovedValue>) -> Option<String> {
        // The states that reach the next iteration: the end of the body when it falls through, and each `continue`.
        mut candidates: Vec<MovedValue> = Vec()
        when falls {
            candidates = self.moved_names.clone()
        }
        for moved in continues {
            candidates.push(moved)
        }
        mut best := String("")
        mut best_slot: u64 = 0
        mut index: u64 = 0
        while index < candidates.len() {
            name := candidates[index].name.clone()
            when moved_in(before.clone(), name.clone(), candidates[index].start, candidates[index].end) {
                index += 1
                continue
            }
            index += 1
            found := self.find(name.clone())
            when found.is_err() {
                continue
            }
            slot := self.locals[found.unwrap()].slot
            when best.is_empty() || slot < best_slot {
                best = name
                best_slot = slot
            }
        }
        when best.is_empty() {
            return Option::None
        }
        // The last move of that value in the body: the one with the latest span.
        mut start: u64 = 0
        mut end: u64 = 0
        index = 0
        while index < candidates.len() {
            when candidates[index].name == best && candidates[index].start >= start {
                start = candidates[index].start
                end = candidates[index].end
            }
            index += 1
        }
        return Option::Some(diagnostic("R0241", start, end, String("a moved value would be reused on the next loop iteration"), String("replace the moved value before continuing, or pass an explicit `.clone()`")))
    }

    // Makes the moves of the statement just lowered part of the state, for the statements that follow.
    fun commit_moves(mut self) {
        for moved in self.pending_moves.clone() {
            self.moved_names.push(moved)
        }
        self.pending_moves = Vec()
    }

    // Drops the moves recorded since `length`, for a sub-expression whose moves are not unconditional.
    fun discard_pending(mut self, length: u64) {
        mut kept: Vec<MovedValue> = Vec()
        mut index: u64 = 0
        while index < length && index < self.pending_moves.len() {
            kept.push(MovedValue { name: self.pending_moves[index].name.clone(), slot: self.pending_moves[index].slot, start: self.pending_moves[index].start, end: self.pending_moves[index].end })
            index += 1
        }
        self.pending_moves = kept
    }

    // A declaration or an assignment makes the name hold a new value, so an earlier move no longer applies.
    fun forget_moved(mut self, name: String) {
        mut kept: Vec<MovedValue> = Vec()
        for item in self.moved_names.clone() {
            when item.name != name {
                kept.push(item)
            }
        }
        self.moved_names = kept
        // A move in the same statement, as in `name = f(name)`, is followed by the new value too.
        mut pending: Vec<MovedValue> = Vec()
        for item in self.pending_moves.clone() {
            when item.name != name {
                pending.push(item)
            }
        }
        self.pending_moves = pending
    }

    fun enum_index(self, name: String) -> Result<u64, String> {
        mut id: u64 = 0
        while id < self.enums.len() {
            when self.enums[id].name == name {
                return Result::Ok(id)
            }
            id += 1
        }
        aliased := self.named_word(name.clone())
        when aliased.is_ok() && enum_id_of(aliased.unwrap()).is_some() {
            return Result::Ok(enum_id_of(self.named_word(name)?).unwrap())
        }
        qualified := qualified_in(self.scope_path.clone(), name)
        when !qualified.is_empty() {
            return self.enum_index(qualified)
        }
        return Result::Err(unsupported("unknown enum"))
    }

    fun enum_type(self, name: String) -> Result<String, String> {
        id := self.enum_index(name)?
        return Result::Ok(join(words2(String("Enum"), num(id))))
    }

    fun variant_index(self, id: u64, name: String) -> Result<u64, String> {
        mut variant: u64 = 0
        while variant < self.enums[id].variant_names.len() {
            when self.enums[id].variant_names[variant] == name {
                return Result::Ok(variant)
            }
            variant += 1
        }
        return Result::Err(unsupported("unknown variant"))
    }

    // The index of a variant's first field among all the enum's fields.
    // Whether every field of a variant is a scalar or string, which can never hold a destructor.
    fun scalar_payload(self, id: u64, variant: u64) -> bool {
        start := self.variant_field_start(id, variant)
        mut index: u64 = 0
        while index < self.enums[id].variant_counts[variant] {
            when scalar_type_name(self.enums[id].field_types[start + index].clone()).is_none() {
                return false
            }
            index += 1
        }
        return true
    }

    fun variant_field_start(self, id: u64, variant: u64) -> u64 {
        mut start: u64 = 0
        mut earlier: u64 = 0
        while earlier < variant {
            start += self.enums[id].variant_counts[earlier]
            earlier += 1
        }
        return start
    }

    // The `Option<payload>` enum. It is created the first time the program uses a payload type
    // without an expected `Option` type.
    fun option_enum_for(mut self, payload: String) -> u64 {
        found := self.option_index(payload.clone())
        when found.is_ok() {
            return found.unwrap()
        }
        id := self.enums.len()
        mut name := String("$RynOption#inferred")
        name.append(num(id))
        self.enums.push(option_info(name, payload))
        return id
    }

    // `Enum::Variant(args)`: an `EnumNew` call that owns the new value. `Option` and `Result` take
    // their enum from the expected type; `Option::Some(value)` may take it from the payload.
    // Whether a method receiver is a local declared without `mut`.
    fun immutable_local_receiver(self, receiver: u64) -> bool {
        choose self.program.exprs[receiver] {
            ast::ExprTree::NameRef(name, span) => self.local_is_immutable(name),
            _ => false,
        }
    }

    // A local declared without `mut`. A by-value parameter counts as mutable for a method receiver, as the bootstrap
    // treats it.
    fun local_is_immutable(self, name: String) -> bool {
        found := self.find(name)
        when found.is_err() {
            return false
        }
        local := self.locals[found.unwrap()]
        mut position: u64 = 0
        while position < self.param_slots.len() {
            when self.param_slots[position] == local.slot {
                return false
            }
            position += 1
        }
        return !local.mutable
    }

    // Whether `name` is `module::item`, where `module` names a module of the program and no function of the program is
    // called `item` in any module. A private function of that name is not missing: it is `R0425`, reported elsewhere.
    fun missing_module_function(self, name: String) -> bool {
        when self.signature_index(name.clone()).is_ok() {
            return false
        }
        cut := last_index_of(name.clone(), String("::"))
        when cut.is_none() {
            return false
        }
        module := name.slice(0, cut.unwrap())
        // The last segment of a module is lowercase: `lexer::Kind::Number(...)` is a variant of the enum `Kind`.
        mut segment := module.clone()
        last_cut := last_index_of(module.clone(), String("::"))
        when last_cut.is_some() {
            segment = module.slice(last_cut.unwrap() + 2, module.len())
        }
        when !String("abcdefghijklmnopqrstuvwxyz").contains(segment.slice(0, 1)) {
            return false
        }
        when !self.names_module(module) {
            return false
        }
        mut suffix := String("::")
        suffix.append(name.slice(cut.unwrap() + 2, name.len()))
        mut position: u64 = 0
        while position < self.signatures.len() {
            when self.signatures[position].name.ends_with(suffix.clone()) {
                return false
            }
            position += 1
        }
        return true
    }

    // The closest function name of the program to `name`, for the hint of `R0210`.
    fun module_function_suggestion(self, name: String) -> String {
        mut candidates: Vec<String> = Vec()
        mut position: u64 = 0
        while position < self.signatures.len() {
            candidates.push(self.signatures[position].name.clone())
            position += 1
        }
        return closest_name(name, candidates)
    }

    // Whether `name` is a function of this program that is not public and lives in another module than the caller.
    fun private_function_call(self, name: String) -> bool {
        found := self.signature_index(name.clone())
        when found.is_err() {
            // A private function that a module alias names, such as `util::hidden` after `use lib::util`, is private
            // to its module when the caller is in another module.
            mut position: u64 = 0
            while position < self.private_alias_names.len() {
                when self.private_alias_names[position] == name {
                    target := self.signature_exact(self.private_alias_targets[position].clone())
                    return target.is_ok() && self.signatures[target.unwrap()].module != self.module
                }
                position += 1
            }
            return false
        }
        id := found.unwrap()
        return !self.signatures[id].public && self.signatures[id].module != self.module
    }

    // Whether `name` names a module rather than an enum: a lowercase first letter, or a function or structure
    // declared under `name::`.
    fun names_module(self, name: String) -> bool {
        first := name.slice(0, 1)
        when String("abcdefghijklmnopqrstuvwxyz").contains(first) {
            return true
        }
        mut prefix := name
        prefix.append("::")
        mut index: u64 = 0
        while index < self.signatures.len() {
            when self.signatures[index].name.starts_with(prefix.clone()) {
                return true
            }
            index += 1
        }
        index = 0
        while index < self.structs.len() {
            when self.structs[index].name.starts_with(prefix.clone()) {
                return true
            }
            index += 1
        }
        return false
    }

    // `located` is false where the call's span is not written here; then a wrong count is declined. `expression`
    // is true for a path written as an expression (`Type::Name`), which the bootstrap reports as an unknown enum
    // (`R0230`); a call to a path that is no enum is a function call there, and it is declined.
    fun enum_construct(mut self, name: String, variant_name: String, arguments: Vec<u64>, expected: String, span: ast::Span, located: bool, expression: bool) -> Result<Lowered, String> {
        mut found: Option<u64> = Option::None
        user := self.enum_index(name.clone())
        expected_id := enum_id_of(expected.clone())
        when user.is_ok() {
            found = Option::Some(user.unwrap())
        } else when expected_id.is_some() && is_generic_enum_name(self.enums[expected_id.unwrap()].name.clone(), name.clone()) {
            found = expected_id
        }
        mut payload: Option<Lowered> = Option::None
        when found.is_none() && name == "Option" && variant_name == "Some" && arguments.len() == 1 {
            value := self.moved_expression(arguments[0], String(""))?
            found = Option::Some(self.option_enum_for(value.ty.clone()))
            payload = Option::Some(value)
        }
        when found.is_none() {
            // `Type::CONSTANT` is a call to a function without parameters.
            mut constant := name.clone()
            constant.append("::")
            constant.append(variant_name.clone())
            function := self.signature_index(constant)
            when arguments.is_empty() && function.is_ok() && self.signatures[function.unwrap()].params.is_empty() && !self.signatures[function.unwrap()].ret.is_empty() {
                ret := self.signatures[function.unwrap()].ret.clone()
                return Result::Ok(Lowered { text: join(words5(String("Call"), String("Function"), num(function.unwrap()), String("0"), ret.clone())), ty: ret })
            }
            // `R0230` for a name that is neither an enum nor a constant, at the expression's span. A lowercase
            // name, or one with functions or structures under it, is a module.
            when located && expression && name != "Option" && name != "Result" {
                when self.names_module(name.clone()) {
                    return Result::Err(unknown_module_item_error(name, variant_name, span.start, span.end))
                }
                return Result::Err(unknown_enum_error(name, span.start, span.end))
            }
            return Result::Err(unsupported("unknown enum"))
        }
        id := found.unwrap()
        variant_found := self.variant_index(id, variant_name.clone())
        when variant_found.is_err() {
            when located && name != "Option" && name != "Result" {
                return Result::Err(unknown_variant_error(name, variant_name, self.enums[id].variant_names.clone(), span.start, span.end))
            }
            return Result::Err(variant_found.unwrap_err())
        }
        variant := variant_found.unwrap()
        ty := join(words2(String("Enum"), num(id)))
        when arguments.len() != self.enums[id].variant_counts[variant] {
            when located && self.scalar_payload(id, variant) {
                return Result::Err(enum_arity_error(name, variant_name, self.enums[id].variant_counts[variant], arguments.len(), span.start, span.end))
            }
            return Result::Err(unsupported("enum constructor arguments"))
        }
        start := self.variant_field_start(id, variant)
        mut tokens: Vec<String> = Vec()
        tokens.push(String("Call"))
        tokens.push(String("EnumNew"))
        tokens.push(num(id))
        tokens.push(num(variant))
        tokens.push(num(arguments.len()))
        mut position: u64 = 0
        while position < arguments.len() {
            field_ty := self.enums[id].field_types[start + position].clone()
            mut value := Lowered { text: String(""), ty: String("") }
            when position == 0 && payload.is_some() {
                value = payload.unwrap()
                payload = Option::None
            } else {
                value = self.moved_expression(arguments[position], field_ty.clone())?
            }
            when value.ty != field_ty {
                return Result::Err(unsupported("enum field type"))
            }
            tokens.push(value.text)
            position += 1
        }
        tokens.push(ty.clone())
        return Result::Ok(Lowered { text: join(tokens), ty: ty })
    }

    // `choose value { Enum::Variant(names) => body, ... }`. Each arm declares its bindings in
    // slots of their own, in arm order, and they are visible in its body only. The first arm
    // gives the result type when the context does not.
    // Whether an arm is a shape probe, which the bootstrap writes as an arm of the enum `$shape`.
    fun is_shape_probe(self, arm: u64) -> bool {
        record := self.program.arms[arm]
        when record.enum_name.is_none() {
            return false
        }
        return record.enum_name.unwrap() == "$shape"
    }

    // The check of a shape probe against its value, as the bootstrap's `pattern_shape` makes it: a scalar value has no
    // tuple or structure shape, and a tuple of another arity has the wrong number of elements. A probe that matches keeps
    // only its body, which is lowered at the expected type.
    fun shape_probe_check(mut self, value: u64, arm: u64, span: ast::Span, expected: String) -> Result<Lowered, String> {
        scrutinee := self.expression(value, String(""))?
        when reference_inner(scrutinee.ty.clone()).is_some() {
            return Result::Err(unsupported("shape probe through a reference"))
        }
        record := self.program.arms[arm]
        mut wanted := String("a structure pattern")
        mut tuple := false
        mut arity: u64 = 0
        when record.variant.is_some() {
            variant := record.variant.unwrap()
            when variant.starts_with("tuple:") {
                tuple = true
                wanted = String("a tuple pattern")
                arity = variant.slice(6, variant.len()).try_parse::<u64>().unwrap_or(0)
            }
        }
        when scalar_type_name(scrutinee.ty.clone()).is_some() {
            name := scalar_type_name(scrutinee.ty.clone()).unwrap()
            mut help := wanted.clone()
            help.append(" needs a value of that shape, but this value has type `")
            help.append(name)
            help.append("`")
            return Result::Err(diagnostic("R0235", span.start, span.end, String("pattern does not match the type of the value"), help))
        }
        id := struct_id_of(scrutinee.ty.clone())
        when id.is_none() {
            return Result::Err(unsupported("shape probe of this type"))
        }
        definition := id.unwrap()
        when tuple && self.structs[definition].name.starts_with("$RynTuple#") {
            have := self.structs[definition].field_types.len() as u64
            when have != arity {
                mut message := String("tuple pattern has ")
                message.append(num(arity))
                message.append(" element(s) but the value has ")
                message.append(num(have))
                return Result::Err(diagnostic("R0235", span.start, span.end, message, String("list one pattern per tuple element")))
            }
        }
        body := record.body
        return self.expression(body, expected)
    }

    fun has_shape_probe(self, arms: Vec<u64>) -> bool {
        mut position: u64 = 0
        while position < arms.len() {
            arm := self.program.arms[arms[position]]
            when arm.enum_name.is_some() && arm.enum_name.unwrap().starts_with("$") {
                return true
            }
            position += 1
        }
        return false
    }

    fun choose_expression(mut self, value: u64, arms: Vec<u64>, span: ast::Span, expected: String) -> Result<Lowered, String> {
        // A shape probe (a tuple or structure pattern, which the pattern pass made) is checked against the value first.
        when arms.len() == 1 && self.is_shape_probe(arms[0]) {
            return self.shape_probe_check(value, arms[0], span, expected)
        }
        // Matching borrows the scrutinee, and an arm's moves happen only when that arm runs: neither is a move of
        // the function body that holds from the next statement, so the moves recorded for them are discarded.
        scrutinee_pending := self.pending_moves.len()
        scrutinee := self.matched_expression(value)?
        self.discard_pending(scrutinee_pending)
        id := enum_id_of(scrutinee.ty.clone()).unwrap_or(0)
        when enum_id_of(scrutinee.ty.clone()).is_none() {
            // A tuple or structure pattern is a shape probe, which the bootstrap checks first (`R0235`).
            when scalar_type_name(scrutinee.ty.clone()).is_some() && !self.has_shape_probe(arms.clone()) {
                return Result::Err(choose_enum_error(span.start, span.end))
            }
            return Result::Err(unsupported("choose on a value that is not an enum"))
        }
        when arms.is_empty() {
            return Result::Err(unsupported("choose without arms"))
        }
        // Which variants an arm names, for the exhaustiveness check after the arms; `_` covers the rest.
        mut covered: Vec<bool> = Vec()
        mut variant_slot: u64 = 0
        while variant_slot < self.enums[id].variant_names.len() {
            covered.push(false)
            variant_slot += 1
        }
        mut has_wildcard := false
        // Each arm starts from the moves before the `choose`; afterwards the moves of any arm.
        self.commit_moves()
        before_arms := self.moved_names.clone()
        mut merged_moves: Vec<MovedValue> = Vec()
        mut ty := String("")
        mut tokens: Vec<String> = Vec()
        mut position: u64 = 0
        while position < arms.len() {
            arm := self.program.arms[arms[position]]
            mut arm_tokens: Vec<String> = Vec()
            visible_before := self.visible
            self.moved_names = before_arms.clone()
            mut tag: u64 = 0
            when arm.variant.is_some() {
                variant_name := arm.variant.unwrap()
                variant_found := self.variant_index(id, variant_name.clone())
                when variant_found.is_err() {
                    // The bootstrap reports a variant missing from the enum that the arm names, when that is the scrutinee's enum.
                    when arm.enum_name.is_some() {
                        written := arm.enum_name.unwrap()
                        when written == self.enums[id].name && self.enums[id].name != "Option" && self.enums[id].name != "Result" {
                            return Result::Err(unknown_variant_error(written, variant_name, self.enums[id].variant_names.clone(), arm.span.start, arm.span.end))
                        }
                    }
                    return Result::Err(variant_found.unwrap_err())
                }
                tag = variant_found.unwrap()
                // `R0235`: a variant that an earlier arm of this `choose` already handles, at the arm.
                when covered[tag] {
                    mut written := String("")
                    when arm.enum_name.is_some() {
                        written = arm.enum_name.unwrap()
                    }
                    mut message := String("`choose` handles variant `")
                    message.append(written)
                    message.append("::")
                    message.append(variant_name.clone())
                    message.append("` more than once")
                    return Result::Err(diagnostic("R0235", arm.span.start, arm.span.end, message, String("")))
                }
                covered.set(tag, true)
                arm_tokens.push(String("+"))
                arm_tokens.push(num(tag))
            } else {
                has_wildcard = true
                arm_tokens.push(String("-"))
            }
            start := self.variant_field_start(id, tag)
            arm_tokens.push(num(arm.bindings.len()))
            mut binding: u64 = 0
            while binding < arm.bindings.len() {
                field_ty := self.enums[id].field_types[start + binding].clone()
                slot := self.allocate(field_ty.clone())?
                self.forget_moved(arm.bindings[binding].clone())
                self.declare(Local { name: arm.bindings[binding].clone(), slot: slot, ty: field_ty.clone(), mutable: false })
                arm_tokens.push(num(slot))
                arm_tokens.push(field_ty)
                arm_tokens.push(num(binding))
                binding += 1
            }
            when ty.is_empty() {
                let_first := self.moved_expression(arm.body, expected.clone())?
                ty = let_first.ty.clone()
                arm_tokens.push(let_first.text)
            } else {
                body := self.moved_expression(arm.body, ty.clone())?
                when body.ty != ty {
                    return Result::Err(unsupported("choose arms of different types"))
                }
                arm_tokens.push(body.text)
            }
            self.commit_moves()
            merged_moves = union_moves(merged_moves, self.moved_names.clone())
            self.visible = visible_before
            for token in arm_tokens {
                tokens.push(token)
            }
            position += 1
        }
        self.moved_names = merged_moves
        // `R0235` for a `choose` without a `_` arm that leaves variants out, at the `choose`'s span. The built-in
        // `Option` and `Result` are declined, since their variant order is not written here.
        when !has_wildcard {
            mut missing := String("")
            mut count: u64 = 0
            mut variant: u64 = 0
            while variant < covered.len() {
                when !covered[variant] {
                    when count > 0 {
                        missing.append(", ")
                    }
                    missing.append(self.enums[id].variant_names[variant].clone())
                    count += 1
                }
                variant += 1
            }
            when count > 0 {
                when self.enums[id].name == "Option" || self.enums[id].name == "Result" {
                    return Result::Err(unsupported("choose over a built-in enum"))
                }
                return Result::Err(choose_missing_error(missing, span.start, span.end))
            }
        }
        // `R0240`, after the arms' own checks: an owned payload bound while matching through a reference.
        through := self.dereferenced_pointer(value)
        when through.is_some() && self.arms_bind_owned(arms.clone(), id) {
            pointer_span := self.expr_span_of(through.unwrap())
            return Result::Err(owned_payload_through_reference_error(pointer_span.start, pointer_span.end))
        }
        return Result::Ok(Lowered { text: join(choose_tokens(scrutinee.text, id, arms.len(), tokens, ty.clone())), ty: ty })
    }

    // The IR records for the program's enums, in source order.
    fun user_enum_records(self) -> Vec<String> {
        mut records: Vec<String> = Vec()
        mut id: u64 = 0
        while id < self.enums.len() {
            mut tokens: Vec<String> = Vec()
            tokens.push(length_prefixed(self.enums[id].name.clone()))
            tokens.push(num(self.enums[id].variant_names.len()))
            mut variant: u64 = 0
            while variant < self.enums[id].variant_names.len() {
                tokens.push(length_prefixed(self.enums[id].variant_names[variant].clone()))
                tokens.push(num(self.enums[id].variant_counts[variant]))
                mut field: u64 = 0
                while field < self.enums[id].variant_counts[variant] {
                    tokens.push(self.enums[id].field_types[self.variant_field_start(id, variant) + field].clone())
                    field += 1
                }
                variant += 1
            }
            records.push(join(tokens))
            id += 1
        }
        return records
    }

    fun field_type(self, value: u64, name: String) -> Result<String, String> {
        place := self.field_of(value, name)?
        return Result::Ok(place.ty)
    }

    fun struct_literal_type(self, name: String) -> Result<String, String> {
        id := self.struct_id(name)?
        return Result::Ok(struct_word(id))
    }

    fun field_read(mut self, value: u64, name: String, span: ast::Span, expected: String) -> Result<Lowered, String> {
        through := self.reference_field(value, name.clone(), span)?
        when through.is_some() {
            result := through.unwrap()
            when !expected.is_empty() && expected != result.ty {
                return Result::Err(unsupported("field type where another type is expected"))
            }
            return Result::Ok(result)
        }
        when self.place_of(value).is_err() {
            return self.field_of_value(value, name, span, expected)
        }
        place := self.field_of(value, name)?
        when !expected.is_empty() && expected != place.ty {
            return Result::Err(unsupported("field type where another type is expected"))
        }
        text := join(words5(String("Local"), num(place.slot), place.ty.clone(), num(span.start), num(span.end)))
        return Result::Ok(Lowered { text: text, ty: place.ty })
    }

    // A field of a structure value that is not a local: `Field value struct field type span`.
    fun field_of_value(mut self, value: u64, name: String, span: ast::Span, expected: String) -> Result<Lowered, String> {
        base := self.expression(value, String(""))?
        id := struct_id_of(base.ty.clone())
        when id.is_none() {
            return Result::Err(unsupported("field of a value that is not a structure"))
        }
        field := self.field_index(id.unwrap(), name)?
        field_ty := self.structs[id.unwrap()].field_types[field].clone()
        when !expected.is_empty() && expected != field_ty {
            return Result::Err(unsupported("field type where another type is expected"))
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("Field"))
        tokens.push(base.text)
        tokens.push(num(id.unwrap()))
        tokens.push(num(field))
        tokens.push(field_ty.clone())
        tokens.push(num(span.start))
        tokens.push(num(span.end))
        return Result::Ok(Lowered { text: join(tokens), ty: field_ty })
    }

    // The local at the root of a chain of field accesses, if it is a reference.
    fun chain_root_is_reference(self, index: u64) -> bool {
        choose self.program.exprs[index] {
            ast::ExprTree::NameRef(name, span) => self.local_is_reference(name),
            ast::ExprTree::FieldE(value, name, name_span, span) => self.chain_root_is_reference(value),
            _ => false,
        }
    }

    fun local_is_reference(self, name: String) -> bool {
        found := self.find(name)
        when found.is_err() {
            return false
        }
        return self.locals[found.unwrap()].ty.starts_with("Reference ")
    }

    // A field of a structure reached through a reference local: `ReferenceField pointer ...`, and
    // `Field` for every access after the first. `None` when the root of the access is not a reference.
    fun reference_field(mut self, value: u64, name: String, span: ast::Span) -> Result<Option<Lowered>, String> {
        when !self.chain_root_is_reference(value) {
            return Result::Ok(Option::None)
        }
        return Result::Ok(Option::Some(self.field_tree_step(value, name, span)?))
    }

    // `Struct { name: value, ... }`: the fields in the order written, each with its index. As the bootstrap
    // does, each written field is checked in turn (`R0225` unknown, `R0228` repeated, `R0205` wrong type), and
    // then the first field left out is reported (`R0229`).
    fun struct_literal(mut self, name: String, fields: Vec<u64>, span: ast::Span, expected: String) -> Result<Lowered, String> {
        found := self.struct_id(name.clone())
        when found.is_err() && name.contains("::") {
            return Result::Err(unknown_structure_error(name, span.start, span.end))
        }
        id := found?
        // `R0227`: a structure of another module that is not `pub` is unknown here.
        when !self.structs[id].public && self.structs[id].module_path != self.module {
            return Result::Err(unknown_structure_error(name, span.start, span.end))
        }
        ty := struct_word(id)
        when !expected.is_empty() && expected != ty {
            return Result::Err(unsupported("structure where another type is expected"))
        }
        when self.structs[id].name.starts_with("$") && !self.structs[id].name.starts_with("$RynStruct#") {
            return Result::Err(unsupported("tuple literal"))
        }
        mut initialized: Vec<bool> = Vec()
        mut slot: u64 = 0
        while slot < self.structs[id].field_names.len() {
            initialized.push(false)
            slot += 1
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("StructValue"))
        tokens.push(num(id))
        tokens.push(num(fields.len()))
        mut position: u64 = 0
        while position < fields.len() {
            init := self.program.inits[fields[position]]
            field_found := self.field_index(id, init.name.clone())
            when field_found.is_err() {
                return Result::Err(self.unknown_struct_field(id, init.name, init.span.start, init.span.end))
            }
            field := field_found.unwrap()
            when initialized[field] {
                mut repeated := String("field `")
                repeated.append(init.name.clone())
                repeated.append("` is initialized more than once")
                return Result::Err(diagnostic("R0228", init.span.start, init.span.end, repeated, String("remove the duplicate field initializer")))
            }
            field_ty := self.structs[id].field_types[field].clone()
            value_result := self.moved_expression(init.value, field_ty.clone())
            when value_result.is_err() {
                refusal := value_result.unwrap_err()
                other := self.other_type_of(init.value, field_ty.clone(), refusal.clone())
                when other.is_some() {
                    mismatch := field_type_error(init.name.clone(), field_ty.clone(), other.unwrap(), self.expr_span_of(init.value))
                    when mismatch.is_some() {
                        return Result::Err(mismatch.unwrap())
                    }
                }
                return Result::Err(refusal)
            }
            value := value_result.unwrap()
            when value.ty != field_ty {
                mismatch := field_type_error(init.name.clone(), field_ty.clone(), value.ty.clone(), self.expr_span_of(init.value))
                when mismatch.is_some() {
                    return Result::Err(mismatch.unwrap())
                }
                return Result::Err(unsupported("structure field type"))
            }
            initialized.set(field, true)
            tokens.push(num(field))
            tokens.push(value.text)
            position += 1
        }
        mut missing: u64 = 0
        while missing < initialized.len() {
            when !initialized[missing] {
                return Result::Err(missing_field_error(self.structs[id].field_names[missing].clone(), name, span.start, span.end))
            }
            missing += 1
        }
        return Result::Ok(Lowered { text: join(tokens), ty: ty })
    }

    // The IR records for the structure definitions, in source order.
    fun struct_records(self) -> Result<Vec<String>, String> {
        mut records: Vec<String> = Vec()
        mut id: u64 = 0
        while id < self.structs.len() {
            field_count := self.structs[id].field_names.len()
            mut tokens: Vec<String> = Vec()
            tokens.push(length_prefixed(self.structs[id].name.clone()))
            tokens.push(num(field_count))
            mut field: u64 = 0
            while field < field_count {
                tokens.push(length_prefixed(self.structs[id].field_names[field].clone()))
                tokens.push(self.structs[id].field_types[field].clone())
                tokens.push(num(self.field_offset(id, field)))
                tokens.push(num(self.structs[id].field_public[field]))
                field += 1
            }
            tokens.push(num(self.slot_count(struct_word(id))))
            tokens.push(num(self.structs[id].repr_c))
            when self.structs[id].drop_name.is_empty() {
                tokens.push(String("-"))
            } else {
                tokens.push(String("+"))
                tokens.push(num(self.signature_index(self.structs[id].drop_name.clone())?))
            }
            tokens.push(num(self.structs[id].derives_clone))
            tokens.push(num(self.structs[id].derives_hash))
            tokens.push(length_prefixed(self.structs[id].module_path.clone()))
            records.push(join(tokens))
            id += 1
        }
        return Result::Ok(records)
    }

    // Whether a type is a structure with a destructor, which owns its storage as one unit.
    fun has_destructor(self, ty: String) -> bool {
        id := struct_id_of(ty)
        when id.is_none() {
            return false
        }
        return !self.structs[id.unwrap()].drop_name.is_empty()
    }

    // `reference.field = value` (or `op=`): a store through the pointer held in the local.
    fun reference_field_assign(mut self, object: String, names: Vec<String>, spans: Vec<u64>, op: Option<String>, value: u64, span: ast::Span) -> Result<bool, String> {
        index := self.find(object.clone())?
        local := self.locals[index]
        id := struct_id_of(reference_inner(local.ty.clone()).unwrap())
        when id.is_none() || names.len() != 1 {
            return Result::Err(unsupported("assignment through this reference"))
        }
        field := self.field_index(id.unwrap(), names[0].clone())?
        // `R0426`: a field of a structure from another module is assigned through a reference only when it is `pub`.
        private := self.private_field_of(reference_inner(local.ty.clone()).unwrap(), names[0].clone(), spans[0], spans[1])
        when private.is_some() {
            return Result::Err(private.unwrap())
        }
        field_ty := self.structs[id.unwrap()].field_types[field].clone()
        object_end := span.start + object.len()
        pointer := join(words5(String("Local"), num(local.slot), local.ty.clone(), num(span.start), num(object_end)))
        mut stored := String("")
        when op.is_none() {
            lowered := self.moved_expression(value, field_ty.clone())?
            when lowered.ty != field_ty {
                return Result::Err(unsupported("field assignment type"))
            }
            stored = lowered.text
        } else {
            operator := op.unwrap()
            when !is_numeric_word(field_ty.clone()) {
                return Result::Err(unsupported("arithmetic on this type"))
            }
            end := object_end + 1 + names[0].len()
            mut read: Vec<String> = Vec()
            read.push(String("ReferenceField"))
            read.push(pointer.clone())
            read.push(num(id.unwrap()))
            read.push(num(field))
            read.push(field_ty.clone())
            read.push(num(span.start))
            read.push(num(end))
            read.push(String("0"))
            target := Lowered { text: join(read), ty: field_ty.clone() }
            mut context := String("")
            when self.operand_ok(field_ty.clone(), is_bitwise_op(operator.clone())) {
                context = field_ty.clone()
            }
            binary := self.binary_rest(operator, target, value, context, field_ty.clone(), span, span, false)?
            stored = binary.text
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("ReferenceFieldAssign"))
        tokens.push(pointer)
        tokens.push(num(id.unwrap()))
        tokens.push(num(field))
        tokens.push(field_ty)
        tokens.push(stored)
        self.statements.push(join(tokens))
        return Result::Ok(false)
    }

    // `place.field = value`, or `place.field op= value` with the target's span.
    fun field_assign(mut self, object: String, names: Vec<String>, spans: Vec<u64>, op: Option<String>, value: u64, span: ast::Span) -> Result<bool, String> {
        mut place := self.name_place(object.clone())?
        when reference_inner(place.ty.clone()).is_some() {
            return self.reference_field_assign(object, names, spans, op, value, span)
        }
        when !place.mutable {
            // A raw pointer's fields are checked by `R0224` or the reference path, not here.
            when place.ty.starts_with("RawPointer ") {
                return Result::Err(unsupported("field assignment through a raw pointer"))
            }
            end := span.start + object.len()
            return Result::Err(immutable_binding(object, span.start, end, "if you intend to change its fields"))
        }
        mut target_len := object.len()
        mut position: u64 = 0
        while position < names.len() {
            target_len += 1 + names[position].len()
            place = self.field_step(place, names[position].clone())?
            position += 1
        }
        // `R0251`/`R0252`: a reference or raw pointer stored into a field may not point at a local of a deeper block
        // than the structure that holds the field. A raw pointer field is `R0252` even for a direct `&raw`.
        when op.is_none() && (place.ty.starts_with("Reference ") || place.ty.starts_with("RawPointer ")) {
            holder := self.find(object.clone())?
            when self.outlives_block(holder, value) {
                value_span := self.expr_span_of(value)
                when place.ty.starts_with("RawPointer ") {
                    return Result::Err(raw_escape_error(value_span.start, value_span.end))
                }
                return Result::Err(reference_escape_error(value_span.start, value_span.end))
            }
        }
        when op.is_none() {
            lowered := self.moved_expression(value, place.ty.clone())?
            when lowered.ty != place.ty {
                return Result::Err(unsupported("field assignment type"))
            }
            self.statements.push(join(words4(String("FieldAssign"), num(place.slot), place.ty.clone(), lowered.text)))
            return Result::Ok(false)
        }
        operator := op.unwrap()
        when !is_numeric_word(place.ty.clone()) {
            return Result::Err(unsupported("arithmetic on this type"))
        }
        end := span.start + target_len
        target := Lowered { text: join(words5(String("Local"), num(place.slot), place.ty.clone(), num(span.start), num(end))), ty: place.ty.clone() }
        mut context := String("")
        when self.operand_ok(place.ty.clone(), is_bitwise_op(operator.clone())) {
            context = place.ty.clone()
        }
        binary := self.binary_rest(operator, target, value, context, place.ty.clone(), span, span, false)?
        self.statements.push(join(words4(String("FieldAssign"), num(place.slot), place.ty.clone(), binary.text)))
        return Result::Ok(false)
    }


    // The type of an expression when it does not depend on context; "" when it does.
    fun infer(self, index: u64) -> Result<String, String> {
        choose self.program.exprs[index] {
            ast::ExprTree::NameRef(name, span) => self.local_type(name),
            ast::ExprTree::BinaryE(op, left, right, span) => self.binary_result_type(op, left, right),
            ast::ExprTree::BoolLit(value, span) => Result::Ok(String("Bool")),
            ast::ExprTree::NotE(value, span) => Result::Ok(String("Bool")),
            ast::ExprTree::NegateE(value, span) => self.infer(value),
            ast::ExprTree::CastE(value, ty, span) => self.annotation(ty),
            ast::ExprTree::FieldE(value, name, name_span, span) => self.field_type(value, name),
            ast::ExprTree::IfE(condition, then_value, else_value, span) => self.if_type(then_value, else_value),
            ast::ExprTree::EnumE(enum_name, variant, arguments, span) => self.enum_type(enum_name),
            ast::ExprTree::ChooseE(value, arms, span) => Result::Err(unsupported("choose type")),
            ast::ExprTree::StructLit(name, fields, span) => self.struct_literal_type(name),
            ast::ExprTree::IntLit(value, span) => Result::Ok(String("")),
            ast::ExprTree::FloatLit(bits, span) => Result::Ok(String("")),
            ast::ExprTree::CharLit(value, span) => Result::Ok(String("Char")),
            ast::ExprTree::BitNotE(value, span) => self.infer(value),
            ast::ExprTree::StrLit(text, span) => Result::Ok(String("Str")),
            ast::ExprTree::CallE(name, type_arguments, arguments, span) => self.call_result_type(name),
            _ => Result::Err(unsupported("expression")),
        }
    }

    // The result type of a call, from its signature, an enum constructor, or a builtin.
    fun call_result_type(self, name: String) -> Result<String, String> {
        when self.signature_index(name.clone()).is_ok() {
            id := self.signature_index(name)?
            return Result::Ok(self.signatures[id].ret.clone())
        }
        cut := last_index_of(name.clone(), String("::"))
        when cut.is_some() {
            return self.enum_type(name.slice(0, cut.unwrap()))
        }
        when name == "String" {
            return Result::Ok(String("OwnedString"))
        }
        when name == "arg_count" {
            return Result::Ok(String("U32"))
        }
        when name == "arg" {
            return Result::Ok(String("Str"))
        }
        when name == "try_read_file" {
            return Result::Ok(join(words2(String("Enum"), num(self.option_index(String("OwnedString"))?))))
        }
        when name == "read_file_result" {
            return Result::Ok(join(words2(String("Enum"), num(self.result_index(String("OwnedString"), String("I32"))?))))
        }
        entry := builtins::builtin_named(name)
        when entry.is_some() {
            return Result::Ok(entry.unwrap().ret)
        }
        return Result::Err(unsupported("unknown function"))
    }

    fun signature_index(self, name: String) -> Result<u64, String> {
        found := self.signature_exact(name.clone())
        when found.is_ok() {
            return found
        }
        // A function is also visible by its name inside the namespace or module of the caller.
        when true {
            when !self.call_scope.is_empty() {
                mut candidate := self.call_scope.clone()
                candidate.append("::")
                candidate.append(name.clone())
                scoped := self.signature_exact(candidate)
                when scoped.is_ok() {
                    return scoped
                }
            }
            when !self.module.is_empty() {
                mut candidate := self.module.clone()
                candidate.append("::")
                candidate.append(name.clone())
                scoped := self.signature_exact(candidate)
                when scoped.is_ok() {
                    return scoped
                }
            }
        }
        qualified := qualified_in(self.scope_path.clone(), name)
        when !qualified.is_empty() {
            return self.signature_exact(qualified)
        }
        return Result::Err(unsupported("unknown function"))
    }

    fun signature_exact(self, name: String) -> Result<u64, String> {
        mut id: u64 = 0
        while id < self.signatures.len() {
            when self.signatures[id].name == name {
                return Result::Ok(id)
            }
            id += 1
        }
        mut alias: u64 = 0
        while alias < self.alias_names.len() {
            when self.alias_names[alias] == name {
                return Result::Ok(self.alias_targets[alias])
            }
            alias += 1
        }
        return Result::Err(unsupported("unknown function"))
    }

    fun local_type(self, name: String) -> Result<String, String> {
        index := self.find(name)?
        return Result::Ok(self.locals[index].ty.clone())
    }

    fun binary_result_type(self, op: String, left: u64, right: u64) -> Result<String, String> {
        when is_comparison(op.clone()) || is_logical(op) {
            return Result::Ok(String("Bool"))
        }
        return self.binary_type(left, right)
    }

    fun binary_type(self, left: u64, right: u64) -> Result<String, String> {
        ty := self.infer(left)?
        when !ty.is_empty() {
            return Result::Ok(ty)
        }
        return self.infer(right)
    }

    fun expression(mut self, index: u64, expected: String) -> Result<Lowered, String> {
        choose self.program.exprs[index] {
            ast::ExprTree::IntLit(value, span) => self.integer(value, expected),
            ast::ExprTree::FloatLit(bits, span) => self.float_literal(bits, expected),
            ast::ExprTree::CharLit(value, span) => self.character_literal(value, expected),
            ast::ExprTree::BitNotE(value, span) => self.bit_not(value, span, expected),
            ast::ExprTree::StrLit(text, span) => self.string_literal(text),
            ast::ExprTree::NameRef(name, span) => self.name_with(name, span, expected),
            ast::ExprTree::BinaryE(op, left, right, span) => self.binary(op, left, right, expected, span),
            ast::ExprTree::BoolLit(value, span) => self.boolean_literal(value, expected),
            ast::ExprTree::NotE(value, span) => self.negation(value, span, expected),
            ast::ExprTree::NegateE(value, span) => self.arithmetic_negation(value, span, expected),
            ast::ExprTree::CastE(value, ty, span) => self.cast(value, ty, expected),
            ast::ExprTree::FieldE(value, name, name_span, span) => self.field_read_checked(value, name, name_span, span, expected),
            ast::ExprTree::IfE(condition, then_value, else_value, span) => self.if_expression(condition, then_value, else_value, expected),
            ast::ExprTree::EnumE(enum_name, variant, arguments, span) => self.enum_construct(enum_name, variant, arguments, expected, span, true, true),
            ast::ExprTree::ChooseE(value, arms, span) => self.choose_expression(value, arms, span, expected),
            ast::ExprTree::StructLit(name, fields, span) => self.struct_literal(name, fields, span, expected),
            ast::ExprTree::CallE(name, type_arguments, arguments, span) => self.call_at(name, type_arguments, arguments, span, expected),
            ast::ExprTree::MethodCallE(receiver, name, type_arguments, arguments, span) => self.method_expression(receiver, name, type_arguments, arguments, span, expected),
            ast::ExprTree::VecNewE(element, span) => self.vec_new(element, expected),
            ast::ExprTree::MapNewE(key, value, span) => self.map_new(key, value),
            ast::ExprTree::SetNewE(element, span) => self.set_new(element),
            ast::ExprTree::IndexE(value, position, span) => self.index_expression(value, position, expected, span),
            ast::ExprTree::LayoutE(ty, alignment, span) => self.layout_of(ty, alignment),
            ast::ExprTree::AddressOfE(mutable, raw, value, span) => self.address_of(mutable, raw, value, span),
            ast::ExprTree::DerefE(pointer, span) => self.dereference(pointer),
            ast::ExprTree::TupleE(elements, span) => self.tuple_literal(elements, expected),
            ast::ExprTree::RangeE(start, end, inclusive, span) => self.range_literal(start, end, inclusive, expected),
            ast::ExprTree::ArrayE(elements, span) => self.array_literal(elements, expected),
            ast::ExprTree::RepeatE(value, length, span) => self.array_repeat(value, length, span, expected),
            ast::ExprTree::PropagateE(value, span) => self.propagate(value, span),
            ast::ExprTree::PipeE(value, target, span) => self.pipe_expression(value, target, expected),
            ast::ExprTree::CoalesceE(value, fallback, span) => self.coalesce_expression(value, fallback, span),
            ast::ExprTree::OptionalFieldE(value, name, name_span, span) => self.optional_field_expression(value, name, name_span),
            _ => Result::Err(unsupported(self.expr_kind(index))),
        }
    }

    fun expr_kind(self, index: u64) -> String {
        choose self.program.exprs[index] {
            ast::ExprTree::IntLit(a, s) => String("expr IntLit"),
            ast::ExprTree::FloatLit(a, s) => String("expr FloatLit"),
            ast::ExprTree::StrLit(a, s) => String("expr StrLit"),
            ast::ExprTree::CharLit(a, s) => String("expr CharLit"),
            ast::ExprTree::BoolLit(a, s) => String("expr BoolLit"),
            ast::ExprTree::NameRef(a, s) => String("expr NameRef"),
            ast::ExprTree::CallE(a, b, c, s) => String("expr CallE"),
            ast::ExprTree::MethodCallE(a, b, c, d, s) => String("expr MethodCallE"),
            ast::ExprTree::StructLit(a, b, s) => String("expr StructLit"),
            ast::ExprTree::FieldE(a, b, c, s) => String("expr FieldE"),
            ast::ExprTree::RangeE(a, b, c, s) => String("expr RangeE"),
            ast::ExprTree::IfE(a, b, c, s) => String("expr IfE"),
            ast::ExprTree::BinaryE(a, b, c, s) => String("expr BinaryE"),
            ast::ExprTree::NegateE(a, s) => String("expr NegateE"),
            ast::ExprTree::NotE(a, s) => String("expr NotE"),
            ast::ExprTree::BitNotE(a, s) => String("expr BitNotE"),
            ast::ExprTree::AddressOfE(a, b, c, s) => String("expr AddressOfE"),
            ast::ExprTree::DerefE(a, s) => String("expr DerefE"),
            ast::ExprTree::CastE(a, b, s) => String("expr CastE"),
            ast::ExprTree::LayoutE(a, b, s) => String("expr LayoutE"),
            ast::ExprTree::VecNewE(a, s) => String("expr VecNewE"),
            ast::ExprTree::MapNewE(a, b, s) => String("expr MapNewE"),
            ast::ExprTree::SetNewE(a, s) => String("expr SetNewE"),
            ast::ExprTree::TupleE(a, s) => String("expr TupleE"),
            ast::ExprTree::ArrayE(a, s) => String("expr ArrayE"),
            ast::ExprTree::RepeatE(a, b, s) => String("expr RepeatE"),
            ast::ExprTree::IndexE(a, b, s) => String("expr IndexE"),
            ast::ExprTree::PropagateE(a, s) => String("expr PropagateE"),
            ast::ExprTree::EnumE(a, b, c, s) => String("expr EnumE"),
            ast::ExprTree::ChooseE(a, b, s) => String("expr ChooseE"),
            ast::ExprTree::PipeE(a, b, s) => String("expr PipeE"),
            ast::ExprTree::CoalesceE(a, b, s) => String("expr CoalesceE"),
            ast::ExprTree::OptionalFieldE(a, b, c, s) => String("expr OptionalFieldE"),
        }
    }

    // A literal takes the expected integer type. In any other context it is `I64`, as the bootstrap
    // types it, and the caller then reports the mismatch; a value beyond `I64` is declined.
    fun integer(self, value: u64, expected: String) -> Result<Lowered, String> {
        mut ty := expected.clone()
        when !is_integer_word(ty.clone()) {
            when value > 9223372036854775807 {
                return Result::Err(unsupported("integer type"))
            }
            ty = String("I64")
        }
        text := join(words3(String("Integer"), num(value), ty.clone()))
        return Result::Ok(Lowered { text: text, ty: ty })
    }

    // A float literal is written as the bits of its f64 value; it is an f32 only where one is expected.
    fun float_literal(self, bits: String, expected: String) -> Result<Lowered, String> {
        mut ty := expected.clone()
        when ty.is_empty() {
            ty = String("F64")
        }
        when !is_float_word(ty.clone()) {
            return Result::Err(unsupported("float literal where another type is expected"))
        }
        return Result::Ok(Lowered { text: join(words3(String("Float"), float_bits(bits)?, ty.clone())), ty: ty })
    }

    fun character_literal(self, value: u64, expected: String) -> Result<Lowered, String> {
        when !expected.is_empty() && expected != "Char" {
            return Result::Err(unsupported("character where another type is expected"))
        }
        return Result::Ok(Lowered { text: join(words2(String("Character"), num(value))), ty: String("Char") })
    }

    // `~value` on an integer; the expected integer type, else the operand's, types a literal.
    fun bit_not(mut self, value: u64, span: ast::Span, expected: String) -> Result<Lowered, String> {
        mut context := String("")
        when !expected.is_empty() && is_integer_word(expected.clone()) {
            context = expected.clone()
        } else {
            context = self.operand_hint(value, true)?
        }
        lowered := self.expression(value, context.clone())
        when lowered.is_err() {
            refusal := lowered.unwrap_err()
            other := self.other_type_of(value, context, refusal.clone())
            when other.is_some() {
                operand_ty := other.unwrap()
                when !is_integer_word(operand_ty) {
                    return Result::Err(unary_diagnostic("unary `~` requires an integer value", "use `~` with a signed or unsigned integer", span.start, span.end))
                }
            }
            return Result::Err(refusal)
        }
        operand := lowered.unwrap()
        when !is_integer_word(operand.ty.clone()) {
            return Result::Err(unary_diagnostic("unary `~` requires an integer value", "use `~` with a signed or unsigned integer", span.start, span.end))
        }
        return Result::Ok(Lowered { text: join(words3(String("BitNot"), operand.text, operand.ty.clone())), ty: operand.ty })
    }

    fun string_literal(self, text: String) -> Result<Lowered, String> {
        tokens := join(words2(String("String"), length_prefixed(text)))
        return Result::Ok(Lowered { text: tokens, ty: String("Str") })
    }

    // A name is a local, or a function where a function pointer is expected.
    fun name_with(self, name: String, span: ast::Span, expected: String) -> Result<Lowered, String> {
        when self.borrowed_name(name.clone(), true) {
            return Result::Err(borrowed_use_error(span.start, span.end))
        }
        when self.is_moved(name.clone()) {
            return Result::Err(moved_value_error(span.start, span.end))
        }
        when self.raw_target_moved(name.clone()) {
            return Result::Err(moved_raw_pointer_error(span.start, span.end))
        }
        when name == "null" && self.find(name.clone()).is_err() {
            return self.null_expression(expected, span)
        }
        when self.find(name.clone()).is_err() && expected.starts_with("FunctionPointer ") {
            return self.function_address(name, expected)
        }
        return self.name(name, span)
    }

    fun name(self, name: String, span: ast::Span) -> Result<Lowered, String> {
        when self.find(name.clone()).is_err() && name != "null" {
            return Result::Err(self.unknown_variable(name, span))
        }
        index := self.find(name)?
        slot := self.locals[index].slot
        ty := self.locals[index].ty.clone()
        text := join(words5(String("Local"), num(slot), ty.clone(), num(span.start), num(span.end)))
        return Result::Ok(Lowered { text: text, ty: ty })
    }

    // `value as T` between numeric types, and from `char` to an integer. A bare integer literal
    // takes an integer target as its own type.
    fun cast(mut self, value: u64, target_index: u64, expected: String) -> Result<Lowered, String> {
        target := self.annotation(target_index)?
        when target.starts_with("FunctionPointer ") {
            return self.cast_to_function_pointer(value, target)
        }
        when target.starts_with("RawPointer ") {
            operand := self.expression(value, String(""))?
            when operand.ty.starts_with("RawPointer ") || operand.ty.starts_with("FunctionPointer ") || is_integer_word(operand.ty.clone()) {
                return Result::Ok(Lowered { text: join(words4(String("Cast"), operand.text, operand.ty.clone(), target.clone())), ty: target })
            }
            return Result::Err(unsupported("raw pointer cast source"))
        }
        when !is_numeric_word(target.clone()) {
            return Result::Err(unsupported("cast to this type"))
        }
        when !expected.is_empty() && expected != target {
            return Result::Err(unsupported("cast where another type is expected"))
        }
        mut context := String("")
        when self.literal_value(value).is_some() && is_integer_word(target.clone()) {
            context = target.clone()
        }
        operand := self.expression(value, context)?
        source := operand.ty.clone()
        when (source.starts_with("RawPointer ") || source.starts_with("FunctionPointer ")) && (target == "U64" || target == "I64") {
            return Result::Ok(Lowered { text: join(words4(String("Cast"), operand.text, source, target.clone())), ty: target })
        }
        when !is_numeric_word(source.clone()) && !(source == "Char" && is_integer_word(target.clone())) {
            return Result::Err(unsupported("cast from this type"))
        }
        return Result::Ok(Lowered { text: join(words4(String("Cast"), operand.text, source, target.clone())), ty: target })
    }

    // `value as <function pointer>`: a function name becomes its address; a raw pointer is reinterpreted.
    fun cast_to_function_pointer(mut self, value: u64, target: String) -> Result<Lowered, String> {
        direct := self.function_name_of(value)
        when direct.is_some() && self.find(direct.unwrap()).is_err() && self.signature_index(direct.unwrap()).is_ok() {
            return self.function_address(direct.unwrap(), target)
        }
        operand := self.expression(value, String(""))?
        when !operand.ty.starts_with("RawPointer ") && !operand.ty.starts_with("FunctionPointer ") {
            return Result::Err(unsupported("function pointer cast source"))
        }
        return Result::Ok(Lowered { text: join(words4(String("Cast"), operand.text, operand.ty.clone(), target.clone())), ty: target })
    }

    fun function_name_of(self, index: u64) -> Option<String> {
        choose self.program.exprs[index] {
            ast::ExprTree::NameRef(name, span) => Option::Some(name),
            _ => Option::None,
        }
    }

    fun boolean_literal(self, value: bool, expected: String) -> Result<Lowered, String> {
        when !expected.is_empty() && expected != "Bool" {
            return Result::Err(unsupported("boolean where another type is expected"))
        }
        mut bit: u64 = 0
        when value {
            bit = 1
        }
        return Result::Ok(Lowered { text: join(words2(String("Boolean"), num(bit))), ty: String("Bool") })
    }

    fun arithmetic_negation(mut self, value: u64, span: ast::Span, expected: String) -> Result<Lowered, String> {
        literal := self.literal_value(value)
        when literal.is_some() {
            mut literal_ty := expected.clone()
            when literal_ty.is_empty() || !is_integer_word(literal_ty.clone()) {
                literal_ty = String("I64")
            }
            when !is_signed_word(literal_ty.clone()) {
                return Result::Err(unary_diagnostic("unary `-` requires a signed integer or floating-point value", "declare the value with a signed integer or floating-point type before negating it", span.start, span.end))
            }
            when needs_folding(literal.unwrap(), literal_ty.clone()) {
                return self.negative_integer(literal.unwrap(), literal_ty)
            }
            operand := self.expression(value, literal_ty.clone())?
            return Result::Ok(Lowered { text: join(words3(String("Negate"), operand.text, literal_ty.clone())), ty: operand.ty })
        }
        lowered := self.expression(value, expected.clone())
        when lowered.is_err() {
            refusal := lowered.unwrap_err()
            other := self.other_type_of(value, expected, refusal.clone())
            when other.is_some() {
                operand_ty := other.unwrap()
                when !is_signed_word(operand_ty.clone()) && !is_float_word(operand_ty) {
                    return Result::Err(unary_diagnostic("unary `-` requires a signed integer or floating-point value", "declare the value with a signed integer or floating-point type before negating it", span.start, span.end))
                }
            }
            return Result::Err(refusal)
        }
        operand := lowered.unwrap()
        when !is_signed_word(operand.ty.clone()) && !is_float_word(operand.ty.clone()) {
            return Result::Err(unary_diagnostic("unary `-` requires a signed integer or floating-point value", "declare the value with a signed integer or floating-point type before negating it", span.start, span.end))
        }
        return Result::Ok(Lowered { text: join(words3(String("Negate"), operand.text, operand.ty.clone())), ty: operand.ty })
    }

    // The value of an integer literal expression, if it is one.
    fun literal_value(self, index: u64) -> Option<u64> {
        choose self.program.exprs[index] {
            ast::ExprTree::IntLit(value, span) => Option::Some(value),
            _ => Option::None,
        }
    }

    // `-N` for a literal N is one literal with a negative value.
    fun negative_integer(self, value: u64, expected: String) -> Result<Lowered, String> {
        mut ty := expected.clone()
        when ty.is_empty() {
            ty = String("I64")
        }
        when !is_integer_word(ty.clone()) {
            return Result::Err(unsupported("integer type"))
        }
        mut text := String("-")
        text.append(String(value))
        return Result::Ok(Lowered { text: join(words3(String("Integer"), text, ty.clone())), ty: ty })
    }

    fun negation(mut self, value: u64, span: ast::Span, expected: String) -> Result<Lowered, String> {
        when !expected.is_empty() && expected != "Bool" {
            return Result::Err(unsupported("boolean where another type is expected"))
        }
        lowered := self.expression(value, String("Bool"))
        when lowered.is_err() {
            refusal := lowered.unwrap_err()
            other := self.other_type_of(value, String("Bool"), refusal.clone())
            when other.is_some() {
                return Result::Err(unary_diagnostic("unary `!` requires a `bool` value", "use `!` with a boolean value or comparison", span.start, span.end))
            }
            return Result::Err(refusal)
        }
        operand := lowered.unwrap()
        when operand.ty != "Bool" {
            return Result::Err(unary_diagnostic("unary `!` requires a `bool` value", "use `!` with a boolean value or comparison", span.start, span.end))
        }
        return Result::Ok(Lowered { text: join(words2(String("Not"), operand.text)), ty: String("Bool") })
    }

    // Whether `ty` can type the operands of an operator: integers for bitwise ones, numbers otherwise.
    fun operand_ok(self, ty: String, bitwise: bool) -> bool {
        when bitwise {
            return is_integer_word(ty)
        }
        return is_numeric_word(ty)
    }

    // The numeric type an operand says by itself, else "".
    fun operand_hint(self, index: u64, bitwise: bool) -> Result<String, String> {
        ty := self.numeric_hint(index)
        when ty.is_empty() || !self.operand_ok(ty.clone(), bitwise) {
            return Result::Ok(String(""))
        }
        return Result::Ok(ty)
    }

    // `id<i32>(1)` parses as a comparison; the bootstrap analyzer points at `::<`.
    fun generic_call_hint(self, op: String, left: u64, right: u64) -> Result<bool, String> {
        when op != "Lt" {
            return Result::Ok(false)
        }
        callee := self.name_text(left)
        type_word := self.name_text(right)
        when callee.is_empty() || type_word.is_empty() || self.find(callee.clone()).is_ok() {
            return Result::Ok(false)
        }
        when type_word == "i8" || type_word == "i16" || type_word == "i32" || type_word == "i64" || type_word == "u8" || type_word == "u16"
            || type_word == "u32" || type_word == "u64" || type_word == "f32" || type_word == "f64" || type_word == "bool" || type_word == "char"
            || type_word == "str" || type_word == "String" {
            span := self.expr_span_of(left)
            mut message := String("unknown variable `")
            message.append(callee.clone())
            message.push('`')
            mut help := String("generic arguments are written after `::`, e.g. `")
            help.append(callee)
            help.append("::<")
            help.append(type_word)
            help.append(">(...)`")
            return Result::Err(diagnostic("R0203", span.start, span.end, message, help))
        }
        return Result::Ok(false)
    }

    fun name_text(self, index: u64) -> String {
        return match_name(self.program.exprs[index])
    }

    fun binary(mut self, op: String, left: u64, right: u64, expected: String, span: ast::Span) -> Result<Lowered, String> {
        self.generic_call_hint(op.clone(), left, right)?
        when is_logical(op.clone()) {
            when !expected.is_empty() && expected != "Bool" {
                return Result::Err(unsupported("boolean where another type is expected"))
            }
            return self.logical(op, left, right, span)
        }
        bitwise := is_bitwise_op(op.clone())
        mut context := String("")
        when !expected.is_empty() && self.operand_ok(expected.clone(), bitwise) {
            context = expected.clone()
        }
        when context.is_empty() {
            context = self.operand_hint(left, bitwise)?
        }
        when context.is_empty() && !is_shift_op(op.clone()) {
            context = self.operand_hint(right, bitwise)?
        }
        lhs := self.expression(left, context.clone())?
        method := operator_method_name(op.clone())
        when struct_id_of(lhs.ty.clone()).is_some() && !method.is_empty() {
            overloaded := self.operator_call(lhs.clone(), method, right, span)?
            when overloaded.is_some() {
                return Result::Ok(overloaded.unwrap())
            }
        }
        return self.binary_rest(op, lhs, right, context, expected, self.expr_span_of(left), span, true)
    }

    // Whether an operand is a numeric literal or a unary operation on one. Its type comes from the context
    // that the bootstrap derives from the other operand, which is not reproduced for `&&` and `||`.
    fun literal_operand(self, index: u64) -> bool {
        choose self.program.exprs[index] {
            ast::ExprTree::IntLit(value, span) => true,
            ast::ExprTree::FloatLit(bits, span) => true,
            ast::ExprTree::NegateE(value, span) => true,
            ast::ExprTree::BitNotE(value, span) => true,
            _ => false,
        }
    }

    // `left && right` or `left || right`: both operands are `bool`. An operand that the expression
    // lowering refuses for its type is probed for its own type, and the first operand that is not
    // `bool` gives `R0206`.
    fun logical(mut self, op: String, left: u64, right: u64, span: ast::Span) -> Result<Lowered, String> {
        when self.literal_operand(left) || self.literal_operand(right) {
            return Result::Err(unsupported("logical operator on a literal operand"))
        }
        left_result := self.expression(left, String("Bool"))
        right_result := self.expression(right, String("Bool"))
        mut left_ty := String("Bool")
        mut left_text := String("")
        when left_result.is_err() {
            refusal := left_result.unwrap_err()
            other := self.other_type_of(left, String("Bool"), refusal.clone())
            when other.is_none() {
                return Result::Err(refusal)
            }
            left_ty = other.unwrap()
        } else {
            left_value := left_result.unwrap()
            left_ty = left_value.ty.clone()
            left_text = left_value.text
        }
        mut right_ty := String("Bool")
        mut right_text := String("")
        when right_result.is_err() {
            refusal := right_result.unwrap_err()
            other := self.other_type_of(right, String("Bool"), refusal.clone())
            when other.is_none() {
                return Result::Err(refusal)
            }
            right_ty = other.unwrap()
        } else {
            right_value := right_result.unwrap()
            right_ty = right_value.ty.clone()
            right_text = right_value.text
        }
        when left_ty != "Bool" {
            error := logical_error(left_ty.clone(), right_ty.clone(), self.expr_span_of(left))
            when error.is_some() {
                return Result::Err(error.unwrap())
            }
            return Result::Err(unsupported("logical operator on non-boolean operands"))
        }
        when right_ty != "Bool" {
            error := logical_error(left_ty.clone(), right_ty.clone(), self.expr_span_of(right))
            when error.is_some() {
                return Result::Err(error.unwrap())
            }
            return Result::Err(unsupported("logical operator on non-boolean operands"))
        }
        text := join(words5(String("Binary"), op, left_text, right_text, String("Bool")))
        return Result::Ok(Lowered { text: text, ty: String("Bool") })
    }

    // `left <op> right` on a structure with an operator method (`add`, `sub`, ...) in its `extend`.
    fun operator_call(mut self, lhs: Lowered, method: String, right: u64, span: ast::Span) -> Result<Option<Lowered>, String> {
        id := struct_id_of(lhs.ty.clone()).unwrap()
        mut key := self.structs[id].name.clone()
        key.append("::")
        key.append(method)
        key.append("#method")
        found := self.signature_index(key)
        when found.is_err() {
            return Result::Ok(Option::None)
        }
        params := self.signatures[found.unwrap()].params.clone()
        when params.len() != 2 {
            return Result::Ok(Option::None)
        }
        rhs := self.expression(right, params[1].clone())?
        when rhs.ty != params[1] {
            return Result::Ok(Option::None)
        }
        mut pointer := String("Reference ")
        pointer.append(lhs.ty.clone())
        pointer.append(" 0")
        receiver := join(words6(String("ValueAddress"), lhs.text, lhs.ty.clone(), pointer, num(span.start), num(span.end)))
        mut ret := self.signatures[found.unwrap()].ret.clone()
        when ret.is_empty() {
            ret = lhs.ty.clone()
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("Call"))
        tokens.push(String("Function"))
        tokens.push(num(found.unwrap()))
        tokens.push(String("2"))
        tokens.push(receiver)
        tokens.push(rhs.text)
        tokens.push(ret.clone())
        return Result::Ok(Option::Some(Lowered { text: join(tokens), ty: ret }))
    }

    // The rest of a binary operation once its left operand is lowered. A compound assignment
    // enters here with the assigned place as the left operand.
    // `located` is false for a compound assignment to a field, whose operation span is not written here;
    // such an operation is declined rather than reported with a span that might differ.
    fun binary_rest(mut self, op: String, first: Lowered, right: u64, context: String, expected: String, left_span: ast::Span, span: ast::Span, located: bool) -> Result<Lowered, String> {
        mut lhs := first
        bitwise := is_bitwise_op(op.clone())
        shift := is_shift_op(op.clone())
        comparison := is_comparison(op.clone())
        when !expected.is_empty() && comparison && expected != "Bool" {
            return Result::Err(unsupported("comparison where another type is expected"))
        }
        mut right_context := context.clone()
        when shift {
            right_context = String("U32")
        } else when right_context.is_empty() && self.operand_ok(lhs.ty.clone(), bitwise) {
            right_context = lhs.ty.clone()
        } else when right_context.is_empty() && lhs.ty.starts_with("RawPointer ") && (op == "Eq" || op == "Ne") {
            // A raw pointer compared for equality types a `null` on the right, as the bootstrap's `left_context` does.
            right_context = lhs.ty.clone()
        }
        rhs_result := self.expression(right, right_context.clone())
        when rhs_result.is_err() {
            // The right operand refused the context type: its own type may still be the operator's mismatch.
            refusal := rhs_result.unwrap_err()
            other := self.other_type_of(right, right_context, refusal.clone())
            when located && other.is_some() {
                right_span := self.expr_span_of(right)
                mismatch := operator_mismatch(op.clone(), lhs.ty.clone(), other.unwrap(), left_span, right_span, span)
                when mismatch.is_some() {
                    return Result::Err(mismatch.unwrap())
                }
            }
            return Result::Err(refusal)
        }
        mut rhs := rhs_result.unwrap()
        // `String == str` compares the text through a borrowed view.
        when (op == "Eq" || op == "Ne") && lhs.ty == "OwnedString" && rhs.ty == "Str" {
            lhs = Lowered { text: join(words2(String("StringAsStr"), lhs.text)), ty: String("Str") }
        } else when (op == "Eq" || op == "Ne") && lhs.ty == "Str" && rhs.ty == "OwnedString" {
            rhs = Lowered { text: join(words2(String("StringAsStr"), rhs.text)), ty: String("Str") }
        }
        when located {
            right_span := self.expr_span_of(right)
            mismatch := operator_mismatch(op.clone(), lhs.ty.clone(), rhs.ty.clone(), left_span, right_span, span)
            when mismatch.is_some() {
                return Result::Err(mismatch.unwrap())
            }
        }
        when comparison {
            equality := op == "Eq" || op == "Ne"
            mut valid := lhs.ty == rhs.ty
            when equality {
                valid = valid && (is_numeric_word(lhs.ty.clone()) || lhs.ty == "Str" || lhs.ty == "OwnedString" || lhs.ty == "Char" || lhs.ty == "Bool" || lhs.ty.starts_with("RawPointer ") || lhs.ty.starts_with("FunctionPointer "))
            } else {
                valid = valid && (is_numeric_word(lhs.ty.clone()) || lhs.ty == "Char")
            }
            when !valid {
                return Result::Err(unsupported("comparison of this type"))
            }
            return Result::Ok(Lowered { text: join(words5(String("Binary"), op, lhs.text, rhs.text, lhs.ty.clone())), ty: String("Bool") })
        }
        word := operator_word(op.clone())?
        when shift {
            when !is_integer_word(lhs.ty.clone()) || rhs.ty != "U32" {
                return Result::Err(unsupported("shift of this type"))
            }
        } else when bitwise {
            when !is_integer_word(lhs.ty.clone()) || lhs.ty != rhs.ty {
                return Result::Err(unsupported("bitwise operator on this type"))
            }
        } else {
            when !is_numeric_word(lhs.ty.clone()) || lhs.ty != rhs.ty {
                return Result::Err(unsupported("arithmetic on this type"))
            }
            when op == "Rem" && !is_integer_word(lhs.ty.clone()) {
                return Result::Err(unsupported("remainder of this type"))
            }
        }
        when !expected.is_empty() && expected != lhs.ty {
            return Result::Err(unsupported("operation where another type is expected"))
        }
        return Result::Ok(Lowered { text: join(words5(String("Binary"), word, lhs.text, rhs.text, lhs.ty.clone())), ty: lhs.ty })
    }

    // `R0212` for an argument whose type is not the parameter's type, at the argument's span. The
    // name is the one the call writes. Only scalar and string types are spelled here.
    fun argument_mismatch(self, name: String, argument: u64, actual: String, expected: String) -> Option<String> {
        actual_name := scalar_type_name(actual)
        expected_name := scalar_type_name(expected)
        when actual_name.is_none() || expected_name.is_none() {
            return Option::None
        }
        actual_text := actual_name.unwrap()
        expected_text := expected_name.unwrap()
        span := self.expr_span_of(argument)
        mut message := String("argument to `")
        message.append(name.clone())
        message.append("` has type `")
        message.append(actual_text)
        message.append("` but `")
        message.append(expected_text.clone())
        message.append("` is required")
        mut help := String("pass a `")
        help.append(expected_text)
        help.append("` value to `")
        help.append(name)
        help.append("`")
        return Option::Some(diagnostic("R0212", span.start, span.end, message, help))
    }

    // The type of an expression that the expression lowering refused because it has another type
    // than `expected` (`... where another type is expected`). Lowering it without an expected type
    // gives its own type. Any other refusal, or a probe that fails, has no such type.
    fun other_type_of(mut self, index: u64, expected: String, refusal: String) -> Option<String> {
        when !refusal.contains(" where another type is expected") {
            return Option::None
        }
        probe := self.expression(index, String(""))
        when probe.is_err() {
            return Option::None
        }
        actual := probe.unwrap().ty
        when actual == expected {
            return Option::None
        }
        return Option::Some(actual)
    }

    // An argument refused for its type: a scalar or string type is `R0212`, and any other refusal stands.
    fun wrong_type_argument(mut self, name: String, argument: u64, expected: String, refusal: String) -> String {
        other := self.other_type_of(argument, expected.clone(), refusal.clone())
        when other.is_some() {
            mismatch := self.argument_mismatch(name, argument, other.unwrap(), expected)
            when mismatch.is_some() {
                return mismatch.unwrap()
            }
        }
        return refusal
    }

    // `R0202` for a `let` whose name is already declared in the scope, at the statement's span.
fun redeclared_let(name: String, start: u64, end: u64) -> String {
    mut message := String("`")
    message.append(name.clone())
    message.append("` is already declared in this scope")
    mut help := String("choose a different name or remove the second declaration of `")
    help.append(name)
    help.append("`")
    return diagnostic("R0202", start, end, message, help)
}

// `R0205` for an initializer whose type is not the declared type, at the initializer's span.
    fun declared_mismatch(self, value: u64, declared: String, actual: String) -> Option<String> {
        declared_name := scalar_type_name(declared)
        actual_name := scalar_type_name(actual)
        when declared_name.is_none() || actual_name.is_none() {
            return Option::None
        }
        declared_text := declared_name.unwrap()
        actual_text := actual_name.unwrap()
        span := self.expr_span_of(value)
        mut message := String("declared type `")
        message.append(declared_text.clone())
        message.append("` does not match initializer type `")
        message.append(actual_text)
        message.append("`")
        mut help := String("make the initializer a `")
        help.append(declared_text)
        help.append("` value or change the type annotation")
        return Option::Some(diagnostic("R0205", span.start, span.end, message, help))
    }

    // Checks the argument list against a signature and lowers each argument to its parameter type.
    fun arguments(mut self, id: u64, name: String, arguments: Vec<u64>) -> Result<Vec<String>, String> {
        params := self.signatures[id].params.clone()
        when arguments.len() != params.len() {
            return Result::Err(unsupported("argument count"))
        }
        mut lowered: Vec<String> = Vec()
        mut explicit: Vec<ExplicitBorrow> = Vec()
        mut position: u64 = 0
        while position < arguments.len() {
            // A `str` parameter borrows an owning String for the call.
            when params[position] == "Str" && self.value_hint(arguments[position]) == "OwnedString" {
                value := self.expression(arguments[position], String(""))?
                when value.ty != "OwnedString" {
                    return Result::Err(unsupported("argument type"))
                }
                lowered.push(join(words2(String("StringAsStr"), value.text)))
                position += 1
                continue
            }
            when params[position].starts_with("Slice ") {
                coerced := self.slice_argument(arguments[position], params[position].clone())?
                lowered.push(coerced)
                position += 1
                continue
            }
            lowered_argument := self.moved_expression(arguments[position], params[position].clone())
            when lowered_argument.is_err() {
                return Result::Err(self.wrong_type_argument(name.clone(), arguments[position], params[position].clone(), lowered_argument.unwrap_err()))
            }
            value := lowered_argument.unwrap()
            // A `str` parameter borrows an owning String result for the call.
            when value.ty == "OwnedString" && params[position] == "Str" {
                lowered.push(join(words2(String("StringAsStr"), value.text)))
                position += 1
                continue
            }
            when value.ty != params[position] {
                mismatch := self.argument_mismatch(name.clone(), arguments[position], value.ty.clone(), params[position].clone())
                when mismatch.is_some() {
                    return Result::Err(mismatch.unwrap())
                }
                return Result::Err(unsupported("argument type"))
            }
            // `R0249`: a reference argument that names the same local as an earlier one, when either is mutable.
            when self.explicit_borrow(arguments[position]).is_some() {
                current := self.explicit_borrow(arguments[position]).unwrap()
                for previous in explicit.clone() {
                    when previous.local == current.local && (previous.mutable || current.mutable) {
                        return Result::Err(conflicting_argument_error(current.start, current.end))
                    }
                }
                explicit.push(current)
            }
            lowered.push(value.text)
            position += 1
        }
        return Result::Ok(lowered)
    }

    // The local that a `&name` or `&mut name` expression borrows; a raw pointer is not a reference.
    fun explicit_borrow(self, index: u64) -> Option<ExplicitBorrow> {
        choose self.program.exprs[index] {
            ast::ExprTree::AddressOfE(mutable, raw, inner, span) => self.explicit_borrow_of(mutable, raw, inner, span),
            _ => Option::None,
        }
    }

    fun explicit_borrow_of(self, mutable: bool, raw: bool, inner: u64, span: ast::Span) -> Option<ExplicitBorrow> {
        when raw {
            return Option::None
        }
        local := self.local_named(inner)
        when local.is_none() {
            return Option::None
        }
        return Option::Some(ExplicitBorrow { local: local.unwrap(), mutable: mutable, start: span.start, end: span.end })
    }

    // `String(value)`: a copy of a `str` or `String`, or the text of a number.
    fun string_constructor(mut self, arguments: Vec<u64>, expected: String) -> Result<Lowered, String> {
        when !expected.is_empty() && expected != "OwnedString" {
            return Result::Err(unsupported("String where another type is expected"))
        }
        when arguments.is_empty() {
            return Result::Ok(Lowered { text: join(words5(String("Call"), String("String"), String("New"), String("1"), join(words3(String("String"), String("0:"), String("OwnedString"))))), ty: String("OwnedString") })
        }
        when arguments.len() != 1 {
            return Result::Err(unsupported("String sigwords"))
        }
        value := self.expression(arguments[0], String(""))?
        mut operation := String("")
        when value.ty == "Str" {
            operation = String("New")
        } else when value.ty == "OwnedString" {
            operation = String("Clone")
        } else when is_numeric_word(value.ty.clone()) {
            operation = String("From")
            operation.append(value.ty.clone())
        } else {
            return Result::Err(unsupported("String from this type"))
        }
        return Result::Ok(Lowered { text: join(words5(String("Call"), String("String"), operation, String("1"), join(words2(value.text, String("OwnedString"))))), ty: String("OwnedString") })
    }

    // A call to a function the compiler provides: the command-line builtins and the table in
    // `builtins`. The text holds the target, argument count, and arguments; the type is the result
    // type, empty for none.
    fun builtin_target(mut self, name: String, arguments: Vec<u64>) -> Result<Lowered, String> {
        when name == "arg_count" {
            when !arguments.is_empty() {
                return Result::Err(unsupported("arg_count sigwords"))
            }
            return Result::Ok(Lowered { text: join(words2(String("ArgumentCount"), String("0"))), ty: String("U32") })
        }
        when name == "arg" {
            when arguments.len() != 1 {
                return Result::Err(unsupported("arg sigwords"))
            }
            index := self.expression(arguments[0], String("U32"))?
            when index.ty != "U32" {
                return Result::Err(unsupported("arg index type"))
            }
            return Result::Ok(Lowered { text: join(words3(String("Argument"), String("1"), index.text)), ty: String("Str") })
        }
        when name == "try_read_file" || name == "read_file_result" {
            when arguments.len() != 1 {
                return Result::Err(unsupported("file call arguments"))
            }
            mut id: u64 = 0
            mut target := String("TryReadFile")
            when name == "try_read_file" {
                id = self.option_index(String("OwnedString"))?
            } else {
                target = String("ReadFileResult")
                id = self.result_index(String("OwnedString"), String("I32"))?
            }
            path := self.expression(arguments[0], String(""))?
            mut text := path.text.clone()
            when path.ty == "OwnedString" {
                text = join(words2(String("StringAsStr"), path.text))
            } else when path.ty != "Str" {
                return Result::Err(unsupported("file path type"))
            }
            return Result::Ok(Lowered { text: join(words4(target, num(id), String("1"), text)), ty: join(words2(String("Enum"), num(id))) })
        }
        entry := builtins::builtin_named(name)
        when entry.is_none() {
            return Result::Err(unsupported("unknown function"))
        }
        builtin := entry.unwrap()
        when arguments.len() != builtin.params.len() {
            return Result::Err(unsupported("builtin argument count"))
        }
        borrows := builtin.target.starts_with("Filesystem") || builtin.target.starts_with("String") || builtin.target.starts_with("System")
        mut tokens: Vec<String> = Vec()
        tokens.push(builtin.target.clone())
        tokens.push(num(arguments.len()))
        mut position: u64 = 0
        while position < arguments.len() {
            expected := builtin.params[position].clone()
            mut context := expected.clone()
            when borrows && expected == "Str" {
                context = String("")
            }
            mut value := Lowered { text: String(""), ty: String("") }
            when builtin.target == "System RunProcessArgs" && position == 1 {
                value = self.moved_expression(arguments[position], context)?
            } else {
                value = self.expression(arguments[position], context)?
            }
            when value.ty == expected {
                tokens.push(value.text)
            } else when borrows && expected == "Str" && value.ty == "OwnedString" {
                tokens.push(join(words2(String("StringAsStr"), value.text)))
            } else {
                return Result::Err(unsupported("builtin argument type"))
            }
            position += 1
        }
        return Result::Ok(Lowered { text: join(tokens), ty: builtin.ret.clone() })
    }

    fun builtin_call(mut self, name: String, arguments: Vec<u64>, expected: String) -> Result<Lowered, String> {
        when name == "String" {
            return self.string_constructor(arguments, expected)
        }
        lowered := self.builtin_target(name, arguments)?
        when lowered.ty.is_empty() {
            return Result::Err(unsupported("value of a call without a result"))
        }
        when !expected.is_empty() && expected != lowered.ty {
            return Result::Err(unsupported("call result type"))
        }
        return Result::Ok(Lowered { text: join(words3(String("Call"), lowered.text, lowered.ty.clone())), ty: lowered.ty })
    }

    // A local function pointer is called indirectly; any other name is a function.
    // `R0211` for a call to a function of this program with the wrong number of arguments. The
    // bootstrap checks that a function of another module is public first (`R0425`), so a private
    // one is declined here and left to the bootstrap. The name is the one the call writes.
    fun arity_mismatch(self, name: String, count: u64, span: ast::Span) -> Option<String> {
        found := self.signature_index(name.clone())
        when found.is_err() {
            return Option::None
        }
        id := found.unwrap()
        expected := self.signatures[id].params.len()
        when expected == count {
            return Option::None
        }
        when !self.signatures[id].public && self.signatures[id].module != self.module {
            return Option::None
        }
        mut message := String("function `")
        message.append(name.clone())
        message.append("` expects ")
        message.append(String(expected))
        message.append(" arguments but got ")
        message.append(String(count))
        mut help := String("pass exactly ")
        help.append(String(expected))
        when expected == 1 {
            help.append(" argument")
        } else {
            help.append(" arguments")
        }
        help.append(" to `")
        help.append(name)
        help.append("`")
        return Option::Some(diagnostic("R0211", span.start, span.end, message, help))
    }

    fun call_at(mut self, name: String, type_arguments: Vec<u64>, arguments: Vec<u64>, span: ast::Span, expected: String) -> Result<Lowered, String> {
        found := self.find(name.clone())
        when found.is_ok() && self.locals[found.unwrap()].ty.starts_with("FunctionPointer ") {
            lowered := self.indirect_call(name, arguments, span)?
            when lowered.ty.is_empty() {
                return Result::Err(unsupported("value of a call without a result"))
            }
            return Result::Ok(Lowered { text: join(words3(String("Call"), lowered.text, lowered.ty.clone())), ty: lowered.ty })
        }
        // `R0425`: a function that another module does not make public, at the call's span.
        when self.private_function_call(name.clone()) {
            return Result::Err(private_function_error(name.clone(), span.start, span.end))
        }
        // `R0210`: a bare variant name called as a function (`Some(3)`), with the bootstrap's hint for it.
        when self.signature_index(name.clone()).is_err() && !bare_variant_hint(name.clone()).is_empty() {
            return Result::Err(unknown_function_error(name.clone(), span.start, span.end))
        }
        when type_arguments.is_empty() {
            mismatch := self.arity_mismatch(name.clone(), arguments.len(), span)
            when mismatch.is_some() {
                return Result::Err(mismatch.unwrap())
            }
        }
        return self.call(name, type_arguments, arguments, expected, span, true)
    }

    fun call_statement_at(mut self, name: String, type_arguments: Vec<u64>, arguments: Vec<u64>, span: ast::Span) -> Result<bool, String> {
        // The built-in output calls are checked first; a user function of the same name takes their place.
        when (name == "print" || name == "eprint" || name == "write") && self.signature_index(name.clone()).is_err() {
            return self.output_call(name, arguments, span)
        }
        // `R0255`: a structure's destructor runs by itself, so it cannot be called.
        when self.is_destructor(name.clone()) {
            return Result::Err(destructor_call_error(span.start, span.end))
        }
        when self.missing_module_function(name.clone()) {
            return Result::Err(unknown_module_function_error(name.clone(), self.module_function_suggestion(name.clone()), span.start, span.end))
        }
        found := self.find(name.clone())
        when found.is_ok() && self.locals[found.unwrap()].ty.starts_with("FunctionPointer ") {
            lowered := self.indirect_call(name, arguments, span)?
            self.statements.push(join(words2(String("CallStatement"), lowered.text)))
            return Result::Ok(false)
        }
        when self.private_function_call(name.clone()) {
            return Result::Err(private_function_error(name.clone(), span.start, span.end))
        }
        when self.signature_index(name.clone()).is_err() && !bare_variant_hint(name.clone()).is_empty() {
            return Result::Err(unknown_function_error(name.clone(), span.start, span.end))
        }
        when type_arguments.is_empty() {
            mismatch := self.arity_mismatch(name.clone(), arguments.len(), span)
            when mismatch.is_some() {
                return Result::Err(mismatch.unwrap())
            }
        }
        return self.call_statement(name, type_arguments, arguments)
    }

    // The checks of a built-in output call (`print`, `eprint`, `write`): the format string (`R0210`, then `R0014` for a
    // stray brace) and its placeholders against the values (`R0208`). The call itself is declined after them.
    // `print` writes its pieces as one template statement; `eprint` and `write` call the stream builtins in a block, and
    // `eprint` ends with a newline. The format string and the placeholder count were checked before any value is lowered.
    fun output_call(mut self, name: String, arguments: Vec<u64>, span: ast::Span) -> Result<bool, String> {
        when arguments.is_empty() {
            return Result::Err(output_format_error(name, span.start, span.end))
        }
        template := self.string_literal_text(arguments[0])
        when template.is_none() {
            return Result::Err(output_format_error(name, span.start, span.end))
        }
        template_text := template.unwrap()
        placeholders := output_placeholders(name.clone(), template_text.clone(), span)?
        when placeholders != arguments.len() - 1 {
            return Result::Err(output_arity_error(name, placeholders, arguments.len() - 1, span.start, span.end))
        }
        pieces := output_pieces(template_text)
        mut value_index: u64 = 1
        when name == "print" {
            mut tokens: Vec<String> = Vec()
            tokens.push(String("PrintTemplate"))
            tokens.push(num(pieces.len()))
            for piece in pieces {
                when piece.is_empty() {
                    lowered := self.printed_lowered(arguments[value_index], String("print"), span.start, span.end)?
                    value_index += 1
                    tokens.push(join(words3(String("Value"), lowered.text, lowered.ty)))
                } else {
                    tokens.push(text_part(piece)?)
                }
            }
            self.statements.push(join(tokens))
            return Result::Ok(false)
        }
        mut sink := String("__io_stdout_write")
        when name == "eprint" {
            sink = String("__io_stderr_write")
        }
        start := self.statements.len()
        visible_before := self.visible
        for piece in pieces {
            mut argument: u64 = 0
            when piece.is_empty() {
                argument = self.output_argument(arguments[value_index], name.clone(), span)?
                value_index += 1
            } else {
                argument = self.add_expr(ast::ExprTree::StrLit(piece, span))
            }
            self.emit_stream_call(sink.clone(), argument, span)?
        }
        when name == "eprint" {
            newline := self.add_expr(ast::ExprTree::StrLit(String("\n"), span))
            self.emit_stream_call(sink.clone(), newline, span)?
        }
        // The block is a scope of its own: the drop that ends it is its last statement, as the guard appends it.
        mut items := self.statements_since(start)
        items.push(self.owned_drop(visible_before))
        self.statements.push(join(block_of(items)))
        return Result::Ok(false)
    }

    // Appends an expression node to the program's arena and returns its index.
    fun add_expr(mut self, node: ast::ExprTree) -> u64 {
        index := self.program.exprs.len()
        self.program.exprs.push(node)
        return index
    }

    // A call of a stream builtin with one argument, as a statement of the surrounding block.
    fun emit_stream_call(mut self, sink: String, argument: u64, span: ast::Span) -> Result<bool, String> {
        mut type_arguments: Vec<u64> = Vec()
        mut arguments: Vec<u64> = Vec()
        arguments.push(argument)
        return self.call_statement_at(sink, type_arguments, arguments, span)
    }

    // The statements pushed since `start`, in order; they are taken out of the statement list.
    fun statements_since(mut self, start: u64) -> Vec<String> {
        mut reversed: Vec<String> = Vec()
        while self.statements.len() > start {
            reversed.push(self.statements.pop().unwrap())
        }
        mut items: Vec<String> = Vec()
        mut index: u64 = reversed.len()
        while index > 0 {
            index -= 1
            items.push(reversed[index].clone())
        }
        return items
    }

    // The argument an `eprint` or `write` piece passes to the stream: a string as it is, a `bool` as `"true"` or `"false"`,
    // and a number through `String(...)`. Any other type is `R0234`, at the call.
    fun output_argument(mut self, value: u64, name: String, span: ast::Span) -> Result<u64, String> {
        lowered := self.expression(value, String(""))?
        when lowered.ty == "Str" || lowered.ty == "OwnedString" {
            return Result::Ok(value)
        }
        when lowered.ty == "Bool" {
            then_value := self.add_expr(ast::ExprTree::StrLit(String("true"), span))
            else_value := self.add_expr(ast::ExprTree::StrLit(String("false"), span))
            return Result::Ok(self.add_expr(ast::ExprTree::IfE(value, then_value, else_value, span)))
        }
        when numeric_word(lowered.ty.clone()) {
            mut type_arguments: Vec<u64> = Vec()
            mut arguments: Vec<u64> = Vec()
            arguments.push(value)
            return Result::Ok(self.add_expr(ast::ExprTree::CallE(String("String"), type_arguments, arguments, span)))
        }
        mut message := String("`")
        message.append(name)
        message.append("` cannot format this type yet")
        return Result::Err(diagnostic("R0234", span.start, span.end, message, String("use numbers, `bool`, `str` or `String`")))
    }

    // A value that `echo` or `print` writes, lowered; a value whose type holds a `Vec` is `R0234` at the statement.
    fun printed_lowered(mut self, value: u64, name: String, start: u64, end: u64) -> Result<Lowered, String> {
        lowered := self.expression(value, String(""))?
        when self.holds_vec(lowered.ty.clone()) {
            mut message := String("`")
            message.append(name)
            message.append("` cannot print `Vec` values yet")
            return Result::Err(diagnostic("R0234", start, end, message, String("iterate the values manually and print each element")))
        }
        return Result::Ok(lowered)
    }

    // Whether a type word holds a `Vec`: the word itself, an array's element, or a structure's fields, as the bootstrap's
    // `type_contains_vec` reads them.
    fun holds_vec(self, word: String) -> bool {
        when word.starts_with("Vec ") {
            return true
        }
        when word.starts_with("Array ") {
            return self.holds_vec(array_element_word(word))
        }
        when struct_id_of(word.clone()).is_some() {
            id := struct_id_of(word).unwrap()
            info := self.structs[id]
            for field_word in info.field_types.clone() {
                when self.holds_vec(field_word) {
                    return true
                }
            }
        }
        return false
    }

    // `null` is the zero address of the raw pointer type its context expects: the cast of the integer `0` to that type.
    // Without such a context, the bootstrap reports `R0203`.
    fun null_expression(self, expected: String, span: ast::Span) -> Result<Lowered, String> {
        when expected.starts_with("RawPointer ") {
            return Result::Ok(Lowered { text: join(words4(String("Cast"), String("Integer 0 U64"), String("U64"), expected.clone())), ty: expected })
        }
        return Result::Err(null_context_error(span.start, span.end))
    }

    // Whether `name` is the destructor of a structure (`#[drop(name)]`).
    fun is_destructor(self, name: String) -> bool {
        mut index: u64 = 0
        while index < self.program.struct_defs.len() {
            definition := self.program.struct_defs[index]
            when definition.drop_function.is_some() && definition.drop_function.unwrap() == name {
                return true
            }
            index += 1
        }
        return false
    }

    // The text of a string literal argument.
    fun string_literal_text(self, index: u64) -> Option<String> {
        choose self.program.exprs[index] {
            ast::ExprTree::StrLit(text, span) => Option::Some(text),
            _ => Option::None,
        }
    }

    // `span` is the call's span when `located` is true; the pipe forms have none and pass false.
    fun call(mut self, name: String, type_arguments: Vec<u64>, arguments: Vec<u64>, expected: String, span: ast::Span, located: bool) -> Result<Lowered, String> {
        // `R0255`: a structure's destructor runs by itself, so it cannot be called.
        when located && self.is_destructor(name.clone()) {
            return Result::Err(destructor_call_error(span.start, span.end))
        }
        when located && self.missing_module_function(name.clone()) {
            return Result::Err(unknown_module_function_error(name.clone(), self.module_function_suggestion(name.clone()), span.start, span.end))
        }
        // `Vec()` takes its element type from the context.
        when name == "Vec" && arguments.is_empty() && type_arguments.is_empty() && self.signature_index(name.clone()).is_err() {
            element := vec_element_of(expected.clone())
            when element.is_none() {
                return Result::Err(unsupported("Vec without an element type"))
            }
            return Result::Ok(Lowered { text: join(words5(String("Call"), String("Vec"), String("New"), element.unwrap(), join(words2(String("0"), expected.clone())))), ty: expected })
        }
        when !type_arguments.is_empty() {
            return Result::Err(unsupported("generic call"))
        }
        when self.signature_index(name.clone()).is_err() {
            // `Enum::Variant(args)` is a call by name, and constructs the variant.
            cut := last_index_of(name.clone(), String("::"))
            when cut.is_some() {
                return self.enum_construct(name.slice(0, cut.unwrap()), name.slice(cut.unwrap() + 2, name.len()), arguments, expected, span, located, false)
            }
            return self.builtin_call(name, arguments, expected)
        }
        id := self.signature_index(name.clone())?
        ret := self.signatures[id].ret.clone()
        when ret.is_empty() {
            return Result::Err(unsupported("value of a call without a result"))
        }
        when !expected.is_empty() && expected != ret {
            return Result::Err(unsupported("call result type"))
        }
        lowered := self.arguments(id, name, arguments)?
        mut tokens: Vec<String> = Vec()
        tokens.push(String("Call"))
        tokens.push(String("Function"))
        tokens.push(num(id))
        tokens.push(num(lowered.len()))
        for text in lowered {
            tokens.push(text)
        }
        tokens.push(ret.clone())
        return Result::Ok(Lowered { text: join(tokens), ty: ret })
    }

    // A builtin used as a statement: its result, if any, is discarded.
    fun builtin_statement(mut self, name: String, arguments: Vec<u64>) -> Result<bool, String> {
        when name == "String" {
            return Result::Err(unsupported("String call as a statement"))
        }
        lowered := self.builtin_target(name, arguments)?
        self.statements.push(join(words2(String("CallStatement"), lowered.text)))
        return Result::Ok(false)
    }

    fun call_statement(mut self, name: String, type_arguments: Vec<u64>, arguments: Vec<u64>) -> Result<bool, String> {
        when !type_arguments.is_empty() {
            return Result::Err(unsupported("generic call"))
        }
        when self.signature_index(name.clone()).is_err() {
            return self.builtin_statement(name, arguments)
        }
        id := self.signature_index(name.clone())?
        lowered := self.arguments(id, name, arguments)?
        mut tokens: Vec<String> = Vec()
        tokens.push(String("CallStatement"))
        tokens.push(String("Function"))
        tokens.push(num(id))
        tokens.push(num(lowered.len()))
        for text in lowered {
            tokens.push(text)
        }
        self.statements.push(join(tokens))
        return Result::Ok(false)
    }

    // Lowers the statements of one branch. A branch that falls through ends with `Drop 0`,
    // as `guard::check` adds it to a nested block. Declarations are left to the later subset.
    fun block(mut self, body: Vec<u64>) -> Result<Block, String> {
        return self.block_with(String(""), String(""), 0, String(""), body)
    }

    // A block whose scope starts with a loop item: `prelude` is the statement that binds it.
    fun block_with(mut self, prelude: String, item_name: String, item_slot: u64, item_ty: String, body: Vec<u64>) -> Result<Block, String> {
        locals_before := self.visible
        start := self.statements.len()
        self.scope_floors.push(locals_before)
        self.open_frame()
        when !item_name.is_empty() {
            self.declare(Local { name: item_name, slot: item_slot, ty: item_ty, mutable: false })
            self.statements.push(prelude)
        }
        mut falls := true
        mut position: u64 = 0
        while position < body.len() && falls {
            falls = !self.statement(body[position])?
            self.commit_moves()
            position += 1
        }
        deferred := self.close_frame()?
        // A body that does not fall through leaves the deferred bodies unreachable, and the
        // guard drops statements after such a point.
        when falls {
            for item in deferred {
                self.statements.push(item)
            }
        }
        // The block's owned strings are dropped while still visible; then the block's names go
        // out of scope. Their slots are not reused.
        when falls {
            self.statements.push(self.owned_drop(locals_before))
        }
        self.visible = locals_before
        self.drop_borrows_from(locals_before)
        self.drop_origins_from(locals_before)
        self.scope_floors.pop()
        mut reversed: Vec<String> = Vec()
        while self.statements.len() > start {
            reversed.push(self.statements.pop().unwrap())
        }
        mut items: Vec<String> = Vec()
        mut index: u64 = reversed.len()
        while index > 0 {
            index -= 1
            items.push(reversed[index].clone())
        }
        return Result::Ok(Block { items: items, falls: falls })
    }

    // The condition of a `when`. A cast (such as a folded constant) keeps its own type, so that a non-`bool` one is `R0207`.
    fun condition_expression(mut self, condition: u64) -> Result<Lowered, String> {
        choose self.program.exprs[condition] {
            ast::ExprTree::CastE(value, target, span) => self.expression(condition, String("")),
            _ => self.expression(condition, String("Bool")),
        }
    }

    fun if_statement(mut self, condition: u64, then_body: Vec<u64>, else_body: Vec<u64>) -> Result<bool, String> {
        test := self.condition_expression(condition)?
        when test.ty != "Bool" {
            // `R0207`: a scalar condition, at the condition.
            when scalar_type_name(test.ty.clone()).is_some() {
                condition_span := self.expr_span_of(condition)
                return Result::Err(condition_type_error(String("`when` condition must have type `bool`"), condition_span.start, condition_span.end))
            }
            return Result::Err(unsupported("condition is not a boolean"))
        }
        // Both branches start from the moves before the `when`; afterwards the moves of the branches that fall through.
        self.commit_moves()
        before := self.moved_names.clone()
        before_origins := self.origins.clone()
        then_block := self.block(then_body)?
        after_then := self.moved_names.clone()
        then_origins := self.origins.clone()
        self.moved_names = before.clone()
        self.origins = before_origins
        else_block := self.block(else_body)?
        self.moved_names = merge_branch_moves(before, after_then, then_block.falls, self.moved_names.clone(), else_block.falls)
        self.origins = self.join_branch_origins(then_origins, then_block.falls, self.origins.clone(), else_block.falls)
        mut tokens: Vec<String> = Vec()
        tokens.push(String("IfStatement"))
        tokens.push(test.text)
        tokens.push(num(then_block.items.len()))
        for item in then_block.items {
            tokens.push(item)
        }
        tokens.push(num(else_block.items.len()))
        for item in else_block.items {
            tokens.push(item)
        }
        self.statements.push(join(tokens))
        return Result::Ok(!(then_block.falls || else_block.falls))
    }

    // `for name in start..end` (or `..=`): the variable and a hidden end slot are allocated after
    // the bounds are lowered, and the variable is in scope only for the body.
    // The bootstrap reports the range's diagnostics at the loop variable's span, after a redeclared
    // name (`R0202`) and before the body.
    fun for_statement(mut self, name: String, name_span: ast::Span, start: u64, end: u64, inclusive: bool, body: Vec<u64>) -> Result<bool, String> {
        when self.declared(name.clone()) {
            return Result::Err(range_loop_redeclared(name, name_span.start, name_span.end))
        }
        start_hint := self.operand_hint(end, true)?
        start_result := self.expression(start, start_hint.clone())
        mut start_value := Lowered { text: String(""), ty: String("") }
        when start_result.is_err() {
            refusal := start_result.unwrap_err()
            other := self.other_type_of(start, start_hint, refusal.clone())
            when other.is_some() {
                found := range_bound_error(other.unwrap(), name_span.start, name_span.end)
                when found.is_some() {
                    return Result::Err(found.unwrap())
                }
            }
            return Result::Err(refusal)
        }
        start_value = start_result.unwrap()
        when !is_integer_word(start_value.ty.clone()) {
            found := range_bound_error(start_value.ty.clone(), name_span.start, name_span.end)
            when found.is_some() {
                return Result::Err(found.unwrap())
            }
            return Result::Err(unsupported("range over this type"))
        }
        mut ty := start_value.ty.clone()
        end_result := self.expression(end, ty.clone())
        mut end_ty := String("")
        mut end_text := String("")
        when end_result.is_err() {
            refusal := end_result.unwrap_err()
            other := self.other_type_of(end, ty.clone(), refusal.clone())
            when other.is_none() {
                return Result::Err(refusal)
            }
            end_ty = other.unwrap()
            // An integer end whose lowering was refused has no text here, so it is declined.
            when is_integer_word(end_ty.clone()) {
                return Result::Err(unsupported("range end refused"))
            }
        } else {
            end_value := end_result.unwrap()
            end_ty = end_value.ty.clone()
            end_text = end_value.text
        }
        // A bare literal start takes the end's type when the hint cannot see it.
        literal := self.literal_value(start)
        when end_ty != ty && is_integer_word(end_ty.clone()) && literal.is_some() {
            start_value = self.expression(start, end_ty.clone())?
            ty = end_ty.clone()
        }
        when end_ty != ty {
            found := range_mismatch_error(ty.clone(), end_ty.clone(), name_span.start, name_span.end)
            when found.is_some() {
                return Result::Err(found.unwrap())
            }
            return Result::Err(unsupported("range bounds of mixed types"))
        }
        when start_value.ty != ty {
            return Result::Err(unsupported("range bounds of mixed types"))
        }
        variable_slot := self.allocate(ty.clone())?
        end_slot := self.allocate(ty.clone())?
        visible_before := self.visible
        self.declare(Local { name: name, slot: variable_slot, ty: ty.clone(), mutable: false })
        self.loop_depth += 1
        self.loop_floors.push(visible_before)
        self.loop_frames.push(self.frame_marks.len())
        // The moves of the loop header (a condition or a collection) happen before the first iteration.
        self.commit_moves()
        loop_before := self.moved_names.clone()
        outer_breaks := self.break_moves.clone()
        outer_continues := self.continue_moves.clone()
        self.break_moves = Vec()
        self.continue_moves = Vec()
        body_block := self.block(body)?
        loop_error := self.loop_move_error(loop_before.clone(), body_block.falls, self.continue_moves.clone())
        when loop_error.is_some() {
            return Result::Err(loop_error.unwrap())
        }
        exits := self.visible_moves(self.break_moves.clone())
        self.break_moves = outer_breaks
        self.continue_moves = outer_continues
        self.moved_names = union_moves(loop_before, exits)
        self.loop_frames.pop()
        self.loop_floors.pop()
        self.loop_depth -= 1
        self.visible = visible_before
        mut bit: u64 = 0
        when inclusive {
            bit = 1
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("For"))
        tokens.push(num(variable_slot))
        tokens.push(num(end_slot))
        tokens.push(ty)
        tokens.push(start_value.text)
        tokens.push(end_text)
        tokens.push(num(bit))
        tokens.push(num(body_block.items.len()))
        for item in body_block.items {
            tokens.push(item)
        }
        self.statements.push(join(tokens))
        return Result::Ok(false)
    }

    fun defer_statement(mut self, body: Vec<u64>, span: ast::Span) -> Result<bool, String> {
        when self.return_ty.starts_with("Reference ") {
            return Result::Err(diagnostic("R0269", span.start, span.end, String("a function returning a reference cannot use `defer`"), String("return an owned value, or move the cleanup to the caller")))
        }
        when self.frame_marks.is_empty() {
            return Result::Err(unsupported("defer outside a block"))
        }
        entry := Deferred { body: body, visible: self.visible }
        when self.defer_count < self.defers.len() {
            self.defers.set(self.defer_count, entry)
        } else {
            self.defers.push(entry)
        }
        self.defer_count += 1
        // The placeholder is an empty block; the guard completes it with its drop.
        self.statements.push(String("Block 1 Drop 0"))
        return Result::Ok(false)
    }

    fun while_statement(mut self, condition: u64, body: Vec<u64>) -> Result<bool, String> {
        test := self.expression(condition, String("Bool"))?
        // The setup of the condition runs before every test, so it is the loop's own setup and not the statement's.
        condition_setup := self.setup.clone()
        self.setup = Vec()
        when test.ty != "Bool" {
            return Result::Err(unsupported("condition is not a boolean"))
        }
        self.loop_depth += 1
        self.loop_floors.push(self.visible)
        self.loop_frames.push(self.frame_marks.len())
        // The moves of the loop header (a condition or a collection) happen before the first iteration.
        self.commit_moves()
        loop_before := self.moved_names.clone()
        outer_breaks := self.break_moves.clone()
        outer_continues := self.continue_moves.clone()
        self.break_moves = Vec()
        self.continue_moves = Vec()
        body_block := self.block(body)?
        loop_error := self.loop_move_error(loop_before.clone(), body_block.falls, self.continue_moves.clone())
        when loop_error.is_some() {
            return Result::Err(loop_error.unwrap())
        }
        exits := self.visible_moves(self.break_moves.clone())
        self.break_moves = outer_breaks
        self.continue_moves = outer_continues
        self.moved_names = union_moves(loop_before, exits)
        self.loop_frames.pop()
        self.loop_floors.pop()
        self.loop_depth -= 1
        mut tokens: Vec<String> = Vec()
        tokens.push(String("While"))
        tokens.push(num(condition_setup.len()))
        for item in condition_setup {
            tokens.push(item)
        }
        tokens.push(test.text)
        tokens.push(num(body_block.items.len()))
        for item in body_block.items {
            tokens.push(item)
        }
        self.statements.push(join(tokens))
        // A loop may run zero times, so control always continues after it.
        return Result::Ok(false)
    }

    // The drop of the owned locals declared from `floor` on, last declared first.
    fun owned_drop(self, floor: u64) -> String {
        mut slots: Vec<String> = Vec()
        mut index: u64 = self.visible
        while index > floor {
            index -= 1
            when self.owns(self.locals[index].ty.clone()) {
                parts := self.owned_parts(self.locals[index].ty.clone(), self.locals[index].slot)
                mut pair: u64 = parts.len() / 2
                while pair > 0 {
                    pair -= 1
                    slots.push(parts[pair * 2].clone())
                    slots.push(parts[pair * 2 + 1].clone())
                }
            }
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("Drop"))
        tokens.push(num(slots.len() / 2))
        for token in slots {
            tokens.push(token)
        }
        return join(tokens)
    }

    // `break` and `continue` leave their scopes, so `guard::check` emits a drop before each.
    fun jump_statement(mut self, word: String, keyword: str, span: ast::Span) -> Result<bool, String> {
        when self.loop_depth == 0 {
            return Result::Err(jump_error(keyword, self.defer_depth > 0, span.start, span.end))
        }
        when word == "Break" {
            self.break_moves = self.concat_moves(self.break_moves.clone(), self.moved_names.clone())
        } else {
            self.continue_moves = self.concat_moves(self.continue_moves.clone(), self.moved_names.clone())
        }
        leaving := self.run_defers(self.frame_start(self.loop_frames[self.loop_frames.len() - 1]))?
        mut items: Vec<String> = Vec()
        for item in leaving {
            items.push(item)
        }
        items.push(self.owned_drop(self.loop_floor()))
        items.push(word)
        when items.len() == 2 {
            self.statements.push(items[0].clone())
            self.statements.push(items[1].clone())
            return Result::Ok(true)
        }
        self.statements.push(join(block_of(items)))
        return Result::Ok(true)
    }

    fun template_part(mut self, index: u64) -> Result<String, String> {
        choose self.program.parts[index] {
            ast::TemplatePart::TextPart(text) => text_part(text),
            ast::TemplatePart::ValuePart(value) => self.value_part(value),
        }
    }

    // A part of an `echo` template: its text, or a value that is checked for a `Vec` at the statement.
    fun echo_part(mut self, index: u64, start: u64, end: u64) -> Result<String, String> {
        choose self.program.parts[index] {
            ast::TemplatePart::TextPart(text) => text_part(text),
            ast::TemplatePart::ValuePart(value) => self.echo_value(value, start, end),
        }
    }

    fun echo_value(mut self, value: u64, start: u64, end: u64) -> Result<String, String> {
        lowered := self.printed_lowered(value, String("echo"), start, end)?
        return Result::Ok(join(words3(String("Value"), lowered.text, lowered.ty)))
    }

    fun value_part(mut self, value: u64) -> Result<String, String> {
        lowered := self.expression(value, String(""))?
        return Result::Ok(join(words3(String("Value"), lowered.text, lowered.ty)))
    }

    // Each statement appends its IR tokens to `statements`; a return reports true. A refusal
    // names the function and source offset of the innermost statement it came from. A
    // diagnostic already carries its own span, so it is passed on unchanged.
    fun statement(mut self, index: u64) -> Result<bool, String> {
        // The setup of an enclosing statement waits until this one is lowered, and this statement's own setup is its alone.
        outer := self.setup.clone()
        self.setup = Vec()
        start := self.statements.len()
        visible_before := self.visible
        lowered := self.statement_inner(index)
        when lowered.is_err() {
            self.setup = outer
            message := lowered.unwrap_err()
            when message.contains(" @ ") || message.starts_with("diagnostic ") {
                return Result::Err(message)
            }
            mut located := message
            located.append(" @ ")
            located.append(self.current_function.clone())
            located.append(" ")
            located.append(String(stmt_span(self.program.stmts[index]).start))
            return Result::Err(located)
        }
        returned := lowered.unwrap()
        when !self.setup.is_empty() {
            // The setup comes first in a block with the statement, as the bootstrap's `with_setup` makes it. The block is a
            // scope of its own, which the guard ends with a drop unless the statement returns (the block does not fall through).
            mut items := self.setup.clone()
            self.setup = Vec()
            for item in self.statements_since(start) {
                items.push(item)
            }
            when !returned {
                items.push(self.owned_drop(visible_before))
            }
            self.statements.push(join(block_of(items)))
        }
        self.setup = outer
        return Result::Ok(returned)
    }

    fun statement_inner(mut self, index: u64) -> Result<bool, String> {
        choose self.program.stmts[index] {
            ast::Stmt::LetS(name, mutable, annotation, value, span) => self.let_statement(name, mutable, annotation, value, span),
            ast::Stmt::AssignS(name, value, span) => self.assign_statement(name, value, span),
            ast::Stmt::CompoundS(name, op, value, span) => self.compound_statement(name, op, value, span),
            ast::Stmt::PrintS(value, span) => self.print_statement(value, span.start, span.end),
            ast::Stmt::TemplateS(parts, span) => self.template_statement(parts, span.start, span.end),
            ast::Stmt::ReturnS(value, span) => self.return_statement(value, span),
            ast::Stmt::CallS(name, type_arguments, arguments, span) => self.call_statement_at(name, type_arguments, arguments, span),
            ast::Stmt::IfS(condition, then_body, else_body, span) => self.if_statement(condition, then_body, else_body),
            ast::Stmt::FieldAssignS(object, names, spans, op, value, span) => self.field_assign(object, names, spans, op, value, span),
            ast::Stmt::WhileS(condition, body, span) => self.while_statement(condition, body),
            ast::Stmt::ForS(name, name_span, start, end, inclusive, body, span) => self.for_statement(name, name_span, start, end, inclusive, body),
            ast::Stmt::BreakS(span) => self.jump_statement(String("Break"), "break", span),
            ast::Stmt::DeferS(body, span) => self.defer_statement(body, span),
            ast::Stmt::ContinueS(span) => self.jump_statement(String("Continue"), "continue", span),
            ast::Stmt::IndexAssignS(name, position, value, span) => self.index_assign(name, position, value, span),
            ast::Stmt::DerefAssignS(pointer, value, span) => self.dereference_assign(pointer, value, span),
            ast::Stmt::MethodCallS(receiver, name, arguments, span) => self.method_statement(receiver, name, arguments, span),
            ast::Stmt::ForEachS(name, name_span, collection, body, span) => self.foreach_statement(name, name_span, collection, body),
        }
    }

    fun let_statement(mut self, name: String, mutable: bool, annotation: Option<u64>, value: u64, span: ast::Span) -> Result<bool, String> {
        // The bootstrap reports a redeclared name before it looks at the initializer.
        when name != "_" && self.declared(name.clone()) {
            return Result::Err(redeclared_let(name, span.start, span.end))
        }
        mut declared := String("")
        when annotation.is_some() {
            declared = self.annotation(annotation.unwrap())?
        }
        lowered_value := self.moved_expression(value, declared.clone())
        when lowered_value.is_err() {
            refusal := lowered_value.unwrap_err()
            when declared.is_empty() {
                return Result::Err(refusal)
            }
            other := self.other_type_of(value, declared.clone(), refusal.clone())
            when other.is_some() {
                mismatch := self.declared_mismatch(value, declared.clone(), other.unwrap())
                when mismatch.is_some() {
                    return Result::Err(mismatch.unwrap())
                }
            }
            return Result::Err(refusal)
        }
        lowered := lowered_value.unwrap()
        mut ty := declared.clone()
        when ty.is_empty() {
            ty = lowered.ty.clone()
        }
        // `R0240`: a borrowed slice is used where it is made, so it cannot be bound to a name.
        when ty.starts_with("Slice ") {
            value_span := self.expr_span_of(value)
            return Result::Err(slice_binding_error(value_span.start, value_span.end))
        }
        when ty != lowered.ty {
            when !declared.is_empty() {
                mismatch := self.declared_mismatch(value, declared.clone(), lowered.ty.clone())
                when mismatch.is_some() {
                    return Result::Err(mismatch.unwrap())
                }
            }
            return Result::Err(unsupported("annotation does not match the value"))
        }
        // `R0250`: a reference to an element of a slice that is not named, so its source is not a known local.
        when ty.starts_with("Reference ") && self.unknown_element_source(value) {
            return Result::Err(unknown_provenance_error(span.start, span.end))
        }
        // `_ := value` keeps a value without a name that could be used or clash.
        mut bound := name.clone()
        when name == "_" {
            bound = String(" discard")
        }
        slot := self.allocate(ty.clone())?
        self.forget_moved(bound.clone())
        self.declare(Local { name: bound.clone(), slot: slot, ty: ty.clone(), mutable: mutable })
        when name != "_" && self.pointed_local(value).is_some() {
            source := self.pointed_local(value).unwrap()
            holder := self.find(bound.clone())?
            self.origins.push(LocalOrigin { holder: holder, source: source })
        }
        // A structure local carries the locals its raw pointer fields point at.
        when name != "_" && struct_id_of(ty.clone()).is_some() {
            holder := self.find(bound.clone())?
            for source in self.struct_sources(value) {
                self.origins.push(LocalOrigin { holder: holder, source: source })
            }
        }
        when name != "_" && self.borrow_target(value).is_some() {
            source := self.borrow_target(value).unwrap()
            source_index := self.find(source)?
            holder_index := self.find(bound.clone())?
            borrow_mutable := self.address_is_mutable(value)
            self.borrows.push(ActiveBorrow { slot: self.locals[source_index].slot, holder: holder_index, mutable: borrow_mutable })
        }
        self.statements.push(join(words6(String("Let"), num(slot), ty, lowered.text, num(span.start), num(span.end))))
        return Result::Ok(false)
    }

    fun assign_statement(mut self, name: String, value: u64, span: ast::Span) -> Result<bool, String> {
        index := self.find(name.clone())?
        when !self.locals[index].mutable {
            return Result::Err(immutable_binding(name, span.start, span.end, "if this binding must be mutable"))
        }
        // `R0251`/`R0252`: a reference or raw pointer may not come to point at a local of a deeper block.
        target_ty := self.locals[index].ty.clone()
        when (target_ty.starts_with("Reference ") || target_ty.starts_with("RawPointer ")) && self.outlives_block(index, value) {
            when target_ty.starts_with("RawPointer ") {
                // The address of the local written directly is `R0248`; a pointer copied through a local is `R0252`.
                when self.direct_raw_address(value) {
                    return Result::Err(raw_pointer_outlives_error(span.start, span.end))
                }
                return Result::Err(raw_escape_error(span.start, span.end))
            }
            return Result::Err(reference_escape_error(span.start, span.end))
        }
        // `R0252`: a structure whose raw pointers would point at a local of a deeper block.
        sources := self.struct_sources(value)
        when struct_id_of(target_ty.clone()).is_some() {
            for source in sources.clone() {
                when self.block_depth(source) > self.block_depth(index) {
                    return Result::Err(raw_escape_error(span.start, span.end))
                }
            }
        }
        slot := self.locals[index].slot
        ty := self.locals[index].ty.clone()
        lowered := self.moved_expression(value, ty.clone())?
        when self.borrowed_name(name.clone(), false) && !ty.starts_with("Reference ") {
            return Result::Err(borrowed_assign_error(span.start, span.end))
        }
        self.set_origin(index, value)
        when struct_id_of(ty.clone()).is_some() {
            self.replace_origins(index, sources)
        }
        self.forget_moved(name.clone())
        self.statements.push(join(words6(String("Assign"), num(slot), ty, lowered.text, num(span.start), num(span.end))))
        return Result::Ok(false)
    }

    // `x op= value` is lowered as `x = x op value`; the name's span is the first `len(x)` bytes.
    fun compound_statement(mut self, name: String, op: String, value: u64, span: ast::Span) -> Result<bool, String> {
        index := self.find(name.clone())?
        when !self.locals[index].mutable {
            end := span.start + name.len()
            return Result::Err(immutable_binding(name.clone(), span.start, end, "if this binding must be mutable"))
        }
        slot := self.locals[index].slot
        ty := self.locals[index].ty.clone()
        when !is_numeric_word(ty.clone()) {
            return Result::Err(unsupported("arithmetic on this type"))
        }
        end := span.start + name.len()
        target := Lowered { text: join(words5(String("Local"), num(slot), ty.clone(), num(span.start), num(end))), ty: ty.clone() }
        mut context := String("")
        when self.operand_ok(ty.clone(), is_bitwise_op(op.clone())) {
            context = ty.clone()
        }
        // The bootstrap checks `x op value` as one binary expression: the name, then the whole span.
        value_end := self.expr_span_of(value).end
        name_span := ast::Span { start: span.start, end: span.start + name.len() }
        whole := ast::Span { start: span.start, end: value_end }
        binary := self.binary_rest(op, target, value, context, ty.clone(), name_span, whole, true)?
        self.statements.push(join(words6(String("Assign"), num(slot), ty, binary.text, num(span.start), num(span.end))))
        return Result::Ok(false)
    }

    fun print_statement(mut self, value: u64, start: u64, end: u64) -> Result<bool, String> {
        lowered := self.printed_lowered(value, String("echo"), start, end)?
        self.statements.push(join(words3(String("Print"), lowered.text, lowered.ty)))
        return Result::Ok(false)
    }

    fun template_statement(mut self, parts: Vec<u64>, start: u64, end: u64) -> Result<bool, String> {
        mut tokens: Vec<String> = Vec()
        tokens.push(String("PrintTemplate"))
        tokens.push(num(parts.len()))
        for part in parts {
            tokens.push(self.echo_part(part, start, end)?)
        }
        self.statements.push(join(tokens))
        return Result::Ok(false)
    }

    fun return_statement(mut self, value: Option<u64>, span: ast::Span) -> Result<bool, String> {
        when self.defer_depth > 0 {
            return Result::Err(diagnostic("R0267", span.start, span.end, String("`return` cannot leave a `defer` block"), String("return from the enclosing function after the `defer` block")))
        }
        when value.is_none() {
            leaving := self.run_defers(self.frame_start(0))?
            when leaving.is_empty() {
                self.statements.push(String("Return -"))
            } else {
                mut items: Vec<String> = Vec()
                for item in leaving {
                    items.push(item)
                }
                items.push(String("Return -"))
                self.statements.push(join(block_of(items)))
            }
            return Result::Ok(true)
        }
        when self.return_ty.is_empty() {
            return Result::Err(return_value_error(self.current_function.clone(), span.start, span.end))
        }
        returned := value.unwrap()
        lowered := self.moved_expression(returned, self.return_ty.clone())?
        // `R0248`: a reference result must come from a reference parameter, directly or through a slice parameter.
        when self.return_ty.starts_with("Reference ") && !self.reference_from_parameter(lowered.text.clone(), lowered.ty.clone()) {
            when lowered.text.starts_with("If ") {
                return Result::Err(unsupported("reference return of a conditional"))
            }
            span_of := self.expr_span_of(returned)
            return Result::Err(local_reference_error(span_of.start, span_of.end))
        }
        // `R0248`: a raw pointer result may not be the address of a local, which is gone when the function returns.
        when self.return_ty.starts_with("RawPointer ") {
            when lowered.text.starts_with("If ") {
                return Result::Err(unsupported("raw pointer return of a conditional"))
            }
            when lowered.text.starts_with("AddressOf ") && lowered.ty.starts_with("RawPointer ") {
                span_of := self.expr_span_of(returned)
                return Result::Err(raw_local_error(span_of.start, span_of.end))
            }
        }
        // `R0248`: a structure result may not hold the address of a local, which is gone when the function returns.
        when struct_id_of(self.return_ty.clone()).is_some() && !self.struct_sources(returned).is_empty() {
            span_of := self.struct_result_span(returned)
            return Result::Err(raw_result_local_error(span_of.start, span_of.end))
        }
        leaving := self.run_defers(self.frame_start(0))?
        when leaving.is_empty() {
            self.note_return(lowered.text.clone(), lowered.ty.clone())
            self.statements.push(join(words3(String("Return"), String("+"), lowered.text)))
            return Result::Ok(true)
        }
        self.returned_refs.push(String(""))
        // The value is computed before the deferred bodies run, so they cannot change it.
        slot := self.allocate(self.return_ty.clone())?
        mut items: Vec<String> = Vec()
        items.push(join(words6(String("Let"), num(slot), self.return_ty.clone(), lowered.text, num(span.start), num(span.end))))
        for item in leaving {
            items.push(item)
        }
        items.push(join(words3(String("Return"), String("+"), self.returned_slot(slot, span.start, span.end))))
        self.statements.push(join(block_of(items)))
        return Result::Ok(true)
    }
}

fun struct_word(id: u64) -> String {
    return join(words2(String("Struct"), num(id)))
}

// The struct id of a `Struct <id>` type word.
fun struct_id_of(ty: String) -> Option<u64> {
    when ty.len() <= 7 || ty.slice(0, 7) != "Struct " {
        return Option::None
    }
    parsed := ty.slice(7, ty.len()).try_parse::<u64>()
    when parsed.is_none() {
        return Option::None
    }
    return Option::Some(parsed.unwrap())
}

// The IR word a declared name stands for: a structure, or an alias with its target's word.
fun named_type_word(names: Vec<String>, words: Vec<String>, name: String) -> Result<String, String> {
    mut id: u64 = 0
    while id < names.len() {
        when names[id] == name {
            return Result::Ok(words[id].clone())
        }
        id += 1
    }
    return Result::Err(unsupported("unknown type"))
}

extend Lowering {
    // The IR word for a declared type: a scalar, `str`, a named structure or alias, or a
    // collection, array, slice, pointer, or function pointer of other types.
    fun resolve(self, index: u64) -> Result<String, String> {
        choose self.program.types[index] {
            ast::TypeTree::Simple(word) => type_word(word),
            ast::TypeTree::NamedTy(name, span) => self.named_resolve(name, span.start, span.end),
            ast::TypeTree::ParamTy(name, span) => Result::Err(unsupported("type param")),
            ast::TypeTree::VecTy(element, span) => self.collection(String("Vec "), element),
            ast::TypeTree::MapTy(key, value, span) => self.pair(String("Map "), key, value),
            ast::TypeTree::SetTy(element, span) => self.pair_set(element),
            ast::TypeTree::ArrayTy(element, length, span) => self.array_type(element, length),
            ast::TypeTree::SliceTy(element, span) => self.collection(String("Slice "), element),
            ast::TypeTree::RefTy(target, mutable, span) => self.reference(target, mutable),
            ast::TypeTree::RawTy(target, span) => self.collection(String("RawPointer "), target),
            ast::TypeTree::FnPtrTy(parameters, result, extern_c, span) => self.function_pointer_type(parameters, result, extern_c),
        }
    }

    fun function_pointer_type(self, parameters: Vec<u64>, result: Option<u64>, extern_c: bool) -> Result<String, String> {
        mut word := String("FunctionPointer ")
        word.append(String(parameters.len()))
        for parameter in parameters {
            word.append(" ")
            word.append(self.resolve(parameter)?)
        }
        when result.is_some() {
            word.append(" + ")
            word.append(self.resolve(result.unwrap())?)
        } else {
            word.append(" -")
        }
        when extern_c {
            word.append(" 1")
        } else {
            word.append(" 0")
        }
        return Result::Ok(word)
    }

    fun array_type(self, element: u64, length: u64) -> Result<String, String> {
        inner := self.resolve(element)?
        mut word := String("Array ")
        word.append(inner)
        word.append(" ")
        word.append(String(length))
        return Result::Ok(word)
    }

    fun named_word(self, name: String) -> Result<String, String> {
        qualified := qualified_in(self.scope_path.clone(), name.clone())
        when !qualified.is_empty() {
            found := named_type_word(self.type_names.clone(), self.type_words.clone(), qualified)
            when found.is_ok() {
                return found
            }
        }
        return named_type_word(self.type_names.clone(), self.type_words.clone(), name)
    }

    // A named type. The placeholder of a generic structure that no instance matches is `R0262`, at the name's span.
    fun named_resolve(self, name: String, start: u64, end: u64) -> Result<String, String> {
        found := self.named_word(name.clone())
        when found.is_ok() || !name.starts_with("$RynStructParam#") {
            return found
        }
        return Result::Err(diagnostic("R0262", start, end, String("a generic structure has no instance for the inferred type arguments"), String("name the instance once in the program, for example `value: Box<i32> = make(1)` or `Box::<i32> { ... }`")))
    }

    fun reference(self, target: u64, mutable: bool) -> Result<String, String> {
        inner := self.resolve(target)?
        mut word := String("Reference ")
        word.append(inner)
        word.append(" ")
        when mutable {
            word.append("1")
        } else {
            word.append("0")
        }
        return Result::Ok(word)
    }

    fun collection(self, prefix: String, element: u64) -> Result<String, String> {
        inner := self.resolve(element)?
        mut word := prefix
        word.append(inner)
        return Result::Ok(word)
    }

    fun pair(self, prefix: String, key: u64, value: u64) -> Result<String, String> {
        left := self.resolve(key)?
        right := self.resolve(value)?
        mut word := prefix
        word.append(left)
        word.append(" ")
        word.append(right)
        return Result::Ok(word)
    }

    // A set is a map from its element to `bool` that the IR names `Set`.
    fun pair_set(self, element: u64) -> Result<String, String> {
        inner := self.resolve(element)?
        mut word := String("Set ")
        word.append(inner)
        word.append(" Bool")
        return Result::Ok(word)
    }
}

// Lowers the program's functions, in source order, and returns the complete IR text, or
// `unsupported: ...` when the program is outside the subset.
pub fun lower_program(program: ast::Program) -> Result<String, String> {
    mut lowering := Lowering {
        program: program,
        signatures: Vec(),
        locals: Vec(),
        local_types: Vec(),
        addressed_types: Vec(),
        next_slot: 0,
        statements: Vec(),
        return_ty: String(""),
        loop_depth: 0,
        visible: 0,
        loop_floors: Vec(),
        owners: Vec(),
        defers: Vec(),
        defer_count: 0,
        defer_depth: 0,
        frame_marks: Vec(),
        loop_frames: Vec(),
        scope_floors: Vec(),
        chained: false,
        borrow_chain: false,
        returned_refs: Vec(),
        moved_names: Vec(),
        pending_moves: Vec(),
        break_moves: Vec(),
        continue_moves: Vec(),
        borrows: Vec(),
        origins: Vec(),
        param_slots: Vec(),
        structs: Vec(),
        enums: Vec(),
        type_names: Vec(),
        type_words: Vec(),
        scope_path: String(""),
        current_function: String(""),
        call_scope: String(""),
        module: String(""),
        alias_names: Vec(),
        private_alias_names: Vec(),
        private_alias_targets: Vec(),
        alias_targets: Vec(),
        setup: Vec(),
    }
    // `R0450`: an `extend ... as Shape` block whose structure does not conform to the shape, checked before the defaults are added.
    shape_failure := lowering.shape_conformance()
    when shape_failure.is_some() {
        return Result::Err(shape_failure.unwrap())
    }
    lowering.add_shape_defaults()
    mut struct_position: u64 = 0
    while struct_position < lowering.program.structs.len() {
        definition := lowering.program.struct_defs[lowering.program.structs[struct_position]]
        lowering.type_names.push(definition.name.clone())
        lowering.type_words.push(struct_word(struct_position))
        struct_position += 1
    }
    mut enum_position: u64 = 0
    while enum_position < lowering.program.enums.len() {
        definition := lowering.program.enum_defs[lowering.program.enums[enum_position]]
        when !definition.type_parameters.is_empty() {
            return Result::Err(unsupported("generic enum"))
        }
        lowering.type_names.push(definition.name.clone())
        lowering.type_words.push(join(words2(String("Enum"), num(enum_position))))
        enum_position += 1
    }
    lowering.add_type_aliases()
    mut alias_position: u64 = 0
    while alias_position < lowering.program.type_aliases.len() {
        alias := lowering.program.alias_defs[lowering.program.type_aliases[alias_position]]
        // A generic alias is expanded where it is used; only plain aliases name a type.
        when alias.type_parameters.is_empty() {
            target := lowering.resolve(alias.ty)?
            lowering.type_names.push(alias.name.clone())
            lowering.type_words.push(target)
        }
        alias_position += 1
    }
    mut structs: Vec<StructInfo> = Vec()
    // The by-value structure fields, grouped by their structure, for the cycle check after the loop.
    mut struct_names: Vec<String> = Vec()
    mut struct_first: Vec<u64> = Vec()
    mut struct_edge_count: Vec<u64> = Vec()
    mut edge_targets: Vec<u64> = Vec()
    mut edge_starts: Vec<u64> = Vec()
    mut edge_ends: Vec<u64> = Vec()
    mut struct_index: u64 = 0
    while struct_index < lowering.program.structs.len() {
        definition := lowering.program.struct_defs[lowering.program.structs[struct_index]]
        lowering.scope_path = declaration_namespace(definition.name.clone(), definition.module_path.clone())
        // `derive` adds generated functions to the IR, which this subset does not write yet.
        when !definition.type_parameters.is_empty() {
            return Result::Err(unsupported("structure with generics"))
        }
        // `R0221`: a structure that declares no field, at the structure.
        when definition.fields.is_empty() {
            return Result::Err(empty_structure_error(definition.span.start, definition.span.end))
        }
        mut drop_name := String("")
        when definition.drop_function.is_some() {
            drop_name = definition.drop_function.unwrap()
        }
        // `R0255`: a destructor must name a function of the program (a method is not one). In a module the bootstrap
        // resolves the name through the module, which is not modelled, so a name that is not found there is declined.
        when !drop_name.is_empty() {
            mut named := false
            for function_index in lowering.program.functions.clone() {
                function_of := lowering.program.function_defs[function_index]
                when function_of.name == drop_name && !(function_of.parameters.len() > 0 && lowering.program.parameters[function_of.parameters[0]].name == "self") {
                    named = true
                }
            }
            when !named {
                when !definition.module_path.is_empty() {
                    return Result::Err(unsupported("destructor of a structure in a module"))
                }
                mut message := String("destructor function `")
                message.append(drop_name.clone())
                message.append("` was not found")
                return Result::Err(diagnostic("R0255", definition.span.start, definition.span.end, message, String("")))
            }
        }
        mut repr: u64 = 0
        when definition.repr_c {
            repr = 1
        }
        mut clone_flag: u64 = 0
        mut hash_flag: u64 = 0
        for derive in definition.derives {
            when derive == "Clone" {
                clone_flag = 1
            }
            when derive == "Hash" {
                hash_flag = 1
            }
        }
        mut field_names: Vec<String> = Vec()
        mut field_types: Vec<String> = Vec()
        mut field_public: Vec<u64> = Vec()
        mut field_position: u64 = 0
        first_edge := edge_targets.len()
        while field_position < definition.fields.len() {
            field := lowering.program.struct_fields[definition.fields[field_position]]
            // `R0222`: a field name that an earlier field of the structure already has, at the field's span.
            mut earlier: u64 = 0
            while earlier < field_names.len() {
                when field_names[earlier] == field.name {
                    return Result::Err(duplicate_field_error(field.name.clone(), field.span.start, field.span.end))
                }
                earlier += 1
            }
            field_names.push(field.name.clone())
            resolved := lowering.resolve(field.ty)?
            when struct_id_of(resolved.clone()).is_some() {
                edge_targets.push(struct_id_of(resolved.clone()).unwrap())
                edge_starts.push(field.span.start)
                edge_ends.push(field.span.end)
            }
            field_types.push(resolved)
            mut public: u64 = 0
            when field.public {
                public = 1
            }
            field_public.push(public)
            field_position += 1
        }
        struct_names.push(definition.name.clone())
        struct_first.push(first_edge)
        struct_edge_count.push(edge_targets.len() - first_edge)
        // `R0255`: a custom destructor needs a non-`repr(C)` structure whose first field is a raw pointer and whose fields
        // are all scalars, raw pointers or `String`.
        when !drop_name.is_empty() {
            mut allowed := field_types.len() > 0 && field_types[0].starts_with("RawPointer ") && repr == 0
            for field_type in field_types.clone() {
                when !destructor_field_type(field_type) {
                    allowed = false
                }
            }
            when !allowed {
                return Result::Err(destructor_layout_error(definition.span.start, definition.span.end))
            }
        }
        structs.push(StructInfo { name: definition.name, field_names: field_names, field_types: field_types, field_public: field_public, repr_c: repr, derives_clone: clone_flag, derives_hash: hash_flag, drop_name: drop_name, module_path: definition.module_path.clone(), public: definition.public })
        struct_index += 1
    }
    cycle := struct_cycle_error(struct_names, struct_first, struct_edge_count, edge_targets, edge_starts, edge_ends)
    when cycle.is_some() {
        return Result::Err(cycle.unwrap())
    }
    mut enums: Vec<EnumInfo> = Vec()
    mut enum_index: u64 = 0
    while enum_index < lowering.program.enums.len() {
        definition := lowering.program.enum_defs[lowering.program.enums[enum_index]]
        lowering.scope_path = declaration_namespace(definition.name.clone(), definition.module_path.clone())
        mut variant_names: Vec<String> = Vec()
        mut variant_counts: Vec<u64> = Vec()
        mut field_types: Vec<String> = Vec()
        mut variant_position: u64 = 0
        while variant_position < definition.variants.len() {
            variant := lowering.program.variant_defs[definition.variants[variant_position]]
            variant_names.push(variant.name.clone())
            variant_counts.push(variant.fields.len())
            mut field_position: u64 = 0
            while field_position < variant.fields.len() {
                field_types.push(lowering.resolve(variant.fields[field_position])?)
                field_position += 1
            }
            variant_position += 1
        }
        enums.push(EnumInfo { name: definition.name, variant_names: variant_names, variant_counts: variant_counts, field_types: field_types })
        enum_index += 1
    }
    enums = with_builtin_enums(enums)
    count := lowering.program.functions.len()
    lowering.structs = structs
    mut signatures: Vec<Signature> = Vec()
    mut main_index: u64 = count
    mut position: u64 = 0
    while position < count {
        definition := lowering.program.function_defs[lowering.program.functions[position]]
        // The bootstrap's signature key: the name, with `#method` for a function whose first parameter is `self`.
        mut key := definition.name.clone()
        when definition.parameters.len() > 0 && lowering.program.parameters[definition.parameters[0]].name == "self" && !definition.name.starts_with("String::") {
            key.append("#method")
        }
        // `R0201` for a function whose key an earlier function already has, before its signature is read.
        mut earlier: u64 = 0
        while earlier < signatures.len() {
            when signatures[earlier].name == key {
                return Result::Err(duplicate_function_error(definition.name, definition.span.start, definition.span.end))
            }
            earlier += 1
        }

        mut params: Vec<String> = Vec()
        mut parameter_index: u64 = 0
        while parameter_index < definition.parameters.len() {
            parameter := lowering.program.parameters[definition.parameters[parameter_index]]
            params.push(lowering.resolve(parameter.ty)?)
            parameter_index += 1
        }
        mut ret := String("")
        when definition.return_type.is_some() {
            ret = lowering.resolve(definition.return_type.unwrap())?
        }
        // `R0247`: an `extern "C"` signature with a value the C ABI does not pass, and an `extern "C"` `main`.
        when definition.extern_c {
            for word in params.clone() {
                when lowering.c_parameter_status(word) == 1 {
                    return Result::Err(c_abi_error(definition.span.start, definition.span.end))
                }
            }
            when !ret.is_empty() && lowering.c_return_status(ret.clone()) == 1 {
                return Result::Err(c_abi_error(definition.span.start, definition.span.end))
            }
            when definition.name == "main" {
                return Result::Err(extern_main_error(definition.span.start, definition.span.end))
            }
        }
        when definition.name == "main" {
            // `R0208`: `main` takes no parameters and returns no value or `i32`.
            when !params.is_empty() || (!ret.is_empty() && ret != "I32") {
                return Result::Err(main_signature_error(definition.span.start, definition.span.end))
            }
            main_index = position
        }
        returned := lowering.returned_parameter(definition.body.clone(), definition.return_value, definition.parameters.clone(), ret.clone())
        signatures.push(Signature { name: key, params: params, ret: ret, public: definition.public, module: definition.module_path.clone(), return_param: returned })
        position += 1
    }
    when main_index == count {
        return Result::Err(unsupported("no main function"))
    }
    lowering.scope_path = String("")
    lowering.call_scope = String("")
    lowering.module = String("")
    // `#[derive(Clone)]` adds a `clone` method per structure after the program's own functions.
    mut clone_structs: Vec<u64> = Vec()
    mut derive_index: u64 = 0
    while derive_index < lowering.structs.len() {
        mut clone_key := lowering.structs[derive_index].name.clone()
        clone_key.append("::clone#method")
        mut present := false
        for known in signatures.clone() {
            when known.name == clone_key {
                present = true
            }
        }
        when lowering.structs[derive_index].derives_clone == 1 && !present {
            mut self_type := String("Reference ")
            self_type.append(struct_word(derive_index))
            self_type.append(" 0")
            mut clone_params: Vec<String> = Vec()
            clone_params.push(self_type)
            signatures.push(Signature { name: clone_key, params: clone_params, ret: struct_word(derive_index), public: true, module: lowering.structs[derive_index].module_path.clone(), return_param: Option::None })
            clone_structs.push(derive_index)
        }
        derive_index += 1
    }
    lowering.signatures = signatures
    lowering.enums = enums
    lowering.add_aliases()
    mut functions: Vec<String> = Vec()
    mut id: u64 = 0
    while id < count {
        // The bounds of a function are checked before its body, as the bootstrap's `prepare_function` does.
        bound_failure := lowering.bound_conformance(id)
        when bound_failure.is_some() {
            return Result::Err(bound_failure.unwrap())
        }
        lowered_function := lowering.function(id)
        when lowered_function.is_err() {
            message := lowered_function.unwrap_err()
            when message.contains(" @ ") || message.starts_with("diagnostic ") {
                return Result::Err(message)
            }
            mut located := message
            located.append(" @ ")
            located.append(lowering.current_function.clone())
            located.append(" 0")
            return Result::Err(located)
        }
        functions.push(lowered_function.unwrap())
        id += 1
    }
    for struct_id in clone_structs {
        functions.push(lowering.clone_function(struct_id))
    }
    return Result::Ok(assemble(main_index, lowering.struct_records()?, functions, lowering.user_enum_records()))
}

extend Lowering {
    // `use module::path` makes the public structures and enums of that module available as `path::Name`.
    fun add_type_aliases(mut self) {
        for use_index in self.program.uses.clone() {
            import := self.program.use_decls[use_index]
            when import.path.is_empty() {
                continue
            }
            module_path := join_path(import.path.clone())
            mut alias := import.path[import.path.len() - 1].clone()
            when import.alias.is_some() {
                alias = import.alias.unwrap()
            }
            mut position: u64 = 0
            for struct_index in self.program.structs.clone() {
                definition := self.program.struct_defs[struct_index]
                when definition.public && definition.module_path == module_path {
                    mut alias_name := alias.clone()
                    alias_name.append("::")
                    alias_name.append(definition.name.clone())
                    self.type_names.push(alias_name)
                    self.type_words.push(struct_word(position))
                }
                position += 1
            }
            mut enum_position: u64 = 0
            for enum_index in self.program.enums.clone() {
                definition := self.program.enum_defs[enum_index]
                when definition.public && definition.module_path == module_path {
                    mut alias_name := alias.clone()
                    alias_name.append("::")
                    alias_name.append(definition.name.clone())
                    self.type_names.push(alias_name)
                    self.type_words.push(join(words2(String("Enum"), num(enum_position))))
                }
                enum_position += 1
            }
        }
    }

    // `use module::path` also makes the public functions of that module available as `path::name`.
    fun add_aliases(mut self) {
        for use_index in self.program.uses.clone() {
            import := self.program.use_decls[use_index]
            when import.path.is_empty() {
                continue
            }
            module_path := join_path(import.path.clone())
            mut alias := import.path[import.path.len() - 1].clone()
            when import.alias.is_some() {
                alias = import.alias.unwrap()
            }
            mut prefix := module_path.clone()
            prefix.append("::")
            mut function_id: u64 = 0
            for function_index in self.program.functions.clone() {
                definition := self.program.function_defs[function_index]
                when !definition.public && definition.module_path == module_path && definition.name.starts_with(prefix.clone()) {
                    mut private_name := alias.clone()
                    private_name.append("::")
                    private_name.append(definition.name.slice(prefix.len(), definition.name.len()))
                    self.private_alias_names.push(private_name)
                    self.private_alias_targets.push(definition.name.clone())
                }
                when definition.public && definition.module_path == module_path && definition.name.starts_with(prefix.clone()) && function_id < self.signatures.len() {
                    suffix := definition.name.slice(prefix.len(), definition.name.len())
                    mut alias_name := alias.clone()
                    alias_name.append("::")
                    alias_name.append(suffix)
                    when self.signatures[function_id].name.ends_with("#method") {
                        alias_name.append("#method")
                    }
                    when self.signature_exact(alias_name.clone()).is_err() {
                        self.alias_names.push(alias_name)
                        self.alias_targets.push(function_id)
                    }
                }
                function_id += 1
            }
        }
    }

    // Whether the program defines a method called `key` (`Type::method`) that takes `self`.
    fun defines_method(self, key: String) -> bool {
        for index in self.program.functions.clone() {
            definition := self.program.function_defs[index]
            when definition.name == key && definition.parameters.len() > 0 && self.program.parameters[definition.parameters[0]].name == "self" {
                return true
            }
        }
        return false
    }

    fun method_key(self, type_name: String, method: String) -> String {
        mut key := type_name
        key.append("::")
        key.append(method)
        return key
    }

    // A structure that has every method a shape requires receives the shape's default methods it
    // lacks, as functions of its own after the program's functions.
    fun add_shape_defaults(mut self) {
        for contract_index in self.program.shapes.clone() {
            contract := self.program.shape_defs[contract_index]
            for struct_index in self.program.structs.clone() {
                definition := self.program.struct_defs[struct_index]
                when definition.name.starts_with("$") {
                    continue
                }
                mut conforms := true
                for method_index in contract.methods.clone() {
                    method := self.program.shape_methods[method_index]
                    has_default := method.default_body.is_some() || method.default_value.is_some()
                    when !has_default && !self.defines_method(self.method_key(definition.name.clone(), method.name.clone())) {
                        conforms = false
                    }
                }
                when !conforms {
                    continue
                }
                for method_index in contract.methods.clone() {
                    method := self.program.shape_methods[method_index]
                    has_default := method.default_body.is_some() || method.default_value.is_some()
                    key := self.method_key(definition.name.clone(), method.name.clone())
                    when !has_default || self.defines_method(key.clone()) {
                        continue
                    }
                    self.add_default_method(definition.name.clone(), definition.module_path.clone(), key, method)
                }
            }
        }
    }

    fun reference_flag(self, index: u64) -> bool {
        choose self.program.types[index] {
            ast::TypeTree::RefTy(target, flag, span) => flag,
            _ => false,
        }
    }

    fun add_default_method(mut self, type_name: String, module: String, key: String, method: ast::ShapeMethod) {
        mut mutable := false
        when method.parameters.len() > 0 {
            first := self.program.parameters[method.parameters[0]]
            mutable = self.reference_flag(first.ty)
        }
        self.program.types.push(ast::TypeTree::NamedTy(type_name, method.span))
        named := self.program.types.len() - 1
        self.program.types.push(ast::TypeTree::RefTy(named, mutable, method.span))
        reference := self.program.types.len() - 1
        self.program.parameters.push(ast::Parameter { name: String("self"), ty: reference, span: method.span })
        parameter := self.program.parameters.len() - 1
        mut parameters: Vec<u64> = Vec()
        parameters.push(parameter)
        mut body: Vec<u64> = Vec()
        when method.default_body.is_some() {
            body = method.default_body.unwrap()
        }
        self.program.function_defs.push(ast::Function { name: key, extern_c: false, external_symbol: Option::None, type_parameters: Vec(), type_parameter_bounds: Vec(), public: true, module_path: module, parameters: parameters, return_type: method.return_type, body: body, return_value: method.default_value, span: method.span })
        self.program.functions.push(self.program.function_defs.len() - 1)
    }

    // The generated `clone` of a structure: a literal of the fields read through the borrowed receiver.
    fun clone_function(self, struct_id: u64) -> String {
        mut self_type := String("Reference ")
        self_type.append(struct_word(struct_id))
        self_type.append(" 0")
        mut fields: Vec<String> = Vec()
        mut field: u64 = 0
        while field < self.structs[struct_id].field_names.len() {
            read := join(words5(String("Local"), String("0"), self_type.clone(), String("0"), String("0")))
            mut reference: Vec<String> = Vec()
            reference.push(String("ReferenceField"))
            reference.push(read)
            reference.push(num(struct_id))
            reference.push(num(field))
            reference.push(self.structs[struct_id].field_types[field].clone())
            reference.push(String("0 0 0"))
            fields.push(num(field))
            fields.push(join(reference))
            field += 1
        }
        mut literal: Vec<String> = Vec()
        literal.push(String("StructValue"))
        literal.push(num(struct_id))
        literal.push(num(self.structs[struct_id].field_names.len()))
        for token in fields {
            literal.push(token)
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("1"))
        tokens.push(String("0"))
        tokens.push(self_type)
        tokens.push(String("-"))
        tokens.push(String("+"))
        tokens.push(struct_word(struct_id))
        tokens.push(String("-"))
        tokens.push(String("-"))
        tokens.push(String("1"))
        tokens.push(String("Return +"))
        tokens.push(join(literal))
        tokens.push(String("1 Ptr 1 - 1 -"))
        return join(tokens)
    }

    // Lowers one function body. Its locals, slots, and statements start empty.
    fun function(mut self, id: u64) -> Result<String, String> {
        self.locals = Vec()
        self.local_types = Vec()
        self.addressed_types = Vec()
        self.next_slot = 0
        self.statements = Vec()
        self.return_ty = self.signatures[id].ret.clone()
        self.loop_depth = 0
        self.visible = 0
        self.loop_floors = Vec()
        self.owners = Vec()
        self.defer_count = 0
        self.frame_marks = Vec()
        self.loop_frames = Vec()
        self.scope_floors = Vec()
        self.returned_refs = Vec()
        self.param_slots = Vec()
        self.moved_names = Vec()
        self.pending_moves = Vec()
        self.break_moves = Vec()
        self.continue_moves = Vec()
        self.borrows = Vec()
        self.origins = Vec()
        self.open_frame()
        definition := self.program.function_defs[self.program.functions[id]]
        self.scope_path = declaration_namespace(definition.name.clone(), definition.module_path.clone())
        self.call_scope = prefix_of(definition.name.clone())
        self.module = definition.module_path.clone()
        self.current_function = definition.name.clone()
        when definition.extern_c {
            return Result::Ok(self.extern_function_text(id, definition.external_symbol))
        }
        mut parameters: Vec<String> = Vec()
        mut parameter_index: u64 = 0
        while parameter_index < definition.parameters.len() {
            parameter := self.program.parameters[definition.parameters[parameter_index]]
            ty := self.signatures[id].params[parameter_index].clone()
            slot := self.allocate(ty.clone())?
            self.declare(Local { name: parameter.name, slot: slot, ty: ty.clone(), mutable: false })
            self.param_slots.push(slot)
            parameters.push(num(slot))
            parameters.push(ty)
            parameter_index += 1
        }
        // A destructor receives the value it releases, which it does not own.
        mut drop_floor: u64 = 0
        mut destructor_scan: u64 = 0
        while destructor_scan < self.structs.len() {
            when self.structs[destructor_scan].drop_name == definition.name {
                drop_floor = self.visible
                mut owned_slot: u64 = 0
                while owned_slot < self.owners.len() {
                    when self.has_destructor(self.owners[owned_slot].clone()) {
                        self.owners.set(owned_slot, String(""))
                    }
                    owned_slot += 1
                }
            }
            destructor_scan += 1
        }
        mut falls_through := true
        mut position: u64 = 0
        while position < definition.body.len() && falls_through {
            falls_through = !self.statement(definition.body[position])?
            self.commit_moves()
            position += 1
        }
        // The function's own defers run after its body, and after the result is computed.
        mut deferred := self.close_frame()?
        when !falls_through {
            deferred = no_items()
        }
        when definition.return_value.is_some() {
            when self.return_ty.is_empty() {
                return Result::Err(result_without_type_error(definition.name.clone(), definition.span.start, definition.span.end))
            }
            lowered := self.moved_expression(definition.return_value.unwrap(), self.return_ty.clone())?
            when deferred.is_empty() {
                self.note_return(lowered.text.clone(), lowered.ty.clone())
                self.statements.push(join(words3(String("Return"), String("+"), lowered.text)))
            } else {
                self.returned_refs.push(String(""))
                slot := self.allocate(self.return_ty.clone())?
                self.statements.push(join(words6(String("Let"), num(slot), self.return_ty.clone(), lowered.text, num(definition.span.start), num(definition.span.end))))
                for item in deferred {
                    self.statements.push(item)
                }
                self.statements.push(join(words3(String("Return"), String("+"), self.returned_slot(slot, definition.span.start, definition.span.end))))
            }
            falls_through = false
        } else {
            for item in deferred {
                self.statements.push(item)
            }
        }
        when !self.return_ty.is_empty() && falls_through {
            found := missing_return_error(self.return_ty.clone(), definition.name.clone(), definition.span.start, definition.span.end)
            when found.is_some() {
                return Result::Err(found.unwrap())
            }
            return Result::Err(unsupported("function must return a value"))
        }
        when falls_through {
            self.statements.push(self.owned_drop(drop_floor))
        }
        return Result::Ok(self.function_text(id, parameters))
    }
}

extend Lowering {
    // A function declared `extern "C"`: no body, and its parameters numbered from zero.
    fun extern_function_text(self, id: u64, symbol: Option<String>) -> String {
        params := self.signatures[id].params.clone()
        mut tokens: Vec<String> = Vec()
        tokens.push(num(params.len()))
        mut slot: u64 = 0
        for param in params {
            tokens.push(num(slot))
            tokens.push(param)
            slot += 1
        }
        when symbol.is_some() {
            tokens.push(String("+"))
            tokens.push(length_prefixed(symbol.unwrap()))
        } else {
            tokens.push(String("-"))
        }
        ret := self.signatures[id].ret.clone()
        when ret.is_empty() {
            tokens.push(String("-"))
        } else {
            tokens.push(String("+"))
            tokens.push(ret)
        }
        tokens.push(String("- - 1 Drop 0 0 0 0"))
        return join(tokens)
    }

    // One function's IR: parameters, external symbol, result, return value, statements, tables.
    fun function_text(self, id: u64, parameters: Vec<String>) -> String {
        mut tokens: Vec<String> = Vec()
        tokens.push(num(parameters.len() / 2))
        for token in parameters {
            tokens.push(token)
        }
        tokens.push(String("-"))
        ret := self.signatures[id].ret.clone()
        when ret.is_empty() {
            tokens.push(String("-"))
        } else {
            tokens.push(String("+"))
            tokens.push(ret)
        }
        mut reference_return := String("")
        mut consistent := !self.returned_refs.is_empty() && !self.returned_refs[0].is_empty()
        for returned in self.returned_refs.clone() {
            when returned != self.returned_refs[0] {
                consistent = false
            }
        }
        when consistent {
            reference_return = self.returned_refs[0].clone()
        }
        when reference_return.is_empty() {
            tokens.push(String("-"))
        } else {
            tokens.push(String("+"))
            tokens.push(reference_return)
        }
        tokens.push(String("-"))
        local_count := self.local_types.len()
        tokens.push(num(self.statements.len()))
        mut index: u64 = 0
        while index < self.statements.len() {
            tokens.push(self.statements[index].clone())
            index += 1
        }
        tokens.push(num(local_count))
        index = 0
        while index < local_count {
            tokens.push(self.local_types[index].clone())
            index += 1
        }
        tokens.push(num(local_count))
        index = 0
        while index < local_count {
            when self.owners[index].is_empty() {
                tokens.push(String("-"))
            } else {
                tokens.push(String("+"))
                tokens.push(self.owners[index].clone())
            }
            index += 1
        }
        tokens.push(num(self.addressed_types.len()))
        mut addressed: u64 = 0
        while addressed < self.addressed_types.len() {
            when self.addressed_types[addressed].is_empty() {
                tokens.push(String("-"))
            } else {
                tokens.push(String("+"))
                tokens.push(self.addressed_types[addressed].clone())
            }
            addressed += 1
        }
        return join(tokens)
    }
}

// The whole IR text: header, builtin enums, and the functions in source order.
fun assemble(main_index: u64, structs: Vec<String>, functions: Vec<String>, enums: Vec<String>) -> String {
    mut tokens: Vec<String> = Vec()
    tokens.push(String("Ir"))
    tokens.push(num(main_index))
    tokens.push(String("-"))
    tokens.push(num(structs.len()))
    for record in structs {
        tokens.push(record)
    }
    tokens.push(num(enums.len()))
    for record in enums {
        tokens.push(record)
    }
    tokens.push(num(functions.len()))
    for function in functions {
        tokens.push(function)
    }
    // The bootstrap encoder writes a space before every word, including the first.
    mut out := String(" ")
    out.append(join(tokens))
    return out
}

// The source span of an expression node.
fun expr_span(node: ast::ExprTree) -> ast::Span {
    choose node {
        ast::ExprTree::IntLit(a, s) => s,
        ast::ExprTree::FloatLit(a, s) => s,
        ast::ExprTree::StrLit(a, s) => s,
        ast::ExprTree::CharLit(a, s) => s,
        ast::ExprTree::BoolLit(a, s) => s,
        ast::ExprTree::NameRef(a, s) => s,
        ast::ExprTree::CallE(a, b, c, s) => s,
        ast::ExprTree::MethodCallE(a, b, c, d, s) => s,
        ast::ExprTree::StructLit(a, b, s) => s,
        ast::ExprTree::FieldE(a, b, c, s) => s,
        ast::ExprTree::RangeE(a, b, c, s) => s,
        ast::ExprTree::IfE(a, b, c, s) => s,
        ast::ExprTree::BinaryE(a, b, c, s) => s,
        ast::ExprTree::NegateE(a, s) => s,
        ast::ExprTree::NotE(a, s) => s,
        ast::ExprTree::BitNotE(a, s) => s,
        ast::ExprTree::AddressOfE(a, b, c, s) => s,
        ast::ExprTree::DerefE(a, s) => s,
        ast::ExprTree::CastE(a, b, s) => s,
        ast::ExprTree::LayoutE(a, b, s) => s,
        ast::ExprTree::VecNewE(a, s) => s,
        ast::ExprTree::MapNewE(a, b, s) => s,
        ast::ExprTree::SetNewE(a, s) => s,
        ast::ExprTree::TupleE(a, s) => s,
        ast::ExprTree::ArrayE(a, s) => s,
        ast::ExprTree::RepeatE(a, b, s) => s,
        ast::ExprTree::IndexE(a, b, s) => s,
        ast::ExprTree::PropagateE(a, s) => s,
        ast::ExprTree::EnumE(a, b, c, s) => s,
        ast::ExprTree::ChooseE(a, b, s) => s,
        ast::ExprTree::PipeE(a, b, s) => s,
        ast::ExprTree::CoalesceE(a, b, s) => s,
        ast::ExprTree::OptionalFieldE(a, b, c, s) => s,
    }
}

extend Lowering {
    // The type of a value from its form alone, as `value_type_hint` of the bootstrap: "" when
    // the form does not say.
    fun value_hint(self, index: u64) -> String {
        choose self.program.exprs[index] {
            ast::ExprTree::CharLit(value, span) => String("Char"),
            ast::ExprTree::StrLit(text, span) => String("Str"),
            ast::ExprTree::NameRef(name, span) => self.hint_of_name(name),
            ast::ExprTree::CallE(name, type_arguments, arguments, span) => self.hint_of_call(name),
            ast::ExprTree::MethodCallE(receiver, name, type_arguments, arguments, span) => self.hint_of_method(receiver, name),
            ast::ExprTree::StructLit(name, fields, span) => self.hint_of_struct(name),
            ast::ExprTree::CastE(value, ty, span) => self.hint_of_cast(ty),
            ast::ExprTree::FieldE(value, name, name_span, span) => self.hint_of_field(value, name),
            _ => String(""),
        }
    }

    fun hint_of_name(self, name: String) -> String {
        found := self.find(name)
        when found.is_err() {
            return String("")
        }
        return self.locals[found.unwrap()].ty.clone()
    }

    fun hint_of_call(self, name: String) -> String {
        when name == "String" {
            return String("OwnedString")
        }
        id := self.signature_exact(name)
        when id.is_err() {
            return String("")
        }
        return self.signatures[id.unwrap()].ret.clone()
    }

    fun hint_of_struct(self, name: String) -> String {
        id := self.struct_id(name)
        when id.is_err() {
            return String("")
        }
        return struct_word(id.unwrap())
    }

    fun hint_of_cast(self, ty: u64) -> String {
        word := self.annotation(ty)
        when word.is_err() {
            return String("")
        }
        return word.unwrap()
    }

    fun hint_of_field(self, value: u64, name: String) -> String {
        mut base := self.value_hint(value)
        when reference_inner(base.clone()).is_some() {
            base = reference_inner(base.clone()).unwrap()
        }
        id := struct_id_of(base)
        when id.is_none() {
            return String("")
        }
        field := self.field_index(id.unwrap(), name)
        when field.is_err() {
            return String("")
        }
        return self.structs[id.unwrap()].field_types[field.unwrap()].clone()
    }

    // What a method call returns, for the receivers whose methods the bootstrap hints.
    fun hint_of_method(self, receiver: u64, name: String) -> String {
        mut base := self.value_hint(receiver)
        when reference_inner(base.clone()).is_some() {
            base = reference_inner(base.clone()).unwrap()
        }
        when base == "OwnedString" {
            row := methods::string_method(name, false)
            when row.is_some() {
                return row.unwrap().ret
            }
            return String("")
        }
        element := vec_element_of(base.clone())
        when element.is_some() {
            row := methods::vec_method(name, element.unwrap())
            when row.is_some() {
                return row.unwrap().ret
            }
            return String("")
        }
        when is_numeric_word(base) && name == "to_string" {
            return String("OwnedString")
        }
        return String("")
    }

    // The numeric type an operand says by itself (`numeric_type_hint` of the bootstrap), else "".
    fun numeric_hint(self, index: u64) -> String {
        choose self.program.exprs[index] {
            ast::ExprTree::MethodCallE(receiver, name, type_arguments, arguments, span) => self.numeric_only(self.value_hint(index)),
            ast::ExprTree::NameRef(name, span) => self.numeric_only(self.hint_of_name(name)),
            ast::ExprTree::CallE(name, type_arguments, arguments, span) => self.hint_of_numeric_call(name),
            ast::ExprTree::FieldE(value, name, name_span, span) => self.numeric_only(self.hint_of_field(value, name)),
            ast::ExprTree::NegateE(value, span) => self.numeric_hint(value),
            ast::ExprTree::BitNotE(value, span) => self.numeric_hint(value),
            ast::ExprTree::CastE(value, ty, span) => self.numeric_only(self.hint_of_cast(ty)),
            ast::ExprTree::BinaryE(op, left, right, span) => self.numeric_of_binary(op, left, right),
            _ => String(""),
        }
    }

    fun numeric_only(self, ty: String) -> String {
        when is_numeric_word(ty.clone()) {
            return ty
        }
        return String("")
    }

    fun hint_of_numeric_call(self, name: String) -> String {
        when name == "arg_count" {
            return String("U32")
        }
        id := self.signature_exact(name)
        when id.is_err() {
            return String("")
        }
        return self.numeric_only(self.signatures[id.unwrap()].ret.clone())
    }

    fun numeric_of_binary(self, op: String, left: u64, right: u64) -> String {
        when is_shift_op(op.clone()) {
            return self.numeric_hint(left)
        }
        when op == "Add" || op == "Sub" || op == "Mul" || op == "Div" || op == "Rem" || op == "BitAnd" || op == "BitXor" || op == "BitOr" {
            first := self.numeric_hint(left)
            when !first.is_empty() {
                return first
            }
            return self.numeric_hint(right)
        }
        return String("")
    }

    // A method call's receiver: a local or a field of one, read as a borrowed view.
    fun receiver(mut self, index: u64) -> Result<Lowered, String> {
        choose self.program.exprs[index] {
            ast::ExprTree::NameRef(name, span) => self.receiver_name(name, span),
            ast::ExprTree::FieldE(value, name, name_span, span) => self.borrowed_field(value, name, span),
            ast::ExprTree::IndexE(value, position, span) => self.index_expression(value, position, String(""), span),
            _ => self.expression(index, String("")),
        }
    }

    // A local used as a method receiver. A moved local is `R0240` at the receiver's name, as the guard reports it.
    fun receiver_name(mut self, name: String, span: ast::Span) -> Result<Lowered, String> {
        when self.is_moved(name.clone()) {
            return Result::Err(moved_value_error(span.start, span.end))
        }
        return self.name(name, span)
    }

    // A field used as a method receiver. A collection or string read through a reference is
    // borrowed: the method works on the stored value, not a copy.
    fun borrowed_field(mut self, value: u64, name: String, span: ast::Span) -> Result<Lowered, String> {
        field := self.field_read(value, name.clone(), span, String(""))?
        when (field.text.starts_with("ReferenceField ") || field.text.starts_with("Field ")) && self.chain_root_is_reference(value) && (field.ty == "OwnedString" || is_collection_word(field.ty.clone())) {
            self.borrow_chain = true
            borrowed := self.field_read(value, name, span, String(""))
            self.borrow_chain = false
            return borrowed
        }
        return Result::Ok(field)
    }

    // The index of the result enum with these `Ok` and `Err` payloads.
    fun result_index(self, ok: String, err: String) -> Result<u64, String> {
        mut id: u64 = 0
        while id < self.enums.len() {
            info := self.enums[id]
            when info.name.starts_with("$RynResult#") && info.variant_names.len() == 2 && info.variant_names[0] == "Ok" && info.field_types[0] == ok && info.variant_names[1] == "Err" && info.field_types[1] == err {
                return Result::Ok(id)
            }
            id += 1
        }
        return Result::Err(unsupported("result type"))
    }

    // The index of the option enum whose payload is `payload`.
    fun option_index(self, payload: String) -> Result<u64, String> {
        mut id: u64 = 0
        while id < self.enums.len() {
            when is_option_payload(self.enums[id], payload.clone()) {
                return Result::Ok(id)
            }
            id += 1
        }
        return Result::Err(unsupported("option type"))
    }

    // Lowers the arguments of a builtin method against its parameter types. The argument at the
    // `owning` position is moved; one that borrows text may be a `String` where `str` is expected.
    fun method_arguments(mut self, params: Vec<String>, arguments: Vec<u64>, owning: u64, borrows_text: bool) -> Result<Vec<String>, String> {
        when arguments.len() != params.len() {
            return Result::Err(unsupported("method argument count"))
        }
        mut lowered: Vec<String> = Vec()
        mut position: u64 = 0
        while position < arguments.len() {
            expected := params[position].clone()
            mut value := Lowered { text: String(""), ty: String("") }
            when borrows_text && expected == "Str" {
                value = self.expression(arguments[position], String(""))?
                when value.ty == "OwnedString" {
                    lowered.push(join(words2(String("StringAsStr"), value.text)))
                    position += 1
                    continue
                }
            } else when ((owning >> (position as u32)) & 1) == 1 {
                value = self.method_argument_value(arguments[position], expected.clone(), true)?
            } else {
                value = self.method_argument_value(arguments[position], expected.clone(), false)?
            }
            when value.ty != expected {
                return Result::Err(self.method_type_error(arguments[position], value.ty.clone(), expected.clone()))
            }
            lowered.push(value.text)
            position += 1
        }
        return Result::Ok(lowered)
    }

    // An argument of a method call, lowered at the parameter's type. A refusal for another type is `R0212` (the probe is
    // the same as for a function's argument), and any other refusal stands.
    fun method_argument_value(mut self, argument: u64, expected: String, moved: bool) -> Result<Lowered, String> {
        mut outcome: Result<Lowered, String> = Result::Err(String(""))
        when moved {
            outcome = self.moved_expression(argument, expected.clone())
        } else {
            outcome = self.expression(argument, expected.clone())
        }
        when outcome.is_err() {
            refusal := outcome.unwrap_err()
            other := self.other_type_of(argument, expected.clone(), refusal.clone())
            when other.is_some() {
                mismatch := self.method_mismatch(argument, other.unwrap(), expected)
                when mismatch.is_some() {
                    return Result::Err(mismatch.unwrap())
                }
            }
            return Result::Err(refusal)
        }
        return outcome
    }

    // The `R0212` of a method argument whose type is another scalar or string type, or a refusal that stands.
    fun method_type_error(self, argument: u64, actual: String, expected: String) -> String {
        mismatch := self.method_mismatch(argument, actual, expected.clone())
        when mismatch.is_some() {
            return mismatch.unwrap()
        }
        return unsupported("method argument type")
    }

    // `R0212` for a method argument whose scalar or string type is not the parameter's, at the argument, with no help.
    fun method_mismatch(self, argument: u64, actual: String, expected: String) -> Option<String> {
        actual_name := scalar_type_name(actual)
        expected_name := scalar_type_name(expected)
        when actual_name.is_none() || expected_name.is_none() {
            return Option::None
        }
        span := self.expr_span_of(argument)
        mut message := String("method argument has type `")
        message.append(actual_name.unwrap())
        message.append("` but `")
        message.append(expected_name.unwrap())
        message.append("` is required")
        return Option::Some(diagnostic("R0212", span.start, span.end, message, String("")))
    }

    // `receiver.name(arguments)`: the call target with its argument count and arguments, and the
    // result type ("" for none).
    fun method_target(mut self, receiver: u64, name: String, type_arguments: Vec<u64>, arguments: Vec<u64>, span: ast::Span) -> Result<Lowered, String> {
        recv := self.receiver(receiver)?
        ty := recv.ty.clone()
        when ty == "OwnedString" && (name == "append" || name == "push" || name == "clear") && self.immutable_local_receiver(receiver) {
            return Result::Err(mutable_string_error(name.clone(), span.start, span.end))
        }
        when name == "to_string" && arguments.is_empty() {
            when ty == "OwnedString" {
                return Result::Ok(Lowered { text: join(words4(String("String"), String("Clone"), String("1"), recv.text)), ty: String("OwnedString") })
            }
            when is_numeric_word(ty.clone()) {
                mut op := String("From")
                op.append(ty.clone())
                return Result::Ok(Lowered { text: join(words4(String("String"), op, String("1"), recv.text)), ty: String("OwnedString") })
            }
        }
        when reference_inner(ty.clone()).is_some() && reference_inner(ty.clone()).unwrap() == "OwnedString" {
            // A statement passes the reference itself; an expression reads through it.
            mut viewed := Lowered { text: join(words3(String("Dereference"), recv.text.clone(), String("OwnedString"))), ty: String("OwnedString") }
            when self.chained {
                viewed = Lowered { text: recv.text.clone(), ty: String("OwnedString") }
            }
            return self.string_method(viewed, name, type_arguments, arguments)
        }
        when ty.starts_with("Slice ") && name == "len" && arguments.is_empty() {
            return Result::Ok(Lowered { text: join(words3(String("SliceLen"), String("1"), recv.text)), ty: String("U64") })
        }
        element := vec_element_of(ty.clone())
        when element.is_some() {
            return self.vec_method(recv, element.unwrap(), name, arguments)
        }
        when ty == "OwnedString" {
            return self.string_method(recv, name, type_arguments, arguments)
        }
        enum_id := enum_id_of(ty.clone())
        when enum_id.is_some() {
            return self.enum_method(recv, enum_id.unwrap(), name, arguments)
        }
        when map_parts(ty.clone()).is_some() {
            return self.map_method_call(recv, name, arguments)
        }
        mut struct_ty := ty.clone()
        inner := reference_inner(ty.clone())
        when inner.is_some() {
            struct_ty = inner.unwrap()
        }
        when struct_id_of(struct_ty.clone()).is_some() {
            return self.struct_method(receiver, recv, struct_id_of(struct_ty).unwrap(), name, arguments, span)
        }
        return Result::Err(unsupported("method on this type"))
    }

    fun vec_method(mut self, recv: Lowered, element: String, name: String, arguments: Vec<u64>) -> Result<Lowered, String> {
        when name == "get" || name == "first" || name == "last" {
            option_id := self.option_index(element.clone())?
            mut index_text := String("")
            when name == "get" {
                when arguments.len() != 1 {
                    return Result::Err(unsupported("get argument count"))
                }
                index := self.expression(arguments[0], String("U64"))?
                when index.ty != "U64" {
                    return Result::Err(unsupported("get index type"))
                }
                index_text = index.text
            } else when name == "first" {
                index_text = String("Integer 0 U64")
            } else {
                index_text = String("Integer 18446744073709551615 U64")
            }
            head := join(words6(String("VecGetOption"), element, num(option_id), String("0"), String("2"), recv.text))
            mut text := head
            text.append(" ")
            text.append(index_text)
            return Result::Ok(Lowered { text: text, ty: join(words2(String("Enum"), num(option_id))) })
        }
        when name == "pop" {
            option_id := self.option_index(element.clone())?
            return Result::Ok(Lowered { text: join(words6(String("VecGetOption"), element, num(option_id), String("1"), String("1"), recv.text)), ty: join(words2(String("Enum"), num(option_id))) })
        }
        when name == "as_slice" || name == "slice" {
            mut start := String("Integer 0 U64")
            mut end := join(words6(String("Call"), String("Vec"), String("Len"), element.clone(), String("1"), join(words2(recv.text.clone(), String("U64")))))
            when name == "slice" {
                when arguments.len() != 2 {
                    return Result::Err(unsupported("slice arguments"))
                }
                first := self.expression(arguments[0], String("U64"))?
                last := self.expression(arguments[1], String("U64"))?
                when first.ty != "U64" || last.ty != "U64" {
                    return Result::Err(unsupported("slice bounds"))
                }
                start = first.text
                end = last.text
            }
            mut slice_ty := String("Slice ")
            slice_ty.append(element.clone())
            return Result::Ok(Lowered { text: join(words6(String("VecSlice"), element, String("3"), recv.text, start, end)), ty: slice_ty })
        }
        found := methods::vec_method(name, element.clone())
        when found.is_none() {
            return Result::Err(unsupported("Vec method"))
        }
        row := found.unwrap()
        lowered := self.method_arguments(row.params.clone(), arguments, row.owning, false)?
        mut tokens: Vec<String> = Vec()
        tokens.push(String("Vec"))
        tokens.push(row.op.clone())
        tokens.push(element)
        tokens.push(num(lowered.len() + 1))
        tokens.push(recv.text)
        for text in lowered {
            tokens.push(text)
        }
        return Result::Ok(Lowered { text: join(tokens), ty: row.ret.clone() })
    }

    fun string_method(mut self, recv: Lowered, name: String, type_arguments: Vec<u64>, arguments: Vec<u64>) -> Result<Lowered, String> {
        mut method := name.clone()
        when name == "parse" || name == "try_parse" {
            when type_arguments.len() != 1 || !arguments.is_empty() {
                return Result::Err(unsupported("parse sigwords"))
            }
            target := self.annotation(type_arguments[0])?
            when !is_numeric_word(target.clone()) {
                return Result::Err(unsupported("parse target"))
            }
            method = String("to_")
            when name == "try_parse" {
                method = String("try_to_")
            }
            method.append(target.to_lower())
        }
        try_prefix := method.starts_with("try_to_")
        mut owned_argument := false
        when !arguments.is_empty() {
            owned_argument = self.value_hint(arguments[0]) == "OwnedString"
        }
        mut operation := String("")
        mut params: Vec<String> = Vec()
        mut ret := String("")
        mut tag: u64 = 0
        when try_prefix {
            word := method.slice(7, method.len())
            parsed := try_parse_type(word)
            when parsed.is_none() {
                return Result::Err(unsupported("try_to method"))
            }
            operation = String("TryParse")
            params.push(String("U32"))
            tag = parsed.unwrap()
            option_id := self.option_index(try_parse_word(tag))?
            ret = join(words2(String("Enum"), num(option_id)))
        } else {
            found := methods::string_method(method, owned_argument)
            when found.is_none() {
                return self.string_extension(recv, name, arguments)
            }
            row := found.unwrap()
            operation = row.op
            params = row.params
            ret = row.ret
        }
        mut lowered: Vec<String> = Vec()
        when try_prefix {
            lowered.push(join(words3(String("Integer"), num(tag), String("U32"))))
        } else {
            lowered = self.method_arguments(params, arguments, 0, true)?
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("String"))
        tokens.push(operation)
        tokens.push(num(lowered.len() + 1))
        tokens.push(recv.text)
        for text in lowered {
            tokens.push(text)
        }
        return Result::Ok(Lowered { text: join(tokens), ty: ret })
    }

    // A method added to `String` by an `extend String` block. The receiver local is lent to it.
    fun string_extension(mut self, recv: Lowered, name: String, arguments: Vec<u64>) -> Result<Lowered, String> {
        mut key := String("String::")
        key.append(name)
        function := self.signature_index(key)?
        params := self.signatures[function].params.clone()
        when params.is_empty() || arguments.len() + 1 != params.len() {
            return Result::Err(unsupported("extension argument count"))
        }
        mut lent := recv.text.clone()
        when recv.text.starts_with("Local ") && !recv.ty.starts_with("Reference ") {
            parts := recv.text.split(" ")
            slot := parts[1].try_parse::<u64>().unwrap_or(0)
            mut pointer := String("Reference OwnedString ")
            when reference_is_mutable(params[0].clone()) {
                pointer.append("1")
            } else {
                pointer.append("0")
            }
            self.addressed_types.set(slot, String("OwnedString"))
            lent = join(words6(String("AddressOf"), num(slot), String("OwnedString"), pointer, parts[recv_span_start()].clone(), parts[recv_span_end()].clone()))
        } else when !recv.text.starts_with("Local ") {
            return Result::Err(unsupported("extension receiver must be a local"))
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("Function"))
        tokens.push(num(function))
        tokens.push(num(params.len()))
        tokens.push(lent)
        mut position: u64 = 0
        while position < arguments.len() {
            value := self.expression(arguments[position], params[position + 1].clone())?
            when value.ty != params[position + 1] {
                return Result::Err(unsupported("extension argument type"))
            }
            tokens.push(value.text)
            position += 1
        }
        return Result::Ok(Lowered { text: join(tokens), ty: self.signatures[function].ret.clone() })
    }

    fun method_expression(mut self, receiver: u64, name: String, type_arguments: Vec<u64>, arguments: Vec<u64>, span: ast::Span, expected: String) -> Result<Lowered, String> {
        lowered := self.method_target(receiver, name.clone(), type_arguments, arguments, span)?
        when lowered.ty.is_empty() {
            return Result::Err(unsupported("value of a method without a result"))
        }
        // `find` yields an `Option<u64>` made from the signed position the runtime returns.
        when lowered.text.starts_with("String FindStr") || lowered.text.starts_with("String FindString") {
            option_id := self.option_index(String("U64"))?
            raw := join(words3(String("Call"), lowered.text, String("I64")))
            return Result::Ok(Lowered { text: join(words3(String("StringFindOption"), raw, num(option_id))), ty: join(words2(String("Enum"), num(option_id))) })
        }
        return Result::Ok(Lowered { text: join(words3(String("Call"), lowered.text, lowered.ty.clone())), ty: lowered.ty })
    }

    fun method_statement(mut self, receiver: u64, name: String, arguments: Vec<u64>, span: ast::Span) -> Result<bool, String> {
        // `root.a().b()` is a sequence of calls on the same root, each with its own span.
        mut chain: Vec<u64> = Vec()
        mut root := receiver
        while self.is_method_call(root) {
            chain.push(root)
            root = self.method_receiver_of(root)
        }
        mut items: Vec<String> = Vec()
        self.chained = true
        mut position: u64 = chain.len()
        while position > 0 {
            position -= 1
            link := chain[position]
            lowered := self.method_target(root, self.method_name_of(link), Vec(), self.method_arguments_of(link), self.expr_span_of(link))?
            when !lowered.ty.is_empty() {
                return Result::Err(unsupported("value in the middle of a method chain"))
            }
            items.push(join(words2(String("CallStatement"), lowered.text)))
        }
        last := self.method_target(root, name, Vec(), arguments, span)?
        self.chained = false
        items.push(join(words2(String("CallStatement"), last.text)))
        when items.len() == 1 {
            self.statements.push(items[0].clone())
        } else {
            items.push(self.owned_drop(self.scope_floor_end()))
            self.statements.push(join(block_of(items)))
        }
        return Result::Ok(false)
    }

    fun is_method_call(self, index: u64) -> bool {
        choose self.program.exprs[index] {
            ast::ExprTree::MethodCallE(r, n, t, a, s) => true,
            _ => false,
        }
    }

    fun method_receiver_of(self, index: u64) -> u64 {
        choose self.program.exprs[index] {
            ast::ExprTree::MethodCallE(r, n, t, a, s) => r,
            _ => index,
        }
    }

    fun method_name_of(self, index: u64) -> String {
        choose self.program.exprs[index] {
            ast::ExprTree::MethodCallE(r, n, t, a, s) => n,
            _ => String(""),
        }
    }

    fun method_arguments_of(self, index: u64) -> Vec<u64> {
        choose self.program.exprs[index] {
            ast::ExprTree::MethodCallE(r, n, t, a, s) => a,
            _ => Vec(),
        }
    }

    fun expr_span_of(self, index: u64) -> ast::Span {
        return expr_span(self.program.exprs[index])
    }

    // A block of statements ends with the drop of its own owned locals; a chain adds none of its own.
    fun scope_floor_end(self) -> u64 {
        return self.visible
    }

    // A call to a method defined in an `extend` block. The receiver is lent to it as a reference.
    fun struct_method(mut self, receiver: u64, recv: Lowered, id: u64, name: String, arguments: Vec<u64>, span: ast::Span) -> Result<Lowered, String> {
        // A method of a structure in a module is named by that module: `util::P::hidden#method`. A generated method,
        // such as the `clone` of `#[derive(Clone)]`, keeps the structure's own name, so that is the fallback.
        mut key := String("")
        mut owner_prefix := self.structs[id].module_path.clone()
        when !owner_prefix.is_empty() {
            owner_prefix.append("::")
            when !self.structs[id].name.starts_with(owner_prefix.clone()) {
                key = self.structs[id].module_path.clone()
                key.append("::")
            }
        }
        key.append(self.structs[id].name.clone())
        key.append("::")
        key.append(name.clone())
        key.append("#method")
        mut found := self.signature_index(key)
        when found.is_err() {
            mut bare := self.structs[id].name.clone()
            bare.append("::")
            bare.append(name.clone())
            bare.append("#method")
            found = self.signature_index(bare)
        }
        function := found?
        // `R0425`: a method that its `extend` block does not mark `pub`, called from another module.
        when !self.signatures[function].public && self.signatures[function].module != self.module {
            return Result::Err(private_method_error(name.clone(), self.structs[id].name.clone(), span.start, span.end))
        }
        params := self.signatures[function].params.clone()
        when params.is_empty() || arguments.len() + 1 != params.len() {
            return Result::Err(unsupported("method argument count"))
        }
        borrowed := reference_inner(recv.ty.clone())
        mut lent := recv.text.clone()
        when borrowed.is_none() && reference_is_mutable(params[0].clone()) && self.immutable_local_receiver(receiver) {
            return Result::Err(mutable_receiver_error(name.clone(), span.start, span.end))
        }
        when borrowed.is_none() {
            slot := self.receiver_local(receiver, recv.clone(), reference_is_mutable(params[0].clone()), span)?
            mut pointer := String("Reference ")
            pointer.append(recv.ty.clone())
            pointer.append(" ")
            when reference_is_mutable(params[0].clone()) {
                pointer.append("1")
            } else {
                pointer.append("0")
            }
            self.addressed_types.set(slot, recv.ty.clone())
            lent = join(words6(String("AddressOf"), num(slot), recv.ty.clone(), pointer, num(span.start), num(span.end)))
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("Function"))
        tokens.push(num(function))
        tokens.push(num(params.len()))
        tokens.push(lent)
        mut position: u64 = 0
        while position < arguments.len() {
            value := self.method_argument_value(arguments[position], params[position + 1].clone(), true)?
            when value.ty != params[position + 1] {
                return Result::Err(self.method_type_error(arguments[position], value.ty.clone(), params[position + 1].clone()))
            }
            tokens.push(value.text)
            position += 1
        }
        return Result::Ok(Lowered { text: join(tokens), ty: self.signatures[function].ret.clone() })
    }

    // The slot a method borrows as its receiver. A local is borrowed in place. Any other receiver is a temporary, which a
    // shared `self` may borrow once its value is bound to a new local (the bootstrap's `materialize_copy_receiver`); a
    // mutable `self` cannot borrow a temporary, and neither can a receiver that is not copyable (`R0235`).
    fun receiver_local(mut self, receiver: u64, recv: Lowered, mutable: bool, span: ast::Span) -> Result<u64, String> {
        when self.is_name_receiver(receiver) {
            return self.receiver_slot(receiver)
        }
        when mutable {
            return Result::Err(diagnostic("R0235", span.start, span.end, String("method receivers must be a local variable for now"), String("assign the value to a local first; `mut self` cannot borrow a temporary")))
        }
        when !self.receiver_copyable(recv.ty.clone()) {
            return Result::Err(diagnostic("R0235", span.start, span.end, String("method receivers must be a local variable for now"), String("assign the value to a local first; only copyable expression receivers are stored in a temporary")))
        }
        slot := self.allocate(recv.ty.clone())?
        self.setup.push(join(words6(String("Let"), num(slot), recv.ty.clone(), recv.text, num(span.start), num(span.end))))
        return Result::Ok(slot)
    }

    // Whether a receiver expression is a name, which is a local.
    fun is_name_receiver(self, index: u64) -> bool {
        choose self.program.exprs[index] {
            ast::ExprTree::NameRef(name, span) => true,
            _ => false,
        }
    }

    // Whether a value of a type may be stored in a temporary and borrowed (the bootstrap's `receiver_is_copyable`): strings,
    // collections, enums, slices, references and function pointers are not, and a structure is unless it owns data.
    fun receiver_copyable(self, ty: String) -> bool {
        when ty == "OwnedString" || ty == "Str" || ty.starts_with("Vec ") || ty.starts_with("Map ") || ty.starts_with("Set ") || ty.starts_with("Enum ") || ty.starts_with("Slice ") || ty.starts_with("Reference ") || ty.starts_with("FunctionPointer ") {
            return false
        }
        when struct_id_of(ty.clone()).is_some() {
            return !self.struct_owns_data(struct_id_of(ty).unwrap())
        }
        when array_parts(ty.clone()).is_some() {
            return self.receiver_copyable(array_parts(ty).unwrap()[0].clone())
        }
        return true
    }

    // Whether a structure has a destructor or a field that owns data (the bootstrap's `type_has_owned_data_in_sema`).
    fun struct_owns_data(self, id: u64) -> bool {
        info := self.structs[id]
        when !info.drop_name.is_empty() {
            return true
        }
        for field_word in info.field_types.clone() {
            when self.field_owns_data(field_word) {
                return true
            }
        }
        return false
    }

    fun field_owns_data(self, ty: String) -> bool {
        when ty == "OwnedString" || ty.starts_with("Vec ") || ty.starts_with("Map ") || ty.starts_with("Set ") || ty.starts_with("Enum ") {
            return true
        }
        when struct_id_of(ty.clone()).is_some() {
            return self.struct_owns_data(struct_id_of(ty).unwrap())
        }
        return false
    }

    // The slot of a local used as a method receiver.
    fun receiver_slot(self, index: u64) -> Result<u64, String> {
        choose self.program.exprs[index] {
            ast::ExprTree::NameRef(name, span) => self.slot_of(name),
            _ => Result::Err(unsupported("method receiver must be a local")),
        }
    }

    fun slot_of(self, name: String) -> Result<u64, String> {
        found := self.find(name)?
        return Result::Ok(self.locals[found].slot)
    }

    // An argument for a slice parameter. An array, or an array literal, is lent as a slice.
    fun slice_argument(mut self, argument: u64, expected: String) -> Result<String, String> {
        element := expected.slice(6, expected.len())
        mut context := self.value_hint(argument)
        when !context.starts_with("Array ") {
            context = String("")
        }
        literal := self.literal_array_context(argument, element.clone())
        when !literal.is_empty() {
            context = literal
        }
        when context.is_empty() {
            value := self.moved_expression(argument, expected.clone())?
            when value.ty != expected {
                return Result::Err(unsupported("argument type"))
            }
            return Result::Ok(value.text)
        }
        value := self.expression(argument, context)?
        parts := array_parts(value.ty.clone())
        when parts.is_some() && parts.unwrap()[0] == element {
            length := array_length_of(array_parts(value.ty.clone()).unwrap())
            return Result::Ok(join(words4(String("ArrayAsSlice"), value.text, element, num(length))))
        }
        when value.ty != expected {
            return Result::Err(unsupported("argument type"))
        }
        return Result::Ok(value.text)
    }

    fun literal_array_context(self, argument: u64, element: String) -> String {
        choose self.program.exprs[argument] {
            ast::ExprTree::ArrayE(values, span) => self.array_context(element, values.len()),
            ast::ExprTree::RepeatE(value, length, span) => self.array_context(element, length),
            _ => String(""),
        }
    }

    fun array_context(self, element: String, length: u64) -> String {
        mut ty := String("Array ")
        ty.append(element)
        ty.append(" ")
        ty.append(String(length))
        return ty
    }

    // A method of a `Map` or `Set`. A set is a map to `bool` and shares its operations.
    fun map_method_call(mut self, recv: Lowered, name: String, arguments: Vec<u64>) -> Result<Lowered, String> {
        ty := recv.ty.clone()
        parts := map_parts(ty.clone()).unwrap()
        is_set := ty.starts_with("Set ")
        mut kind := String("Map")
        when is_set {
            kind = String("Set")
        }
        key := parts[0].clone()
        value := parts[1].clone()
        found := methods::map_method(name.clone(), key.clone(), value.clone(), ty.clone())
        when found.is_none() {
            return Result::Err(unsupported("Map method"))
        }
        row := found.unwrap()
        when is_set && !(name == "len" || name == "is_empty" || name == "clear" || name == "contains_key" || name == "contains" || name == "insert" || name == "add" || name == "remove" || name == "clone") {
            return Result::Err(unsupported("Set method"))
        }
        mut params: Vec<String> = row.params.clone()
        mut extra := String("")
        when row.op == "Insert" && value == "Bool" && arguments.len() == 1 {
            params = Vec()
            params.push(key.clone())
            extra = String("Boolean 1")
        }
        mut owning := row.owning
        when is_set {
            owning = 0
        }
        mut ret := row.ret.clone()
        when row.op == "Get" {
            ret = join(words2(String("Enum"), num(self.option_index(value.clone())?)))
        }
        when is_set && row.op == "Insert" {
            ret = String("Bool")
        }
        lowered := self.method_arguments(params, arguments, owning, false)?
        mut tokens: Vec<String> = Vec()
        tokens.push(kind)
        tokens.push(row.op.clone())
        tokens.push(key)
        tokens.push(value)
        mut count: u64 = lowered.len() + 1
        when !extra.is_empty() {
            count += 1
        }
        tokens.push(num(count))
        tokens.push(recv.text)
        for text in lowered {
            tokens.push(text)
        }
        when !extra.is_empty() {
            tokens.push(extra)
        }
        return Result::Ok(Lowered { text: join(tokens), ty: ret })
    }

    fun map_new(self, key: u64, value: u64) -> Result<Lowered, String> {
        key_ty := self.annotation(key)?
        value_ty := self.annotation(value)?
        mut map := String("Map ")
        map.append(key_ty.clone())
        map.append(" ")
        map.append(value_ty.clone())
        return Result::Ok(Lowered { text: join(words5(String("Call"), String("Map"), String("New"), key_ty, join(words3(value_ty, String("0"), map.clone())))), ty: map })
    }

    fun set_new(self, element: u64) -> Result<Lowered, String> {
        element_ty := self.annotation(element)?
        mut set := String("Set ")
        set.append(element_ty.clone())
        set.append(" Bool")
        return Result::Ok(Lowered { text: join(words5(String("Call"), String("Set"), String("New"), element_ty, join(words3(String("Bool"), String("0"), set.clone())))), ty: set })
    }

    // `Vec<T>()`: an empty vector of the element type.
    fun vec_new(self, element: u64, expected: String) -> Result<Lowered, String> {
        word := self.annotation(element)?
        mut vec := String("Vec ")
        vec.append(word.clone())
        when !expected.is_empty() && expected != vec {
            return Result::Err(unsupported("Vec where another type is expected"))
        }
        return Result::Ok(Lowered { text: join(words5(String("Call"), String("Vec"), String("New"), word, join(words2(String("0"), vec.clone())))), ty: vec })
    }

    // The value being indexed. A field read through a reference is borrowed, not copied.
    fun indexed_base(mut self, value: u64) -> Result<Lowered, String> {
        choose self.program.exprs[value] {
            ast::ExprTree::FieldE(inner, name, name_span, span) => self.borrowed_field(inner, name, span),
            _ => self.expression(value, String("")),
        }
    }

    // `values[index]` on a `Vec` (a clone of the element, as `values.index(index)`) or an array.
    fun index_expression(mut self, value: u64, index: u64, expected: String, span: ast::Span) -> Result<Lowered, String> {
        base := self.indexed_base(value)?
        element := vec_element_of(base.ty.clone())
        when element.is_some() {
            mut arguments: Vec<u64> = Vec()
            arguments.push(index)
            mut receiver_value := base
            when receiver_value.text.starts_with("ReferenceField ") {
                receiver_value = Lowered { text: receiver_value.text.slice(0, receiver_value.text.len() - 1).concat("1"), ty: receiver_value.ty.clone() }
            }
            lowered := self.vec_method(receiver_value, element.unwrap(), String("index"), arguments)?
            when !expected.is_empty() && expected != lowered.ty {
                return Result::Err(unsupported("index result type"))
            }
            return Result::Ok(Lowered { text: join(words3(String("Call"), lowered.text, lowered.ty.clone())), ty: lowered.ty })
        }
        when base.ty.starts_with("Slice ") {
            at := self.expression(index, String(""))?
            when !is_integer_word(at.ty.clone()) {
                return Result::Err(unsupported("index type"))
            }
            slice_element := base.ty.slice(6, base.ty.len())
            return Result::Ok(Lowered { text: join(words4(String("SliceIndex"), base.text, at.text, slice_element.clone())), ty: slice_element })
        }
        parts := array_parts(base.ty.clone())
        when parts.is_none() {
            return Result::Err(unsupported("indexing this type"))
        }
        position := self.expression(index, String(""))?
        when !is_integer_word(position.ty.clone()) {
            return Result::Err(unsupported("index type"))
        }
        length := array_length_of(array_parts(base.ty.clone()).unwrap())
        // `R0257`: a literal index that the array has no element for, at the indexing expression.
        literal := self.literal_value(index)
        when literal.is_some() && literal.unwrap() >= length {
            return Result::Err(index_out_of_bounds_error(literal.unwrap(), length, span.start, span.end))
        }
        element_ty := parts.unwrap()[0].clone()
        when !expected.is_empty() && expected != element_ty {
            return Result::Err(unsupported("index result type"))
        }
        return Result::Ok(Lowered { text: join(words5(String("ArrayIndex"), base.text, position.text, element_ty.clone(), num(length))), ty: element_ty })
    }

    // Adds a structure the program did not declare: tuples and ranges are registered when first built.
    fun add_struct(mut self, name: String, field_names: Vec<String>, field_types: Vec<String>, public: u64) -> u64 {
        mut flags: Vec<u64> = Vec()
        for field in field_names.clone() {
            flags.push(public)
        }
        id := self.structs.len()
        self.structs.push(StructInfo { name: name, field_names: field_names, field_types: field_types, field_public: flags, repr_c: 0, derives_clone: 0, derives_hash: 0, drop_name: String(""), module_path: String(""), public: true })
        return id
    }

    // `(a, b, c)`: a structure `$RynTuple#...` of the element types, found or created.
    fun tuple_literal(mut self, elements: Vec<u64>, expected: String) -> Result<Lowered, String> {
        expected_id := struct_id_of(expected.clone())
        when !expected.is_empty() && (expected_id.is_none() || !self.structs[expected_id.unwrap()].name.starts_with("$RynTuple#")) {
            return Result::Err(unsupported("tuple where another type is expected"))
        }
        mut texts: Vec<String> = Vec()
        mut types: Vec<String> = Vec()
        mut position: u64 = 0
        while position < elements.len() {
            mut context := String("")
            when expected_id.is_some() {
                when self.structs[expected_id.unwrap()].field_types.len() != elements.len() {
                    return Result::Err(unsupported("tuple length"))
                }
                context = self.structs[expected_id.unwrap()].field_types[position].clone()
            }
            value := self.moved_expression(elements[position], context)?
            texts.push(value.text)
            types.push(value.ty)
            position += 1
        }
        mut id: u64 = 0
        mut found := false
        when expected_id.is_some() {
            id = expected_id.unwrap()
            found = true
        }
        mut candidate: u64 = 0
        while !found && candidate < self.structs.len() {
            when self.structs[candidate].name.starts_with("$RynTuple#") && self.structs[candidate].field_types.len() == types.len() {
                mut same := true
                mut field: u64 = 0
                while field < types.len() {
                    when self.structs[candidate].field_types[field] != types[field] {
                        same = false
                    }
                    field += 1
                }
                when same {
                    id = candidate
                    found = true
                }
            }
            candidate += 1
        }
        when !found {
            mut names: Vec<String> = Vec()
            mut index: u64 = 0
            while index < types.len() {
                mut field_name := String("_")
                field_name.append(String(index))
                names.push(field_name)
                index += 1
            }
            mut struct_name := String("$RynTuple#inferred")
            struct_name.append(String(self.structs.len()))
            id = self.add_struct(struct_name, names, types.clone(), 0)
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("StructValue"))
        tokens.push(num(id))
        tokens.push(num(texts.len()))
        mut field: u64 = 0
        while field < texts.len() {
            tokens.push(num(field))
            tokens.push(texts[field].clone())
            field += 1
        }
        return Result::Ok(Lowered { text: join(tokens), ty: struct_word(id) })
    }

    // The structure that holds a range of `element` values: `start`, `end`, and `inclusive`.
    fun range_struct_for(mut self, element: String) -> u64 {
        mut candidate: u64 = 0
        while candidate < self.structs.len() {
            info := self.structs[candidate]
            when info.name.starts_with("$RynRange#") && info.field_types.len() == 3 && info.field_types[0] == element && info.field_types[1] == element && info.field_types[2] == "Bool" {
                return candidate
            }
            candidate += 1
        }
        mut names: Vec<String> = Vec()
        names.push(String("start"))
        names.push(String("end"))
        names.push(String("inclusive"))
        mut types: Vec<String> = Vec()
        types.push(element.clone())
        types.push(element)
        types.push(String("Bool"))
        mut struct_name := String("$RynRange#inferred")
        struct_name.append(String(self.structs.len()))
        return self.add_struct(struct_name, names, types, 1)
    }

    // `start..end` or `start..=end`: a value holding the bounds.
    fun range_literal(mut self, start: u64, end: u64, inclusive: bool, expected: String) -> Result<Lowered, String> {
        first := self.expression(start, String(""))?
        when !is_integer_word(first.ty.clone()) {
            return Result::Err(unsupported("range bounds must be integers"))
        }
        last := self.expression(end, first.ty.clone())?
        when last.ty != first.ty {
            return Result::Err(unsupported("range bounds of mixed types"))
        }
        id := self.range_struct_for(first.ty.clone())
        mut bit := String("0")
        when inclusive {
            bit = String("1")
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("StructValue"))
        tokens.push(num(id))
        tokens.push(String("3"))
        tokens.push(String("0"))
        tokens.push(first.text)
        tokens.push(String("1"))
        tokens.push(last.text)
        tokens.push(String("2"))
        tokens.push(join(words2(String("Boolean"), bit)))
        when !expected.is_empty() && expected != struct_word(id) {
            return Result::Err(unsupported("range where another type is expected"))
        }
        return Result::Ok(Lowered { text: join(tokens), ty: struct_word(id) })
    }

    // The size and alignment of a type as the backend lays it out.
    fun type_layout(self, ty: String) -> Vec<u64> {
        mut result: Vec<u64> = Vec()
        when ty == "I8" || ty == "U8" || ty == "Bool" {
            result.push(1)
            result.push(1)
            return result
        }
        when ty == "I16" || ty == "U16" {
            result.push(2)
            result.push(2)
            return result
        }
        when ty == "I32" || ty == "U32" || ty == "F32" || ty == "Char" {
            result.push(4)
            result.push(4)
            return result
        }
        when ty == "Str" || ty.starts_with("Slice ") {
            result.push(16)
            result.push(8)
            return result
        }
        parts := array_parts(ty.clone())
        when parts.is_some() {
            inner := self.type_layout(parts.unwrap()[0].clone())
            width := (inner[0] + inner[1] - 1) / inner[1] * inner[1]
            result.push(width * array_length_of(array_parts(ty).unwrap()))
            result.push(inner[1])
            return result
        }
        id := struct_id_of(ty.clone())
        when id.is_some() {
            mut size: u64 = 0
            mut align: u64 = 1
            mut field: u64 = 0
            while field < self.structs[id.unwrap()].field_types.len() {
                inner := self.type_layout(self.structs[id.unwrap()].field_types[field].clone())
                size = (size + inner[1] - 1) / inner[1] * inner[1] + inner[0]
                when inner[1] > align {
                    align = inner[1]
                }
                field += 1
            }
            result.push((size + align - 1) / align * align)
            result.push(align)
            return result
        }
        result.push(8)
        result.push(8)
        return result
    }

    fun layout_of(self, ty: u64, alignment: bool) -> Result<Lowered, String> {
        word := self.annotation(ty)?
        layout := self.type_layout(word)
        mut value := layout[0]
        when alignment {
            value = layout[1]
        }
        return Result::Ok(Lowered { text: join(words3(String("Integer"), num(value), String("U64"))), ty: String("U64") })
    }

    // `&name`, `&mut name`, or `&raw mut name`: the address of a local.
    fun address_of(mut self, mutable: bool, raw: bool, value: u64, span: ast::Span) -> Result<Lowered, String> {
        choose self.program.exprs[value] {
            ast::ExprTree::NameRef(name, name_span) => self.address_of_local(name, mutable, raw, span, name_span),
            ast::ExprTree::IndexE(slice, position, index_span) => self.slice_element_address(slice, position, span),
            _ => Result::Err(address_operand_error(span.start, span.end)),
        }
    }

    fun address_of_local(mut self, name: String, mutable: bool, raw: bool, span: ast::Span, name_span: ast::Span) -> Result<Lowered, String> {
        found := self.find(name.clone())?
        local := self.locals[found]
        // `R0206`: a mutable reference (not a raw pointer) needs a binding declared `mut`.
        when mutable && !raw && !local.mutable {
            return Result::Err(diagnostic("R0206", name_span.start, name_span.end, String("cannot create a mutable reference to an immutable binding"), String("declare the value with `mut` before borrowing it mutably")))
        }
        // `R0240`: a borrow of a value that an earlier statement moved, at the whole `&` expression.
        when self.is_moved(name.clone()) {
            return Result::Err(moved_value_error(span.start, span.end))
        }
        mut pointer := String("")
        when raw {
            pointer = String("RawPointer ")
            pointer.append(local.ty.clone())
        } else {
            pointer = String("Reference ")
            pointer.append(local.ty.clone())
            when mutable {
                pointer.append(" 1")
            } else {
                pointer.append(" 0")
            }
        }
        self.addressed_types.set(local.slot, local.ty.clone())
        return Result::Ok(Lowered { text: join(words6(String("AddressOf"), num(local.slot), local.ty.clone(), pointer.clone(), num(span.start), num(span.end))), ty: pointer })
    }

    // `&slice[index]`: the address of an element of a borrowed slice.
    fun slice_element_address(mut self, slice: u64, position: u64, span: ast::Span) -> Result<Lowered, String> {
        base := self.expression(slice, String(""))?
        when !base.ty.starts_with("Slice ") {
            return Result::Err(unsupported("address of an element of this type"))
        }
        at := self.expression(position, String(""))?
        when !is_integer_word(at.ty.clone()) {
            return Result::Err(unsupported("index type"))
        }
        element := base.ty.slice(6, base.ty.len())
        mut pointer := String("Reference ")
        pointer.append(element.clone())
        pointer.append(" 0")
        return Result::Ok(Lowered { text: join(words6(String("SliceElementAddress"), base.text, at.text, element, num(span.start), num(span.end))), ty: pointer })
    }

    fun pointee_of(self, pointer: String) -> Result<String, String> {
        when pointer.starts_with("Reference ") {
            return Result::Ok(reference_inner(pointer).unwrap())
        }
        when pointer.starts_with("RawPointer ") {
            return Result::Ok(pointer.slice(11, pointer.len()))
        }
        return Result::Err(unsupported("dereference of this type"))
    }

    // The form a field access has before the guard flattens it: `Field base ...`, kept as written
    // under nodes the guard does not look inside.
    fun field_tree(mut self, index: u64) -> Result<Lowered, String> {
        choose self.program.exprs[index] {
            ast::ExprTree::FieldE(value, name, name_span, span) => self.field_tree_step(value, name, span),
            _ => self.expression(index, String("")),
        }
    }

    fun field_tree_step(mut self, value: u64, name: String, span: ast::Span) -> Result<Lowered, String> {
        base := self.field_tree(value)?
        mut base_ty := base.ty.clone()
        mut through := false
        inner := reference_inner(base.ty.clone())
        when inner.is_some() {
            base_ty = inner.unwrap()
            through = true
        }
        id := struct_id_of(base_ty)
        when id.is_none() {
            return Result::Err(unsupported("field of a value that is not a structure"))
        }
        field := self.field_index(id.unwrap(), name)?
        field_ty := self.structs[id.unwrap()].field_types[field].clone()
        mut tokens: Vec<String> = Vec()
        when through {
            tokens.push(String("ReferenceField"))
        } else {
            tokens.push(String("Field"))
        }
        tokens.push(base.text)
        tokens.push(num(id.unwrap()))
        tokens.push(num(field))
        tokens.push(field_ty.clone())
        tokens.push(num(span.start))
        tokens.push(num(span.end))
        when through {
            when self.borrow_chain {
                tokens.push(String("1"))
            } else {
                tokens.push(String("0"))
            }
        }
        return Result::Ok(Lowered { text: join(tokens), ty: field_ty })
    }

    fun dereference(mut self, pointer: u64) -> Result<Lowered, String> {
        value := self.field_tree(pointer)?
        pointee := self.pointee_of(value.ty.clone())?
        return Result::Ok(Lowered { text: join(words3(String("Dereference"), value.text, pointee.clone())), ty: pointee })
    }

    fun dereference_assign(mut self, pointer: u64, value: u64, span: ast::Span) -> Result<bool, String> {
        target := self.expression(pointer, String(""))?
        // `R0206`: a shared reference is not assigned through.
        when target.ty.starts_with("Reference ") && !reference_is_mutable(target.ty.clone()) {
            return Result::Err(shared_assign_error(span.start, span.end))
        }
        pointee := self.pointee_of(target.ty.clone())?
        stored := self.expression(value, pointee.clone())?
        when stored.ty != pointee {
            return Result::Err(unsupported("assignment through a pointer type"))
        }
        self.statements.push(join(words4(String("DereferenceAssign"), target.text, pointee, stored.text)))
        return Result::Ok(false)
    }

    // A function name used where a function pointer is expected.
    fun function_address(self, name: String, pointer_ty: String) -> Result<Lowered, String> {
        id := self.signature_index(name)?
        parts := function_pointer_parts(pointer_ty.clone())
        when parts.is_none() {
            return Result::Err(unsupported("function pointer type"))
        }
        sigwords := parts.unwrap()
        params := self.signatures[id].params.clone()
        when params.len() + 1 != sigwords.len() {
            return Result::Err(unsupported("function pointer arity"))
        }
        mut position: u64 = 0
        while position < params.len() {
            when params[position] != sigwords[position] {
                return Result::Err(unsupported("function pointer parameter"))
            }
            position += 1
        }
        when self.signatures[id].ret != sigwords[params.len()] {
            return Result::Err(unsupported("function pointer result"))
        }
        return Result::Ok(Lowered { text: join(words3(String("FunctionAddress"), num(id), pointer_ty.clone())), ty: pointer_ty })
    }

    // `callback(arguments)` where `callback` is a local function pointer.
    fun indirect_call(mut self, name: String, arguments: Vec<u64>, span: ast::Span) -> Result<Lowered, String> {
        found := self.find(name)?
        local := self.locals[found]
        sigwords := function_pointer_parts(local.ty.clone()).unwrap()
        when arguments.len() + 1 != sigwords.len() {
            return Result::Err(unsupported("function pointer argument count"))
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("IndirectFunctionPointer"))
        tokens.push(local.ty.clone())
        tokens.push(num(arguments.len() + 1))
        tokens.push(join(words5(String("Local"), num(local.slot), local.ty.clone(), num(span.start), num(span.end))))
        mut position: u64 = 0
        while position < arguments.len() {
            value := self.moved_expression(arguments[position], sigwords[position].clone())?
            when value.ty != sigwords[position] {
                return Result::Err(unsupported("function pointer argument type"))
            }
            tokens.push(value.text)
            position += 1
        }
        result_at := arguments.len()
        return Result::Ok(Lowered { text: join(tokens), ty: sigwords[result_at].clone() })
    }

    // `[a, b, c]`: the element type is the expected one, else the first element's.
    fun array_literal(mut self, elements: Vec<u64>, expected: String) -> Result<Lowered, String> {
        mut element_ty := String("")
        mut length: u64 = elements.len()
        mut first_text := String("")
        mut start: u64 = 0
        mut texts: Vec<String> = Vec()
        expected_parts := array_parts(expected.clone())
        when !expected.is_empty() && expected_parts.is_none() {
            return Result::Err(unsupported("array where another type is expected"))
        }
        when expected_parts.is_some() {
            element_ty = expected_parts.unwrap()[0].clone()
            when array_length_of(array_parts(expected.clone()).unwrap()) != elements.len() {
                return Result::Err(unsupported("array length"))
            }
        } else {
            when elements.is_empty() {
                return Result::Err(unsupported("empty array without a type"))
            }
            first := self.moved_expression(elements[0], String(""))?
            element_ty = first.ty.clone()
            texts.push(first.text)
            start = 1
        }
        mut position: u64 = start
        while position < elements.len() {
            value := self.moved_expression(elements[position], element_ty.clone())?
            when value.ty != element_ty {
                return Result::Err(unsupported("array element type"))
            }
            texts.push(value.text)
            position += 1
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("ArrayValue"))
        tokens.push(num(texts.len()))
        for text in texts {
            tokens.push(text)
        }
        mut ty := String("Array ")
        ty.append(element_ty)
        ty.append(" ")
        ty.append(String(length))
        return Result::Ok(Lowered { text: join(tokens), ty: ty })
    }

    // `[value; length]`: one evaluated element copied `length` times.
    // `[value; length]`. The bootstrap checks, in order: the expected array's length (`R0240`), the element's
    // type against the expected element type (`R0205`), and whether the element can be copied (`R0256`).
    fun array_repeat(mut self, value: u64, length: u64, span: ast::Span, expected: String) -> Result<Lowered, String> {
        mut element_ty := String("")
        expected_parts := array_parts(expected.clone())
        when !expected.is_empty() && expected_parts.is_none() {
            found := repeat_type_error(expected.clone(), span.start, span.end)
            when found.is_some() {
                return Result::Err(found.unwrap())
            }
            return Result::Err(unsupported("array where another type is expected"))
        }
        when expected_parts.is_some() {
            element_ty = expected_parts.unwrap()[0].clone()
            expected_length := array_length_of(array_parts(expected.clone()).unwrap())
            when expected_length != length {
                return Result::Err(repeat_length_error(length, expected_length, span.start, span.end))
            }
        }
        element_result := self.moved_expression(value, element_ty.clone())
        when element_result.is_err() {
            refusal := element_result.unwrap_err()
            when element_ty.is_empty() {
                return Result::Err(refusal)
            }
            other := self.other_type_of(value, element_ty.clone(), refusal.clone())
            when other.is_some() {
                found := element_type_error(element_ty.clone(), other.unwrap(), self.expr_span_of(value))
                when found.is_some() {
                    return Result::Err(found.unwrap())
                }
            }
            return Result::Err(refusal)
        }
        element := element_result.unwrap()
        when !element_ty.is_empty() && element.ty != element_ty {
            found := element_type_error(element_ty.clone(), element.ty.clone(), self.expr_span_of(value))
            when found.is_some() {
                return Result::Err(found.unwrap())
            }
            return Result::Err(unsupported("array element type"))
        }
        when element.ty == "OwnedString" {
            return Result::Err(repeat_copy_error("String", span.start, span.end))
        }
        when enum_id_of(element.ty.clone()).is_some() {
            return Result::Err(repeat_copy_error("enum", span.start, span.end))
        }
        when is_collection_word(element.ty.clone()) {
            return Result::Err(unsupported("array repeat of a collection"))
        }
        mut ty := String("Array ")
        ty.append(element.ty.clone())
        ty.append(" ")
        ty.append(String(length))
        return Result::Ok(Lowered { text: join(words3(String("ArrayRepeat"), element.text, num(length))), ty: ty })
    }

    // `name[index] = value`: stores into one element of an array local.
    fun index_assign(mut self, name: String, index: u64, value: u64, span: ast::Span) -> Result<bool, String> {
        found := self.find(name.clone())?
        local := self.locals[found]
        when !local.mutable {
            return Result::Err(immutable_binding(name, span.start, span.end, "to assign an array element"))
        }
        parts := array_parts(local.ty.clone())
        when parts.is_none() {
            return Result::Err(unsupported("indexed assignment to this type"))
        }
        element := parts.unwrap()[0].clone()
        length := array_length_of(array_parts(local.ty.clone()).unwrap())
        position := self.expression(index, String(""))?
        when !is_integer_word(position.ty.clone()) {
            return Result::Err(unsupported("index type"))
        }
        stored := self.moved_expression(value, element.clone())?
        when stored.ty != element {
            return Result::Err(unsupported("array element type"))
        }
        mut tokens: Vec<String> = Vec()
        tokens.push(String("ArrayAssign"))
        tokens.push(num(local.slot))
        tokens.push(element)
        tokens.push(num(length))
        tokens.push(position.text)
        tokens.push(stored.text)
        tokens.push(num(span.start))
        tokens.push(num(span.end))
        self.statements.push(join(tokens))
        return Result::Ok(false)
    }

    // `for name in range`: two loops, one for each kind of bound, chosen when the loop starts.
    fun range_foreach(mut self, id: u64, lowered: Lowered, vector_slot: u64, item_slot: u64, item_ty: String, name: String, name_span: ast::Span, collection_span: ast::Span, body: Vec<u64>) -> Result<bool, String> {
        visible_before := self.visible
        self.declare(Local { name: String(" sequence"), slot: vector_slot, ty: lowered.ty.clone(), mutable: false })
        self.loop_depth += 1
        self.loop_floors.push(self.visible)
        self.loop_frames.push(self.frame_marks.len())
        body_block := self.block_with(String("@item"), name, item_slot, item_ty.clone(), body)?
        self.loop_frames.pop()
        self.loop_floors.pop()
        self.loop_depth -= 1
        cursor_slot := self.allocate(item_ty.clone())?
        cursor_end_slot := self.allocate(item_ty.clone())?
        item_let := join(words6(String("Let"), num(item_slot), item_ty.clone(), join(words5(String("Local"), num(cursor_slot), item_ty.clone(), num(collection_span.start), num(collection_span.end))), num(name_span.start), num(name_span.end)))
        mut loop_items: Vec<String> = Vec()
        for item in body_block.items {
            when item == "@item" {
                loop_items.push(item_let.clone())
            } else {
                loop_items.push(item)
            }
        }
        view := join(words5(String("Local"), num(vector_slot), lowered.ty.clone(), num(collection_span.start), num(collection_span.end)))
        start_field := join(words5(String("Local"), num(vector_slot + self.field_offset(id, 0)), item_ty.clone(), num(collection_span.start), num(collection_span.end)))
        end_field := join(words5(String("Local"), num(vector_slot + self.field_offset(id, 1)), item_ty.clone(), num(collection_span.start), num(collection_span.end)))
        flag_field := join(words5(String("Local"), num(vector_slot + self.field_offset(id, 2)), String("Bool"), num(collection_span.start), num(collection_span.end)))
        inclusive_loop := self.range_loop(cursor_slot, cursor_end_slot, item_ty.clone(), start_field.clone(), end_field.clone(), true, loop_items.clone())
        exclusive_loop := self.range_loop(cursor_slot, cursor_end_slot, item_ty.clone(), start_field, end_field, false, loop_items)
        mut branch: Vec<String> = Vec()
        branch.push(String("IfStatement"))
        branch.push(flag_field)
        branch.push(String("2"))
        branch.push(inclusive_loop)
        branch.push(String("Drop 0"))
        branch.push(String("2"))
        branch.push(exclusive_loop)
        branch.push(String("Drop 0"))
        scope_drop := self.owned_drop(visible_before)
        self.visible = visible_before
        mut items: Vec<String> = Vec()
        items.push(join(words6(String("Let"), num(vector_slot), lowered.ty.clone(), lowered.text, num(collection_span.start), num(collection_span.end))))
        items.push(join(branch))
        items.push(scope_drop)
        self.statements.push(join(block_of(items)))
        return Result::Ok(false)
    }

    fun range_loop(self, cursor: u64, cursor_end: u64, ty: String, start: String, end: String, inclusive: bool, body: Vec<String>) -> String {
        mut tokens: Vec<String> = Vec()
        tokens.push(String("For"))
        tokens.push(num(cursor))
        tokens.push(num(cursor_end))
        tokens.push(ty)
        tokens.push(start)
        tokens.push(end)
        when inclusive {
            tokens.push(String("1"))
        } else {
            tokens.push(String("0"))
        }
        tokens.push(num(body.len()))
        for item in body {
            tokens.push(item)
        }
        return join(tokens)
    }

    // `for name in collection { body }` over a `Vec`, a `String`, or a `str`. The collection is
    // moved into a hidden local; a counter walks it and the item is read from it each time.
    fun foreach_statement(mut self, name: String, name_span: ast::Span, collection: u64, body: Vec<u64>) -> Result<bool, String> {
        when self.declared(name.clone()) {
            return Result::Err(collection_loop_redeclared(name, name_span.start, name_span.end))
        }
        collection_span := expr_span(self.program.exprs[collection])
        lowered := self.moved_expression(collection, String(""))?
        mut item_ty := String("")
        mut length := String("")
        mut take := String("")
        element := vec_element_of(lowered.ty.clone())
        range_id := struct_id_of(lowered.ty.clone())
        mut is_range := false
        when range_id.is_some() && self.structs[range_id.unwrap()].name.starts_with("$RynRange#") {
            is_range = true
        }
        when element.is_some() {
            item_ty = element.unwrap()
        } else when lowered.ty == "OwnedString" || lowered.ty == "Str" {
            item_ty = String("Char")
        } else when is_range {
            item_ty = self.structs[range_id.unwrap()].field_types[0].clone()
        } else when lowered.ty.starts_with("Slice ") {
            item_ty = lowered.ty.slice(6, lowered.ty.len())
        } else {
            found := iterable_error(lowered.ty.clone(), collection_span.start, collection_span.end)
            when found.is_some() {
                return Result::Err(found.unwrap())
            }
            return Result::Err(unsupported("iterating this type"))
        }
        vector_slot := self.allocate(lowered.ty.clone())?
        index_slot := self.allocate(String("U64"))?
        end_slot := self.allocate(String("U64"))?
        item_slot := self.allocate(item_ty.clone())?
        view := join(words5(String("Local"), num(vector_slot), lowered.ty.clone(), num(collection_span.start), num(collection_span.end)))
        when is_range {
            return self.range_foreach(range_id.unwrap(), lowered, vector_slot, item_slot, item_ty, name, name_span, collection_span, body)
        }
        counter := join(words5(String("Local"), num(index_slot), String("U64"), num(collection_span.start), num(collection_span.end)))
        when lowered.ty == "OwnedString" {
            length = join(words5(String("Call"), String("String"), String("CharCount"), String("1"), join(words2(view.clone(), String("U64")))))
            take = join(words6(String("Call"), String("String"), String("CharAt"), String("2"), view.clone(), join(words2(counter, String("Char")))))
        } else when lowered.ty == "Str" {
            length = join(words5(String("Call"), String("String"), String("StrCharCount"), String("1"), join(words2(view.clone(), String("U64")))))
            take = join(words6(String("Call"), String("String"), String("StrCharAt"), String("2"), view.clone(), join(words2(counter, String("Char")))))
        } else when lowered.ty.starts_with("Slice ") {
            length = join(words5(String("Call"), String("SliceLen"), String("1"), view.clone(), String("U64")))
            take = join(words4(String("SliceIndex"), view.clone(), counter.clone(), item_ty.clone()))
        } else {
            length = join(words6(String("Call"), String("Vec"), String("Len"), item_ty.clone(), String("1"), join(words2(view.clone(), String("U64")))))
            take = join(words6(String("Call"), String("Vec"), String("Take"), item_ty.clone(), String("2"), join(words3(view.clone(), String("Integer 0 U64"), item_ty.clone()))))
        }
        item_let := join(words6(String("Let"), num(item_slot), item_ty.clone(), take, num(name_span.start), num(name_span.end)))
        visible_before := self.visible
        self.declare(Local { name: String(" sequence"), slot: vector_slot, ty: lowered.ty.clone(), mutable: false })
        self.loop_depth += 1
        self.loop_floors.push(self.visible)
        self.loop_frames.push(self.frame_marks.len())
        // The moves of the loop header (a condition or a collection) happen before the first iteration.
        self.commit_moves()
        loop_before := self.moved_names.clone()
        outer_breaks := self.break_moves.clone()
        outer_continues := self.continue_moves.clone()
        self.break_moves = Vec()
        self.continue_moves = Vec()
        body_block := self.block_with(item_let, name, item_slot, item_ty.clone(), body)?
        loop_error := self.loop_move_error(loop_before.clone(), body_block.falls, self.continue_moves.clone())
        when loop_error.is_some() {
            return Result::Err(loop_error.unwrap())
        }
        exits := self.visible_moves(self.break_moves.clone())
        self.break_moves = outer_breaks
        self.continue_moves = outer_continues
        self.moved_names = union_moves(loop_before, exits)
        self.loop_frames.pop()
        self.loop_floors.pop()
        self.loop_depth -= 1
        mut tokens: Vec<String> = Vec()
        tokens.push(String("For"))
        tokens.push(num(index_slot))
        tokens.push(num(end_slot))
        tokens.push(String("U64"))
        tokens.push(String("Integer 0 U64"))
        tokens.push(length)
        tokens.push(String("0"))
        tokens.push(num(body_block.items.len()))
        for item in body_block.items {
            tokens.push(item)
        }
        scope_drop := self.owned_drop(visible_before)
        self.visible = visible_before
        mut items: Vec<String> = Vec()
        items.push(join(words6(String("Let"), num(vector_slot), lowered.ty.clone(), lowered.text, num(collection_span.start), num(collection_span.end))))
        items.push(join(tokens))
        items.push(scope_drop)
        self.statements.push(join(block_of(items)))
        return Result::Ok(false)
    }
}

// The type a `try_to_<type>` method parses to, as its index in the parse tables.
fun try_parse_type(word: String) -> Option<u64> {
    mut names: Vec<String> = Vec()
    names.push(String("i8"))
    names.push(String("i16"))
    names.push(String("i32"))
    names.push(String("i64"))
    names.push(String("u8"))
    names.push(String("u16"))
    names.push(String("u32"))
    names.push(String("u64"))
    names.push(String("f32"))
    names.push(String("f64"))
    mut index: u64 = 0
    while index < names.len() {
        when names[index] == word {
            return Option::Some(index)
        }
        index += 1
    }
    return Option::None
}

fun try_parse_word(tag: u64) -> String {
    primitive := ryn_preamble_words()
    return primitive[tag].clone()
}

// The position of the last `separator` in `text`, if any.
fun last_index_of(text: String, separator: String) -> Option<u64> {
    when separator.len() > text.len() {
        return Option::None
    }
    mut at: u64 = text.len() - separator.len() + 1
    while at > 0 {
        at -= 1
        when text.slice(at, at + separator.len()) == separator {
            return Option::Some(at)
        }
    }
    return Option::None
}

// Whether the internal name of a generated enum belongs to the generic enum `requested`.
fun is_generic_enum_name(internal: String, requested: String) -> bool {
    when requested == "Option" {
        return internal.starts_with("$RynOption#")
    }
    when requested == "Result" {
        return internal.starts_with("$RynResult#")
    }
    when !internal.starts_with("$RynEnum#") {
        return false
    }
    rest := internal.slice(9, internal.len())
    hash := last_index_of(rest.clone(), String("#"))
    when hash.is_none() {
        return false
    }
    template := rest.slice(0, hash.unwrap())
    when template == requested {
        return true
    }
    colons := last_index_of(template.clone(), String("::"))
    when colons.is_none() {
        return false
    }
    return template.slice(colons.unwrap() + 2, template.len()) == requested
}

extend Lowering {
    fun has_variant(self, id: u64, name: String) -> bool {
        mut variant: u64 = 0
        while variant < self.enums[id].variant_names.len() {
            when self.enums[id].variant_names[variant] == name {
                return true
            }
            variant += 1
        }
        return false
    }

    // The type of the first field of the variant called `name`.
    fun variant_payload(self, id: u64, name: String) -> Result<String, String> {
        variant := self.variant_index(id, name)?
        when self.enums[id].variant_counts[variant] == 0 {
            return Result::Err(unsupported("variant without a payload"))
        }
        return Result::Ok(self.enums[id].field_types[self.variant_field_start(id, variant)].clone())
    }

    // `is_some`, `unwrap`, `unwrap_or`, and the like, on an `Option` or `Result` receiver.
    fun enum_method(mut self, recv: Lowered, id: u64, name: String, arguments: Vec<u64>) -> Result<Lowered, String> {
        is_option := self.has_variant(id, String("Some")) && self.has_variant(id, String("None"))
        is_result := self.has_variant(id, String("Ok")) && self.has_variant(id, String("Err"))
        mut predicate := String("")
        when is_option && name == "is_some" {
            predicate = String("IsSome")
        } else when is_option && name == "is_none" {
            predicate = String("IsNone")
        } else when is_result && name == "is_ok" {
            predicate = String("IsOk")
        } else when is_result && name == "is_err" {
            predicate = String("IsErr")
        }
        when !predicate.is_empty() {
            when !arguments.is_empty() {
                return Result::Err(unsupported("predicate arguments"))
            }
            return Result::Ok(Lowered { text: join(words5(String("EnumPredicate"), predicate, num(id), String("1"), recv.text)), ty: String("Bool") })
        }
        generated := self.enums[id].name.starts_with("$RynOption#") || self.enums[id].name.starts_with("$RynResult#")
        mut success := String("Some")
        when self.enums[id].name.starts_with("$RynResult#") {
            success = String("Ok")
        }
        when generated && name == "unwrap_or" {
            when arguments.len() != 1 {
                return Result::Err(unsupported("unwrap_or arguments"))
            }
            value_type := self.variant_payload(id, success)?
            default := self.expression(arguments[0], value_type.clone())?
            when default.ty != value_type {
                return Result::Err(unsupported("unwrap_or default type"))
            }
            mut default_text := default.text
            when value_type == "OwnedString" {
                default_text = join(words5(String("Call"), String("String"), String("Clone"), String("1"), join(words2(default_text, String("OwnedString")))))
            }
            return Result::Ok(Lowered { text: join(words6(String("EnumUnwrapOr"), num(id), value_type.clone(), String("2"), recv.text, default_text)), ty: value_type })
        }
        when (is_option && (name == "unwrap" || name == "expect")) || (is_result && (name == "unwrap" || name == "expect" || name == "unwrap_err")) {
            takes_message := name == "expect"
            mut success_name := String("Some")
            when name == "unwrap_err" {
                success_name = String("Err")
            } else when is_result {
                success_name = String("Ok")
            }
            mut failure := String("OptionUnwrapFailed")
            when takes_message {
                failure = String("OptionExpectFailed")
            } else when is_result {
                failure = String("ResultUnwrapFailed")
            }
            when arguments.len() != 0 && !takes_message || arguments.len() != 1 && takes_message {
                return Result::Err(unsupported("unwrap arguments"))
            }
            success_tag := self.variant_index(id, success_name.clone())?
            value_type := self.variant_payload(id, success_name)?
            mut tokens: Vec<String> = Vec()
            tokens.push(String("EnumUnwrap"))
            tokens.push(num(id))
            tokens.push(value_type.clone())
            mut flag := String("0")
            when takes_message {
                flag = String("1")
            }
            tokens.push(flag)
            tokens.push(num(success_tag))
            tokens.push(failure)
            when takes_message {
                tokens.push(String("2"))
                tokens.push(recv.text)
                message := self.expression(arguments[0], String("Str"))?
                when message.ty != "Str" {
                    return Result::Err(unsupported("expect message"))
                }
                tokens.push(message.text)
            } else {
                tokens.push(String("1"))
                tokens.push(recv.text)
            }
            return Result::Ok(Lowered { text: join(tokens), ty: value_type })
        }
        return Result::Err(unsupported("enum method"))
    }

    // `value?`: on `Err` or `None` the function returns early after its pending `defer` bodies.
    fun propagate(mut self, value: u64, span: ast::Span) -> Result<Lowered, String> {
        deferred := self.run_defers(self.frame_start(0))?
        lowered := self.moved_expression(value, String(""))?
        input := enum_id_of(lowered.ty.clone())
        when input.is_none() {
            // `R0234`: a scalar is not an `Option` or `Result`; other values that are not enums are declined.
            when scalar_type_name(lowered.ty.clone()).is_some() {
                return Result::Err(propagate_operand_error(span.start, span.end))
            }
            return Result::Err(unsupported("? on a value that is not an enum"))
        }
        input_id := input.unwrap()
        is_option := self.enums[input_id].name.starts_with("$RynOption#")
        // `R0234`: `?` applies to `Option` and `Result` only, and the function must return the same family.
        when !is_option && !self.enums[input_id].name.starts_with("$RynResult#") {
            return Result::Err(propagate_operand_error(span.start, span.end))
        }
        output := enum_id_of(self.return_ty.clone())
        when output.is_none() {
            return Result::Err(propagate_return_error(span.start, span.end))
        }
        output_id := output.unwrap()
        when is_option && !self.enums[output_id].name.starts_with("$RynOption#") {
            return Result::Err(propagate_family_error(span.start, span.end))
        }
        when !is_option && !self.enums[output_id].name.starts_with("$RynResult#") {
            return Result::Err(propagate_family_error(span.start, span.end))
        }
        mut success_name := String("Ok")
        mut failure_name := String("Err")
        when is_option {
            success_name = String("Some")
            failure_name = String("None")
        }
        success_type := self.variant_payload(input_id, success_name.clone())?
        success_variant := self.variant_index(input_id, success_name)?
        failure_variant := self.variant_index(input_id, failure_name.clone())?
        output_failure_variant := self.variant_index(output_id, failure_name.clone())?
        mut tokens: Vec<String> = Vec()
        tokens.push(String("Propagate"))
        tokens.push(lowered.text)
        tokens.push(num(input_id))
        tokens.push(num(output_id))
        tokens.push(success_type.clone())
        when is_option {
            tokens.push(String("-"))
        } else {
            tokens.push(String("+"))
            tokens.push(self.variant_payload(input_id, failure_name)?)
        }
        tokens.push(num(success_variant))
        tokens.push(num(failure_variant))
        tokens.push(num(output_failure_variant))
        // The guard checks the deferred bodies as a block, which ends with the drop of its scope.
        tokens.push(num(deferred.len() + 1))
        for item in deferred {
            tokens.push(item)
        }
        tokens.push(self.owned_drop(self.scope_floor()))
        return Result::Ok(Lowered { text: join(tokens), ty: success_type })
    }

    // `value |> target`: the target function called with `value` as its first argument.
    fun pipe_expression(mut self, value: u64, target: u64, expected: String) -> Result<Lowered, String> {
        mut arguments: Vec<u64> = Vec()
        arguments.push(value)
        choose self.program.exprs[target] {
            ast::ExprTree::NameRef(name, span) => self.call(name, Vec(), arguments, expected, ast::Span { start: 0, end: 0 }, false),
            ast::ExprTree::CallE(name, type_arguments, rest, span) => self.pipe_call(name, type_arguments, arguments, rest, expected),
            _ => Result::Err(unsupported("pipe target")),
        }
    }

    fun pipe_call(mut self, name: String, type_arguments: Vec<u64>, first: Vec<u64>, rest: Vec<u64>, expected: String) -> Result<Lowered, String> {
        mut arguments: Vec<u64> = first
        for argument in rest {
            arguments.push(argument)
        }
        return self.call(name, type_arguments, arguments, expected, ast::Span { start: 0, end: 0 }, false)
    }

    // The `Some` and `None` arms of an `Option` choose that the `??` and `?.` forms stand for.
    // `bound` names the payload; `some_body` and `none_body` lower each arm's value.
    fun option_arms_header(mut self, value: u64) -> Result<Lowered, String> {
        scrutinee := self.moved_expression(value, String(""))?
        id := enum_id_of(scrutinee.ty.clone())
        when id.is_none() || !self.has_variant(id.unwrap(), String("Some")) {
            return Result::Err(unsupported("?? or ?. on a value that is not an Option"))
        }
        return Result::Ok(scrutinee)
    }

    // `value ?? fallback`: the payload of `Some`, else the fallback, which is lowered only in its arm.
    fun coalesce_expression(mut self, value: u64, fallback: u64, span: ast::Span) -> Result<Lowered, String> {
        scrutinee := self.moved_expression(value, String(""))?
        // The bootstrap desugars `??` into a `choose`, which reports a scalar left side as `R0234`.
        when enum_id_of(scrutinee.ty.clone()).is_none() && scalar_type_name(scrutinee.ty.clone()).is_some() {
            return Result::Err(choose_enum_error(span.start, span.end))
        }
        when enum_id_of(scrutinee.ty.clone()).is_none() || !self.has_variant(enum_id_of(scrutinee.ty.clone()).unwrap(), String("Some")) {
            return Result::Err(unsupported("?? or ?. on a value that is not an Option"))
        }
        id := enum_id_of(scrutinee.ty.clone()).unwrap()
        payload := self.variant_payload(id, String("Some"))?
        some_tag := self.variant_index(id, String("Some"))?
        none_tag := self.variant_index(id, String("None"))?
        visible_before := self.visible
        slot := self.allocate(payload.clone())?
        self.declare(Local { name: String("$coalesce"), slot: slot, ty: payload.clone(), mutable: false })
        mut body := join(words5(String("Local"), num(slot), payload.clone(), num(span.start), num(span.end)))
        when self.owns(payload.clone()) {
            body = join(words3(String("Move"), num(slot), payload.clone()))
        }
        self.visible = visible_before
        fallback_value := self.moved_expression(fallback, payload.clone())?
        when fallback_value.ty != payload {
            return Result::Err(unsupported("?? fallback type"))
        }
        mut arms: Vec<String> = Vec()
        arms.push(String("+"))
        arms.push(num(some_tag))
        arms.push(String("1"))
        arms.push(num(slot))
        arms.push(payload.clone())
        arms.push(String("0"))
        arms.push(body)
        arms.push(String("+"))
        arms.push(num(none_tag))
        arms.push(String("0"))
        arms.push(fallback_value.text)
        return Result::Ok(Lowered { text: join(choose_tokens(scrutinee.text, id, 2, arms, payload.clone())), ty: payload })
    }

    // `value?.name`: the field of the `Some` payload wrapped in an `Option` again, else `None`.
    fun optional_field_expression(mut self, value: u64, name: String, name_span: ast::Span) -> Result<Lowered, String> {
        scrutinee := self.option_arms_header(value)?
        id := enum_id_of(scrutinee.ty.clone()).unwrap()
        payload := self.variant_payload(id, String("Some"))?
        some_tag := self.variant_index(id, String("Some"))?
        none_tag := self.variant_index(id, String("None"))?
        visible_before := self.visible
        slot := self.allocate(payload.clone())?
        base := Place { slot: slot, ty: payload.clone(), mutable: false }
        place := self.field_step(base, name)?
        mut field_value := join(words5(String("Local"), num(place.slot), place.ty.clone(), num(name_span.start), num(name_span.end)))
        when self.owns(place.ty.clone()) {
            field_value = join(words3(String("Move"), num(place.slot), place.ty.clone()))
        }
        wrapper := self.option_enum_for(place.ty.clone())
        wrapped_type := join(words2(String("Enum"), num(wrapper)))
        some_tag_wrapped := self.variant_index(wrapper, String("Some"))?
        none_tag_wrapped := self.variant_index(wrapper, String("None"))?
        self.visible = visible_before
        mut arms: Vec<String> = Vec()
        arms.push(String("+"))
        arms.push(num(some_tag))
        arms.push(String("1"))
        arms.push(num(slot))
        arms.push(payload.clone())
        arms.push(String("0"))
        arms.push(join(words6(String("Call"), String("EnumNew"), num(wrapper), num(some_tag_wrapped), String("1"), join(words2(field_value, wrapped_type.clone())))))
        arms.push(String("+"))
        arms.push(num(none_tag))
        arms.push(String("0"))
        arms.push(join(words6(String("Call"), String("EnumNew"), num(wrapper), num(none_tag_wrapped), String("0"), wrapped_type.clone())))
        return Result::Ok(Lowered { text: join(choose_tokens(scrutinee.text, id, 2, arms, wrapped_type.clone())), ty: wrapped_type })
    }
}

fun operator_method_name(op: String) -> String {
    when op == "Add" {
        return String("add")
    }
    when op == "Sub" {
        return String("sub")
    }
    when op == "Mul" {
        return String("mul")
    }
    when op == "Div" {
        return String("div")
    }
    when op == "Rem" {
        return String("rem")
    }
    return String("")
}

// Positions of the span in the words of a lowered `Local slot type start end`.
fun recv_span_start() -> u64 {
    return 3
}

fun recv_span_end() -> u64 {
    return 4
}

// The segments of a module path joined with `::`.
fun join_path(parts: Vec<String>) -> String {
    mut out := String("")
    mut first := true
    for part in parts {
        when !first {
            out.append("::")
        }
        out.append(part)
        first = false
    }
    return out
}

// Everything before the last `::`, or "" when the name has none.
fun prefix_of(name: String) -> String {
    cut := last_index_of(name.clone(), String("::"))
    when cut.is_none() {
        return String("")
    }
    return name.slice(0, cut.unwrap())
}

// The source span of a statement node.
fun stmt_span(node: ast::Stmt) -> ast::Span {
    choose node {
        ast::Stmt::LetS(a, b, c, d, s) => s,
        ast::Stmt::AssignS(a, b, s) => s,
        ast::Stmt::IndexAssignS(a, b, c, s) => s,
        ast::Stmt::DerefAssignS(a, b, s) => s,
        ast::Stmt::FieldAssignS(a, b, c, d, e, s) => s,
        ast::Stmt::CompoundS(a, b, c, s) => s,
        ast::Stmt::PrintS(a, s) => s,
        ast::Stmt::TemplateS(a, s) => s,
        ast::Stmt::CallS(a, b, c, s) => s,
        ast::Stmt::MethodCallS(a, b, c, s) => s,
        ast::Stmt::IfS(a, b, c, s) => s,
        ast::Stmt::WhileS(a, b, s) => s,
        ast::Stmt::DeferS(a, s) => s,
        ast::Stmt::ForS(a, b, c, d, e, f, s) => s,
        ast::Stmt::ForEachS(a, b, c, d, s) => s,
        ast::Stmt::BreakS(s) => s,
        ast::Stmt::ContinueS(s) => s,
        ast::Stmt::ReturnS(a, s) => s,
    }
}

// `R0450`: each structure that an `extend ... as Shape` block names must conform to the shape, as the bootstrap's conformance
// check reads it. The first error in program order is reported. A case this check does not cover is declined (`unsupported`):
// a generic structure, a shape with other than one method, a shape parameter or return type that is not a builtin word, a
// parameter or return type of a method that is not a builtin word, and any program without `main`, which the bootstrap reports first.
extend Lowering {
    fun shape_conformance(self) -> Option<String> {
        mut has_main := false
        for index in self.program.functions.clone() {
            when self.program.function_defs[index].name == "main" {
                has_main = true
            }
        }
        when !has_main {
            return Option::Some(unsupported("program without main"))
        }
        for index in self.program.extends.clone() {
            record := self.program.extend_defs[index]
            when record.as_shape.is_some() {
                shape_name := record.as_shape.unwrap()
                structure := self.shape_type_name(record.type_name)
                outcome := self.conformance(structure, shape_name)
                when outcome.is_err() {
                    return Option::Some(outcome.unwrap_err())
                }
                message := outcome.unwrap()
                when message.is_some() {
                    return Option::Some(diagnostic("R0450", record.span.start, record.span.end, message.unwrap(), String("")))
                }
            }
        }
        return Option::None
    }

    // The bounds of a function, as the bootstrap's `prepare_function` checks them: `R0452` for a bound that names an
    // undeclared shape, then `R0450` when a structure that the bound names does not conform to one of its shapes. A bound
    // names the concrete type a generic function was specialized for; a name that is not a structure is not checked.
    fun bound_conformance(self, id: u64) -> Option<String> {
        definition := self.program.function_defs[self.program.functions[id]]
        for bound_index in definition.type_parameter_bounds.clone() {
            bound := self.program.bounds[bound_index]
            for shape_name in bound.traits.clone() {
                mut known := false
                for shape_index in self.program.shapes.clone() {
                    when self.program.shape_defs[shape_index].name == shape_name {
                        known = true
                    }
                }
                when !known {
                    mut message := String("unknown shape `")
                    message.append(shape_name)
                    message.append("` in the bound on `")
                    message.append(bound.name.clone())
                    message.append("`")
                    return Option::Some(diagnostic("R0452", definition.span.start, definition.span.end, message, String("declare the shape with `shape Name { ... }` before using it as a bound")))
                }
            }
            mut struct_known := false
            for structure_index in self.program.structs.clone() {
                when self.program.struct_defs[structure_index].name == bound.name {
                    struct_known = true
                }
            }
            when !struct_known {
                // The bootstrap also looks the name up as `namespace::name`; only a structure with that suffix can match.
                mut suffix := String("::")
                suffix.append(bound.name.clone())
                mut namespaced := false
                for structure_index in self.program.structs.clone() {
                    when self.program.struct_defs[structure_index].name.ends_with(suffix.clone()) {
                        namespaced = true
                    }
                }
                when namespaced {
                    return Option::Some(unsupported("bound that may name a namespaced structure"))
                }
                continue
            }
            for shape_name in bound.traits.clone() {
                outcome := self.conformance(bound.name.clone(), shape_name.clone())
                when outcome.is_err() {
                    return Option::Some(outcome.unwrap_err())
                }
                message := outcome.unwrap()
                when message.is_some() {
                    mut help := String("structural conformance checks `")
                    help.append(bound.name.clone())
                    help.append("` against `")
                    help.append(shape_name)
                    help.append("` at the call site")
                    return Option::Some(diagnostic("R0450", definition.span.start, definition.span.end, message.unwrap(), help))
                }
            }
        }
        return Option::None
    }

    // The message of the first conformance error of a structure against a shape, or nothing. A case the check does not cover
    // is declined (`unsupported`), so the frontend compares nothing.
    fun conformance(self, structure: String, shape_name: String) -> Result<Option<String>, String> {
        mut found_structure := false
        mut structure_index: u64 = 0
        mut position: u64 = 0
        while position < self.program.structs.len() {
            candidate := self.program.structs[position]
            when self.program.struct_defs[candidate].name == structure {
                found_structure = true
                structure_index = candidate
            }
            position += 1
        }
        when !found_structure {
            return Result::Err(unsupported("extend of an unknown structure"))
        }
        definition := self.program.struct_defs[structure_index]
        when !definition.type_parameters.is_empty() {
            return Result::Err(unsupported("structure with generics"))
        }
        mut found_shape := false
        mut shape_index: u64 = 0
        position = 0
        while position < self.program.shapes.len() {
            candidate := self.program.shapes[position]
            when self.program.shape_defs[candidate].name == shape_name {
                found_shape = true
                shape_index = candidate
            }
            position += 1
        }
        when !found_shape {
            return Result::Err(unsupported("extend as an unknown shape"))
        }
        contract := self.program.shape_defs[shape_index]
        mut failure: Option<String> = Option::None
        mut failures: u64 = 0
        for method_index in contract.methods.clone() {
            method := self.program.shape_methods[method_index]
            outcome := self.method_conformance(structure.clone(), shape_name.clone(), !definition.module_path.is_empty(), method)
            when outcome.is_err() {
                return outcome
            }
            message := outcome.unwrap()
            when message.is_some() {
                failures += 1
                failure = message
            }
        }
        // The bootstrap collects a shape's methods in an order it does not fix, so two failing methods are declined.
        when failures > 1 {
            return Result::Err(unsupported("several methods of a shape that do not conform"))
        }
        return Result::Ok(failure)
    }

    // The message of the conformance error of one method of a shape, or nothing; a method with a default conforms.
    fun method_conformance(self, structure: String, shape_name: String, in_module: bool, method: ast::ShapeMethod) -> Result<Option<String>, String> {
        when method.default_body.is_some() || method.default_value.is_some() {
            return Result::Ok(Option::None)
        }
        // The shape's receiver is read from its written type; its other parameters are compared by their builtin words.
        mut self_mutable := false
        mut required_types: Vec<u64> = Vec()
        mut position: u64 = 0
        while position < method.parameters.len() {
            declaration := self.program.parameters[method.parameters[position]]
            when position == 0 && declaration.name == "self" {
                self_mutable = self.reference_kind(declaration.ty) == 2
            } else {
                required_types.push(declaration.ty)
            }
            position += 1
        }
        mut has_required_return := false
        mut required_return := String("")
        when method.return_type.is_some() {
            required_word := self.simple_word(method.return_type.unwrap())
            when required_word.is_none() {
                return Result::Err(unsupported("shape return type that is not a builtin word"))
            }
            required_return = required_word.unwrap()
            has_required_return = true
        }
        mut index: u64 = 0
        while index < required_types.len() {
            when self.simple_word(required_types[index]).is_none() {
                return Result::Err(unsupported("shape parameter type that is not a builtin word"))
            }
            index += 1
        }
        key := self.method_key(structure.clone(), method.name.clone())
        mut found: Option<u64> = Option::None
        // A method is a function of the structure whose first parameter is `self`, as the bootstrap registers them.
        for function_index in self.program.functions.clone() {
            definition_of := self.program.function_defs[function_index]
            when definition_of.name == key && definition_of.parameters.len() > 0 && self.program.parameters[definition_of.parameters[0]].name == "self" {
                found = Option::Some(function_index)
            }
        }
        when found.is_none() {
            when in_module {
                return Result::Err(unsupported("method of a structure in a module"))
            }
            mut message := String("`")
            message.append(structure.clone())
            message.append("` does not satisfy shape `")
            message.append(shape_name.clone())
            message.append("`: missing method `")
            message.append(method.name.clone())
            message.append("`")
            return Result::Ok(Option::Some(message))
        }
        function := self.program.function_defs[found.unwrap()]
        receiver := self.program.parameters[function.parameters[0]]
        receiver_kind := self.reference_kind(receiver.ty)
        when receiver_kind == 0 {
            return Result::Ok(Option::Some(method_conformance_text(structure.clone(), method.name.clone(), String("must take `self`"))))
        }
        target := self.pointee(receiver.ty)
        when self.simple_word(target).is_some() {
            mut detail := String("must take a `")
            detail.append(structure.clone())
            detail.append("` receiver")
            return Result::Ok(Option::Some(method_conformance_text(structure.clone(), method.name.clone(), detail)))
        }
        when self.shape_type_name(target) != structure.clone() {
            return Result::Err(unsupported("receiver of another type"))
        }
        when self_mutable && receiver_kind != 2 {
            mut detail := String("must take `mut self` to satisfy `")
            detail.append(shape_name.clone())
            detail.append("`")
            return Result::Ok(Option::Some(method_conformance_text(structure.clone(), method.name.clone(), detail)))
        }
        declared: u64 = function.parameters.len() - 1
        when declared != required_types.len() {
            mut detail := String("has ")
            detail.append(String(declared))
            detail.append(" parameter(s) but `")
            detail.append(shape_name.clone())
            detail.append("` requires ")
            detail.append(String(required_types.len()))
            return Result::Ok(Option::Some(method_conformance_text(structure.clone(), method.name.clone(), detail)))
        }
        index = 0
        while index < required_types.len() {
            parameter := self.program.parameters[function.parameters[index + 1]]
            actual := self.simple_word(parameter.ty)
            when actual.is_none() {
                return Result::Err(unsupported("method parameter type that is not a builtin word"))
            }
            expected := self.simple_word(required_types[index])
            actual_word := actual.unwrap()
            expected_word := expected.unwrap()
            when actual_word != expected_word {
                mut detail := String("parameter ")
                detail.append(String(index + 1))
                detail.append(" has type `")
                detail.append(actual_word)
                detail.append("` but `")
                detail.append(shape_name.clone())
                detail.append("` requires `")
                detail.append(expected_word)
                detail.append("`")
                return Result::Ok(Option::Some(method_conformance_text(structure.clone(), method.name.clone(), detail)))
            }
            index += 1
        }
        mut has_actual_return := false
        mut actual_return := String("")
        when function.return_type.is_some() {
            actual_word := self.simple_word(function.return_type.unwrap())
            when actual_word.is_none() {
                return Result::Err(unsupported("method return type that is not a builtin word"))
            }
            actual_return = actual_word.unwrap()
            has_actual_return = true
        }
        when has_actual_return != has_required_return || (has_actual_return && actual_return != required_return) {
            mut detail := String("return type does not match `")
            detail.append(shape_name.clone())
            detail.append("`")
            return Result::Ok(Option::Some(method_conformance_text(structure.clone(), method.name.clone(), detail)))
        }
        return Result::Ok(Option::None)
    }

    // The name a type tree names as a structure or alias; empty for any other type.
    fun shape_type_name(self, index: u64) -> String {
        choose self.program.types[index] {
            ast::TypeTree::NamedTy(name, span) => name,
            _ => String(""),
        }
    }

    // The builtin word of a `Simple` type tree, or nothing.
    fun simple_word(self, index: u64) -> Option<String> {
        choose self.program.types[index] {
            ast::TypeTree::Simple(word) => Option::Some(word),
            _ => Option::None,
        }
    }

    // 0 for a type that is not a reference, 1 for `&T`, 2 for `&mut T`.
    fun reference_kind(self, index: u64) -> u64 {
        choose self.program.types[index] {
            ast::TypeTree::RefTy(target, flag, span) => mutability_kind(flag),
            _ => 0,
        }
    }

    // The type a reference points at, or the type itself when it is not a reference.
    fun pointee(self, index: u64) -> u64 {
        choose self.program.types[index] {
            ast::TypeTree::RefTy(target, flag, span) => target,
            _ => index,
        }
    }
}

fun mutability_kind(flag: bool) -> u64 {
    when flag {
        return 2
    }
    return 1
}

// The message of `R0450` for a method of a structure that does not conform to the shape its block names.
fun method_conformance_text(structure: String, method: String, detail: String) -> String {
    mut message := String("`")
    message.append(structure)
    message.append("` method `")
    message.append(method)
    message.append("` ")
    message.append(detail)
    return message
}
