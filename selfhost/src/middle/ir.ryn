// The typed IR as Ryn data, and the reader and writer for its text form.
//
// The text is the one `ryn::ir_codec::encode_ir` writes. Recursive IR nodes live in
// flat arenas (`IrProgram.exprs`, `stmts`, `types`, `parts`, `arms`) and refer to one
// another by index, because Ryn does not allow a variant to hold a `Vec` of its own
// type. Operation names (`Binary` operators, string/vector/system operations and
// similar) are kept as their text tokens, so re-encoding writes them back unchanged.

pub struct IrSpan {
    pub start: u64,
    pub end: u64,
}

// A type. `Scalar` holds the word such as `I32` or `OwnedString`.
pub enum IrTy {
    Scalar(String),
    StructTy(u64),
    EnumTy(u64),
    VecOf(u64),
    SliceOf(u64),
    ArrayOf(u64, u64),
    MapOf(u64, u64),
    SetOf(u64, u64),
    ReferenceTo(u64, bool),
    RawPointerTo(u64),
    FunctionPointerTo(Vec<u64>, Option<u64>, bool),
}

pub enum CallTarget {
    Func(u64),
    ArgCount,
    Arg,
    StringOp(String),
    FilesystemOp(String),
    TryRead(u64),
    ReadFileRes(u64),
    SystemOp(String),
    IndirectFn(u64),
    VecOp(String, u64),
    VecSlice(u64),
    SliceLen,
    MapOp(String, u64, u64),
    SetOp(String, u64, u64),
    EnumNew(u64, u64),
    EnumPredicate(String, u64),
    EnumUnwrapOr(u64, u64),
    EnumUnwrap(u64, u64, bool, u64, String),
    VecGetOption(u64, u64, bool),
}

// Expression children are indices into `IrProgram.exprs`; lists of children are `Vec<u64>`.
pub enum IrExpr {
    IntegerLit(String, u64),
    FloatLit(u64, u64),
    StrLit(String),
    CharLit(u64),
    BoolLit(bool),
    LocalRef(u64, u64, IrSpan),
    MoveRef(u64, u64),
    StructValue(u64, Vec<u64>, Vec<u64>),
    FieldRead(u64, u64, u64, u64, IrSpan),
    ReferenceFieldRead(u64, u64, u64, u64, IrSpan, bool),
    ValueAddress(u64, u64, u64, IrSpan),
    CallExpr(CallTarget, Vec<u64>, u64),
    IfExpr(u64, u64, u64, u64),
    EnumMatch(u64, u64, Vec<u64>, u64),
    Propagate(u64, u64, u64, u64, Option<u64>, u64, u64, u64, Vec<u64>),
    ArrayValue(Vec<u64>),
    ArrayRepeat(u64, u64),
    ArrayAsSlice(u64, u64, u64),
    ArrayIndex(u64, u64, u64, u64),
    SliceIndex(u64, u64, u64),
    SliceElementAddress(u64, u64, u64, IrSpan),
    AddressOf(u64, u64, u64, IrSpan),
    Dereference(u64, u64),
    StringFindOption(u64, u64),
    StringAsStr(u64),
    Binary(String, u64, u64, u64),
    Negate(u64, u64),
    Not(u64),
    BitNot(u64, u64),
    FunctionAddress(u64, u64),
    CastExpr(u64, u64, u64),
}

// Statement children are indices into `IrProgram.stmts`; bodies are `Vec<u64>`.
pub enum IrStmt {
    BlockStmt(Vec<u64>),
    DropStmt(Vec<u64>, Vec<u64>),
    LetStmt(u64, u64, u64, IrSpan),
    AssignStmt(u64, u64, u64, IrSpan),
    ArrayAssignStmt(u64, u64, u64, u64, u64, IrSpan),
    DereferenceAssignStmt(u64, u64, u64),
    FieldAssignStmt(u64, u64, u64),
    ReferenceFieldAssignStmt(u64, u64, u64, u64, u64),
    PrintStmt(u64, u64),
    PrintTemplateStmt(Vec<u64>),
    CallStmt(CallTarget, Vec<u64>),
    IfStmt(u64, Vec<u64>, Vec<u64>),
    WhileStmt(Vec<u64>, u64, Vec<u64>),
    ForStmt(u64, u64, u64, u64, u64, bool, Vec<u64>),
    BreakStmt,
    ContinueStmt,
    ReturnStmt(Option<u64>),
}

// A part of a `PrintTemplate`, stored in `IrProgram.parts`.
pub enum PrintPart {
    TextPart(String),
    ValuePart(u64, u64),
}

// A `choose` arm. `bindings` is a flat list of (slot, type, field index) triples.
pub struct MatchArm {
    pub variant: Option<u64>,
    pub bindings: Vec<u64>,
    pub body: u64,
}

pub struct StructField {
    pub name: String,
    pub ty: u64,
    pub slot_offset: u64,
    pub public: bool,
}

pub struct IrStructDef {
    pub name: String,
    pub fields: Vec<StructField>,
    pub slot_count: u64,
    pub repr_c: bool,
    pub drop_function: Option<u64>,
    pub derives_clone: bool,
    pub derives_hash: bool,
    pub module_path: String,
}

pub struct EnumVariant {
    pub name: String,
    pub fields: Vec<u64>,
}

pub struct IrEnumDef {
    pub name: String,
    pub variants: Vec<EnumVariant>,
}

// `parameters` is a flat list of (slot, type) pairs. Statement and value lists hold
// indices into the arenas.
pub struct IrFunction {
    pub parameters: Vec<u64>,
    pub external_symbol: Option<String>,
    pub return_type: Option<u64>,
    pub reference_return_parameter: Option<u64>,
    pub return_value: Option<u64>,
    pub statements: Vec<u64>,
    pub local_types: Vec<String>,
    pub owned_slot_types: Vec<Option<u64>>,
    pub addressed_slot_types: Vec<Option<u64>>,
}

pub struct IrProgram {
    pub main_index: u64,
    pub instant_drop: Option<u64>,
    pub structs: Vec<IrStructDef>,
    pub enums: Vec<IrEnumDef>,
    pub functions: Vec<IrFunction>,
    pub types: Vec<IrTy>,
    pub exprs: Vec<IrExpr>,
    pub stmts: Vec<IrStmt>,
    pub parts: Vec<PrintPart>,
    pub arms: Vec<MatchArm>,
}

// Reads the text form. Each function consumes the tokens of one grammar production in the
// order `ryn::ir_codec` writes them, so the same words and counts are checked as in the
// Rust decoder, and nodes are pushed to the arenas once their children are read.
struct IrDecoder {
    text: String,
    at: u64,
    types: Vec<IrTy>,
    exprs: Vec<IrExpr>,
    stmts: Vec<IrStmt>,
    parts: Vec<PrintPart>,
    arms: Vec<MatchArm>,
}

fun is_scalar_word(word: String) -> bool {
    when word == "I8" || word == "I16" || word == "I32" || word == "I64" {
        return true
    }
    when word == "U8" || word == "U16" || word == "U32" || word == "U64" {
        return true
    }
    when word == "F32" || word == "F64" || word == "Str" || word == "OwnedString" {
        return true
    }
    return word == "Char" || word == "Bool"
}

fun is_local_type_word(word: String) -> bool {
    return word == "I8" || word == "I16" || word == "I32" || word == "I64" || word == "F32" || word == "F64" || word == "Ptr" || word == "OwnedPtr"
}

extend IrDecoder {
    fun skip_spaces(mut self) {
        while self.at < self.text.len() && self.text.byte_at(self.at) == (32 as u8) {
            self.at += 1
        }
    }

    fun finish(mut self) -> Result<bool, String> {
        self.skip_spaces()
        when self.at != self.text.len() {
            return Result::Err(String("trailing IR text"))
        }
        return Result::Ok(true)
    }

    // The next space-delimited token.
    fun token(mut self) -> Result<String, String> {
        self.skip_spaces()
        start := self.at
        while self.at < self.text.len() && self.text.byte_at(self.at) != (32 as u8) {
            self.at += 1
        }
        when start == self.at {
            return Result::Err(String("unexpected end of IR text"))
        }
        return Result::Ok(self.text.slice(start, self.at))
    }

    fun expect_word(mut self, expected: str) -> Result<bool, String> {
        found := self.token()?
        when found != expected {
            return Result::Err(String("unexpected word in IR text"))
        }
        return Result::Ok(true)
    }

    fun uint(mut self) -> Result<u64, String> {
        token := self.token()?
        parsed := token.try_parse::<u64>()
        when parsed.is_none() {
            return Result::Err(String("expected an unsigned integer"))
        }
        return Result::Ok(parsed.unwrap())
    }

    // An integer literal is kept as its text: the IR holds 128-bit values.
    fun int_text(mut self) -> Result<String, String> {
        token := self.token()?
        mut index: u64 = 0
        when token.byte_at(0) == (45 as u8) {
            index = 1
        }
        when index >= token.len() {
            return Result::Err(String("expected an integer"))
        }
        while index < token.len() {
            byte := token.byte_at(index)
            when byte < (48 as u8) || byte > (57 as u8) {
                return Result::Err(String("expected an integer"))
            }
            index += 1
        }
        return Result::Ok(token)
    }

    fun boolean(mut self) -> Result<bool, String> {
        value := self.uint()?
        when value == 0 {
            return Result::Ok(false)
        }
        when value == 1 {
            return Result::Ok(true)
        }
        return Result::Err(String("expected a boolean"))
    }

    // A length-prefixed string: `<byte length>:<bytes>`.
    fun string(mut self) -> Result<String, String> {
        self.skip_spaces()
        digits_start := self.at
        while self.at < self.text.len() && self.text.byte_at(self.at) >= (48 as u8) && self.text.byte_at(self.at) <= (57 as u8) {
            self.at += 1
        }
        when digits_start == self.at || self.at >= self.text.len() || self.text.byte_at(self.at) != (58 as u8) {
            return Result::Err(String("expected a length-prefixed string"))
        }
        length := self.text.slice(digits_start, self.at).try_parse::<u64>()
        when length.is_none() {
            return Result::Err(String("string length is out of range"))
        }
        self.at += 1
        end := self.at + length.unwrap()
        when end > self.text.len() {
            return Result::Err(String("string extends past the end of the IR text"))
        }
        // A byte in 0x80..=0xBF continues a UTF-8 character, so the end would split it.
        when end < self.text.len() && self.text.byte_at(end) >= (128 as u8) && self.text.byte_at(end) < (192 as u8) {
            return Result::Err(String("string length splits a UTF-8 character"))
        }
        value := self.text.slice(self.at, end)
        self.at = end
        return Result::Ok(value)
    }

    fun span(mut self) -> Result<IrSpan, String> {
        start := self.uint()?
        end := self.uint()?
        return Result::Ok(IrSpan { start: start, end: end })
    }

    fun optional_uint(mut self) -> Result<Option<u64>, String> {
        word := self.token()?
        when word == "-" {
            return Result::Ok(Option::None)
        }
        when word == "+" {
            value := self.uint()?
            return Result::Ok(Option::Some(value))
        }
        return Result::Err(String("expected an optional value"))
    }

    fun optional_ty(mut self) -> Result<Option<u64>, String> {
        word := self.token()?
        when word == "-" {
            return Result::Ok(Option::None)
        }
        when word == "+" {
            value := self.ty()?
            return Result::Ok(Option::Some(value))
        }
        return Result::Err(String("expected an optional type"))
    }

    fun optional_expr(mut self) -> Result<Option<u64>, String> {
        word := self.token()?
        when word == "-" {
            return Result::Ok(Option::None)
        }
        when word == "+" {
            value := self.expression()?
            return Result::Ok(Option::Some(value))
        }
        return Result::Err(String("expected an optional value"))
    }

    fun push_ty(mut self, ty: IrTy) -> u64 {
        index := self.types.len()
        self.types.push(ty)
        return index
    }

    fun push_expr(mut self, expr: IrExpr) -> u64 {
        index := self.exprs.len()
        self.exprs.push(expr)
        return index
    }

    fun push_stmt(mut self, stmt: IrStmt) -> u64 {
        index := self.stmts.len()
        self.stmts.push(stmt)
        return index
    }

    fun push_part(mut self, part: PrintPart) -> u64 {
        index := self.parts.len()
        self.parts.push(part)
        return index
    }

    fun push_arm(mut self, arm: MatchArm) -> u64 {
        index := self.arms.len()
        self.arms.push(arm)
        return index
    }

    fun ir(mut self) -> Result<IrProgram, String> {
        main_index := self.uint()?
        instant_drop := self.optional_uint()?
        mut structs: Vec<IrStructDef> = Vec()
        struct_count := self.uint()?
        mut struct_index: u64 = 0
        while struct_index < struct_count {
            structs.push(self.struct_definition()?)
            struct_index += 1
        }
        mut enums: Vec<IrEnumDef> = Vec()
        enum_count := self.uint()?
        mut enum_index: u64 = 0
        while enum_index < enum_count {
            enums.push(self.enum_definition()?)
            enum_index += 1
        }
        mut functions: Vec<IrFunction> = Vec()
        function_count := self.uint()?
        mut function_index: u64 = 0
        while function_index < function_count {
            functions.push(self.function()?)
            function_index += 1
        }
        return Result::Ok(IrProgram {
            main_index: main_index,
            instant_drop: instant_drop,
            structs: structs,
            enums: enums,
            functions: functions,
            types: self.types,
            exprs: self.exprs,
            stmts: self.stmts,
            parts: self.parts,
            arms: self.arms,
        })
    }

    fun struct_definition(mut self) -> Result<IrStructDef, String> {
        name := self.string()?
        field_count := self.uint()?
        mut fields: Vec<StructField> = Vec()
        mut field_index: u64 = 0
        while field_index < field_count {
            field_name := self.string()?
            field_ty := self.ty()?
            slot_offset := self.uint()?
            public := self.boolean()?
            fields.push(StructField { name: field_name, ty: field_ty, slot_offset: slot_offset, public: public })
            field_index += 1
        }
        slot_count := self.uint()?
        repr_c := self.boolean()?
        drop_function := self.optional_uint()?
        derives_clone := self.boolean()?
        derives_hash := self.boolean()?
        module_path := self.string()?
        return Result::Ok(IrStructDef {
            name: name,
            fields: fields,
            slot_count: slot_count,
            repr_c: repr_c,
            drop_function: drop_function,
            derives_clone: derives_clone,
            derives_hash: derives_hash,
            module_path: module_path,
        })
    }

    fun enum_definition(mut self) -> Result<IrEnumDef, String> {
        name := self.string()?
        variant_count := self.uint()?
        mut variants: Vec<EnumVariant> = Vec()
        mut variant_index: u64 = 0
        while variant_index < variant_count {
            variant_name := self.string()?
            field_count := self.uint()?
            mut fields: Vec<u64> = Vec()
            mut field_index: u64 = 0
            while field_index < field_count {
                fields.push(self.ty()?)
                field_index += 1
            }
            variants.push(EnumVariant { name: variant_name, fields: fields })
            variant_index += 1
        }
        return Result::Ok(IrEnumDef { name: name, variants: variants })
    }

    fun function(mut self) -> Result<IrFunction, String> {
        parameter_count := self.uint()?
        mut parameters: Vec<u64> = Vec()
        mut parameter_index: u64 = 0
        while parameter_index < parameter_count {
            parameters.push(self.uint()?)
            parameters.push(self.ty()?)
            parameter_index += 1
        }
        external_word := self.token()?
        mut external_symbol: Option<String> = Option::None
        when external_word == "+" {
            external_symbol = Option::Some(self.string()?)
        } else {
            when external_word != "-" {
                return Result::Err(String("expected an optional symbol"))
            }
        }
        return_type := self.optional_ty()?
        reference_return_parameter := self.optional_uint()?
        return_value := self.optional_expr()?
        statements := self.statement_list()?
        local_count := self.uint()?
        mut local_types: Vec<String> = Vec()
        mut local_index: u64 = 0
        while local_index < local_count {
            word := self.token()?
            when !is_local_type_word(word.clone()) {
                return Result::Err(String("unknown local type"))
            }
            local_types.push(word)
            local_index += 1
        }
        owned_count := self.uint()?
        mut owned_slot_types: Vec<Option<u64>> = Vec()
        mut owned_index: u64 = 0
        while owned_index < owned_count {
            owned_slot_types.push(self.optional_ty()?)
            owned_index += 1
        }
        addressed_count := self.uint()?
        mut addressed_slot_types: Vec<Option<u64>> = Vec()
        mut addressed_index: u64 = 0
        while addressed_index < addressed_count {
            addressed_slot_types.push(self.optional_ty()?)
            addressed_index += 1
        }
        return Result::Ok(IrFunction {
            parameters: parameters,
            external_symbol: external_symbol,
            return_type: return_type,
            reference_return_parameter: reference_return_parameter,
            return_value: return_value,
            statements: statements,
            local_types: local_types,
            owned_slot_types: owned_slot_types,
            addressed_slot_types: addressed_slot_types,
        })
    }

    fun ty(mut self) -> Result<u64, String> {
        word := self.token()?
        when is_scalar_word(word.clone()) {
            return Result::Ok(self.push_ty(IrTy::Scalar(word)))
        }
        when word == "Struct" {
            id := self.uint()?
            return Result::Ok(self.push_ty(IrTy::StructTy(id)))
        }
        when word == "Enum" {
            id := self.uint()?
            return Result::Ok(self.push_ty(IrTy::EnumTy(id)))
        }
        when word == "Vec" {
            element := self.ty()?
            return Result::Ok(self.push_ty(IrTy::VecOf(element)))
        }
        when word == "Slice" {
            element := self.ty()?
            return Result::Ok(self.push_ty(IrTy::SliceOf(element)))
        }
        when word == "Array" {
            element := self.ty()?
            length := self.uint()?
            return Result::Ok(self.push_ty(IrTy::ArrayOf(element, length)))
        }
        when word == "Map" {
            key := self.ty()?
            value := self.ty()?
            return Result::Ok(self.push_ty(IrTy::MapOf(key, value)))
        }
        when word == "Set" {
            key := self.ty()?
            value := self.ty()?
            return Result::Ok(self.push_ty(IrTy::SetOf(key, value)))
        }
        when word == "Reference" {
            target := self.ty()?
            mutable := self.boolean()?
            return Result::Ok(self.push_ty(IrTy::ReferenceTo(target, mutable)))
        }
        when word == "RawPointer" {
            target := self.ty()?
            return Result::Ok(self.push_ty(IrTy::RawPointerTo(target)))
        }
        when word == "FunctionPointer" {
            parameter_count := self.uint()?
            mut parameters: Vec<u64> = Vec()
            mut parameter_index: u64 = 0
            while parameter_index < parameter_count {
                parameters.push(self.ty()?)
                parameter_index += 1
            }
            result := self.optional_ty()?
            extern_c := self.boolean()?
            return Result::Ok(self.push_ty(IrTy::FunctionPointerTo(parameters, result, extern_c)))
        }
        return Result::Err(String("unknown type"))
    }

    fun statement_list(mut self) -> Result<Vec<u64>, String> {
        count := self.uint()?
        mut indices: Vec<u64> = Vec()
        mut index: u64 = 0
        while index < count {
            indices.push(self.statement()?)
            index += 1
        }
        return Result::Ok(indices)
    }

    fun expression_list(mut self) -> Result<Vec<u64>, String> {
        count := self.uint()?
        mut indices: Vec<u64> = Vec()
        mut index: u64 = 0
        while index < count {
            indices.push(self.expression()?)
            index += 1
        }
        return Result::Ok(indices)
    }

    fun statement(mut self) -> Result<u64, String> {
        word := self.token()?
        when word == "Block" {
            body := self.statement_list()?
            return Result::Ok(self.push_stmt(IrStmt::BlockStmt(body)))
        }
        when word == "Drop" {
            count := self.uint()?
            mut slots: Vec<u64> = Vec()
            mut types: Vec<u64> = Vec()
            mut index: u64 = 0
            while index < count {
                slots.push(self.uint()?)
                types.push(self.ty()?)
                index += 1
            }
            return Result::Ok(self.push_stmt(IrStmt::DropStmt(slots, types)))
        }
        when word == "Let" {
            slot := self.uint()?
            ty := self.ty()?
            value := self.expression()?
            span := self.span()?
            return Result::Ok(self.push_stmt(IrStmt::LetStmt(slot, ty, value, span)))
        }
        when word == "Assign" {
            slot := self.uint()?
            ty := self.ty()?
            value := self.expression()?
            span := self.span()?
            return Result::Ok(self.push_stmt(IrStmt::AssignStmt(slot, ty, value, span)))
        }
        when word == "ArrayAssign" {
            slot := self.uint()?
            element := self.ty()?
            length := self.uint()?
            index := self.expression()?
            value := self.expression()?
            span := self.span()?
            return Result::Ok(self.push_stmt(IrStmt::ArrayAssignStmt(slot, element, length, index, value, span)))
        }
        when word == "DereferenceAssign" {
            pointer := self.expression()?
            ty := self.ty()?
            value := self.expression()?
            return Result::Ok(self.push_stmt(IrStmt::DereferenceAssignStmt(pointer, ty, value)))
        }
        when word == "FieldAssign" {
            slot := self.uint()?
            ty := self.ty()?
            value := self.expression()?
            return Result::Ok(self.push_stmt(IrStmt::FieldAssignStmt(slot, ty, value)))
        }
        when word == "ReferenceFieldAssign" {
            pointer := self.expression()?
            struct_id := self.uint()?
            field_index := self.uint()?
            ty := self.ty()?
            value := self.expression()?
            return Result::Ok(self.push_stmt(IrStmt::ReferenceFieldAssignStmt(pointer, struct_id, field_index, ty, value)))
        }
        when word == "Print" {
            value := self.expression()?
            ty := self.ty()?
            return Result::Ok(self.push_stmt(IrStmt::PrintStmt(value, ty)))
        }
        when word == "PrintTemplate" {
            count := self.uint()?
            mut parts: Vec<u64> = Vec()
            mut index: u64 = 0
            while index < count {
                parts.push(self.print_part()?)
                index += 1
            }
            return Result::Ok(self.push_stmt(IrStmt::PrintTemplateStmt(parts)))
        }
        when word == "CallStatement" {
            target := self.call_target()?
            arguments := self.expression_list()?
            return Result::Ok(self.push_stmt(IrStmt::CallStmt(target, arguments)))
        }
        when word == "IfStatement" {
            condition := self.expression()?
            then_body := self.statement_list()?
            else_body := self.statement_list()?
            return Result::Ok(self.push_stmt(IrStmt::IfStmt(condition, then_body, else_body)))
        }
        when word == "While" {
            setup := self.statement_list()?
            condition := self.expression()?
            body := self.statement_list()?
            return Result::Ok(self.push_stmt(IrStmt::WhileStmt(setup, condition, body)))
        }
        when word == "For" {
            slot := self.uint()?
            end_slot := self.uint()?
            ty := self.ty()?
            start := self.expression()?
            end := self.expression()?
            inclusive := self.boolean()?
            body := self.statement_list()?
            return Result::Ok(self.push_stmt(IrStmt::ForStmt(slot, end_slot, ty, start, end, inclusive, body)))
        }
        when word == "Break" {
            return Result::Ok(self.push_stmt(IrStmt::BreakStmt))
        }
        when word == "Continue" {
            return Result::Ok(self.push_stmt(IrStmt::ContinueStmt))
        }
        when word == "Return" {
            value := self.optional_expr()?
            return Result::Ok(self.push_stmt(IrStmt::ReturnStmt(value)))
        }
        return Result::Err(String("unknown statement"))
    }

    fun print_part(mut self) -> Result<u64, String> {
        word := self.token()?
        when word == "Text" {
            text := self.string()?
            return Result::Ok(self.push_part(PrintPart::TextPart(text)))
        }
        when word == "Value" {
            value := self.expression()?
            ty := self.ty()?
            return Result::Ok(self.push_part(PrintPart::ValuePart(value, ty)))
        }
        return Result::Err(String("unknown print part"))
    }

    fun call_target(mut self) -> Result<CallTarget, String> {
        word := self.token()?
        when word == "Function" {
            id := self.uint()?
            return Result::Ok(CallTarget::Func(id))
        }
        when word == "ArgumentCount" {
            return Result::Ok(CallTarget::ArgCount)
        }
        when word == "Argument" {
            return Result::Ok(CallTarget::Arg)
        }
        when word == "String" {
            return Result::Ok(CallTarget::StringOp(self.token()?))
        }
        when word == "Filesystem" {
            return Result::Ok(CallTarget::FilesystemOp(self.token()?))
        }
        when word == "TryReadFile" {
            id := self.uint()?
            return Result::Ok(CallTarget::TryRead(id))
        }
        when word == "ReadFileResult" {
            id := self.uint()?
            return Result::Ok(CallTarget::ReadFileRes(id))
        }
        when word == "System" {
            return Result::Ok(CallTarget::SystemOp(self.token()?))
        }
        when word == "IndirectFunctionPointer" {
            id := self.ty()?
            return Result::Ok(CallTarget::IndirectFn(id))
        }
        when word == "Vec" {
            op := self.token()?
            id := self.ty()?
            return Result::Ok(CallTarget::VecOp(op, id))
        }
        when word == "VecSlice" {
            id := self.ty()?
            return Result::Ok(CallTarget::VecSlice(id))
        }
        when word == "SliceLen" {
            return Result::Ok(CallTarget::SliceLen)
        }
        when word == "Map" {
            op := self.token()?
            key := self.ty()?
            value := self.ty()?
            return Result::Ok(CallTarget::MapOp(op, key, value))
        }
        when word == "Set" {
            op := self.token()?
            key := self.ty()?
            value := self.ty()?
            return Result::Ok(CallTarget::SetOp(op, key, value))
        }
        when word == "EnumNew" {
            enum_id := self.uint()?
            tag := self.uint()?
            return Result::Ok(CallTarget::EnumNew(enum_id, tag))
        }
        when word == "EnumPredicate" {
            op := self.token()?
            id := self.uint()?
            return Result::Ok(CallTarget::EnumPredicate(op, id))
        }
        when word == "EnumUnwrapOr" {
            enum_id := self.uint()?
            value_type := self.ty()?
            return Result::Ok(CallTarget::EnumUnwrapOr(enum_id, value_type))
        }
        when word == "EnumUnwrap" {
            enum_id := self.uint()?
            value_type := self.ty()?
            message := self.boolean()?
            success_tag := self.uint()?
            failure := self.token()?
            return Result::Ok(CallTarget::EnumUnwrap(enum_id, value_type, message, success_tag, failure))
        }
        when word == "VecGetOption" {
            elem_id := self.ty()?
            option_id := self.uint()?
            pop := self.boolean()?
            return Result::Ok(CallTarget::VecGetOption(elem_id, option_id, pop))
        }
        return Result::Err(String("unknown call target"))
    }

    fun match_arm(mut self) -> Result<u64, String> {
        variant := self.optional_uint()?
        count := self.uint()?
        mut bindings: Vec<u64> = Vec()
        mut index: u64 = 0
        while index < count {
            bindings.push(self.uint()?)
            bindings.push(self.ty()?)
            bindings.push(self.uint()?)
            index += 1
        }
        body := self.expression()?
        return Result::Ok(self.push_arm(MatchArm { variant: variant, bindings: bindings, body: body }))
    }

    fun expression(mut self) -> Result<u64, String> {
        word := self.token()?
        when word == "Integer" {
            value := self.int_text()?
            ty := self.ty()?
            return Result::Ok(self.push_expr(IrExpr::IntegerLit(value, ty)))
        }
        when word == "Float" {
            bits := self.uint()?
            ty := self.ty()?
            return Result::Ok(self.push_expr(IrExpr::FloatLit(bits, ty)))
        }
        when word == "String" {
            text := self.string()?
            return Result::Ok(self.push_expr(IrExpr::StrLit(text)))
        }
        when word == "Character" {
            scalar := self.uint()?
            when scalar > 1114111 || (scalar >= 55296 && scalar <= 57343) {
                return Result::Err(String("invalid character scalar"))
            }
            return Result::Ok(self.push_expr(IrExpr::CharLit(scalar)))
        }
        when word == "Boolean" {
            value := self.boolean()?
            return Result::Ok(self.push_expr(IrExpr::BoolLit(value)))
        }
        when word == "Local" {
            slot := self.uint()?
            ty := self.ty()?
            span := self.span()?
            return Result::Ok(self.push_expr(IrExpr::LocalRef(slot, ty, span)))
        }
        when word == "Move" {
            slot := self.uint()?
            ty := self.ty()?
            return Result::Ok(self.push_expr(IrExpr::MoveRef(slot, ty)))
        }
        when word == "StructValue" {
            struct_id := self.uint()?
            count := self.uint()?
            mut field_indices: Vec<u64> = Vec()
            mut values: Vec<u64> = Vec()
            mut index: u64 = 0
            while index < count {
                field_indices.push(self.uint()?)
                values.push(self.expression()?)
                index += 1
            }
            return Result::Ok(self.push_expr(IrExpr::StructValue(struct_id, field_indices, values)))
        }
        when word == "Field" {
            value := self.expression()?
            struct_id := self.uint()?
            field_index := self.uint()?
            ty := self.ty()?
            span := self.span()?
            return Result::Ok(self.push_expr(IrExpr::FieldRead(value, struct_id, field_index, ty, span)))
        }
        when word == "ReferenceField" {
            pointer := self.expression()?
            struct_id := self.uint()?
            field_index := self.uint()?
            ty := self.ty()?
            span := self.span()?
            borrowed := self.boolean()?
            return Result::Ok(self.push_expr(IrExpr::ReferenceFieldRead(pointer, struct_id, field_index, ty, span, borrowed)))
        }
        when word == "ValueAddress" {
            value := self.expression()?
            ty := self.ty()?
            pointer_type := self.ty()?
            span := self.span()?
            return Result::Ok(self.push_expr(IrExpr::ValueAddress(value, ty, pointer_type, span)))
        }
        when word == "Call" {
            target := self.call_target()?
            arguments := self.expression_list()?
            return_type := self.ty()?
            return Result::Ok(self.push_expr(IrExpr::CallExpr(target, arguments, return_type)))
        }
        when word == "If" {
            condition := self.expression()?
            then_value := self.expression()?
            else_value := self.expression()?
            ty := self.ty()?
            return Result::Ok(self.push_expr(IrExpr::IfExpr(condition, then_value, else_value, ty)))
        }
        when word == "EnumMatch" {
            value := self.expression()?
            enum_id := self.uint()?
            count := self.uint()?
            mut arms: Vec<u64> = Vec()
            mut index: u64 = 0
            while index < count {
                arms.push(self.match_arm()?)
                index += 1
            }
            ty := self.ty()?
            return Result::Ok(self.push_expr(IrExpr::EnumMatch(value, enum_id, arms, ty)))
        }
        when word == "Propagate" {
            value := self.expression()?
            input_enum := self.uint()?
            output_enum := self.uint()?
            success_type := self.ty()?
            failure_type := self.optional_ty()?
            success_variant := self.uint()?
            failure_variant := self.uint()?
            output_failure_variant := self.uint()?
            deferred := self.statement_list()?
            return Result::Ok(self.push_expr(IrExpr::Propagate(value, input_enum, output_enum, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred)))
        }
        when word == "ArrayValue" {
            items := self.expression_list()?
            return Result::Ok(self.push_expr(IrExpr::ArrayValue(items)))
        }
        when word == "ArrayRepeat" {
            value := self.expression()?
            length := self.uint()?
            return Result::Ok(self.push_expr(IrExpr::ArrayRepeat(value, length)))
        }
        when word == "ArrayAsSlice" {
            array := self.expression()?
            slice_id := self.ty()?
            length := self.uint()?
            return Result::Ok(self.push_expr(IrExpr::ArrayAsSlice(array, slice_id, length)))
        }
        when word == "ArrayIndex" {
            array := self.expression()?
            index := self.expression()?
            ty := self.ty()?
            length := self.uint()?
            return Result::Ok(self.push_expr(IrExpr::ArrayIndex(array, index, ty, length)))
        }
        when word == "SliceIndex" {
            slice := self.expression()?
            index := self.expression()?
            ty := self.ty()?
            return Result::Ok(self.push_expr(IrExpr::SliceIndex(slice, index, ty)))
        }
        when word == "SliceElementAddress" {
            slice := self.expression()?
            index := self.expression()?
            ty := self.ty()?
            span := self.span()?
            return Result::Ok(self.push_expr(IrExpr::SliceElementAddress(slice, index, ty, span)))
        }
        when word == "AddressOf" {
            slot := self.uint()?
            ty := self.ty()?
            pointer_type := self.ty()?
            span := self.span()?
            return Result::Ok(self.push_expr(IrExpr::AddressOf(slot, ty, pointer_type, span)))
        }
        when word == "Dereference" {
            pointer := self.expression()?
            ty := self.ty()?
            return Result::Ok(self.push_expr(IrExpr::Dereference(pointer, ty)))
        }
        when word == "StringFindOption" {
            value := self.expression()?
            enum_id := self.uint()?
            return Result::Ok(self.push_expr(IrExpr::StringFindOption(value, enum_id)))
        }
        when word == "StringAsStr" {
            value := self.expression()?
            return Result::Ok(self.push_expr(IrExpr::StringAsStr(value)))
        }
        when word == "Binary" {
            op := self.token()?
            left := self.expression()?
            right := self.expression()?
            ty := self.ty()?
            return Result::Ok(self.push_expr(IrExpr::Binary(op, left, right, ty)))
        }
        when word == "Negate" {
            value := self.expression()?
            ty := self.ty()?
            return Result::Ok(self.push_expr(IrExpr::Negate(value, ty)))
        }
        when word == "Not" {
            value := self.expression()?
            return Result::Ok(self.push_expr(IrExpr::Not(value)))
        }
        when word == "BitNot" {
            value := self.expression()?
            ty := self.ty()?
            return Result::Ok(self.push_expr(IrExpr::BitNot(value, ty)))
        }
        when word == "FunctionAddress" {
            function := self.uint()?
            ty := self.ty()?
            return Result::Ok(self.push_expr(IrExpr::FunctionAddress(function, ty)))
        }
        when word == "Cast" {
            value := self.expression()?
            source := self.ty()?
            target := self.ty()?
            return Result::Ok(self.push_expr(IrExpr::CastExpr(value, source, target)))
        }
        return Result::Err(String("unknown expression"))
    }
}

// Decodes the text written by `ryn::ir_codec::encode_ir`.
pub fun decode_ir(text: String) -> Result<IrProgram, String> {
    mut decoder := IrDecoder { text: text, at: 0, types: Vec(), exprs: Vec(), stmts: Vec(), parts: Vec(), arms: Vec() }
    decoder.expect_word("Ir")?
    program := decoder.ir()?
    decoder.finish()?
    return Result::Ok(program)
}

// Writes the text form. The field order mirrors `IrDecoder`, so decoding the output gives
// back the same arenas, and writing it again gives the same text.
struct IrWriter {
    out: String,
    program: IrProgram,
}

extend IrWriter {
    fun raw(mut self, text: String) {
        self.out.append(" ")
        self.out.append(text)
    }

    fun word(mut self, text: str) {
        self.out.append(" ")
        self.out.append(text)
    }

    fun uint(mut self, value: u64) {
        self.out.append(" ")
        self.out.append(String(value))
    }

    fun boolean(mut self, value: bool) {
        when value {
            self.uint(1)
        } else {
            self.uint(0)
        }
    }

    // A length-prefixed string: `<byte length>:<bytes>`.
    fun string(mut self, value: String) {
        self.out.append(" ")
        self.out.append(String(value.len()))
        self.out.append(":")
        self.out.append(value)
    }

    fun optional_uint(mut self, value: Option<u64>) {
        when value.is_none() {
            self.word("-")
        } else {
            self.word("+")
            self.uint(value.unwrap())
        }
    }

    fun optional_ty(mut self, value: Option<u64>) {
        when value.is_none() {
            self.word("-")
        } else {
            self.word("+")
            self.ty(value.unwrap())
        }
    }

    fun optional_expr(mut self, value: Option<u64>) {
        when value.is_none() {
            self.word("-")
        } else {
            self.word("+")
            self.expression(value.unwrap())
        }
    }

    fun optional_string(mut self, value: Option<String>) {
        when value.is_none() {
            self.word("-")
        } else {
            self.word("+")
            self.string(value.unwrap())
        }
    }

    fun span(mut self, span: IrSpan) {
        self.uint(span.start)
        self.uint(span.end)
    }

    fun ir(mut self) {
        main_index := self.program.main_index
        instant_drop := self.program.instant_drop
        self.uint(main_index)
        self.optional_uint(instant_drop)
        struct_count := self.program.structs.len()
        self.uint(struct_count)
        mut index: u64 = 0
        while index < struct_count {
            definition := self.program.structs[index]
            self.struct_definition(definition)
            index += 1
        }
        enum_count := self.program.enums.len()
        self.uint(enum_count)
        index = 0
        while index < enum_count {
            definition := self.program.enums[index]
            self.enum_definition(definition)
            index += 1
        }
        function_count := self.program.functions.len()
        self.uint(function_count)
        index = 0
        while index < function_count {
            function := self.program.functions[index]
            self.function(function)
            index += 1
        }
    }

    fun struct_definition(mut self, definition: IrStructDef) {
        self.string(definition.name)
        self.uint(definition.fields.len())
        for field in definition.fields {
            self.string(field.name)
            self.ty(field.ty)
            self.uint(field.slot_offset)
            self.boolean(field.public)
        }
        self.uint(definition.slot_count)
        self.boolean(definition.repr_c)
        self.optional_uint(definition.drop_function)
        self.boolean(definition.derives_clone)
        self.boolean(definition.derives_hash)
        self.string(definition.module_path)
    }

    fun enum_definition(mut self, definition: IrEnumDef) {
        self.string(definition.name)
        self.uint(definition.variants.len())
        for variant in definition.variants {
            self.string(variant.name)
            self.uint(variant.fields.len())
            for field in variant.fields {
                self.ty(field)
            }
        }
    }

    fun function(mut self, function: IrFunction) {
        self.uint(function.parameters.len() / 2)
        mut index: u64 = 0
        while index < function.parameters.len() {
            self.uint(function.parameters[index])
            self.ty(function.parameters[index + 1])
            index += 2
        }
        when function.external_symbol.is_none() {
            self.word("-")
        } else {
            self.word("+")
            self.string(function.external_symbol.unwrap())
        }
        self.optional_ty(function.return_type)
        self.optional_uint(function.reference_return_parameter)
        self.optional_expr(function.return_value)
        self.statement_list(function.statements)
        self.uint(function.local_types.len())
        for local in function.local_types {
            self.raw(local)
        }
        self.uint(function.owned_slot_types.len())
        for owned in function.owned_slot_types {
            self.optional_ty(owned)
        }
        self.uint(function.addressed_slot_types.len())
        for addressed in function.addressed_slot_types {
            self.optional_ty(addressed)
        }
    }

    fun ty(mut self, index: u64) -> bool {
        choose self.program.types[index] {
            IrTy::Scalar(name) => self.emit_ty_scalar(name),
            IrTy::StructTy(id) => self.emit_ty_struct_ty(id),
            IrTy::EnumTy(id) => self.emit_ty_enum_ty(id),
            IrTy::VecOf(element) => self.emit_ty_vec_of(element),
            IrTy::SliceOf(element) => self.emit_ty_slice_of(element),
            IrTy::ArrayOf(element, length) => self.emit_ty_array_of(element, length),
            IrTy::MapOf(key, value) => self.emit_ty_map_of(key, value),
            IrTy::SetOf(key, value) => self.emit_ty_set_of(key, value),
            IrTy::ReferenceTo(target, mutable) => self.emit_ty_reference_to(target, mutable),
            IrTy::RawPointerTo(target) => self.emit_ty_raw_pointer_to(target),
            IrTy::FunctionPointerTo(parameters, result, extern_c) => self.emit_ty_function_pointer_to(parameters, result, extern_c),
        }
    }

    fun statement_list(mut self, indices: Vec<u64>) {
        self.uint(indices.len())
        for index in indices {
            self.statement(index)
        }
    }

    fun expression_list(mut self, indices: Vec<u64>) {
        self.uint(indices.len())
        for index in indices {
            self.expression(index)
        }
    }

    fun print_part(mut self, index: u64) -> bool {
        choose self.program.parts[index] {
            PrintPart::TextPart(text) => self.emit_print_part_text_part(text),
            PrintPart::ValuePart(value, ty) => self.emit_print_part_value_part(value, ty),
        }
    }

    fun call_target(mut self, target: CallTarget) -> bool {
        choose target {
            CallTarget::Func(id) => self.emit_call_target_func(id),
            CallTarget::ArgCount => self.emit_call_target_arg_count(),
            CallTarget::Arg => self.emit_call_target_arg(),
            CallTarget::StringOp(op) => self.emit_call_target_string_op(op),
            CallTarget::FilesystemOp(op) => self.emit_call_target_filesystem_op(op),
            CallTarget::TryRead(id) => self.emit_call_target_try_read(id),
            CallTarget::ReadFileRes(id) => self.emit_call_target_read_file_res(id),
            CallTarget::SystemOp(op) => self.emit_call_target_system_op(op),
            CallTarget::IndirectFn(id) => self.emit_call_target_indirect_fn(id),
            CallTarget::VecOp(op, id) => self.emit_call_target_vec_op(op, id),
            CallTarget::VecSlice(id) => self.emit_call_target_vec_slice(id),
            CallTarget::SliceLen => self.emit_call_target_slice_len(),
            CallTarget::MapOp(op, key, value) => self.emit_call_target_map_op(op, key, value),
            CallTarget::SetOp(op, key, value) => self.emit_call_target_set_op(op, key, value),
            CallTarget::EnumNew(enum_id, tag) => self.emit_call_target_enum_new(enum_id, tag),
            CallTarget::EnumPredicate(op, id) => self.emit_call_target_enum_predicate(op, id),
            CallTarget::EnumUnwrapOr(enum_id, value_type) => self.emit_call_target_enum_unwrap_or(enum_id, value_type),
            CallTarget::EnumUnwrap(enum_id, value_type, message, success_tag, failure) => self.emit_call_target_enum_unwrap(enum_id, value_type, message, success_tag, failure),
            CallTarget::VecGetOption(elem_id, option_id, pop) => self.emit_call_target_vec_get_option(elem_id, option_id, pop),
        }
    }

    fun match_arm(mut self, index: u64) {
        arm := self.program.arms[index]
        self.optional_uint(arm.variant)
        self.uint(arm.bindings.len() / 3)
        mut at: u64 = 0
        while at < arm.bindings.len() {
            self.uint(arm.bindings[at])
            self.ty(arm.bindings[at + 1])
            self.uint(arm.bindings[at + 2])
            at += 3
        }
        self.expression(arm.body)
    }

    fun statement(mut self, index: u64) -> bool {
        choose self.program.stmts[index] {
            IrStmt::BlockStmt(body) => self.emit_stmt_block_stmt(body),
            IrStmt::DropStmt(slots, types) => self.emit_stmt_drop_stmt(slots, types),
            IrStmt::LetStmt(slot, ty, value, span) => self.emit_stmt_let_stmt(slot, ty, value, span),
            IrStmt::AssignStmt(slot, ty, value, span) => self.emit_stmt_assign_stmt(slot, ty, value, span),
            IrStmt::ArrayAssignStmt(slot, element, length, index, value, span) => self.emit_stmt_array_assign_stmt(slot, element, length, index, value, span),
            IrStmt::DereferenceAssignStmt(pointer, ty, value) => self.emit_stmt_dereference_assign_stmt(pointer, ty, value),
            IrStmt::FieldAssignStmt(slot, ty, value) => self.emit_stmt_field_assign_stmt(slot, ty, value),
            IrStmt::ReferenceFieldAssignStmt(pointer, struct_id, field_index, ty, value) => self.emit_stmt_reference_field_assign_stmt(pointer, struct_id, field_index, ty, value),
            IrStmt::PrintStmt(value, ty) => self.emit_stmt_print_stmt(value, ty),
            IrStmt::PrintTemplateStmt(parts) => self.emit_stmt_print_template_stmt(parts),
            IrStmt::CallStmt(target, arguments) => self.emit_stmt_call_stmt(target, arguments),
            IrStmt::IfStmt(condition, then_body, else_body) => self.emit_stmt_if_stmt(condition, then_body, else_body),
            IrStmt::WhileStmt(setup, condition, body) => self.emit_stmt_while_stmt(setup, condition, body),
            IrStmt::ForStmt(slot, end_slot, ty, start, end, inclusive, body) => self.emit_stmt_for_stmt(slot, end_slot, ty, start, end, inclusive, body),
            IrStmt::BreakStmt => self.emit_stmt_break_stmt(),
            IrStmt::ContinueStmt => self.emit_stmt_continue_stmt(),
            IrStmt::ReturnStmt(value) => self.emit_stmt_return_stmt(value),
        }
    }

    fun expression(mut self, index: u64) -> bool {
        choose self.program.exprs[index] {
            IrExpr::IntegerLit(text, ty) => self.emit_expr_integer_lit(text, ty),
            IrExpr::FloatLit(bits, ty) => self.emit_expr_float_lit(bits, ty),
            IrExpr::StrLit(text) => self.emit_expr_str_lit(text),
            IrExpr::CharLit(scalar) => self.emit_expr_char_lit(scalar),
            IrExpr::BoolLit(value) => self.emit_expr_bool_lit(value),
            IrExpr::LocalRef(slot, ty, span) => self.emit_expr_local_ref(slot, ty, span),
            IrExpr::MoveRef(slot, ty) => self.emit_expr_move_ref(slot, ty),
            IrExpr::StructValue(struct_id, field_indices, values) => self.emit_expr_struct_value(struct_id, field_indices, values),
            IrExpr::FieldRead(value, struct_id, field_index, ty, span) => self.emit_expr_field_read(value, struct_id, field_index, ty, span),
            IrExpr::ReferenceFieldRead(pointer, struct_id, field_index, ty, span, borrowed) => self.emit_expr_reference_field_read(pointer, struct_id, field_index, ty, span, borrowed),
            IrExpr::ValueAddress(value, ty, pointer_type, span) => self.emit_expr_value_address(value, ty, pointer_type, span),
            IrExpr::CallExpr(target, arguments, return_type) => self.emit_expr_call_expr(target, arguments, return_type),
            IrExpr::IfExpr(condition, then_value, else_value, ty) => self.emit_expr_if_expr(condition, then_value, else_value, ty),
            IrExpr::EnumMatch(value, enum_id, arms, ty) => self.emit_expr_enum_match(value, enum_id, arms, ty),
            IrExpr::Propagate(value, input_enum, output_enum, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred) => self.emit_expr_propagate(value, input_enum, output_enum, success_type, failure_type, success_variant, failure_variant, output_failure_variant, deferred),
            IrExpr::ArrayValue(items) => self.emit_expr_array_value(items),
            IrExpr::ArrayRepeat(value, length) => self.emit_expr_array_repeat(value, length),
            IrExpr::ArrayAsSlice(array, slice_id, length) => self.emit_expr_array_as_slice(array, slice_id, length),
            IrExpr::ArrayIndex(array, index, ty, length) => self.emit_expr_array_index(array, index, ty, length),
            IrExpr::SliceIndex(slice, index, ty) => self.emit_expr_slice_index(slice, index, ty),
            IrExpr::SliceElementAddress(slice, index, ty, span) => self.emit_expr_slice_element_address(slice, index, ty, span),
            IrExpr::AddressOf(slot, ty, pointer_type, span) => self.emit_expr_address_of(slot, ty, pointer_type, span),
            IrExpr::Dereference(pointer, ty) => self.emit_expr_dereference(pointer, ty),
            IrExpr::StringFindOption(value, enum_id) => self.emit_expr_string_find_option(value, enum_id),
            IrExpr::StringAsStr(value) => self.emit_expr_string_as_str(value),
            IrExpr::Binary(op, left, right, ty) => self.emit_expr_binary(op, left, right, ty),
            IrExpr::Negate(value, ty) => self.emit_expr_negate(value, ty),
            IrExpr::Not(value) => self.emit_expr_not(value),
            IrExpr::BitNot(value, ty) => self.emit_expr_bit_not(value, ty),
            IrExpr::FunctionAddress(function, ty) => self.emit_expr_function_address(function, ty),
            IrExpr::CastExpr(value, source, target) => self.emit_expr_cast_expr(value, source, target),
        }
    }
}

// Encodes a decoded program as `Ir <program>`, the form `ryn::ir_codec::encode_ir` writes.
pub fun encode_ir(program: IrProgram) -> String {
    mut writer := IrWriter { out: String(""), program: program }
    writer.word("Ir")
    writer.ir()
    return writer.out
}

extend IrWriter {
    fun emit_ty_scalar(mut self, name: String) -> bool {
        self.raw(name)
        return true
    }

    fun emit_ty_struct_ty(mut self, id: u64) -> bool {
        self.word("Struct")
        self.uint(id)
        return true
    }

    fun emit_ty_enum_ty(mut self, id: u64) -> bool {
        self.word("Enum")
        self.uint(id)
        return true
    }

    fun emit_ty_vec_of(mut self, element: u64) -> bool {
        self.word("Vec")
        self.ty(element)
        return true
    }

    fun emit_ty_slice_of(mut self, element: u64) -> bool {
        self.word("Slice")
        self.ty(element)
        return true
    }

    fun emit_ty_array_of(mut self, element: u64, length: u64) -> bool {
        self.word("Array")
        self.ty(element)
        self.uint(length)
        return true
    }

    fun emit_ty_map_of(mut self, key: u64, value: u64) -> bool {
        self.word("Map")
        self.ty(key)
        self.ty(value)
        return true
    }

    fun emit_ty_set_of(mut self, key: u64, value: u64) -> bool {
        self.word("Set")
        self.ty(key)
        self.ty(value)
        return true
    }

    fun emit_ty_reference_to(mut self, target: u64, mutable: bool) -> bool {
        self.word("Reference")
        self.ty(target)
        self.boolean(mutable)
        return true
    }

    fun emit_ty_raw_pointer_to(mut self, target: u64) -> bool {
        self.word("RawPointer")
        self.ty(target)
        return true
    }

    fun emit_ty_function_pointer_to(mut self, parameters: Vec<u64>, result: Option<u64>, extern_c: bool) -> bool {
        self.word("FunctionPointer")
        self.uint(parameters.len())
        for parameter in parameters {
            self.ty(parameter)
        }
        self.optional_ty(result)
        self.boolean(extern_c)
        return true
    }

    fun emit_print_part_text_part(mut self, text: String) -> bool {
        self.word("Text")
        self.string(text)
        return true
    }

    fun emit_print_part_value_part(mut self, value: u64, ty: u64) -> bool {
        self.word("Value")
        self.expression(value)
        self.ty(ty)
        return true
    }

    fun emit_call_target_func(mut self, id: u64) -> bool {
        self.word("Function")
        self.uint(id)
        return true
    }

    fun emit_call_target_arg_count(mut self) -> bool {
        self.word("ArgumentCount")
        return true
    }

    fun emit_call_target_arg(mut self) -> bool {
        self.word("Argument")
        return true
    }

    fun emit_call_target_string_op(mut self, op: String) -> bool {
        self.word("String")
        self.raw(op)
        return true
    }

    fun emit_call_target_filesystem_op(mut self, op: String) -> bool {
        self.word("Filesystem")
        self.raw(op)
        return true
    }

    fun emit_call_target_try_read(mut self, id: u64) -> bool {
        self.word("TryReadFile")
        self.uint(id)
        return true
    }

    fun emit_call_target_read_file_res(mut self, id: u64) -> bool {
        self.word("ReadFileResult")
        self.uint(id)
        return true
    }

    fun emit_call_target_system_op(mut self, op: String) -> bool {
        self.word("System")
        self.raw(op)
        return true
    }

    fun emit_call_target_indirect_fn(mut self, id: u64) -> bool {
        self.word("IndirectFunctionPointer")
        self.ty(id)
        return true
    }

    fun emit_call_target_vec_op(mut self, op: String, id: u64) -> bool {
        self.word("Vec")
        self.raw(op)
        self.ty(id)
        return true
    }

    fun emit_call_target_vec_slice(mut self, id: u64) -> bool {
        self.word("VecSlice")
        self.ty(id)
        return true
    }

    fun emit_call_target_slice_len(mut self) -> bool {
        self.word("SliceLen")
        return true
    }

    fun emit_call_target_map_op(mut self, op: String, key: u64, value: u64) -> bool {
        self.word("Map")
        self.raw(op)
        self.ty(key)
        self.ty(value)
        return true
    }

    fun emit_call_target_set_op(mut self, op: String, key: u64, value: u64) -> bool {
        self.word("Set")
        self.raw(op)
        self.ty(key)
        self.ty(value)
        return true
    }

    fun emit_call_target_enum_new(mut self, enum_id: u64, tag: u64) -> bool {
        self.word("EnumNew")
        self.uint(enum_id)
        self.uint(tag)
        return true
    }

    fun emit_call_target_enum_predicate(mut self, op: String, id: u64) -> bool {
        self.word("EnumPredicate")
        self.raw(op)
        self.uint(id)
        return true
    }

    fun emit_call_target_enum_unwrap_or(mut self, enum_id: u64, value_type: u64) -> bool {
        self.word("EnumUnwrapOr")
        self.uint(enum_id)
        self.ty(value_type)
        return true
    }

    fun emit_call_target_enum_unwrap(mut self, enum_id: u64, value_type: u64, message: bool, success_tag: u64, failure: String) -> bool {
        self.word("EnumUnwrap")
        self.uint(enum_id)
        self.ty(value_type)
        self.boolean(message)
        self.uint(success_tag)
        self.raw(failure)
        return true
    }

    fun emit_call_target_vec_get_option(mut self, elem_id: u64, option_id: u64, pop: bool) -> bool {
        self.word("VecGetOption")
        self.ty(elem_id)
        self.uint(option_id)
        self.boolean(pop)
        return true
    }

    fun emit_stmt_block_stmt(mut self, body: Vec<u64>) -> bool {
        self.word("Block")
        self.statement_list(body)
        return true
    }

    fun emit_stmt_drop_stmt(mut self, slots: Vec<u64>, types: Vec<u64>) -> bool {
        self.word("Drop")
        self.uint(slots.len())
        mut at: u64 = 0
        while at < slots.len() {
            self.uint(slots[at])
            self.ty(types[at])
            at += 1
        }
        return true
    }

    fun emit_stmt_let_stmt(mut self, slot: u64, ty: u64, value: u64, span: IrSpan) -> bool {
        self.word("Let")
        self.uint(slot)
        self.ty(ty)
        self.expression(value)
        self.span(span)
        return true
    }

    fun emit_stmt_assign_stmt(mut self, slot: u64, ty: u64, value: u64, span: IrSpan) -> bool {
        self.word("Assign")
        self.uint(slot)
        self.ty(ty)
        self.expression(value)
        self.span(span)
        return true
    }

    fun emit_stmt_array_assign_stmt(mut self, slot: u64, element: u64, length: u64, index: u64, value: u64, span: IrSpan) -> bool {
        self.word("ArrayAssign")
        self.uint(slot)
        self.ty(element)
        self.uint(length)
        self.expression(index)
        self.expression(value)
        self.span(span)
        return true
    }

    fun emit_stmt_dereference_assign_stmt(mut self, pointer: u64, ty: u64, value: u64) -> bool {
        self.word("DereferenceAssign")
        self.expression(pointer)
        self.ty(ty)
        self.expression(value)
        return true
    }

    fun emit_stmt_field_assign_stmt(mut self, slot: u64, ty: u64, value: u64) -> bool {
        self.word("FieldAssign")
        self.uint(slot)
        self.ty(ty)
        self.expression(value)
        return true
    }

    fun emit_stmt_reference_field_assign_stmt(mut self, pointer: u64, struct_id: u64, field_index: u64, ty: u64, value: u64) -> bool {
        self.word("ReferenceFieldAssign")
        self.expression(pointer)
        self.uint(struct_id)
        self.uint(field_index)
        self.ty(ty)
        self.expression(value)
        return true
    }

    fun emit_stmt_print_stmt(mut self, value: u64, ty: u64) -> bool {
        self.word("Print")
        self.expression(value)
        self.ty(ty)
        return true
    }

    fun emit_stmt_print_template_stmt(mut self, parts: Vec<u64>) -> bool {
        self.word("PrintTemplate")
        self.uint(parts.len())
        for part in parts {
            self.print_part(part)
        }
        return true
    }

    fun emit_stmt_call_stmt(mut self, target: CallTarget, arguments: Vec<u64>) -> bool {
        self.word("CallStatement")
        self.call_target(target)
        self.expression_list(arguments)
        return true
    }

    fun emit_stmt_if_stmt(mut self, condition: u64, then_body: Vec<u64>, else_body: Vec<u64>) -> bool {
        self.word("IfStatement")
        self.expression(condition)
        self.statement_list(then_body)
        self.statement_list(else_body)
        return true
    }

    fun emit_stmt_while_stmt(mut self, setup: Vec<u64>, condition: u64, body: Vec<u64>) -> bool {
        self.word("While")
        self.statement_list(setup)
        self.expression(condition)
        self.statement_list(body)
        return true
    }

    fun emit_stmt_for_stmt(mut self, slot: u64, end_slot: u64, ty: u64, start: u64, end: u64, inclusive: bool, body: Vec<u64>) -> bool {
        self.word("For")
        self.uint(slot)
        self.uint(end_slot)
        self.ty(ty)
        self.expression(start)
        self.expression(end)
        self.boolean(inclusive)
        self.statement_list(body)
        return true
    }

    fun emit_stmt_break_stmt(mut self) -> bool {
        self.word("Break")
        return true
    }

    fun emit_stmt_continue_stmt(mut self) -> bool {
        self.word("Continue")
        return true
    }

    fun emit_stmt_return_stmt(mut self, value: Option<u64>) -> bool {
        self.word("Return")
        self.optional_expr(value)
        return true
    }

    fun emit_expr_integer_lit(mut self, text: String, ty: u64) -> bool {
        self.word("Integer")
        self.raw(text)
        self.ty(ty)
        return true
    }

    fun emit_expr_float_lit(mut self, bits: u64, ty: u64) -> bool {
        self.word("Float")
        self.uint(bits)
        self.ty(ty)
        return true
    }

    fun emit_expr_str_lit(mut self, text: String) -> bool {
        self.word("String")
        self.string(text)
        return true
    }

    fun emit_expr_char_lit(mut self, scalar: u64) -> bool {
        self.word("Character")
        self.uint(scalar)
        return true
    }

    fun emit_expr_bool_lit(mut self, value: bool) -> bool {
        self.word("Boolean")
        self.boolean(value)
        return true
    }

    fun emit_expr_local_ref(mut self, slot: u64, ty: u64, span: IrSpan) -> bool {
        self.word("Local")
        self.uint(slot)
        self.ty(ty)
        self.span(span)
        return true
    }

    fun emit_expr_move_ref(mut self, slot: u64, ty: u64) -> bool {
        self.word("Move")
        self.uint(slot)
        self.ty(ty)
        return true
    }

    fun emit_expr_struct_value(mut self, struct_id: u64, field_indices: Vec<u64>, values: Vec<u64>) -> bool {
        self.word("StructValue")
        self.uint(struct_id)
        self.uint(field_indices.len())
        mut at: u64 = 0
        while at < field_indices.len() {
            self.uint(field_indices[at])
            self.expression(values[at])
            at += 1
        }
        return true
    }

    fun emit_expr_field_read(mut self, value: u64, struct_id: u64, field_index: u64, ty: u64, span: IrSpan) -> bool {
        self.word("Field")
        self.expression(value)
        self.uint(struct_id)
        self.uint(field_index)
        self.ty(ty)
        self.span(span)
        return true
    }

    fun emit_expr_reference_field_read(mut self, pointer: u64, struct_id: u64, field_index: u64, ty: u64, span: IrSpan, borrowed: bool) -> bool {
        self.word("ReferenceField")
        self.expression(pointer)
        self.uint(struct_id)
        self.uint(field_index)
        self.ty(ty)
        self.span(span)
        self.boolean(borrowed)
        return true
    }

    fun emit_expr_value_address(mut self, value: u64, ty: u64, pointer_type: u64, span: IrSpan) -> bool {
        self.word("ValueAddress")
        self.expression(value)
        self.ty(ty)
        self.ty(pointer_type)
        self.span(span)
        return true
    }

    fun emit_expr_call_expr(mut self, target: CallTarget, arguments: Vec<u64>, return_type: u64) -> bool {
        self.word("Call")
        self.call_target(target)
        self.expression_list(arguments)
        self.ty(return_type)
        return true
    }

    fun emit_expr_if_expr(mut self, condition: u64, then_value: u64, else_value: u64, ty: u64) -> bool {
        self.word("If")
        self.expression(condition)
        self.expression(then_value)
        self.expression(else_value)
        self.ty(ty)
        return true
    }

    fun emit_expr_enum_match(mut self, value: u64, enum_id: u64, arms: Vec<u64>, ty: u64) -> bool {
        self.word("EnumMatch")
        self.expression(value)
        self.uint(enum_id)
        self.uint(arms.len())
        for arm in arms {
            self.match_arm(arm)
        }
        self.ty(ty)
        return true
    }

    fun emit_expr_propagate(mut self, value: u64, input_enum: u64, output_enum: u64, success_type: u64, failure_type: Option<u64>, success_variant: u64, failure_variant: u64, output_failure_variant: u64, deferred: Vec<u64>) -> bool {
        self.word("Propagate")
        self.expression(value)
        self.uint(input_enum)
        self.uint(output_enum)
        self.ty(success_type)
        self.optional_ty(failure_type)
        self.uint(success_variant)
        self.uint(failure_variant)
        self.uint(output_failure_variant)
        self.statement_list(deferred)
        return true
    }

    fun emit_expr_array_value(mut self, items: Vec<u64>) -> bool {
        self.word("ArrayValue")
        self.expression_list(items)
        return true
    }

    fun emit_expr_array_repeat(mut self, value: u64, length: u64) -> bool {
        self.word("ArrayRepeat")
        self.expression(value)
        self.uint(length)
        return true
    }

    fun emit_expr_array_as_slice(mut self, array: u64, slice_id: u64, length: u64) -> bool {
        self.word("ArrayAsSlice")
        self.expression(array)
        self.ty(slice_id)
        self.uint(length)
        return true
    }

    fun emit_expr_array_index(mut self, array: u64, index: u64, ty: u64, length: u64) -> bool {
        self.word("ArrayIndex")
        self.expression(array)
        self.expression(index)
        self.ty(ty)
        self.uint(length)
        return true
    }

    fun emit_expr_slice_index(mut self, slice: u64, index: u64, ty: u64) -> bool {
        self.word("SliceIndex")
        self.expression(slice)
        self.expression(index)
        self.ty(ty)
        return true
    }

    fun emit_expr_slice_element_address(mut self, slice: u64, index: u64, ty: u64, span: IrSpan) -> bool {
        self.word("SliceElementAddress")
        self.expression(slice)
        self.expression(index)
        self.ty(ty)
        self.span(span)
        return true
    }

    fun emit_expr_address_of(mut self, slot: u64, ty: u64, pointer_type: u64, span: IrSpan) -> bool {
        self.word("AddressOf")
        self.uint(slot)
        self.ty(ty)
        self.ty(pointer_type)
        self.span(span)
        return true
    }

    fun emit_expr_dereference(mut self, pointer: u64, ty: u64) -> bool {
        self.word("Dereference")
        self.expression(pointer)
        self.ty(ty)
        return true
    }

    fun emit_expr_string_find_option(mut self, value: u64, enum_id: u64) -> bool {
        self.word("StringFindOption")
        self.expression(value)
        self.uint(enum_id)
        return true
    }

    fun emit_expr_string_as_str(mut self, value: u64) -> bool {
        self.word("StringAsStr")
        self.expression(value)
        return true
    }

    fun emit_expr_binary(mut self, op: String, left: u64, right: u64, ty: u64) -> bool {
        self.word("Binary")
        self.raw(op)
        self.expression(left)
        self.expression(right)
        self.ty(ty)
        return true
    }

    fun emit_expr_negate(mut self, value: u64, ty: u64) -> bool {
        self.word("Negate")
        self.expression(value)
        self.ty(ty)
        return true
    }

    fun emit_expr_not(mut self, value: u64) -> bool {
        self.word("Not")
        self.expression(value)
        return true
    }

    fun emit_expr_bit_not(mut self, value: u64, ty: u64) -> bool {
        self.word("BitNot")
        self.expression(value)
        self.ty(ty)
        return true
    }

    fun emit_expr_function_address(mut self, function: u64, ty: u64) -> bool {
        self.word("FunctionAddress")
        self.uint(function)
        self.ty(ty)
        return true
    }

    fun emit_expr_cast_expr(mut self, value: u64, source: u64, target: u64) -> bool {
        self.word("Cast")
        self.expression(value)
        self.ty(source)
        self.ty(target)
        return true
    }

}
