// rync: the Ryn compiler as one program that needs neither the Rust compiler nor a C library. It reads a program (an entry
// file, or a project directory with `ryn.yaml` and `src/main.ryn`, and the modules it imports) and writes a static x86-64
// Linux executable.
//
//     rync [build] [options] <entry.ryn | project-dir>      compile; the executable goes to `-o <path>` or standard output
//     rync check [options] <entry.ryn | project-dir>        check the program without generating code
//     rync --version
//
// Options:
//     -o, --output <path>        write the executable to a file with mode 0755
//     --stdlib <directory>       where `std::x` is found (`x.ryn`); `stdlib/std/src` by default
//     --package <name>=<dir>     the source directory of a dependency package (repeatable); it takes precedence over the
//                                path dependencies of the manifests
//
// The pipeline is the compiler's own: the modules are joined into one source text and parsed (`frontend/parser`), each item
// takes the module it came from, generic functions are specialized (`frontend/generics`), compile-time code is evaluated
// (`middle/comptime`), extended patterns are rewritten (`middle/desugar`), the program is lowered to typed IR with its
// ownership checks (`middle/lower`), and the IR is turned into machine code and linked (`back/gen`, `back/elf`). A module
// `a::b` is the file `a/b.ryn` (or `a/b/mod.ryn`) in the source directory of its package; `std::x` is `x.ryn` in the
// standard library directory.
//
// Status 0 means success, 1 an error in the program (its diagnostics go to standard error in the form the bootstrap
// compiler writes), 2 invalid command arguments, and 3 a valid program the native pipeline cannot compile.

use frontend::parser
use frontend::generics
use middle::ast
use middle::ir
use middle::lower
use middle::comptime
use middle::desugar
use back::gen
use back::arm64
use back::spirv
use driver::report
use driver::manifest
use std::fs
use std::env
use std::system
use std::time

extern "C" fun putchar(value: i32) -> i32;
extern "C" fun getpid() -> i32;
extern "C" fun malloc(size: u64) -> *u8;
extern "C" fun free(pointer: *u8);
extern "C" fun fopen(path: *u8, mode: *u8) -> *u8;
extern "C" fun fwrite(data: *u8, size: u64, count: u64, file: *u8) -> u64;
extern "C" fun fclose(file: *u8) -> i32;
extern "C" fun chmod(path: *u8, mode: u32) -> i32;

// One source file of the program.
#[derive(Clone)]
struct Unit {
    path: String,
    module_path: String,
    text: String,
    // The public type aliases of the module: name, type parameters joined by `, `, and the text of the aliased type.
    alias_names: Vec<String>,
    alias_parameters: Vec<String>,
    alias_types: Vec<String>,
    public_items: Vec<String>,
    // The modules it imports (`a::b`) and the names they are known by.
    import_paths: Vec<String>,
    import_locals: Vec<String>,
}

struct Loader {
    std_root: String,
    package_names: Vec<String>,
    package_roots: Vec<String>,
    units: Vec<Unit>,
    // The files found so far with their module paths, and the module paths being loaded now (for a cycle).
    found_files: Vec<String>,
    found_modules: Vec<String>,
    importing: Vec<String>,
    error: String,
}

// The text of a part of the joined program: its byte range and its unit.
#[derive(Clone)]
struct Segment {
    start: u64,
    end: u64,
    unit: u64,
}

#[derive(Clone)]
struct Compilation {
    units: Vec<Unit>,
    segments: Vec<Segment>,
    // The single file of a program without modules is compiled as it is written (no segments).
    single: bool,
    // The joined text of a program of modules.
    joined: String,
}

fun rync_join_components(components: Vec<String>, separator: str) -> String {
    mut out := String("")
    mut at: u64 = 0
    while at < components.len() {
        when at > 0 {
            out.append(separator)
        }
        out.append(components[at].clone())
        at += 1
    }
    return out
}

// The frontend's output when it begins with the status word " Ok" (the data follows it), and nothing for an error.
fun rync_after_ok(text: String) -> Option<String> {
    when text.starts_with(" Ok") {
        return Option::Some(text)
    }
    return Option::None
}

fun rync_display_module(module_path: String) -> String {
    when module_path.is_empty() {
        return String("main")
    }
    return module_path
}

// The rendered diagnostics of a frontend result that failed, against one file.
fun rync_render_frontend(text: String, path: String, source: String) -> String {
    mut out := String("")
    for diagnostic in report::frontend_diagnostics(text) {
        when !out.is_empty() {
            out.append("\n\n")
        }
        out.append(report::render(diagnostic, path.clone(), source.clone()))
    }
    when out.is_empty() {
        return report::plain("R0903", String("the self-hosted frontend wrote output that cannot be read"))
    }
    return out
}

extend Loader {
    fun package_root(self, name: String) -> Option<String> {
        mut at: u64 = 0
        while at < self.package_names.len() {
            when self.package_names[at] == name {
                return Option::Some(self.package_roots[at].clone())
            }
            at += 1
        }
        return Option::None
    }

    // The package root and file of module `components`, imported from a module of the package at `source_root`.
    fun resolve(self, components: Vec<String>, source_root: String) -> Result<Vec<String>, String> {
        joined := rync_join_components(components.clone(), "::")
        when components.is_empty() {
            return Result::Err(String("error[R0420]: empty module path"))
        }
        mut root := source_root
        mut first: u64 = 0
        dependency := self.package_root(components[0].clone())
        when dependency.is_some() {
            root = dependency.unwrap()
            first = 1
        }
        when first >= components.len() {
            mut message := String("error[R0420]: module path `")
            message.append(joined)
            message.append("` must name a module inside its package")
            return Result::Err(message)
        }
        mut base := root.clone()
        mut at := first
        while at < components.len() {
            component := components[at].clone()
            when component.is_empty() || component == "." || component == ".." {
                mut message := String("error[R0420]: invalid module path `")
                message.append(joined)
                message.append("`")
                return Result::Err(message)
            }
            base.append("/")
            base.append(component)
            at += 1
        }
        mut file := base.clone()
        file.append(".ryn")
        mut found: Vec<String> = Vec()
        found.push(root)
        when components[0] == "std" && file_exists(file.clone()) {
            found.push(file)
            return Result::Ok(found)
        }
        mut directory_file := base.clone()
        directory_file.append("/mod.ryn")
        when file_exists(file.clone()) {
            found.push(file)
            return Result::Ok(found)
        }
        when file_exists(directory_file.clone()) {
            found.push(directory_file)
            return Result::Ok(found)
        }
        when components.len() > first + 1 {
            mut parent := components.clone()
            parent.pop()
            resolved := self.resolve(parent.clone(), found[0].clone())
            when resolved.is_ok() {
                mut place := resolved.unwrap()
                place.push(rync_join_components(parent, "::"))
                return Result::Ok(place)
            }
        }
        mut message := String("error[R0420]: module `")
        message.append(joined)
        message.append("` not found (looked for ")
        message.append(file)
        message.append(" and ")
        message.append(directory_file)
        message.append(")")
        return Result::Err(message)
    }

    // Loads the runtime module. It imports nothing and declares no public alias, which `load` would find by parsing its 2700
    // lines (a quarter of the build of a small program); the front end parses it once, later. A module that does either is
    // loaded as any other.
    fun load_runtime(mut self, file: String, module_path: String, source_root: String) -> bool {
        read := read_file_result(file.clone())
        when read.is_err() || !env::get("RYN_NO_PRUNE").is_empty() {
            return self.load(file, module_path, source_root)
        }
        text := read.unwrap()
        when text.starts_with("use ") || text.find("\nuse ").is_some() || text.find("pub type").is_some() {
            return self.load(file, module_path, source_root)
        }
        self.found_files.push(file.clone())
        self.found_modules.push(module_path.clone())
        self.units.push(Unit { path: file, module_path: module_path, text: text, alias_names: Vec(), alias_parameters: Vec(), alias_types: Vec(), public_items: Vec(), import_paths: Vec(), import_locals: Vec() })
        return true
    }

    // Loads the module in `file` after every module it imports, so that the modules are in dependency order.
    fun load(mut self, file: String, module_path: String, source_root: String) -> bool {
        mut seen: u64 = 0
        while seen < self.found_files.len() {
            when self.found_files[seen] == file {
                previous := self.found_modules[seen].clone()
                when previous != module_path {
                    self.error = String("error[R0423]: source file ")
                    self.error.append(file)
                    self.error.append(" is imported under both `")
                    self.error.append(previous)
                    self.error.append("` and `")
                    self.error.append(module_path)
                    self.error.append("`")
                    return false
                }
                mut open: u64 = 0
                while open < self.importing.len() {
                    when self.importing[open] == module_path {
                        mut chain := String("")
                        mut link := open
                        while link < self.importing.len() {
                            chain.append(rync_display_module(self.importing[link].clone()))
                            chain.append(" -> ")
                            link += 1
                        }
                        chain.append(rync_display_module(module_path.clone()))
                        self.error = String("error[R0427]: circular module dependency: ")
                        self.error.append(chain)
                        self.error.append("\n  help: move the shared declarations into a module that both import")
                        return false
                    }
                    open += 1
                }
                return true
            }
            seen += 1
        }
        self.found_files.push(file.clone())
        self.found_modules.push(module_path.clone())
        self.importing.push(module_path.clone())
        when !file_exists(file.clone()) {
            when module_path.starts_with("std::") {
                self.error = String("error[R0420]: standard module `")
                self.error.append(module_path)
                self.error.append("` is not available")
            } else {
                self.error = String("error[R0420]: cannot read module ")
                self.error.append(file)
                self.error.append(": No such file or directory (os error 2)")
            }
            return false
        }
        read := read_file_result(file.clone())
        when read.is_err() {
            code := read.unwrap_err()
            self.error = String("error[R0001]: cannot read ")
            self.error.append(file)
            when code == 3 {
                self.error.append(": stream did not contain valid UTF-8")
            } else when code == 2 {
                self.error.append(": Permission denied (os error 13)")
            } else {
                self.error.append(": No such file or directory (os error 2)")
            }
            return false
        }
        text := rync_expand_bitflags(read.unwrap())
        parsed_text := parser::parse(text.clone(), true)
        parsed := rync_after_ok(parsed_text.clone())
        when parsed.is_none() {
            self.error = rync_render_frontend(parsed_text, file, text)
            return false
        }
        decoded := ast::decode_program(parsed.unwrap())
        when decoded.is_err() {
            self.error = report::plain("R0903", String("the self-hosted frontend wrote a syntax tree that cannot be read"))
            return false
        }
        program := decoded.unwrap()
        mut unit := Unit { path: file.clone(), module_path: module_path.clone(), text: text.clone(), alias_names: Vec(), alias_parameters: Vec(), alias_types: Vec(), public_items: Vec(), import_paths: Vec(), import_locals: Vec() }
        for index in program.structs.clone() {
            definition := program.struct_defs[index]
            when definition.public { unit.public_items.push(definition.name.clone()) }
        }
        for index in program.enums.clone() {
            definition := program.enum_defs[index]
            when definition.public { unit.public_items.push(definition.name.clone()) }
        }
        for index in program.functions.clone() {
            definition := program.function_defs[index]
            when definition.public { unit.public_items.push(definition.name.clone()) }
        }
        for alias_index in program.type_aliases.clone() {
            alias := program.alias_defs[alias_index]
            when alias.public && alias.span.end <= text.len() {
                unit.public_items.push(alias.name.clone())
                declared := text.slice(alias.span.start, alias.span.end)
                equals := declared.find("=")
                when equals.is_some() {
                    unit.alias_names.push(alias.name.clone())
                    unit.alias_parameters.push(rync_join_components(alias.type_parameters.clone(), ", "))
                    unit.alias_types.push(declared.slice(equals.unwrap() + 1, declared.len()).trim())
                }
            }
        }
        mut use_at: u64 = 0
        while use_at < program.uses.len() {
            declaration := program.use_decls[program.uses[use_at]]
            components := declaration.path.clone()
            imported := rync_join_components(components.clone(), "::")
            when components.len() > 0 {
                unit.import_paths.push(imported.clone())
                when declaration.alias.is_some() {
                    unit.import_locals.push(declaration.alias.unwrap())
                } else {
                    unit.import_locals.push(components[components.len() - 1].clone())
                }
            }
            resolved := self.resolve(components, source_root.clone())
            when resolved.is_err() {
                self.error = resolved.unwrap_err()
                self.error.append("\n  imported from ")
                self.error.append(file.clone())
                return false
            }
            place := resolved.unwrap()
            mut loaded_module := imported.clone()
            when place.len() > 2 { loaded_module = place[2].clone() }
            when !self.load(place[1].clone(), loaded_module.clone(), place[0].clone()) {
                return false
            }
            when place.len() > 2 {
                item := imported.slice(loaded_module.len() + 2, imported.len())
                mut visible := false
                for provider in self.units.clone() {
                    when provider.module_path == loaded_module {
                        for name in provider.public_items.clone() { when name == item { visible = true } }
                    }
                }
                when !visible {
                    self.error = String("error[R0425]: unknown or private imported item `")
                    self.error.append(imported)
                    self.error.append("`")
                    return false
                }
            }
            use_at += 1
        }
        self.importing.pop()
        self.units.push(unit)
        return true
    }
}

extend Compilation {
    // The unit and the span in it of a span of the joined text; `diagnostic` keeps its message.
    fun render(self, diagnostic: report::Diagnostic) -> String {
        // Secondary loan spans remain inside the existing help string wire format, so
        // bootstrap readers stay compatible. Map both spans through the joined modules.
        when diagnostic.code == "R0249" && diagnostic.help.starts_with("@borrow ") {
            first := diagnostic.help.split("\n")[0].clone()
            fields := first.split(" ")
            when fields.len() == 3 && first.len() < diagnostic.help.len() {
                start := fields[1].try_parse::<u64>()
                end := fields[2].try_parse::<u64>()
                when start.is_some() && end.is_some() {
                    primary := report::Diagnostic { code: diagnostic.code.clone(), message: diagnostic.message.clone(), start: diagnostic.start, end: diagnostic.end, has_help: true, help: diagnostic.help.slice(first.len() + 1, diagnostic.help.len()) }
                    note := report::Diagnostic { code: String("R0249"), message: String("borrow starts here"), start: start.unwrap(), end: end.unwrap(), has_help: false, help: String("") }
                    mut out := self.render(primary)
                    out.append("\n")
                    out.append(self.render(note).replace("error[R0249]:", "note:"))
                    return out
                }
            }
        }
        when self.single {
            unit := self.units[0]
            return report::render(diagnostic, unit.path.clone(), unit.text.clone())
        }
        for segment in self.segments.clone() {
            when segment.start <= diagnostic.start && diagnostic.start <= segment.end {
                unit := self.units[segment.unit]
                mut start := diagnostic.start - segment.start
                mut end: u64 = 0
                when diagnostic.end > segment.start {
                    end = diagnostic.end - segment.start
                }
                when start > unit.text.len() {
                    start = unit.text.len()
                }
                when end > unit.text.len() {
                    end = unit.text.len()
                }
                local := report::Diagnostic { code: diagnostic.code.clone(), message: diagnostic.message.clone(), start: start, end: end, has_help: diagnostic.has_help, help: diagnostic.help.clone() }
                return report::render(local, unit.path.clone(), unit.text.clone())
            }
        }
        return report::render_plain(diagnostic)
    }

    fun render_frontend(self, text: String) -> String {
        mut out := String("")
        for diagnostic in report::frontend_diagnostics(text) {
            when !out.is_empty() {
                out.append("\n\n")
            }
            out.append(self.render(diagnostic))
        }
        when out.is_empty() {
            return report::plain("R0903", String("the self-hosted frontend wrote output that cannot be read"))
        }
        return out
    }

    // A failure of a middle stage: a diagnostic of the program (status 1) or a construct the pipeline lacks (status 3).
    fun stage_failure(self, text: String) -> Failure {
        all := report::lowered_diagnostics(text.clone())
        when all.len() > 1 {
            mut rendered := String("")
            for each in all {
                when !rendered.is_empty() {
                    rendered.append("\n\n")
                }
                rendered.append(self.render(each))
            }
            return Failure { text: rendered, status: 1 }
        }
        diagnostic := report::lowered_diagnostic(text.clone())
        when diagnostic.is_some() {
            found := diagnostic.unwrap()
            // `R0905` is the backend's report of a construct it lacks, at the place of the construct.
            when found.code == "R0905" {
                mut message := String("the native compiler cannot compile this program: ")
                message.append(found.message.clone())
                placed := report::Diagnostic { code: found.code.clone(), message: message, start: found.start, end: found.end, has_help: true, help: String("this construct is not supported by the native backend yet; simplify it or report it as a compiler limitation") }
                return Failure { text: self.render(placed), status: 3 }
            }
            return Failure { text: self.render(found), status: 1 }
        }
        return rync_unsupported(text)
    }
}

#[derive(Clone)]
struct Failure {
    text: String,
    status: i32,
}

fun rync_unsupported(reason: String) -> Failure {
    mut message := String("the native compiler cannot compile this program: ")
    message.append(reason)
    return Failure { text: report::plain("R0905", message), status: 3 }
}

// The segment index holding byte `position`, if any.
fun rync_segment_of(segments: Vec<Segment>, position: u64) -> Option<u64> {
    mut at: u64 = 0
    while at < segments.len() {
        when segments[at].start <= position && position < segments[at].end {
            return Option::Some(at)
        }
        at += 1
    }
    return Option::None
}

// Joins the units into one program text: each starts in the root namespace, and the public type aliases of a module are
// declared again under the name that imports it.
fun rync_join(units: Vec<Unit>) -> Compilation {
    mut text := String("")
    mut segments: Vec<Segment> = Vec()
    mut emitted: Vec<String> = Vec()
    mut at: u64 = 0
    while at < units.len() {
        unit := units[at]
        when !text.is_empty() {
            when !text.ends_with("\n") {
                text.push('\n')
            }
            text.append("namespace;\n")
        }
        mut import_at: u64 = 0
        while import_at < unit.import_paths.len() {
            imported := unit.import_paths[import_at].clone()
            local := unit.import_locals[import_at].clone()
            for provider in units.clone() {
                mut item_prefix := provider.module_path.clone()
                item_prefix.append("::")
                when imported.starts_with(item_prefix.clone()) {
                    item := imported.slice(item_prefix.len(), imported.len())
                    mut selected: u64 = 0
                    while selected < provider.alias_names.len() {
                        when provider.alias_names[selected] == item && local != item {
                            text.append("type ")
                            text.append(local.clone())
                            parameters := provider.alias_parameters[selected].clone()
                            when !parameters.is_empty() { text.append("<") text.append(parameters.clone()) text.append(">") }
                            text.append(" = ")
                            text.append(item.clone())
                            when !parameters.is_empty() { text.append("<") text.append(parameters) text.append(">") }
                            text.push('\n')
                        }
                        selected += 1
                    }
                }
                when provider.module_path == imported {
                    mut alias_at: u64 = 0
                    while alias_at < provider.alias_names.len() {
                        name := provider.alias_names[alias_at].clone()
                        mut namespace_text := local.clone()
                        mut leaf := name.clone()
                        mut cut := name.len()
                        mut found_cut := false
                        while cut > 1 && !found_cut {
                            cut -= 1
                            when (name.byte_at(cut) as u64) == 58 && (name.byte_at(cut - 1) as u64) == 58 {
                                found_cut = true
                            }
                        }
                        when found_cut {
                            namespace_text.append("::")
                            namespace_text.append(name.slice(0, cut - 1))
                            leaf = name.slice(cut + 1, name.len())
                        }
                        mut exported := namespace_text.clone()
                        exported.append("::")
                        exported.append(leaf.clone())
                        mut seen := false
                        for done in emitted.clone() {
                            when done == exported {
                                seen = true
                            }
                        }
                        when !seen {
                            emitted.push(exported)
                            text.append("namespace ")
                            text.append(namespace_text)
                            text.append(";\ntype ")
                            text.append(leaf)
                            parameters := provider.alias_parameters[alias_at].clone()
                            when !parameters.is_empty() {
                                text.append("<")
                                text.append(parameters)
                                text.append(">")
                            }
                            text.append(" = ")
                            text.append(provider.alias_types[alias_at].clone())
                            text.append("\nnamespace;\n")
                        }
                        alias_at += 1
                    }
                }
            }
            import_at += 1
        }
        start := text.len()
        text.append(unit.text.clone())
        segments.push(Segment { start: start, end: text.len(), unit: at })
        text.push('\n')
        at += 1
    }
    return Compilation { units: units, segments: segments, single: false, joined: text }
}

// Gives every item the module it came from, and names the functions of a module by it.
fun rync_assign_modules(compilation: Compilation, parsed: ast::Program) -> Result<ast::Program, Failure> {
    mut program := parsed
    segments := compilation.segments.clone()
    mut modules: Vec<String> = Vec()
    for segment in segments.clone() {
        modules.push(compilation.units[segment.unit].module_path.clone())
    }
    // The names of the root functions, which a module function may not share.
    mut root_names: Vec<String> = Vec()
    mut f: u64 = 0
    while f < program.function_defs.len() {
        segment := rync_segment_of(segments.clone(), program.function_defs[f].span.start)
        when segment.is_some() && modules[segment.unwrap()].is_empty() {
            root_names.push(program.function_defs[f].name.clone())
        }
        f += 1
    }
    f = 0
    while f < program.function_defs.len() {
        segment := rync_segment_of(segments.clone(), program.function_defs[f].span.start)
        when segment.is_some() {
            module := modules[segment.unwrap()].clone()
            mut function := program.function_defs[f]
            function.module_path = module.clone()
            when !module.is_empty() {
                // The runtime module may declare C functions that a program declares too.
                when module != "std::native" && module != "std::native_windows" {
                    for taken in root_names.clone() {
                        when taken == function.name {
                            mut message := String("module function `")
                            message.append(function.name.clone())
                            message.append("` conflicts with a root function")
                            conflict := report::Diagnostic { code: String("R0421"), message: message, start: function.span.start, end: function.span.end, has_help: true, help: String("rename the root or module function") }
                            return Result::Err(Failure { text: compilation.render(conflict), status: 1 })
                        }
                    }
                }
                mut qualified := module
                qualified.append("::")
                qualified.append(function.name.clone())
                function.name = qualified
            }
            program.function_defs.set(f, function)
        }
        f += 1
    }
    mut s: u64 = 0
    while s < program.struct_defs.len() {
        segment := rync_segment_of(segments.clone(), program.struct_defs[s].span.start)
        when segment.is_some() {
            module := modules[segment.unwrap()].clone()
            mut definition := program.struct_defs[s]
            definition.module_path = module.clone()
            when !module.is_empty() && definition.drop_function.is_some() {
                routine := definition.drop_function.unwrap()
                mut named := routine.clone()
                when !routine.contains("::") {
                    named = module.clone()
                    named.append("::")
                    named.append(routine)
                }
                definition.drop_function = Option::Some(named)
            }
            program.struct_defs.set(s, definition)
        }
        s += 1
    }
    mut e: u64 = 0
    while e < program.enum_defs.len() {
        segment := rync_segment_of(segments.clone(), program.enum_defs[e].span.start)
        when segment.is_some() && !program.enum_defs[e].name.starts_with("$Ryn") {
            mut definition := program.enum_defs[e]
            definition.module_path = modules[segment.unwrap()].clone()
            program.enum_defs.set(e, definition)
        }
        e += 1
    }
    mut h: u64 = 0
    while h < program.shape_defs.len() {
        segment := rync_segment_of(segments.clone(), program.shape_defs[h].span.start)
        when segment.is_some() {
            mut definition := program.shape_defs[h]
            definition.module_path = modules[segment.unwrap()].clone()
            program.shape_defs.set(h, definition)
        }
        h += 1
    }
    mut a: u64 = 0
    while a < program.alias_defs.len() {
        segment := rync_segment_of(segments.clone(), program.alias_defs[a].span.start)
        when segment.is_some() {
            mut definition := program.alias_defs[a]
            definition.module_path = modules[segment.unwrap()].clone()
            program.alias_defs.set(a, definition)
        }
        a += 1
    }
    return Result::Ok(program)
}

// With `RYN_TIMINGS` set, `rync` writes the time of each phase to standard error: the seconds since `since`, measured now.
fun rync_tick(label: str, since: f64) -> f64 {
    now := time::monotonic()
    when !env::get("RYN_TIMINGS").is_empty() {
        milliseconds := ((now - since) * 1000000.0) as u64
        mut line := String("timing ")
        line.append(label)
        line.append(": ")
        line.append((milliseconds / 1000).to_string())
        line.append(".")
        fraction := milliseconds % 1000
        when fraction < 100 {
            line.append("0")
        }
        when fraction < 10 {
            line.append("0")
        }
        line.append(fraction.to_string())
        line.append(" ms")
        eprint("{}", line)
    }
    return now
}

// ---------------------------------------------------------------------------------------------------------------- the runtime module
// Every program is compiled with `std::native`, the runtime written in Ryn: 2700 lines that all the phases before the code
// generator read, although a program reaches few of its functions (hello world reaches none) and the lowering is lazy. So the
// functions the program may reach are kept, and the other `__rt_` functions keep their header and get a body that the lowering
// rejects; if the lowering reaches one of them anyway, the whole front end runs again with the module as it is.

fun rync_ident_byte(byte: u64) -> bool {
    return (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
}

// Every identifier of `text`.
fun rync_words_of(text: String) -> Vec<String> {
    mut words: Vec<String> = Vec()
    mut at: u64 = 0
    while at < text.len() {
        when rync_ident_byte(text.byte_at(at) as u64) {
            mut end := at + 1
            while end < text.len() && rync_ident_byte(text.byte_at(end) as u64) {
                end += 1
            }
            words.push(text.slice(at, end))
            at = end
        } else {
            at += 1
        }
    }
    return words
}

// The name of the function a header line `fun name(` or `pub fun name(` declares, or an empty string.
fun rync_function_name(line: String) -> String {
    mut at: u64 = 0
    when line.starts_with("pub fun ") {
        at = 8
    } else when line.starts_with("fun ") {
        at = 4
    } else {
        return String("")
    }
    mut end := at
    while end < line.len() && rync_ident_byte(line.byte_at(end) as u64) {
        end += 1
    }
    return line.slice(at, end)
}

// The module text with the functions the program does not use cut down. `words` holds the identifiers of every other module
// of the program.
fun rync_prune_runtime(runtime: String, words: Map<String, bool>) -> String {
    mut starts: Vec<u64> = Vec()
    mut header_ends: Vec<u64> = Vec()
    mut ends: Vec<u64> = Vec()
    mut names: Vec<String> = Vec()
    mut at: u64 = 0
    while at < runtime.len() {
        mut line_end := at
        while line_end < runtime.len() && (runtime.byte_at(line_end) as u64) != 10 {
            line_end += 1
        }
        // Only a line that starts with `fun` or `pub fun` can start a function, so the rest is not copied.
        mut name := String("")
        when (runtime.byte_at(at) as u64) == 102 || (runtime.byte_at(at) as u64) == 112 {
            name = rync_function_name(runtime.slice(at, line_end))
        }
        when !name.is_empty() {
            // The function ends at the next line that is a closing brace alone.
            mut cursor := line_end + 1
            mut done: bool = false
            while cursor < runtime.len() && !done {
                mut next_end := cursor
                while next_end < runtime.len() && (runtime.byte_at(next_end) as u64) != 10 {
                    next_end += 1
                }
                when next_end == cursor + 1 && (runtime.byte_at(cursor) as u64) == 125 {
                    done = true
                }
                cursor = next_end + 1
            }
            starts.push(at)
            header_ends.push(line_end)
            ends.push(cursor)
            names.push(name)
            at = cursor
        } else {
            at = line_end + 1
        }
    }
    // The words that are needed: those of the program, those of the text outside the functions, and, closing over the
    // functions that are kept, those of their bodies.
    mut needed: Map<String, bool> = Map<String, bool>()
    for word in words.keys() {
        needed.insert(word, true)
    }
    mut outside := String("")
    mut position: u64 = 0
    mut item: u64 = 0
    while item <= starts.len() {
        mut stop := runtime.len()
        when item < starts.len() {
            stop = starts[item]
        }
        when stop > position {
            outside.append(runtime.slice(position, stop))
        }
        when item < starts.len() {
            position = ends[item]
        }
        item += 1
    }
    for word in rync_words_of(outside.clone()) {
        needed.insert(word, true)
    }
    // The lowering calls this one by name, for a `char` in an interpolated string.
    needed.insert(String("__char_string"), true)
    // Printing is syntax, not a call of the operation's name.
    when words.contains_key(String("print")) || words.contains_key(String("println")) || words.contains_key(String("echo")) || words.contains_key(String("io")) {
        needed.insert(String("__rt_system_write_stdout"), true)
    }
    when words.contains_key(String("eprint")) || words.contains_key(String("eprintln")) || words.contains_key(String("io")) {
        needed.insert(String("__rt_system_write_stderr"), true)
    }
    mut keep: Vec<bool> = Vec()
    mut at_item: u64 = 0
    while at_item < names.len() {
        keep.push(false)
        at_item += 1
    }
    mut changed: bool = true
    while changed {
        changed = false
        mut it: u64 = 0
        while it < names.len() {
            when !keep[it] {
                mut wanted: bool = needed.contains_key(names[it].clone())
                // A runtime function `__rt_<group>_<operation>` is likely to be used when the program has the operation's name.
                when !wanted && names[it].starts_with("__rt_") {
                    rest := names[it].slice(5, names[it].len())
                    mut cut: u64 = 0
                    while cut < rest.len() && (rest.byte_at(cut) as u64) != 95 {
                        cut += 1
                    }
                    when cut + 1 < rest.len() && words.contains_key(rest.slice(cut + 1, rest.len())) {
                        wanted = true
                    }
                    // Or any word of the operation's name (`file`, `dir`, `env`, `args`).
                    mut word_start: u64 = cut + 1
                    mut scan: u64 = cut + 1
                    while !wanted && scan <= rest.len() {
                        when scan == rest.len() || (rest.byte_at(scan) as u64) == 95 {
                            when scan - word_start >= 3 && words.contains_key(rest.slice(word_start, scan)) {
                                wanted = true
                            }
                            word_start = scan + 1
                        }
                        scan += 1
                    }
                }
                when wanted {
                    keep.set(it, true)
                    changed = true
                    for word in rync_words_of(runtime.slice(starts[it], ends[it])) {
                        needed.insert(word, true)
                    }
                }
            }
            it += 1
        }
    }
    mut out := outside
    mut every: u64 = 0
    while every < names.len() {
        when keep[every] {
            out.append(runtime.slice(starts[every], ends[every]))
        } else when names[every].starts_with("__rt_") {
            out.append(runtime.slice(starts[every], header_ends[every]))
            out.append("\n    __ryn_pruned_runtime()\n}\n")
        }
        every += 1
    }
    return out
}

// Cutting the runtime down saves some 80 ms; reading the words of a large program costs more than that (a second for the
// compiler itself), so only a program of modest size is cut down for.
fun rync_prune_worthwhile(units: Vec<Unit>) -> bool {
    mut bytes: u64 = 0
    for unit in units {
        when unit.module_path != "std::native" {
            bytes += unit.text.len()
        }
    }
    return bytes < 120000
}

// The units with the runtime module cut down to what the other modules may use.
fun rync_pruned_units(units: Vec<Unit>) -> Vec<Unit> {
    mut words: Map<String, bool> = Map<String, bool>()
    mut native: u64 = units.len()
    mut at: u64 = 0
    while at < units.len() {
        when units[at].module_path == "std::native" {
            native = at
        } else when env::get("RYN_PRUNE_STRESS").is_empty() {
            for word in rync_words_of(units[at].text.clone()) {
                words.insert(word, true)
            }
        }
        at += 1
    }
    mut pruned: Vec<Unit> = units
    when native < pruned.len() {
        mut unit := pruned[native]
        unit.text = rync_prune_runtime(unit.text.clone(), words)
        pruned.set(native, unit)
    }
    return pruned
}

// ------------------------------------------------------------------------------------------------------------------ bitflags
// `bitflags Name: u32 { A = 1, B = 2, AB = A | B, C }` declares a structure with one `bits` field, a constant per flag
// (`Name::A`), the operators `|`, `&`, `^`, `-` and `!` as methods (so `|=` works), and `empty`, `all`, `from_bits`, `contains`,
// `intersects`, `is_empty`, `insert`, `remove`, `toggle` and `set`. It is written out as ordinary Ryn at the end of the file,
// and the declaration itself is blanked, so that the positions of everything else in the file stay where they were.

fun rync_flag_entries(body: String) -> Vec<String> {
    // The entries of a flag list, comments removed, split at commas and line ends.
    mut entries: Vec<String> = Vec()
    mut current := String("")
    mut at: u64 = 0
    while at < body.len() {
        byte := body.byte_at(at) as u64
        when byte == 47 && at + 1 < body.len() && (body.byte_at(at + 1) as u64) == 47 {
            while at < body.len() && (body.byte_at(at) as u64) != 10 {
                at += 1
            }
        } else when byte == 44 || byte == 10 {
            trimmed := current.trim()
            when !trimmed.is_empty() {
                entries.push(trimmed)
            }
            current = String("")
            at += 1
        } else {
            current.push(char_from_u32(byte as u32))
            at += 1
        }
    }
    trimmed := current.trim()
    when !trimmed.is_empty() {
        entries.push(trimmed)
    }
    return entries
}

// `expression` with each of the names `flags` replaced by its constant `__<name>_<flag>`.
fun rync_flag_expression(expression: String, owner: String, flags: Vec<String>) -> String {
    mut out := String("")
    mut at: u64 = 0
    while at < expression.len() {
        when rync_ident_byte(expression.byte_at(at) as u64) {
            mut end := at + 1
            while end < expression.len() && rync_ident_byte(expression.byte_at(end) as u64) {
                end += 1
            }
            word := expression.slice(at, end)
            mut known: bool = false
            for flag in flags.clone() {
                when flag == word {
                    known = true
                }
            }
            when known {
                out.append("__")
                out.append(owner.clone())
                out.append("_")
            }
            out.append(word)
            at = end
        } else {
            out.push(char_from_u32((expression.byte_at(at) as u64) as u32))
            at += 1
        }
    }
    return out
}

fun rync_flag_source(name: String, ty: String, entries: Vec<String>) -> String {
    mut names: Vec<String> = Vec()
    mut out := String("\n")
    mut position: u64 = 0
    for entry in entries.clone() {
        equals := entry.find("=")
        mut flag := entry.clone()
        mut value := String("")
        when equals.is_some() {
            flag = entry.slice(0, equals.unwrap()).trim()
            value = rync_flag_expression(entry.slice(equals.unwrap() + 1, entry.len()).trim(), name.clone(), names.clone())
        } else {
            value = String("1 << ")
            value.append(String(position))
        }
        out.append("const __")
        out.append(name.clone())
        out.append("_")
        out.append(flag.clone())
        out.append(": ")
        out.append(ty.clone())
        out.append(" = ")
        out.append(value)
        out.append("\n")
        names.push(flag)
        position += 1
    }
    out.append("pub struct ")
    out.append(name.clone())
    out.append(" { pub bits: ")
    out.append(ty.clone())
    out.append(" }\nextend ")
    out.append(name.clone())
    out.append(" {\n")
    mut every := String("0")
    for flag in names.clone() {
        mut constant := String("__")
        constant.append(name.clone())
        constant.append("_")
        constant.append(flag.clone())
        out.append("    pub const ")
        out.append(flag)
        out.append(": ")
        out.append(name.clone())
        out.append(" = ")
        out.append(name.clone())
        out.append(" { bits: ")
        out.append(constant.clone())
        out.append(" }\n")
        every.append(" | ")
        every.append(constant)
    }
    mut methods := String("")
    methods.append("    pub fun empty() -> NAME { return NAME { bits: 0 } }\n")
    methods.append("    pub fun all() -> NAME { return NAME { bits: EVERY } }\n")
    methods.append("    pub fun from_bits(bits: TYPE) -> NAME { return NAME { bits: bits } }\n")
    methods.append("    pub fun contains(self, other: NAME) -> bool { return (self.bits & other.bits) == other.bits }\n")
    methods.append("    pub fun intersects(self, other: NAME) -> bool { return (self.bits & other.bits) != 0 }\n")
    methods.append("    pub fun is_empty(self) -> bool { return self.bits == 0 }\n")
    methods.append("    pub fun is_all(self) -> bool { return self.bits == (EVERY) }\n")
    methods.append("    pub fun insert(mut self, other: NAME) { self.bits = self.bits | other.bits }\n")
    methods.append("    pub fun remove(mut self, other: NAME) { self.bits = self.bits & ~other.bits }\n")
    methods.append("    pub fun toggle(mut self, other: NAME) { self.bits = self.bits ^ other.bits }\n")
    methods.append("    pub fun set(mut self, other: NAME, on: bool) {\n        when on {\n            self.bits = self.bits | other.bits\n        } else {\n            self.bits = self.bits & ~other.bits\n        }\n    }\n")
    methods.append("    pub fun bitor(self, other: NAME) -> NAME { return NAME { bits: self.bits | other.bits } }\n")
    methods.append("    pub fun bitand(self, other: NAME) -> NAME { return NAME { bits: self.bits & other.bits } }\n")
    methods.append("    pub fun bitxor(self, other: NAME) -> NAME { return NAME { bits: self.bits ^ other.bits } }\n")
    methods.append("    pub fun sub(self, other: NAME) -> NAME { return NAME { bits: self.bits & ~other.bits } }\n")
    methods.append("    pub fun not(self) -> NAME { return NAME { bits: (EVERY) & ~self.bits } }\n")
    methods.append("    pub fun eq(self, other: NAME) -> bool { return self.bits == other.bits }\n")
    methods.append("}\n")
    out.append(rync_replace_all(rync_replace_all(rync_replace_all(methods, "NAME", name), "TYPE", ty), "EVERY", every))
    return out
}

fun rync_replace_all(text: String, from: str, with: String) -> String {
    mut out := String("")
    mut at: u64 = 0
    while at < text.len() {
        when text.slice(at, text.len()).starts_with(from) {
            out.append(with.clone())
            at += from.len()
        } else {
            out.push(char_from_u32((text.byte_at(at) as u64) as u32))
            at += 1
        }
    }
    return out
}

// The text with every `bitflags` declaration blanked and written out as Ryn after the last line.
fun rync_expand_bitflags(text: String) -> String {
    when text.find("bitflags ").is_none() {
        return text
    }
    mut kept := String("")
    mut generated := String("")
    mut at: u64 = 0
    while at < text.len() {
        mut line_end := at
        while line_end < text.len() && (text.byte_at(line_end) as u64) != 10 {
            line_end += 1
        }
        line := text.slice(at, line_end)
        when line.starts_with("bitflags ") {
            // The declaration runs to the line that closes its braces.
            mut item_end := line_end
            mut depth: u64 = 0
            mut opened: bool = false
            mut cursor := at
            while cursor < text.len() && (!opened || depth > 0) {
                byte := text.byte_at(cursor) as u64
                when byte == 123 {
                    depth += 1
                    opened = true
                } else when byte == 125 && depth > 0 {
                    depth -= 1
                }
                cursor += 1
            }
            item_end = cursor
            item := text.slice(at, item_end)
            open := item.find("{")
            colon := item.find(":")
            when open.is_some() && colon.is_some() && colon.unwrap() < open.unwrap() {
                name := item.slice(9, colon.unwrap()).trim()
                ty := item.slice(colon.unwrap() + 1, open.unwrap()).trim()
                body := item.slice(open.unwrap() + 1, item.len() - 1)
                generated.append(rync_flag_source(name, ty, rync_flag_entries(body)))
                // Blank it, keeping the line ends.
                mut blank := at
                while blank < item_end {
                    when (text.byte_at(blank) as u64) == 10 {
                        kept.push('\n')
                    } else {
                        kept.push(' ')
                    }
                    blank += 1
                }
                at = item_end
            } else {
                kept.append(line)
                at = line_end
            }
        } else {
            kept.append(line)
            at = line_end
        }
        when at < text.len() && (text.byte_at(at) as u64) == 10 {
            kept.push('\n')
            at += 1
        }
    }
    kept.append(generated)
    return kept
}

// The program from its entry file through the typed IR. `recovering` reports every syntax error of a file without modules.
// `library`: the program need not have `main` (`check`, and the SPIR-V target, which compiles kernels only).
fun rync_frontend(units: Vec<Unit>, recovering: bool, library: bool) -> Result<Compiled, Failure> {
    mut clock := time::monotonic()
    single := units.len() == 1 && units[0].import_paths.is_empty()
    mut compilation := Compilation { units: units.clone(), segments: Vec(), single: true, joined: String("") }
    mut text := units[0].text.clone()
    when !single {
        compilation = rync_join(units)
        text = compilation.joined.clone()
    }
    // A program of modules is parsed recovering, as each of its files was; a single file only when it is being checked.
    clock = rync_tick("join", clock)
    parsed_text := parser::parse(text, recovering || !single)
    clock = rync_tick("parse", clock)
    parsed := rync_after_ok(parsed_text.clone())
    when parsed.is_none() {
        return Result::Err(Failure { text: compilation.render_frontend(parsed_text), status: 1 })
    }
    decoded := ast::decode_program(parsed.unwrap())
    when decoded.is_err() {
        return Result::Err(Failure { text: report::plain("R0903", String("the self-hosted frontend wrote a syntax tree that cannot be read")), status: 1 })
    }
    mut program := decoded.unwrap()
    when !single {
        program = rync_assign_modules(compilation.clone(), program)?
    }
    clock = rync_tick("decode", clock)
    rewritten := desugar::rewrite_operators(program)
    clock = rync_tick("rewrite operators", clock)
    when rewritten.is_err() {
        return Result::Err(compilation.stage_failure(rewritten.unwrap_err()))
    }
    specialized_text := generics::specialize(ast::encode_program(rewritten.unwrap()))
    clock = rync_tick("specialize generics", clock)
    specialized := rync_after_ok(specialized_text.clone())
    when specialized.is_none() {
        return Result::Err(Failure { text: compilation.render_frontend(specialized_text), status: 1 })
    }
    specialized_program := ast::decode_program(specialized.unwrap())
    when specialized_program.is_err() {
        return Result::Err(Failure { text: report::plain("R0903", String("the specialized syntax tree cannot be read")), status: 1 })
    }
    clock = rync_tick("decode specialized", clock)
    evaluated := comptime::evaluate_program(specialized_program.unwrap())
    clock = rync_tick("comptime", clock)
    when evaluated.is_err() {
        return Result::Err(compilation.stage_failure(evaluated.unwrap_err()))
    }
    desugared := desugar::desugar_program(evaluated.unwrap())
    clock = rync_tick("desugar patterns", clock)
    when desugared.is_err() {
        return Result::Err(compilation.stage_failure(desugared.unwrap_err()))
    }
    lowered := lower::lower_recovering_with(desugared.unwrap(), !env::get("RYN_LOWER_ALL").is_empty(), library)
    clock = rync_tick("lower", clock)
    when lowered.is_err() {
        return Result::Err(compilation.stage_failure(lowered.unwrap_err()))
    }
    return Result::Ok(Compiled { ir_text: lowered.unwrap(), compilation: compilation })
}

// A program lowered to typed IR (its text), with the sources its spans refer to.
struct Compiled {
    ir_text: String,
    compilation: Compilation,
}

// A copy of `text` in C memory with a terminating zero, for the C-convention routines of the runtime.
fun rync_c_string(text: String) -> *u8 {
    buffer := malloc(text.len() + 1)
    base := buffer as u64
    mut at: u64 = 0
    while at < text.len() {
        cell := (base + at) as *u8
        *cell = text.byte_at(at)
        at += 1
    }
    end := (base + text.len()) as *u8
    *end = 0 as u8
    return buffer
}

// Writes the executable to `path` with mode 0755. The bytes go to a file of their own beside it that then replaces `path`,
// so an output that is a link to a source file replaces the link and never the source.
fun rync_write_executable(path: String, bytes: Vec<u8>) -> bool {
    mut temporary := path.clone()
    temporary.append(".ryn-")
    temporary.append(String(getpid() as u64))
    temporary.append(".tmp")
    when !rync_write_file(temporary.clone(), bytes) {
        removed := fs::remove_file(temporary)
        return false
    }
    moved := fs::rename(temporary.clone(), path)
    when !moved {
        removed := fs::remove_file(temporary)
    }
    return moved
}

fun rync_write_file(path: String, bytes: Vec<u8>) -> bool {
    c_path := rync_c_string(path)
    mode := rync_c_string(String("wb"))
    file := fopen(c_path, mode)
    free(mode)
    when (file as u64) == 0 {
        free(c_path)
        return false
    }
    // The bytes go through a buffer of 64 KiB at a time.
    chunk: u64 = 65536
    buffer := malloc(chunk)
    base := buffer as u64
    mut written_ok := true
    mut at: u64 = 0
    while at < bytes.len() && written_ok {
        mut length := bytes.len() - at
        when length > chunk {
            length = chunk
        }
        mut index: u64 = 0
        while index < length {
            cell := (base + index) as *u8
            *cell = bytes[at + index]
            index += 1
        }
        when fwrite(buffer, 1, length, file) != length {
            written_ok = false
        }
        at += length
    }
    free(buffer)
    when fclose(file) != 0 {
        written_ok = false
    }
    when written_ok && chmod(c_path, 493 as u32) != 0 {
        written_ok = false
    }
    free(c_path)
    return written_ok
}

fun rync_absolute(path: String) -> String {
    when manifest::is_absolute(path.clone()) {
        return manifest::normalize(path)
    }
    return manifest::join_path(env::current_dir(), path)
}

fun rync_fail(message: String, code: i32) -> i32 {
    eprint("{}", message)
    return code
}

fun rync_usage() -> String {
    return String("usage: rync [build|check] [-o <path>] [--profile-generate <file>] [--profile-use <file>] [--target <linux|windows|aarch64-linux|spirv>] [--stdlib <directory>] [--package <name>=<directory>] <entry.ryn|project-dir>\n       rync asm [--function <name>] [--summary] [--arch x86-64] [--target <linux|windows>] [--stdlib <directory>] <entry.ryn|project-dir>\n       rync --version")
}

fun main() -> i32 {
    mut std_root := String("stdlib/std/src")
    mut entry := String("")
    mut output := String("")
    mut checking := false
    // `rync asm`: print the assembly of the functions (all, or the one named by `--function`) instead of writing a program.
    mut listing := false
    mut only := String("")
    mut summary := false
    // `--profile-generate <file>` builds an instrumented program that writes its entry counts there; `--profile-use <file>`
    // orders the code by such a profile (`build` only).
    mut profile_out := String("")
    mut profile_in := String("")
    mut package_names: Vec<String> = Vec()
    mut package_roots: Vec<String> = Vec()
    mut position: u32 = 0
    mut seen_command := false
    // The target is the system the compiler runs on, unless `--target` names the other.
    mut windows := system::os() == "windows"
    // `--target aarch64-linux` selects the AArch64 backend, which makes a Linux executable for ARM64.
    mut arm64 := false
    // `--target spirv` writes the `#[kernel]` functions as a SPIR-V module (`back/spirv`), with no `main`.
    mut spirv_target := false
    while position < arg_count() {
        word := String(arg(position))
        when word == "--version" || word == "-V" {
            echo "rync 0.1.13"
            return 0
        }
        when word == "--help" || word == "-h" {
            usage := rync_usage()
            echo "{usage}"
            return 0
        }
        when !seen_command && entry.is_empty() && (word == "build" || word == "check" || word == "asm") {
            checking = word == "check"
            listing = word == "asm"
            seen_command = true
            position += 1
        } else when listing && word == "--function" && position + 1 < arg_count() {
            only = String(arg(position + 1))
            position += 2
        } else when listing && word == "--summary" {
            summary = true
            position += 1
        } else when listing && word == "--arch" && position + 1 < arg_count() {
            architecture := String(arg(position + 1))
            when architecture != "x86-64" && architecture != "x86_64" && architecture != "amd64" {
                mut message := String("error[R0910]: unsupported architecture `")
                message.append(architecture)
                message.append("`: the listing is x86-64 only; build an ARM64 executable with --target aarch64-linux")
                return rync_fail(message, 2)
            }
            position += 2
        } else when listing && word.starts_with("-O") {
            return rync_fail(String("error[R0910]: the native backend has one code generation level, so there is no `-O` option; `ryn asm` shows the code it generates"), 2)
        } else when word == "--target" && position + 1 < arg_count() {
            target := String(arg(position + 1))
            when target == "windows" || target == "x86_64-windows" {
                windows = true
                arm64 = false
                spirv_target = false
            } else when target == "linux" || target == "x86_64-linux" {
                windows = false
                arm64 = false
                spirv_target = false
            } else when target == "aarch64-linux" || target == "aarch64" {
                windows = false
                arm64 = true
                spirv_target = false
            } else when target == "spirv" {
                windows = false
                arm64 = false
                spirv_target = true
            } else {
                return rync_fail(rync_usage(), 2)
            }
            position += 2
        } else when word == "--profile-generate" && position + 1 < arg_count() {
            profile_out = String(arg(position + 1))
            position += 2
        } else when word == "--profile-use" && position + 1 < arg_count() {
            profile_in = String(arg(position + 1))
            position += 2
        } else when word == "--stdlib" && position + 1 < arg_count() {
            std_root = String(arg(position + 1))
            position += 2
        } else when (word == "-o" || word == "--output") && position + 1 < arg_count() {
            output = String(arg(position + 1))
            position += 2
        } else when word == "--package" && position + 1 < arg_count() {
            pair := String(arg(position + 1))
            equals := pair.find("=")
            when equals.is_none() {
                return rync_fail(rync_usage(), 2)
            }
            cut := equals.unwrap()
            package_names.push(pair.slice(0, cut))
            package_roots.push(pair.slice(cut + 1, pair.len()))
            position += 2
        } else when word.starts_with("-") || !entry.is_empty() {
            return rync_fail(rync_usage(), 2)
        } else {
            entry = word
            position += 1
        }
    }
    when entry.is_empty() {
        return rync_fail(rync_usage(), 2)
    }
    when (checking || listing) && (!profile_out.is_empty() || !profile_in.is_empty()) {
        return rync_fail(String("error[R0914]: --profile-generate and --profile-use apply to `rync build` only"), 2)
    }
    // A project directory: its manifest names the path dependencies, and `src/main.ryn` is the entry file.
    mut source_root := manifest::directory_of(entry.clone())
    mut entry_file := entry.clone()
    mut manifest_file := entry.clone()
    manifest_file.append("/ryn.yaml")
    mut package_directory := entry.clone()
    when !file_exists(manifest_file.clone()) && entry.ends_with(".ryn") {
        enclosing := manifest::project_for_source(entry.clone())
        when enclosing.is_some() {
            package_directory = enclosing.unwrap()
            manifest_file = manifest::join_path(package_directory.clone(), String("ryn.yaml"))
        }
    }
    when file_exists(manifest_file.clone()) {
        source_root = manifest::join_path(package_directory.clone(), String("src"))
        when package_directory == entry {
            entry_file = manifest::join_path(source_root.clone(), String("main.ryn"))
        }
        when !file_exists(entry_file.clone()) {
            mut message := String("error[R0001]: project entry point not found: ")
            message.append(entry_file)
            return rync_fail(message, 1)
        }
        project_manifest := manifest::read_manifest(read_file(manifest_file.clone()))
        when project_manifest.name.is_empty() {
            mut message := String("error[R0410]: invalid ryn.yaml\n  --> ")
            message.append(manifest_file.clone())
            message.append("\nmissing field `name`")
            return rync_fail(message, 1)
        }
        added := rync_path_dependencies(package_directory, package_names.clone())
        when added.is_err() {
            return rync_fail(added.unwrap_err(), 1)
        }
        pairs := added.unwrap()
        mut pair_at: u64 = 0
        while pair_at + 1 < pairs.len() {
            package_names.push(pairs[pair_at].clone())
            package_roots.push(pairs[pair_at + 1].clone())
            pair_at += 2
        }
    } else when !file_exists(entry_file.clone()) {
        mut message := String("error[R0001]: cannot read ")
        message.append(entry_file)
        message.append(": No such file or directory (os error 2)")
        return rync_fail(message, 1)
    }
    when source_root.is_empty() {
        source_root = String(".")
    }
    package_names.push(String("std"))
    package_roots.push(std_root.clone())
    mut loader := Loader { std_root: std_root.clone(), package_names: package_names, package_roots: package_roots, units: Vec(), found_files: Vec(), found_modules: Vec(), importing: Vec(), error: String("") }
    when !loader.load(entry_file, String(""), source_root) {
        return rync_fail(loader.error.clone(), 1)
    }
    // The native runtime module: the builtins it implements in Ryn become calls of its functions (`middle/lower`), and
    // only the functions a program reaches are generated.
    mut runtime_file := std_root
    runtime_file.append("/native.ryn")
    when file_exists(runtime_file.clone()) {
        when !loader.load_runtime(runtime_file, String("std::native"), loader.std_root.clone()) {
            return rync_fail(loader.error.clone(), 1)
        }
    }
    // For Windows, the runtime functions that differ there are in a second module, which the lowering prefers.
    when windows {
        mut windows_file := loader.std_root.clone()
        windows_file.append("/native_windows.ryn")
        when file_exists(windows_file.clone()) {
            when !loader.load(windows_file, String("std::native_windows"), loader.std_root.clone()) {
                return rync_fail(loader.error.clone(), 1)
            }
        }
    }
    loaded_files := loader.found_files.clone()
    mut analyzed: Result<Compiled, Failure> = Result::Err(Failure { text: String(""), status: 1 })
    // A library (`check`, and the SPIR-V target) keeps every function: pruning keeps only what `main` reaches.
    library := checking || spirv_target
    when !library && !windows && env::get("RYN_NO_PRUNE").is_empty() && rync_prune_worthwhile(loader.units.clone()) {
        analyzed = rync_frontend(rync_pruned_units(loader.units.clone()), false, false)
        when analyzed.is_err() {
            analyzed = rync_frontend(loader.units.clone(), false, false)
        }
    } else {
        analyzed = rync_frontend(loader.units.clone(), checking, library)
    }
    when analyzed.is_err() {
        failure := analyzed.unwrap_err()
        return rync_fail(failure.text, failure.status)
    }
    compiled := analyzed.unwrap()
    compilation := compiled.compilation
    when checking {
        // The typed IR must also be readable by the code generator.
        when ir::decode_ir(compiled.ir_text).is_err() {
            failure := rync_unsupported(String("the typed IR does not decode"))
            return rync_fail(failure.text, failure.status)
        }
        return 0
    }
    when listing {
        listed := gen::generate_listing(compiled.ir_text, windows, only.clone(), summary)
        when listed.is_err() {
            reason := listed.unwrap_err()
            when reason == "no function with that name" {
                mut message := String("error[R0911]: no function named `")
                message.append(only)
                message.append("` in the generated code (a name is the function's path, such as `main` or `Counter::add`)")
                return rync_fail(message, 1)
            }
            failure := compilation.stage_failure(reason)
            return rync_fail(failure.text, failure.status)
        }
        text := listed.unwrap()
        print("{}", text)
        return 0
    }
    mut generation_started := time::monotonic()
    // The profile is read here, so that a missing file is reported before the program is generated.
    mut profile_text := String("")
    when !profile_in.is_empty() {
        read_profile := read_file_result(profile_in.clone())
        // A profile that cannot be read costs speed and nothing else: the program is built as without one.
        when read_profile.is_err() {
            eprint("warning[R0913]: cannot read the profile {}; the program is built without it", profile_in)
        } else {
            profile_text = read_profile.unwrap()
        }
    }
    // `RYN_DUMP_IR=<path>` writes the IR text of the program, for debugging the code generators.
    dump_path := env::get("RYN_DUMP_IR")
    when !dump_path.is_empty() {
        mut dump: Vec<u8> = Vec()
        mut at: u64 = 0
        while at < compiled.ir_text.len() {
            dump.push(compiled.ir_text.byte_at(at))
            at += 1
        }
        rync_write_file(dump_path, dump)
    }
    mut linked: Result<Vec<u8>, String> = Result::Err(String(""))
    when spirv_target && (!profile_out.is_empty() || !profile_text.is_empty()) {
        return rync_fail(String("error[R0910]: profiling is not available for the SPIR-V target"), 2)
    }
    when arm64 && (!profile_out.is_empty() || !profile_text.is_empty()) {
        return rync_fail(String("error[R0910]: profiling is not available for the AArch64 target"), 2)
    }
    when spirv_target {
        linked = spirv::generate_text(compiled.ir_text.clone())
    } else when arm64 {
        linked = arm64::generate_executable_text(compiled.ir_text.clone())
    } else when !profile_out.is_empty() || !profile_text.is_empty() {
        linked = gen::generate_profiled(compiled.ir_text.clone(), windows, profile_out.clone(), profile_text)
    } else {
        linked = gen::generate_for_target(compiled.ir_text.clone(), windows)
    }
    generation_started = rync_tick("decode IR, generate code and link", generation_started)
    when linked.is_err() {
        failure := compilation.stage_failure(linked.unwrap_err())
        return rync_fail(failure.text, failure.status)
    }
    bytes := linked.unwrap()
    when !output.is_empty() {
        absolute_output := rync_absolute(output.clone())
        for source in loaded_files.clone() {
            when rync_absolute(source.clone()) == absolute_output {
                mut message := String("error[R0303]: output ")
                message.append(output.clone())
                message.append(" would overwrite ")
                message.append(source)
                return rync_fail(message, 1)
            }
        }
        when !rync_write_executable(output.clone(), bytes) {
            mut message := String("error[R0301]: cannot write the executable ")
            message.append(output)
            return rync_fail(message, 1)
        }
        return 0
    }
    mut at: u64 = 0
    while at < bytes.len() {
        putchar(bytes[at] as i32)
        at += 1
    }
    return 0
}

// The path dependencies of the project at `project` and of the packages they name, unless `--package` gave them: the
// name and the source directory of each, one after the other.
fun rync_path_dependencies(project: String, given_names: Vec<String>) -> Result<Vec<String>, String> {
    mut names := given_names
    mut pairs: Vec<String> = Vec()
    mut pending: Vec<String> = Vec()
    pending.push(project)
    mut visited: Vec<String> = Vec()
    while !pending.is_empty() {
        package := pending.pop().unwrap()
        mut known := false
        for done in visited.clone() {
            when done == package {
                known = true
            }
        }
        when !known {
            visited.push(package.clone())
            manifest_path := manifest::join_path(package.clone(), String("ryn.yaml"))
            when !file_exists(manifest_path.clone()) {
                mut message := String("error[R0425]: cannot read the manifest ")
                message.append(manifest_path)
                return Result::Err(message)
            }
            read := manifest::read_manifest(read_file(manifest_path))
            mut at: u64 = 0
            while at < read.dependency_names.len() {
                name := read.dependency_names[at].clone()
                directory := manifest::join_path(package.clone(), read.dependency_paths[at].clone())
                source := manifest::join_path(directory.clone(), String("src"))
                mut given := false
                mut index: u64 = 0
                while index < names.len() {
                    when names[index] == name {
                        given = true
                    }
                    index += 1
                }
                when !given {
                    when !file_exists(manifest::join_path(directory.clone(), String("ryn.yaml"))) {
                        mut message := String("error[R0425]: cannot resolve path dependency `")
                        message.append(name)
                        message.append("` of package `")
                        message.append(read.name.clone())
                        message.append("` at ")
                        message.append(directory)
                        message.append(": No such file or directory (os error 2)")
                        return Result::Err(message)
                    }
                    names.push(name.clone())
                    pairs.push(name)
                    pairs.push(source)
                    pending.push(directory)
                }
                at += 1
            }
            for other in read.other_dependencies.clone() {
                mut given := false
                mut index: u64 = 0
                while index < names.len() {
                    when names[index] == other {
                        given = true
                    }
                    index += 1
                }
                when !given {
                    mut message := String("error[R0425]: dependency `")
                    message.append(other)
                    message.append("` of package `")
                    message.append(read.name.clone())
                    message.append("` is not a path dependency; build the project with `ryn build`, which resolves it")
                    return Result::Err(message)
                }
            }
        }
    }
    return Result::Ok(pairs)
}
