// ryn: the command-line tool. It creates and cleans projects and runs `check`, `build` and `run` by starting the sibling
// compiler `rync` (installed next to it) with the project layout the commands define.
//
//     ryn new <path>
//     ryn check <file.ryn|project-dir>
//     ryn build <file.ryn|project-dir> [--release] [-o|--output <path>]
//     ryn run <file.ryn|project-dir> [--release] [-o|--output <path>] [-- <program-args...>]
//     ryn update\n  ryn asm <file.ryn|project-dir> [--function NAME] [--summary] [--compare A B] [--arch x86-64] [--target linux|windows]\n  ryn bench <file.ryn|project-dir> [--iterations N] [--warmup N] [--compile-runs N] [--json]
//               [--baseline <file>] [--save-baseline <file>] [--threshold PERCENT] [-- <program-args...>]
//     ryn clean <project-dir>
//
// The standard library is found at `<directory of ryn>/stdlib/std/src`, or at `RYN_STDLIB`. Status 0 means success, 1 an
// error (diagnostics go to standard error), and `run` returns the program's own status.

use driver::bench
use driver::manifest
use driver::pkg
use std::fs
use std::env
use std::time
use std::process
use std::system

fun ryn_usage() -> String {
    return String("usage:\n  ryn new <path>\n  ryn check <file.ryn|project-dir>\n  ryn build <file.ryn|project-dir> [--release] [-o|--output <path>]\n  ryn run <file.ryn|project-dir> [--release] [-o|--output <path>] [-- <program-args...>]\n  ryn bench <file.ryn|project-dir> [--iterations N] [--warmup N] [--compile-runs N] [--json] [--baseline <file>] [--save-baseline <file>] [--threshold PERCENT] [-- <program-args...>]\n  ryn clean <project-dir>\n  ryn lock <project-dir>\n  ryn login <token>\n  ryn publish [project-dir]")
}

fun ryn_help() -> String {
    mut text := String("Ryn — Reliable. Fast. Native.\n\n")
    text.append(ryn_usage())
    text.append("\n\nCommands:\n  new <path>        Create a project with a native Hello World example\n  check <source>    Check a .ryn file or project directory\n  build <source>    Compile a .ryn file or project directory\n  run <source>      Compile and run a .ryn file or project directory\n  update            Install the latest release over this one (runs the installer of the repository; RYN_REPOSITORY and RYN_INSTALL_DIR are honoured)\n  asm <source>      Show the assembly the native backend generates (one function, a summary, or a comparison of two)\n  bench <source>    Compile, then time the program: warmup, median, baseline comparison, JSON\n  lock <project>     Resolve and write ryn.lock for supported dependencies\n  login <token>     Save a pods registry token for publishing\n  publish [project] Check, pack and upload the project to the pods registry\n  clean <project>   Remove the project's build directory\n\nA project directory uses src/main.ryn as its entry point.\nProject outputs go under build/debug or build/release; build/cache is reserved for compiler caches.\nAn i32 result from main becomes the process exit code for run.\nPass program arguments to run after --.\nclean removes only the direct build directory and refuses symbolic links.\n\nAsm options:\n  --function NAME      Only the function called NAME (`main`, `Counter::add`)\n  --summary            One line per function: instructions and bytes\n  --compare A B        Instruction and byte counts of functions A and B, then both listings (scalar against SIMD)\n  --arch ARCH          x86-64 (the listing is x86-64 only; `ryn build --target aarch64-linux` writes ARM64 executables)\n  --target T           linux or windows\n  The backend has a single code generation level, so there is no -O option.\n\nBench options:\n  --iterations N       Timed runs of the program (default 10)\n  --warmup N           Runs before timing starts, not counted (default 2)\n  --compile-runs N     Times the compiler is timed (default 1)\n  --json               Print the report as JSON only\n  --baseline <file>    Compare medians with a saved report; exit 1 on a regression\n  --save-baseline <f>  Write the report as JSON to a file\n  --threshold PERCENT  Slowdown that counts as a regression (default 10)\n  A project directory with a benches/ directory times every .ryn file in it.\n\nOptions:\n  --release            Use the project's release output directory\n  --target aarch64-linux  Build (ryn build only) an ARM64 executable for Linux with the AArch64 backend\n  -o, --output <path>  Set the executable path for build or run\n  -h, --help           Show this help\n  -V, --version        Show compiler version\n")
    return text
}

fun ryn_fail(message: String) -> i32 {
    eprint("{}", message)
    return 1
}

fun ryn_ends_with(text: String, suffix: str) -> bool {
    return text.ends_with(suffix)
}

// The last component of a path, ignoring trailing slashes.
fun ryn_base_name(path: String) -> String {
    mut end := path.len()
    while end > 1 && (path.byte_at(end - 1) as u64) == 47 {
        end -= 1
    }
    mut start := end
    while start > 0 && (path.byte_at(start - 1) as u64) != 47 {
        start -= 1
    }
    return path.slice(start, end)
}

// A manifest scalar: plain when it is made of letters, digits, `-` and `_`, double-quoted otherwise.
fun ryn_yaml_scalar(value: String) -> String {
    mut plain := !value.is_empty()
    mut quoted := String("\"")
    mut at: u64 = 0
    while at < value.len() {
        byte := value.byte_at(at) as u64
        when !((byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 45 || byte == 95) {
            plain = false
        }
        when byte == 92 || byte == 34 {
            quoted.append("\\")
        }
        quoted.append(value.slice(at, at + 1))
        at += 1
    }
    quoted.append("\"")
    when plain {
        return value
    }
    return quoted
}

fun ryn_new(path: String) -> i32 {
    when fs::exists(path.clone()) {
        mut message := String("error[R0400]: project path already exists: ")
        message.append(path)
        return ryn_fail(message)
    }
    name := ryn_base_name(path.clone())
    when name.is_empty() {
        return ryn_fail(ryn_usage())
    }
    mut directories: Vec<String> = Vec()
    directories.push(String("src"))
    directories.push(String("build/cache"))
    directories.push(String("build/debug"))
    directories.push(String("build/release"))
    for directory in directories {
        full := manifest::join_path(path.clone(), directory)
        when !fs::create_dir_all(full.clone()) {
            mut message := String("error[R0401]: cannot create ")
            message.append(full)
            return ryn_fail(message)
        }
    }
    when !fs::write(manifest::join_path(path.clone(), String("src/main.ryn")), "fun main() {\n    echo \"Hello, Ryn!\"\n}\n") {
        return ryn_fail(String("error[R0401]: cannot write project entry point"))
    }
    mut yaml := String("name: ")
    yaml.append(ryn_yaml_scalar(name))
    yaml.append("\nversion: 0.1.0\nowner: guest\n\ndependencies:\n\nbuild:\n  optimize: speed\n")
    when !fs::write(manifest::join_path(path.clone(), String("ryn.yaml")), yaml) {
        return ryn_fail(String("error[R0401]: cannot write project manifest"))
    }
    echo "created {path}"
    return 0
}

fun ryn_clean(path: String) -> i32 {
    when !fs::is_dir(path.clone()) {
        mut message := String("error[R0402]: project path is not a directory: ")
        message.append(path)
        return ryn_fail(message)
    }
    build := manifest::join_path(path.clone(), String("build"))
    when !fs::exists(build.clone()) {
        echo "no build artifacts in {path}"
        return 0
    }
    when pkg::is_symlink(build.clone()) || !fs::is_dir(build.clone()) {
        mut message := String("error[R0402]: refusing to clean a non-directory or symbolic link at ")
        message.append(build)
        return ryn_fail(message)
    }
    when !fs::remove_dir_all(build.clone()) {
        mut message := String("error[R0402]: cannot remove build directory ")
        message.append(build)
        return ryn_fail(message)
    }
    echo "cleaned {build}"
    return 0
}

// The name of an executable on this system: `.exe` is added on Windows.
fun ryn_executable(name: String) -> String {
    mut out := name
    when system::os() == "windows" {
        out.append(".exe")
    }
    return out
}

// The directory the tool is installed in.
fun ryn_home() -> String {
    return manifest::directory_of(env::executable_path())
}

fun ryn_stdlib() -> String {
    given := env::get("RYN_STDLIB")
    when !given.is_empty() {
        return given
    }
    return manifest::join_path(ryn_home(), String("stdlib/std/src"))
}

fun ryn_default_output(input: String, project: bool, release: bool) -> String {
    when project {
        mut name := ryn_base_name(input.clone())
        when name == "." || name == ".." || name.is_empty() {
            name = ryn_base_name(env::current_dir())
        }
        profile := when release { String("release") } else { String("debug") }
        mut relative := String("build/")
        relative.append(profile)
        relative.append("/")
        relative.append(ryn_executable(name))
        return manifest::join_path(input, relative)
    }
    when input.ends_with(".ryn") {
        return ryn_executable(input.slice(0, input.len() - 4))
    }
    mut out := input
    out.append(".out")
    return out
}

// The packages a project depends on, resolved through `ryn.lock`: a name and a source directory each. The first build of a
// project with registry dependencies writes the lock file.
fun ryn_dependencies(project: String) -> Vec<String> {
    mut none: Vec<String> = Vec()
    mut directory := project
    when !fs::is_file(manifest::join_path(directory.clone(), String("ryn.yaml"))) {
        found := manifest::project_for_source(directory.clone())
        when found.is_none() { return none }
        directory = found.unwrap()
    }
    when pkg::uses_registry(directory.clone()) && !fs::is_file(manifest::join_path(directory.clone(), String("ryn.lock"))) {
        written := pkg::write_lock(directory.clone())
        when written.is_err() {
            eprint("{}", written.unwrap_err())
            return none
        }
        path := written.unwrap()
        eprint("note: created {}\n", path)
    }
    resolved := pkg::dependency_directories(directory)
    when resolved.is_err() {
        eprint("{}\n", resolved.unwrap_err())
        none.push(String("!"))
        return none
    }
    return resolved.unwrap()
}

fun ryn_compiler_path() -> String {
    return manifest::join_path(ryn_home(), ryn_executable(String("rync")))
}

// The arguments of one start of the compiler.
fun ryn_compiler_arguments(command: str, input: String, output: String, packages: Vec<String>, target: String) -> Vec<String> {
    mut arguments: Vec<String> = Vec()
    arguments.push(String(command))
    arguments.push(String("--stdlib"))
    arguments.push(ryn_stdlib())
    when !output.is_empty() {
        arguments.push(String("-o"))
        arguments.push(output)
    }
    when !target.is_empty() {
        arguments.push(String("--target"))
        arguments.push(target)
    }
    mut at: u64 = 0
    while at + 1 < packages.len() {
        mut pair := packages[at].clone()
        pair.append("=")
        pair.append(packages[at + 1].clone())
        arguments.push(String("--package"))
        arguments.push(pair)
        at += 2
    }
    arguments.push(input)
    return arguments
}

fun ryn_compiler(command: str, input: String, output: String, packages: Vec<String>, target: String) -> i32 {
    compiler := ryn_compiler_path()
    when !fs::exists(compiler.clone()) {
        mut message := String("error[R0301]: the compiler is not installed at ")
        message.append(compiler)
        return ryn_fail(message)
    }
    return run_process_args(compiler, ryn_compiler_arguments(command, input, output, packages, target))
}

// ---------------------------------------------------------------------------------------------------------------------
// ryn update

// Installs the latest release with the installer of the repository, the same script a first install uses: it reads the latest
// GitHub release, checks the archive's SHA-256 and replaces the installed files. Nothing is downloaded until this command runs.
fun ryn_update() -> i32 {
    repository := env_or("RYN_REPOSITORY", "rynlanguage/Ryn")
    mut base := String("https://raw.githubusercontent.com/")
    base.append(repository)
    base.append("/main/")
    mut arguments: Vec<String> = Vec()
    mut program := String("sh")
    when os() == "windows" {
        program = String("powershell")
        arguments.push(String("-NoProfile"))
        arguments.push(String("-Command"))
        mut script := String("irm ")
        script.append(base.clone())
        script.append("install.ps1 | iex")
        arguments.push(script)
    } else {
        arguments.push(String("-c"))
        mut script := String("curl -fsSL ")
        script.append(base.clone())
        script.append("install.sh | bash")
        arguments.push(script)
    }
    echo "Updating Ryn from {repository} ..."
    status := run_process_args(program, arguments)
    when status != 0 {
        return ryn_fail(String("error[R0912]: the update failed; run the installer by hand (see the README)"))
    }
    return 0
}

// ---------------------------------------------------------------------------------------------------------------------
// ryn asm

// The text of `rync asm` for one function (or all), captured.
fun ryn_asm_capture(input: String, packages: Vec<String>, extra: Vec<String>) -> process::ProcessResult {
    arguments := ryn_compiler_arguments("asm", input, String(""), packages, String(""))
    mut full: Vec<String> = Vec()
    full.push(arguments[0].clone())
    for word in extra {
        full.push(word)
    }
    mut at: u64 = 1
    while at < arguments.len() {
        full.push(arguments[at].clone())
        at += 1
    }
    return process::run_capture_args(ryn_compiler_path(), full)
}

fun ryn_asm() -> i32 {
    mut input := String("")
    mut extra: Vec<String> = Vec()
    mut first := String("")
    mut second := String("")
    mut position: u32 = 1
    while position < arg_count() {
        word := String(arg(position))
        when (word == "--function" || word == "--arch" || word == "--target") && position + 1 < arg_count() {
            extra.push(word)
            extra.push(String(arg(position + 1)))
            position += 2
        } else when word == "--summary" {
            extra.push(word)
            position += 1
        } else when word == "--compare" && position + 2 < arg_count() {
            first = String(arg(position + 1))
            second = String(arg(position + 2))
            position += 3
        } else when word.starts_with("-O") {
            extra.push(word)
            position += 1
        } else when input.is_empty() && !word.starts_with("-") {
            input = word
            position += 1
        } else {
            return ryn_fail(ryn_usage())
        }
    }
    when input.is_empty() {
        return ryn_fail(ryn_usage())
    }
    compiler := ryn_compiler_path()
    when !fs::exists(compiler.clone()) {
        mut message := String("error[R0301]: the compiler is not installed at ")
        message.append(compiler)
        return ryn_fail(message)
    }
    packages := ryn_dependencies(input.clone())
    when packages.len() == 1 {
        return 1
    }
    when first.is_empty() {
        shown := ryn_asm_capture(input, packages, extra)
        when shown.exit_code != 0 {
            eprint("{}", shown.stderr)
            return shown.exit_code
        }
        print("{}", shown.stdout)
        return 0
    }
    // --compare A B: the sizes of both, then both listings.
    mut summary_first := extra.clone()
    summary_first.push(String("--function"))
    summary_first.push(first.clone())
    mut summary_second := extra.clone()
    summary_second.push(String("--function"))
    summary_second.push(second.clone())
    mut summary_first_only := summary_first.clone()
    summary_first_only.push(String("--summary"))
    mut summary_second_only := summary_second.clone()
    summary_second_only.push(String("--summary"))
    sizes_first := ryn_asm_capture(input.clone(), packages.clone(), summary_first_only)
    when sizes_first.exit_code != 0 {
        eprint("{}", sizes_first.stderr)
        return sizes_first.exit_code
    }
    sizes_second := ryn_asm_capture(input.clone(), packages.clone(), summary_second_only)
    when sizes_second.exit_code != 0 {
        eprint("{}", sizes_second.stderr)
        return sizes_second.exit_code
    }
    print("{}", sizes_first.stdout)
    print("{}", sizes_second.stdout)
    listing_first := ryn_asm_capture(input.clone(), packages.clone(), summary_first)
    listing_second := ryn_asm_capture(input, packages, summary_second)
    print("\n{}", listing_first.stdout)
    print("\n{}", listing_second.stdout)
    return 0
}

// ---------------------------------------------------------------------------------------------------------------------
// ryn bench

fun ryn_now_ns() -> u64 {
    return (time::monotonic() * 1000000000.0) as u64
}

// Whether `left` sorts after `right`, byte by byte.
fun ryn_text_after(left: String, right: String) -> bool {
    mut at: u64 = 0
    while at < left.len() && at < right.len() {
        a := left.byte_at(at) as u64
        b := right.byte_at(at) as u64
        when a != b {
            return a > b
        }
        at += 1
    }
    return left.len() > right.len()
}

// The `.ryn` files directly in `directory`, by name.
fun ryn_bench_sources(directory: String) -> Vec<String> {
    mut names: Vec<String> = Vec()
    for name in fs::read_dir(directory.clone()) {
        when name.ends_with(".ryn") {
            names.push(name)
        }
    }
    mut at: u64 = 1
    while at < names.len() {
        value := names[at].clone()
        mut before := at
        while before > 0 && ryn_text_after(names[before - 1].clone(), value.clone()) {
            names.set(before, names[before - 1].clone())
            before -= 1
        }
        names.set(before, value)
        at += 1
    }
    mut paths: Vec<String> = Vec()
    for name in names {
        paths.push(manifest::join_path(directory.clone(), name))
    }
    return paths
}

fun ryn_bench_options_error(message: str) -> i32 {
    mut text := String("error[R0908]: ")
    text.append(message)
    return ryn_fail(text)
}

fun ryn_bench() -> i32 {
    mut input := String("")
    mut iterations: u64 = 10
    mut warmup: u64 = 2
    mut compile_runs: u64 = 1
    mut threshold: u64 = 10
    mut baseline_path := String("")
    mut save_path := String("")
    mut json := false
    mut program_args: Vec<String> = Vec()
    mut position: u32 = 1
    while position < arg_count() {
        word := String(arg(position))
        when word == "--" {
            position += 1
            while position < arg_count() {
                program_args.push(String(arg(position)))
                position += 1
            }
        } else when (word == "--iterations" || word == "--warmup" || word == "--compile-runs" || word == "--threshold") && position + 1 < arg_count() {
            parsed := bench::bench_parse_u64(String(arg(position + 1)))
            when parsed.is_none() {
                mut message := String("`")
                message.append(word)
                message.append("` takes a whole number")
                return ryn_bench_options_error(message.slice(0, message.len()))
            }
            when word == "--iterations" {
                iterations = parsed.unwrap()
            } else when word == "--warmup" {
                warmup = parsed.unwrap()
            } else when word == "--compile-runs" {
                compile_runs = parsed.unwrap()
            } else {
                threshold = parsed.unwrap()
            }
            position += 2
        } else when word == "--baseline" && position + 1 < arg_count() && baseline_path.is_empty() {
            baseline_path = String(arg(position + 1))
            position += 2
        } else when word == "--save-baseline" && position + 1 < arg_count() && save_path.is_empty() {
            save_path = String(arg(position + 1))
            position += 2
        } else when word == "--json" && !json {
            json = true
            position += 1
        } else when word == "--release" {
            position += 1
        } else when input.is_empty() && !word.starts_with("-") {
            input = word
            position += 1
        } else {
            return ryn_fail(ryn_usage())
        }
    }
    when input.is_empty() {
        return ryn_fail(ryn_usage())
    }
    when iterations == 0 {
        return ryn_bench_options_error("`--iterations` must be at least 1")
    }
    when compile_runs == 0 {
        return ryn_bench_options_error("`--compile-runs` must be at least 1")
    }
    when !fs::exists(input.clone()) {
        mut message := String("error[R0300]: no such file or directory: ")
        message.append(input)
        return ryn_fail(message)
    }
    compiler := ryn_compiler_path()
    when !fs::exists(compiler.clone()) {
        mut message := String("error[R0301]: the compiler is not installed at ")
        message.append(compiler)
        return ryn_fail(message)
    }
    baseline_text := String("")
    mut baseline_text_value := baseline_text
    when !baseline_path.is_empty() {
        when !fs::is_file(baseline_path.clone()) {
            mut message := String("error[R0300]: no such baseline file: ")
            message.append(baseline_path)
            return ryn_fail(message)
        }
        baseline_text_value = fs::read(baseline_path.clone())
    }
    // The programs to time: every file in the `benches` directory of a project, or the given file or project itself.
    mut targets: Vec<String> = Vec()
    input = manifest::normalize(input)
    project := fs::is_dir(input.clone())
    mut packages := ryn_dependencies(input.clone())
    when packages.len() == 1 {
        return 1
    }
    when project {
        benches := manifest::join_path(input.clone(), String("benches"))
        when fs::is_dir(benches.clone()) {
            targets = ryn_bench_sources(benches)
        }
    }
    when targets.is_empty() {
        targets.push(input.clone())
    }
    scratch := env::temp_dir()
    mut work := scratch
    work.append("/ryn-bench-")
    work.append((time::monotonic() * 1000000.0).to_string())
    when !fs::create_dir_all(work.clone()) {
        return ryn_fail(String("error[R0401]: cannot create a scratch directory"))
    }
    mut entries: Vec<String> = Vec()
    mut regressions: u64 = 0
    mut failed := false
    mut report := String("")
    mut index: u64 = 0
    while index < targets.len() && !failed {
        target := targets[index].clone()
        mut shown := target.clone()
        when project && targets.len() == 1 && targets[0] == input {
            shown = manifest::join_path(input.clone(), String("src/main.ryn"))
        }
        mut executable := work.clone()
        executable.append("/bench")
        executable.append(index.to_string())
        executable = ryn_executable(executable)
        mut compile_samples: Vec<u64> = Vec()
        mut compile_peak: u64 = 0
        mut run_peak: u64 = 0
        mut run_count: u64 = 0
        while run_count < compile_runs && !failed {
            started := ryn_now_ns()
            built := process::run_capture_args(compiler.clone(), ryn_compiler_arguments("build", target.clone(), executable.clone(), packages.clone(), String("")))
            compile_samples.push(ryn_now_ns() - started)
            when built.peak_memory_kb > compile_peak {
                compile_peak = built.peak_memory_kb
            }
            when built.exit_code != 0 {
                eprint("{}", built.stderr)
                failed = true
            }
            run_count += 1
        }
        mut run_samples: Vec<u64> = Vec()
        mut total_runs: u64 = 0
        while total_runs < warmup + iterations && !failed {
            started := ryn_now_ns()
            result := process::run_capture_args(executable.clone(), program_args.clone())
            elapsed := ryn_now_ns() - started
            when result.exit_code != 0 {
                mut message := String("error[R0909]: the benchmark exited with status ")
                message.append(result.exit_code.to_string())
                message.append(": ")
                message.append(shown.clone())
                eprint("{}", message)
                failed = true
            }
            when total_runs >= warmup {
                run_samples.push(elapsed)
                when result.peak_memory_kb > run_peak {
                    run_peak = result.peak_memory_kb
                }
            }
            total_runs += 1
        }
        when !failed {
            compile := bench::bench_stats(compile_samples.clone())
            run := bench::bench_stats(run_samples.clone())
            entries.push(bench::bench_json_entry(shown.clone(), compile_samples, run_samples, warmup, compile_peak, run_peak))
            mut text := String("")
            text.append(shown.clone())
            text.append("\n  compile  median ")
            text.append(bench::bench_format(compile.median_ns))
            text.append("  min ")
            text.append(bench::bench_format(compile.min_ns))
            text.append("  max ")
            text.append(bench::bench_format(compile.max_ns))
            text.append("  peak memory ")
            text.append(bench::bench_format_kb(compile_peak))
            text.append("  (")
            text.append(compile.count.to_string())
            text.append(" runs)\n  run      median ")
            text.append(bench::bench_format(run.median_ns))
            text.append("  min ")
            text.append(bench::bench_format(run.min_ns))
            text.append("  mean ")
            text.append(bench::bench_format(run.mean_ns))
            text.append("  max ")
            text.append(bench::bench_format(run.max_ns))
            text.append("  +/- ")
            text.append(bench::bench_format(run.stddev_ns))
            text.append("  peak memory ")
            text.append(bench::bench_format_kb(run_peak))
            text.append("  (")
            text.append(run.count.to_string())
            text.append(" runs after ")
            text.append(warmup.to_string())
            text.append(" warmup)\n")
            when !baseline_path.is_empty() {
                before := bench::bench_baseline_median(baseline_text_value.clone(), shown.clone())
                when before.is_none() {
                    text.append("  baseline none for this program\n")
                } else {
                    change := bench::bench_change(before.unwrap(), run.median_ns, threshold)
                    text.append("  baseline median ")
                    text.append(bench::bench_format(before.unwrap()))
                    text.append("  now ")
                    text.append(bench::bench_percent(change.tenths))
                    when change.regression {
                        text.append("  REGRESSION (more than ")
                        text.append(threshold.to_string())
                        text.append("%)\n")
                        regressions += 1
                    } else {
                        text.append("  ok\n")
                    }
                }
                // The peak memory is compared with the same threshold when both reports have it.
                memory_before := bench::bench_baseline_peak(baseline_text_value.clone(), shown.clone())
                when memory_before.is_some() && memory_before.unwrap() > 0 && run_peak > 0 {
                    memory_change := bench::bench_change(memory_before.unwrap(), run_peak, threshold)
                    text.append("  baseline memory ")
                    text.append(bench::bench_format_kb(memory_before.unwrap()))
                    text.append("  now ")
                    text.append(bench::bench_percent(memory_change.tenths))
                    when memory_change.regression {
                        text.append("  REGRESSION (more than ")
                        text.append(threshold.to_string())
                        text.append("%)\n")
                        regressions += 1
                    } else {
                        text.append("  ok\n")
                    }
                }
            }
            report.append(text)
        }
        index += 1
    }
    removed := fs::remove_dir_all(work)
    when failed {
        return 1
    }
    json_text := bench::bench_json_report(String("0.1.13"), entries)
    when !save_path.is_empty() {
        parent := manifest::directory_of(save_path.clone())
        when !parent.is_empty() {
            made := fs::create_dir_all(parent)
        }
        mut file_text := json_text.clone()
        file_text.append("\n")
        when !fs::write(save_path.clone(), file_text) {
            mut message := String("error[R0401]: cannot write ")
            message.append(save_path)
            return ryn_fail(message)
        }
    }
    when json {
        echo "{json_text}"
    } else {
        echo "{report}"
        when regressions > 0 {
            mut summary := regressions.to_string()
            summary.append(" benchmark(s) regressed")
            echo "{summary}"
        }
    }
    when regressions > 0 {
        return 1
    }
    return 0
}

fun main() -> i32 {
    when arg_count() == 0 {
        return ryn_fail(ryn_usage())
    }
    command := String(arg(0))
    when command == "-h" || command == "--help" || command == "help" {
        text := ryn_help()
        echo "{text}"
        return 0
    }
    when command == "-V" || command == "--version" || command == "version" {
        echo "ryn 0.1.13"
        return 0
    }
    when command == "bench" {
        return ryn_bench()
    }
    when command == "new" || command == "clean" {
        when arg_count() != 2 {
            return ryn_fail(ryn_usage())
        }
        path := String(arg(1))
        when command == "new" {
            return ryn_new(path)
        }
        return ryn_clean(path)
    }
    when command == "login" {
        when arg_count() != 2 {
            return ryn_fail(ryn_usage())
        }
        saved := pkg::login(String(arg(1)))
        when saved.is_err() {
            return ryn_fail(saved.unwrap_err())
        }
        path := saved.unwrap()
        echo "saved registry token to {path}"
        return 0
    }
    when command == "lock" {
        when arg_count() != 2 || !fs::is_dir(String(arg(1))) {
            return ryn_fail(ryn_usage())
        }
        locked := pkg::write_lock(String(arg(1)))
        when locked.is_err() {
            return ryn_fail(locked.unwrap_err())
        }
        path := locked.unwrap()
        echo "locked {path}"
        return 0
    }
    when command == "publish" {
        mut directory := String(".")
        when arg_count() > 2 {
            return ryn_fail(ryn_usage())
        }
        when arg_count() == 2 {
            directory = String(arg(1))
        }
        when !fs::is_file(manifest::join_path(directory.clone(), String("ryn.yaml"))) {
            return ryn_fail(ryn_usage())
        }
        when fs::is_file(manifest::join_path(directory.clone(), String("src/main.ryn"))) {
            checked := ryn_compiler("check", directory.clone(), String(""), ryn_dependencies(directory.clone()), String(""))
            when checked != 0 {
                return checked
            }
        }
        published := pkg::publish(directory)
        when published.is_err() {
            return ryn_fail(published.unwrap_err())
        }
        url := published.unwrap()
        echo "published {url}"
        return 0
    }
    when command == "update" {
        return ryn_update()
    }
    when command == "asm" {
        return ryn_asm()
    }
    when command != "check" && command != "build" && command != "run" {
        return ryn_fail(ryn_usage())
    }
    mut input := String("")
    mut output := String("")
    mut release := false
    mut build_target := String("")
    mut program_args: Vec<String> = Vec()
    mut position: u32 = 1
    while position < arg_count() {
        word := String(arg(position))
        when word == "--" && command == "run" {
            position += 1
            while position < arg_count() {
                program_args.push(String(arg(position)))
                position += 1
            }
        } else when (word == "-o" || word == "--output") && command != "check" && position + 1 < arg_count() && output.is_empty() {
            output = String(arg(position + 1))
            position += 2
        } else when word == "--backend" && position + 1 < arg_count() {
            backend := String(arg(position + 1))
            when backend != "native" {
                mut message := String("error[R0907]: unknown backend `")
                message.append(backend)
                message.append("`; use `native`")
                return ryn_fail(message)
            }
            position += 2
        } else when word == "--target" && command != "build" {
            return ryn_fail(String("error[R0910]: --target is accepted by ryn build only"))
        } else when word == "--target" && position + 1 < arg_count() {
            requested := String(arg(position + 1))
            when requested == "aarch64-linux" {
                build_target = requested
            } else when requested != "linux" {
                mut message := String("error[R0910]: unknown target `")
                message.append(requested)
                message.append("`; use `aarch64-linux` or leave the option out for this Linux x86-64 build")
                return ryn_fail(message)
            }
            position += 2
        } else when word == "--release" && command != "check" && !release {
            release = true
            position += 1
        } else when input.is_empty() && !word.starts_with("-") {
            input = word
            position += 1
        } else {
            return ryn_fail(ryn_usage())
        }
    }
    when input.is_empty() {
        return ryn_fail(ryn_usage())
    }
    input = manifest::normalize(input)
    project := fs::is_dir(input.clone())
    when command == "check" {
        packages := ryn_dependencies(input.clone())
        when packages.len() == 1 {
            return 1
        }
        status := ryn_compiler("check", input.clone(), String(""), packages, String(""))
        when status == 0 {
            mut shown := input.clone()
            when project {
                shown = manifest::join_path(input.clone(), String("src/main.ryn"))
            }
            echo "{shown}: ok"
        }
        return status
    }
    mut scratch := String("")
    when command == "run" && output.is_empty() && !project {
        scratch = env::temp_dir()
        scratch.append("/ryn-run-")
        scratch.append(time::unix().to_string())
        when !fs::create_dir_all(scratch.clone()) {
            return ryn_fail(String("error[R0401]: cannot create a scratch directory"))
        }
        output = manifest::join_path(scratch.clone(), ryn_base_name(ryn_default_output(input.clone(), false, release)))
    }
    when output.is_empty() {
        output = ryn_default_output(input.clone(), project, release)
    }
    parent := manifest::directory_of(output.clone())
    when !parent.is_empty() {
        made := fs::create_dir_all(parent)
    }
    packages := ryn_dependencies(input.clone())
    when packages.len() == 1 {
        return 1
    }
    status := ryn_compiler("build", input, output.clone(), packages, build_target.clone())
    when status != 0 {
        when !scratch.is_empty() {
            removed := fs::remove_dir_all(scratch)
        }
        return status
    }
    when command == "build" {
        echo "built {output}"
        return 0
    }
    mut absolute := output
    when !manifest::is_absolute(absolute.clone()) {
        absolute = manifest::join_path(env::current_dir(), absolute)
    }
    code := run_process_args(absolute, program_args)
    when !scratch.is_empty() {
        removed := fs::remove_dir_all(scratch)
    }
    return code
}
