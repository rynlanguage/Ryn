// SHA-256 (FIPS 180-4) over a byte vector, written as lowercase hexadecimal: the checksum format the registry and
// `ryn.lock` use.

fun sha_k() -> Vec<u32> {
    mut k: Vec<u32> = Vec()
    values: [u32; 64] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ]
    mut at: u64 = 0
    while at < 64 {
        k.push(values[at])
        at += 1
    }
    return k
}

fun sha_rotr(value: u32, count: u32) -> u32 {
    return (value >> count) | (value << (32 - count))
}

fun sha_hex_digit(value: u32) -> String {
    digits := String("0123456789abcdef")
    at := value as u64
    return digits.slice(at, at + 1)
}

// The lowercase hexadecimal SHA-256 of `data`.
pub fun sha256_hex(data: Vec<u8>) -> String {
    k := sha_k()
    mut h0: u32 = 0x6a09e667
    mut h1: u32 = 0xbb67ae85
    mut h2: u32 = 0x3c6ef372
    mut h3: u32 = 0xa54ff53a
    mut h4: u32 = 0x510e527f
    mut h5: u32 = 0x9b05688c
    mut h6: u32 = 0x1f83d9ab
    mut h7: u32 = 0x5be0cd19

    // The padded message: the data, 0x80, zeros, and the bit length as 64 bits, big-endian.
    mut message: Vec<u8> = data.clone()
    length_bits: u64 = (data.len() as u64) * 8
    message.push(128 as u8)
    while message.len() % 64 != 56 {
        message.push(0 as u8)
    }
    mut shift: u32 = 56
    while true {
        message.push(((length_bits >> shift) & 255) as u8)
        when shift == 0 {
            break
        }
        shift -= 8
    }

    mut block: u64 = 0
    while block < message.len() as u64 {
        mut w: Vec<u32> = Vec()
        mut t: u64 = 0
        while t < 16 {
            base := block + t * 4
            word := ((message[base] as u32) << 24) | ((message[base + 1] as u32) << 16) | ((message[base + 2] as u32) << 8) | (message[base + 3] as u32)
            w.push(word)
            t += 1
        }
        while t < 64 {
            s0 := sha_rotr(w[t - 15], 7) ^ sha_rotr(w[t - 15], 18) ^ (w[t - 15] >> 3)
            s1 := sha_rotr(w[t - 2], 17) ^ sha_rotr(w[t - 2], 19) ^ (w[t - 2] >> 10)
            w.push(w[t - 16] + s0 + w[t - 7] + s1)
            t += 1
        }
        mut a := h0
        mut b := h1
        mut c := h2
        mut d := h3
        mut e := h4
        mut f := h5
        mut g := h6
        mut hh := h7
        t = 0
        while t < 64 {
            big1 := sha_rotr(e, 6) ^ sha_rotr(e, 11) ^ sha_rotr(e, 25)
            pick := (e & f) ^ ((e ^ 0xffffffff) & g)
            temp1 := hh + big1 + pick + k[t] + w[t]
            big0 := sha_rotr(a, 2) ^ sha_rotr(a, 13) ^ sha_rotr(a, 22)
            majority := (a & b) ^ (a & c) ^ (b & c)
            temp2 := big0 + majority
            hh = g
            g = f
            f = e
            e = d + temp1
            d = c
            c = b
            b = a
            a = temp1 + temp2
            t += 1
        }
        h0 = h0 + a
        h1 = h1 + b
        h2 = h2 + c
        h3 = h3 + d
        h4 = h4 + e
        h5 = h5 + f
        h6 = h6 + g
        h7 = h7 + hh
        block += 64
    }

    mut out := String("")
    mut words: Vec<u32> = Vec()
    words.push(h0)
    words.push(h1)
    words.push(h2)
    words.push(h3)
    words.push(h4)
    words.push(h5)
    words.push(h6)
    words.push(h7)
    mut index: u64 = 0
    while index < 8 {
        mut nibble: u32 = 28
        while true {
            out.append(sha_hex_digit((words[index] >> nibble) & 15))
            when nibble == 0 {
                break
            }
            nibble -= 4
        }
        index += 1
    }
    return out
}
