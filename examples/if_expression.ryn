fun select_value(flag: bool) -> i32 {
    when flag {
        10
    } else when true {
        20
    } else {
        30
    }
}

fun mark(value: i32) -> i32 {
    echo value
    value
}

fun main() {
    message := when false { "wrong" } else { "selected" }
    echo message

    decimal: f32 = when true { 1.5 } else { 2.5 }
    echo decimal

    echo when false { false } else { true }

    answer := when true { mark(1) } else { mark(2) }
    echo answer

    echo select_value(false) + when false { 1 } else { 2 }
    echo when false { 1 } else when false { 2 } else { 3 } + 4
}
