fun add(a: i32, b: i32) -> i32 {
    a + b
}

fun negate(value: i32) -> i32 {
    -value
}

fun main() {
    mut total: i32 = add(20, 22)
    minimum: i32 = -2147483648
    maximum: i32 = 2147483647
    total = total + 1
    echo total
    echo negate(5)
    echo minimum
    echo maximum
    echo total > 40
}
