fn lower_bound() -> i32 {
    print("lower")
    1
}

fn upper_bound() -> i32 {
    print("upper")
    4
}

fn main() {
    let mut total = 0
    for index in 0..6 {
        if index == 2 {
            continue
        }
        if index == 5 {
            break
        }
        print(index)
        total += index
    }
    print(total)

    for index in lower_bound()..upper_bound() {
        print(index)
    }

    let byte_start: u8 = 254
    let byte_end: u8 = 255
    for byte in byte_start..byte_end {
        print(byte)
    }
}
