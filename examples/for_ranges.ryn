fun lower_bound() -> i32 {
    echo "lower"
    1
}

fun upper_bound() -> i32 {
    echo "upper"
    4
}

fun main() {
    mut total := 0
    for index in 0..6 {
        when index == 2 {
            continue
        }
        when index == 5 {
            break
        }
        echo index
        total += index
    }
    echo total

    for index in lower_bound()..upper_bound() {
        echo index
    }

    byte_start: u8 = 254
    byte_end: u8 = 255
    for byte in byte_start..byte_end {
        echo byte
    }
}
