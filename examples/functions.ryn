fun main() {
    notify()
    echo twice(add(10, 11))
    echo next(41)
    echo say("native calls")
    echo invert(false)
    echo false && mark()
    echo true || mark()
    echo true && mark()
    echo false || mark()
}

fun add(a: i64, b: i64) -> i64 {
    a + b
}

fun twice(value: i64) -> i64 {
    add(value, value)
}

fun next(value: i64) -> i64 {
    return value + 1
}

fun say(value: str) -> str {
    value
}

fun invert(value: bool) -> bool {
    !value
}

fun mark() -> bool {
    echo "rhs"
    true
}

fun notify() {
    echo "void call"
}
