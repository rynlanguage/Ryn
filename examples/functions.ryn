fn main() {
    notify()
    print(twice(add(10, 11)))
    print(next(41))
    print(echo("native calls"))
    print(invert(false))
    print(false && mark())
    print(true || mark())
    print(true && mark())
    print(false || mark())
}

fn add(a: i64, b: i64) -> i64 {
    a + b
}

fn twice(value: i64) -> i64 {
    add(value, value)
}

fn next(value: i64) -> i64 {
    return value + 1
}

fn echo(value: str) -> str {
    value
}

fn invert(value: bool) -> bool {
    !value
}

fn mark() -> bool {
    print("rhs")
    true
}

fn notify() {
    print("void call")
}
