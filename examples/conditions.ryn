fun main() {
    mut score := 10

    when score >= 10 && score < 20 {
        score += 5
        echo "rank up"
    } else {
        echo "no rank"
    }

    echo score
    echo score == 15

    mut selected := 0
    when score == 15 {
        selected = 1
    } else {
        selected = 2
    }
    echo selected

    when !false {
        when score > 0 {
            echo "boolean works"
        } else {
            echo "unexpected"
        }
    }
}
