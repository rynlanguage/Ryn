fun scale(value: f32, factor: f32) -> f32 {
    value * factor - 0.0
}

fun identity(value: f64) -> f64 {
    value
}

fun main() {
    mut precise: f64 = 1.25
    precise = precise * 4.0 / 2.0 + 0.0 - 0.0
    small := scale(1.5, 2.0)
    echo precise
    echo -precise
    echo small
    echo -small
    echo identity(0.125)
    echo small > 2.5
    echo precise <= 2.5
    echo 1.25

    zero64: f64 = 0.0
    nan64 := zero64 / zero64
    zero32: f32 = 0.0
    nan32 := zero32 / zero32
    echo 1.0 / zero64
    echo -1.0 / zero64
    echo nan64
    echo -0.0
    echo nan64 == nan64
    echo nan64 != nan64
    echo nan64 < 1.0
    echo nan64 <= 1.0
    echo nan64 > 1.0
    echo nan64 >= 1.0
    echo -0.0 == 0.0
    echo 1.0 / zero32
    echo -1.0 / zero32
    echo nan32
    echo nan32 == nan32
    echo nan32 != nan32
    echo nan32 < 1.0
}
