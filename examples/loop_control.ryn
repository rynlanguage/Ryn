fun main() {
    mut count := 0
    while count < 5 {
        count += 1
        when count == 2 {
            continue
        }
        when count == 4 {
            break
        }
        echo count
    }
    echo count

    mut outer := 0
    while outer < 2 {
        outer += 1
        mut inner := 0
        while inner < 3 {
            inner += 1
            when inner == 2 {
                continue
            }
            when inner == 3 {
                break
            }
            echo outer * 10 + inner
        }
    }

    mut stop := 0
    while stop < 3 {
        stop += 1
        when stop == 1 {
            continue
        } else {
            break
        }
        echo 999
    }
    echo stop
}
