    assert(control_execution.return_value == 4)

    branch_source := parse_simple_program(String("mut selected := 0; when false { selected = 1; } else { when true { selected = 2; } else { selected = 3; } } echo selected; return selected"))
    assert(!branch_source.state.failed)
    branch_execution := evaluate_program(AstArena {
        source: branch_source.state.source.clone(),
        nodes: branch_source.state.nodes.clone(),
        children: branch_source.state.children.clone()
    }, branch_source.node_id)
    assert(branch_execution.output.len() == 1)
    assert(branch_execution.output.index(0) == 2)
    assert(branch_execution.return_value == 2)

    function_source := parse_simple_program(String("fun add(left: i32, right: i32) -> i32 { return left + right; } fun main() -> i32 { return add(20, 22); }"))
    assert(!function_source.state.failed)
    function_root := function_source.state.nodes.index(function_source.node_id)
    assert(function_root.child_count == 2)
    first_function_id := function_source.state.children.index(function_root.first_child)
    first_function := function_source.state.nodes.index(first_function_id)
    assert(first_function.kind == 30)
    assert(first_function.child_count == 4)
    function_params_id := function_source.state.children.index(first_function.first_child + 1)
    function_params := function_source.state.nodes.index(function_params_id)
    assert(function_params.kind == 31)
    assert(function_params.child_count == 2)
    second_function_id := function_source.state.children.index(function_root.first_child + 1)
    second_function := function_source.state.nodes.index(second_function_id)
    second_body_id := function_source.state.children.index(second_function.first_child + 3)
    second_body := function_source.state.nodes.index(second_body_id)
    return_id := function_source.state.children.index(second_body.first_child)
    return_node := function_source.state.nodes.index(return_id)
    call_id := function_source.state.children.index(return_node.first_child)
    call_node := function_source.state.nodes.index(call_id)
    assert(call_node.kind == 19)
    assert(call_node.payload == 2)
    function_execution := evaluate_program(AstArena {
        source: function_source.state.source.clone(),
        nodes: function_source.state.nodes.clone(),
        children: function_source.state.children.clone()
    }, function_source.node_id)
    assert(function_execution.return_value == 42)

    generic_signature := parse_simple_program(String("fun first<T>(items: &[T]) -> &T { return items[0].field; }"))
    assert(!generic_signature.state.failed)
    generic_root := generic_signature.state.nodes.index(generic_signature.node_id)
    generic_function_id := generic_signature.state.children.index(generic_root.first_child)
    generic_function := generic_signature.state.nodes.index(generic_function_id)
    assert(generic_function.kind == 30)
    assert(generic_function.child_count == 5)
    generic_parameters_id := generic_signature.state.children.index(generic_function.first_child + 1)
    generic_parameters := generic_signature.state.nodes.index(generic_parameters_id)
    first_parameter_id := generic_signature.state.children.index(generic_parameters.first_child)
    first_parameter := generic_signature.state.nodes.index(first_parameter_id)
    parameter_type_id := generic_signature.state.children.index(first_parameter.first_child + 1)
    parameter_type := generic_signature.state.nodes.index(parameter_type_id)
    assert(generic_signature.state.source.slice(parameter_type.start, parameter_type.end) == String("&[T]"))
    generic_names_id := generic_signature.state.children.index(generic_function.first_child + 4)
    generic_names := generic_signature.state.nodes.index(generic_names_id)
    assert(generic_names.kind == 33)
    assert(generic_names.child_count == 1)
    generic_return_id := generic_signature.state.children.index(generic_function.first_child + 2)
    generic_return := generic_signature.state.nodes.index(generic_return_id)
    assert(generic_signature.state.source.slice(generic_return.start, generic_return.end) == String("&T"))
    generic_body_id := generic_signature.state.children.index(generic_function.first_child + 3)
    generic_body := generic_signature.state.nodes.index(generic_body_id)
    generic_return_statement_id := generic_signature.state.children.index(generic_body.first_child)
    generic_return_statement := generic_signature.state.nodes.index(generic_return_statement_id)
    generic_field_access_id := generic_signature.state.children.index(generic_return_statement.first_child)
    generic_field_access := generic_signature.state.nodes.index(generic_field_access_id)
    assert(generic_field_access.kind == 35)
    generic_index_id := generic_signature.state.children.index(generic_field_access.first_child)
    generic_index := generic_signature.state.nodes.index(generic_index_id)
    assert(generic_index.kind == 34)

    recursive_source := parse_simple_program(String("fun sum(value: i32) -> i32 { when value <= 0 { return 0; } return value + sum(value - 1); } fun main() -> i32 { return sum(5); }"))
    assert(!recursive_source.state.failed)
    recursive_execution := evaluate_program(AstArena {
        source: recursive_source.state.source.clone(),
        nodes: recursive_source.state.nodes.clone(),
        children: recursive_source.state.children.clone()
    }, recursive_source.node_id)
    assert(recursive_execution.return_value == 15)
}

