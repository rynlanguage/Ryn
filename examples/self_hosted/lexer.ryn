    }, range_boundary.node_id) == 40)
        malformed_choose := parse_arithmetic(String("choose 1 { 'x' => 2 }"))
    assert(malformed_choose.state.failed)
    assert(malformed_choose.state.error_code == 8)
    loop_program := parse_simple_program(String("while true { continue; break; } return;"))
    assert(!loop_program.state.failed)
    loop_root := loop_program.state.nodes.index(loop_program.node_id)
    assert(loop_root.child_count == 2)
    loop_id := loop_program.state.children.index(loop_root.first_child)
    loop_node := loop_program.state.nodes.index(loop_id)
    assert(loop_node.kind == 14)
    loop_body_id := loop_program.state.children.index(loop_node.first_child + 1)
    loop_body := loop_program.state.nodes.index(loop_body_id)
    assert(loop_body.kind == 13)
    assert(loop_body.child_count == 2)
    first_loop_statement := loop_program.state.children.index(loop_body.first_child)
    second_loop_statement := loop_program.state.children.index(loop_body.first_child + 1)
    assert(loop_program.state.nodes.index(first_loop_statement).kind == 16)
    assert(loop_program.state.nodes.index(second_loop_statement).kind == 15)
    bare_return_id := loop_program.state.children.index(loop_root.first_child + 1)
    bare_return := loop_program.state.nodes.index(bare_return_id)
    assert(bare_return.kind == 21)
    assert(bare_return.child_count == 0)
