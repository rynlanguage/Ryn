    assert(!for_program.state.failed)
    for_root := for_program.state.nodes.index(for_program.node_id)
    assert(for_root.child_count == 1)
    for_id := for_program.state.children.index(for_root.first_child)
    for_node := for_program.state.nodes.index(for_id)
