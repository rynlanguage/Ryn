fn classify(value: i32) -> str {
    if value < 0 {
        return "negative"
    } else if value == 0 {
        return "zero"
    }
    "positive"
}

fn classify_code(value: i32) -> i32 {
    if value < 0 {
        return -1
    } else if value == 0 {
        return 0
    } else {
        return 1
    }
}

fn main() {
    print(classify(-1))
    print(classify(0))
    print(classify(1))
    print(classify_code(-1))
    print(classify_code(0))
    print(classify_code(1))
}
