fun classify(value: i32) -> str {
    when value < 0 {
        return "negative"
    } else when value == 0 {
        return "zero"
    }
    "positive"
}

fun classify_code(value: i32) -> i32 {
    when value < 0 {
        return -1
    } else when value == 0 {
        return 0
    } else {
        return 1
    }
}

fun main() {
    echo classify(-1)
    echo classify(0)
    echo classify(1)
    echo classify_code(-1)
    echo classify_code(0)
    echo classify_code(1)
}
