struct Point { x: i32, y: i32 }

fun bump(values: &mut [i32]) {
    mut index: u64 = 0
    while index < values.len() {
        values[index] = values[index] + 10
        index += 1
    }
}

fun main() {
    mut point := Point { x: 1, y: 2 }
    reference := &mut point
    reference.x = 3
    echo reference.x
    // The reference's last use is above; the owner is available again.
    point.y = 4
    echo point.y

    mut values: [i32; 3] = [1, 2, 3]
    bump(&mut values)
    view: &[i32] = &values
    echo view[0]
    echo view.len()
    values[1] = 20
    echo values[1]

    mut items: Vec<i32> = Vec()
    items.push(4)
    items.push(5)
    bump(items.as_mut_slice())
    echo items[0]
    echo items[1]
}
