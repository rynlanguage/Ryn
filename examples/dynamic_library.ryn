type AbsFn = extern "C" fun(i32) -> i32

fun invoke(function: AbsFn, value: i32) -> i32 {
    function(value)
}

fun main() {
    library := load_library("ucrtbase.dll")
    assert_message(!pointer_is_null(library), "could not load ucrtbase.dll")

    absolute_value := load_symbol(library, "abs")
    assert_message(!pointer_is_null(absolute_value), "could not find abs in ucrtbase.dll")
    typed_absolute_value: AbsFn = absolute_value as AbsFn
    echo invoke(typed_absolute_value, -42)

    missing_symbol := load_symbol(library, "ryn_symbol_that_does_not_exist")
    assert(pointer_is_null(missing_symbol))
    assert(unload_library(library))
}
