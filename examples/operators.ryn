struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

extend Vec3 {
    fun new(x: f32, y: f32, z: f32) -> Vec3 {
        return Vec3 { x: x, y: y, z: z }
    }

    fun add(self, rhs: Vec3) -> Vec3 {
        return Vec3 {
            x: self.x + rhs.x,
            y: self.y + rhs.y,
            z: self.z + rhs.z,
        }
    }

    fun sub(self, rhs: Vec3) -> Vec3 {
        return Vec3 {
            x: self.x - rhs.x,
            y: self.y - rhs.y,
            z: self.z - rhs.z,
        }
    }

    fun mul(self, scalar: f32) -> Vec3 {
        return Vec3 {
            x: self.x * scalar,
            y: self.y * scalar,
            z: self.z * scalar,
        }
    }
}

fun main() {
    a := Vec3::new(1.0, 2.0, 3.0)
    b := Vec3::new(10.0, 20.0, 30.0)
    sum := a + b
    echo sum.x
    echo sum.y
    echo sum.z
    scaled := a * 2.0
    echo scaled.x
    diff := b - a
    echo diff.z
    echo a.x
}
