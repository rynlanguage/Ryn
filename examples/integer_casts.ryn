fun small_count() -> i16 {
    2
}

fun main() {
    signed: i8 = -1
    echo signed as i16
    echo signed as u16

    wide: u64 = 18446744073709551615
    echo 18446744073709551615 as u64
    echo wide as u8
    echo wide as i64

    small: u8 = 255
    echo small as i64
    count := small_count() as u32
    one: u8 = 1
    echo one << count

    pattern: u16 = 0x1234
    echo pattern as u8

    rounded: u64 = 16777217
    echo rounded as f32 == 16777216.0
    fraction: f32 = 0.1
    promoted: f64 = fraction as f64
    echo promoted == 0.10000000149011612
    halfway_down: f64 = 1.000000059604644775390625
    echo halfway_down as f32 == 1.0
    halfway_up: f64 = 1.000000178813934326171875
    echo halfway_up as f32 == 1.000000238418579
    large_float: f64 = 1e300
    echo large_float as f32

    fractional: f64 = 12.9
    echo fractional as i32
    negative: f64 = -12.9
    echo negative as i32
    echo large_float as u8
    negative_large: f64 = -1e300
    echo negative_large as i8
    not_a_number: f64 = 0.0 / 0.0
    echo not_a_number as i16
    echo not_a_number as u64
    echo negative as u16
    positive_infinity: f64 = 1.0 / 0.0
    echo positive_infinity as i64
    echo positive_infinity as u64
    negative_infinity: f64 = -1.0 / 0.0
    echo negative_infinity as u64
}
