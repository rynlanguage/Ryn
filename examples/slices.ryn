fun sum(values: &[i32]) -> i32 {
    mut total := 0 as i32
    for value in values {
        total += value
    }
    total
}

fun first_string(values: &[String]) -> String {
    return values[0]
}

fun total_string_chars(values: &[String]) -> u64 {
    mut total := 0 as u64
    for value in values {
        total += value.char_count()
    }
    return total
}

struct LabelledValues {
    label: String,
    values: Vec<i32>
}

fun first_label(values: &[LabelledValues]) -> String {
    return values[0].label
}

fun first_map_score(values: &[Map<String, i32>]) -> i32 {
    return choose values[0].get(String("score")) {
        Option::Some(score) => score,
        Option::None => 0
    }
}

fun main() {
    mut values: Vec<i32> = Vec()
    values.push(4)
    values.push(7)
    values.push(9)
    values.push(12)

    all := sum(values.as_slice())
    middle := sum(values.slice(1, 3))
    echo all
    echo middle

    mut names := Vec<String>()
    names.push(String("Ryn"))
    names.push(String("🦀"))
    echo first_string(names.as_slice())
    echo total_string_chars(names.slice(0, 2))
    echo names.take(0)

    mut records := Vec<LabelledValues>()
    mut scores := Vec<i32>()
    scores.push(9)
    records.push(LabelledValues { label: String("nested"), values: scores })
    echo first_label(records.as_slice())

    mut maps := Vec<Map<String, i32>>()
    mut scores_by_name := Map<String, i32>()
    scores_by_name.insert(String("score"), 27)
    maps.push(scores_by_name)
    echo first_map_score(maps.as_slice())
}
