fun find(names: Vec<String>) -> bool {
    mut existing := false
    for slot in 0 as u64..names.len() {
        when names.index(slot) == String("count") {
            existing = true
        }
    }
    existing
}

fun main() {
    mut v := Vec<String>()
    v.push(String("count"))
    echo find(v)
    echo "done"
}
