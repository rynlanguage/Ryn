type UserId = u64
type Score = i32
type Scores = [Score; 3]

struct User {
    id: UserId,
    score: Score
}

fun adjusted(value: Score) -> Score {
    value + 2
}

fun main() {
    mut values: Scores = [1, 3, 5]
    values[1] = adjusted(values[1])
    user := User { id: 42, score: values[1] }
    echo user.id
    echo user.score
}
