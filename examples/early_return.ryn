fun absolute(value: i32) -> i32 {
    when value < 0 {
        return -value
    }
    value
}

fun select_value(value: i32) -> i32 {
    when value == 0 {
        return 10
    } else {
        return 20
    }
}

fun label(enabled: bool) -> str {
    when enabled {
        return "enabled"
    } else {
        return "disabled"
    }
}

fun find_three(limit: i32) -> i32 {
    mut value: i32 = 0
    while value < limit {
        when value == 3 {
            return value
        }
        value += 1
    }
    -1
}

fun notify(enabled: bool) {
    when !enabled {
        return
    }
    echo "notification"
}

fun main() {
    echo absolute(-7)
    echo absolute(4)
    echo select_value(0)
    echo select_value(1)
    echo label(true)
    echo label(false)
    echo find_three(5)
    echo find_three(2)
    notify(false)
    notify(true)
}
