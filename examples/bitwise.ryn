fun main() {
    flags: u8 = 0b1100
    mask: u8 = 0b1010

    echo flags & mask
    echo flags | mask
    echo flags ^ mask
    echo ~mask
    echo flags & ~mask
    echo (flags & mask) == 8
    mut updated: u8 = flags
    updated &= mask
    updated |= 1
    updated ^= 2
    echo updated
    count: u32 = 2
    echo flags << count
    echo flags >> count
    echo flags << 8
    mut shifted: u8 = flags
    shifted <<= 2
    shifted >>= 1
    echo shifted
    signed: i8 = -64
    echo signed >> count
    echo signed >> 8
    echo 1 | 2 ^ 3 & 4
    echo 1 + 2 << 1
    echo 1 << 2 & 6
    echo 1 + 2 & 6
    echo false || true && false
}
