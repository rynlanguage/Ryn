fun main() {
    max: i8 = 127
    min: i8 = -128
    half: i8 = 64
    neg_seven: i8 = -7
    min16: i16 = -32768
    min32: i32 = -2147483648
    min64: i64 = -9223372036854775808
    max_u8: u8 = 255
    max_u16: u16 = 65535
    max_u32: u32 = 4294967295
    max_u64: u64 = 18446744073709551615

    echo max + 1
    echo min - 1
    echo half * 2
    echo -min
    echo neg_seven / 2
    echo neg_seven % 2
    echo min / -1
    echo min % -1
    echo min16 / -1
    echo min16 % -1
    echo min32 / -1
    echo min32 % -1
    echo min64 / -1
    echo min64 % -1
    echo max_u8 / 2
    echo max_u8 % 2
    echo max_u16 / 256
    echo max_u16 % 256
    echo max_u32 / 10
    echo max_u32 % 10
    echo max_u64 / 10
    echo max_u64 % 10
}
