fun main() {
    mut numbers := Vec<i32>()
    numbers.push(3)
    numbers.push(5)
    numbers.push(8)

    mut sum: i32 = 0
    for number in numbers {
        when number == 5 {
            continue
        }
        sum += number
    }
    echo sum

    mut names := Vec<String>()
    names.push(String("Ryn"))
    names.push(String("compiler"))
    for name in names {
        echo name
        break
    }
}
