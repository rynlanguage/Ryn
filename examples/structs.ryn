struct Player {
    name: str
    vitals: Vitals
}

struct Vitals {
    health: i32
    alive: bool
}

fun damage(player: Player, amount: i32) -> Player {
    mut updated := Player {
        name: player.name,
        vitals: player.vitals,
    }
    updated.vitals.health -= amount
    updated.vitals.alive = updated.vitals.health > 0
    updated
}

fun main() {
    player := Player {
        name: "Veni",
        vitals: Vitals {
            health: 100,
            alive: true,
        },
    }
    damaged := when true { damage(player, 35) } else { player }
    echo damaged.name
    echo damaged.vitals.health
    echo damaged.vitals.alive
    echo player.vitals.health
    echo player
    echo "updated={damaged}"
}
