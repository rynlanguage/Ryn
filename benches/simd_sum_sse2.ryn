// The same sum as simd_sum_scalar.ryn, four lanes at a time with SSE2 (std::simd::F32x4).
use std::simd
extern "C" fun malloc(size: u64) -> *u8;
extern "C" fun free(block: *u8);
fun main() {
    count: u64 = 1048576
    data := malloc(count * 4 as u64)
    mut at: u64 = 0
    while at < count {
        slot := (data as u64 + at * 4 as u64) as *f32
        *slot = ((at % 7 as u64) as f32) * 0.5
        at += 1
    }
    mut total: f32 = 0.0
    mut pass: u64 = 0
    while pass < 64 {
        mut index: u64 = 0
        mut lanes := simd::F32x4::zero()
        while index < count {
            lanes = lanes.add(simd::F32x4::load((data as u64 + index * 4 as u64) as *u8))
            index += 4
        }
        total = total + lanes.sum()
        pass += 1
    }
    echo total
    free(data)
}
