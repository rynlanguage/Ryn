// The same sum as simd_sum_scalar.ryn (1,048,576 f32 values, 64 passes), one call of std::simd::sum_f32 per pass: the fused
// loop runs the AVX2 form here when the processor has it. The data is exact in binary, so the printed total equals the scalar
// loop's whatever the order of the additions.
use std::simd
extern "C" fun malloc(size: u64) -> *u8;
extern "C" fun free(block: *u8);
fun main() {
    count: u64 = 1048576
    data := malloc(count * 4 as u64) as *f32
    mut at: u64 = 0
    while at < count {
        slot := (data as u64 + at * 4 as u64) as *f32
        *slot = ((at % 7 as u64) as f32) * 0.5
        at += 1
    }
    mut total: f32 = 0.0
    mut pass: u64 = 0
    while pass < 64 {
        total = total + simd::sum_f32(data, count)
        pass += 1
    }
    echo total
    free(data as *u8)
}
