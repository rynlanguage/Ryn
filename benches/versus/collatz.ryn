fun main() {
    limit: u64 = 3000000
    mut best: u64 = 0
    mut best_start: u64 = 0
    mut start: u64 = 1
    while start < limit {
        mut x: u64 = start
        mut steps: u64 = 0
        while x != 1 {
            when x % 2 == 0 {
                x = x / 2
            } else {
                x = 3 * x + 1
            }
            steps += 1
        }
        when steps > best {
            best = steps
            best_start = start
        }
        start += 1
    }
    echo best_start
}
