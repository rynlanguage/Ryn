// test: run
// out: 5
// out: 8
// out: 5
// A field of a structure nested in the result of a call is read, and the rest of the result is dropped.
pub struct P { pub x: i64, pub name: String }
pub struct Q { pub p: P, pub k: i64 }
pub struct W { pub q: Q, pub label: String }
fun make() -> W { return W { q: Q { p: P { x: 5, name: String("nm") }, k: 8 }, label: String("w") } }
fun main() {
    echo make().q.p.x
    echo make().q.k
    pp := make().q.p
    echo pp.x
}
