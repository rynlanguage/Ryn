// test: run
// out: 4
// out: 3
// out: 3
// out: 4
// out: 2
// out: 1
// out: 1
// A structure literal may write its fields in any order. Each value is evaluated in the order it is written, and the
// structure has its fields in declaration order, whether the literal is a return value, a call argument or a `let`.
struct Point {
    x: i32
    y: i32
}

fun note(value: i32) -> i32 {
    echo(value)
    return value
}

fun show(point: Point) {
    echo(point.x)
    echo(point.y)
}

fun make() -> Point {
    return Point { y: note(2), x: note(1) }
}

fun main() {
    show(Point { y: note(4), x: note(3) })
    point := make()
    echo(point.x)
}
