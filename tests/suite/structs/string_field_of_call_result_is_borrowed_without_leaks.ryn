// test: run
// out: 4
// out: 2
// out: wxyz!
// out: xy
// out: nm
// out: 0
// A method is called on a `String` field of a call result (`make().label.len()`, also nested). The string moves into a
// hidden local that lives as long as the name bound from it, and nothing leaks or is freed twice.
extern "C" fun ryn_native_live_allocations() -> u64;
pub struct P { pub x: i64, pub name: String }
pub struct Q { pub p: P, pub k: i64 }
pub struct W { pub q: Q, pub label: String }
fun make() -> W {
    return W { q: Q { p: P { x: 5, name: String("nm") }, k: 8 }, label: String("wxyz") }
}
fun run() {
    n := make().label.len()
    echo n
    c := make().q.p.name.len()
    echo c
    mut d := make().label.clone()
    d.append("!")
    echo d
    e := make().label.slice(1, 3)
    echo e
    when true {
        f := make().q.p.name.clone()
        echo f
    }
    k := make().label.len() + make().label.len()
}
fun main() {
    before := ryn_native_live_allocations()
    run()
    after := ryn_native_live_allocations()
    echo after - before
}
