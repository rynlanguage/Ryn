// test: run
// out: count
// out: 2
// out: 3
// exit: 0
// A `str` local takes two slots, so a later `mut self` receiver must still find its own slot.
struct Counter {
    value: i32,
}

extend Counter {
    pub fun bump(mut self) -> i32 {
        self.value += 1
        return self.value
    }
}

fun main() {
    label := "count"
    mut counter := Counter { value: 1 }
    echo label
    echo counter.bump()
    echo counter.bump()
}
