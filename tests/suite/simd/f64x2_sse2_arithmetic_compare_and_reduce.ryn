// out: 1.5
// out: true
// out: true
use std::simd
fun show(v: simd::F64x2) {
    echo v.get(0)
    echo v.get(1)
}
fun main() {
    a := simd::F64x2::splat(0.0).with(0, 1.5).with(1, -2.0)
    b := simd::F64x2::splat(0.0).with(0, 0.5).with(1, 8.0)
    r := simd::F64x2::splat(0.0).with(0, 4.0).with(1, 2.25)
    show(a.add(b))
    show(a.sub(b))
    show(a.mul(b))
    show(a.div(b))
    show(a.min(b))
    show(a.max(b))
    show(r.sqrt())
    show(a.neg())
    show(a.abs())
    echo a.lt(b).movemask()
    echo a.le(b).movemask()
    echo a.gt(b).movemask()
    echo a.ge(b).movemask()
    echo a.eq(b).movemask()
    echo a.ne(b).movemask()
    show(a.lt(b).select(a, b))
    echo a.sum()
    echo a.reduce_max()
    echo a.reduce_min()
    echo a.get(1)
    show(a.reverse())
    echo a.lt(b).any()
    echo a.eq(a).all()
}
