use std::simd
fun show(v: simd::I32x4) {
    echo v.get(0)
    echo v.get(1)
    echo v.get(2)
    echo v.get(3)
}
fun main() {
    a := simd::I32x4::splat(0).with(0, 1).with(1, -2).with(2, 2147483647).with(3, 100000)
    b := simd::I32x4::splat(0).with(0, 5).with(1, 7).with(2, 1).with(3, 100000)
    show(a.add(b))
    show(a.sub(b))
    show(a.mul(b))
    show(a.bit_and(b))
    show(a.bit_or(b))
    show(a.bit_xor(b))
    show(a.bit_andnot(b))
    echo a.eq(b).movemask()
    echo a.ne(b).movemask()
    echo a.gt(b).movemask()
    echo a.lt(b).movemask()
    echo a.ge(b).movemask()
    echo a.le(b).movemask()
    show(a.min(b))
    show(a.max(b))
    show(a.neg())
    echo a.sum()
    echo a.reduce_min()
    echo a.reduce_max()
    show(a.gt(b).select(a, b))
    show(a.reverse())
}
