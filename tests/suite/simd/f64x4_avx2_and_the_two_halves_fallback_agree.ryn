use std::simd
use std::cpu
fun show(v: simd::F64x4) {
    echo v.get(0)
    echo v.get(1)
    echo v.get(2)
    echo v.get(3)
}
fun put(cell: *u64, value: u64) {
    *cell = value
}
fun pass() {
    a := simd::F64x4::splat(0.0).with(0, 1.5).with(1, -2.0).with(2, 3.25).with(3, 4.0)
    b := simd::F64x4::splat(0.0).with(0, 0.5).with(1, 8.0).with(2, -1.0).with(3, 2.0)
    r := simd::F64x4::splat(0.0).with(0, 4.0).with(1, 9.0).with(2, 16.0).with(3, 25.0)
    show(a.add(b))
    show(a.sub(b))
    show(a.mul(b))
    show(a.div(b))
    show(a.min(b))
    show(a.max(b))
    show(r.sqrt())
    show(a.neg())
    show(a.abs())
    echo a.lt(b).movemask()
    echo a.le(b).movemask()
    echo a.gt(b).movemask()
    echo a.ge(b).movemask()
    echo a.eq(b).movemask()
    echo a.ne(b).movemask()
    show(a.lt(b).select(a, b))
    echo a.sum()
    echo a.reduce_max()
    echo a.reduce_min()
    echo a.get(3)
    show(a.reverse())
    echo a.lt(b).any()
    echo a.eq(a).all()
}
fun main() {
    pass()
    cell := __cpu_cell() as *u64
    bits := *cell
    when cpu::has_avx2() {
        put(cell, bits - 128)
    }
    pass()
    echo cpu::has_avx2()
}
