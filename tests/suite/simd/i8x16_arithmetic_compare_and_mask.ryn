use std::simd
fun show(v: simd::I8x16) {
    echo v.get(0)
    echo v.get(1)
    echo v.get(2)
    echo v.get(3)
    echo v.get(4)
    echo v.get(5)
    echo v.get(6)
    echo v.get(7)
    echo v.get(8)
    echo v.get(9)
    echo v.get(10)
    echo v.get(11)
    echo v.get(12)
    echo v.get(13)
    echo v.get(14)
    echo v.get(15)
}
fun main() {
    a := simd::I8x16::splat(0).with(0, 1).with(1, -2).with(2, 127).with(3, 100).with(4, -128).with(5, 5).with(6, 0).with(7, 7).with(8, 9).with(9, 10).with(10, 11).with(11, 12).with(12, -1).with(13, -1).with(14, 3).with(15, 3)
    b := simd::I8x16::splat(0).with(0, 5).with(1, 7).with(2, 1).with(3, 100).with(4, -1).with(5, 5).with(6, 1).with(7, -7).with(8, 9).with(9, -10).with(10, 12).with(11, 11).with(12, -1).with(13, 1).with(14, 3).with(15, 4)
    show(a.add(b))
    show(a.sub(b))
    show(a.mul(b))
    show(a.bit_and(b))
    show(a.bit_or(b))
    show(a.bit_xor(b))
    show(a.bit_andnot(b))
    echo a.eq(b).movemask()
    echo a.ne(b).movemask()
    echo a.gt(b).movemask()
    echo a.lt(b).movemask()
    echo a.ge(b).movemask()
    echo a.le(b).movemask()
    show(a.min(b))
    show(a.max(b))
    show(a.neg())
    echo a.sum()
    echo a.reduce_min()
    echo a.reduce_max()
    show(a.gt(b).select(a, b))
    show(a.reverse())
}
