use std::simd
use std::cpu
fun show(v: simd::I64x4) {
    echo v.get(0)
    echo v.get(1)
    echo v.get(2)
    echo v.get(3)
}
fun put(cell: *u64, value: u64) {
    *cell = value
}
fun pass() {
    a := simd::I64x4::splat(0).with(0, 1).with(1, -9223372036854775808).with(2, 5).with(3, -3)
    b := simd::I64x4::splat(0).with(0, 5).with(1, -1).with(2, 5).with(3, 2)
    show(a.add(b))
    show(a.sub(b))
    show(a.mul(b))
    show(a.bit_and(b))
    show(a.bit_or(b))
    show(a.bit_xor(b))
    show(a.bit_andnot(b))
    echo a.eq(b).movemask()
    echo a.ne(b).movemask()
    echo a.gt(b).movemask()
    echo a.lt(b).movemask()
    echo a.ge(b).movemask()
    echo a.le(b).movemask()
    show(a.min(b))
    show(a.max(b))
    show(a.neg())
    echo a.sum()
    echo a.reduce_min()
    echo a.reduce_max()
    show(a.gt(b).select(a, b))
    show(a.reverse())
}
fun main() {
    pass()
    cell := __cpu_cell() as *u64
    bits := *cell
    when cpu::has_avx2() {
        put(cell, bits - 128)
    }
    pass()
    echo cpu::has_avx2()
}
