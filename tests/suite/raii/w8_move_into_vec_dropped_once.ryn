// test: run
// out: full
// out: 100000
#[drop(bump)]
struct Counter { h: *i64 }
fun bump(c: Counter) {
    *c.h = *c.h + 1
}
fun main() {
    mut hits: i64 = 0
    mut v: Vec<Counter> = Vec()
    mut i: i64 = 0
    while i < 100000 {
        c := Counter { h: &raw mut hits }
        v.push(c)
        i += 1
    }
    when v.len() == 100000 {
        echo "full"
    }
    v.clear()
    echo hits
}
