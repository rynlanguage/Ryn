// test: run
// out: pushed
// out: drop 2
// out: drop 1
#[drop(rel)]
struct R { h: *i32, id: i32 }
fun rel(r: R) { echo "drop {r.id}" }
fun mk(id: i32, p: *i32) -> R { return R { h: p, id: id } }
fun main() {
    mut x: i32 = 0
    p := &raw mut x
    mut v: Vec<R> = Vec()
    v.push(mk(1, p))
    v.push(mk(2, p))
    echo "pushed"
}
