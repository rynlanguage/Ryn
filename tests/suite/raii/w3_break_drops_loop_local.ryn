// test: run
// out: iter 1
// out: drop 0
// out: drop 1
// out: after
#[drop(rel)]
struct R {
    h: *i32,
    id: i32,
}
fun rel(r: R) {
    echo "drop {r.id}"
}
fun mk(id: i32, p: *i32) -> R {
    return R { h: p, id: id }
}
fun main() {
    mut x: i32 = 0
    mut i: i32 = 0
    while true {
        a := mk(i, &raw mut x)
        i += 1
        when i == 2 {
            break
        }
        echo "iter {i}"
    }
    echo "after"
}
