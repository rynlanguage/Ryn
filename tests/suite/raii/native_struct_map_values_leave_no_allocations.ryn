// test: run
// out: 1000000
// out: 0
// `values()` of a map of structures is a vector of copies, freed at scope exit: no live allocation remains.
extern "C" fun ryn_native_live_allocations() -> u64;
struct Mixed {
    small: u8
    wide: i64
    flag: bool
    count: i32
}
fun round(seed: i64) -> i64 {
    mut table := Map<i32, Mixed>()
    table.insert(1, Mixed { small: 1, wide: seed, flag: true, count: 10 })
    table.insert(2, Mixed { small: 2, wide: seed + 1, flag: false, count: 20 })
    mut all := table.values()
    mut sum: i64 = 0
    for item in all {
        sum += item.wide
    }
    table.clear()
    return sum
}
fun main() {
    before := ryn_native_live_allocations()
    mut i: i64 = 0
    mut total: i64 = 0
    while i < 1000 {
        total += round(i)
        i += 1
    }
    echo total
    echo ryn_native_live_allocations() - before
}
