// test: run
// out: 1
// out: drop 1
#[drop(rel)]
struct R { h: *i32, id: i32 }
fun rel(r: R) { echo "drop {r.id}" }
fun mk(id: i32, p: *i32) -> R { return R { h: p, id: id } }
fun main() {
    mut x: i32 = 0
    p := &raw mut x
    mut m := Map<i32, i32>()
    m.insert(1, 10)
    r := mk(1, p)
    echo m.len()
}
