// test: run
// out: 200000
// out: 100000
#[drop(bump)]
struct Counter { h: *i64 }
fun bump(c: Counter) {
    *c.h = *c.h + 1
}
struct Holder { items: Vec<String>, c: Counter, label: String }
fun main() {
    mut hits: i64 = 0
    mut strings: i64 = 0
    mut i: i64 = 0
    while i < 100000 {
        mut v: Vec<String> = Vec()
        v.push(String("a"))
        v.push(String("bc"))
        strings += v.len() as i64
        h := Holder { items: v, c: Counter { h: &raw mut hits }, label: String("L") }
        i += 1
    }
    echo strings
    echo hits
}
