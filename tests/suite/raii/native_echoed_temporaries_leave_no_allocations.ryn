// exit: 0
// Echoed structures and enums that own their text are dropped once written: fifty rounds leave no live allocation.
extern "C" fun ryn_native_live_allocations() -> u64;
struct Named {
    label: String,
    count: u64,
}
enum Shape {
    Empty,
    Circle(i32),
    Labelled(String, i32),
}
fun main() {
    before := ryn_native_live_allocations()
    mut i: u64 = 0
    while i < 50 {
        echo Named { label: String("x"), count: 1 }
        echo Shape::Labelled(String("y"), 2)
        i += 1
    }
    echo ryn_native_live_allocations() - before
}
