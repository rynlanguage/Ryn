// test: run
// out: end
// out: drop 1
// out: consumed 1
// out: drop 1
// out: end
#[drop(rel)]
struct R {
    h: *i32,
    id: i32,
}
fun rel(r: R) {
    echo "drop {r.id}"
}
fun mk(id: i32, p: *i32) -> R {
    return R { h: p, id: id }
}
fun consume(r: R) {
    echo "consumed {r.id}"
}
fun run(flag: bool) {
    mut x: i32 = 0
    a := mk(1, &raw mut x)
    when flag {
        consume(a)
    }
    echo "end"
}
fun main() {
    run(false)
    run(true)
}
