// test: run
// out: 4
// out: 9
// out: 19
// self.data[i] = v, self.data[i] += v and a[i] *= v.
struct Buf { data: [f32; 4], n: i32 }
extend Buf {
    fun put(mut self, i: u64, v: f32) {
        self.data[i] = v
    }
    fun bump(mut self, i: u64) {
        self.data[i] += 1.0
    }
}
fun fill(b: &mut Buf) {
    b.data[2] = 9.0
}
fun main() {
    mut b := Buf { data: [0.0; 4], n: 0 }
    b.put(1, 3.0)
    b.bump(1)
    fill(&mut b)
    echo b.data[1]
    echo b.data[2]
    mut a: [i32; 3] = [1, 2, 3]
    a[1] += 5
    a[2] *= 4
    echo a[1] + a[2]
}
