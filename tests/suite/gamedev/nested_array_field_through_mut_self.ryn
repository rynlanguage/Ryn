// test: run
// out: 7
// out: 7
// out: 15
// A two-dimensional array field is assigned and read through self and directly, with compound assignment.
struct World { tiles: [[u8; 4]; 3], hp: [i32; 2] }
extend World {
    fun set(mut self, y: u64, x: u64, v: u8) { self.tiles[y][x] = v }
    fun get(self, y: u64, x: u64) -> u8 { return self.tiles[y][x] }
}
fun main() {
    mut w := World { tiles: [[0; 4]; 3], hp: [10, 20] }
    w.set(2, 3, 7)
    w.tiles[1][1] = 4
    w.tiles[1][1] += 3
    w.hp[1] -= 5
    echo w.get(2, 3)
    echo w.get(1, 1)
    echo w.hp[1]
}
