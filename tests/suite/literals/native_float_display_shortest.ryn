// Shortest float text: powers of two whose shortest digits lie above the nearest decimal, exact halfway values (Rust
// takes the upper decimal), subnormals, the extremes, and single-precision values.

fun power(exponent: i64) -> f64 {
    mut x: f64 = 1.0
    mut n: i64 = 0
    while n < exponent {
        x = x * 2.0
        n += 1
    }
    while n > exponent {
        x = x / 2.0
        n -= 1
    }
    return x
}

fun main() {
    echo power(89)
    echo power(122)
    echo power(-25)
    echo power(-1074)
    echo power(-1022)
    echo power(1023)
    echo 1.7976931348623157e308
    echo 123456789.125
    echo 0.1 + 0.7
    echo 1.0 / 3.0
    echo -2.5e-10
    a: f32 = 0.000244140625
    echo a
    b: f32 = 3.4028235e38
    echo b
    c: f32 = 1.0e-45
    echo c
    d: f32 = 1.0 / 3.0
    echo d
    s := String(0.1 + 0.2)
    echo s.len()
    echo String(d)
}
