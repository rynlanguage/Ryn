// test: run
// out: 4
// out: 3
// out: 1
struct Pair<A, B> { first: A, second: B }
fun left<A, B>(p: Pair<A, B>) -> A {
    return p.first
}
fun sum(p: Pair<i32, i32>) -> i32 {
    return p.first + p.second
}
fun main() {
    p := Pair::<i32, bool> { first: 4, second: true }
    q := Pair::<i32, i32> { first: 1, second: 2 }
    echo left(p)
    echo sum(q)
    echo left(q)
}
