// msg: does not satisfy shape
shape Show {
    fun show(self) -> i32
}
struct A { n: i32 }
extend A {
    fun show(self) -> i32 { self.n }
}
struct Plain { n: i32 }
struct Box<T> { v: T }
fun show_box<T: Show>(b: Box<T>) -> i32 {
    return b.v.show() * 10
}
fun main() {
    echo show_box(Box::<Plain> { v: Plain { n: 4 } })
}
