// test: run
// out: false
// out: true
// out: false
// out: true
// out: true
// out: ne
// out: false
// out: true
// Regression: `==` and `!=` of floats answered "equal" for any two ordered values (the second setcc overwrote the first).
struct V { x: f32 }
fun main() {
    x: f32 = 1.0
    y: f32 = 2.0
    p: f64 = 1.0
    q: f64 = 2.0
    echo x == y
    echo x != y
    echo p == q
    echo p != q
    echo x == x
    when x == y { echo "eq" } else { echo "ne" }
    a := V { x: 1.0 }
    b := V { x: 2.0 }
    echo a == b
    echo a != b
}
