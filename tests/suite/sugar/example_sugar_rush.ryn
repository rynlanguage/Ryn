// test: run
// out: total 30 is big
// out: Ada (level 3) is hurt
// out: 2..9 Bo 12 60
// out: 7
// out: -1
// out: 11
// out: 314
// out: 12
// out: 12
// out: dead
// out: fine
// out: overhealed
// Ryn 0.1.12 "Sugar Rush": the everyday syntax in one program.
struct Player { name: String, hp: i32, level: u32 }

enum Shape { Circle(i32), Rect(i32, i32), Dot }

fun double(x: i32) -> i32 { return x * 2 }
fun inc(x: i32) -> i32 { return x + 1 }

fun describe(hp: i32) -> String {
    return choose hp {
        0 => String("dead"),
        1..=25 => String("critical"),
        26..=74 => String("hurt"),
        h when h > 100 => String("overhealed"),
        _ => String("fine"),
    }
}

fun area(figure: Shape) -> i32 {
    return choose figure {
        Shape::Circle(r) when r > 10 => 314,
        Shape::Circle(r) => 3 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Dot => 0,
    }
}

fun main() {
    // Ranges, compound assignment and `when` as a value.
    mut total: u64 = 0
    for i in 1..=4 {
        total += i
    }
    total *= 3
    label := when total > 20 { "big" } else { "small" }
    echo "total {total} is {label}"

    // Interpolation builds a String; a literal without variables stays a str.
    p := Player { name: String("Ada"), hp: 40, level: 3 }
    state := describe(p.hp)
    echo "{p.name} (level {p.level}) is {state}"

    // Destructuring tuples, structures and arrays.
    (lo, hi) := (2, 9)
    Player { name, hp } := Player { name: String("Bo"), hp: 12, level: 2 }
    [first, second, third] := [10, 20, 30]
    sum := first + second + third
    echo "{lo}..{hi} {name} {hp} {sum}"

    // Optional chaining, coalescing and the pipe.
    found: Option<Player> = Option::Some(Player { name: String("Zed"), hp: 7, level: 1 })
    nobody: Option<Player> = Option::None
    echo (found?.hp) ?? 0
    echo (nobody?.hp) ?? -1
    echo 5 |> double |> inc

    // Advanced choose: ranges, guards, bindings.
    echo area(Shape::Circle(20))
    echo area(Shape::Circle(2))
    echo area(Shape::Rect(3, 4))
    echo describe(0)
    echo describe(100)
    echo describe(150)
}
