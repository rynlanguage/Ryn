// test: run
// out: 2
// out: 7
shape Show { fun show(self) -> i32 }
struct B { n: i32 }
extend B as Show {
    fun show(self) -> i32 { return self.n }
    fun extra(self) -> i32 { return 7 }
}
fun f<T: Show>(a: T) -> i32 {
    return a.show() + 1
}
fun main() {
    b := B { n: 1 }
    echo f(B { n: 1 })
    echo b.extra()
}
