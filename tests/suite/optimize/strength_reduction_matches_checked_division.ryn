// test: run
// out: 0
// A division, remainder or multiplication by a constant is computed without a divide instruction.
// Each is compared with the same operation on a divisor that is not a constant (a parameter), at every width.
// The count of mismatches is printed.
fun div_u8(x: u8, d: u8) -> u8 { return x / d }
fun rem_u8(x: u8, d: u8) -> u8 { return x % d }
fun mul_u8(x: u8, d: u8) -> u8 { return x * d }
fun div_u16(x: u16, d: u16) -> u16 { return x / d }
fun rem_u16(x: u16, d: u16) -> u16 { return x % d }
fun mul_u16(x: u16, d: u16) -> u16 { return x * d }
fun div_u32(x: u32, d: u32) -> u32 { return x / d }
fun rem_u32(x: u32, d: u32) -> u32 { return x % d }
fun mul_u32(x: u32, d: u32) -> u32 { return x * d }
fun div_u64(x: u64, d: u64) -> u64 { return x / d }
fun rem_u64(x: u64, d: u64) -> u64 { return x % d }
fun mul_u64(x: u64, d: u64) -> u64 { return x * d }
fun div_i8(x: i8, d: i8) -> i8 { return x / d }
fun rem_i8(x: i8, d: i8) -> i8 { return x % d }
fun mul_i8(x: i8, d: i8) -> i8 { return x * d }
fun div_i16(x: i16, d: i16) -> i16 { return x / d }
fun rem_i16(x: i16, d: i16) -> i16 { return x % d }
fun mul_i16(x: i16, d: i16) -> i16 { return x * d }
fun div_i32(x: i32, d: i32) -> i32 { return x / d }
fun rem_i32(x: i32, d: i32) -> i32 { return x % d }
fun mul_i32(x: i32, d: i32) -> i32 { return x * d }
fun div_i64(x: i64, d: i64) -> i64 { return x / d }
fun rem_i64(x: i64, d: i64) -> i64 { return x % d }
fun mul_i64(x: i64, d: i64) -> i64 { return x * d }
