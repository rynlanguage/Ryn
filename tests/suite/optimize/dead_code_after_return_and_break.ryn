// test: run
// out: 1
// out: 2
// out: 3
// out: 5
fun early(n: i64) -> i64 {
    when n > 0 {
        return 1
        echo "unreachable"
    }
    return 0
}

fun main() {
    echo early(5)
    mut i: i64 = 0
    while true {
        i += 1
        when i == 2 {
            echo 2
            break
            echo "unreachable"
        }
    }
    when i == 2 {
        echo 3
    }
    mut s: i64 = 0
    for j in 0..5 {
        when j == 4 {
            continue
            s += 100
        }
        s += 1
    }
    echo s + 1
}
