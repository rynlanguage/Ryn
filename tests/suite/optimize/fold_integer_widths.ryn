// test: run
// out: 0
// out: 0
// out: 255
// out: 255
// out: 144
// out: 144
// out: 1
// out: 1
// out: -128
// out: -128
// out: -128
// out: -128
// out: 2147483648
// out: -2147483648
// out: 4294967296
// out: 0
// out: -9223372036854775808
// out: -9223372036854775808
// out: -9223372036854775808
// out: 0
// out: 18446744073709551614
// out: 1
// out: 18446744073709551614
// out: 4294967294
// out: 4294967294
// out: -128
// out: -128
// out: true
// out: true
// out: -2
// out: -2
// out: -1
// out: -1
// out: -128
// out: -128
// out: -1
// out: -1
// out: -2147483648
// out: -2147483648
// out: -128
// out: -128
// out: 15
// out: 15
// out: -9223372036854775808
// out: -9223372036854775808
// out: 0
// out: 0
fun add_u8(a: u8, b: u8) -> u8 {
    return a + b
}

fun sub_u8(a: u8, b: u8) -> u8 {
    return a - b
}

fun mul_u8(a: u8, b: u8) -> u8 {
    return a * b
}

fun add_i8(a: i8, b: i8) -> i8 {
    return a + b
}

fun mul_i8(a: i8, b: i8) -> i8 {
    return a * b
}

fun neg_i8(a: i8) -> i8 {
    return -a
}

fun add_i32(a: i32, b: i32) -> i32 {
    return a + b
}

fun mul_i32(a: i32, b: i32) -> i32 {
    return a * b
}

fun mul_i64(a: i64, b: i64) -> i64 {
    return a * b
}

fun add_u64(a: u64, b: u64) -> u64 {
    return a + b
}

fun mul_u64(a: u64, b: u64) -> u64 {
    return a * b
}

fun mul_u32(a: u32, b: u32) -> u32 {
    return a * b
}
fun div_i64(a: i64, b: i64) -> i64 {
    return a / b
}

fun rem_i64(a: i64, b: i64) -> i64 {
    return a % b
}

fun neg_sub_i8(a: i8) -> i8 {
    return -a - 1 as i8
}

fun sar_i64_by(a: i64, n: u32) -> i64 {
    return a >> n
}

fun neg_min_i32(a: i32) -> i32 {
    return -a - 1 as i32
}

fun neg_i64(a: i64) -> i64 {
    return -a
}

fun bit_not_i8(a: i8) -> i8 {
    return ~a
}

fun main() {
    // u8: 255 + 1 wraps to 0, 0 - 1 wraps to 255, 200 * 2 is 400 mod 256.
    echo 255 as u8 + 1 as u8
    echo add_u8(255 as u8, 1 as u8)
    echo 0 as u8 - 1 as u8
    echo sub_u8(0 as u8, 1 as u8)
    echo 200 as u8 * 2 as u8
    echo mul_u8(200 as u8, 2 as u8)
    // 255 * 255 = 65025 = 254 * 256 + 1.
    echo 255 as u8 * 255 as u8
    echo mul_u8(255 as u8, 255 as u8)
    // i8: 127 + 1 wraps to -128; 16 * 8 = 128 wraps to -128.
    echo 127 as i8 + 1 as i8
    echo add_i8(127 as i8, 1 as i8)
    echo 16 as i8 * 8 as i8
    echo mul_i8(16 as i8, 8 as i8)
    // i32 default: MAX + 1 wraps to MIN; 65536 * 65536 is 2^32, which is 0 at 32 bits.
    echo 2147483647 + 1
    echo add_i32(2147483647, 1)
    echo 65536 * 65536
    echo mul_i32(65536, 65536)
    // i64: MAX + 1 wraps to MIN; MIN * -1 wraps back to MIN.
    echo 9223372036854775807 as i64 + 1 as i64
    echo mul_i64(0 as i64 - 9223372036854775807 as i64 - 1 as i64, 0 as i64 - 1 as i64)
    echo (0 as i64 - 9223372036854775807 as i64 - 1 as i64) * (0 as i64 - 1 as i64)
    // u64: MAX + 1 wraps to 0; MAX * 2 is 2^64 - 2.
    echo 18446744073709551615 as u64 + 1 as u64
    echo 18446744073709551615 as u64 * 2 as u64
    echo add_u64(18446744073709551615 as u64, 2 as u64)
    echo mul_u64(18446744073709551615 as u64, 2 as u64)
    // u32: MAX * 2 is 2^33 - 2, which is 2^32 - 2 at 32 bits.
    echo 4294967295 as u32 * 2 as u32
    echo mul_u32(4294967295 as u32, 2 as u32)
    // Negating MIN of i8 wraps to MIN.
    echo 0 as i8 - (0 as i8 - 127 as i8 - 1 as i8)
    echo neg_i8(0 as i8 - 127 as i8 - 1 as i8)
    // Bit-not of zero is all ones; a comparison of a wrapped value.
    echo (0 as u8 - 1 as u8) > 200 as u8
    echo ((~(0 as u8)) == 255 as u8) && (0 as u8 - 1 as u8 == 255 as u8)
    echo -5 / 2
    echo div_i64(-5, 2)
    echo -7 % 2
    echo rem_i64(-7, 2)
    echo -(127 as i8) - 1 as i8
    echo neg_sub_i8(127 as i8)
    echo (-1 as i64) >> 63 as u32
    echo sar_i64_by(-1, 63 as u32)
    echo -(2147483647 as i32) - 1 as i32
    echo neg_min_i32(2147483647 as i32)
    echo -(0 as i8 - 127 as i8 - 1 as i8)
    echo neg_i8(0 as i8 - 127 as i8 - 1 as i8)
    echo (-5) * (-3)
    echo mul_i32(-5, -3)
    echo -(0 as i64 - 9223372036854775807 as i64 - 1 as i64)
    echo neg_i64(0 as i64 - 9223372036854775807 as i64 - 1 as i64)
    echo ~(-1 as i8)
    echo bit_not_i8(-1 as i8)
}
