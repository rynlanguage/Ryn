// test: run
// out: 6
// exit: 1
// err: Vec slice end is out of bounds

fun total(values: &[i32]) -> i32 {
    mut t: i32 = 0
    for v in values {
        t += v
    }
    return t
}

fun main() {
    mut v: Vec<i32> = Vec()
    v.push(1)
    v.push(2)
    v.push(3)
    echo total(v.slice(0, 3))
    echo total(v.slice(1, 9))
}
