// out: after the buffer filled
// out: flushed
// out: x
// out: 3.5
// out: -7
// Standard output is buffered when it is not a terminal: `echo`, `print`, `io::print` and `io::println` share the buffer, which
// is written out when it fills (64 KiB, passed twice here), and everything comes out in the order it was written.
use std::io
fun main() {
    echo "first"
    io::print("second ")
    io::println("third")
    print("fourth {} {}", 4, true)
    echo ""
    mut i: u64 = 0
    while i < 2600 {
        echo "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQR {i}"
        i += 1
    }
    io::println("after the buffer filled")
    io::stdout_flush()
    echo "flushed"
    echo 'x'
    echo 3.5
    echo -7
}
