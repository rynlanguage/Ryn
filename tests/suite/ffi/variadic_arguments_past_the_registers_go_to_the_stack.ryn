// test: run
// target: linux
// out: 1,2,3,4,5,6 total=21
// snprintf takes three named arguments and six variable ones, so the last three integers are passed on the stack.
extern "C" fun malloc(size: u64) -> *u8;
extern "C" fun write(fd: i32, buffer: *u8, count: u64) -> i64;
extern "C" fun snprintf(buffer: *u8, size: u64, format: *u8, ...) -> i32;
fun poke8(address: u64, value: u8) {
    p := address as *u8
    *p = value
}
fun store(address: u64, text: str) {
    mut at: u64 = 0
    while at < text.len() {
        poke8(address + at, text.byte_at(at))
        at += 1
    }
    poke8(address + text.len(), 0 as u8)
}
fun at(base: u64, offset: u64) -> *u8 {
    return (base + offset) as *u8
}
fun main() {
    buffer := malloc(128 as u64)
    base := buffer as u64
    store(base + 64, "%d,%d,%d,%d,%d,%d total=%ld\n")
    line := snprintf(buffer, 64 as u64, at(base, 64), 1, 2, 3, 4, 5, 6, 21)
    write(1, buffer, line as u64)
}
