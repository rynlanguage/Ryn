// test: run
// out: 500
// out: 6
enum Inner { Data(i32), Nothing }
enum Outer { Nested(Inner), Direct(i32) }
fun f(o: Outer) -> i32 {
    choose o {
        Outer::Nested(Inner::Data(5)) => 500,
        Outer::Nested(Inner::Data(n)) => n,
        Outer::Nested(Inner::Nothing) => 0,
        Outer::Direct(x) => x
    }
}
fun main() {
    echo f(Outer::Nested(Inner::Data(5)))
    echo f(Outer::Nested(Inner::Data(6)))
}
