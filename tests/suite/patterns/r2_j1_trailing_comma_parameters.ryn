// test: run
// out: 3
// out: 6
fun add(a: i32, b: i32,) -> i32 {
    return a + b
}
shape Scale {
    fun scale(self, factor: i32,) -> i32
}
struct Box { v: i32 }
extend Box as Scale {
    fun scale(self, factor: i32,) -> i32 { self.v * factor }
}
fun main() {
    echo add(1, 2)
    b := Box { v: 3 }
    echo b.scale(2)
}
