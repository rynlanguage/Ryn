// test: run
// out: 30
// out: -1
struct Rect { w: i64, h: i64 }
extend Rect {
    fun area(self) -> i64 { return self.w * self.h }
}
struct Stack<T> { items: Vec<T> }
extend<T> Stack<T> {
    pub fun push_item(mut self, v: T) { self.items.push(v) }
    pub fun pop_item(mut self) -> Option<T> { return self.items.pop() }
}
fun main() {
    mut st := Stack::<Rect> { items: Vec<Rect>() }
    st.push_item(Rect { w: 5, h: 6 })
    q := choose st.pop_item() { Option::Some(r) => r.area(), Option::None => -1 }
    echo q
    e := choose st.pop_item() { Option::Some(r) => r.area(), Option::None => -1 }
    echo e
}
