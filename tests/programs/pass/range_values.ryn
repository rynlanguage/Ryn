fun main() {
    r := 5..20
    echo r.start
    echo r.end
    mut total: i64 = 0
    for i in r {
        total += i
    }
    echo total
    for i in r {
        total += 1
    }
    echo total
    q := 1..=3
    for i in q {
        echo i
    }
    empty := 5..5
    for i in empty {
        echo 99
    }
    lo: u8 = 250
    hi: u8 = 255
    span := lo..=hi
    mut count: i32 = 0
    for b in span {
        echo b
        count += 1
    }
    echo count
    for i in 0..3 {
        echo i
    }
}
