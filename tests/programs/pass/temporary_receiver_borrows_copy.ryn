struct Rect {
    w: i64,
    h: i64,
}

extend Rect {
    fun area(self) -> i64 {
        return self.w * self.h
    }
}

fun make() -> Rect {
    return Rect { w: 2, h: 3 }
}

fun doubled() -> i64 {
    return make().area() * 2
}

fun main() {
    echo make().area()
    total := make().area() + doubled()
    echo total
}
